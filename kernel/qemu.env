# The QEMU machine the kernel is built for. seL4 dumps this machine's DTB at
# configure time and compiles its memory map in, so QEMU must run with the
# same values. Read by kernel/Makefile and scripts/run-qemu.sh.
QEMU_CPU=cortex-a57
QEMU_MEM=1024
# GICv3 rather than seL4's default v2: HVF (run-qemu.sh --hvf) only emulates v3.
QEMU_GIC=3
