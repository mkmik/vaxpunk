! Generated by vdefs from lib.mlb: edit that, then run vdefs.
! Fields are BLOCK[, BYTE] access actuals: offset, position, size, extension.

! $PRDEF
LITERAL
    PR$_KSP = 0,  ! stack pointers, per access mode
    PR$_ESP = 1,
    PR$_SSP = 2,
    PR$_USP = 3,
    PR$_ISP = 4,  ! interrupt stack pointer
    PR$_P0BR = 8,  ! page table base and length
    PR$_P0LR = 9,
    PR$_P1BR = 10,
    PR$_P1LR = 11,
    PR$_SBR = 12,
    PR$_SLR = 13,
    PR$_PCBB = 16,  ! process control block base
    PR$_SCBB = 17,  ! system control block base
    PR$_IPL = 18,  ! interrupt priority level
    PR$_ASTLVL = 19,
    PR$_SIRR = 20,  ! software interrupt request
    PR$_SISR = 21,  ! software interrupt summary
    PR$_ICCS = 24,  ! interval clock control
    PR$_RXCS = 32,  ! console receive status and data
    PR$_RXDB = 33,
    PR$_TXCS = 34,  ! console transmit status and data
    PR$_TXDB = 35,
    PR$_MAPEN = 56,  ! memory management enable
    PR$_TBIA = 57,  ! translation buffer invalidates
    PR$_TBIS = 58,
    PR$_SID = 62,  ! system identification
    PR$_TBCHK = 63,
    PR$_DOORBELL = 64;  ! vaxpunk's: rings port n's doorbell

! $PALDEF
LITERAL
    PAL$_HALT = 0,
    PAL$_SWPCTX = 5,  ! R0 = new HWPCB; R0 = the one left
    PAL$_WTINT = 62,  ! wait for an interrupt
    PAL$_WRPTE = 65,  ! R0 = address, R1 = PTE; R0 = old PTE
    PAL$_DELCTX = 66,  ! R0 = HWPCB of a context to delete
    PAL$_READLBLK = 70,  ! R0 = buffer, R1 = byte count, R2 = LBN, R3 = unit; R0 = status
    PAL$_WRITELBLK = 71,  ! the same, writing the buffer there
    PAL$_DOORBELL = 72,  ! R0 = a port: MTPR #n, #PR$_DOORBELL
    PAL$_RD_PS = 145;  ! R0 = the PSL: the modes and IPL

! $IPLDEF
LITERAL
    IPL$_ASTDEL = 2,  ! AST delivery
    IPL$_RESCHED = 3,  ! rescheduling software interrupt
    IPL$_IOPOST = 4,  ! I/O post processing
    IPL$_NETPOST = 6,  ! the port's responses, a fork level
    IPL$_TIMER = 7,  ! software timer: quantum end
    IPL$_SYNCH = 8,  ! the scheduler's database
    IPL$_CONSOLE = 20,  ! console receive interrupt
    IPL$_PORT = 21,  ! the port's completion interrupt
    IPL$_HWCLK = 24,  ! interval timer interrupt
    IPL$_POWER = 31;  ! everything blocked

! $SCBDEF
LITERAL
    SCB$K_LENGTH = 260;
MACRO
    SCB$L_OPCDEC = 16, 0, 32, 0 %,  ! reserved or privileged instruction
    SCB$L_ACCVIO = 32, 0, 32, 0 %,  ! access violation: a mask and the address
    SCB$L_CHMK = 64, 0, 32, 0 %,  ! change mode to kernel
    SCB$L_CHME = 68, 0, 32, 0 %,  ! to executive
    SCB$L_CHMS = 72, 0, 32, 0 %,  ! to supervisor
    SCB$L_CHMU = 76, 0, 32, 0 %,  ! to user
    SCB$L_SOFTINT = 128, 0, 32, 0 %,  ! software interrupt level n at +4*n
    SCB$L_INTTIM = 192, 0, 32, 0 %,  ! interval timer, at IPL$_HWCLK
    SCB$L_CONSRCV = 248, 0, 32, 0 %,  ! console receive, at IPL$_CONSOLE
    SCB$L_PORT = 256, 0, 32, 0 %;  ! port 0's completion, at IPL$_PORT

! $FDSCDEF
LITERAL
    FDSC$V_HANDLER = 0,  ! FDSC$Q_HANDLER is a static handler
    FDSC$V_BASE_FRAME = 1,  ! the chain ends here
    FDSC$V_TARGET_INVO = 2,  ! call the handler when the frame is an unwind's target
    FDSC$V_EXCEPTION_FRAME = 3,  ! a frame exception delivery built
    FDSC$V_AST_FRAME = 4,  ! a frame AST delivery built
    FDSC$K_LENGTH = 32;
MACRO
    FDSC$L_FLAGS = 0, 0, 32, 0 %,
    FDSC$L_SAVED = 4, 0, 32, 0 %,  ! bit n: x18+n, n 0-10; bit 11+n: d8+n
    FDSC$L_RSA = 8, 0, 32, 0 %,  ! the saved registers' offset from FP, ascending
    FDSC$L_SIZE = 12, 0, 32, 0 %,  ! the frame's size: the caller's sp is FP plus it
    FDSC$Q_HANDLER = 16, 0, 64, 0 %,
    FDSC$Q_NAME = 24, 0, 64, 0 %;

! $FRMDEF
LITERAL
    FRM$K_LENGTH = 32;  ! the part every frame has
MACRO
    FRM$Q_FP = 0, 0, 64, 0 %,  ! the caller's FP, 0 past the last frame
    FRM$Q_PC = 8, 0, 64, 0 %,  ! the return address
    FRM$Q_HANDLER = 16, 0, 64, 0 %,  ! the condition handler, 0 if none
    FRM$Q_FDSC = 24, 0, 64, 0 %,  ! the frame descriptor's address
    FRM$L_ARGS = 32, 0, 32, 0 %;  ! MACRO-32's argument list, if it homes one

! $INTSTKDEF
LITERAL
    INTSTK$K_LENGTH = 272;
MACRO
    INTSTK$Q_PC = 0, 0, 64, 0 %,
    INTSTK$Q_PS = 8, 0, 64, 0 %,  ! the PSL ($PSLDEF): modes, IPL, NZVC
    INTSTK$Q_X0 = 16, 0, 64, 0 %,  ! x0-x30, 8 bytes each
    INTSTK$Q_R0 = 16, 0, 64, 0 %,  ! R0
    INTSTK$Q_R1 = 24, 0, 64, 0 %,  ! R1
    INTSTK$Q_R7 = 72, 0, 64, 0 %,  ! R7
    INTSTK$Q_SP = 160, 0, 64, 0 %,  ! the interrupted mode's VAX SP, x18
    INTSTK$Q_X_SP = 264, 0, 64, 0 %;  ! ARM64's sp

! $HWPCBDEF
LITERAL
    HWPCB$K_LENGTH = 128;
MACRO
    HWPCB$Q_KSP = 0, 0, 64, 0 %,  ! kernel stack pointer
    HWPCB$Q_ESP = 8, 0, 64, 0 %,  ! executive
    HWPCB$Q_SSP = 16, 0, 64, 0 %,  ! supervisor
    HWPCB$Q_USP = 24, 0, 64, 0 %,  ! user
    HWPCB$B_ASTEN = 32, 0, 8, 0 %,  ! bit n: mode n's ASTs may be delivered
    HWPCB$B_ASTSR = 33, 0, 8, 0 %;  ! bit n: an AST for mode n is queued

! $PTEDEF
LITERAL
    PTE$V_VALID = 31,
    PTE$M_VALID = 2147483648,
    PTE$V_PROT = 27,  ! 4 bits, PRT$C_ codes
    PTE$V_EXEC = 25,
    PTE$M_EXEC = 33554432,
    PTE$M_PFN = 2097151,
    MMG$C_PAGESIZE = 4096,
    MMG$C_VPCTX = 12;  ! address bits in a page

! $VADEF
LITERAL
    VA$C_P0BASE = 4096,  ! page 0 is never mapped
    VA$C_S0BASE = 1073741824,  ! past P0's end
    VA$C_P1BASE = 1610612736,  ! past S0's end
    VA$C_CLI = 2146435072,  ! a command interpreter's image, up to the stacks
    VA$C_STACKS = 2147368960,  ! the mode stacks, executive's first
    VA$C_ESP = 2147385344,  ! the executive stack's top
    VA$C_SSP = 2147401728,  ! the supervisor stack's top
    VA$C_USP = 2147418112,  ! the user stack's top
    VA$C_CLI_RESULT = 2147416064,  ! the parse of an image's command, from $IMGACT, above its stack
    VA$C_CLI_RESMAX = 2048,  ! its size, at most
    VA$C_P1END = 2147418112;

! $RPBDEF
LITERAL
    RPB$K_LENGTH = 192;
MACRO
    RPB$L_BASE = 0, 0, 32, 0 %,  ! the RPB's own address
    RPB$L_PFNCNT = 4, 0, 32, 0 %,  ! PFNs 0 to PFNCNT-1 are the executive's
    RPB$L_FREEPFN = 8, 0, 32, 0 %,  ! and those below this one are in use
    RPB$L_BOOTTIME = 12, 0, 32, 0 %,  ! seconds since 1970 at boot, from the RTC
    RPB$L_PORT = 16, 0, 32, 0 %,  ! port 0's pages, in S0, or 0 without a network
    RPB$Q_HWPCB = 64, 0, 64, 0 %;  ! the boot context's HWPCB

! $STATEDEF
LITERAL
    SCH$C_MWAIT = 2,  ! resource wait
    SCH$C_CEF = 3,  ! common event flag wait
    SCH$C_LEF = 5,  ! local event flag wait
    SCH$C_HIB = 7,  ! hibernating
    SCH$C_SUSP = 9,  ! suspended
    SCH$C_COM = 12,  ! computable
    SCH$C_CUR = 14,  ! current
    SCH$C_MAXPIX = 32;  ! process slots: index 0 unused, 1 the swapper

! $PCBDEF
LITERAL
    PCB$K_LENGTH = 624,
    PCB$C_MAXCHAN = 31,  ! channels 1-31, a bit each in PCB$L_CHANS
    PCB$V_WAKEPEN = 0,  ! a $WAKE came that $HIBER hasn't seen
    PCB$V_WALL = 1,  ! the wait is for all of EFWM
    PCB$V_SUSPEN = 2,  ! suspend when the wait ends
    DYN$C_PCB = 1;  ! PCB$B_TYPE
MACRO
    PCB$L_SQFL = 0, 0, 32, 0 %,  ! state queue: COM queue or a wait queue
    PCB$L_SQBL = 4, 0, 32, 0 %,
    PCB$W_SIZE = 8, 0, 16, 0 %,
    PCB$B_TYPE = 10, 0, 8, 0 %,
    PCB$B_PRI = 11, 0, 8, 0 %,  ! current priority, 0-31, higher first
    PCB$L_STATE = 12, 0, 32, 0 %,  ! SCH$C_
    PCB$L_PID = 16, 0, 32, 0 %,
    PCB$L_STS = 20, 0, 32, 0 %,  ! PCB$V_
    PCB$L_EFCS = 24, 0, 32, 0 %,  ! event flags 0-31
    PCB$L_EFCU = 28, 0, 32, 0 %,  ! 32-63
    PCB$L_EFC2P = 32, 0, 32, 0 %,  ! common cluster 2 (64-95): its CEB
    PCB$L_EFC3P = 36, 0, 32, 0 %,  ! 3 (96-127)
    PCB$L_EFWM = 40, 0, 32, 0 %,  ! a wait's flags
    PCB$L_WEFC = 44, 0, 32, 0 %,  ! and their cluster, 0-3
    PCB$L_KSTACK = 48, 0, 32, 0 %,  ! kernel stack, from pool
    PCB$L_HWPCB = 52, 0, 32, 0 %,  ! the HWPCB the PAL knows it by
    PCB$L_FREP0VA = 56, 0, 32, 0 %,  ! past its last P0 page
    PCB$L_FREP1VA = 60, 0, 32, 0 %,  ! its first P1 page
    PCB$B_PRIB = 64, 0, 8, 0 %,  ! base priority
    PCB$W_QUANT = 66, 0, 16, 0 %,  ! -ticks left of its quantum
    PCB$L_OWNER = 68, 0, 32, 0 %,  ! creator's PID
    PCB$T_LNAME = 72, 0, 0, 0 %,  ! process name, .ASCIC, 15 characters
    PCB$T_IMAGE = 88, 0, 0, 0 %,  ! image name, .ASCIC, 39 characters
    PCB$Q_HWPCB = 128, 0, 64, 0 %,  ! its HWPCB, if it isn't the boot one
    PCB$L_CHANS = 256, 0, 32, 0 %,  ! bit n: channel n is assigned
    PCB$L_CLI = 260, 0, 32, 0 %,  ! its command interpreter's transfer address, or 0
    PCB$L_CLICHANS = 264, 0, 32, 0 %,  ! the channels it keeps when an image exits
    PCB$A_IFAB = 272, 0, 32, 1 %,  ! its open files' IFABs, by IFI 1-15, or 0
    PCB$L_FILES = 336, 0, 32, 0 %,  ! bit n: IFI n is open
    PCB$L_CLIFILES = 340, 0, 32, 0 %,  ! the files it keeps open when an image exits
    PCB$Q_LNMHD = 344, 0, 64, 0 %,  ! its logical name table, LNM$PROCESS_TABLE: LNMBs
    PCB$T_DEFDIR = 352, 0, 0, 0 %,  ! default directory, .ASCIC, 63 characters: $SETDDIR's
    PCB$Q_ASTQFL = 424, 0, 64, 0 %,  ! its ACBs, by access mode, kernel's first
    PCB$L_ASTSP = 432, 0, 32, 0 %,  ! while an AST routine runs, where on the kernel stack what it interrupted is, else 0
    PCB$B_ASTEN = 436, 0, 8, 0 %,  ! bit n: $SETAST has mode n's ASTs enabled
    PCB$B_ASTACT = 437, 0, 8, 0 %,  ! bit n: an AST routine of mode n runs
    PCB$AL_CCB = 440, 0, 0, 0 %,  ! channel n's device, at 4*n: its UCB
    PCB$AL_EXH = 568, 0, 0, 0 %,  ! mode n's exit handlers, at 4*n: the first one's block, or 0
    PCB$L_TMBU = 584, 0, 32, 0 %,  ! its termination mailbox's unit, MBnn, or 0
    PCB$L_FINALSTS = 588, 0, 32, 0 %,  ! the status of its last $EXIT, or 0
    PCB$Q_PRIV = 592, 0, 64, 0 %,  ! current privileges, $PRVDEF's bits: what the checks look at
    PCB$Q_AUTHPRIV = 600, 0, 64, 0 %,  ! authorized: what $SETPRV may enable without SETPRV
    PCB$Q_PROCPRIV = 608, 0, 64, 0 %,  ! permanent: what the current ones go back to when an image exits
    PCB$L_UIC = 616, 0, 32, 0 %;  ! its UIC: the group in the high word, the member in the low

! $CEBDEF
LITERAL
    CEB$K_LENGTH = 48;
MACRO
    CEB$L_CEBFL = 0, 0, 32, 0 %,  ! all clusters
    CEB$L_CEBBL = 4, 0, 32, 0 %,
    CEB$L_WQFL = 8, 0, 32, 0 %,  ! processes waiting on it
    CEB$L_WQBL = 12, 0, 32, 0 %,
    CEB$L_EFC = 16, 0, 32, 0 %,  ! the flags
    CEB$L_REFC = 20, 0, 32, 0 %,  ! processes associated
    CEB$T_EFCNAM = 24, 0, 0, 0 %;  ! name, .ASCIC, 15 characters

! $LNMBDEF
LITERAL
    LNMB$K_LENGTH = 10;  ! past that, both strings
MACRO
    LNMB$L_FLINK = 0, 0, 32, 0 %,  ! the table
    LNMB$L_BLINK = 4, 0, 32, 0 %,
    LNMB$W_SIZE = 8, 0, 16, 0 %,  ! its size, as allocated
    LNMB$T_NAME = 10, 0, 0, 0 %;  ! the name, .ASCIC, then the equivalence, .ASCIC

! $TQEDEF
LITERAL
    TQE$K_LENGTH = 48,
    TQE$C_TMSNGL = 0,  ! $SETIMR: sets an event flag
    TQE$C_WKSNGL = 1,  ! $SCHDWK: wakes the process
    TQE$C_WKREPT = 2,  ! and again every TQE$Q_DELTA
    DYN$C_TQE = 15;  ! TQE$B_TYPE
MACRO
    TQE$L_TQFL = 0, 0, 32, 0 %,  ! timer queue
    TQE$L_TQBL = 4, 0, 32, 0 %,
    TQE$W_SIZE = 8, 0, 16, 0 %,
    TQE$B_TYPE = 10, 0, 8, 0 %,
    TQE$B_RQTYPE = 11, 0, 8, 0 %,  ! TQE$C_
    TQE$L_PID = 12, 0, 32, 0 %,  ! the process it is for
    TQE$L_AST = 16, 0, 32, 0 %,  ! $SETIMR's AST routine, or 0
    TQE$L_ASTPRM = 20, 0, 32, 0 %,  ! $SETIMR's reqidt, the AST's parameter
    TQE$Q_TIME = 24, 0, 64, 0 %,  ! when it is due
    TQE$Q_DELTA = 32, 0, 64, 0 %,  ! a repeating $SCHDWK's interval
    TQE$B_RMOD = 40, 0, 8, 0 %,  ! the access mode of $SETIMR's caller
    TQE$L_EFN = 44, 0, 32, 0 %;  ! $SETIMR's event flag

! $ACBDEF
LITERAL
    ACB$K_LENGTH = 32,
    DYN$C_ACB = 2;  ! ACB$B_TYPE
MACRO
    ACB$L_ASTQFL = 0, 0, 32, 0 %,  ! the AST queue
    ACB$L_ASTQBL = 4, 0, 32, 0 %,
    ACB$W_SIZE = 8, 0, 16, 0 %,
    ACB$B_TYPE = 10, 0, 8, 0 %,
    ACB$B_RMOD = 11, 0, 8, 0 %,  ! the access mode the AST is for
    ACB$L_PID = 12, 0, 32, 0 %,  ! the process it is for
    ACB$L_AST = 16, 0, 32, 0 %,  ! the AST routine, called in that mode
    ACB$L_ASTPRM = 20, 0, 32, 0 %,  ! its parameter
    ACB$L_KAST = 24, 0, 32, 0 %;  ! or the executive's routine, for a kernel mode AST: JSB'd with R4 = the PCB, R5 = the ACB, which it frees, at IPL$_SYNCH

! $VCBDEF
LITERAL
    VCB$K_LENGTH = 576,
    VCB$V_MOUNTED = 0,  ! a volume is mounted on it
    VCB$V_WRITE = 1,  ! the device can be written
    VCB$V_RAMDISK = 2;  ! the device is the ramdisk, MDA0:, not one of the PAL's disks
MACRO
    VCB$L_STATUS = 0, 0, 32, 0 %,  ! VCB$V_
    VCB$L_HDRVBN = 4, 0, 32, 0 %,  ! INDEXF.SYS's VBN of file 1's header
    VCB$L_IBMAPLBN = 8, 0, 32, 0 %,  ! the index file bitmap's LBN
    VCB$L_SBMAPLBN = 12, 0, 32, 0 %,  ! the storage bitmap's LBN
    VCB$T_DEVNAM = 16, 0, 0, 0 %,  ! the device's name, DDCU:, 5 characters
    VCB$B_UNIT = 21, 0, 8, 0 %,  ! the PAL's unit: 0 DKA0:, 1 DKB0:
    VCB$W_CLUSTER = 22, 0, 16, 0 %,  ! the volume's cluster, in blocks
    VCB$T_VOLNAME = 24, 0, 0, 0 %,  ! the volume's label, .ASCIC, 12 characters
    VCB$AB_INDEXF = 48, 0, 0, 0 %,  ! INDEXF.SYS's header, 512 bytes
    VCB$L_UCB = 560, 0, 32, 0 %,  ! the disk's UCB, whose driver the file system's I/O goes through
    VCB$L_OWNER = 564, 0, 32, 0 %,  ! the volume's owner, a UIC
    VCB$W_PROT = 568, 0, 16, 0 %,  ! and protection, a file header's mask: who may use its files
    VCB$L_SBMAPBLKS = 572, 0, 32, 0 %;  ! the storage bitmap's blocks, past its SCB

! $UCBDEF
LITERAL
    UCB$K_LENGTH = 28,
    UCB$K_NETLENGTH = 48,  ! a network unit, which BGA0: clones
    UCB$K_MBLENGTH = 60,  ! a mailbox
    UCB$V_PRMMBX = 0,  ! UCB$L_MBSTS: permanent, until $DELMBX
    UCB$M_PRMMBX = 1,
    UCB$V_ONLINE = 4,  ! the device is online
    UCB$M_ONLINE = 16;
MACRO
    UCB$L_IOQFL = 0, 0, 32, 0 %,  ! IRPs waiting for the device
    UCB$L_IOQBL = 4, 0, 32, 0 %,
    UCB$L_FDT = 8, 0, 32, 0 %,  ! the driver's FDT routine, which $QIO JSBs
    UCB$L_VCB = 12, 0, 32, 0 %,  ! a disk's VCB, or 0
    UCB$T_NAME = 16, 0, 0, 0 %,  ! the device's name, DDCU, 4 characters
    UCB$L_START = 20, 0, 32, 0 %,  ! a disk driver's start I/O routine, which does an IRP's I/O, or 0
    UCB$L_ERRCNT = 24, 0, 32, 0 %,  ! the errors the device reported, SS$_DRVERR
    UCB$L_CONN = 28, 0, 32, 0 %,  ! a network unit's connection on the port, 0 none yet
    UCB$L_MBSTS = 28, 0, 32, 0 %,  ! a mailbox's UCB$V_PRMMBX
    UCB$L_LINK = 32, 0, 32, 0 %,  ! a cloned unit's, a network unit's or a mailbox's: the next of its kind
    UCB$L_REFC = 36, 0, 32, 0 %,  ! the channels assigned to it
    UCB$L_UNIT = 40, 0, 32, 0 %,  ! its number, nn in its name, BGnn or MBnn
    UCB$L_PROTO = 44, 0, 32, 0 %,  ! a network unit's socket's protocol, TCPIP$C_
    UCB$L_MSGQFL = 44, 0, 32, 0 %,  ! a mailbox's messages, oldest first
    UCB$L_MSGQBL = 48, 0, 32, 0 %,
    UCB$L_MAXMSG = 52, 0, 32, 0 %,  ! the longest message it takes
    UCB$L_BUFQUO = 56, 0, 32, 0 %;  ! the bytes of messages it may still hold

! $IRPDEF
LITERAL
    IRP$K_LENGTH = 80,
    IRP$V_BUFIO = 0,  ! a read whose data IOC$POST copies to the caller's buffer
    IRP$M_BUFIO = 1,
    IRP$V_STARTED = 1,  ! the terminal has written its prompt
    DYN$C_IRP = 10;  ! IRP$B_TYPE
MACRO
    IRP$L_IOQFL = 0, 0, 32, 0 %,  ! the UCB's queue, then the AST queue
    IRP$L_IOQBL = 4, 0, 32, 0 %,
    IRP$W_SIZE = 8, 0, 16, 0 %,  ! with the prompt and data
    IRP$B_TYPE = 10, 0, 8, 0 %,
    IRP$B_RMOD = 11, 0, 8, 0 %,  ! the AST's mode: kernel, then the caller's
    IRP$L_PID = 12, 0, 32, 0 %,  ! the process it is for
    IRP$L_AST = 16, 0, 32, 0 %,  ! the caller's AST routine, or 0
    IRP$L_ASTPRM = 20, 0, 32, 0 %,  ! its parameter
    IRP$L_KAST = 24, 0, 32, 0 %,  ! IOC$POST once done, then 0
    IRP$L_UCB = 28, 0, 32, 0 %,  ! the device
    IRP$L_FUNC = 32, 0, 32, 0 %,  ! the function code and its modifiers
    IRP$L_EFN = 36, 0, 32, 0 %,  ! the event flag
    IRP$L_IOSB = 40, 0, 32, 0 %,  ! the caller's I/O status block, or 0
    IRP$W_CHAN = 44, 0, 16, 0 %,  ! the channel
    IRP$B_PMOD = 46, 0, 8, 0 %,  ! the caller's access mode
    IRP$L_STS = 48, 0, 32, 0 %,  ! IRP$V_
    IRP$L_IOST1 = 52, 0, 32, 0 %,  ! once done, the IOSB's first longword: a status and a byte count
    IRP$L_IOST2 = 56, 0, 32, 0 %,  ! and its second
    IRP$L_BUFADR = 60, 0, 32, 0 %,  ! the caller's buffer, p1
    IRP$L_BCNT = 64, 0, 32, 0 %,  ! its size, p2
    IRP$L_PROMPT = 68, 0, 32, 0 %,  ! a read's prompt's size: it is past IRP$K_LENGTH, and the data past it
    IRP$L_MEDIA = 72, 0, 32, 0 %,  ! a disk's LBN, p3
    IRP$L_POST = 76, 0, 32, 0 %;  ! a routine IOC$POST JSBs, R6 the IRP, in its process, or 0

! $PORTDEF
LITERAL
    PORT$K_VERSION = 2,  ! PORT$L_VERSION once the component is ready
    PORT$K_PAGES = 17,
    PORT$K_RING = 32,  ! messages in a ring
    PORT$K_TAGS = 32,  ! tags, a command's each: the credits
    PORT$K_BUFFERS = 16,  ! the tags that have a buffer
    PORT$K_BUFSIZE = 4096,
    PORTMSG$K_LENGTH = 32,
    PORT$C_OPEN = 1,  ! PROTO: TCP, UDP or ICMP; then as SETMODE; response: CONN
    PORT$C_SETMODE = 2,  ! FLAGS BIND: ADDR, PORT the local address; LISTEN: ARG1 the backlog
    PORT$C_ACCEPT = 3,  ! response: ARG1 the new connection, ADDR and PORT the peer's
    PORT$C_CONNECT = 4,  ! ADDR, PORT: the peer's
    PORT$C_SEND = 5,  ! LEN bytes from the buffer, a datagram to ADDR, PORT with FLAGS TO
    PORT$C_RECV = 6,  ! at most LEN bytes into the buffer, 0 if the peer closed; a datagram's sender
    PORT$C_CLOSE = 7,
    PORT$C_IFCONFIG = 8,  ! sets those FLAGS has: ADDR, ARG1 the mask, ARG2 the gateway, or DHCP's; response: all
    PORT$C_CANCEL = 9,  ! ends the connection's commands
    PORT$C_GETNAME = 10,  ! response: ADDR and PORT the local name, ARG1 and ARG2 the peer's
    PORT$C_SHUTDOWN = 11,  ! ARG1: 0 no more receives, 1 no more sends, 2 neither
    PORT$C_ICMP = 1,  ! PROTO, a raw socket's
    PORT$C_TCP = 6,
    PORT$C_UDP = 17,
    PORT$M_BIND = 1,  ! OPEN, SETMODE: bind
    PORT$M_LISTEN = 2,  ! OPEN, SETMODE: listen
    PORT$M_TO = 1,  ! SEND: to ADDR, PORT
    PORT$M_ADDR = 1,  ! IFCONFIG: set the address
    PORT$M_MASK = 2,  ! the mask
    PORT$M_GW = 4,  ! the gateway
    PORT$M_DHCP = 8,  ! ask a DHCP server, and answer once it has
    PORT$M_LINKUP = 16,  ! IFCONFIG's response: the link is up
    PORT$C_ST_OK = 0,  ! the statuses, which the driver maps to SS$_
    PORT$C_ST_BADPARAM = 1,
    PORT$C_ST_NOMEM = 2,
    PORT$C_ST_INUSE = 3,
    PORT$C_ST_REFUSED = 4,
    PORT$C_ST_RESET = 5,
    PORT$C_ST_TIMEOUT = 6,
    PORT$C_ST_ABORTED = 7,
    PORT$C_ST_UNREACH = 8,
    PORT$C_ST_CLOSED = 9,
    PORT$C_ST_NOLINKS = 10,
    PORT$C_ST_ISCONN = 11,
    PORT$C_ST_IVADDR = 12;
MACRO
    PORT$L_VERSION = 0, 0, 32, 0 %,
    PORT$L_CMDPUT = 4, 0, 32, 0 %,  ! commands written, by the executive
    PORT$L_CMDGET = 8, 0, 32, 0 %,  ! and taken, by the component
    PORT$L_RSPPUT = 12, 0, 32, 0 %,  ! responses written, by the component
    PORT$L_RSPGET = 16, 0, 32, 0 %,  ! and taken, by the executive
    PORT$A_CMD = 256, 0, 32, 1 %,  ! the command ring
    PORT$A_RSP = 1280, 0, 32, 1 %,  ! the response ring
    PORTMSG$B_TYPE = 0, 0, 8, 0 %,  ! PORT$C_
    PORTMSG$B_FLAGS = 1, 0, 8, 0 %,
    PORTMSG$W_TAG = 2, 0, 16, 0 %,  ! the executive's, echoed in the response
    PORTMSG$L_CONN = 4, 0, 32, 0 %,  ! the connection, 0 the control connection
    PORTMSG$L_STATUS = 8, 0, 32, 0 %,  ! a response's PORT$C_ST_
    PORTMSG$L_LEN = 12, 0, 32, 0 %,  ! bytes in the tag's buffer
    PORTMSG$L_ADDR = 16, 0, 32, 0 %,  ! an IPv4 address, network order
    PORTMSG$W_PORT = 20, 0, 16, 0 %,  ! a TCP or UDP port
    PORTMSG$W_PROTO = 22, 0, 16, 0 %,
    PORTMSG$L_ARG1 = 24, 0, 32, 0 %,
    PORTMSG$L_ARG2 = 28, 0, 32, 0 %;

! $IFBDEF
LITERAL
    IFB$K_LENGTH = 592,  ! the fixed part
    IFB$V_WRITE = 0,  ! it may be written: $CREATE made it or $OPEN opened it for that
    IFB$V_DIRTY = 1,  ! the buffer holds what the file hasn't yet
    IFB$V_HDR = 2,  ! the header changed: its end of file
    IFB$V_BIO = 3,  ! block I/O only
    IFB$V_BRO = 4,  ! block and record I/O
    IFB$V_PLG = 5,  ! relative: the prologue's end of file changed
    IFB$V_FOUND = 6,  ! the last record service was a $FIND: a sequential $GET reads the record it found
    IFB$V_DATA = 7;  ! indexed: a bucket was written, the end of file goes past the last block
MACRO
    IFB$L_POS = 0, 0, 32, 0 %,  ! sequential: the next byte; relative: the next record number
    IFB$L_EOF = 4, 0, 32, 0 %,  ! sequential: the bytes in the file; relative: the VBN after the last bucket
    IFB$L_BLOCK = 8, 0, 32, 0 %,  ! the VBN in the buffer, or 0
    IFB$L_VCB = 12, 0, 32, 0 %,  ! the file's volume
    IFB$L_FLAGS = 16, 0, 32, 0 %,  ! IFB$V_
    IFB$L_SIZE = 20, 0, 32, 0 %,  ! the IFAB's size, to give it back
    IFB$L_BUF = 24, 0, 32, 0 %,  ! its buffer: a block, or a bucket
    IFB$L_CUR = 28, 0, 32, 0 %,  ! the current record: sequential, its offset, -1 for none; relative, its number, 0 for none
    IFB$L_CURDAT = 32, 0, 32, 0 %,  ! sequential: its data's offset
    IFB$L_CURSZ = 36, 0, 32, 0 %,  ! sequential: its data's size
    IFB$B_ORG = 40, 0, 8, 0 %,  ! organization, FAB$C_SEQ, REL or IDX
    IFB$B_RFM = 41, 0, 8, 0 %,  ! record format, FAB$C_
    IFB$B_RAT = 42, 0, 8, 0 %,  ! record attributes
    IFB$B_FSZ = 43, 0, 8, 0 %,  ! VFC header size
    IFB$W_MRS = 44, 0, 16, 0 %,  ! record size, or the largest
    IFB$B_BKS = 46, 0, 8, 0 %,  ! bucket size, blocks
    IFB$B_FAC = 47, 0, 8, 0 %,  ! the access $OPEN or $CREATE gave, FAB$M_
    IFB$L_MRN = 48, 0, 32, 0 %,  ! relative: the highest record number
    IFB$L_DVBN = 52, 0, 32, 0 %,  ! relative: the first bucket's VBN
    IFB$L_CELLS = 56, 0, 32, 0 %,  ! relative: cells in a bucket
    IFB$L_CELLSZ = 60, 0, 32, 0 %,  ! relative: a cell's size
    IFB$L_IDX = 64, 0, 32, 0 %,  ! indexed: its state, past the buffers
    IFB$L_RAB = 68, 0, 32, 0 %,  ! the RAB connected, or 0
    IFB$L_BUFSZ = 72, 0, 32, 0 %,  ! the buffer's size, to give it back
    IFB$AB_HDR = 80, 0, 0, 0 %;  ! the file's header

! $PLGDEF
LITERAL
    PLG$C_VER_REL = 1,  ! a relative file's
    PLG$C_VER_3 = 3;  ! an indexed file's
MACRO
    PLG$B_AVBN = 102, 0, 8, 0 %,  ! first area descriptor's VBN
    PLG$B_AMAX = 103, 0, 8, 0 %,  ! areas
    PLG$W_DVBN = 104, 0, 16, 0 %,  ! relative: first bucket
    PLG$L_MRN = 108, 0, 32, 0 %,  ! relative: highest record number
    PLG$L_EOF = 112, 0, 32, 0 %,  ! relative: the VBN after the last bucket
    PLG$W_VER_NO = 116, 0, 16, 0 %,  ! prologue version
    PLG$W_CHECKSUM = 510, 0, 16, 0 %;  ! the 16-bit sum of the block's first 255 words

! $KEYDEF
LITERAL
    KEY$K_BLN = 102,  ! a key descriptor's size
    KEY$V_DUPKEYS = 0,  ! duplicates
    KEY$M_DUPKEYS = 1,
    KEY$V_CHGKEYS = 1,  ! $UPDATE may change it
    KEY$M_CHGKEYS = 2,
    KEY$V_NULKEYS = 2,  ! a null key isn't indexed
    KEY$M_NULKEYS = 4,
    KEY$V_IDX_COMPR = 3,  ! index compression
    KEY$M_IDX_COMPR = 8,
    KEY$V_INITIDX = 4,  ! no index yet
    KEY$M_INITIDX = 16,
    KEY$V_KEY_COMPR = 6,  ! key compression in data and SIDR buckets
    KEY$M_KEY_COMPR = 64,
    KEY$V_REC_COMPR = 7,  ! data record compression
    KEY$M_REC_COMPR = 128,
    KEY$C_STRING = 0,
    KEY$C_SGNWORD = 1,
    KEY$C_UNSGNWORD = 2,
    KEY$C_SGNLONG = 3,
    KEY$C_UNSGNLONG = 4,
    KEY$C_PACKED = 5,
    KEY$C_SGNQUAD = 6,
    KEY$C_UNSGNQUAD = 7,
    KEY$C_COLLATED = 8,
    KEY$C_DESCENDING = 32;  ! added to one of those
MACRO
    KEY$L_IDXFL = 0, 0, 32, 0 %,  ! the next key descriptor's VBN, 0 for none
    KEY$W_NOFF = 4, 0, 16, 0 %,  ! and offset
    KEY$B_IANUM = 6, 0, 8, 0 %,  ! area of the index above level 1
    KEY$B_LANUM = 7, 0, 8, 0 %,  ! area of the level 1 index
    KEY$B_DANUM = 8, 0, 8, 0 %,  ! area of the data
    KEY$B_ROOTLEV = 9, 0, 8, 0 %,  ! root bucket's level
    KEY$B_IDXBKTSZ = 10, 0, 8, 0 %,  ! index bucket size
    KEY$B_DATBKTSZ = 11, 0, 8, 0 %,  ! data bucket size
    KEY$L_ROOTVBN = 12, 0, 32, 0 %,  ! root bucket
    KEY$B_FLAGS = 16, 0, 8, 0 %,  ! KEY$V_
    KEY$B_DATATYPE = 17, 0, 8, 0 %,  ! KEY$C_
    KEY$B_SEGMENTS = 18, 0, 8, 0 %,
    KEY$B_NULLCHAR = 19, 0, 8, 0 %,  ! null value, with NULKEYS
    KEY$B_KEYSZ = 20, 0, 8, 0 %,  ! the key's size
    KEY$B_KEYREF = 21, 0, 8, 0 %,  ! key of reference
    KEY$W_MINRECSZ = 22, 0, 16, 0 %,  ! shortest record holding the key
    KEY$W_IDXFILL = 24, 0, 16, 0 %,  ! index fill, bytes
    KEY$W_DATFILL = 26, 0, 16, 0 %,  ! data fill, bytes
    KEY$W_POSITION = 28, 0, 16, 0 %,  ! segment positions, 8 words
    KEY$B_SIZE = 44, 0, 8, 0 %,  ! segment sizes, 8 bytes
    KEY$T_KEYNAM = 52, 0, 0, 0 %,  ! name, 32 bytes, space padded
    KEY$L_LDVBN = 84, 0, 32, 0 %,  ! first data bucket
    KEY$B_TYPE = 88, 0, 8, 0 %;  ! segment types, 8 bytes

! $AREADEF
LITERAL
    AREA$K_BLN = 64;  ! an area descriptor's size
MACRO
    AREA$B_AREAID = 2, 0, 8, 0 %,  ! its number
    AREA$B_ARBKTSZ = 3, 0, 8, 0 %,  ! bucket size
    AREA$W_VOLUME = 4, 0, 16, 0 %,
    AREA$B_ALN = 6, 0, 8, 0 %,  ! placement
    AREA$B_AOP = 7, 0, 8, 0 %,  ! allocation options
    AREA$L_AVAIL = 8, 0, 32, 0 %,  ! first reclaimed bucket, 0 for none
    AREA$L_CVBN = 12, 0, 32, 0 %,  ! current extent's first VBN
    AREA$L_CNBLK = 16, 0, 32, 0 %,  ! and blocks
    AREA$L_USED = 20, 0, 32, 0 %,  ! blocks of it used
    AREA$L_NXTVBN = 24, 0, 32, 0 %,  ! next VBN to use
    AREA$L_NXT = 28, 0, 32, 0 %,  ! next extent, 0 for none
    AREA$L_NXBLK = 32, 0, 32, 0 %,  ! its blocks
    AREA$W_DEQ = 36, 0, 16, 0 %,  ! default extension
    AREA$L_LOC = 40, 0, 32, 0 %,  ! placement location
    AREA$W_RFI = 44, 0, 16, 0 %,  ! related file, 3 words
    AREA$L_TOTAL_ALLOC = 50, 0, 32, 0 %;  ! blocks the area has

! $BKTDEF
LITERAL
    BKT$K_OVERHDSZ = 14,  ! the header's size
    BKT$V_LASTBKT = 0,  ! the last of its level
    BKT$V_ROOTBKT = 1,  ! the root
    BKT$V_PTR_SZ = 3,  ! index pointers' size less 2, 2 bits
    BKT$K_ENDOVHD = 4;  ! an index bucket's end: VBN free space word, 0, check character
MACRO
    BKT$B_CHECKCHAR = 0, 0, 8, 0 %,  ! as the bucket's last byte
    BKT$B_INDEXNO = 1, 0, 8, 0 %,  ! key of reference
    BKT$W_ADRSAMPLE = 2, 0, 16, 0 %,  ! low word of its VBN
    BKT$W_FREESPACE = 4, 0, 16, 0 %,  ! first free byte
    BKT$W_NXTRECID = 6, 0, 16, 0 %,  ! next record ID
    BKT$L_NXTBKT = 8, 0, 32, 0 %,  ! next bucket of the level
    BKT$B_LEVEL = 12, 0, 8, 0 %,  ! 0 for data and SIDR buckets
    BKT$B_BKTCB = 13, 0, 8, 0 %;  ! BKT$V_

! $IRCDEF
LITERAL
    IRC$K_HDRSZ = 9,  ! a data record's header, with a 4-byte pointer
    IRC$V_PTRSZ = 0,  ! the pointer's size less 2, 2 bits
    IRC$V_DELETED = 2,
    IRC$V_RRV = 3,  ! a record reference vector
    IRC$V_NOPTRSZ = 4,  ! no pointer: a deleted SIDR pointer
    IRC$V_FIRST = 7;  ! a SIDR's first pointer
MACRO
    IRC$B_CONTROL = 0, 0, 8, 0 %,  ! IRC$V_
    IRC$W_ID = 1, 0, 16, 0 %,  ! record ID
    IRC$W_RRV_ID = 3, 0, 16, 0 %,  ! its RFA's ID
    IRC$L_RRV_VBN = 5, 0, 32, 0 %;  ! and VBN

! $DLCDEF
LITERAL
    DLC$V_DELETED = 2,  ! a relative cell's record was deleted
    DLC$V_REC = 3;  ! it has a record

! $IDXDEF
LITERAL
    W$K_LENGTH = 576,
    X$K_WALK0 = 1908,  ! the walks
    X$K_WALK1 = 2484,
    X$K_WALK2 = 3060,
    X$K_LENGTH = 3636,
    X$C_BOF = 0,  ! before the first record
    X$C_AFTER = 1,  ! after the stream's record
    X$C_AT = 2,  ! at it: a $FIND found it
    X$C_EOF = 3,  ! past the last
    X$V_LASTPUT = 0,  ! X$T_LASTPUT holds a key
    X$V_OKDUP = 1;  ! a $PUT found a key it has
MACRO
    W$L_BUF = 0, 0, 32, 0 %,  ! the bucket's room
    W$L_VBN = 4, 0, 32, 0 %,  ! the bucket
    W$L_SIZE = 8, 0, 32, 0 %,  ! its bytes
    W$L_OFF = 12, 0, 32, 0 %,  ! the entry's offset
    W$L_FREE = 16, 0, 32, 0 %,  ! where the entries end
    W$L_INDEX = 20, 0, 32, 0 %,  ! the entry's number from 0
    W$L_CTL = 24, 0, 32, 0 %,  ! its control byte
    W$L_ID = 28, 0, 32, 0 %,  ! its ID
    W$L_RRVID = 32, 0, 32, 0 %,  ! a record's RFA, an RRV's new place, an index entry's pointer: ID
    W$L_RRVVBN = 36, 0, 32, 0 %,  ! and VBN
    W$L_BODY = 40, 0, 32, 0 %,  ! a record's or SIDR's body, after its size
    W$L_BLEN = 44, 0, 32, 0 %,  ! the body's bytes
    W$L_LEN = 48, 0, 32, 0 %,  ! the entry's bytes
    W$L_KLEN = 52, 0, 32, 0 %,  ! the bytes of its key in the body, before the rest
    W$L_PTR = 56, 0, 32, 0 %,  ! a SIDR's pointer
    W$L_PEND = 60, 0, 32, 0 %,  ! and where its pointers end
    W$T_PREV = 64, 0, 0, 0 %,  ! the key before the entry
    W$T_CUR = 320, 0, 0, 0 %,  ! the entry's key
    X$L_NKEYS = 0, 0, 32, 0 %,  ! keys
    X$L_NAREAS = 4, 0, 32, 0 %,  ! areas
    X$L_KEYS = 8, 0, 32, 0 %,  ! their descriptors, KEY$K_BLN each
    X$L_KLOC = 12, 0, 32, 0 %,  ! where each is: VBN and offset, a longword each
    X$L_AREAS = 16, 0, 32, 0 %,  ! area descriptors, AREA$K_BLN each
    X$L_AVBN = 20, 0, 32, 0 %,  ! the first area descriptor's VBN
    X$L_BKS = 24, 0, 32, 0 %,  ! the largest bucket, blocks
    X$L_BUF0 = 28, 0, 32, 0 %,  ! a bucket's room each: a descent's and walk 0's,
    X$L_BUF1 = 32, 0, 32, 0 %,  ! walk 1's: a record by RFA, a split's new bucket,
    X$L_BUF2 = 36, 0, 32, 0 %,  ! walk 2's: an RRV's bucket
    X$L_WORK = 40, 0, 32, 0 %,  ! a record being made
    X$L_LEVEL = 44, 0, 32, 0 %,  ! a descent's level
    X$B_KRF = 48, 0, 8, 0 %,  ! the stream's key of reference
    X$B_STATE = 49, 0, 8, 0 %,  ! X$C_: where the stream is
    X$W_CURID = 50, 0, 16, 0 %,  ! the current record's RFA: ID,
    X$L_CURVBN = 52, 0, 32, 0 %,  ! and VBN, 0 if there is none
    X$L_CTXVBN = 56, 0, 32, 0 %,  ! the stream's record's RFA: VBN,
    X$W_CTXID = 60, 0, 16, 0 %,  ! and ID
    X$W_FLAGS = 62, 0, 16, 0 %,  ! X$V_
    X$T_CTXKEY = 64, 0, 0, 0 %,  ! and its key along X$B_KRF
    X$T_KEY = 320, 0, 0, 0 %,  ! a key looked for or made
    X$T_KEY2 = 576, 0, 0, 0 %,  ! another
    X$L_PATH = 832, 0, 32, 0 %,  ! a descent's buckets and entries, a quadword a level
    X$T_LASTPUT = 1088, 0, 0, 0 %,  ! the key of the last $PUT by RAB$C_SEQ
    X$T_QPREV = 1344, 0, 0, 0 %,  ! where a key goes in a bucket: the key before,
    X$T_QCUR = 1600, 0, 0, 0 %,  ! and the entry's there
    X$L_Q = 1856, 0, 32, 0 %,  ! that entry's number,
    X$L_QOFF = 1860, 0, 32, 0 %,  ! and offset
    X$L_N = 1864, 0, 32, 0 %,  ! the bucket's records or SIDRs
    X$L_END = 1868, 0, 32, 0 %,  ! and where they end, before its RRVs
    X$L_WORK2 = 1872, 0, 32, 0 %,  ! another record being made
    X$L_WORKSZ = 1876, 0, 32, 0 %,  ! X$L_WORK's bytes
    X$L_NMOV = 1880, 0, 32, 0 %,  ! records a split moved, in X$L_WORK2: home VBN, ID, new ID
    X$L_RVBN = 1884, 0, 32, 0 %,  ! a split's new bucket
    X$L_RFAVBN = 1888, 0, 32, 0 %,  ! a record's RFA, being put: VBN,
    X$W_RFAID = 1892, 0, 16, 0 %,  ! and ID
    X$L_PRREC = 1896, 0, 32, 0 %,  ! a record being packed,
    X$L_PRLEN = 1900, 0, 32, 0 %,  ! and its size
    X$L_M = 1904, 0, 32, 0 %;  ! a split's first entry that goes
