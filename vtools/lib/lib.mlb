; lib.mlb: definitions executive code uses, like VMS's LIB.MLB. Use it with
; .LIBRARY "lib.mlb" and vasm -I vtools/lib.

; $PRDEF: the VAX processor registers every VAX has, PR$_name, the numbers
; MTPR and MFPR take. vmacro compiles those it has PAL calls for
; (docs/design/0001-pal-interface.md at the repository root).
        .MACRO  $PRDEF
PR$_KSP = 0                             ; stack pointers, per access mode
PR$_ESP = 1
PR$_SSP = 2
PR$_USP = 3
PR$_ISP = 4                             ; interrupt stack pointer
PR$_P0BR = 8                            ; page table base and length
PR$_P0LR = 9
PR$_P1BR = 10
PR$_P1LR = 11
PR$_SBR = 12
PR$_SLR = 13
PR$_PCBB = 16                           ; process control block base
PR$_SCBB = 17                           ; system control block base
PR$_IPL = 18                            ; interrupt priority level
PR$_ASTLVL = 19
PR$_SIRR = 20                           ; software interrupt request
PR$_SISR = 21                           ; software interrupt summary
PR$_ICCS = 24                           ; interval clock control
PR$_RXCS = 32                           ; console receive status and data
PR$_RXDB = 33
PR$_TXCS = 34                           ; console transmit status and data
PR$_TXDB = 35
PR$_MAPEN = 56                          ; memory management enable
PR$_TBIA = 57                           ; translation buffer invalidates
PR$_TBIS = 58
PR$_SID = 62                            ; system identification
PR$_TBCHK = 63
        .ENDM   $PRDEF

; $PALDEF: function codes for CALL_PAL, the PAL calls that have no VAX
; instruction (docs/design/0001-pal-interface.md). Arguments go in R0-R5,
; the result comes back in R0.
        .MACRO  $PALDEF
PAL$_HALT = ^X00
PAL$_SWPCTX = ^X05                      ; R0 = new HWPCB; R0 = the one left
PAL$_WTINT = ^X3E                       ; wait for an interrupt
PAL$_WRPTE = ^X41                       ; R0 = address, R1 = PTE; R0 = old PTE
PAL$_DELCTX = ^X42                      ; R0 = HWPCB of a context to delete
PAL$_READLBLK = ^X46                    ; R0 = buffer, R1 = byte count, R2 = LBN; R0 = status
        .ENDM   $PALDEF

; $IPLDEF: interrupt priority levels the executive synchronizes at.
        .MACRO  $IPLDEF
IPL$_ASTDEL = 2                         ; AST delivery
IPL$_RESCHED = 3                        ; rescheduling software interrupt
IPL$_IOPOST = 4                         ; I/O post processing
IPL$_TIMER = 7                          ; software timer: quantum end
IPL$_SYNCH = 8                          ; the scheduler's database
IPL$_CONSOLE = 20                       ; console receive interrupt
IPL$_HWCLK = 24                         ; interval timer interrupt
IPL$_POWER = 31                         ; everything blocked
        .ENDM   $IPLDEF

; SETIPL, DSBINT, ENBINT, SOFTINT: VMS's IPL macros. DSBINT saves the IPL
; (on the stack unless DST says) and raises it; ENBINT puts it back.
        .MACRO  SETIPL  IPL=#31
        MTPR    IPL, #18                ; PR$_IPL
        .ENDM   SETIPL

        .MACRO  DSBINT  IPL=#31, DST=-(SP)
        MFPR    #18, DST
        MTPR    IPL, #18
        .ENDM   DSBINT

        .MACRO  ENBINT  SRC=(SP)+
        MTPR    SRC, #18
        .ENDM   ENBINT

        .MACRO  SOFTINT LEVEL
        MTPR    LEVEL, #20              ; PR$_SIRR
        .ENDM   SOFTINT

; IFNORD, IFNOWRT: VMS's checks of an address a caller passed: branch to
; DEST unless MODE, or the previous mode if it is an outer one, may read
; (write) the first and last of SIZ bytes at ADR.
        .MACRO  IFNORD  SIZ, ADR, DEST, MODE=#0
        PROBER  MODE, SIZ, ADR
        BEQL    DEST
        .ENDM   IFNORD

        .MACRO  IFNOWRT SIZ, ADR, DEST, MODE=#0
        PROBEW  MODE, SIZ, ADR
        BEQL    DEST
        .ENDM   IFNOWRT

; $SCBDEF: system control block vectors the PAL delivers through, at the
; VAX's offsets. Each holds the handler's address, a longword.
        .MACRO  $SCBDEF
SCB$L_OPCDEC = ^X10                     ; reserved or privileged instruction
SCB$L_ACCVIO = ^X20                     ; access violation: a mask and the address
SCB$L_CHMK = ^X40                       ; change mode to kernel
SCB$L_CHME = ^X44                       ; to executive
SCB$L_CHMS = ^X48                       ; to supervisor
SCB$L_CHMU = ^X4C                       ; to user
SCB$L_SOFTINT = ^X80                    ; software interrupt level n at +4*n
SCB$L_INTTIM = ^XC0                     ; interval timer, at IPL$_HWCLK
SCB$L_CONSRCV = ^XF8                    ; console receive, at IPL$_CONSOLE
SCB$K_LENGTH = ^XFC
        .ENDM   $SCBDEF

; $INTSTKDEF: the frame the PAL pushes on the stack of the mode it delivers
; an interrupt or an exception in, and REI pops. Quadwords: the registers
; the interrupted code may have live that VAX code doesn't save. An
; exception with parameters pushes them below the frame, and its handler
; pops them before REI.
        .MACRO  $INTSTKDEF
INTSTK$Q_PC = 0
INTSTK$Q_PS = 8                         ; the PSL ($PSLDEF): modes, IPL, NZVC
INTSTK$Q_R7 = 16
INTSTK$Q_SP = 24                        ; the interrupted mode's VAX SP
INTSTK$Q_X_SP = 32                      ; ARM64's sp
INTSTK$Q_X13 = 40                       ; x13-x18, vmacro's scratch
INTSTK$Q_X30 = 88                       ; the link register
INTSTK$K_LENGTH = 96
        .ENDM   $INTSTKDEF

; $HWPCBDEF: the hardware PCB the PAL knows a process context by. Quadword
; aligned. When a context first runs, the PAL pops an INTSTK frame from
; its KSP, as REI does. Each mode's stack pointer is where the PAL pushes
; a frame on entering it from an outer mode, and where it saves the stack
; pointer of a mode it leaves for another.
        .MACRO  $HWPCBDEF
HWPCB$Q_KSP = 0                         ; kernel stack pointer
HWPCB$Q_ESP = 8                         ; executive
HWPCB$Q_SSP = 16                        ; supervisor
HWPCB$Q_USP = 24                        ; user
HWPCB$K_LENGTH = 128
        .ENDM   $HWPCBDEF

; $PTEDEF: a page table entry, as WRPTE takes it: the VAX's, with an
; execute bit, which ARM64 has and the VAX didn't. Pages are 4 KB.
        .MACRO  $PTEDEF
PTE$V_VALID = 31
PTE$M_VALID = ^X80000000
PTE$V_PROT = 27                         ; 4 bits, PRT$C_ codes
PTE$V_EXEC = 25
PTE$M_EXEC = ^X02000000
PTE$M_PFN = ^X001FFFFF
MMG$C_PAGESIZE = 4096
MMG$C_VPCTX = 12                        ; address bits in a page
        .ENDM   $PTEDEF

; $VADEF: the address space every process sees, below 2 GB: P0 and P1 are
; its own, S0 the system's, which all share.
        .MACRO  $VADEF
VA$C_P0BASE = ^X00001000                ; page 0 is never mapped
VA$C_S0BASE = ^X40000000                ; past P0's end
VA$C_P1BASE = ^X60000000                ; past S0's end
VA$C_CLI = ^X7FF00000                   ; a command interpreter's image, up to the stacks
VA$C_STACKS = ^X7FFE4000                ; the mode stacks, executive's first
VA$C_ESP = ^X7FFE8000                   ; the executive stack's top
VA$C_SSP = ^X7FFEC000                   ; the supervisor stack's top
VA$C_USP = ^X7FFF0000                   ; the user stack's top
VA$C_FOREIGN = ^X7FFEFF00               ; an image's command line, .ASCIC, from $IMGACT, above its stack
VA$C_P1END = ^X7FFF0000
        .ENDM   $VADEF

; $RPBDEF: the restart parameter block, which the PAL fills before the
; executive starts and passes in R11.
        .MACRO  $RPBDEF
RPB$L_BASE = 0                          ; the RPB's own address
RPB$L_PFNCNT = 4                        ; PFNs 0 to PFNCNT-1 are the executive's
RPB$L_FREEPFN = 8                       ; and those below this one are in use
RPB$L_BOOTTIME = 12                     ; seconds since 1970 at boot, from the RTC
RPB$Q_HWPCB = 64                        ; the boot context's HWPCB
RPB$K_LENGTH = 192
        .ENDM   $RPBDEF

; $STATEDEF: scheduling states, SCH$C_.
        .MACRO  $STATEDEF
SCH$C_MWAIT = 2                         ; resource wait: the console, for a read
SCH$C_CEF = 3                           ; common event flag wait
SCH$C_LEF = 5                           ; local event flag wait
SCH$C_HIB = 7                           ; hibernating
SCH$C_SUSP = 9                          ; suspended
SCH$C_COM = 12                          ; computable
SCH$C_CUR = 14                          ; current
SCH$C_MAXPIX = 32                       ; process slots: index 0 unused, 1 the swapper
        .ENDM   $STATEDEF

; $PCBDEF: the software process control block.
        .MACRO  $PCBDEF
PCB$L_SQFL = 0                          ; state queue: COM queue or a wait queue
PCB$L_SQBL = 4
PCB$W_SIZE = 8
PCB$B_TYPE = 10
PCB$B_PRI = 11                          ; current priority, 0-31, higher first
PCB$L_STATE = 12                        ; SCH$C_
PCB$L_PID = 16
PCB$L_STS = 20                          ; PCB$V_
PCB$L_EFCS = 24                         ; event flags 0-31
PCB$L_EFCU = 28                         ; 32-63
PCB$L_EFC2P = 32                        ; common cluster 2 (64-95): its CEB
PCB$L_EFC3P = 36                        ; 3 (96-127)
PCB$L_EFWM = 40                         ; a wait's flags
PCB$L_WEFC = 44                         ; and their cluster, 0-3
PCB$L_KSTACK = 48                       ; kernel stack, from pool
PCB$L_HWPCB = 52                        ; the HWPCB the PAL knows it by
PCB$L_FREP0VA = 56                      ; past its last P0 page
PCB$L_FREP1VA = 60                      ; its first P1 page
PCB$B_PRIB = 64                         ; base priority
PCB$W_QUANT = 66                        ; -ticks left of its quantum
PCB$L_OWNER = 68                        ; creator's PID
PCB$T_LNAME = 72                        ; process name, .ASCIC, 15 characters
PCB$T_IMAGE = 88                        ; image name, .ASCIC, 39 characters
PCB$Q_HWPCB = 128                       ; its HWPCB, if it isn't the boot one
PCB$L_CHANS = 256                       ; bit n: channel n is assigned
PCB$L_CLI = 260                         ; its command interpreter's transfer address, or 0
PCB$L_CLICHANS = 264                    ; the channels it keeps when an image exits
PCB$A_IFAB = 272                        ; its open files' IFABs, by IFI 1-15, or 0
PCB$L_FILES = 336                       ; bit n: IFI n is open
PCB$L_CLIFILES = 340                    ; the files it keeps open when an image exits
PCB$Q_LNMHD = 344                       ; its logical name table, LNM$PROCESS_TABLE: LNMBs
PCB$T_DEFDIR = 352                      ; default directory, .ASCIC, 63 characters: $SETDDIR's
PCB$K_LENGTH = 416
PCB$V_WAKEPEN = 0                       ; a $WAKE came while not hibernating
PCB$V_WALL = 1                          ; the wait is for all of EFWM
PCB$V_SUSPEN = 2                        ; suspend when the wait ends
PCB$V_DELPEN = 3                        ; delete it when it next has the CPU
DYN$C_PCB = 1                           ; PCB$B_TYPE
        .ENDM   $PCBDEF

; $CEBDEF: a common event block, a named cluster of 32 common event flags.
        .MACRO  $CEBDEF
CEB$L_CEBFL = 0                         ; all clusters
CEB$L_CEBBL = 4
CEB$L_WQFL = 8                          ; processes waiting on it
CEB$L_WQBL = 12
CEB$L_EFC = 16                          ; the flags
CEB$L_REFC = 20                         ; processes associated
CEB$T_EFCNAM = 24                       ; name, .ASCIC, 15 characters
CEB$K_LENGTH = 48
        .ENDM   $CEBDEF

; $LNMBDEF: a logical name block, from pool, on its table's queue: a
; logical name and its equivalence string.
        .MACRO  $LNMBDEF
LNMB$L_FLINK = 0                        ; the table
LNMB$L_BLINK = 4
LNMB$W_SIZE = 8                         ; its size, as allocated
LNMB$T_NAME = 10                        ; the name, .ASCIC, then the equivalence, .ASCIC
LNMB$K_LENGTH = 10                      ; past that, both strings
        .ENDM   $LNMBDEF

; $TQEDEF: a timer queue entry, from pool, on EXE$GQ_TQFL in the order it
; is due. Times are VMS's: 100 ns units since 17-Nov-1858.
        .MACRO  $TQEDEF
TQE$L_TQFL = 0                          ; timer queue
TQE$L_TQBL = 4
TQE$W_SIZE = 8
TQE$B_TYPE = 10
TQE$B_RQTYPE = 11                       ; TQE$C_
TQE$L_PID = 12                          ; the process it is for
TQE$L_ASTPRM = 16                       ; $SETIMR's reqidt
TQE$L_EFN = 20                          ; $SETIMR's event flag
TQE$Q_TIME = 24                         ; when it is due
TQE$Q_DELTA = 32                        ; a repeating $SCHDWK's interval
TQE$K_LENGTH = 48
TQE$C_TMSNGL = 0                        ; $SETIMR: sets an event flag
TQE$C_WKSNGL = 1                        ; $SCHDWK: wakes the process
TQE$C_WKREPT = 2                        ; and again every TQE$Q_DELTA
DYN$C_TQE = 15                          ; TQE$B_TYPE
        .ENDM   $TQEDEF
