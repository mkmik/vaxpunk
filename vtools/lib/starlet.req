    PRV$V_ALLSPOOL = 4,
    PRV$V_DETACH = 5,  ! a process with another UIC
    PRV$V_DIAGNOSE = 6,
    PRV$V_LOG_IO = 7,  ! a disk's blocks by LBN
    PRV$V_GROUP = 8,  ! other processes in its UIC group
    PRV$V_NOACNT = 9,
    PRV$V_PRMCEB = 10,
    PRV$V_PRMMBX = 11,  ! permanent mailboxes
    PRV$V_PSWAPM = 12,
    PRV$V_ALTPRI = 13,
    PRV$V_SETPRV = 14,  ! any privilege, not just the authorized ones
    PRV$V_TMPMBX = 15,  ! temporary mailboxes
    PRV$V_WORLD = 16,  ! any other process
    PRV$V_MOUNT = 17,
    PRV$V_OPER = 18,  ! the operator's: the network's interface
    PRV$V_EXQUOTA = 19,
    PRV$V_NETMBX = 20,
    PRV$V_VOLPRO = 21,  ! INITIALIZE a volume
    PRV$V_PHY_IO = 22,  ! a disk's blocks, physical or logical
    PRV$V_BUGCHK = 23,
    PRV$V_PRMGBL = 24,
    PRV$V_SYSGBL = 25,
    PRV$V_PFNMAP = 26,
    PRV$V_SHMEM = 27,
    PRV$V_SYSPRV = 28,
    PRV$V_BYPASS = 29,
    PRV$V_SYSLCK = 30,
    PRV$V_SHARE = 31,
    PRV$V_UPGRADE = 32,
    PRV$V_DOWNGRADE = 33,
    PRV$V_GRPPRV = 34,
    PRV$V_READALL = 35,
    PRV$V_IMPORT = 36,
    PRV$V_AUDIT = 37,
    PRV$V_SECURITY = 38,
    PRV$K_NUMBER = 39,  ! how many there are
    PRV$M_CMKRNL = 1,
    PRV$M_CMEXEC = 2,
    PRV$M_SYSNAM = 4,
    PRV$M_DETACH = 32,
    PRV$M_LOG_IO = 128,
    PRV$M_GROUP = 256,
    PRV$M_PRMMBX = 2048,
    PRV$M_SETPRV = 16384,
    PRV$M_TMPMBX = 32768,
    PRV$M_WORLD = 65536,
    PRV$M_OPER = 262144,
    PRV$M_VOLPRO = 2097152,
    PRV$M_PHY_IO = 4194304,
    PRV$M_SYSPRV = 268435456,
    PRV$M_BYPASS = 536870912;

