    PRT$C_NA = 0,
    PRT$C_KW = 2,
    PRT$C_KR = 3,
    PRT$C_UW = 4,
    PRT$C_EW = 5,
    PRT$C_ERKW = 6,
    PRT$C_ER = 7,
    PRT$C_SW = 8,
    PRT$C_SREW = 9,
    PRT$C_SRKW = 10,
