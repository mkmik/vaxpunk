    SS$_IVMODE = 852,
    SS$_MBTOOSML = 412,  ! the message is longer than the mailbox takes
    SS$_OPCDEC = 1084,
    SS$_NOTALLPRIV = 1665,  ! success: $SETPRV enabled only the privileges it may
    SS$_BUFFEROVF = 1537,  ! success: the output didn't all fit in the buffer
    SS$_CONTROLY = 1553,  ! CTRL/Y stopped the image
    SS$_CONTROLC = 1617,  ! CTRL/C, which no CTRL/C AST took, stopped the image
    SS$_CREATED = 1561,  ! success: it wasn't there, and was made
