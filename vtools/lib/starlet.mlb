RMS$_REENT = ^X1C15C                    ; file could not be renamed and recovery failed; file has been lost
RMS$_ACC_RUJ = ^X1C164                  ; recovery unit journal can not be accessed
RMS$_TMR = ^X1C16C                      ; SETIMR system service request failed
RMS$_ACC_AIJ = ^X1C174                  ; after image journal can not be accessed
RMS$_ACC_BIJ = ^X1C17C                  ; before image journal can not be accessed
RMS$_ACC_ATJ = ^X1C184                  ; audit trail journal can not be accessed
RMS$_DTFDEFFIL = ^X1C18C                ; error accessing file definition file
RMS$_DTFREGFIL = ^X1C194                ; error accessing registration file
RMS$_JNLNOTAUTH = ^X1C19C               ; RMS Journaling not authorized; operation not performed
RMS$_CRBUFOBJ = ^X1C1A4                 ; CREATE_BUFOBJ system service failed to create buffer object
RMS$_RSESTK_ALLOC = ^X1C1AC             ; allocation of KP RSE stack failed
        .ENDM   $RMSDEF

; $FABDEF: the file access block (VMS's layout).
        .MACRO  $FABDEF
FAB$C_BID = 3
FAB$C_BLN = 80
FAB$K_BLN = 80
FAB$B_BID = 0
FAB$B_BLN = 1
FAB$W_IFI = 2                           ; internal file index, from $OPEN or $CREATE
FAB$L_FOP = 4                           ; file processing options: FAB$M_
FAB$L_STS = 8                           ; the status of the last operation
FAB$L_STV = 12                          ; its secondary status
FAB$L_ALQ = 16                          ; blocks allocated
FAB$W_DEQ = 20                          ; default extension, blocks
FAB$B_FAC = 22                          ; access wanted: FAB$M_PUT to FAB$M_BRO
FAB$B_SHR = 23                          ; access others may have: FAB$M_SHRPUT to FAB$M_NQL
FAB$L_CTX = 24                          ; the caller's
FAB$B_RTV = 28                          ; retrieval window size
FAB$B_ORG = 29                          ; organization: FAB$C_SEQ, REL or IDX
FAB$B_RAT = 30                          ; record attributes: FAB$M_FTN to FAB$M_BLK
FAB$B_RFM = 31                          ; record format: FAB$C_UDF to FAB$C_STMCR
FAB$B_JOURNAL = 32
FAB$L_XAB = 36                          ; the first XAB, or 0
FAB$L_NAM = 40                          ; a NAM block, or 0
FAB$L_FNA = 44                          ; the file specification
FAB$L_DNA = 48                          ; the default one
FAB$B_FNS = 52                          ; their lengths
FAB$B_DNS = 53
FAB$W_MRS = 54                          ; maximum record size, 0 for any
FAB$L_MRN = 56                          ; maximum record number of a relative file
FAB$W_BLS = 60                          ; block size, magnetic tape
FAB$B_BKS = 62                          ; bucket size, blocks
FAB$B_FSZ = 63                          ; VFC header size
FAB$L_DEV = 64                          ; device characteristics, from $OPEN
FAB$L_SDC = 68                          ; spooling device's
FAB$W_GBC = 72                          ; global buffer count
; FAB$L_FOP
FAB$V_MXV = 1                           ; $CREATE: a version above the highest
FAB$M_MXV = ^X2
FAB$V_SUP = 2                           ; $CREATE: supersede a version that exists
FAB$M_SUP = ^X4
FAB$V_TMP = 3                           ; temporary: no directory entry
FAB$M_TMP = ^X8
FAB$V_TMD = 4                           ; temporary, deleted when closed
FAB$M_TMD = ^X10
FAB$V_DFW = 5                           ; deferred write
FAB$M_DFW = ^X20
FAB$V_SQO = 6                           ; sequential access only
FAB$M_SQO = ^X40
FAB$V_RWO = 7                           ; rewind on open
FAB$M_RWO = ^X80
FAB$V_POS = 8
FAB$M_POS = ^X100
FAB$V_WCK = 9                           ; write check
FAB$M_WCK = ^X200
FAB$V_NEF = 10                          ; don't position to end of file
FAB$M_NEF = ^X400
FAB$V_RWC = 11                          ; rewind on close
FAB$M_RWC = ^X800
FAB$V_DMO = 12
FAB$M_DMO = ^X1000
FAB$V_SPL = 13                          ; spool when closed
FAB$M_SPL = ^X2000
FAB$V_SCF = 14                          ; submit as a batch job when closed
FAB$M_SCF = ^X4000
FAB$V_DLT = 15                          ; delete when closed
FAB$M_DLT = ^X8000
FAB$V_NFS = 16                          ; non-file-structured
FAB$M_NFS = ^X10000
FAB$V_UFO = 17                          ; user file open: no RMS
FAB$M_UFO = ^X20000
FAB$V_PPF = 18
FAB$M_PPF = ^X40000
FAB$V_INP = 19
FAB$M_INP = ^X80000
FAB$V_CTG = 20                          ; contiguous
FAB$M_CTG = ^X100000
FAB$V_CBT = 21                          ; contiguous best try
FAB$M_CBT = ^X200000
FAB$V_RCK = 23                          ; read check
FAB$M_RCK = ^X800000
FAB$V_NAM = 24                          ; the file the NAM block names, by its resultant string
FAB$M_NAM = ^X1000000
FAB$V_CIF = 25                          ; $CREATE: open the file if it exists
FAB$M_CIF = ^X2000000
FAB$V_ESC = 27
FAB$M_ESC = ^X8000000
FAB$V_TEF = 28                          ; truncate at end of file when closed
FAB$M_TEF = ^X10000000
FAB$V_OFP = 29                          ; output file parse
FAB$M_OFP = ^X20000000
FAB$V_KFO = 30
FAB$M_KFO = ^X40000000
; FAB$B_FAC
FAB$V_PUT = 0
FAB$M_PUT = 1
FAB$V_GET = 1
FAB$M_GET = 2
FAB$V_DEL = 2
FAB$M_DEL = 4
FAB$V_UPD = 3
FAB$M_UPD = 8
FAB$V_TRN = 4                           ; $TRUNCATE
FAB$M_TRN = 16
FAB$V_BIO = 5                           ; block I/O only
FAB$M_BIO = 32
FAB$V_BRO = 6                           ; block and record I/O
FAB$M_BRO = 64
FAB$V_EXE = 7
FAB$M_EXE = 128
; FAB$B_SHR
FAB$V_SHRPUT = 0
FAB$M_SHRPUT = 1
FAB$V_SHRGET = 1
FAB$M_SHRGET = 2
FAB$V_SHRDEL = 2
FAB$M_SHRDEL = 4
FAB$V_SHRUPD = 3
FAB$M_SHRUPD = 8
FAB$V_MSE = 4                           ; several streams
FAB$M_MSE = 16
FAB$V_NIL = 5                           ; no sharing
FAB$M_NIL = 32
FAB$V_UPI = 6                           ; user provided interlock
FAB$M_UPI = 64
; FAB$B_ORG
FAB$V_ORG = 4
FAB$S_ORG = 4
FAB$C_SEQ = 0
FAB$C_REL = 16
FAB$C_IDX = 32
FAB$C_HSH = 48
; FAB$B_RAT
FAB$V_FTN = 0                           ; FORTRAN carriage control
FAB$M_FTN = 1
FAB$V_CR = 1                            ; carriage return carriage control
FAB$M_CR = 2
FAB$V_PRN = 2                           ; print carriage control, in the VFC header
FAB$M_PRN = 4
FAB$V_BLK = 3                           ; records don't span blocks
FAB$M_BLK = 8
FAB$V_MSB = 4                           ; VAR sizes most significant byte first
FAB$M_MSB = 16
; FAB$B_RFM
FAB$C_UDF = 0                           ; undefined: block I/O only
FAB$C_FIX = 1
FAB$C_VAR = 2
FAB$C_VFC = 3                           ; VAR with a fixed control header
FAB$C_STM = 4                           ; stream: CR LF ends a record
FAB$C_STMLF = 5
FAB$C_STMCR = 6
FAB$C_MAXRFM = 6
        .ENDM   $FABDEF

; $RABDEF: the record access block (VMS's layout).
        .MACRO  $RABDEF
RAB$C_BID = 1
RAB$C_BLN = 68
RAB$K_BLN = 68
RAB$B_BID = 0
RAB$B_BLN = 1
RAB$W_ISI = 2                           ; internal stream index, from $CONNECT
RAB$L_ROP = 4                           ; record processing options: RAB$M_
RAB$L_STS = 8
RAB$L_STV = 12
RAB$W_RFA = 16                          ; the record's file address, 6 bytes
RAB$L_RFA0 = 16                         ; its VBN, or a relative record number
RAB$W_RFA4 = 20                         ; its ID, or a sequential record's offset in the block
RAB$L_CTX = 24                          ; the caller's
RAB$B_RAC = 30                          ; record access: RAB$C_SEQ, KEY or RFA
RAB$B_TMO = 31                          ; timeout, seconds
RAB$W_USZ = 32                          ; the user's buffer: its size
RAB$W_RSZ = 34                          ; the record's size
RAB$L_UBF = 36                          ; the user's buffer
RAB$L_RBF = 40                          ; where $GET put the record, what $PUT writes
RAB$L_RHB = 44                          ; a VFC record's fixed control header
RAB$L_KBF = 48                          ; the key, or relative record number
RAB$L_PBF = 48                          ; the prompt, for terminals
RAB$B_KSZ = 52                          ; the key's size
RAB$B_PSZ = 52
RAB$B_KRF = 53                          ; key of reference
RAB$B_MBF = 54                          ; multibuffer count
RAB$B_MBC = 55                          ; multiblock count
RAB$L_BKT = 56                          ; bucket or VBN, for $READ, $WRITE, $SPACE; a relative file's record number
RAB$L_FAB = 60                          ; the FAB $CONNECT connects to
RAB$L_XAB = 64
; RAB$L_ROP
RAB$V_ASY = 0                           ; asynchronous
RAB$M_ASY = ^X1
RAB$V_TPT = 1                           ; $PUT truncates the file after the record
RAB$M_TPT = ^X2
RAB$V_REA = 2                           ; lock for read
RAB$M_REA = ^X4
RAB$V_RRL = 3                           ; read regardless of lock
RAB$M_RRL = ^X8
RAB$V_UIF = 4                           ; $PUT of a record that exists updates it
RAB$M_UIF = ^X10
RAB$V_MAS = 5                           ; mass insert
RAB$M_MAS = ^X20
RAB$V_FDL = 6                           ; fast delete
RAB$M_FDL = ^X40
RAB$V_REV = 7                           ; reverse search
RAB$M_REV = ^X80
RAB$V_EOF = 8                           ; $CONNECT at the end of the file
RAB$M_EOF = ^X100
RAB$V_RAH = 9                           ; read ahead
RAB$M_RAH = ^X200
RAB$V_WBH = 10                          ; write behind
RAB$M_WBH = ^X400
RAB$V_BIO = 11                          ; block I/O on a FAB$M_BRO file
RAB$M_BIO = ^X800
RAB$V_CDK = 12
RAB$M_CDK = ^X1000
RAB$V_LOA = 13                          ; load buckets to their fill quantity
RAB$M_LOA = ^X2000
RAB$V_LIM = 14
RAB$M_LIM = ^X4000
RAB$V_LOC = 16                          ; locate mode: RBF may point into RMS's buffer
RAB$M_LOC = ^X10000
RAB$V_WAT = 17                          ; wait for a locked record
RAB$M_WAT = ^X20000
RAB$V_ULK = 18                          ; manual unlocking
RAB$M_ULK = ^X40000
RAB$V_RLK = 19                          ; lock for write, others may read
RAB$M_RLK = ^X80000
RAB$V_NLK = 20                          ; no lock
RAB$M_NLK = ^X100000
RAB$V_KGE = 21                          ; key greater than or equal
RAB$M_KGE = ^X200000
RAB$V_EQNXT = 21
RAB$M_EQNXT = ^X200000
RAB$V_KGT = 22                          ; key greater than
RAB$M_KGT = ^X400000
RAB$V_NXT = 22
RAB$M_NXT = ^X400000
RAB$V_NXR = 23                          ; nonexistent record
RAB$M_NXR = ^X800000
RAB$V_RNE = 24                          ; terminals: no echo
RAB$M_RNE = ^X1000000
RAB$V_TMO = 25                          ; timeout
RAB$M_TMO = ^X2000000
RAB$V_CVT = 26                          ; convert to upper case
RAB$M_CVT = ^X4000000
RAB$V_RNF = 27                          ; no filter
RAB$M_RNF = ^X8000000
RAB$V_PMT = 30                          ; prompt
RAB$M_PMT = ^X40000000
RAB$V_CCO = 31                          ; cancel CTRL/O
RAB$M_CCO = ^X80000000
; RAB$B_RAC
RAB$C_SEQ = 0                           ; sequential
RAB$C_KEY = 1                           ; by key, or relative record number
RAB$C_RFA = 2                           ; by record's file address
        .ENDM   $RABDEF

; $NAMDEF: the name block, which $PARSE, $SEARCH and $OPEN fill.
        .MACRO  $NAMDEF
NAM$C_BID = 2
NAM$C_BLN = 96
NAM$B_BID = 0
NAM$B_BLN = 1
NAM$B_RSS = 2                           ; the resultant string area: size
NAM$B_RSL = 3                           ; the string's length
NAM$L_RSA = 4                           ; its address
NAM$B_ESS = 10                          ; the expanded string area: size
NAM$B_ESL = 11
NAM$L_ESA = 12
NAM$W_FID = 36                          ; file ID, 3 words
NAM$W_DID = 42                          ; directory ID, 3 words
NAM$L_WCC = 48                          ; $SEARCH's context
NAM$L_FNB = 52                          ; NAM$M_ bits
NAM$B_DEV = 57                          ; the lengths of the string's parts
NAM$B_DIR = 58
NAM$B_NAME = 59
NAM$B_TYPE = 60
NAM$B_VER = 61
NAM$L_DEV = 68                          ; and their addresses
NAM$L_DIR = 72
NAM$L_NAME = 76
NAM$L_TYPE = 80
NAM$L_VER = 84
NAM$M_WILDCARD = ^X100                  ; the specification has a wildcard
        .ENDM   $NAMDEF

; $DVIDEF: $GETDVI's item codes, VMS's, those vaxpunk knows.
        .MACRO  $DVIDEF
DVI$_DEVCHAR = 2                        ; the DEV$ bits, a longword
DVI$_DEVCLASS = 4                       ; DC$_DISK or DC$_TERM
DVI$_DEVTYPE = 6                        ; a terminal's DT$ type
DVI$_DEVBUFSIZ = 8                      ; a terminal's width, a disk's block size
DVI$_DEVDEPEND = 10                     ; a terminal's TT$ bits, its page in the top byte
DVI$_UNIT = 12
DVI$_ERRCNT = 20
DVI$_DEVDEPEND2 = 28                    ; a terminal's TT2$ bits
DVI$_REFCNT = 30                        ; the channels assigned to it
DVI$_DEVNAM = 32                        ; the device's name, _DDCU:
DVI$_VOLNAM = 34                        ; the mounted volume's label
DVI$_FREEBLOCKS = 42                    ; its free blocks
DVI$_MOUNTCNT = 56                      ; 1 if a volume is mounted, else 0
DVI$_CLUSTER = 58                       ; its cluster, in blocks
DVI$_AVL = 98                           ; DEVCHAR's bits, each 1 or 0
DVI$_MNT = 100
DVI$_SWL = 112
DVI$_STS = 226                          ; the UCB$ status bits: UCB$M_ONLINE
        .ENDM   $DVIDEF

; $DVSDEF: $DEVICE_SCAN's item codes.
        .MACRO  $DVSDEF
DVS$_DEVCLASS = 1                       ; only devices of this class, a longword
        .ENDM   $DVSDEF

; $DCDEF: device classes.
        .MACRO  $DCDEF
DC$_DISK = 1
DC$_TERM = 66
DC$_MAILBOX = 160
DT$_VT100 = 96                          ; a terminal's type: a VT100
        .ENDM   $DCDEF

; $TTDEF: a terminal's characteristics, the second longword of what
; IO$_SETMODE and IO$_SENSEMODE take and give, and DVI$_DEVDEPEND: the
; page length in the top byte.
        .MACRO  $TTDEF
TT$V_PASSALL = 0                        ; no editing and no control keys
TT$V_NOECHO = 1                         ; reads don't echo
TT$V_NOTYPEAHD = 2
TT$V_ESCAPE = 3                         ; reads end at an escape sequence
TT$V_HOSTSYNC = 4
TT$V_TTSYNC = 5
TT$V_LOWER = 7                          ; it has lowercase
TT$V_MECHTAB = 8                        ; it has tab stops
TT$V_WRAP = 9                           ; it wraps at its width
TT$V_SCOPE = 12                         ; a screen, not paper
TT$V_REMOTE = 13
TT$V_EIGHTBIT = 15
TT$V_NOBRDCST = 17                      ; no broadcast messages
TT$V_READSYNC = 18
TT$V_MECHFORM = 19
TT$V_HALFDUP = 20
TT$V_MODEM = 21
TT$V_PAGE = 24                          ; the page length, a byte
TT$M_NOECHO = ^X2
TT$M_ESCAPE = ^X8
TT$M_TTSYNC = ^X20
TT$M_LOWER = ^X80
TT$M_MECHTAB = ^X100
TT$M_WRAP = ^X200
TT$M_SCOPE = ^X1000
TT$M_EIGHTBIT = ^X8000
TT$M_NOBRDCST = ^X20000
        .ENDM   $TTDEF

; $TT2DEF: a terminal's extended characteristics, the third longword of
; IO$_SETMODE's and IO$_SENSEMODE's buffer, and DVI$_DEVDEPEND2.
        .MACRO  $TT2DEF
TT2$V_LOCALECHO = 0
TT2$V_AUTOBAUD = 1
TT2$V_HANGUP = 2
TT2$V_BRDCSTMBX = 4
TT2$V_DMA = 6
TT2$V_ALTYPEAHD = 7
TT2$V_SETSPEED = 8
TT2$V_DECCRT4 = 10
TT2$V_COMMSYNC = 11
TT2$V_EDITING = 12                      ; line editing
TT2$V_INSERT = 13                       ; in insert mode, not overstrike
TT2$V_FALLBACK = 14
TT2$V_DIALUP = 15
TT2$V_SECURE = 16
TT2$V_DISCONNECT = 17
TT2$V_PASTHRU = 18                      ; reads pass every character but CTRL/C and CTRL/Y
TT2$V_SYSPWD = 19
TT2$V_SIXEL = 20
TT2$V_DRCS = 21                         ; soft characters
TT2$V_PRINTER = 22
TT2$V_APP_KEYPAD = 23                   ; the keypad in application mode
TT2$V_ANSICRT = 24
TT2$V_REGIS = 25
TT2$V_BLOCK = 26
TT2$V_AVO = 27                          ; advanced video
TT2$V_EDIT = 28                         ; edit mode
TT2$V_DECCRT = 29
TT2$V_DECCRT2 = 30
TT2$V_DECCRT3 = 31
TT2$M_EDITING = ^X1000
TT2$M_INSERT = ^X2000
TT2$M_PASTHRU = ^X40000
TT2$M_ANSICRT = ^X1000000
TT2$M_AVO = ^X8000000
TT2$M_EDIT = ^X10000000
TT2$M_DECCRT = ^X20000000
        .ENDM   $TT2DEF

; $DEVDEF: device characteristics, DVI$_DEVCHAR's bits.
        .MACRO  $DEVDEF
DEV$M_REC = ^X1                         ; record oriented
DEV$M_CCL = ^X2                         ; carriage control
DEV$M_TRM = ^X4                         ; a terminal
DEV$M_DIR = ^X8                         ; directory structured
DEV$M_FOD = ^X4000                      ; files oriented
DEV$M_SHR = ^X10000                     ; shareable
DEV$M_AVL = ^X40000                     ; available
DEV$V_AVL = 18
DEV$M_MNT = ^X80000                     ; a volume is mounted
DEV$V_MNT = 19
DEV$M_SWL = ^X2000000                   ; software write locked: the volume is read only
DEV$V_SWL = 25
DEV$M_IDV = ^X4000000                   ; input
DEV$M_ODV = ^X8000000                   ; output
DEV$M_RND = ^X10000000                  ; random access
        .ENDM   $DEVDEF

; $MSGDEF: the types of the messages the system writes to mailboxes.
        .MACRO  $MSGDEF
MSG$_DELPROC = 3                        ; a process was deleted: its termination message, $ACCDEF
        .ENDM   $MSGDEF

; $ACCDEF: a process's termination message, which the mailbox whose unit
; $CREPRC's mbxunt named gets when the process is deleted. What vaxpunk
; doesn't keep is 0: the job, account, user name, accounting counts and
; login time.
        .MACRO  $ACCDEF
ACC$W_MSGTYP = 0                        ; MSG$_DELPROC
ACC$L_FINALSTS = 4                      ; the status of its last $EXIT, or 0
ACC$L_PID = 8
ACC$L_JOBID = 12
ACC$Q_TERMTIME = 16                     ; the system time it was deleted at
ACC$T_ACCOUNT = 24                      ; 8 characters
ACC$T_USERNAME = 32                     ; 12 characters
ACC$L_CPUTIM = 44
ACC$L_PAGEFLTS = 48
ACC$L_PGFLPEAK = 52
ACC$L_WSPEAK = 56
ACC$L_BIOCNT = 60
ACC$L_DIOCNT = 64
ACC$L_VOLUMES = 68
ACC$Q_LOGIN = 72
ACC$L_OWNER = 80                        ; its creator's PID
ACC$K_TERMLEN = 84                      ; the message's size
        .ENDM   $ACCDEF

; $MNTDEF: $MOUNT's item codes.
        .MACRO  $MNTDEF
MNT$_DEVNAM = 1                         ; the device
MNT$_VOLNAM = 2                         ; the volume's label
MNT$_OWNER = 13                         ; the volume's owner, a UIC, for this mount
MNT$_VPROT = 14                         ; and protection, a word
        .ENDM   $MNTDEF

; $INITDEF: $INIT_VOL's item codes, VMS's names; the codes are vaxpunk's.
        .MACRO  $INITDEF
INIT$_OWNER = 1                         ; the volume's owner, a UIC: the caller's by default
INIT$_VOLPRO = 2                        ; its protection, a word: 0, all may, by default
        .ENDM   $INITDEF

; $ARMDEF: an access mask: what a process wants to do to a file or a
; volume, which its protection, 4 bits a category, denies or not.
        .MACRO  $ARMDEF
ARM$M_READ = 1
ARM$M_WRITE = 2
ARM$M_EXECUTE = 4                       ; a file's; a directory's: look a name up in it
ARM$M_DELETE = 8
ARM$M_CONTROL = 16                      ; change the protection: the owner's and the system's
ARM$M_SYSTEM = 32                       ; vaxpunk's: change the owner, the system's only
        .ENDM   $ARMDEF

; $XABDEF: the fields every XAB starts with.
        .MACRO  $XABDEF
XAB$B_COD = 0                           ; its type: XAB$C_KEY, ALL, SUM, FHC, DAT, RDT, PRO
XAB$B_BLN = 1                           ; its size
XAB$L_NXT = 4                           ; the next XAB, or 0
        .ENDM   $XABDEF

; $XABKEYDEF: the key definition XAB: a key of an indexed file, which
; $CREATE takes and $OPEN and $DISPLAY fill.
        .MACRO  $XABKEYDEF
        $XABDEF
XAB$C_KEY = 21
XAB$C_KEYLEN = 100
XAB$K_KEYLEN = 100
XAB$C_KEYLEN_V2 = 64
XAB$B_IAN = 8                           ; area of the index above level 1
XAB$B_LAN = 9                           ; area of the level 1 index
XAB$B_DAN = 10                          ; area of the data
XAB$B_LVL = 11                          ; root level
XAB$B_IBS = 12                          ; index bucket size
XAB$B_DBS = 13                          ; data bucket size
XAB$L_RVB = 14                          ; root VBN
XAB$B_FLG = 18                          ; XAB$M_ flags
XAB$B_DTP = 19                          ; data type: XAB$C_STG to XAB$C_DBN8
XAB$B_NSG = 20                          ; segments
XAB$B_NUL = 21                          ; null value
XAB$B_TKS = 22                          ; total key size
XAB$B_REF = 23                          ; key of reference
XAB$W_MRL = 24                          ; minimum record length
XAB$W_IFL = 26                          ; index fill, bytes
XAB$W_DFL = 28                          ; data fill, bytes
XAB$W_POS = 30                          ; segment positions, 8 words
XAB$W_POS0 = 30
XAB$B_SIZ = 46                          ; segment sizes, 8 bytes
XAB$B_SIZ0 = 46
XAB$L_KNM = 56                          ; the key's name, 32 bytes, or 0
XAB$L_DVB = 60                          ; first data bucket's VBN
XAB$B_TYP = 64                          ; segment types, 8 bytes
XAB$B_TYP0 = 64
XAB$B_PROLOG = 72                       ; prologue level: XAB$C_PRG3
XAB$C_PRG1 = 1
XAB$C_PRG2 = 2
XAB$C_PRG3 = 3
XAB$V_DUP = 0                           ; duplicates allowed
XAB$M_DUP = ^X1
XAB$V_CHG = 1                           ; $UPDATE may change it
XAB$M_CHG = ^X2
XAB$V_NUL = 2                           ; a null key isn't indexed
XAB$M_NUL = ^X4
XAB$V_IDX_NCMPR = 3                     ; no index compression
XAB$M_IDX_NCMPR = ^X8
XAB$V_KEY_NCMPR = 6                     ; no key compression
XAB$M_KEY_NCMPR = ^X40
XAB$V_DAT_NCMPR = 7                     ; no data record compression
XAB$M_DAT_NCMPR = ^X80
XAB$C_STG = 0                           ; string
XAB$C_IN2 = 1                           ; signed word
XAB$C_BN2 = 2                           ; unsigned word
XAB$C_IN4 = 3
XAB$C_BN4 = 4
XAB$C_PAC = 5                           ; packed decimal
XAB$C_IN8 = 6
XAB$C_BN8 = 7
XAB$C_COL = 8                           ; collated string
XAB$C_DSTG = 32                         ; descending: 32 more
XAB$C_DIN2 = 33
XAB$C_DBN2 = 34
XAB$C_DIN4 = 35
XAB$C_DBN4 = 36
XAB$C_DPAC = 37
XAB$C_DIN8 = 38
XAB$C_DBN8 = 39
XAB$C_DCOL = 40
        .ENDM   $XABKEYDEF

; $XABALLDEF: the allocation XAB: an area of an indexed file.
        .MACRO  $XABALLDEF
        $XABDEF
XAB$C_ALL = 20
XAB$C_ALLLEN = 32
XAB$K_ALLLEN = 32
XAB$B_AOP = 8                           ; allocation options
XAB$B_ALN = 9                           ; alignment: XAB$C_ANY to XAB$C_RFI
XAB$W_VOL = 10                          ; relative volume
XAB$L_LOC = 12                          ; location
XAB$L_ALQ = 16                          ; blocks
XAB$W_DEQ = 20                          ; default extension
XAB$B_BKZ = 22                          ; bucket size
XAB$B_AID = 23                          ; area number
XAB$W_RFI = 24                          ; related file, 3 words
XAB$V_HRD = 0                           ; hard: fail if the placement can't be had
XAB$M_HRD = ^X1
XAB$V_ONC = 1                           ; on cylinder
XAB$M_ONC = ^X2
XAB$V_CBT = 5                           ; contiguous best try
XAB$M_CBT = ^X20
XAB$V_CTG = 7                           ; contiguous
XAB$M_CTG = ^X80
XAB$C_ANY = 0
XAB$C_CYL = 1
XAB$C_LBN = 2
XAB$C_VBN = 3
XAB$C_RFI = 4
        .ENDM   $XABALLDEF

; $XABSUMDEF: the summary XAB: an indexed file's areas and keys.
        .MACRO  $XABSUMDEF
        $XABDEF
XAB$C_SUM = 22
XAB$C_SUMLEN = 12
XAB$K_SUMLEN = 12
XAB$B_NOA = 8                           ; areas
XAB$B_NOK = 9                           ; keys
XAB$W_PVN = 10                          ; prologue version
        .ENDM   $XABSUMDEF

; $XABFHCDEF: the file header characteristics XAB, which $OPEN and
; $DISPLAY fill from the header's record attributes.
        .MACRO  $XABFHCDEF
        $XABDEF
XAB$C_FHC = 29
XAB$C_FHCLEN = 44
XAB$K_FHCLEN = 44
XAB$B_RFO = 8                           ; organization and record format, as FAT$B_RTYPE
XAB$B_ATR = 9                           ; record attributes
XAB$W_LRL = 10                          ; longest record
XAB$L_HBK = 12                          ; highest block allocated
XAB$L_EBK = 16                          ; end of file block
XAB$W_FFB = 20                          ; first free byte in it
XAB$B_BKZ = 22                          ; bucket size
XAB$B_HSZ = 23                          ; VFC header size
XAB$W_MRZ = 24                          ; maximum record size
XAB$W_DXQ = 26                          ; default extension
XAB$W_GBC = 28                          ; global buffer count
XAB$W_VERLIMIT = 38                     ; version limit
XAB$L_SBN = 40                          ; starting LBN, if contiguous
        .ENDM   $XABFHCDEF

; $XABDATDEF: the date and time XAB.
        .MACRO  $XABDATDEF
        $XABDEF
XAB$C_DAT = 18
XAB$C_DATLEN = 44
XAB$K_DATLEN = 44
XAB$C_DATLEN_V2 = 36
XAB$W_RVN = 8                           ; revision number
XAB$Q_RDT = 12                          ; revised
XAB$Q_CDT = 20                          ; created
XAB$Q_EDT = 28                          ; expires
XAB$Q_BDT = 36                          ; backed up
        .ENDM   $XABDATDEF

; $XABRDTDEF: the revision date and time XAB, which $CLOSE writes back.
        .MACRO  $XABRDTDEF
        $XABDEF
XAB$C_RDT = 30
XAB$C_RDTLEN = 20
XAB$K_RDTLEN = 20
XAB$W_RVN = 8                           ; revision number
XAB$Q_RDT = 12                          ; revised
        .ENDM   $XABRDTDEF

; $XABPRODEF: the protection XAB, which $OPEN fills with the file's owner
; and protection, and $CLOSE changes them to.
        .MACRO  $XABPRODEF
        $XABDEF
XAB$C_PRO = 19                          ; XAB$B_COD
XAB$C_PROLEN = 16                       ; XAB$B_BLN
XAB$W_PRO = 8                           ; the protection: 4 bits each for system, owner, group, world, a set bit denying
XAB$L_UIC = 12                          ; the owner
XAB$V_NOREAD = 0                        ; a category's bits
XAB$V_NOWRITE = 1
XAB$V_NOEXE = 2
XAB$V_NODEL = 3
        .ENDM   $XABPRODEF

; $$BITS sym, prefix, list: sym = the prefix'item bits of the list's items
; added, 0 for an empty list. The $FAB, $RAB and $XABKEY keyword lists use it.
        .MACRO  $$BITS  SYM, PREFIX, LIST
SYM = 0
        .IF NB  <LIST>
        .IRP    ITEM, <LIST>
SYM = SYM ! PREFIX''ITEM
        .ENDR
        .ENDC
        .ENDM   $$BITS

; $FAB, $RAB, $XABKEY, $XABALL, $XABSUM, $XABFHC, $XABDAT, $XABRDT,
; $XABPRO, $NAM: the blocks, with the fields given and the rest VMS's
; defaults, as VMS's macros make them: addresses are labels, sizes values
; (FNS=5), and options keywords, alone or a list in angle brackets
; (FAC=<GET,PUT>, ORG=IDX, RFM=FIX, RAT=CR, ROP=<KGE,LOC>,
; FLG=<DUP,CHG>). FAB's SHR takes PUT, GET, DEL, UPD, MSE and NIL.
        .MACRO  $FAB    FNA=0, FNS=0, DNA=0, DNS=0, NAM=0, FAC, XAB=0, ORG=SEQ, RFM=VAR, RAT, MRS=0, FOP, SHR, ALQ=0, DEQ=0, BKS=0, FSZ=0, MRN=0, CTX=0, RTV=0, GBC=0
        $FABDEF
        $$BITS  $$FAC, FAB$M_, <FAC>
        $$BITS  $$FOP, FAB$M_, <FOP>
        $$BITS  $$RAT, FAB$M_, <RAT>
$$SHR = 0
        .IF NB  <SHR>
        .IRP    ITEM, <SHR>
        .IF IDN <ITEM>, <MSE>
$$SHR = $$SHR ! FAB$M_MSE
        .IFF
        .IF IDN <ITEM>, <NIL>
$$SHR = $$SHR ! FAB$M_NIL
        .IFF
$$SHR = $$SHR ! FAB$M_SHR'ITEM
        .ENDC
        .ENDC
        .ENDR
        .ENDC
        .BYTE   FAB$C_BID, FAB$C_BLN
        .WORD   0                       ; IFI
        .LONG   $$FOP, 0, 0, ALQ        ; FOP, STS, STV, ALQ
        .WORD   DEQ
        .BYTE   $$FAC, $$SHR
        .LONG   CTX
        .BYTE   RTV, FAB$C_'ORG, $$RAT, FAB$C_'RFM
        .BYTE   0, 0                    ; JOURNAL, RU_FACILITY
        .WORD   0                       ; FOPEXT
        .ADDRESS XAB
        .ADDRESS NAM, FNA, DNA
        .BYTE   FNS, DNS
        .WORD   MRS
        .LONG   MRN
        .WORD   0                       ; BLS
        .BYTE   BKS, FSZ
        .LONG   0, 0                    ; DEV, SDC
        .WORD   GBC
        .BYTE   0, 0                    ; ACMODES, RCF
        .WORD   0, 0                    ; GBC_INITIAL, and a word
        .ENDM   $FAB

        .MACRO  $RAB    FAB=0, UBF=0, USZ=0, RBF=0, RSZ=0, RAC=SEQ, ROP, KBF=0, KSZ=0, KRF=0, RHB=0, BKT=0, XAB=0, MBF=0, MBC=0, CTX=0, TMO=0
        $RABDEF
        $$BITS  $$ROP, RAB$M_, <ROP>
        .BYTE   RAB$C_BID, RAB$C_BLN
        .WORD   0                       ; ISI
        .LONG   $$ROP, 0, 0             ; ROP, STS, STV
        .WORD   0, 0, 0, 0              ; RFA, and a word
        .LONG   CTX
        .WORD   0                       ; ROP_2
        .BYTE   RAB$C_'RAC, TMO
        .WORD   USZ, RSZ
        .ADDRESS UBF, RBF, RHB, KBF
        .BYTE   KSZ, KRF, MBF, MBC
        .LONG   BKT
        .ADDRESS FAB, XAB
        .ENDM   $RAB

        .MACRO  $XABKEY REF=0, POS=0, SIZ=0, DTP=STG, FLG, PROLOG=0, IAN=0, LAN=0, DAN=0, IFL=0, DFL=0, NUL=0, KNM=0, NXT=0
        $XABKEYDEF
        $$BITS  $$FLG, XAB$M_, <FLG>
        .BYTE   XAB$C_KEY, XAB$C_KEYLEN
        .WORD   0
        .ADDRESS NXT
        .BYTE   IAN, LAN, DAN, 0        ; IAN, LAN, DAN, LVL
        .BYTE   0, 0                    ; IBS, DBS
        .LONG   0                       ; RVB
        .BYTE   $$FLG, XAB$C_'DTP
$$N = 0
        .IRP    ITEM, <POS>
$$N = $$N + 1
        .ENDR
        .BYTE   $$N, NUL, 0, REF        ; NSG, NUL, TKS, REF
        .WORD   0, IFL, DFL             ; MRL, IFL, DFL
        .IRP    ITEM, <POS>
        .WORD   ITEM
        .ENDR
        .BLKW   8 - $$N
        .IRP    ITEM, <SIZ>
        .BYTE   ITEM
        .ENDR
        .BLKB   8 - $$N
        .WORD   0                       ; to KNM
        .ADDRESS KNM
        .LONG   0                       ; DVB
        .BLKB   8                       ; TYP
        .BYTE   PROLOG
        .BLKB   27                      ; to the end
        .ENDM   $XABKEY

        .MACRO  $XABALL AID=0, ALN=ANY, AOP, ALQ=0, BKZ=0, DEQ=0, LOC=0, VOL=0, NXT=0
        $XABALLDEF
        $$BITS  $$AOP, XAB$M_, <AOP>
        .BYTE   XAB$C_ALL, XAB$C_ALLLEN
        .WORD   0
        .ADDRESS NXT
        .BYTE   $$AOP, XAB$C_'ALN
        .WORD   VOL
        .LONG   LOC, ALQ
        .WORD   DEQ
        .BYTE   BKZ, AID
        .WORD   0, 0, 0                 ; RFI
        .WORD   0
        .ENDM   $XABALL

        .MACRO  $XABSUM NXT=0
        .BYTE   22, 12                  ; XAB$C_SUM, XAB$C_SUMLEN
        .WORD   0
        .ADDRESS NXT
        .BYTE   0, 0                    ; NOA, NOK
        .WORD   0                       ; PVN
        .ENDM   $XABSUM

        .MACRO  $XABFHC NXT=0
        .BYTE   29, 44                  ; XAB$C_FHC, XAB$C_FHCLEN
        .WORD   0
        .ADDRESS NXT
        .BLKB   36
        .ENDM   $XABFHC

        .MACRO  $XABDAT NXT=0
        .BYTE   18, 44                  ; XAB$C_DAT, XAB$C_DATLEN
        .WORD   0
        .ADDRESS NXT
        .BLKB   36
        .ENDM   $XABDAT

        .MACRO  $XABRDT NXT=0
        .BYTE   30, 20                  ; XAB$C_RDT, XAB$C_RDTLEN
        .WORD   0
        .ADDRESS NXT
        .BLKB   12
        .ENDM   $XABRDT

        .MACRO  $XABPRO PRO=0, UIC=0, NXT=0
        .BYTE   19, 16                  ; COD, BLN
        .WORD   0
        .ADDRESS NXT
        .WORD   PRO
        .BYTE   0, 0                    ; MTACC, PROT_OPT
        .LONG   UIC
        .ENDM   $XABPRO

        .MACRO  $XABFHC NXT=0
        .BYTE   29, 44                  ; COD, BLN
        .WORD   0
        .ADDRESS NXT
        .BLKB   36                      ; RFO to the end
        .ENDM   $XABFHC

        .MACRO  $NAM    ESA=0, ESS=0, RSA=0, RSS=0
        .BYTE   2, 96                   ; BID, BLN
        .BYTE   RSS, 0                  ; RSS, RSL
        .ADDRESS RSA
        .BYTE   0, 0, ESS, 0            ; NOP, RFS, ESS, ESL
        .ADDRESS ESA
        .BLKB   80                      ; RLF to the end
        .ENDM   $NAM

; The RMS services, which take the block's address: $OPEN, $CREATE,
; $CLOSE, $ERASE, $PARSE, $SEARCH, $DISPLAY FAB=fab, and $CONNECT,
; $DISCONNECT, $GET, $PUT, $FIND, $UPDATE, $DELETE, $TRUNCATE, $REWIND,
; $FLUSH, $READ, $WRITE, $SPACE, $FREE, $RELEASE, $WAIT RAB=rab.
        .MACRO  $RMSCALL NAME, BLOCK
        PUSHAB  BLOCK
        .EXTERNAL SYS$'NAME
        CALLS   #1, G^SYS$'NAME
        .ENDM   $RMSCALL

        .MACRO  $OPEN    FAB
        $RMSCALL OPEN, FAB
        .ENDM   $OPEN

        .MACRO  $CREATE  FAB
        $RMSCALL CREATE, FAB
        .ENDM   $CREATE

        .MACRO  $CLOSE   FAB
        $RMSCALL CLOSE, FAB
        .ENDM   $CLOSE

        .MACRO  $ERASE   FAB
        $RMSCALL ERASE, FAB
        .ENDM   $ERASE

        .MACRO  $PARSE   FAB
        $RMSCALL PARSE, FAB
        .ENDM   $PARSE

        .MACRO  $SEARCH  FAB
        $RMSCALL SEARCH, FAB
        .ENDM   $SEARCH

        .MACRO  $DISPLAY FAB
        $RMSCALL DISPLAY, FAB
        .ENDM   $DISPLAY

        .MACRO  $CONNECT RAB
        $RMSCALL CONNECT, RAB
        .ENDM   $CONNECT

        .MACRO  $DISCONNECT RAB
        $RMSCALL DISCONNECT, RAB
        .ENDM   $DISCONNECT

        .MACRO  $GET     RAB
        $RMSCALL GET, RAB
        .ENDM   $GET

        .MACRO  $PUT     RAB
        $RMSCALL PUT, RAB
        .ENDM   $PUT

        .MACRO  $FIND    RAB
        $RMSCALL FIND, RAB
        .ENDM   $FIND

        .MACRO  $UPDATE  RAB
        $RMSCALL UPDATE, RAB
        .ENDM   $UPDATE

        .MACRO  $DELETE  RAB
        $RMSCALL DELETE, RAB
        .ENDM   $DELETE

        .MACRO  $TRUNCATE RAB
        $RMSCALL TRUNCATE, RAB
        .ENDM   $TRUNCATE

        .MACRO  $REWIND  RAB
        $RMSCALL REWIND, RAB
        .ENDM   $REWIND

        .MACRO  $FLUSH   RAB
        $RMSCALL FLUSH, RAB
        .ENDM   $FLUSH

        .MACRO  $READ    RAB
        $RMSCALL READ, RAB
        .ENDM   $READ

        .MACRO  $WRITE   RAB
        $RMSCALL WRITE, RAB
        .ENDM   $WRITE

        .MACRO  $SPACE   RAB
        $RMSCALL SPACE, RAB
        .ENDM   $SPACE

        .MACRO  $FREE    RAB
        $RMSCALL FREE, RAB
        .ENDM   $FREE

        .MACRO  $RELEASE RAB
        $RMSCALL RELEASE, RAB
        .ENDM   $RELEASE

        .MACRO  $WAIT    RAB
        $RMSCALL WAIT, RAB
        .ENDM   $WAIT

; $PSLDEF: the processor status longword's fields and the access modes,
; from kernel, the innermost, out to user.
        .MACRO  $PSLDEF
PSL$V_IPL = 16
PSL$V_PRVMOD = 22                       ; the mode before the last change
PSL$V_CURMOD = 24
PSL$C_KERNEL = 0
PSL$C_EXEC = 1
PSL$C_SUPER = 2
PSL$C_USER = 3
        .ENDM   $PSLDEF

; $DSCDEF: descriptors, 32-bit and 64-bit (DSC64$), which has a word 1,
; MBO, where a 32-bit one has its length, and a longword -1, MBMO, where it
; has its pointer: $IS_DESC64 tells them apart by both.
        .MACRO  $DSCDEF
DSC$W_LENGTH = 0
DSC$B_DTYPE = 2
DSC$B_CLASS = 3
DSC$A_POINTER = 4
DSC$K_S_BLN = 8
DSC64$W_MBO = 0                         ; 1
DSC64$B_DTYPE = 2
DSC64$B_CLASS = 3
DSC64$L_MBMO = 4                        ; -1
DSC64$Q_LENGTH = 8
DSC64$PQ_POINTER = 16
DSC64$K_S_BLN = 24
DSC$K_DTYPE_T = 14                      ; text
DSC$K_CLASS_S = 1                       ; static: a string where the pointer says
        .ENDM   $DSCDEF

; $ILEDEF: item list entries: VMS's 32-bit one, ILE3$, and the 64-bit ones,
; ILEA_64$ and ILEB_64$, which has a return length address too, with MBO
; and MBMO as a 64-bit descriptor has them.
        .MACRO  $ILEDEF
ILE3$W_LENGTH = 0
ILE3$W_CODE = 2
ILE3$PS_BUFADDR = 4
ILE3$PS_RETLEN_ADDR = 8
ILE3$K_LENGTH = 12
ILEA_64$W_MBO = 0                       ; 1
ILEA_64$W_CODE = 2
ILEA_64$L_MBMO = 4                      ; -1
ILEA_64$Q_LENGTH = 8
ILEA_64$PQ_BUFADDR = 16
ILEA_64$K_LENGTH = 24
ILEB_64$W_MBO = 0
ILEB_64$W_CODE = 2
ILEB_64$L_MBMO = 4
ILEB_64$Q_LENGTH = 8
ILEB_64$PQ_BUFADDR = 16
ILEB_64$PQ_RETLEN_ADDR = 24
ILEB_64$K_LENGTH = 32
        .ENDM   $ILEDEF

; $CHFDEF: a condition handler's arguments, as 64-bit VMS's
; (DESIGN-0004, *Condition handling*). The 32-bit signal array: a count,
; the condition, its arguments, then the PC and PSL where it was
; signaled, longwords. The 64-bit one: a count, SS$_SIGNAL64, then the
; same as quadwords. The mechanism array: the frame that established the
; handler, its depth, 0 for the routine that signaled, the R0 and R1 it
; goes on with, x2-x17 when it was signaled, and both signal arrays. The
; CHF$L_MCH_ names are the low longwords of the quadwords, as VMS kept
; them for 32-bit code.
        .MACRO  $CHFDEF
CHF$L_SIGARGLST = 4                     ; a handler's first argument
CHF$L_MCHARGLST = 8                     ; its second
CHF$L_SIG_ARGS = 0                      ; the signal array's count
CHF$L_SIG_NAME = 4                      ; the condition
CHF$L_SIG_ARG1 = 8
CHF64$L_SIG_ARGS = 0                    ; the 64-bit one's count
CHF64$L_SIGNAL64 = 4                    ; SS$_SIGNAL64
CHF64$Q_SIG_NAME = 8                    ; the condition
CHF64$Q_SIG_ARG1 = 16
CHF$IS_MCH_ARGS = 0                     ; the quadwords after the first, 24
CHF$IS_MCH_FLAGS = 4
CHF$PH_MCH_FRAME = 8                    ; the establisher's FP
CHF$IS_MCH_DEPTH = 16                   ; 0 the frame that signaled, 1 its caller
CHF$PH_MCH_DADDR = 24                   ; handler data, 0
CHF$PH_MCH_ESF_ADDR = 32                ; the exception's frame, 0 for a signal
CHF$PH_MCH_SIG_ADDR = 40                ; the 32-bit signal array
CHF$IH_MCH_RETVAL = 48                  ; R0
CHF$IH_MCH_RETVAL2 = 56                 ; R1
CHF$IH_MCH_SAVX2 = 64                   ; x2-x17, 8 bytes each
CHF$PH_MCH_SIG64_ADDR = 192             ; the 64-bit signal array
CHF$S_MCH = 200
CHF$L_MCH_FRAME = CHF$PH_MCH_FRAME
CHF$L_MCH_DEPTH = CHF$IS_MCH_DEPTH
CHF$L_MCH_SAVR0 = CHF$IH_MCH_RETVAL
CHF$IH_MCH_SAVR0 = CHF$IH_MCH_RETVAL    ; OpenVMS Alpha's name for it
CHF$L_MCH_SAVR1 = CHF$IH_MCH_RETVAL2
        .ENDM   $CHFDEF

; $STSDEF: a condition value's fields.
        .MACRO  $STSDEF
STS$K_WARNING = 0
STS$K_SUCCESS = 1
STS$K_ERROR = 2
STS$K_INFO = 3
STS$K_SEVERE = 4
STS$M_SEVERITY = 7
STS$V_FAC_NO = 16                       ; the facility, 12 bits: 0 for the system's
STS$M_INHIB_MSG = ^X10000000            ; the message was written already
        .ENDM   $STSDEF

; $IODEF: I/O function codes for $QIO.
        .MACRO  $IODEF
IO$_WRITEPBLK = 11
IO$_WRITELBLK = 32
IO$_WRITEVBLK = 48
IO$_READPBLK = 12
IO$_READLBLK = 33
IO$_READVBLK = 49
IO$_READPROMPT = 55                     ; writes the prompt in p5 and p6 first
IO$_SETMODE = 35                        ; a terminal: sets its characteristics, or enables a CTRL/C or CTRL/Y AST
IO$V_CTRLYAST = 7                       ; SETMODE: the AST is CTRL/Y's
IO$M_CTRLYAST = ^X80
IO$V_CTRLCAST = 8                       ; SETMODE: the AST is CTRL/C's
IO$M_CTRLCAST = ^X100
IO$V_NOECHO = 6                         ; a read doesn't echo
IO$M_NOECHO = ^X40
IO$V_NOFILTR = 9                        ; a read doesn't edit: DEL, CTRL/U are data
IO$M_NOFILTR = ^X200
IO$V_NOW = 6                            ; a mailbox's read doesn't wait for a message
IO$M_NOW = ^X40
IO$_SETCHAR = 26                        ; a socket: as IO$_SETMODE, which is the same function there
IO$_SENSECHAR = 27                      ; a socket: as IO$_SENSEMODE
IO$_ACCESS = 50                         ; a socket: connects, or accepts; a datagram socket's peer
IO$_DEACCESS = 52                       ; a socket: closes it
IO$_SENSEMODE = 39                      ; a terminal: its characteristics; a socket: its names, ioctls
IO$V_ACCEPT = 7                         ; a socket's ACCESS: accepts a connection
IO$M_ACCEPT = ^X80
IO$V_SHUTDOWN = 7                       ; a socket's DEACCESS: shuts down a direction, p4
IO$M_SHUTDOWN = ^X80
IO$V_READATTN = 7                       ; a socket's SETMODE: an AST when data comes
IO$M_READATTN = ^X80
IO$V_WRTATTN = 8                        ; a socket's SETMODE: an AST when it can be written
IO$M_WRTATTN = ^X100
IO$V_INTERRUPT = 6                      ; a socket's read or write: out-of-band data
IO$M_INTERRUPT = ^X40
IO$V_OUTBAND = 10                       ; a socket's SETMODE: an AST for out-of-band data
IO$M_OUTBAND = ^X400
IO$V_EXTEND = 15                        ; a socket name written is BSD 4.4's
IO$M_EXTEND = ^X8000
        .ENDM   $IODEF

; $INETSYMDEF, $SOCKADDRINDEF, $IFREQDEF, $ORTENTRYDEF and $SIOCDEF: TCP/IP
; Services' TCPIP$INETDEF, the modules and the values a program uses with
; $QIO on a socket, TCPIP$DEVICE:. A socket's characteristics, IO$_SETMODE's
; p1, are a word protocol, a byte type and a byte address family; a socket
; name is an item_list_2 (a word length, a word TCPIP$C_SOCK_NAME and an
; address) to set it, or an item_list_3 (with a longword for the length
; written, too) to get it, of a SOCKADDRIN; an ioctl is an item_list_2 of
; type TCPIP$C_IOCTL of ioctl_comm longword pairs, the request and the
; address of its argument. $INETSYMDEF: the protocols, socket types,
; families, item list types, options and flags.
        .MACRO  $INETSYMDEF
TCPIP$C_ICMP = 1                        ; protocols: a raw socket's
TCPIP$C_TCP = 6
TCPIP$C_UDP = 17
TCPIP$C_RAW_IP = 255
TCPIP$C_STREAM = 1                      ; socket types
TCPIP$C_DGRAM = 2
TCPIP$C_RAW = 3
TCPIP$C_AF_UNSPEC = 0                   ; address families
TCPIP$C_AF_INET = 2
TCPIP$C_INADDR_ANY = 0
TCPIP$C_INADDR_BROADCAST = -1
TCPIP$C_IPOPT = 0                       ; item list types
TCPIP$C_SOCKOPT = 1
TCPIP$C_IOCTL = 2
TCPIP$C_DATA = 3
TCPIP$C_SOCK_NAME = 4
TCPIP$C_TCPOPT = 6
TCPIP$C_REUSEADDR = 4                   ; socket options
TCPIP$C_KEEPALIVE = 8
TCPIP$C_BROADCAST = 32
TCPIP$C_LINGER = 128
TCPIP$C_MSG_OOB = 1                     ; a read's or a write's p4 flags
TCPIP$C_MSG_PEEK = 2
TCPIP$C_MSG_DONTROUTE = 4
TCPIP$C_MSG_NBIO = 64
TCPIP$C_DSC_RCV = 0                     ; IO$_DEACCESS!IO$M_SHUTDOWN's p4
TCPIP$C_DSC_SND = 1
TCPIP$C_DSC_ALL = 2
        .ENDM   $INETSYMDEF

; $SOCKADDRINDEF: a socket name, an IPv4 address and port, BSD 4.3's or 4.4's.
        .MACRO  $SOCKADDRINDEF
SIN$W_FAMILY = 0                        ; BSD 4.3's: TCPIP$C_AF_INET
SIN$W_PORT = 2                          ; in network order
SIN$L_ADDR = 4                          ; in network order
SIN$T_ZERO = 8
SIN$K_LENGTH = 16
SIN44$B_LEN = 0                         ; BSD 4.4's, IO$M_EXTEND's: 16
SIN44$B_FAMILY = 1
SIN44$K_LENGTH = 16
        .ENDM   $SOCKADDRINDEF

; $IFREQDEF: an interface ioctl's argument, its name and an address or flags.
        .MACRO  $IFREQDEF
IFR$T_NAME = 0                          ; the interface's name, WE0, zero filled
IFR$T_ADDR = 16                         ; an address, a SOCKADDRIN
IFR$W_FLAGS = 16                        ; IFR$M_IFF_
IFR$K_LENGTH = 32
IFR$M_IFF_UP = 1
IFR$M_IFF_BROADCAST = 2
IFR$M_IFF_RUNNING = ^X40                ; the link is up
        .ENDM   $IFREQDEF

; $ORTENTRYDEF: a route ioctl's argument, its destination and gateway.
        .MACRO  $ORTENTRYDEF
ORT$L_HASH = 0
ORT$T_DST = 4                           ; the destination, a SOCKADDRIN
ORT$L_DST_SIN_ADDR = 8
ORT$T_GATEWAY = 20                      ; the gateway, a SOCKADDRIN
ORT$L_GATEWAY_SIN_ADDR = 24
ORT$W_FLAGS = 36                        ; ORT$M_RTF_
ORT$K_LENGTH = 48
ORT$M_RTF_UP = 1
ORT$M_RTF_GATEWAY = 2
ORT$M_RTF_HOST = 4
        .ENDM   $ORTENTRYDEF

; $SIOCDEF: the ioctl requests, an ioctl_comm's first longword, with
; TCPIP$INETDEF's values: _IOW and _IOWR of 'i' or 'r', a size and a number.
        .MACRO  $SIOCDEF
SIOCADDRT = -2144308726                 ; adds a route, an ORTENTRY
SIOCDELRT = -2144308725                 ; deletes one
SIOCGETRT = -1070566869                 ; the route to ORT$T_DST
SIOCSIFADDR = -2145359604               ; sets an interface's address, an IFREQ
SIOCGIFADDR = -1071617779
SIOCSIFFLAGS = -2145359600
SIOCGIFFLAGS = -1071617775
SIOCGIFNETMASK = -1071617771
SIOCSIFNETMASK = -2145359594
SIOCSIFDHCP = -2145359489               ; vaxpunk's, not VMS's: a DHCP server sets the interface
        .ENDM   $SIOCDEF

; $LNMDEF: logical names: item codes for the item lists of $CRELNM and
; $TRNLNM, and limits. An item list is 12-byte items, each a word buffer
; length, a word item code, a buffer address and the address of a word
; for the length returned, or 0; a longword 0 ends it.
        .MACRO  $LNMDEF
LNM$_STRING = 2                         ; the equivalence string
LNM$_TABLE = 4                          ; the name of the table it was found in
LNM$_LENGTH = 5                         ; the equivalence string's length, a longword
LNM$C_NAMLENGTH = 255                   ; the longest name or equivalence string
LNM$C_MAXDEPTH = 10                     ; translations of a device name, at most
        .ENDM   $LNMDEF

; $JPIDEF: $GETJPI's item codes, VMS's, those vaxpunk knows. The item list
; is as $LNMDEF says.
        .MACRO  $JPIDEF
JPI$_PRI = ^X302                        ; the current priority, 0-31, a longword
JPI$_OWNER = ^X303                      ; the creator's PID
JPI$_STS = ^X305                        ; the PCB$V_ bits
JPI$_STATE = ^X306                      ; the scheduling state, SCH$C_
JPI$_PRIB = ^X309                       ; the base priority
JPI$_PID = ^X319
JPI$_PRCNAM = ^X31C                     ; the process's name
JPI$_IMAGNAME = ^X207                   ; the image it runs, or ran last
JPI$_UIC = ^X304                        ; its UIC, a longword
JPI$_MEM = ^X307                        ; the UIC's member, and its group
JPI$_GRP = ^X308
JPI$_PROCPRIV = ^X204                   ; its privileges, quadwords: permanent,
JPI$_CURPRIV = ^X400                    ; current,
JPI$_AUTHPRIV = ^X412                   ; and authorized
        .ENDM   $JPIDEF

; $SYIDEF: $GETSYI's item codes, VMS's, those vaxpunk knows.
        .MACRO  $SYIDEF
SYI$_VERSION = 4096                     ; the system's version, 8 characters
SYI$_MAXPROCESSCNT = 4105               ; how many processes there may be
SYI$_QUANTUM = 4137                     ; ticks of 10 ms in a quantum
SYI$_BOOTTIME = 4286                    ; the system time at boot, a quadword
        .ENDM   $SYIDEF

; $PRVDEF: the privileges, VMS's bits in a quadword mask: PRV$V_name, and
; PRV$M_name, the mask in the first longword, for those vaxpunk checks.
        .MACRO  $PRVDEF
PRV$V_CMKRNL = 0                        ; $CMKRNL
PRV$V_CMEXEC = 1                        ; $CMEXEC
PRV$V_SYSNAM = 2                        ; LNM$SYSTEM_TABLE's names, and volumes mounted for all
PRV$V_GRPNAM = 3
PRV$V_ALLSPOOL = 4
PRV$V_DETACH = 5                        ; a process with another UIC
PRV$V_DIAGNOSE = 6
PRV$V_LOG_IO = 7                        ; a disk's blocks by LBN
PRV$V_GROUP = 8                         ; other processes in its UIC group
PRV$V_NOACNT = 9
PRV$V_PRMCEB = 10
PRV$V_PRMMBX = 11                       ; permanent mailboxes
PRV$V_PSWAPM = 12
PRV$V_ALTPRI = 13
PRV$V_SETPRV = 14                       ; any privilege, not just the authorized ones
PRV$V_TMPMBX = 15                       ; temporary mailboxes
PRV$V_WORLD = 16                        ; any other process
PRV$V_MOUNT = 17
PRV$V_OPER = 18                         ; the operator's: the network's interface
PRV$V_EXQUOTA = 19
PRV$V_NETMBX = 20
PRV$V_VOLPRO = 21                       ; INITIALIZE a volume
PRV$V_PHY_IO = 22                       ; a disk's blocks, physical or logical
PRV$V_BUGCHK = 23
PRV$V_PRMGBL = 24
PRV$V_SYSGBL = 25
PRV$V_PFNMAP = 26
PRV$V_SHMEM = 27
PRV$V_SYSPRV = 28
PRV$V_BYPASS = 29
PRV$V_SYSLCK = 30
PRV$V_SHARE = 31
PRV$V_UPGRADE = 32
PRV$V_DOWNGRADE = 33
PRV$V_GRPPRV = 34
PRV$V_READALL = 35
PRV$V_IMPORT = 36
PRV$V_AUDIT = 37
PRV$V_SECURITY = 38
PRV$K_NUMBER = 39                       ; how many there are
PRV$M_CMKRNL = 1
PRV$M_CMEXEC = 2
PRV$M_SYSNAM = 4
PRV$M_DETACH = ^X20
PRV$M_LOG_IO = ^X80
PRV$M_GROUP = ^X100
PRV$M_PRMMBX = ^X800
PRV$M_SETPRV = ^X4000
PRV$M_TMPMBX = ^X8000
PRV$M_WORLD = ^X10000
PRV$M_OPER = ^X40000
PRV$M_VOLPRO = ^X200000
PRV$M_PHY_IO = ^X400000
PRV$M_SYSPRV = ^X10000000
PRV$M_BYPASS = ^X20000000
        .ENDM   $PRVDEF

; $PRTDEF: page protection codes, the VAX's: who may read (R) and write (W),
; from kernel (K) out to user (U) mode.
        .MACRO  $PRTDEF
PRT$C_NA = 0
PRT$C_KW = 2
PRT$C_KR = 3
PRT$C_UW = 4
PRT$C_EW = 5
PRT$C_ERKW = 6
PRT$C_ER = 7
PRT$C_SW = 8
PRT$C_SREW = 9
PRT$C_SRKW = 10
PRT$C_SR = 11
PRT$C_URSW = 12
PRT$C_UREW = 13
PRT$C_URKW = 14
PRT$C_UR = 15
        .ENDM   $PRTDEF

; The _S forms of the system services: each pushes its arguments, last
; first, and calls SYS$name. A value argument is pushed as written
; (EFN=#65); an address argument is pushed as an address (PIDADR=PID), or
; as 0 if it is 0, the default.

        .MACRO  $PUSHADR ADDR
        .IF     IDN <ADDR>, <0>
        PUSHL   #0
        .IFF
        PUSHAB  ADDR
        .ENDC
        .ENDM   $PUSHADR

        .MACRO  $CREPRC_S PIDADR=0, IMAGE=0, INPUT=0, OUTPUT=0, ERROR=0, PRVADR=0, QUOTA=0, PRCNAM=0, BASPRI=#2, UIC=#0, MBXUNT=#0, STSFLG=#0
        PUSHL   STSFLG
        PUSHL   MBXUNT
        PUSHL   UIC
        PUSHL   BASPRI
        $PUSHADR PRCNAM
        $PUSHADR QUOTA
        $PUSHADR PRVADR
        $PUSHADR ERROR
        $PUSHADR OUTPUT
        $PUSHADR INPUT
        $PUSHADR IMAGE
        $PUSHADR PIDADR
        .EXTERNAL SYS$CREPRC
        CALLS   #12, G^SYS$CREPRC
        .ENDM   $CREPRC_S

        .MACRO  $DELPRC_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$DELPRC
        CALLS   #2, G^SYS$DELPRC
        .ENDM   $DELPRC_S

        .MACRO  $EXIT_S CODE=#1
        PUSHL   CODE
        .EXTERNAL SYS$EXIT
        CALLS   #1, G^SYS$EXIT
        .ENDM   $EXIT_S

        .MACRO  $DCLEXH_S DESBLK
        $PUSHADR DESBLK
        .EXTERNAL SYS$DCLEXH
        CALLS   #1, G^SYS$DCLEXH
        .ENDM   $DCLEXH_S

        .MACRO  $CANEXH_S DESBLK=0
        $PUSHADR DESBLK
        .EXTERNAL SYS$CANEXH
        CALLS   #1, G^SYS$CANEXH
        .ENDM   $CANEXH_S

        .MACRO  $FORCEX_S PIDADR=0, PRCNAM=0, CODE=#0
        PUSHL   CODE
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$FORCEX
        CALLS   #3, G^SYS$FORCEX
        .ENDM   $FORCEX_S

        .MACRO  $HIBER_S
        .EXTERNAL SYS$HIBER
        CALLS   #0, G^SYS$HIBER
        .ENDM   $HIBER_S

        .MACRO  $WAKE_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$WAKE
        CALLS   #2, G^SYS$WAKE
        .ENDM   $WAKE_S

        .MACRO  $SUSPND_S PIDADR=0, PRCNAM=0, FLAGS=#0
        PUSHL   FLAGS
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SUSPND
        CALLS   #3, G^SYS$SUSPND
        .ENDM   $SUSPND_S

        .MACRO  $RESUME_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$RESUME
        CALLS   #2, G^SYS$RESUME
        .ENDM   $RESUME_S

        .MACRO  $SETPRI_S PIDADR=0, PRCNAM=0, PRI, PRVPRI=0
        $PUSHADR PRVPRI
        PUSHL   PRI
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SETPRI
        CALLS   #4, G^SYS$SETPRI
        .ENDM   $SETPRI_S

        .MACRO  $SETPRN_S PRCNAM=0
        $PUSHADR PRCNAM
        .EXTERNAL SYS$SETPRN
