; starlet.mlb: what programs that call system services use, like VMS's
; STARLET.MLB. Use it with .LIBRARY "starlet.mlb" and vasm -I vtools/lib.

; $SSDEF: system service status codes, as VMS numbers them.
        .MACRO  $SSDEF
SS$_NORMAL = 1
SS$_WASCLR = 1
SS$_WASSET = 9
SS$_ACCVIO = 12
SS$_BADPARAM = 20
SS$_EXQUOTA = 28
SS$_NOPRIV = 36
SS$_ABORT = 44
SS$_DEVMOUNT = 108                      ; the device is already mounted
SS$_DEVNOTMOUNT = 124
SS$_BADIMGHDR = 68
SS$_DRVERR = 140
SS$_DUPLNAM = 148
SS$_ILLBLKNUM = 220
SS$_ILLEFC = 236
SS$_ILLIOFUNC = 244
SS$_ILLPAGCNT = 252
SS$_ILLSER = 260
SS$_INCVOLLABEL = 268                   ; the volume's label isn't the one asked for
SS$_INSFARG = 276
SS$_INSFMEM = 292
SS$_IVCHAN = 316
SS$_IVDEVNAM = 324                      ; no device name, or a bad one
SS$_IVLOGNAM = 340
SS$_IVLOGTAB = 348
SS$_IVSSRQ = 372
SS$_MEDOFL = 420                        ; the medium is offline: a ramdisk not made yet
SS$_NOIOCHAN = 436
SS$_NOLOGNAM = 444
SS$_PAGOWNVIO = 492
SS$_UNASEFC = 564
SS$_VASFULL = 580
SS$_WRITLCK = 604                       ; the device is write locked
SS$_IVMODE = 852
SS$_OPCDEC = 1084
SS$_CONTROLY = 1553                     ; CTRL/Y stopped the image
SS$_SUPERSEDE = 1585                    ; success: a name by that name was replaced
SS$_NONEXPR = 2280
SS$_NOSUCHDEV = 2312
SS$_NOSUCHFILE = 2320
SS$_BADCHKSUM = 2056
SS$_BADFILEHDR = 2064
SS$_BADFILEVER = 2080                   ; a version above 32767
SS$_BADIRECTORY = 2088
SS$_DEVICEFULL = 2128                   ; no free blocks left
SS$_DUPFILENAME = 2152                  ; that name and version is in the directory already
SS$_ENDOFFILE = 2160
SS$_HEADERFULL = 2248                   ; the file's map is full
SS$_IDXFILEFULL = 2256                  ; no free file headers left
SS$_NOHOMEBLK = 2272                    ; no Files-11 home block
SS$_NOMOREFILES = 2352
SS$_NOMOREDEV = 2648                    ; no more devices to list
SS$_NOLOGTAB = 8852
        .ENDM   $SSDEF

; $RMSDEF: RMS status codes, as VMS numbers them.
        .MACRO  $RMSDEF
RMS$_NORMAL = ^X10001
RMS$_EOF = ^X1827A                      ; end of file
RMS$_FNF = ^X18292                      ; file not found
RMS$_WLK = ^X182BA                      ; device write locked: the volume is read-only
RMS$_NMF = ^X182CA                      ; no more files
RMS$_RTB = ^X181A8                      ; record too big for the user's buffer
RMS$_DNF = ^X1C04A                      ; directory not found
RMS$_DEV = ^X184C4                      ; bad device
RMS$_DIR = ^X184CC                      ; bad directory
RMS$_DME = ^X184D4                      ; dynamic memory exhausted
RMS$_ESA = ^X184FC                      ; no expanded string area
RMS$_ESS = ^X18504                      ; expanded string area too small
RMS$_FAB = ^X1850C                      ; not a FAB
RMS$_FNM = ^X1852C                      ; bad file name
RMS$_IFI = ^X18564                      ; bad internal file index
RMS$_ISI = ^X18584                      ; bad internal stream index
RMS$_NAM = ^X185DC                      ; not a NAM block
RMS$_RAB = ^X1863C                      ; not a RAB
RMS$_RFM = ^X18664                      ; record format RMS can't read
RMS$_RSS = ^X18694                      ; resultant string area too small
RMS$_SYN = ^X186D4                      ; file specification syntax
RMS$_VER = ^X186FC                      ; bad version
RMS$_WLD = ^X18744                      ; wildcard where one may not be
RMS$_DNR = ^X18272                      ; device not ready: not mounted
RMS$_FEX = ^X18282                      ; file already exists
RMS$_PRV = ^X1829A                      ; privilege violation: a reserved file
RMS$_FUL = ^X18544                      ; device full
RMS$_IOP = ^X18574                      ; operation the file wasn't opened for
RMS$_RSZ = ^X186A4                      ; record size: a FIX record of another size
RMS$_CRE = ^X1C00A                      ; the file system couldn't create the file
RMS$_ENT = ^X1C01A                      ; or enter it in its directory
RMS$_MKD = ^X1C032                      ; or delete it
RMS$_WER = ^X1C114                      ; or write it
        .ENDM   $RMSDEF

; $FABDEF: the file access block, for RMS's sequential files.
        .MACRO  $FABDEF
FAB$C_BID = 3
FAB$C_BLN = 80
FAB$B_BID = 0
FAB$B_BLN = 1
FAB$W_IFI = 2                           ; internal file index, from $OPEN or $CREATE
FAB$L_FOP = 4                           ; file processing options: FAB$M_NAM
FAB$L_STS = 8                           ; the status of the last operation
FAB$L_STV = 12
FAB$L_ALQ = 16                          ; blocks allocated
FAB$B_FAC = 22                          ; access wanted: FAB$M_
FAB$B_ORG = 29                          ; organization: FAB$C_SEQ
FAB$B_RAT = 30                          ; record attributes: FAB$M_CR
FAB$B_RFM = 31                          ; record format: FAB$C_
FAB$L_NAM = 40                          ; a NAM block, or 0
FAB$L_FNA = 44                          ; the file specification
FAB$L_DNA = 48                          ; the default one
FAB$B_FNS = 52                          ; their lengths
FAB$B_DNS = 53
FAB$W_MRS = 54                          ; maximum record size
FAB$B_FSZ = 63                          ; VFC header size
FAB$M_PUT = 1
FAB$M_GET = 2
FAB$M_DEL = 4
FAB$M_UPD = 8
FAB$M_TRN = 16
FAB$C_SEQ = 0
FAB$M_CR = 2
FAB$M_BLK = 8                           ; records don't span blocks
FAB$M_NAM = ^X1000000                   ; $ERASE the file the NAM block's resultant string names
FAB$C_UDF = 0
FAB$C_FIX = 1
FAB$C_VAR = 2
FAB$C_VFC = 3
        .ENDM   $FABDEF

; $RABDEF: the record access block.
        .MACRO  $RABDEF
RAB$C_BID = 1
RAB$C_BLN = 68
RAB$B_BID = 0
RAB$B_BLN = 1
RAB$W_ISI = 2                           ; internal stream index, from $CONNECT
RAB$L_STS = 8
RAB$L_STV = 12
RAB$W_USZ = 32                          ; the user's buffer: its size
RAB$W_RSZ = 34                          ; the record's size
RAB$L_UBF = 36                          ; and address
RAB$L_RBF = 40                          ; where $GET put the record, what $PUT writes
RAB$L_FAB = 60                          ; the FAB $CONNECT connects to
        .ENDM   $RABDEF

; $NAMDEF: the name block, which $PARSE, $SEARCH and $OPEN fill.
        .MACRO  $NAMDEF
NAM$C_BID = 2
NAM$C_BLN = 96
NAM$B_BID = 0
NAM$B_BLN = 1
NAM$B_RSS = 2                           ; the resultant string area: size
NAM$B_RSL = 3                           ; the string's length
NAM$L_RSA = 4                           ; its address
NAM$B_ESS = 10                          ; the expanded string area: size
NAM$B_ESL = 11
NAM$L_ESA = 12
NAM$W_FID = 36                          ; file ID, 3 words
NAM$W_DID = 42                          ; directory ID, 3 words
NAM$L_WCC = 48                          ; $SEARCH's context
NAM$L_FNB = 52                          ; NAM$M_ bits
NAM$B_DEV = 57                          ; the lengths of the string's parts
NAM$B_DIR = 58
NAM$B_NAME = 59
NAM$B_TYPE = 60
NAM$B_VER = 61
NAM$L_DEV = 68                          ; and their addresses
NAM$L_DIR = 72
NAM$L_NAME = 76
NAM$L_TYPE = 80
NAM$L_VER = 84
NAM$M_WILDCARD = ^X100                  ; the specification has a wildcard
        .ENDM   $NAMDEF

; $DVIDEF: $GETDVI's item codes, VMS's, those vaxpunk knows.
        .MACRO  $DVIDEF
DVI$_DEVCHAR = 2                        ; the DEV$ bits, a longword
DVI$_DEVCLASS = 4                       ; DC$_DISK or DC$_TERM
DVI$_UNIT = 12
DVI$_ERRCNT = 20
DVI$_DEVNAM = 32                        ; the device's name, _DDCU:
DVI$_VOLNAM = 34                        ; the mounted volume's label
DVI$_FREEBLOCKS = 42                    ; its free blocks
DVI$_MOUNTCNT = 56                      ; 1 if a volume is mounted, else 0
DVI$_CLUSTER = 58                       ; its cluster, in blocks
DVI$_AVL = 98                           ; DEVCHAR's bits, each 1 or 0
DVI$_MNT = 100
DVI$_SWL = 112
DVI$_STS = 226                          ; the UCB$ status bits: UCB$M_ONLINE
        .ENDM   $DVIDEF

; $DVSDEF: $DEVICE_SCAN's item codes.
        .MACRO  $DVSDEF
DVS$_DEVCLASS = 1                       ; only devices of this class, a longword
        .ENDM   $DVSDEF

; $DCDEF: device classes.
        .MACRO  $DCDEF
DC$_DISK = 1
DC$_TERM = 66
        .ENDM   $DCDEF

; $DEVDEF: device characteristics, DVI$_DEVCHAR's bits.
        .MACRO  $DEVDEF
DEV$M_REC = ^X1                         ; record oriented
DEV$M_CCL = ^X2                         ; carriage control
DEV$M_TRM = ^X4                         ; a terminal
DEV$M_DIR = ^X8                         ; directory structured
DEV$M_FOD = ^X4000                      ; files oriented
DEV$M_SHR = ^X10000                     ; shareable
DEV$M_AVL = ^X40000                     ; available
DEV$V_AVL = 18
DEV$M_MNT = ^X80000                     ; a volume is mounted
DEV$V_MNT = 19
DEV$M_SWL = ^X2000000                   ; software write locked: the volume is read only
DEV$V_SWL = 25
DEV$M_IDV = ^X4000000                   ; input
DEV$M_ODV = ^X8000000                   ; output
DEV$M_RND = ^X10000000                  ; random access
        .ENDM   $DEVDEF

; $UCBDEF: DVI$_STS's bits, a unit control block's status on VMS; vaxpunk
; has no UCBs.
        .MACRO  $UCBDEF
UCB$V_ONLINE = 4                        ; the device is online
UCB$M_ONLINE = ^X10
        .ENDM   $UCBDEF

; $MNTDEF: $MOUNT's item codes.
        .MACRO  $MNTDEF
MNT$_DEVNAM = 1                         ; the device
MNT$_VOLNAM = 2                         ; the volume's label
        .ENDM   $MNTDEF

; $FAB, $RAB, $NAM: a FAB, RAB or name block, with the fields given and
; the rest 0. Lengths are values (FNS=#5 is FNS=5 here), addresses labels.
        .MACRO  $FAB    FNA=0, FNS=0, DNA=0, DNS=0, NAM=0, FAC=0
        .BYTE   3, 80                   ; BID, BLN
        .WORD   0                       ; IFI
        .LONG   0, 0, 0, 0              ; FOP, STS, STV, ALQ
        .WORD   0                       ; DEQ
        .BYTE   FAC, 0                  ; FAC, SHR
        .LONG   0                       ; CTX
        .BYTE   0, 0, 0, 0              ; RTV, ORG, RAT, RFM
        .LONG   0, 0                    ; JNL, XAB
        .ADDRESS NAM, FNA, DNA
        .BYTE   FNS, DNS
        .BLKB   26                      ; MRS to the end
        .ENDM   $FAB

        .MACRO  $RAB    FAB=0, UBF=0, USZ=0
        .BYTE   1, 68                   ; BID, BLN
        .WORD   0                       ; ISI
        .LONG   0, 0, 0                 ; ROP, STS, STV
        .WORD   0, 0, 0, 0              ; RFA, and a word
        .LONG   0                       ; CTX
        .BYTE   0, 0, 0, 0              ; two bytes, RAC, TMO
        .WORD   USZ, 0                  ; USZ, RSZ
        .ADDRESS UBF
        .LONG   0, 0, 0                 ; RBF, RHB, KBF
        .BYTE   0, 0, 0, 0              ; KSZ, KRF, MBF, MBC
        .LONG   0                       ; BKT
        .ADDRESS FAB
        .LONG   0                       ; XAB
        .ENDM   $RAB

        .MACRO  $NAM    ESA=0, ESS=0, RSA=0, RSS=0
        .BYTE   2, 96                   ; BID, BLN
        .BYTE   RSS, 0                  ; RSS, RSL
        .ADDRESS RSA
        .BYTE   0, 0, ESS, 0            ; NOP, RFS, ESS, ESL
        .ADDRESS ESA
        .BLKB   80                      ; RLF to the end
        .ENDM   $NAM

; $OPEN, $CREATE, $CLOSE, $ERASE, $PARSE, $SEARCH FAB=fab and $CONNECT,
; $DISCONNECT, $GET, $PUT RAB=rab: the RMS services, which take the
; block's address.
        .MACRO  $RMSCALL NAME, BLOCK
        PUSHAB  BLOCK
        .EXTERNAL SYS$'NAME
        CALLS   #1, G^SYS$'NAME
        .ENDM   $RMSCALL

        .MACRO  $OPEN   FAB
        $RMSCALL OPEN, FAB
        .ENDM   $OPEN

        .MACRO  $CREATE FAB
        $RMSCALL CREATE, FAB
        .ENDM   $CREATE

        .MACRO  $CLOSE  FAB
        $RMSCALL CLOSE, FAB
        .ENDM   $CLOSE

        .MACRO  $ERASE  FAB
        $RMSCALL ERASE, FAB
        .ENDM   $ERASE

        .MACRO  $PARSE  FAB
        $RMSCALL PARSE, FAB
        .ENDM   $PARSE

        .MACRO  $SEARCH FAB
        $RMSCALL SEARCH, FAB
        .ENDM   $SEARCH

        .MACRO  $CONNECT RAB
        $RMSCALL CONNECT, RAB
        .ENDM   $CONNECT

        .MACRO  $DISCONNECT RAB
        $RMSCALL DISCONNECT, RAB
        .ENDM   $DISCONNECT

        .MACRO  $GET    RAB
        $RMSCALL GET, RAB
        .ENDM   $GET

        .MACRO  $PUT    RAB
        $RMSCALL PUT, RAB
        .ENDM   $PUT

; $PSLDEF: the processor status longword's fields and the access modes,
; from kernel, the innermost, out to user.
        .MACRO  $PSLDEF
PSL$V_IPL = 16
PSL$V_PRVMOD = 22                       ; the mode before the last change
PSL$V_CURMOD = 24
PSL$C_KERNEL = 0
PSL$C_EXEC = 1
PSL$C_SUPER = 2
PSL$C_USER = 3
        .ENDM   $PSLDEF

; $IODEF: I/O function codes for $QIO.
        .MACRO  $IODEF
IO$_WRITEPBLK = 11
IO$_WRITELBLK = 32
IO$_WRITEVBLK = 48
IO$_READPBLK = 12
IO$_READLBLK = 33
IO$_READVBLK = 49
IO$_READPROMPT = 55                     ; writes the prompt in p5 and p6 first
        .ENDM   $IODEF

; $LNMDEF: logical names: item codes for the item lists of $CRELNM and
; $TRNLNM, and limits. An item list is 12-byte items, each a word buffer
; length, a word item code, a buffer address and the address of a word
; for the length returned, or 0; a longword 0 ends it.
        .MACRO  $LNMDEF
LNM$_STRING = 2                         ; the equivalence string
LNM$_TABLE = 4                          ; the name of the table it was found in
LNM$_LENGTH = 5                         ; the equivalence string's length, a longword
LNM$C_NAMLENGTH = 255                   ; the longest name or equivalence string
LNM$C_MAXDEPTH = 10                     ; translations of a device name, at most
        .ENDM   $LNMDEF

; $PRTDEF: page protection codes, the VAX's: who may read (R) and write (W),
; from kernel (K) out to user (U) mode.
        .MACRO  $PRTDEF
PRT$C_NA = 0
PRT$C_KW = 2
PRT$C_KR = 3
PRT$C_UW = 4
PRT$C_EW = 5
PRT$C_ERKW = 6
PRT$C_ER = 7
PRT$C_SW = 8
PRT$C_SREW = 9
PRT$C_SRKW = 10
PRT$C_SR = 11
PRT$C_URSW = 12
PRT$C_UREW = 13
PRT$C_URKW = 14
PRT$C_UR = 15
        .ENDM   $PRTDEF

; The _S forms of the system services: each pushes its arguments, last
; first, and calls SYS$name. A value argument is pushed as written
; (EFN=#65); an address argument is pushed as an address (PIDADR=PID), or
; as 0 if it is 0, the default.

        .MACRO  $PUSHADR ADDR
        .IF     IDN <ADDR>, <0>
        PUSHL   #0
        .IFF
        PUSHAB  ADDR
        .ENDC
        .ENDM   $PUSHADR

        .MACRO  $CREPRC_S PIDADR=0, IMAGE=0, INPUT=0, OUTPUT=0, ERROR=0, PRVADR=0, QUOTA=0, PRCNAM=0, BASPRI=#2, UIC=#0, MBXUNT=#0, STSFLG=#0
        PUSHL   STSFLG
        PUSHL   MBXUNT
        PUSHL   UIC
        PUSHL   BASPRI
        $PUSHADR PRCNAM
        $PUSHADR QUOTA
        $PUSHADR PRVADR
        $PUSHADR ERROR
        $PUSHADR OUTPUT
        $PUSHADR INPUT
        $PUSHADR IMAGE
        $PUSHADR PIDADR
        .EXTERNAL SYS$CREPRC
        CALLS   #12, G^SYS$CREPRC
        .ENDM   $CREPRC_S

        .MACRO  $DELPRC_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$DELPRC
        CALLS   #2, G^SYS$DELPRC
        .ENDM   $DELPRC_S

        .MACRO  $EXIT_S CODE=#1
        PUSHL   CODE
        .EXTERNAL SYS$EXIT
        CALLS   #1, G^SYS$EXIT
        .ENDM   $EXIT_S

        .MACRO  $HIBER_S
        .EXTERNAL SYS$HIBER
        CALLS   #0, G^SYS$HIBER
        .ENDM   $HIBER_S

        .MACRO  $WAKE_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$WAKE
        CALLS   #2, G^SYS$WAKE
        .ENDM   $WAKE_S

        .MACRO  $SUSPND_S PIDADR=0, PRCNAM=0, FLAGS=#0
        PUSHL   FLAGS
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SUSPND
        CALLS   #3, G^SYS$SUSPND
        .ENDM   $SUSPND_S

        .MACRO  $RESUME_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$RESUME
        CALLS   #2, G^SYS$RESUME
        .ENDM   $RESUME_S

        .MACRO  $SETPRI_S PIDADR=0, PRCNAM=0, PRI, PRVPRI=0
        $PUSHADR PRVPRI
        PUSHL   PRI
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SETPRI
        CALLS   #4, G^SYS$SETPRI
        .ENDM   $SETPRI_S

        .MACRO  $SETPRN_S PRCNAM=0
        $PUSHADR PRCNAM
        .EXTERNAL SYS$SETPRN
        CALLS   #1, G^SYS$SETPRN
        .ENDM   $SETPRN_S

        .MACRO  $ASCEFC_S EFN, NAME, PROT=#0, PERM=#0
        PUSHL   PERM
        PUSHL   PROT
        $PUSHADR NAME
        PUSHL   EFN
        .EXTERNAL SYS$ASCEFC
        CALLS   #4, G^SYS$ASCEFC
        .ENDM   $ASCEFC_S

        .MACRO  $DACEFC_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$DACEFC
        CALLS   #1, G^SYS$DACEFC
        .ENDM   $DACEFC_S

        .MACRO  $SETEF_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$SETEF
        CALLS   #1, G^SYS$SETEF
        .ENDM   $SETEF_S

        .MACRO  $CLREF_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$CLREF
        CALLS   #1, G^SYS$CLREF
        .ENDM   $CLREF_S

        .MACRO  $READEF_S EFN, STATE
        $PUSHADR STATE
        PUSHL   EFN
        .EXTERNAL SYS$READEF
        CALLS   #2, G^SYS$READEF
        .ENDM   $READEF_S

        .MACRO  $WAITFR_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$WAITFR
        CALLS   #1, G^SYS$WAITFR
        .ENDM   $WAITFR_S

        .MACRO  $WFLOR_S EFN, MASK
        PUSHL   MASK
        PUSHL   EFN
        .EXTERNAL SYS$WFLOR
        CALLS   #2, G^SYS$WFLOR
        .ENDM   $WFLOR_S

        .MACRO  $WFLAND_S EFN, MASK
        PUSHL   MASK
        PUSHL   EFN
        .EXTERNAL SYS$WFLAND
        CALLS   #2, G^SYS$WFLAND
        .ENDM   $WFLAND_S

        .MACRO  $CRETVA_S INADR, RETADR=0, ACMODE=#0
        PUSHL   ACMODE
        $PUSHADR RETADR
        $PUSHADR INADR
        .EXTERNAL SYS$CRETVA
        CALLS   #3, G^SYS$CRETVA
        .ENDM   $CRETVA_S

        .MACRO  $DELTVA_S INADR, RETADR=0, ACMODE=#0
        PUSHL   ACMODE
        $PUSHADR RETADR
        $PUSHADR INADR
        .EXTERNAL SYS$DELTVA
        CALLS   #3, G^SYS$DELTVA
        .ENDM   $DELTVA_S

        .MACRO  $EXPREG_S PAGCNT, RETADR=0, ACMODE=#0, REGION=#0
        PUSHL   REGION
        PUSHL   ACMODE
        $PUSHADR RETADR
        PUSHL   PAGCNT
        .EXTERNAL SYS$EXPREG
        CALLS   #4, G^SYS$EXPREG
        .ENDM   $EXPREG_S

        .MACRO  $CMKRNL_S ROUTIN, ARGLST=0
        $PUSHADR ARGLST
        $PUSHADR ROUTIN
        .EXTERNAL SYS$CMKRNL
        CALLS   #2, G^SYS$CMKRNL
        .ENDM   $CMKRNL_S

        .MACRO  $CMEXEC_S ROUTIN, ARGLST=0
        $PUSHADR ARGLST
        $PUSHADR ROUTIN
        .EXTERNAL SYS$CMEXEC
        CALLS   #2, G^SYS$CMEXEC
        .ENDM   $CMEXEC_S

        .MACRO  $ASSIGN_S DEVNAM, CHAN, ACMODE=#0, MBXNAM=0
        $PUSHADR MBXNAM
        PUSHL   ACMODE
        $PUSHADR CHAN
        $PUSHADR DEVNAM
        .EXTERNAL SYS$ASSIGN
        CALLS   #4, G^SYS$ASSIGN
        .ENDM   $ASSIGN_S

        .MACRO  $DASSGN_S CHAN
        PUSHL   CHAN
        .EXTERNAL SYS$DASSGN
        CALLS   #1, G^SYS$DASSGN
        .ENDM   $DASSGN_S

        .MACRO  $QIOW_S EFN=#0, CHAN, FUNC, IOSB=0, ASTADR=0, ASTPRM=#0, P1=0, P2=#0, P3=#0, P4=#0, P5=#0, P6=#0
        PUSHL   P6
        PUSHL   P5
        PUSHL   P4
        PUSHL   P3
        PUSHL   P2
        $PUSHADR P1
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        PUSHL   FUNC
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$QIOW
        CALLS   #12, G^SYS$QIOW
        .ENDM   $QIOW_S

        .MACRO  $DCLAST_S ASTADR, ASTPRM=#0, ACMODE=#0
        PUSHL   ACMODE
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        .EXTERNAL SYS$DCLAST
        CALLS   #3, G^SYS$DCLAST
        .ENDM   $DCLAST_S

        .MACRO  $SETAST_S ENBFLG
        PUSHL   ENBFLG
        .EXTERNAL SYS$SETAST
        CALLS   #1, G^SYS$SETAST
        .ENDM   $SETAST_S

        .MACRO  $GETTIM_S TIMADR
        $PUSHADR TIMADR
        .EXTERNAL SYS$GETTIM
        CALLS   #1, G^SYS$GETTIM
        .ENDM   $GETTIM_S

        .MACRO  $SETIMR_S EFN=#0, DAYTIM, ASTADR=0, REQIDT=#0
        PUSHL   REQIDT
        $PUSHADR ASTADR
        $PUSHADR DAYTIM
        PUSHL   EFN
        .EXTERNAL SYS$SETIMR
        CALLS   #4, G^SYS$SETIMR
        .ENDM   $SETIMR_S

        .MACRO  $CANTIM_S REQIDT=#0, ACMODE=#0
        PUSHL   ACMODE
        PUSHL   REQIDT
        .EXTERNAL SYS$CANTIM
        CALLS   #2, G^SYS$CANTIM
        .ENDM   $CANTIM_S

        .MACRO  $SCHDWK_S PIDADR=0, PRCNAM=0, DAYTIM, REPTIM=0
        $PUSHADR REPTIM
        $PUSHADR DAYTIM
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SCHDWK
        CALLS   #4, G^SYS$SCHDWK
        .ENDM   $SCHDWK_S

