; starlet.mlb: what programs that call system services use, like VMS's
; STARLET.MLB. Use it with .LIBRARY "starlet.mlb" and vasm -I vtools/lib.

; $SSDEF: system service status codes, as VMS numbers them.
        .MACRO  $SSDEF
SS$_NORMAL = 1
SS$_CONTINUE = 1                        ; a handler's: go on where the condition was signaled
SS$_WASCLR = 1
SS$_WASSET = 9
SS$_ACCVIO = 12
SS$_BADPARAM = 20
SS$_DEVOFFLINE = 132                    ; the device isn't there: no network
SS$_EXQUOTA = 28
SS$_NOPRIV = 36
SS$_ABORT = 44
SS$_DEVMOUNT = 108                      ; the device is already mounted
SS$_DEVNOTMOUNT = 124                   ; no volume is mounted on the device
SS$_BADIMGHDR = 68
SS$_DEVNOTMBX = 116                     ; the device isn't a mailbox
SS$_DRVERR = 140
SS$_DUPLNAM = 148
SS$_ILLBLKNUM = 220
SS$_DEVACTIVE = 708                     ; the device is in use: the system disk, or one with files open
SS$_ILLEFC = 236
SS$_ILLIOFUNC = 244
SS$_ILLPAGCNT = 252
SS$_ILLSER = 260
SS$_IVADDR = 308                        ; a bad network address
SS$_INCVOLLABEL = 268                   ; the volume's label isn't the one asked for
SS$_INSFARG = 276
SS$_INSFMEM = 292
SS$_INSFRAME = 300                      ; $UNWIND: fewer frames than its depth
SS$_IVCHAN = 316
SS$_IVDEVNAM = 324                      ; no device name, or a bad one
SS$_IVLOGNAM = 340
SS$_IVLOGTAB = 348
SS$_IVSSRQ = 372
SS$_MEDOFL = 420                        ; the medium is offline: a ramdisk not made yet
SS$_NOIOCHAN = 436
SS$_NOLOGNAM = 444
SS$_PAGOWNVIO = 492
SS$_TIMEOUT = 556
SS$_REJECT = 660                        ; the peer refused the connection
SS$_INSFBUFDP = 828                     ; no buffer for the request
SS$_IVBUFLEN = 844                      ; a buffer too long for the device
SS$_UNASEFC = 564
SS$_VASFULL = 580
SS$_WRITLCK = 604                       ; the device is write locked
SS$_IVMODE = 852
SS$_MBTOOSML = 412                      ; the message is longer than the mailbox takes
SS$_OPCDEC = 1084
SS$_NOTALLPRIV = 1665                   ; success: $SETPRV enabled only the privileges it may
SS$_BUFFEROVF = 1537                    ; success: the output didn't all fit in the buffer
SS$_CONTROLY = 1553                     ; CTRL/Y stopped the image
SS$_CONTROLC = 1617                     ; CTRL/C, which no CTRL/C AST took, stopped the image
SS$_CREATED = 1561                      ; success: it wasn't there, and was made
SS$_MSGNOTFND = 1569                    ; success: $GETMSG has no text for the status
SS$_SUPERSEDE = 1585                    ; success: a name by that name was replaced
SS$_NONEXPR = 2280
SS$_NOHANDLER = 2296                    ; no such exit handler
SS$_NOSIGNAL = 2304                     ; $UNWIND outside a condition handler
SS$_RESIGNAL = 2328                     ; a handler's: let the next one have the condition
SS$_UNWIND = 2336                       ; to a frame's handler: $UNWIND removes the frame
SS$_UNWINDING = 2344                    ; $UNWIND twice for one condition
SS$_SIGNAL64 = 9732                     ; a 64-bit signal array's second longword
SS$_ARG_GTR_32_BITS = 9916              ; an argument isn't a sign-extended longword
SS$_NOMOREPROC = 2472                   ; a wildcard $GETJPI is past the last process
SS$_NOSUCHDEV = 2312
SS$_NOSUCHFILE = 2320
SS$_BADCHKSUM = 2056
SS$_BADFILEHDR = 2064
SS$_BADFILEVER = 2080                   ; a version above 32767
SS$_BADIRECTORY = 2088
SS$_DEVICEFULL = 2128                   ; no free blocks left
SS$_DUPFILENAME = 2152                  ; that name and version is in the directory already
SS$_ENDOFFILE = 2160
SS$_HEADERFULL = 2248                   ; the file's map is full
SS$_MBFULL = 2264                       ; the mailbox has no room for the message
SS$_IDXFILEFULL = 2256                  ; no free file headers left
SS$_NOHOMEBLK = 2272                    ; no Files-11 home block
SS$_NOMOREFILES = 2352
SS$_NOMOREDEV = 2648                    ; no more devices to list
SS$_UNREACHABLE = 8340                  ; no route to the peer
SS$_LINKABORT = 8420                    ; the connection was reset
SS$_LINKDISCON = 8428                   ; the peer closed the connection
SS$_DIRNOTEMPTY = 8564                  ; a directory to delete has files in it
SS$_FORCEDEXIT = 8572                   ; $FORCEX ended the image
SS$_NOLOGTAB = 8852
        .ENDM   $SSDEF

; $CLIMSGDEF: the command language interpreter's status codes, facility
; CLI, as VMS numbers them. DCL reports them as %DCL-.
        .MACRO  $CLIMSGDEF
CLI$_ABVERB = ^X38008                   ; ambiguous command verb
CLI$_ABKEYW = ^X38010                   ; ambiguous qualifier or keyword
CLI$_BUFOVF = ^X38018                   ; command buffer overflow
CLI$_INSFPRM = ^X38048                  ; missing command parameters
CLI$_IVKEYW = ^X38060                   ; unrecognized keyword
CLI$_IVVERB = ^X38090                   ; unrecognized command verb
CLI$_MAXPARM = ^X38098                  ; too many parameters
CLI$_NOCCAT = ^X380A8                   ; parameter concatenation not allowed
CLI$_NOCOMD = ^X380B0                   ; no command on line
CLI$_NOKEYW = ^X380B8                   ; qualifier name is missing
CLI$_NOLIST = ^X380C0                   ; list of parameter values not allowed
CLI$_NOQUAL = ^X380C8                   ; qualifiers not allowed
CLI$_NOVALU = ^X380D0                   ; value not allowed
CLI$_NOTNEG = ^X380D8                   ; qualifier or keyword not negatable
CLI$_NUMBER = ^X380E8                   ; invalid numeric value
CLI$_PARMDEL = ^X38110                  ; invalid parameter delimiter
CLI$_VALREQ = ^X38150                   ; missing qualifier or keyword value
CLI$_ONEVAL = ^X38158                   ; list of values not allowed
CLI$_ABSENT = ^X381F0                   ; entity or value absent from command string
CLI$_NEGATED = ^X381F8                  ; entity explicitly negated
CLI$_LOCNEG = ^X38230                   ; entity explicitly and locally negated
CLI$_IVQUAL = ^X38240                   ; unrecognized qualifier
CLI$_CONFLICT = ^X38258                 ; illegal combination of command elements
CLI$_NOPAREN = ^X38288                  ; value improperly delimited
CLI$_INVROUT = ^X38912                  ; invalid routine specified in command tables
CLI$_INVTAB = ^X38922                   ; command tables have invalid format
CLI$_ENTNF = ^X38932                    ; entity not found in command tables
CLI$_PRESENT = ^X3FD19                  ; entity value is present
CLI$_DEFAULTED = ^X3FD21                ; entity defaulted present
CLI$_CONCAT = ^X3FD29                   ; value terminated by a plus sign
CLI$_LOCPRES = ^X3FD31                  ; entity value is locally present
CLI$_COMMA = ^X3FD39                    ; value terminated by a comma
        .ENDM   $CLIMSGDEF

; $RMSDEF: RMS status codes, as VMS numbers them.
        .MACRO  $RMSDEF
RMS$_NORMAL = ^X10001
RMS$_EOF = ^X1827A                      ; end of file
RMS$_FNF = ^X18292                      ; file not found
RMS$_WLK = ^X182BA                      ; device write locked: the volume is read-only
RMS$_NMF = ^X182CA                      ; no more files
RMS$_RTB = ^X181A8                      ; record too big for the user's buffer
RMS$_DNF = ^X1C04A                      ; directory not found
RMS$_DEV = ^X184C4                      ; bad device
RMS$_DIR = ^X184CC                      ; bad directory
RMS$_DME = ^X184D4                      ; dynamic memory exhausted
RMS$_ESA = ^X184FC                      ; no expanded string area
RMS$_ESS = ^X18504                      ; expanded string area too small
RMS$_FAB = ^X1850C                      ; not a FAB
RMS$_FNM = ^X1852C                      ; bad file name
RMS$_IFI = ^X18564                      ; bad internal file index
RMS$_ISI = ^X18584                      ; bad internal stream index
RMS$_NAM = ^X185DC                      ; not a NAM block
RMS$_RAB = ^X1863C                      ; not a RAB
RMS$_RFM = ^X18664                      ; record format RMS can't read
RMS$_RSS = ^X18694                      ; resultant string area too small
RMS$_SYN = ^X186D4                      ; file specification syntax
RMS$_VER = ^X186FC                      ; bad version
RMS$_WLD = ^X18744                      ; wildcard where one may not be
RMS$_DNR = ^X18272                      ; device not ready: not mounted
RMS$_FEX = ^X18282                      ; file already exists
RMS$_PRV = ^X1829A                      ; privilege or protection violation, or a reserved file
RMS$_FUL = ^X18544                      ; device full
RMS$_IOP = ^X18574                      ; operation the file wasn't opened for
RMS$_NEF = ^X185E4                      ; $PUT not at the end of the file
RMS$_RSZ = ^X186A4                      ; record size: a FIX record of another size
RMS$_CRE = ^X1C00A                      ; the file system couldn't create the file
RMS$_ENT = ^X1C01A                      ; or enter it in its directory
RMS$_MKD = ^X1C032                      ; or delete it
RMS$_WER = ^X1C114                      ; or write it
        .ENDM   $RMSDEF

; $FABDEF: the file access block, for RMS's sequential files.
        .MACRO  $FABDEF
FAB$C_BID = 3
FAB$C_BLN = 80
FAB$B_BID = 0
FAB$B_BLN = 1
FAB$W_IFI = 2                           ; internal file index, from $OPEN or $CREATE
FAB$L_FOP = 4                           ; file processing options: FAB$M_NAM
FAB$L_STS = 8                           ; the status of the last operation
FAB$L_STV = 12
FAB$L_ALQ = 16                          ; blocks allocated
FAB$B_FAC = 22                          ; access wanted: FAB$M_
FAB$B_ORG = 29                          ; organization: FAB$C_SEQ
FAB$B_RAT = 30                          ; record attributes: FAB$M_CR
FAB$B_RFM = 31                          ; record format: FAB$C_
FAB$L_NAM = 40                          ; a NAM block, or 0
FAB$L_FNA = 44                          ; the file specification
FAB$L_DNA = 48                          ; the default one
FAB$B_FNS = 52                          ; their lengths
FAB$B_DNS = 53
FAB$W_MRS = 54                          ; maximum record size
FAB$B_FSZ = 63                          ; VFC header size
FAB$L_XAB = 36                          ; the first XAB, or 0
FAB$M_PUT = 1
FAB$M_GET = 2
FAB$M_DEL = 4
FAB$M_UPD = 8
FAB$M_TRN = 16
FAB$C_SEQ = 0
FAB$M_CR = 2
FAB$M_BLK = 8                           ; records don't span blocks
FAB$M_NAM = ^X1000000                   ; $ERASE the file the NAM block's resultant string names
FAB$C_UDF = 0
FAB$C_FIX = 1
FAB$C_VAR = 2
FAB$C_VFC = 3
        .ENDM   $FABDEF

; $RABDEF: the record access block.
        .MACRO  $RABDEF
RAB$C_BID = 1
RAB$C_BLN = 68
RAB$B_BID = 0
RAB$B_BLN = 1
RAB$W_ISI = 2                           ; internal stream index, from $CONNECT
RAB$L_ROP = 4                           ; record processing options: RAB$M_EOF
RAB$M_EOF = ^X100                       ; $CONNECT at the end of the file
RAB$L_STS = 8
RAB$L_STV = 12
RAB$W_USZ = 32                          ; the user's buffer: its size
RAB$W_RSZ = 34                          ; the record's size
RAB$L_UBF = 36                          ; and address
RAB$L_RBF = 40                          ; where $GET put the record, what $PUT writes
RAB$L_FAB = 60                          ; the FAB $CONNECT connects to
        .ENDM   $RABDEF

; $NAMDEF: the name block, which $PARSE, $SEARCH and $OPEN fill.
        .MACRO  $NAMDEF
NAM$C_BID = 2
NAM$C_BLN = 96
NAM$B_BID = 0
NAM$B_BLN = 1
NAM$B_RSS = 2                           ; the resultant string area: size
NAM$B_RSL = 3                           ; the string's length
NAM$L_RSA = 4                           ; its address
NAM$B_ESS = 10                          ; the expanded string area: size
NAM$B_ESL = 11
NAM$L_ESA = 12
NAM$W_FID = 36                          ; file ID, 3 words
NAM$W_DID = 42                          ; directory ID, 3 words
NAM$L_WCC = 48                          ; $SEARCH's context
NAM$L_FNB = 52                          ; NAM$M_ bits
NAM$B_DEV = 57                          ; the lengths of the string's parts
NAM$B_DIR = 58
NAM$B_NAME = 59
NAM$B_TYPE = 60
NAM$B_VER = 61
NAM$L_DEV = 68                          ; and their addresses
NAM$L_DIR = 72
NAM$L_NAME = 76
NAM$L_TYPE = 80
NAM$L_VER = 84
NAM$M_WILDCARD = ^X100                  ; the specification has a wildcard
        .ENDM   $NAMDEF

; $DVIDEF: $GETDVI's item codes, VMS's, those vaxpunk knows.
        .MACRO  $DVIDEF
DVI$_DEVCHAR = 2                        ; the DEV$ bits, a longword
DVI$_DEVCLASS = 4                       ; DC$_DISK or DC$_TERM
DVI$_DEVTYPE = 6                        ; a terminal's DT$ type
DVI$_DEVBUFSIZ = 8                      ; a terminal's width, a disk's block size
DVI$_DEVDEPEND = 10                     ; a terminal's TT$ bits, its page in the top byte
DVI$_UNIT = 12
DVI$_ERRCNT = 20
DVI$_DEVDEPEND2 = 28                    ; a terminal's TT2$ bits
DVI$_DEVNAM = 32                        ; the device's name, _DDCU:
DVI$_VOLNAM = 34                        ; the mounted volume's label
DVI$_FREEBLOCKS = 42                    ; its free blocks
DVI$_MOUNTCNT = 56                      ; 1 if a volume is mounted, else 0
DVI$_CLUSTER = 58                       ; its cluster, in blocks
DVI$_AVL = 98                           ; DEVCHAR's bits, each 1 or 0
DVI$_MNT = 100
DVI$_SWL = 112
DVI$_STS = 226                          ; the UCB$ status bits: UCB$M_ONLINE
        .ENDM   $DVIDEF

; $DVSDEF: $DEVICE_SCAN's item codes.
        .MACRO  $DVSDEF
DVS$_DEVCLASS = 1                       ; only devices of this class, a longword
        .ENDM   $DVSDEF

; $DCDEF: device classes.
        .MACRO  $DCDEF
DC$_DISK = 1
DC$_TERM = 66
DC$_MAILBOX = 160
DT$_VT100 = 96                          ; a terminal's type: a VT100
        .ENDM   $DCDEF

; $TTDEF: a terminal's characteristics, the second longword of what
; IO$_SETMODE and IO$_SENSEMODE take and give, and DVI$_DEVDEPEND: the
; page length in the top byte.
        .MACRO  $TTDEF
TT$V_PASSALL = 0                        ; no editing and no control keys
TT$V_NOECHO = 1                         ; reads don't echo
TT$V_NOTYPEAHD = 2
TT$V_ESCAPE = 3                         ; reads end at an escape sequence
TT$V_HOSTSYNC = 4
TT$V_TTSYNC = 5
TT$V_LOWER = 7                          ; it has lowercase
TT$V_MECHTAB = 8                        ; it has tab stops
TT$V_WRAP = 9                           ; it wraps at its width
TT$V_SCOPE = 12                         ; a screen, not paper
TT$V_REMOTE = 13
TT$V_EIGHTBIT = 15
TT$V_NOBRDCST = 17                      ; no broadcast messages
TT$V_READSYNC = 18
TT$V_MECHFORM = 19
TT$V_HALFDUP = 20
TT$V_MODEM = 21
TT$V_PAGE = 24                          ; the page length, a byte
TT$M_NOECHO = ^X2
TT$M_ESCAPE = ^X8
TT$M_TTSYNC = ^X20
TT$M_LOWER = ^X80
TT$M_MECHTAB = ^X100
TT$M_WRAP = ^X200
TT$M_SCOPE = ^X1000
TT$M_EIGHTBIT = ^X8000
TT$M_NOBRDCST = ^X20000
        .ENDM   $TTDEF

; $TT2DEF: a terminal's extended characteristics, the third longword of
; IO$_SETMODE's and IO$_SENSEMODE's buffer, and DVI$_DEVDEPEND2.
        .MACRO  $TT2DEF
TT2$V_LOCALECHO = 0
TT2$V_AUTOBAUD = 1
TT2$V_HANGUP = 2
TT2$V_BRDCSTMBX = 4
TT2$V_DMA = 6
TT2$V_ALTYPEAHD = 7
TT2$V_SETSPEED = 8
TT2$V_DECCRT4 = 10
TT2$V_COMMSYNC = 11
TT2$V_EDITING = 12                      ; line editing
TT2$V_INSERT = 13                       ; in insert mode, not overstrike
TT2$V_FALLBACK = 14
TT2$V_DIALUP = 15
TT2$V_SECURE = 16
TT2$V_DISCONNECT = 17
TT2$V_PASTHRU = 18                      ; reads pass every character but CTRL/C and CTRL/Y
TT2$V_SYSPWD = 19
TT2$V_SIXEL = 20
TT2$V_DRCS = 21                         ; soft characters
TT2$V_PRINTER = 22
TT2$V_APP_KEYPAD = 23                   ; the keypad in application mode
TT2$V_ANSICRT = 24
TT2$V_REGIS = 25
TT2$V_BLOCK = 26
TT2$V_AVO = 27                          ; advanced video
TT2$V_EDIT = 28                         ; edit mode
TT2$V_DECCRT = 29
TT2$V_DECCRT2 = 30
TT2$V_DECCRT3 = 31
TT2$M_EDITING = ^X1000
TT2$M_INSERT = ^X2000
TT2$M_PASTHRU = ^X40000
TT2$M_ANSICRT = ^X1000000
TT2$M_AVO = ^X8000000
TT2$M_EDIT = ^X10000000
TT2$M_DECCRT = ^X20000000
        .ENDM   $TT2DEF

; $DEVDEF: device characteristics, DVI$_DEVCHAR's bits.
        .MACRO  $DEVDEF
DEV$M_REC = ^X1                         ; record oriented
DEV$M_CCL = ^X2                         ; carriage control
DEV$M_TRM = ^X4                         ; a terminal
DEV$M_DIR = ^X8                         ; directory structured
DEV$M_FOD = ^X4000                      ; files oriented
DEV$M_SHR = ^X10000                     ; shareable
DEV$M_AVL = ^X40000                     ; available
DEV$V_AVL = 18
DEV$M_MNT = ^X80000                     ; a volume is mounted
DEV$V_MNT = 19
DEV$M_SWL = ^X2000000                   ; software write locked: the volume is read only
DEV$V_SWL = 25
DEV$M_IDV = ^X4000000                   ; input
DEV$M_ODV = ^X8000000                   ; output
DEV$M_RND = ^X10000000                  ; random access
        .ENDM   $DEVDEF

; $MSGDEF: the types of the messages the system writes to mailboxes.
        .MACRO  $MSGDEF
MSG$_DELPROC = 3                        ; a process was deleted: its termination message, $ACCDEF
        .ENDM   $MSGDEF

; $ACCDEF: a process's termination message, which the mailbox whose unit
; $CREPRC's mbxunt named gets when the process is deleted. What vaxpunk
; doesn't keep is 0: the job, account, user name, accounting counts and
; login time.
        .MACRO  $ACCDEF
ACC$W_MSGTYP = 0                        ; MSG$_DELPROC
ACC$L_FINALSTS = 4                      ; the status of its last $EXIT, or 0
ACC$L_PID = 8
ACC$L_JOBID = 12
ACC$Q_TERMTIME = 16                     ; the system time it was deleted at
ACC$T_ACCOUNT = 24                      ; 8 characters
ACC$T_USERNAME = 32                     ; 12 characters
ACC$L_CPUTIM = 44
ACC$L_PAGEFLTS = 48
ACC$L_PGFLPEAK = 52
ACC$L_WSPEAK = 56
ACC$L_BIOCNT = 60
ACC$L_DIOCNT = 64
ACC$L_VOLUMES = 68
ACC$Q_LOGIN = 72
ACC$L_OWNER = 80                        ; its creator's PID
ACC$K_TERMLEN = 84                      ; the message's size
        .ENDM   $ACCDEF

; $MNTDEF: $MOUNT's item codes.
        .MACRO  $MNTDEF
MNT$_DEVNAM = 1                         ; the device
MNT$_VOLNAM = 2                         ; the volume's label
MNT$_OWNER = 13                         ; the volume's owner, a UIC, for this mount
MNT$_VPROT = 14                         ; and protection, a word
        .ENDM   $MNTDEF

; $INITDEF: $INIT_VOL's item codes, VMS's names; the codes are vaxpunk's.
        .MACRO  $INITDEF
INIT$_OWNER = 1                         ; the volume's owner, a UIC: the caller's by default
INIT$_VOLPRO = 2                        ; its protection, a word: 0, all may, by default
        .ENDM   $INITDEF

; $ARMDEF: an access mask: what a process wants to do to a file or a
; volume, which its protection, 4 bits a category, denies or not.
        .MACRO  $ARMDEF
ARM$M_READ = 1
ARM$M_WRITE = 2
ARM$M_EXECUTE = 4                       ; a file's; a directory's: look a name up in it
ARM$M_DELETE = 8
ARM$M_CONTROL = 16                      ; change the protection: the owner's and the system's
ARM$M_SYSTEM = 32                       ; vaxpunk's: change the owner, the system's only
        .ENDM   $ARMDEF

; $XABPRODEF: the protection XAB, which $OPEN fills with the file's owner
; and protection, and $CLOSE changes them to.
        .MACRO  $XABPRODEF
XAB$C_PRO = 19                          ; XAB$B_COD
XAB$C_PROLEN = 16                       ; XAB$B_BLN
XAB$B_COD = 0
XAB$B_BLN = 1
XAB$L_NXT = 4                           ; the next XAB, or 0
XAB$W_PRO = 8                           ; the protection: 4 bits each for system, owner, group, world, a set bit denying
XAB$L_UIC = 12                          ; the owner
XAB$V_NOREAD = 0                        ; a category's bits
XAB$V_NOWRITE = 1
XAB$V_NOEXE = 2
XAB$V_NODEL = 3
        .ENDM   $XABPRODEF

; $FAB, $RAB, $NAM, $XABPRO: a FAB, RAB, name block or protection XAB,
; with the fields given and the rest 0. Lengths are values (FNS=#5 is
; FNS=5 here), addresses labels.
        .MACRO  $FAB    FNA=0, FNS=0, DNA=0, DNS=0, NAM=0, FAC=0, XAB=0
        .BYTE   3, 80                   ; BID, BLN
        .WORD   0                       ; IFI
        .LONG   0, 0, 0, 0              ; FOP, STS, STV, ALQ
        .WORD   0                       ; DEQ
        .BYTE   FAC, 0                  ; FAC, SHR
        .LONG   0                       ; CTX
        .BYTE   0, 0, 0, 0              ; RTV, ORG, RAT, RFM
        .LONG   0                       ; JNL
        .ADDRESS XAB
        .ADDRESS NAM, FNA, DNA
        .BYTE   FNS, DNS
        .BLKB   26                      ; MRS to the end
        .ENDM   $FAB

        .MACRO  $RAB    FAB=0, UBF=0, USZ=0
        .BYTE   1, 68                   ; BID, BLN
        .WORD   0                       ; ISI
        .LONG   0, 0, 0                 ; ROP, STS, STV
        .WORD   0, 0, 0, 0              ; RFA, and a word
        .LONG   0                       ; CTX
        .BYTE   0, 0, 0, 0              ; two bytes, RAC, TMO
        .WORD   USZ, 0                  ; USZ, RSZ
        .ADDRESS UBF
        .LONG   0, 0, 0                 ; RBF, RHB, KBF
        .BYTE   0, 0, 0, 0              ; KSZ, KRF, MBF, MBC
        .LONG   0                       ; BKT
        .ADDRESS FAB
        .LONG   0                       ; XAB
        .ENDM   $RAB

        .MACRO  $XABPRO PRO=0, UIC=0
        .BYTE   19, 16                  ; COD, BLN
        .WORD   0
        .LONG   0                       ; NXT
        .WORD   PRO
        .BYTE   0, 0                    ; MTACC, PROT_OPT
        .LONG   UIC
        .ENDM   $XABPRO

        .MACRO  $NAM    ESA=0, ESS=0, RSA=0, RSS=0
        .BYTE   2, 96                   ; BID, BLN
        .BYTE   RSS, 0                  ; RSS, RSL
        .ADDRESS RSA
        .BYTE   0, 0, ESS, 0            ; NOP, RFS, ESS, ESL
        .ADDRESS ESA
        .BLKB   80                      ; RLF to the end
        .ENDM   $NAM

; $OPEN, $CREATE, $CLOSE, $ERASE, $PARSE, $SEARCH FAB=fab and $CONNECT,
; $DISCONNECT, $GET, $PUT RAB=rab: the RMS services, which take the
; block's address.
        .MACRO  $RMSCALL NAME, BLOCK
        PUSHAB  BLOCK
        .EXTERNAL SYS$'NAME
        CALLS   #1, G^SYS$'NAME
        .ENDM   $RMSCALL

        .MACRO  $OPEN   FAB
        $RMSCALL OPEN, FAB
        .ENDM   $OPEN

        .MACRO  $CREATE FAB
        $RMSCALL CREATE, FAB
        .ENDM   $CREATE

        .MACRO  $CLOSE  FAB
        $RMSCALL CLOSE, FAB
        .ENDM   $CLOSE

        .MACRO  $ERASE  FAB
        $RMSCALL ERASE, FAB
        .ENDM   $ERASE

        .MACRO  $PARSE  FAB
        $RMSCALL PARSE, FAB
        .ENDM   $PARSE

        .MACRO  $SEARCH FAB
        $RMSCALL SEARCH, FAB
        .ENDM   $SEARCH

        .MACRO  $CONNECT RAB
        $RMSCALL CONNECT, RAB
        .ENDM   $CONNECT

        .MACRO  $DISCONNECT RAB
        $RMSCALL DISCONNECT, RAB
        .ENDM   $DISCONNECT

        .MACRO  $GET    RAB
        $RMSCALL GET, RAB
        .ENDM   $GET

        .MACRO  $PUT    RAB
        $RMSCALL PUT, RAB
        .ENDM   $PUT

; $PSLDEF: the processor status longword's fields and the access modes,
; from kernel, the innermost, out to user.
        .MACRO  $PSLDEF
PSL$V_IPL = 16
PSL$V_PRVMOD = 22                       ; the mode before the last change
PSL$V_CURMOD = 24
PSL$C_KERNEL = 0
PSL$C_EXEC = 1
PSL$C_SUPER = 2
PSL$C_USER = 3
        .ENDM   $PSLDEF

; $DSCDEF: descriptors, 32-bit and 64-bit (DSC64$), which has a word 1,
; MBO, where a 32-bit one has its length, and a longword -1, MBMO, where it
; has its pointer: $IS_DESC64 tells them apart by both.
        .MACRO  $DSCDEF
DSC$W_LENGTH = 0
DSC$B_DTYPE = 2
DSC$B_CLASS = 3
DSC$A_POINTER = 4
DSC$K_S_BLN = 8
DSC64$W_MBO = 0                         ; 1
DSC64$B_DTYPE = 2
DSC64$B_CLASS = 3
DSC64$L_MBMO = 4                        ; -1
DSC64$Q_LENGTH = 8
DSC64$PQ_POINTER = 16
DSC64$K_S_BLN = 24
DSC$K_DTYPE_T = 14                      ; text
DSC$K_CLASS_S = 1                       ; static: a string where the pointer says
        .ENDM   $DSCDEF

; $ILEDEF: item list entries: VMS's 32-bit one, ILE3$, and the 64-bit ones,
; ILEA_64$ and ILEB_64$, which has a return length address too, with MBO
; and MBMO as a 64-bit descriptor has them.
        .MACRO  $ILEDEF
ILE3$W_LENGTH = 0
ILE3$W_CODE = 2
ILE3$PS_BUFADDR = 4
ILE3$PS_RETLEN_ADDR = 8
ILE3$K_LENGTH = 12
ILEA_64$W_MBO = 0                       ; 1
ILEA_64$W_CODE = 2
ILEA_64$L_MBMO = 4                      ; -1
ILEA_64$Q_LENGTH = 8
ILEA_64$PQ_BUFADDR = 16
ILEA_64$K_LENGTH = 24
ILEB_64$W_MBO = 0
ILEB_64$W_CODE = 2
ILEB_64$L_MBMO = 4
ILEB_64$Q_LENGTH = 8
ILEB_64$PQ_BUFADDR = 16
ILEB_64$PQ_RETLEN_ADDR = 24
ILEB_64$K_LENGTH = 32
        .ENDM   $ILEDEF

; $CHFDEF: a condition handler's arguments, as 64-bit VMS's
; (DESIGN-0004, *Condition handling*). The 32-bit signal array: a count,
; the condition, its arguments, then the PC and PSL where it was
; signaled, longwords. The 64-bit one: a count, SS$_SIGNAL64, then the
; same as quadwords. The mechanism array: the frame that established the
; handler, its depth, 0 for the routine that signaled, the R0 and R1 it
; goes on with, x2-x17 when it was signaled, and both signal arrays. The
; CHF$L_MCH_ names are the low longwords of the quadwords, as VMS kept
; them for 32-bit code.
        .MACRO  $CHFDEF
CHF$L_SIGARGLST = 4                     ; a handler's first argument
CHF$L_MCHARGLST = 8                     ; its second
CHF$L_SIG_ARGS = 0                      ; the signal array's count
CHF$L_SIG_NAME = 4                      ; the condition
CHF$L_SIG_ARG1 = 8
CHF64$L_SIG_ARGS = 0                    ; the 64-bit one's count
CHF64$L_SIGNAL64 = 4                    ; SS$_SIGNAL64
CHF64$Q_SIG_NAME = 8                    ; the condition
CHF64$Q_SIG_ARG1 = 16
CHF$IS_MCH_ARGS = 0                     ; the quadwords after the first, 24
CHF$IS_MCH_FLAGS = 4
CHF$PH_MCH_FRAME = 8                    ; the establisher's FP
CHF$IS_MCH_DEPTH = 16                   ; 0 the frame that signaled, 1 its caller
CHF$PH_MCH_DADDR = 24                   ; handler data, 0
CHF$PH_MCH_ESF_ADDR = 32                ; the exception's frame, 0 for a signal
CHF$PH_MCH_SIG_ADDR = 40                ; the 32-bit signal array
CHF$IH_MCH_RETVAL = 48                  ; R0
CHF$IH_MCH_RETVAL2 = 56                 ; R1
CHF$IH_MCH_SAVX2 = 64                   ; x2-x17, 8 bytes each
CHF$PH_MCH_SIG64_ADDR = 192             ; the 64-bit signal array
CHF$S_MCH = 200
CHF$L_MCH_FRAME = CHF$PH_MCH_FRAME
CHF$L_MCH_DEPTH = CHF$IS_MCH_DEPTH
CHF$L_MCH_SAVR0 = CHF$IH_MCH_RETVAL
CHF$L_MCH_SAVR1 = CHF$IH_MCH_RETVAL2
        .ENDM   $CHFDEF

; $STSDEF: a condition value's fields.
        .MACRO  $STSDEF
STS$K_WARNING = 0
STS$K_SUCCESS = 1
STS$K_ERROR = 2
STS$K_INFO = 3
STS$K_SEVERE = 4
STS$M_SEVERITY = 7
STS$V_FAC_NO = 16                       ; the facility, 12 bits: 0 for the system's
STS$M_INHIB_MSG = ^X10000000            ; the message was written already
        .ENDM   $STSDEF

; $IODEF: I/O function codes for $QIO.
        .MACRO  $IODEF
IO$_WRITEPBLK = 11
IO$_WRITELBLK = 32
IO$_WRITEVBLK = 48
IO$_READPBLK = 12
IO$_READLBLK = 33
IO$_READVBLK = 49
IO$_READPROMPT = 55                     ; writes the prompt in p5 and p6 first
IO$_SETMODE = 35                        ; a terminal: sets its characteristics, or enables a CTRL/C or CTRL/Y AST
IO$V_CTRLYAST = 7                       ; SETMODE: the AST is CTRL/Y's
IO$M_CTRLYAST = ^X80
IO$V_CTRLCAST = 8                       ; SETMODE: the AST is CTRL/C's
IO$M_CTRLCAST = ^X100
IO$V_NOECHO = 6                         ; a read doesn't echo
IO$M_NOECHO = ^X40
IO$V_NOFILTR = 9                        ; a read doesn't edit: DEL, CTRL/U are data
IO$M_NOFILTR = ^X200
IO$V_NOW = 6                            ; a mailbox's read doesn't wait for a message
IO$M_NOW = ^X40
IO$_SETCHAR = 26                        ; BGA0: sets the interface's address
IO$_SENSECHAR = 27                      ; BGA0: senses it
IO$_ACCESS = 50                         ; a network unit: connects, or accepts
IO$_DEACCESS = 52                       ; a network unit: closes
IO$_SENSEMODE = 39                      ; a terminal: its characteristics; a network unit: its number and channels
IO$V_BIND = 10                          ; a network unit's SETMODE: binds a local address
IO$M_BIND = ^X400
IO$V_LISTEN = 11                        ; a network unit's SETMODE: listens
IO$M_LISTEN = ^X800
IO$V_ACCEPT = 10                        ; a network unit's ACCESS: accepts a connection
IO$M_ACCEPT = ^X400
        .ENDM   $IODEF

; $LNMDEF: logical names: item codes for the item lists of $CRELNM and
; $TRNLNM, and limits. An item list is 12-byte items, each a word buffer
; length, a word item code, a buffer address and the address of a word
; for the length returned, or 0; a longword 0 ends it.
        .MACRO  $LNMDEF
LNM$_STRING = 2                         ; the equivalence string
LNM$_TABLE = 4                          ; the name of the table it was found in
LNM$_LENGTH = 5                         ; the equivalence string's length, a longword
LNM$C_NAMLENGTH = 255                   ; the longest name or equivalence string
LNM$C_MAXDEPTH = 10                     ; translations of a device name, at most
        .ENDM   $LNMDEF

; $JPIDEF: $GETJPI's item codes, VMS's, those vaxpunk knows. The item list
; is as $LNMDEF says.
        .MACRO  $JPIDEF
JPI$_PRI = ^X302                        ; the current priority, 0-31, a longword
JPI$_OWNER = ^X303                      ; the creator's PID
JPI$_STS = ^X305                        ; the PCB$V_ bits
JPI$_STATE = ^X306                      ; the scheduling state, SCH$C_
JPI$_PRIB = ^X309                       ; the base priority
JPI$_PID = ^X319
JPI$_PRCNAM = ^X31C                     ; the process's name
JPI$_IMAGNAME = ^X207                   ; the image it runs, or ran last
JPI$_UIC = ^X304                        ; its UIC, a longword
JPI$_MEM = ^X307                        ; the UIC's member, and its group
JPI$_GRP = ^X308
JPI$_PROCPRIV = ^X204                   ; its privileges, quadwords: permanent,
JPI$_CURPRIV = ^X400                    ; current,
JPI$_AUTHPRIV = ^X412                   ; and authorized
        .ENDM   $JPIDEF

; $SYIDEF: $GETSYI's item codes, VMS's, those vaxpunk knows.
        .MACRO  $SYIDEF
SYI$_VERSION = 4096                     ; the system's version, 8 characters
SYI$_MAXPROCESSCNT = 4105               ; how many processes there may be
SYI$_QUANTUM = 4137                     ; ticks of 10 ms in a quantum
SYI$_BOOTTIME = 4286                    ; the system time at boot, a quadword
        .ENDM   $SYIDEF

; $PRVDEF: the privileges, VMS's bits in a quadword mask: PRV$V_name, and
; PRV$M_name, the mask in the first longword, for those vaxpunk checks.
        .MACRO  $PRVDEF
PRV$V_CMKRNL = 0                        ; $CMKRNL
PRV$V_CMEXEC = 1                        ; $CMEXEC
PRV$V_SYSNAM = 2                        ; LNM$SYSTEM_TABLE's names, and volumes mounted for all
PRV$V_GRPNAM = 3
PRV$V_ALLSPOOL = 4
PRV$V_DETACH = 5                        ; a process with another UIC
PRV$V_DIAGNOSE = 6
PRV$V_LOG_IO = 7                        ; a disk's blocks by LBN
PRV$V_GROUP = 8                         ; other processes in its UIC group
PRV$V_NOACNT = 9
PRV$V_PRMCEB = 10
PRV$V_PRMMBX = 11                       ; permanent mailboxes
PRV$V_PSWAPM = 12
PRV$V_ALTPRI = 13
PRV$V_SETPRV = 14                       ; any privilege, not just the authorized ones
PRV$V_TMPMBX = 15                       ; temporary mailboxes
PRV$V_WORLD = 16                        ; any other process
PRV$V_MOUNT = 17
PRV$V_OPER = 18                         ; the operator's: the network's interface
PRV$V_EXQUOTA = 19
PRV$V_NETMBX = 20
PRV$V_VOLPRO = 21                       ; INITIALIZE a volume
PRV$V_PHY_IO = 22                       ; a disk's blocks, physical or logical
PRV$V_BUGCHK = 23
PRV$V_PRMGBL = 24
PRV$V_SYSGBL = 25
PRV$V_PFNMAP = 26
PRV$V_SHMEM = 27
PRV$V_SYSPRV = 28
PRV$V_BYPASS = 29
PRV$V_SYSLCK = 30
PRV$V_SHARE = 31
PRV$V_UPGRADE = 32
PRV$V_DOWNGRADE = 33
PRV$V_GRPPRV = 34
PRV$V_READALL = 35
PRV$V_IMPORT = 36
PRV$V_AUDIT = 37
PRV$V_SECURITY = 38
PRV$K_NUMBER = 39                       ; how many there are
PRV$M_CMKRNL = 1
PRV$M_CMEXEC = 2
PRV$M_SYSNAM = 4
PRV$M_DETACH = ^X20
PRV$M_LOG_IO = ^X80
PRV$M_GROUP = ^X100
PRV$M_PRMMBX = ^X800
PRV$M_SETPRV = ^X4000
PRV$M_TMPMBX = ^X8000
PRV$M_WORLD = ^X10000
PRV$M_OPER = ^X40000
PRV$M_VOLPRO = ^X200000
PRV$M_PHY_IO = ^X400000
PRV$M_SYSPRV = ^X10000000
PRV$M_BYPASS = ^X20000000
        .ENDM   $PRVDEF

; $PRTDEF: page protection codes, the VAX's: who may read (R) and write (W),
; from kernel (K) out to user (U) mode.
        .MACRO  $PRTDEF
PRT$C_NA = 0
PRT$C_KW = 2
PRT$C_KR = 3
PRT$C_UW = 4
PRT$C_EW = 5
PRT$C_ERKW = 6
PRT$C_ER = 7
PRT$C_SW = 8
PRT$C_SREW = 9
PRT$C_SRKW = 10
PRT$C_SR = 11
PRT$C_URSW = 12
PRT$C_UREW = 13
PRT$C_URKW = 14
PRT$C_UR = 15
        .ENDM   $PRTDEF

; The _S forms of the system services: each pushes its arguments, last
; first, and calls SYS$name. A value argument is pushed as written
; (EFN=#65); an address argument is pushed as an address (PIDADR=PID), or
; as 0 if it is 0, the default.

        .MACRO  $PUSHADR ADDR
        .IF     IDN <ADDR>, <0>
        PUSHL   #0
        .IFF
        PUSHAB  ADDR
        .ENDC
        .ENDM   $PUSHADR

        .MACRO  $CREPRC_S PIDADR=0, IMAGE=0, INPUT=0, OUTPUT=0, ERROR=0, PRVADR=0, QUOTA=0, PRCNAM=0, BASPRI=#2, UIC=#0, MBXUNT=#0, STSFLG=#0
        PUSHL   STSFLG
        PUSHL   MBXUNT
        PUSHL   UIC
        PUSHL   BASPRI
        $PUSHADR PRCNAM
        $PUSHADR QUOTA
        $PUSHADR PRVADR
        $PUSHADR ERROR
        $PUSHADR OUTPUT
        $PUSHADR INPUT
        $PUSHADR IMAGE
        $PUSHADR PIDADR
        .EXTERNAL SYS$CREPRC
        CALLS   #12, G^SYS$CREPRC
        .ENDM   $CREPRC_S

        .MACRO  $DELPRC_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$DELPRC
        CALLS   #2, G^SYS$DELPRC
        .ENDM   $DELPRC_S

        .MACRO  $EXIT_S CODE=#1
        PUSHL   CODE
        .EXTERNAL SYS$EXIT
        CALLS   #1, G^SYS$EXIT
        .ENDM   $EXIT_S

        .MACRO  $DCLEXH_S DESBLK
        $PUSHADR DESBLK
        .EXTERNAL SYS$DCLEXH
        CALLS   #1, G^SYS$DCLEXH
        .ENDM   $DCLEXH_S

        .MACRO  $CANEXH_S DESBLK=0
        $PUSHADR DESBLK
        .EXTERNAL SYS$CANEXH
        CALLS   #1, G^SYS$CANEXH
        .ENDM   $CANEXH_S

        .MACRO  $FORCEX_S PIDADR=0, PRCNAM=0, CODE=#0
        PUSHL   CODE
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$FORCEX
        CALLS   #3, G^SYS$FORCEX
        .ENDM   $FORCEX_S

        .MACRO  $HIBER_S
        .EXTERNAL SYS$HIBER
        CALLS   #0, G^SYS$HIBER
        .ENDM   $HIBER_S

        .MACRO  $WAKE_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$WAKE
        CALLS   #2, G^SYS$WAKE
        .ENDM   $WAKE_S

        .MACRO  $SUSPND_S PIDADR=0, PRCNAM=0, FLAGS=#0
        PUSHL   FLAGS
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SUSPND
        CALLS   #3, G^SYS$SUSPND
        .ENDM   $SUSPND_S

        .MACRO  $RESUME_S PIDADR=0, PRCNAM=0
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$RESUME
        CALLS   #2, G^SYS$RESUME
        .ENDM   $RESUME_S

        .MACRO  $SETPRI_S PIDADR=0, PRCNAM=0, PRI, PRVPRI=0
        $PUSHADR PRVPRI
        PUSHL   PRI
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        .EXTERNAL SYS$SETPRI
        CALLS   #4, G^SYS$SETPRI
        .ENDM   $SETPRI_S

        .MACRO  $SETPRN_S PRCNAM=0
        $PUSHADR PRCNAM
        .EXTERNAL SYS$SETPRN
        CALLS   #1, G^SYS$SETPRN
        .ENDM   $SETPRN_S

        .MACRO  $GETJPI_S EFN=#0, PIDADR=0, PRCNAM=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        PUSHL   EFN
        .EXTERNAL SYS$GETJPI
        CALLS   #7, G^SYS$GETJPI
        .ENDM   $GETJPI_S

        .MACRO  $GETJPIW_S EFN=#0, PIDADR=0, PRCNAM=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        PUSHL   EFN
        .EXTERNAL SYS$GETJPIW
        CALLS   #7, G^SYS$GETJPIW
        .ENDM   $GETJPIW_S

        .MACRO  $GETSYI_S EFN=#0, CSIDADR=0, NODENAME=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR NODENAME
        $PUSHADR CSIDADR
        PUSHL   EFN
        .EXTERNAL SYS$GETSYI
        CALLS   #7, G^SYS$GETSYI
        .ENDM   $GETSYI_S

        .MACRO  $GETSYIW_S EFN=#0, CSIDADR=0, NODENAME=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR NODENAME
        $PUSHADR CSIDADR
        PUSHL   EFN
        .EXTERNAL SYS$GETSYIW
        CALLS   #7, G^SYS$GETSYIW
        .ENDM   $GETSYIW_S

        .MACRO  $PUTMSG_S MSGVEC
        $PUSHADR MSGVEC
        .EXTERNAL SYS$PUTMSG
        CALLS   #1, G^SYS$PUTMSG
        .ENDM   $PUTMSG_S

        .MACRO  $UNWIND_S DEPADR=0, NEWPC=0
        $PUSHADR NEWPC
        $PUSHADR DEPADR
        .EXTERNAL SYS$UNWIND
        CALLS   #2, G^SYS$UNWIND
        .ENDM   $UNWIND_S

        .MACRO  $GETMSG_S MSGID, MSGLEN=0, BUFADR, FLAGS=#0, OUTADR=0
        $PUSHADR OUTADR
        PUSHL   FLAGS
        $PUSHADR BUFADR
        $PUSHADR MSGLEN
        PUSHL   MSGID
        .EXTERNAL SYS$GETMSG
        CALLS   #5, G^SYS$GETMSG
        .ENDM   $GETMSG_S

        .MACRO  $ASCEFC_S EFN, NAME, PROT=#0, PERM=#0
        PUSHL   PERM
        PUSHL   PROT
        $PUSHADR NAME
        PUSHL   EFN
        .EXTERNAL SYS$ASCEFC
        CALLS   #4, G^SYS$ASCEFC
        .ENDM   $ASCEFC_S

        .MACRO  $DACEFC_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$DACEFC
        CALLS   #1, G^SYS$DACEFC
        .ENDM   $DACEFC_S

        .MACRO  $SETEF_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$SETEF
        CALLS   #1, G^SYS$SETEF
        .ENDM   $SETEF_S

        .MACRO  $CLREF_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$CLREF
        CALLS   #1, G^SYS$CLREF
        .ENDM   $CLREF_S

        .MACRO  $READEF_S EFN, STATE
        $PUSHADR STATE
        PUSHL   EFN
        .EXTERNAL SYS$READEF
        CALLS   #2, G^SYS$READEF
        .ENDM   $READEF_S

        .MACRO  $WAITFR_S EFN
        PUSHL   EFN
        .EXTERNAL SYS$WAITFR
        CALLS   #1, G^SYS$WAITFR
        .ENDM   $WAITFR_S

        .MACRO  $WFLOR_S EFN, MASK
        PUSHL   MASK
        PUSHL   EFN
        .EXTERNAL SYS$WFLOR
        CALLS   #2, G^SYS$WFLOR
        .ENDM   $WFLOR_S

        .MACRO  $WFLAND_S EFN, MASK
        PUSHL   MASK
        PUSHL   EFN
        .EXTERNAL SYS$WFLAND
        CALLS   #2, G^SYS$WFLAND
        .ENDM   $WFLAND_S

        .MACRO  $CRETVA_S INADR, RETADR=0, ACMODE=#0
        PUSHL   ACMODE
        $PUSHADR RETADR
        $PUSHADR INADR
        .EXTERNAL SYS$CRETVA
        CALLS   #3, G^SYS$CRETVA
        .ENDM   $CRETVA_S

        .MACRO  $DELTVA_S INADR, RETADR=0, ACMODE=#0
        PUSHL   ACMODE
        $PUSHADR RETADR
        $PUSHADR INADR
        .EXTERNAL SYS$DELTVA
        CALLS   #3, G^SYS$DELTVA
        .ENDM   $DELTVA_S

        .MACRO  $EXPREG_S PAGCNT, RETADR=0, ACMODE=#0, REGION=#0
        PUSHL   REGION
        PUSHL   ACMODE
        $PUSHADR RETADR
        PUSHL   PAGCNT
        .EXTERNAL SYS$EXPREG
        CALLS   #4, G^SYS$EXPREG
        .ENDM   $EXPREG_S

        .MACRO  $SETPRV_S ENBFLG=#0, PRVADR=0, PRMFLG=#0, PRVPRV=0
        $PUSHADR PRVPRV
        PUSHL   PRMFLG
        $PUSHADR PRVADR
        PUSHL   ENBFLG
        .EXTERNAL SYS$SETPRV
        CALLS   #4, G^SYS$SETPRV
        .ENDM   $SETPRV_S

        .MACRO  $CMKRNL_S ROUTIN, ARGLST=0
        $PUSHADR ARGLST
        $PUSHADR ROUTIN
        .EXTERNAL SYS$CMKRNL
        CALLS   #2, G^SYS$CMKRNL
        .ENDM   $CMKRNL_S

        .MACRO  $CMEXEC_S ROUTIN, ARGLST=0
        $PUSHADR ARGLST
        $PUSHADR ROUTIN
        .EXTERNAL SYS$CMEXEC
        CALLS   #2, G^SYS$CMEXEC
        .ENDM   $CMEXEC_S

        .MACRO  $ASSIGN_S DEVNAM, CHAN, ACMODE=#0, MBXNAM=0
        $PUSHADR MBXNAM
        PUSHL   ACMODE
        $PUSHADR CHAN
        $PUSHADR DEVNAM
        .EXTERNAL SYS$ASSIGN
        CALLS   #4, G^SYS$ASSIGN
        .ENDM   $ASSIGN_S

        .MACRO  $CREMBX_S PRMFLG=#0, CHAN, MAXMSG=#0, BUFQUO=#0, PROMSK=#0, ACMODE=#0, LOGNAM=0, FLAGS=#0
        PUSHL   FLAGS
        $PUSHADR LOGNAM
        PUSHL   ACMODE
        PUSHL   PROMSK
        PUSHL   BUFQUO
        PUSHL   MAXMSG
        $PUSHADR CHAN
        PUSHL   PRMFLG
        .EXTERNAL SYS$CREMBX
        CALLS   #8, G^SYS$CREMBX
        .ENDM   $CREMBX_S

        .MACRO  $DELMBX_S CHAN
        PUSHL   CHAN
        .EXTERNAL SYS$DELMBX
        CALLS   #1, G^SYS$DELMBX
        .ENDM   $DELMBX_S

        .MACRO  $DASSGN_S CHAN
        PUSHL   CHAN
        .EXTERNAL SYS$DASSGN
        CALLS   #1, G^SYS$DASSGN
        .ENDM   $DASSGN_S

        .MACRO  $CANCEL_S CHAN
        PUSHL   CHAN
        .EXTERNAL SYS$CANCEL
        CALLS   #1, G^SYS$CANCEL
        .ENDM   $CANCEL_S

        .MACRO  $QIOW_S EFN=#0, CHAN, FUNC, IOSB=0, ASTADR=0, ASTPRM=#0, P1=0, P2=#0, P3=#0, P4=#0, P5=#0, P6=#0
        PUSHL   P6
        PUSHL   P5
        PUSHL   P4
        PUSHL   P3
        PUSHL   P2
        $PUSHADR P1
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        PUSHL   FUNC
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$QIOW
        CALLS   #12, G^SYS$QIOW
        .ENDM   $QIOW_S

        .MACRO  $QIO_S EFN=#0, CHAN, FUNC, IOSB=0, ASTADR=0, ASTPRM=#0, P1=0, P2=#0, P3=#0, P4=#0, P5=#0, P6=#0
        PUSHL   P6
        PUSHL   P5
        PUSHL   P4
        PUSHL   P3
        PUSHL   P2
        $PUSHADR P1
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        PUSHL   FUNC
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$QIO
        CALLS   #12, G^SYS$QIO
        .ENDM   $QIO_S

        .MACRO  $DCLAST_S ASTADR, ASTPRM=#0, ACMODE=#0
        PUSHL   ACMODE
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        .EXTERNAL SYS$DCLAST
        CALLS   #3, G^SYS$DCLAST
        .ENDM   $DCLAST_S

        .MACRO  $SETAST_S ENBFLG
        PUSHL   ENBFLG
        .EXTERNAL SYS$SETAST
        CALLS   #1, G^SYS$SETAST
        .ENDM   $SETAST_S

        .MACRO  $GETTIM_S TIMADR
        $PUSHADR TIMADR
        .EXTERNAL SYS$GETTIM
        CALLS   #1, G^SYS$GETTIM
