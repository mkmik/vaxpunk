        .ENDM   $GETJPI_S

        .MACRO  $GETJPIW_S EFN=#0, PIDADR=0, PRCNAM=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR PRCNAM
        $PUSHADR PIDADR
        PUSHL   EFN
