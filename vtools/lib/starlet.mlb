        .MACRO  $QIOW_S EFN=#0, CHAN, FUNC, IOSB=0, ASTADR=0, ASTPRM=#0, P1=0, P2=#0, P3=#0, P4=#0, P5=#0, P6=#0
        PUSHL   P6
        PUSHL   P5
        PUSHL   P4
        PUSHL   P3
        PUSHL   P2
        $PUSHADR P1
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        PUSHL   FUNC
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$QIOW
        CALLS   #12, G^SYS$QIOW
        .ENDM   $QIOW_S

        .MACRO  $QIO_S EFN=#0, CHAN, FUNC, IOSB=0, ASTADR=0, ASTPRM=#0, P1=0, P2=#0, P3=#0, P4=#0, P5=#0, P6=#0
        PUSHL   P6
        PUSHL   P5
        PUSHL   P4
        PUSHL   P3
        PUSHL   P2
        $PUSHADR P1
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        PUSHL   FUNC
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$QIO
