        .EXTERNAL SYS$IMGACT
        CALLS   #2, G^SYS$IMGACT
        .ENDM   $IMGACT_S

        .MACRO  $INIT_VOL_S DEVNAM, VOLNAM, ITMLST=0
        $PUSHADR ITMLST
        $PUSHADR VOLNAM
        $PUSHADR DEVNAM
        .EXTERNAL SYS$INIT_VOL
        CALLS   #3, G^SYS$INIT_VOL
        .ENDM   $INIT_VOL_S

        .MACRO  $GETDVI_S EFN=#0, CHAN=#0, DEVNAM=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0, NULLARG=0
        $PUSHADR NULLARG
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR DEVNAM
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$GETDVI
        CALLS   #8, G^SYS$GETDVI
        .ENDM   $GETDVI_S

        .MACRO  $GETDVIW_S EFN=#0, CHAN=#0, DEVNAM=0, ITMLST, IOSB=0, ASTADR=0, ASTPRM=#0, NULLARG=0
        $PUSHADR NULLARG
        PUSHL   ASTPRM
        $PUSHADR ASTADR
        $PUSHADR IOSB
        $PUSHADR ITMLST
        $PUSHADR DEVNAM
        PUSHL   CHAN
        PUSHL   EFN
        .EXTERNAL SYS$GETDVIW
        CALLS   #8, G^SYS$GETDVIW
        .ENDM   $GETDVIW_S

        .MACRO  $DEVICE_SCAN_S RETURN_DEVNAM, RETLEN=0, SEARCH_DEVNAM=0, ITMLST=0, CONTXT=0
        $PUSHADR CONTXT
        $PUSHADR ITMLST
        $PUSHADR SEARCH_DEVNAM
        $PUSHADR RETLEN
        $PUSHADR RETURN_DEVNAM
        .EXTERNAL SYS$DEVICE_SCAN
        CALLS   #5, G^SYS$DEVICE_SCAN
        .ENDM   $DEVICE_SCAN_S

        .MACRO  $MOUNT_S ITMLST
        $PUSHADR ITMLST
        .EXTERNAL SYS$MOUNT
        CALLS   #1, G^SYS$MOUNT
        .ENDM   $MOUNT_S

        .MACRO  $DISMOU_S DEVNAM, FLAGS=#0
        PUSHL   FLAGS
        $PUSHADR DEVNAM
        .EXTERNAL SYS$DISMOU
        CALLS   #2, G^SYS$DISMOU
        .ENDM   $DISMOU_S

        .MACRO  $CREATE_DIR_S DEVDIRSPEC
        $PUSHADR DEVDIRSPEC
        .EXTERNAL SYS$CREATE_DIR
        CALLS   #1, G^SYS$CREATE_DIR
        .ENDM   $CREATE_DIR_S

