; $ASCTIM_S [TIMLEN], TIMBUF, [TIMADR], [CVTFLG]: a time as text.
        .MACRO  $ASCTIM_S TIMLEN=0, TIMBUF, TIMADR=0, CVTFLG=#0
        PUSHL   CVTFLG
        $PUSHADR TIMADR
        $PUSHADR TIMBUF
        $PUSHADR TIMLEN
        .EXTERNAL SYS$ASCTIM
        CALLS   #4, G^SYS$ASCTIM
        .ENDM   $ASCTIM_S

        .MACRO  $GETTIM_S TIMADR
        $PUSHADR TIMADR
        .EXTERNAL SYS$GETTIM
        CALLS   #1, G^SYS$GETTIM
        .ENDM   $GETTIM_S

; $NUMTIM_S TIMBUF, TIMADR: the time at TIMADR, or the system time, as 7
; words at TIMBUF: year, month, day, hour, minute, second, hundredths.
        .MACRO  $NUMTIM_S TIMBUF, TIMADR=0
        $PUSHADR TIMADR
