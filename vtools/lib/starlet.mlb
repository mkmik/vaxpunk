        $PUSHADR ACMODE
        $PUSHADR LOGNAM
        $PUSHADR TABNAM
        $PUSHADR ATTR
        .EXTERNAL SYS$TRNLNM
        CALLS   #5, G^SYS$TRNLNM
        .ENDM   $TRNLNM_S

        .MACRO  $SETDDIR_S NEWDIR=0, OLDLEN=0, OLDDIR=0
        $PUSHADR OLDDIR
        $PUSHADR OLDLEN
        $PUSHADR NEWDIR
        .EXTERNAL SYS$SETDDIR
        CALLS   #3, G^SYS$SETDDIR
        .ENDM   $SETDDIR_S

        .MACRO  $IMGACT_S IMAGE, CMDLIN=0
        $PUSHADR CMDLIN
