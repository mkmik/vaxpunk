        .MACRO  $CRELNM_S ATTR=0, TABNAM, LOGNAM, ACMODE=0, ITMLST
        $PUSHADR ITMLST
        $PUSHADR ACMODE
        $PUSHADR LOGNAM
        $PUSHADR TABNAM
