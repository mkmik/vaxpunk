MODULE ASCTIM (IDENT = 'V1.0') =
%TITLE 'Time as text under vrun: $ASCTIM'
BEGIN
!
! $ASCTIM for programs that run under vrun, from $NUMTIM's numbers
! (numtim.b64, the executive's). The system's own $ASCTIM is MACRO-32
! (roottask/exec/timeschdl.mar); tests/bliss/asctime.b64 runs this one
! against VMS's.
!
LIBRARY 'SYS$LIBRARY:STARLET';

EXTERNAL ROUTINE
    SYS$GETTIM,
    SYS$NUMTIM;

LITERAL
    ! The 7 words of $NUMTIM's buffer.
    YEAR = 0,
    MONTH = 1,
    DAY = 2,
    HOUR = 3,
    MINUTE = 4,
    SECOND = 5,
    HUNDREDTH = 6;

! PUT n, digits, p: n's last digits, `digits` of them, at p, zeros first,
! or blanks if `blank`. Returns the pointer past them.
ROUTINE PUT (N, DIGITS, PTR, BLANK) =
    BEGIN
    LOCAL
        V;
    V = .N;
    DECR I FROM .DIGITS - 1 TO 0 DO
        BEGIN
        CH$WCHAR(%C'0' + .V MOD 10, CH$PLUS(.PTR, .I));
        V = .V / 10;
        IF .V EQL 0 AND .BLANK AND .I GTR 0
        THEN
            BEGIN
            DECR J FROM .I - 1 TO 0 DO
                CH$WCHAR(%C' ', CH$PLUS(.PTR, .J));
            EXITLOOP
            END
        END;
    CH$PLUS(.PTR, .DIGITS)
    END;

! SYS$ASCTIM [timlen], timbuf [,timadr] [,cvtflg]: the time at timadr, or
! the system time, as text into the buffer timbuf's descriptor gives:
! `dd-MMM-yyyy hh:mm:ss.cc`, or with cvtflg 1 just the time; a delta time
! as `dddd hh:mm:ss.cc`. The day is blank padded; the length goes to the
! word at timlen. R0 = SS$_NORMAL, or SS$_BUFFEROVF if the buffer was too
! short for all of it.
GLOBAL ROUTINE SYS$ASCTIM (TIMLEN, TIMBUF : REF BLOCK[, BYTE], TIMADR, CVTFLG) =
    BEGIN
    BIND
        MONTHS = UPLIT('JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC');
    LOCAL
        T,
        N : VECTOR[7, WORD],
        TEXT : VECTOR[CH$ALLOCATION(23)],
        P,
        LEN;
    IF .TIMADR NEQ 0 THEN T = ..TIMADR ELSE SYS$GETTIM(T);
    SYS$NUMTIM(N, T);
    P = CH$PTR(TEXT);
    IF .CVTFLG NEQ 1
    THEN
        IF .T LSS 0
        THEN
            BEGIN
            P = PUT(.N[DAY], 4, .P, 1);
            CH$WCHAR_A(%C' ', P)
            END
        ELSE
            BEGIN
            P = PUT(.N[DAY], 2, .P, 1);
            CH$WCHAR_A(%C'-', P);
            P = CH$MOVE(3, CH$PTR(MONTHS, 3 * (.N[MONTH] - 1)), .P);
            CH$WCHAR_A(%C'-', P);
            P = PUT(.N[YEAR], 4, .P, 0);
            CH$WCHAR_A(%C' ', P)
            END;
    P = PUT(.N[HOUR], 2, .P, 0);
    CH$WCHAR_A(%C':', P);
    P = PUT(.N[MINUTE], 2, .P, 0);
    CH$WCHAR_A(%C':', P);
    P = PUT(.N[SECOND], 2, .P, 0);
    CH$WCHAR_A(%C'.', P);
    P = PUT(.N[HUNDREDTH], 2, .P, 0);
    LEN = MIN(CH$DIFF(.P, CH$PTR(TEXT)), .TIMBUF[DSC$W_LENGTH]);
    CH$MOVE(.LEN, CH$PTR(TEXT), .TIMBUF[DSC$A_POINTER]);
    IF .TIMLEN NEQ 0 THEN (.TIMLEN)<0, 16> = .LEN;
    IF .LEN LSS CH$DIFF(.P, CH$PTR(TEXT)) THEN SS$_BUFFEROVF ELSE SS$_NORMAL
    END;

END
ELUDOM
