# Builds and runs the BLISS examples with the vtools commands. `just
# --dry-run NAME` shows the commands without running them. Output goes to
# target/examples/bliss.

bin := "../../../target/debug"
out := "../../../target/examples/bliss"
lib := "../../lib"

_default:
    @just --list

# Runs every example.
all: date

_build:
    cargo build -q -p vbliss -p vmacro -p vlib -p vlink -p vrun
    mkdir -p {{out}}

# SYSLIB.OLB: an object library of the vtools/lib modules the examples call,
# as the system's libraries are on VMS.
_syslib: _build
    {{bin}}/vbliss -I {{lib}} -o {{out}}/asctim.obj     {{lib}}/asctim.b64
    {{bin}}/vbliss -I {{lib}} -o {{out}}/numtim.obj     {{lib}}/numtim.b64
    {{bin}}/vmacro            -o {{out}}/gettim.obj     {{lib}}/gettim.mar
    {{bin}}/vmacro            -o {{out}}/putoutput.obj  {{lib}}/putoutput.mar
    {{bin}}/vmacro            -o {{out}}/conputchar.obj {{lib}}/conputchar.mar
    {{bin}}/vlib --create {{out}}/syslib.olb {{out}}/asctim.obj {{out}}/numtim.obj {{out}}/gettim.obj {{out}}/putoutput.obj {{out}}/conputchar.obj

# Calls $ASCTIM and LIB$PUT_OUTPUT. The linker takes them from SYSLIB.OLB,
# and the modules they call in turn.
date: _syslib
    {{bin}}/vbliss -o {{out}}/date.obj date.b64
    {{bin}}/vlink  -o {{out}}/date.exe {{out}}/date.obj {{out}}/syslib.olb
    {{bin}}/vrun   {{out}}/date.exe
