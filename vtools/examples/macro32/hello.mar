        .TITLE  HELLO   MACRO-32 says hello on the console
        .IDENT  /V1.0/
        .EXTERNAL EXE$OUTZSTRING

        .PSECT  DATA, NOEXE, LONG
MESSAGE:
        .ASCIZ  "Hello from MACRO-32!"<10>

        .PSECT  CODE, EXE, SHR, LONG
        .ENTRY  HELLO, ^M<>
        MOVAB   MESSAGE, R1
        JSB     G^EXE$OUTZSTRING        ; from vtools/lib/consolio.mar
        MOVL    #1, R0                  ; SS$_NORMAL
        RET

        .END    HELLO
