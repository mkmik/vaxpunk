        .TITLE  MAIN    CALLS, CALLG, JSB and the stack, across modules
        .LIBRARY "vrun.mlb"
        .EXTERNAL FACT, PUTNUM, SUM

        .PSECT  DATA, NOEXE, WRT, LONG
ARGS:   .LONG   3, 20, 300, 4000        ; an argument list for CALLG
TEXT:   .ASCII  "copied by MOVC3"
TEXT_LEN = . - TEXT
BUFFER: .BLKB   32

        .PSECT  CODE, EXE, LONG
        .ENTRY  MAIN, ^M<R2, R3, R4, R5, R6>
        MOVL    #77, R2                 ; FACT saves R2
        PUSHL   #10
        CALLS   #1, FACT
        CMPL    R2, #77
        BNEQ    90$
        PUSHL   R0
        CALLS   #1, PUTNUM              ; 3628800

        CALLG   ARGS, SUM
        PUSHL   R0
        CALLS   #1, PUTNUM              ; 4320

        MOVL    #21, R1
        JSB     DOUBLE
        BSBW    DOUBLE
        PUSHL   R1
        CALLS   #1, PUTNUM              ; 84

        MOVL    #3, R4
        MOVL    #4, R5
        PUSHR   #^M<R4, R5>
        CLRQ    R4
        POPR    #^M<R4, R5>
        MULL3   R4, R5, -(SP)
        CALLS   #1, PUTNUM              ; 12

        MOVC5   #0, (SP), #^A/-/, #10, BUFFER
        MOVC3   #TEXT_LEN, TEXT, BUFFER+10
        MOVB    #10, (R3)               ; R3: the end of the copy
        SUBL3   #BUFFER, R3, R1
        INCL    R1
        MOVAB   BUFFER, R0
        svc     #2                      ; ARM64: vrun's put
        MOVL    #1, R0
        RET
90$:    MOVL    #4, R0
        RET

; DOUBLE: R1 = R1 * 2, for JSB.
DOUBLE: .JSB_ENTRY INPUT=<R1>, OUTPUT=<R1>
        ADDL2   R1, R1
        RSB

        .END    MAIN
