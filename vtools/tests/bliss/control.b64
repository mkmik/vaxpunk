MODULE CONTROL (MAIN = MAIN) =
BEGIN
! IF, CASE, SELECT, the loops, LEAVE, EXITLOOP, RETURN and block values.
REQUIRE 'PRINT';

ROUTINE KIND (X) =
    CASE .X FROM 1 TO 6 OF
        SET
        [1]: 10;
        [2, 4]: 20;
        [5 TO 6]: 30;
        [INRANGE]: 40;
        [OUTRANGE]: 50;
        TES;

ROUTINE SEL (X) =
    BEGIN
    LOCAL R;
    R = 0;
    SELECT .X OF
        SET
        [1]: R = .R + 1;
        [1 TO 3]: R = .R + 10;
        [OTHERWISE]: R = .R + 100;
        [ALWAYS]: R = .R + 1000;
        TES;
    .R
    END;

ROUTINE ONE (X) =
    SELECTONE .X OF
        SET
        [1]: 1;
        [1 TO 3]: 2;
        [OTHERWISE]: 3;
        TES;

ROUTINE FIRST (LIMIT) =
    BEGIN
    INCR I FROM 1 TO 100 DO
        IF .I * .I GTR .LIMIT THEN RETURN .I;
    0
    END;

ROUTINE MAIN =
    BEGIN
    LOCAL
        N,
        T;
    PRINT(IF 1 THEN 2 ELSE 3);
    PRINT(IF 2 THEN 2 ELSE 3);
    PRINT(IF .N EQL .N THEN 4);
    INCR I FROM 0 TO 7 DO PRINT(KIND(.I));
    INCR I FROM 0 TO 4 DO PRINT(SEL(.I));
    INCR I FROM 0 TO 4 DO PRINT(ONE(.I));
    PRINT(FIRST(50));
    T = 0;
    INCR I FROM 1 TO 10 BY 3 DO T = .T * 10 + .I;
    PRINT(.T);
    T = 0;
    DECR I FROM 10 TO 1 BY 4 DO T = .T * 100 + .I;
    PRINT(.T);
    T = 0;
    INCRU I FROM 1 TO 3 DO T = .T + .I;
    PRINT(.T);
    PRINT(INCR I FROM 1 TO 3 DO 0);
    PRINT(INCR I FROM 1 TO 3 DO IF .I EQL 2 THEN EXITLOOP .I * 7);
    N = 0;
    WHILE .N LSS 5 DO N = .N + 2;
    PRINT(.N);
    UNTIL .N EQL 0 DO N = .N - 1;
    PRINT(.N);
    DO N = .N + 1 WHILE .N LSS 3;
    PRINT(.N);
    DO N = .N + 1 UNTIL 1;
    PRINT(.N);
    PRINT(WHILE 0 DO 0);
    PRINT(BEGIN 1; 2; 3 END);
    PRINT((N = 6; .N * 2));
    PRINT(
        BEGIN
        LABEL OUTER;
        OUTER:
            BEGIN
            INCR I FROM 1 TO 5 DO
                INCR J FROM 1 TO 5 DO
                    IF .I * .J EQL 12 THEN LEAVE OUTER WITH .I * 100 + .J;
            -1
            END
        END);
    1
    END;

END
ELUDOM
