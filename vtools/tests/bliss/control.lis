    2	    103     INCR I FROM 0 TO 4 DO PRINT(SEL(.I));
    2	    104     INCR I FROM 0 TO 4 DO PRINT(ONE(.I));
    2	    105     PRINT(FIRST(50));
    2	    106     T = 0;
    2	    107     INCR I FROM 1 TO 10 BY 3 DO T = .T * 10 + .I;
    2	    108     PRINT(.T);
    2	    109     T = 0;
    2	    110     DECR I FROM 10 TO 1 BY 4 DO T = .T * 100 + .I;
    2	    111     PRINT(.T);

