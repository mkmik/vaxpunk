    1	     58         [1]: 10;
    1	     59         [2, 4]: 20;
    1	     60         [5 TO 6]: 30;
    1	     61         [INRANGE]: 40;
    1	     62         [OUTRANGE]: 50;
    1	     63         TES;
    1	     64 
    1	     65 ROUTINE SEL (X) =
    1	     66     BEGIN
    2	     67     LOCAL R;
    2	     68     R = 0;
    2	     69     SELECT .X OF
    2	     70         SET
    2	     71         [1]: R = .R + 1;
    2	     72         [1 TO 3]: R = .R + 10;
    2	     73         [OTHERWISE]: R = .R + 100;
    2	     74         [ALWAYS]: R = .R + 1000;
    2	     75         TES;
    2	     76     .R
    2	     77     END;
    1	     78 
    1	     79 ROUTINE ONE (X) =
    1	     80     SELECTONE .X OF
    1	     81         SET
    1	     82         [1]: 1;
    1	     83         [1 TO 3]: 2;
    1	     84         [OTHERWISE]: 3;
    1	     85         TES;
    1	     86 
    1	     87 ROUTINE FIRST (LIMIT) =
    1	     88     BEGIN
    2	     89     INCR I FROM 1 TO 100 DO
    2	     90         IF .I * .I GTR .LIMIT THEN RETURN .I;
    2	     91     0
    2	     92     END;
    1	     93 
    1	     94 ROUTINE MAIN =
    1	     95     BEGIN
    2	     96     LOCAL
    2	     97         N,
    2	     98         T;
    2	     99     PRINT(IF 1 THEN 2 ELSE 3);
    2	    100     PRINT(IF 2 THEN 2 ELSE 3);
    2	    101     PRINT(IF .N EQL .N THEN 4);
