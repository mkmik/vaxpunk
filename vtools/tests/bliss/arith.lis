    1	     58     BIG : INITIAL(%X'7FFFFFFFFFFFFFFF');
    1	     59 
    1	     60 ROUTINE MAIN =
    1	     61     BEGIN
    2	     62     PRINT(.A + .B);
    2	     63     PRINT(.A - .B);
    2	     64     PRINT(.A * .B);
    2	     65     PRINT(.A / .B);
    2	     66     PRINT(.A MOD .B);
    2	     67     PRINT(.B MOD .A);
    2	     68     PRINT(-.A / 2);
    2	     69     PRINT(.A AND 5);
    2	     70     PRINT(.A OR 8);
    2	     71     PRINT(.A XOR .B);
    2	     72     PRINT(.A EQV .B);
    2	     73     PRINT(NOT .A);
    2	     74     PRINT(-.B);
    2	     75     PRINT(.A ^ 3);
    2	     76     PRINT(.B ^ -1);
    2	     77     PRINT(.A ^ (.B + 1));
    2	     78     PRINT(.A ^ (.A + 50));
    2	     79     PRINT(1 ^ 63);
    2	     80     PRINT(.A EQL 7);
    2	     81     PRINT(.A NEQ 7);
    2	     82     PRINT(.B LSS .A);
    2	     83     PRINT(.B LSSU .A);
    2	     84     PRINT(.B GTRA .A);
    2	     85     PRINT(.B LEQ -3);
    2	     86     PRINT(.B GEQU 0);
    2	     87     PRINT(-1 LSS 0);
    2	     88     PRINT(-1 LSSU 0);
    2	     89     PRINT(-1 LSSA 0);
    2	     90     PRINT(%X'80000000' LSS 0);
    2	     91     PRINT(.A + .B * 2 ^ 2 - 1);
    2	     92     PRINT(NOT .A EQL 7 OR .B EQL -3);
    2	     93     PRINT(%C'A');
    2	     94     PRINT('AB');
    2	     95     PRINT(%O'777');
    2	     96     PRINT(%B'1010');
    2	     97     PRINT(%DECIMAL'-12');
    2	     98     ! Last: overflow traps if OVERFLOW is the default.
    2	     99     PRINT(.BIG + 1);
    2	    100     PRINT(.BIG * 2);
    2	    101     1
    2	    102     END;
    1	    103 
    1	    104 END
    1	    105 ELUDOM


