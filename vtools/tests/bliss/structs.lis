    1	    105 ROUTINE SUM (X : REF VECTOR, N) =
    1	    106     BEGIN
    2	    107     LOCAL
    2	    108         S;
    2	    109     S = 0;
    2	    110     INCR I FROM 0 TO .N - 1 DO
    2	    111         S = .S + .X[.I];
    2	    112     .S
    2	    113     END;
