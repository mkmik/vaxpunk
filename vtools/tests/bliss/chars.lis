    2	    115     PRINT(CH$GTR(4, P_BETA, 4, P_BEAR));
    2	    116     PRINT(CH$GTR(4, P_BEAR, 2, P_BE));
    2	    117     PRINT(CH$GTR(4, P_BEAR, 2, P_BE, 127));
    2	    118     PRINT(CH$COMPARE(5, P_ALPHA, 4, P_BETA));
    2	    119     PRINT(CH$COMPARE(2, P_BEAR, 2, P_BE));
    2	    120     PRINT(CH$EQL(2, P_BEAR, 2, P_BE) + CH$NEQ(2, P_BEAR, 2, P_BE) * 2);
    2	    121     PRINT(CH$LEQ(4, P_BETA, 4, P_BEAR) + CH$GEQ(4, P_BETA, 4, P_BEAR) * 2);
    2	    122     LE = CH$FIND_NOT_CH(15, CH$PTR(LINE), %C' ');
    2	    123     RE = CH$FIND_CH(15 - CH$DIFF(.LE, CH$PTR(LINE)), .LE, %C' ');
    2	    124     PRINT(CH$DIFF(.LE, CH$PTR(LINE)));
    2	    125     PRINT(CH$DIFF(.RE, .LE));
    2	    126     PRINT(CH$FAIL(CH$FIND_CH(4, CH$PTR(S), %C'Z')));
    2	    127     PRINT(CH$DIFF(CH$FIND_SUB(15, CH$PTR(LINE), 3, CH$PTR(UPLIT('ORD'))), CH$PTR(LINE)));
    2	    128     PRINT(CH$FAIL(CH$FIND_SUB(15, CH$PTR(LINE), 3, CH$PTR(UPLIT('ORE')))));
    2	    129     1
    2	    130     END;
