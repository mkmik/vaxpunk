    1	     58     ALPHA : VECTOR[CH$ALLOCATION(10)],
    1	     59     P;
    1	     60 
    1	     61 BIND
    1	     62     S = UPLIT('ABCD'),
    1	     63     Q = UPLIT('ABCDEFGH'),
    1	     64     P_ALPHA = CH$PTR(UPLIT('ALPHA')),
    1	     65     P_BETA = CH$PTR(UPLIT('BETA')),
    1	     66     P_BEAR = CH$PTR(UPLIT('BEAR')),
    1	     67     P_BE = CH$PTR(UPLIT('BE')),
    1	     68     LINE = UPLIT('   SOME WORDS  ');
    1	     69 
    1	     70 ! Prints n characters at pointer p as a number, a character a digit.
    1	     71 ROUTINE CHARS (N, PTR) : NOVALUE =
    1	     72     BEGIN
    2	     73     LOCAL
    2	     74         V;
    2	     75     V = 0;
    2	     76     INCR I FROM 0 TO .N - 1 DO
    2	     77         V = .V * 256 + CH$RCHAR(CH$PLUS(.PTR, .I));
    2	     78     PRINT(.V)
    2	     79     END;
    1	     80 
    1	     81 ROUTINE MAIN =
    1	     82     BEGIN
    2	     83     LOCAL
    2	     84         CP,
    2	     85         LE,
    2	     86         RE;
    2	     87     PRINT(CH$ALLOCATION(20));
    2	     88     PRINT(CH$SIZE());
    2	     89     CP = CH$PTR(S);
    2	     90     PRINT(CH$RCHAR(.CP));
    2	     91     PRINT(CH$A_RCHAR(CP));
    2	     92     PRINT(CH$RCHAR_A(CP));
    2	     93     PRINT(CH$RCHAR(.CP));
    2	     94     PRINT(CH$DIFF(.CP, CH$PTR(S)));
    2	     95     P = CH$PTR(X);
    2	     96     INCR I FROM 1 TO 4 DO
    2	     97         BEGIN
    3	     98         P = CH$MOVE(.I, CH$PTR(S), .P);
    3	     99         P = CH$FILL(%C'-', 5 - .I, .P);
    3	    100         END;
    2	    101     PRINT(CH$DIFF(.P, CH$PTR(X)));
    2	    102     CHARS(8, CH$PTR(X));
    2	    103     CHARS(8, CH$PTR(X, 8));
    2	    104     CHARS(4, CH$PTR(X, 16));
    2	    105     PRINT(CH$DIFF(CH$COPY(3, CH$PTR(Q, 5), 5, CH$PTR(Q), %C' ', 10, CH$PTR(ALPHA)), CH$PTR(ALPHA)));
    2	    106     CHARS(5, CH$PTR(ALPHA));
    2	    107     CHARS(5, CH$PTR(ALPHA, 5));
    2	    108     CP = CH$PTR(ALPHA);
    2	    109     CH$WCHAR(%C'P', .CP);
    2	    110     INCR I FROM 1 TO 4 DO
    2	    111         CH$A_WCHAR(%C'Q', CP);
    2	    112     CH$WCHAR_A(%C'R', CP);
    2	    113     CHARS(6, CH$PTR(ALPHA));
    2	    114     PRINT(CH$LSS(5, P_ALPHA, 4, P_BETA));

