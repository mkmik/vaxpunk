MODULE ASCTIME (MAIN = MAIN) =
BEGIN
! $ASCTIM and $NUMTIM on given times: under vrun BLISS-64, the
! executive's $NUMTIM (vms/exec/numtim.b64) and lib/asctim.b64's
! $ASCTIM on it; on OpenVMS, VMS's own, which the oracle runs this against.
REQUIRE 'PRINT';

EXTERNAL ROUTINE
    SYS$ASCTIM,
    SYS$NUMTIM;

OWN
    TIMES : VECTOR[6] INITIAL(
        0,
        %X'009E37DD13161CC0',               ! 1 January 2000, 12:34:56.78
        %X'00B94EF3DDFDF960',               ! 29 February 2024, 23:59:59.99
        %X'00BC3990F9CC6840',               ! 7 October 2026, 03:04:05.06
        %X'002E49213AEC4000',               ! 1 March 1900
        -937840500000);                     ! a delta: 1 02:03:04.05

! Prints the time at t as $ASCTIM gives it with cvtflg, in a buffer of
! size n: the text, its length and the status.
ROUTINE SHOWTIME (T, CVTFLG, N) : NOVALUE =
    BEGIN
    LOCAL
        BUF : VECTOR[CH$ALLOCATION(32)],
        DESC : VECTOR[2, LONG],
        LEN : WORD,
        STATUS;
    DESC[0] = .N + %X'010E0000';
    DESC[1] = BUF;
    STATUS = SYS$ASCTIM(LEN, DESC, .T, .CVTFLG);
    DESC[0] = .LEN + %X'010E0000';
    LIB$PUT_OUTPUT(DESC);
    PRINT(.LEN);
    PRINT(.STATUS)
    END;

ROUTINE MAIN =
    BEGIN
    LOCAL
        N : VECTOR[7, WORD];
    INCR I FROM 0 TO 5 DO
        SHOWTIME(TIMES[.I], 0, 32);
    SHOWTIME(TIMES[1], 1, 32);
    SHOWTIME(TIMES[5], 1, 32);
    SHOWTIME(TIMES[3], 0, 10);
    PRINT(SYS$NUMTIM(N, TIMES[2]));
    INCR I FROM 0 TO 6 DO
        PRINT(.N[.I]);
    SYS$NUMTIM(N, TIMES[5]);
    INCR I FROM 0 TO 6 DO
        PRINT(.N[.I]);
    1
    END;

END
ELUDOM
