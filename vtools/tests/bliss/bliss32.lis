    0	      1 MODULE BLISS32 (MAIN = MAIN) =
    0	      2 BEGIN
    1	      3 ! BLISS-32 under /A32: 32-bit values, kept sign-extended, LONG the
    1	      4 ! default unit, the predeclared structures' units, PLITs, the shifts and
    1	      5 ! the argument list.
    1	      6 REQUIRE 'PRINT32';
 R  1	      7 ! PRINT for BLISS-32 programs: prints a value as a signed decimal and as 8
 R  1	      8 ! hex digits, on a line of its own, through LIB$PUT_OUTPUT, under vrun and
 R  1	      9 ! on OpenVMS for the oracle.
 R  1	     10 
 R  1	     11 EXTERNAL ROUTINE
 R  1	     12     LIB$PUT_OUTPUT;
 R  1	     13 
 R  1	     14 ROUTINE PRINT (V) : NOVALUE =
 R  1	     15     BEGIN
 R  2	     16     LOCAL
 R  2	     17         BUF : VECTOR[32, BYTE],
 R  2	     18         DESC : VECTOR[2],
 R  2	     19         X,
 R  2	     20         I;
 R  2	     21     I = 32;
 R  2	     22     X = .V;
 R  2	     23     INCR K FROM 1 TO 8 DO
 R  2	     24         BEGIN
 R  3	     25         LOCAL D;
 R  3	     26         D = .X AND 15;
 R  3	     27         I = .I - 1;
 R  3	     28         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     29         X = .X ^ -4 AND %X'0FFFFFFF'
 R  3	     30         END;
 R  2	     31     I = .I - 1;
 R  2	     32     BUF[.I] = %C' ';
 R  2	     33     X = .V;
 R  2	     34     DO
 R  2	     35         BEGIN
 R  3	     36         LOCAL D;
 R  3	     37         D = .X - (.X / 10) * 10;
 R  3	     38         IF .D LSS 0 THEN D = -.D;
 R  3	     39         I = .I - 1;
 R  3	     40         BUF[.I] = %C'0' + .D;
 R  3	     41         X = .X / 10
 R  3	     42         END
 R  3	     43     UNTIL .X EQL 0;
 R  2	     44     IF .V LSS 0
 R  2	     45     THEN
 R  2	     46         BEGIN
 R  3	     47         I = .I - 1;
 R  3	     48         BUF[.I] = %C'-'
 R  3	     49         END;
 R  2	     50     DESC[0] = 32 - .I + %X'010E0000';
 R  2	     51     DESC[1] = BUF[.I];
 R  2	     52     LIB$PUT_OUTPUT(DESC)
 R  2	     53     END;
    1	     54 
    1	     55 BUILTIN
    1	     56     ACTUALCOUNT,
    1	     57     ARGPTR,

