    1	     88 ROUTINE MAIN =
    1	     89     BEGIN
    2	     90     LOCAL
    2	     91         X,
    2	     92         Y;
    2	     93     PRINT(%X'FFFFFFFF');
    2	     94     X = %X'7FFFFFFF';
    2	     95     PRINT(.X + 1);
    2	     96     PRINT(.X * 2);
    2	     97     PRINT(-%X'80000000');
    2	     98     Y = -7;
    2	     99     PRINT(.Y / 2);
    2	    100     PRINT(.Y MOD 3);
    2	    101     PRINT(1 ^ 31);
    2	    102     PRINT(-1 ^ -4);
    2	    103     PRINT(.X LSSU %X'80000000');
    2	    104     PRINT(-1 GTRU 1);
    2	    105     PRINT(-1 LSS 0);
    2	    106     PRINT(SLL(1, 31));
    2	    107     PRINT(SRL(-1, 28));
    2	    108     PRINT(SRA(%X'80000000', 4));
    2	    109     PRINT(ROT(%X'80000001', 4));
    2	    110     S = -1;
    2	    111     PRINT(.S);
    2	    112     B = -1;
    2	    113     PRINT(.B);
    2	    114     W = -1;
    2	    115     PRINT(.W);
    2	    116     V[2] = %X'DEADBEEF';
    2	    117     PRINT(.V[2]);
    2	    118     PRINT(.(V + 8));
    2	    119     VB[1] = 300;
