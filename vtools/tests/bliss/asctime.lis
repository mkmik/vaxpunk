    1	     58     SYS$ASCTIM,
    1	     59     SYS$NUMTIM;
    1	     60 
    1	     61 OWN
    1	     62     TIMES : VECTOR[6] INITIAL(
    1	     63         0,
    1	     64         %X'009E37DD13161CC0',               ! 1 January 2000, 12:34:56.78
    1	     65         %X'00B94EF3DDFDF960',               ! 29 February 2024, 23:59:59.99
    1	     66         %X'00BC3990F9CC6840',               ! 7 October 2026, 03:04:05.06
    1	     67         %X'002E49213AEC4000',               ! 1 March 1900
    1	     68         -937840500000);                     ! a delta: 1 02:03:04.05
    1	     69 
    1	     70 ! Prints the time at t as $ASCTIM gives it with cvtflg, in a buffer of
    1	     71 ! size n: the text, its length and the status.
    1	     72 ROUTINE SHOWTIME (T, CVTFLG, N) : NOVALUE =
    1	     73     BEGIN
    2	     74     LOCAL
    2	     75         BUF : VECTOR[CH$ALLOCATION(32)],
    2	     76         DESC : VECTOR[2, LONG],
    2	     77         LEN : WORD,
    2	     78         STATUS;
    2	     79     DESC[0] = .N + %X'010E0000';
    2	     80     DESC[1] = BUF;
    2	     81     STATUS = SYS$ASCTIM(LEN, DESC, .T, .CVTFLG);
    2	     82     DESC[0] = .LEN + %X'010E0000';
    2	     83     LIB$PUT_OUTPUT(DESC);
    2	     84     PRINT(.LEN);
    2	     85     PRINT(.STATUS)
    2	     86     END;
    1	     87 
    1	     88 ROUTINE MAIN =
    1	     89     BEGIN
    2	     90     LOCAL
    2	     91         N : VECTOR[7, WORD];
    2	     92     INCR I FROM 0 TO 5 DO
    2	     93         SHOWTIME(TIMES[.I], 0, 32);
    2	     94     SHOWTIME(TIMES[1], 1, 32);
    2	     95     SHOWTIME(TIMES[5], 1, 32);
    2	     96     SHOWTIME(TIMES[3], 0, 10);
    2	     97     PRINT(SYS$NUMTIM(N, TIMES[2]));
    2	     98     INCR I FROM 0 TO 6 DO
    2	     99         PRINT(.N[.I]);
    2	    100     SYS$NUMTIM(N, TIMES[5]);
    2	    101     INCR I FROM 0 TO 6 DO
    2	    102         PRINT(.N[.I]);
    2	    103     1
    2	    104     END;
    1	    105 
    1	    106 END
    1	    107 ELUDOM


