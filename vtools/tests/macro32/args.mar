        .TITLE  ARGS    Arguments in registers, on the stack and homed
        .LIBRARY "vrun.mlb"

; CALLS and CALLG pass the first eight arguments in x0-x7, sign-extended,
; the rest on the stack, and the count in x9 (DESIGN-0004); a routine
; that reads AP has them copied into a VAX argument list at 32(FP). Calls
; with 0, 1, 8, 9 and 255 arguments, read through n(AP), through AP as a
; list and through the registers, and a JSB routine reading its caller's
; list, or code it shares with another routine, as LIB$SIGNAL does
; LIB$STOP's. A failed check returns 2 * N, an error status, so the exit
; code says which.

        .MACRO  EXPECT  VALUE, N, ?OK
        CMPL    R0, VALUE
        BEQL    OK
        MOVL    #<N * 2>, R0
        RET
OK:
        .ENDM   EXPECT

        .PSECT  DATA, NOEXE, WRT, LONG
NINE:   .LONG   9, 1, 2, 3, 4, 5, 6, 7, 8, 9
NONE:   .LONG   0

        .PSECT  CODE, EXE, LONG
        .ENTRY  ARGS, ^M<R2, R6, R7>
        CALLS   #0, COUNT
        EXPECT  #0, 1
        CALLG   NONE, SUM
        EXPECT  #0, 2
        PUSHL   #-5
        CALLS   #1, MINUS5
        EXPECT  #1, 3
        PUSHL   #-5                     ; sign-extended through CALLG too
        PUSHL   #1
        CALLG   (SP), MINUS5
        ADDL2   #8, SP
        EXPECT  #1, 4
        MOVL    #8, R2
10$:    PUSHL   R2
        SOBGTR  R2, 10$
        CALLS   #8, SUM
        EXPECT  #36, 5
        MOVL    #9, R2
20$:    PUSHL   R2
        SOBGTR  R2, 20$
        CALLS   #9, NINTH
        EXPECT  #9, 6
        CALLG   NINE, SUM
        EXPECT  #45, 7
        CALLG   NINE, NINTH
        EXPECT  #9, 8
        MOVL    #255, R2
30$:    PUSHL   R2
        SOBGTR  R2, 30$
        CALLS   #255, SUM
        EXPECT  #32640, 9
        MOVL    #255, R2
40$:    PUSHL   R2
        SOBGTR  R2, 40$
        PUSHL   #255
        CALLG   (SP), SUM
        MOVAB   1024(SP), SP
        EXPECT  #32640, 10
        MOVL    #9, R6                  ; a count known when it runs
        MOVAB   SUM, R7
        MOVL    R6, R2
50$:    PUSHL   R2
        SOBGTR  R2, 50$
        CALLS   R6, (R7)
        EXPECT  #45, 11
        PUSHL   #7
        PUSHL   #-3
        CALLS   #2, SECOND
        EXPECT  #7, 12
        CLRQ    -(SP)
        CALLS   #2, COUNT
        EXPECT  #2, 13
        PUSHL   #5
        CALLS   #1, FIRST
        EXPECT  #5, 14
        $PUT    "args ok"<10>
        MOVL    #1, R0
        RET

; COUNT: R0 = x9's count, before anything reads it.
COUNT:  .CALL_ENTRY
        and     x0, x9, #255
        RET

; MINUS5 n: R0 = 1 if n arrived in x0 as -5, all 64 bits, and reads -5.
MINUS5: .CALL_ENTRY
        cmn     x0, #5
        b.ne    10$
        CMPL    4(AP), #-5
        BNEQ    10$
        MOVL    #1, R0
        RET
10$:    CLRL    R0
        RET

; SUM args...: R0 = their sum, through AP as a list.
SUM:    .CALL_ENTRY MAX_ARGS=255
        CLRL    R0
        MOVZBL  (AP), R1
        BEQL    20$
10$:    ADDL2   (AP)[R1], R0
        SOBGTR  R1, 10$
20$:    RET

; NINTH a, ..., i: R0 = i, from the stack.
NINTH:  .CALL_ENTRY
        MOVL    36(AP), R0
        RET

; SECOND a, b: R0 = b, which GETARG reads from this routine's list.
SECOND: .CALL_ENTRY
        BSBW    GETARG
        RET

GETARG: .JSB_ENTRY
        MOVL    8(AP), R0
        RSB

; FIRST a: R0 = a, which LAST's code reads.
FIRST:  .CALL_ENTRY
        BRB     TAIL

; LAST a: R0 = a.
LAST:   .CALL_ENTRY
TAIL:   .GLOBAL_LABEL
        MOVL    4(AP), R0
        RET

        .END    ARGS
