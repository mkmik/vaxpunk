$ ! MAKE.COM: makes the RMS fixtures on OpenVMS (crosstools/ods/vms/rms-oracle.sh runs
$ ! it): each file from the inputs and an FDL file here, its FDL and /CHECK
$ ! report from ANALYZE/RMS_FILE, and a dump of its records by every key,
$ ! by CONVERT/KEY into a sequential VAR file, KEYn.SEQ.
$ SET NOON
$ IN = "DKA100:[000000]"
$ DEFINE SYS$SCRATCH DKA100:[OUT]
$ DEFINE SYS$LOGIN DKA100:[OUT]
$ ! BIG.TXT: 3,000 records, so the index has two levels
$ OPEN/WRITE O BIG.TXT
$ YS = "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
$ I = 1
$ B1:
$ WRITE O F$FAO("B!7ZL ", I*2), F$EXTRACT(0, I - I/50*50, YS)
$ I = I + 1
$ IF I .LE. 3000 THEN GOTO B1
$ CLOSE O
$ CONVERT/FDL='IN'IDX1.FDL 'IN'DATA.TXT IDX1.IDX
$ CONVERT/FDL='IN'IDXC.FDL 'IN'DATA.TXT IDXC.IDX
$ CONVERT/FDL='IN'IDXF.FDL/PAD 'IN'FIXD.TXT IDXF.IDX
$ CONVERT/FDL='IN'IDXB.FDL BIG.TXT IDXB.IDX
$ CONVERT/FDL='IN'COMP.FDL 'IN'COMP.TXT COMP.IDX
$ ! IDXM: IDX1 after $PUTs that split buckets, $DELETEs and $UPDATEs
$ CONVERT/FDL='IN'IDX1.FDL 'IN'DATA.TXT IDXM.IDX
$ OPEN/READ/WRITE F IDXM.IDX
$ I = 1
$ M1:
$ WRITE F F$FAO("K!7ZL ZETA added record !UL", I*3+1, I)
$ I = I + 1
$ IF I .LE. 60 THEN GOTO M1
$ READ/KEY="K0000009"/DELETE F R
$ READ/KEY="K0000012"/DELETE F R
$ READ/KEY="K0000300"/DELETE F R
$ READ/KEY="K0000015" F R
$ WRITE/UPDATE F "K0000015 OMEGA updated, longer than it was before by a lot"
$ READ/KEY="K0000018" F R
$ WRITE/UPDATE F "K0000018 ALPHA"
$ READ/KEY="K0000600" F R
$ WRITE/UPDATE F "K0000600 BETA changed"
$ CLOSE F
$ ! UAF: SYSUAF.DAT's keys, with a few records
$ CREATE/FDL='IN'UAF.FDL UAF.IDX
$ OPEN/READ/WRITE F UAF.IDX
$ N = "SYSTEM,FIELD,SYSTEST,DEFAULT,ALICE,BOB"
$ G = "1,1,1,200,300,300"
$ M = "4,2,7,200,1,2"
$ I = 0
$ U1:
$ R = ""
$ R[0,32] = %X010A0001
$ R = R + F$FAO("!32AS", F$ELEMENT(I, ",", N))
$ U = ""
$ U[0,16] = F$INTEGER(F$ELEMENT(I, ",", M))
$ U[16,16] = F$INTEGER(F$ELEMENT(I, ",", G))
$ U[32,32] = 0
$ U[64,32] = I * 1000
$ U[96,32] = 7
$ WRITE F R, U, "and the rest of the record"
$ I = I + 1
$ IF I .LT. 6 THEN GOTO U1
$ CLOSE F
$ ! REL: relative, VAR records, cell 5 deleted, cell 7 updated
$ CONVERT/FDL='IN'REL.FDL 'IN'DATA.TXT REL.REL
$ OPEN/READ/WRITE F REL.REL
$ K[0,32] = 5
$ READ/KEY=&K/DELETE F R
$ K[0,32] = 7
$ READ/KEY=&K F R
$ WRITE/UPDATE F "seven updated"
$ CLOSE F
$ CONVERT/FDL='IN'RELF.FDL/PAD 'IN'FIXD.TXT RELF.REL
$ CONVERT/FDL='IN'STM.FDL 'IN'FIXD.TXT STM.SEQ
$ CONVERT/FDL='IN'STMLF.FDL 'IN'FIXD.TXT STMLF.SEQ
$ CONVERT/FDL='IN'STMCR.FDL 'IN'FIXD.TXT STMCR.SEQ
$ CONVERT/FDL='IN'VFC.FDL 'IN'FIXD.TXT VFC.SEQ
$ CONVERT/FDL='IN'FIX.FDL/PAD 'IN'FIXD.TXT FIX.SEQ
$ ! Their FDL, /CHECK and dumps
$ L = "IDX1/2,IDXC/2,IDXF/3,IDXB/1,COMP/1,IDXM/2,UAF/4"
$ I = 0
$ A1:
$ E = F$ELEMENT(I, ",", L)
$ IF E .EQS. "," THEN GOTO A2
$ X = F$ELEMENT(0, "/", E)
$ NK = F$INTEGER(F$ELEMENT(1, "/", E))
$ ANALYZE/RMS_FILE/FDL/OUTPUT='X'.FDL 'X'.IDX
$ ANALYZE/RMS_FILE/CHECK/OUTPUT='X'.CHK 'X'.IDX
$ K = 0
$ A3:
$ CONVERT/KEY='K'/FDL='IN'SEQVAR.FDL 'X'.IDX 'X'_KEY'K'.SEQ
$ K = K + 1
$ IF K .LT. NK THEN GOTO A3
$ I = I + 1
$ GOTO A1
$ A2:
$ ANALYZE/RMS_FILE/FDL/OUTPUT=REL.FDL REL.REL
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=REL.CHK REL.REL
$ CONVERT/FDL='IN'SEQVAR.FDL REL.REL REL_KEY0.SEQ
$ ANALYZE/RMS_FILE/FDL/OUTPUT=RELF.FDL RELF.REL
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=RELF.CHK RELF.REL
$ CONVERT/FDL='IN'SEQVAR.FDL RELF.REL RELF_KEY0.SEQ
$ EXIT
