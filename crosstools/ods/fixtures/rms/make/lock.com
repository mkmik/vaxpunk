$ ! LOCK.COM: record and file locking from DCL, two and three streams in
$ ! one process on an indexed file, L.IDX, made as IDX1: what each command
$ ! said, and the records it read, as LOCK.LOG has them from OpenVMS
$ ! Alpha V8.4. P1 is where IDX1.FDL and DATA.TXT are.
$ SET NOON
$ IN = P1
$ CONVERT/FDL='IN'IDX1.FDL 'IN'DATA.TXT L.IDX
$ R1 = "-"
$ R2 = "-"
$ R3 = "-"
$ RA = "-"
$ RB = "-"
$ RR = "-"
$ RW = "-"
$ WRITE SYS$OUTPUT "--- 1 open F1 rw share=write: OPEN/READ/WRITE/SHARE=WRITE F1 L.IDX"
$ OPEN/READ/WRITE/SHARE=WRITE F1 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 2 open F2 rw share=write: OPEN/READ/WRITE/SHARE=WRITE F2 L.IDX"
$ OPEN/READ/WRITE/SHARE=WRITE F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 3 F1 read K3: READ/KEY='K0000003' F1 R1"
$ READ/KEY="K0000003" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 4 F2 read K3 (F1 holds it): READ/KEY='K0000003' F2 R2"
$ READ/KEY="K0000003" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 5 F2 read/nolock K3: READ/NOLOCK/KEY='K0000003' F2 R2"
$ READ/NOLOCK/KEY="K0000003" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 5b F2 write/update after read/nolock (RNL?): WRITE/UPDATE F2 R2"
$ WRITE/UPDATE F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 6 F2 read K6: READ/KEY='K0000006' F2 R2"
$ READ/KEY="K0000006" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 7 F1 write/update K3: WRITE/UPDATE F1 'K0000003 BETA updated by F1'"
$ WRITE/UPDATE F1 "K0000003 BETA updated by F1"
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 8 F2 read K3 after F1 update: READ/KEY='K0000003' F2 R2"
$ READ/KEY="K0000003" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 9 F1 read K3 (F2 now holds it?): READ/KEY='K0000003' F1 R1"
$ READ/KEY="K0000003" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 10 F1 read K9: READ/KEY='K0000009' F1 R1"
$ READ/KEY="K0000009" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 11 F2 read/delete K9 (F1 holds it): READ/KEY='K0000009'/DELETE F2 R2"
$ READ/KEY="K0000009"/DELETE F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 12 F1 read next (K12): READ F1 R1"
$ READ F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 13 F2 read/delete K9 again: READ/KEY='K0000009'/DELETE F2 R2"
$ READ/KEY="K0000009"/DELETE F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 14 F1 read K9 (deleted by F2): READ/KEY='K0000009' F1 R1"
$ READ/KEY="K0000009" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 16 F1 write new K10: WRITE F1 'K0000010 NEW from F1'"
$ WRITE F1 "K0000010 NEW from F1"
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 17 F2 read K10: READ/KEY='K0000010' F2 R2"
$ READ/KEY="K0000010" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 18 F1 read K10 (F2 holds it): READ/KEY='K0000010' F1 R1"
$ READ/KEY="K0000010" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 18b F1 write/update after RLK (CUR?): WRITE/UPDATE F1 'K0000010 changed after RLK'"
$ WRITE/UPDATE F1 "K0000010 changed after RLK"
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 19 open F3 read share=write: OPEN/READ/SHARE=WRITE F3 L.IDX"
$ OPEN/READ/SHARE=WRITE F3 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 20 F3 read K15: READ/KEY='K0000015' F3 R3"
$ READ/KEY="K0000015" F3 R3
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R3=", R3
$ WRITE SYS$OUTPUT "--- 21 F2 read K15 (F3 is read-only): READ/KEY='K0000015' F2 R2"
$ READ/KEY="K0000015" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 21b F3 read K15 again (F2 holds it): READ/KEY='K0000015' F3 R3"
$ READ/KEY="K0000015" F3 R3
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R3=", R3
$ WRITE SYS$OUTPUT "--- 21c F3 read/nolock K15: READ/NOLOCK/KEY='K0000015' F3 R3"
$ READ/NOLOCK/KEY="K0000015" F3 R3
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R3=", R3
$ WRITE SYS$OUTPUT "--- 22 F1 read K18: READ/KEY='K0000018' F1 R1"
$ READ/KEY="K0000018" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 23 close F1: CLOSE F1"
$ CLOSE F1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 24 F2 read K18 after F1 closed: READ/KEY='K0000018' F2 R2"
$ READ/KEY="K0000018" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 25 close F2: CLOSE F2"
$ CLOSE F2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 26 close F3: CLOSE F3"
$ CLOSE F3
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 27 open A rw share: OPEN/READ/WRITE/SHARE A L.IDX"
$ OPEN/READ/WRITE/SHARE A L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 28 open B rw share: OPEN/READ/WRITE/SHARE B L.IDX"
$ OPEN/READ/WRITE/SHARE B L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 29 A read K6: READ/KEY='K0000006' A RA"
$ READ/KEY="K0000006" A RA
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RA=", RA
$ WRITE SYS$OUTPUT "--- 30 B read first: READ B RB"
$ READ B RB
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RB=", RB
$ WRITE SYS$OUTPUT "--- 31 B read next (K6, A holds it): READ B RB"
$ READ B RB
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RB=", RB
$ WRITE SYS$OUTPUT "--- 31b B write/update after RLK: WRITE/UPDATE B 'K0000003 BETA by B'"
$ WRITE/UPDATE B "K0000003 BETA by B"
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 32 close A: CLOSE A"
$ CLOSE A
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 33 B read next after A closed: READ B RB"
$ READ B RB
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RB=", RB
$ WRITE SYS$OUTPUT "--- 34 open A rw share: OPEN/READ/WRITE/SHARE A L.IDX"
$ OPEN/READ/WRITE/SHARE A L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 35 A read K12: READ/KEY='K0000012' A RA"
$ READ/KEY="K0000012" A RA
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RA=", RA
$ WRITE SYS$OUTPUT "--- 40 B read/delete/nolock K15: READ/DELETE/NOLOCK/KEY='K0000015' B RB"
$ READ/DELETE/NOLOCK/KEY="K0000015" B RB
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RB=", RB
$ WRITE SYS$OUTPUT "--- 41 close A: CLOSE A"
$ CLOSE A
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 42 close B: CLOSE B"
$ CLOSE B
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 43 open R read share: OPEN/READ/SHARE R L.IDX"
$ OPEN/READ/SHARE R L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 44 open W rw share: OPEN/READ/WRITE/SHARE W L.IDX"
$ OPEN/READ/WRITE/SHARE W L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 45 R read K18: READ/KEY='K0000018' R RR"
$ READ/KEY="K0000018" R RR
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RR=", RR
$ WRITE SYS$OUTPUT "--- 46 W read K18 (R only queried?): READ/KEY='K0000018' W RW"
$ READ/KEY="K0000018" W RW
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RW=", RW
$ WRITE SYS$OUTPUT "--- 47 R read K18 (W holds it): READ/KEY='K0000018' R RR"
$ READ/KEY="K0000018" R RR
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RR=", RR
$ WRITE SYS$OUTPUT "--- 48 R read/nolock K18: READ/NOLOCK/KEY='K0000018' R RR"
$ READ/NOLOCK/KEY="K0000018" R RR
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   RR=", RR
$ WRITE SYS$OUTPUT "--- 49 close R: CLOSE R"
$ CLOSE R
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 50 close W: CLOSE W"
$ CLOSE W
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 51 open P rw share=read: OPEN/READ/WRITE/SHARE=READ P L.IDX"
$ OPEN/READ/WRITE/SHARE=READ P L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 52 open A rw share (CW vs PW): OPEN/READ/WRITE/SHARE A L.IDX"
$ OPEN/READ/WRITE/SHARE A L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 53 open R read share (CR): OPEN/READ/SHARE R L.IDX"
$ OPEN/READ/SHARE R L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 54 open Q read (PR vs PW): OPEN/READ Q L.IDX"
$ OPEN/READ Q L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 55 open S read share=read: OPEN/READ/SHARE=READ S L.IDX"
$ OPEN/READ/SHARE=READ S L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 56 close P: CLOSE P"
$ CLOSE P
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 57 open A rw share again: OPEN/READ/WRITE/SHARE A L.IDX"
$ OPEN/READ/WRITE/SHARE A L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 58 close: CLOSE A"
$ CLOSE A
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 59 close: CLOSE R"
$ CLOSE R
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 60 close: CLOSE Q"
$ CLOSE Q
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 61 close: CLOSE S"
$ CLOSE S
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 62 open F1 rw share=write: OPEN/READ/WRITE/SHARE=WRITE F1 L.IDX"
$ OPEN/READ/WRITE/SHARE=WRITE F1 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 63 open F2 rw share=read: OPEN/READ/WRITE/SHARE=READ F2 L.IDX"
$ OPEN/READ/WRITE/SHARE=READ F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 64 open F2 read share=read: OPEN/READ/SHARE=READ F2 L.IDX"
$ OPEN/READ/SHARE=READ F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 65 open F2 read (no share): OPEN/READ F2 L.IDX"
$ OPEN/READ F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 66 open F2 read share=write: OPEN/READ/SHARE=WRITE F2 L.IDX"
$ OPEN/READ/SHARE=WRITE F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 67 close: CLOSE F1"
$ CLOSE F1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 68 close: CLOSE F2"
$ CLOSE F2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 69 open F1 rw (no share): OPEN/READ/WRITE F1 L.IDX"
$ OPEN/READ/WRITE F1 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 70 open F2 rw (no share): OPEN/READ/WRITE F2 L.IDX"
$ OPEN/READ/WRITE F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 71 open F2 read (no share): OPEN/READ F2 L.IDX"
$ OPEN/READ F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 72 open F2 read share=write: OPEN/READ/SHARE=WRITE F2 L.IDX"
$ OPEN/READ/SHARE=WRITE F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 73 close: CLOSE F1"
$ CLOSE F1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 74 close: CLOSE F2"
$ CLOSE F2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 75 open F1 read (no share): OPEN/READ F1 L.IDX"
$ OPEN/READ F1 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 76 open F2 read (no share): OPEN/READ F2 L.IDX"
$ OPEN/READ F2 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 77 open F3 rw share=write: OPEN/READ/WRITE/SHARE=WRITE F3 L.IDX"
$ OPEN/READ/WRITE/SHARE=WRITE F3 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 78 open F4 read share=write: OPEN/READ/SHARE=WRITE F4 L.IDX"
$ OPEN/READ/SHARE=WRITE F4 L.IDX
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 79 F1 read K3: READ/KEY='K0000003' F1 R1"
$ READ/KEY="K0000003" F1 R1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R1=", R1
$ WRITE SYS$OUTPUT "--- 80 F2 read K3: READ/KEY='K0000003' F2 R2"
$ READ/KEY="K0000003" F2 R2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "   R2=", R2
$ WRITE SYS$OUTPUT "--- 81 close: CLOSE F1"
$ CLOSE F1
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 82 close: CLOSE F2"
$ CLOSE F2
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 83 close: CLOSE F3"
$ CLOSE F3
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ WRITE SYS$OUTPUT "--- 84 close: CLOSE F4"
$ CLOSE F4
$ S = $STATUS
$ WRITE SYS$OUTPUT "=> ", S, " ", F$MESSAGE(F$INTEGER(S))
$ EXIT
