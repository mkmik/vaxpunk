; lib.mlb: definitions executive code uses, like VMS's LIB.MLB. Use it with
; .LIBRARY "lib.mlb" and vasm -I crosstools/vtools/lib.

; $PRDEF: the VAX processor registers every VAX has, PR$_name, the numbers
; MTPR and MFPR take. vmacro compiles those it has PAL calls for
; (docs/design/0001-pal-interface.md at the repository root).
        .MACRO  $PRDEF
PR$_KSP = 0                             ; stack pointers, per access mode
PR$_ESP = 1
PR$_SSP = 2
PR$_USP = 3
PR$_ISP = 4                             ; interrupt stack pointer
PR$_P0BR = 8                            ; page table base and length
PR$_P0LR = 9
PR$_P1BR = 10
PR$_P1LR = 11
PR$_SBR = 12
PR$_SLR = 13
PR$_PCBB = 16                           ; process control block base
PR$_SCBB = 17                           ; system control block base
PR$_IPL = 18                            ; interrupt priority level
PR$_ASTLVL = 19
PR$_SIRR = 20                           ; software interrupt request
PR$_SISR = 21                           ; software interrupt summary
PR$_ICCS = 24                           ; interval clock control
PR$_RXCS = 32                           ; console receive status and data
PR$_RXDB = 33
PR$_TXCS = 34                           ; console transmit status and data
PR$_TXDB = 35
PR$_MAPEN = 56                          ; memory management enable
PR$_TBIA = 57                           ; translation buffer invalidates
PR$_TBIS = 58
PR$_SID = 62                            ; system identification
PR$_TBCHK = 63
PR$_DOORBELL = 64                       ; vaxpunk's: rings port n's doorbell
        .ENDM   $PRDEF

; $PALDEF: function codes for CALL_PAL, the PAL calls that have no VAX
; instruction (docs/design/0001-pal-interface.md). Arguments go in R0-R5,
; the result comes back in R0.
        .MACRO  $PALDEF
PAL$_HALT = ^X00
PAL$_SWPCTX = ^X05                      ; R0 = new HWPCB; R0 = the one left
PAL$_WTINT = ^X3E                       ; wait for an interrupt
PAL$_WRPTE = ^X41                       ; R0 = address, R1 = PTE; R0 = old PTE
PAL$_DELCTX = ^X42                      ; R0 = HWPCB of a context to delete
PAL$_READLBLK = ^X46                    ; R0 = buffer, R1 = byte count, R2 = LBN, R3 = unit; R0 = status
PAL$_WRITELBLK = ^X47                   ; the same, writing the buffer there
PAL$_DOORBELL = ^X48                    ; R0 = a port: MTPR #n, #PR$_DOORBELL
PAL$_GETENTROPY = ^X49                  ; R0 = buffer, R1 = byte count, at most 256; R0 = status
PAL$_RD_PS = ^X91                       ; R0 = the PSL: the modes and IPL
        .ENDM   $PALDEF

; $IPLDEF: interrupt priority levels the executive synchronizes at.
        .MACRO  $IPLDEF
IPL$_ASTDEL = 2                         ; AST delivery
IPL$_RESCHED = 3                        ; rescheduling software interrupt
IPL$_IOPOST = 4                         ; I/O post processing
IPL$_NETPOST = 6                        ; the port's responses, a fork level
IPL$_TIMER = 7                          ; software timer: quantum end
IPL$_SYNCH = 8                          ; the scheduler's database
IPL$_CONSOLE = 20                       ; console receive interrupt
IPL$_PORT = 21                          ; the port's completion interrupt
IPL$_HWCLK = 24                         ; interval timer interrupt
IPL$_POWER = 31                         ; everything blocked
        .ENDM   $IPLDEF

; SETIPL, DSBINT, ENBINT, SOFTINT: VMS's IPL macros. DSBINT saves the IPL
; (on the stack unless DST says) and raises it; ENBINT puts it back.
        .MACRO  SETIPL  IPL=#31
        MTPR    IPL, #18                ; PR$_IPL
        .ENDM   SETIPL

        .MACRO  DSBINT  IPL=#31, DST=-(SP)
        MFPR    #18, DST
        MTPR    IPL, #18
        .ENDM   DSBINT

        .MACRO  ENBINT  SRC=(SP)+
        MTPR    SRC, #18
        .ENDM   ENBINT

        .MACRO  SOFTINT LEVEL
        MTPR    LEVEL, #20              ; PR$_SIRR
        .ENDM   SOFTINT

; IFNORD, IFNOWRT: VMS's checks of an address a caller passed: branch to
; DEST unless MODE, or the previous mode if it is an outer one, may read
; (write) the first and last of SIZ bytes at ADR.
        .MACRO  IFNORD  SIZ, ADR, DEST, MODE=#0
        PROBER  MODE, SIZ, ADR
        BEQL    DEST
        .ENDM   IFNORD

        .MACRO  IFNOWRT SIZ, ADR, DEST, MODE=#0
        PROBEW  MODE, SIZ, ADR
        BEQL    DEST
        .ENDM   IFNOWRT

; IFPRIV, IFNPRIV: VMS's privilege checks: branch to DEST if the process
; whose PCB is in PCB (R4) has (hasn't) the privilege PRIV, a $PRVDEF name
; without PRV$V_, among its current ones. Use $PCBDEF and $PRVDEF.
        .MACRO  IFPRIV  PRIV, DEST, PCB=R4
        BBS     #PRV$V_'PRIV, PCB$Q_PRIV(PCB), DEST
        .ENDM   IFPRIV

        .MACRO  IFNPRIV PRIV, DEST, PCB=R4
        BBC     #PRV$V_'PRIV, PCB$Q_PRIV(PCB), DEST
        .ENDM   IFNPRIV

; $SCBDEF: system control block vectors the PAL delivers through, at the
; VAX's offsets. Each holds the handler's address, a longword.
        .MACRO  $SCBDEF
SCB$L_OPCDEC = ^X10                     ; reserved or privileged instruction
SCB$L_ACCVIO = ^X20                     ; access violation: a mask and the address
SCB$L_CHMK = ^X40                       ; change mode to kernel
SCB$L_CHME = ^X44                       ; to executive
SCB$L_CHMS = ^X48                       ; to supervisor
SCB$L_CHMU = ^X4C                       ; to user
SCB$L_SOFTINT = ^X80                    ; software interrupt level n at +4*n
SCB$L_INTTIM = ^XC0                     ; interval timer, at IPL$_HWCLK
SCB$L_CONSRCV = ^XF8                    ; console receive, at IPL$_CONSOLE
SCB$L_PORT = ^X100                      ; port 0's completion, at IPL$_PORT
SCB$K_LENGTH = ^X104
        .ENDM   $SCBDEF

; $FDSCDEF: a frame descriptor (DESIGN-0004), which a frame's 24(FP)
; points at: what the routine saves and where, the frame's size, a static
; handler, and the routine's name, an .ASCIC string, as its offset from
; the descriptor, or 0.
        .MACRO  $FDSCDEF
FDSC$L_FLAGS = 0
FDSC$V_HANDLER = 0                      ; FDSC$Q_HANDLER is a static handler
FDSC$V_BASE_FRAME = 1                   ; the chain ends here
FDSC$V_TARGET_INVO = 2                  ; call the handler when the frame is an unwind's target
FDSC$V_EXCEPTION_FRAME = 3              ; a frame exception delivery built
FDSC$V_AST_FRAME = 4                    ; a frame AST delivery built
FDSC$L_SAVED = 4                        ; bit n: x18+n, n 0-10; bit 11+n: d8+n
FDSC$L_RSA = 8                          ; the saved registers' offset from FP, ascending
FDSC$L_SIZE = 12                        ; the frame's size: the caller's sp is FP plus it
FDSC$Q_HANDLER = 16
FDSC$Q_NAME = 24
FDSC$K_LENGTH = 32
        .ENDM   $FDSCDEF

; $FRMDEF: a frame (DESIGN-0004), at FP.
        .MACRO  $FRMDEF
FRM$Q_FP = 0                            ; the caller's FP, 0 past the last frame
FRM$Q_PC = 8                            ; the return address
FRM$Q_HANDLER = 16                      ; the condition handler, 0 if none
FRM$Q_FDSC = 24                         ; the frame descriptor's address
FRM$L_ARGS = 32                         ; MACRO-32's argument list, if it homes one
FRM$K_LENGTH = 32                       ; the part every frame has
        .ENDM   $FRMDEF

; $INTSTKDEF: the frame the PAL pushes on the stack of the mode it delivers
; an interrupt or an exception in, and REI pops. Quadwords: the PC, the PSL,
; then every register of the code it stopped, all 64 bits, which REI
; restores. A handler that hands back a register, as a change mode
; handler hands back R0 and R1, writes it into the frame before REI. An
; exception with parameters pushes them below the frame, and its handler
; pops them before REI.
        .MACRO  $INTSTKDEF
INTSTK$Q_PC = 0
INTSTK$Q_PS = 8                         ; the PSL ($PSLDEF): modes, IPL, NZVC
INTSTK$Q_X0 = 16                        ; x0-x30, 8 bytes each
INTSTK$Q_R0 = INTSTK$Q_X0               ; R0
INTSTK$Q_R1 = INTSTK$Q_X0+8             ; R1
INTSTK$Q_R7 = INTSTK$Q_X0+56            ; R7
INTSTK$Q_SP = INTSTK$Q_X0+144           ; the interrupted mode's VAX SP, x18
INTSTK$Q_X_SP = 264                     ; ARM64's sp
INTSTK$K_LENGTH = 272
        .ENDM   $INTSTKDEF

; $HWPCBDEF: the hardware PCB the PAL knows a process context by. Quadword
; aligned. When a context first runs, the PAL pops an INTSTK frame from
; its KSP, as REI does. Each mode's stack pointer is where the PAL pushes
; a frame on entering it from an outer mode, and where it saves the stack
; pointer of a mode it leaves for another. The PAL requests the AST
; delivery interrupt, at IPL$_ASTDEL, when IPL is below it and a mode bit
; set in both ASTEN and ASTSR is the current mode's or an inner one's.
        .MACRO  $HWPCBDEF
HWPCB$Q_KSP = 0                         ; kernel stack pointer
HWPCB$Q_ESP = 8                         ; executive
HWPCB$Q_SSP = 16                        ; supervisor
HWPCB$Q_USP = 24                        ; user
HWPCB$B_ASTEN = 32                      ; bit n: mode n's ASTs may be delivered
HWPCB$B_ASTSR = 33                      ; bit n: an AST for mode n is queued
HWPCB$K_LENGTH = 128
        .ENDM   $HWPCBDEF

; $PTEDEF: a page table entry, as WRPTE takes it: the VAX's, with an
; execute bit, which ARM64 has and the VAX didn't. Pages are 4 KB.
        .MACRO  $PTEDEF
PTE$V_VALID = 31
PTE$M_VALID = ^X80000000
PTE$V_PROT = 27                         ; 4 bits, PRT$C_ codes
PTE$V_EXEC = 25
PTE$M_EXEC = ^X02000000
PTE$M_PFN = ^X001FFFFF
MMG$C_PAGESIZE = 4096
MMG$C_VPCTX = 12                        ; address bits in a page
        .ENDM   $PTEDEF

; $VADEF: the address space every process sees, below 2 GB: P0 and P1 are
; its own, S0 the system's, which all share.
        .MACRO  $VADEF
VA$C_P0BASE = ^X00001000                ; page 0 is never mapped
VA$C_S0BASE = ^X40000000                ; past P0's end
VA$C_P1BASE = ^X60000000                ; past S0's end
VA$C_CLI = ^X7FF00000                   ; a command interpreter's image, up to the stacks
VA$C_STACKS = ^X7FFE4000                ; the mode stacks, executive's first
VA$C_ESP = ^X7FFE8000                   ; the executive stack's top
VA$C_SSP = ^X7FFEC000                   ; the supervisor stack's top
VA$C_USP = ^X7FFF0000                   ; the user stack's top
VA$C_CLI_RESULT = ^X7FFEF800            ; the parse of an image's command, from $IMGACT, above its stack
VA$C_CLI_RESMAX = 2048                  ; its size, at most
VA$C_P1END = ^X7FFF0000
        .ENDM   $VADEF

; $RPBDEF: the restart parameter block, which the PAL fills before the
; executive starts and passes in R11.
        .MACRO  $RPBDEF
RPB$L_BASE = 0                          ; the RPB's own address
RPB$L_PFNCNT = 4                        ; PFNs 0 to PFNCNT-1 are the executive's
RPB$L_FREEPFN = 8                       ; and those below this one are in use
RPB$L_BOOTTIME = 12                     ; seconds since 1970 at boot, from the RTC
RPB$L_PORT = 16                         ; port 0's pages, in S0, or 0 without a network
RPB$Q_HWPCB = 64                        ; the boot context's HWPCB
RPB$T_STARTUP = 192                     ; STARTUP_P1 to STARTUP_P8, 4 characters each, blank-padded
RPB$K_LENGTH = 224
        .ENDM   $RPBDEF

; $STATEDEF: scheduling states, SCH$C_.
        .MACRO  $STATEDEF
SCH$C_MWAIT = 2                         ; resource wait
SCH$C_CEF = 3                           ; common event flag wait
SCH$C_LEF = 5                           ; local event flag wait
SCH$C_HIB = 7                           ; hibernating
SCH$C_SUSP = 9                          ; suspended
SCH$C_COM = 12                          ; computable
SCH$C_CUR = 14                          ; current
SCH$C_MAXPIX = 32                       ; process slots: index 0 unused, 1 the swapper
        .ENDM   $STATEDEF

; $PCBDEF: the software process control block.
        .MACRO  $PCBDEF
PCB$L_SQFL = 0                          ; state queue: COM queue or a wait queue
PCB$L_SQBL = 4
PCB$W_SIZE = 8
PCB$B_TYPE = 10
PCB$B_PRI = 11                          ; current priority, 0-31, higher first
PCB$L_STATE = 12                        ; SCH$C_
PCB$L_PID = 16
PCB$L_STS = 20                          ; PCB$V_
PCB$L_EFCS = 24                         ; event flags 0-31
PCB$L_EFCU = 28                         ; 32-63
PCB$L_EFC2P = 32                        ; common cluster 2 (64-95): its CEB
PCB$L_EFC3P = 36                        ; 3 (96-127)
PCB$L_EFWM = 40                         ; a wait's flags
PCB$L_WEFC = 44                         ; and their cluster, 0-3
PCB$L_KSTACK = 48                       ; kernel stack, from pool
PCB$L_HWPCB = 52                        ; the HWPCB the PAL knows it by
PCB$L_FREP0VA = 56                      ; past its last P0 page
PCB$L_FREP1VA = 60                      ; its first P1 page
PCB$B_PRIB = 64                         ; base priority
PCB$W_QUANT = 66                        ; -ticks left of its quantum
PCB$L_OWNER = 68                        ; creator's PID
PCB$T_LNAME = 72                        ; process name, .ASCIC, 15 characters
PCB$T_IMAGE = 88                        ; image name, .ASCIC, 39 characters
PCB$Q_HWPCB = 128                       ; its HWPCB, if it isn't the boot one
PCB$L_CHANS = 256                       ; bit n: channel n is assigned
PCB$L_CLI = 260                         ; its command interpreter's transfer address, or 0
PCB$L_CLICHANS = 264                    ; the channels it keeps when an image exits
PCB$A_IFAB = 272                        ; its open files' IFABs, by IFI 1-15, or 0
PCB$L_FILES = 336                       ; bit n: IFI n is open
PCB$L_CLIFILES = 340                    ; the files it keeps open when an image exits
PCB$Q_LNMHD = 344                       ; its logical name table, LNM$PROCESS_TABLE: LNMBs
PCB$T_DEFDIR = 352                      ; default directory, .ASCIC, 63 characters: $SETDDIR's
PCB$Q_ASTQFL = 424                      ; its ACBs, by access mode, kernel's first
PCB$L_ASTSP = 432                       ; while an AST routine runs, where on the kernel stack what it interrupted is, else 0
PCB$B_ASTEN = 436                       ; bit n: $SETAST has mode n's ASTs enabled
PCB$B_ASTACT = 437                      ; bit n: an AST routine of mode n runs
PCB$AL_CCB = 440                        ; channel n's device, at 4*n: its UCB
PCB$AL_EXH = 568                        ; mode n's exit handlers, at 4*n: the first one's block, or 0
PCB$L_TMBU = 584                        ; its termination mailbox's unit, MBnn, or 0
PCB$L_FINALSTS = 588                    ; the status of its last $EXIT, or 0
PCB$Q_PRIV = 592                        ; current privileges, $PRVDEF's bits: what the checks look at
PCB$Q_AUTHPRIV = 600                    ; authorized: what $SETPRV may enable without SETPRV
PCB$Q_PROCPRIV = 608                    ; permanent: what the current ones go back to when an image exits
PCB$L_UIC = 616                         ; its UIC: the group in the high word, the member in the low
PCB$T_USERNAME = 620                    ; its user's name, .ASCIC, 12 characters padded with blanks
PCB$K_LENGTH = 640
PCB$C_MAXCHAN = 31                      ; channels 1-31, a bit each in PCB$L_CHANS
PCB$V_WAKEPEN = 0                       ; a $WAKE came that $HIBER hasn't seen
PCB$V_WALL = 1                          ; the wait is for all of EFWM
PCB$V_SUSPEN = 2                        ; suspend when the wait ends
DYN$C_PCB = 1                           ; PCB$B_TYPE
        .ENDM   $PCBDEF

; $CEBDEF: a common event block, a named cluster of 32 common event flags.
        .MACRO  $CEBDEF
CEB$L_CEBFL = 0                         ; all clusters
CEB$L_CEBBL = 4
CEB$L_WQFL = 8                          ; processes waiting on it
CEB$L_WQBL = 12
CEB$L_EFC = 16                          ; the flags
CEB$L_REFC = 20                         ; processes associated
CEB$T_EFCNAM = 24                       ; name, .ASCIC, 15 characters
CEB$K_LENGTH = 48
        .ENDM   $CEBDEF

; $LNMBDEF: a logical name block, from pool, on its table's queue: a
; logical name and its equivalence strings, more than one for a search
; list.
        .MACRO  $LNMBDEF
LNMB$L_FLINK = 0                        ; the table
LNMB$L_BLINK = 4
LNMB$W_SIZE = 8                         ; its size, as allocated
LNMB$T_NAME = 10                        ; the name, .ASCIC, then each equivalence, .ASCIC, then a 0
LNMB$K_LENGTH = 10                      ; past that, the strings
        .ENDM   $LNMBDEF

; $TQEDEF: a timer queue entry, from pool, on EXE$GQ_TQFL in the order it
; is due. Times are VMS's: 100 ns units since 17-Nov-1858. A $SETIMR
; entry with an AST becomes its ACB when it is due: TQE$L_PID, TQE$L_AST
; and TQE$L_ASTPRM are where $ACBDEF has them.
        .MACRO  $TQEDEF
TQE$L_TQFL = 0                          ; timer queue
TQE$L_TQBL = 4
TQE$W_SIZE = 8
TQE$B_TYPE = 10
TQE$B_RQTYPE = 11                       ; TQE$C_
TQE$L_PID = 12                          ; the process it is for
TQE$L_AST = 16                          ; $SETIMR's AST routine, or 0
TQE$L_ASTPRM = 20                       ; $SETIMR's reqidt, the AST's parameter
TQE$Q_TIME = 24                         ; when it is due
TQE$Q_DELTA = 32                        ; a repeating $SCHDWK's interval
TQE$B_RMOD = 40                         ; the access mode of $SETIMR's caller
TQE$L_EFN = 44                          ; $SETIMR's event flag
TQE$K_LENGTH = 48
TQE$C_TMSNGL = 0                        ; $SETIMR: sets an event flag
TQE$C_WKSNGL = 1                        ; $SCHDWK: wakes the process
TQE$C_WKREPT = 2                        ; and again every TQE$Q_DELTA
TQE$C_SSSNGL = 3                        ; a driver's: JSBs TQE$L_AST with R5 = the entry, its own, at IPL$_SYNCH
DYN$C_TQE = 15                          ; TQE$B_TYPE
        .ENDM   $TQEDEF

; $ACBDEF: an AST control block, from pool, on its process's AST queue,
; PCB$Q_ASTQFL, until the AST is delivered (vms/exec/astdel.mar).
        .MACRO  $ACBDEF
ACB$L_ASTQFL = 0                        ; the AST queue
ACB$L_ASTQBL = 4
ACB$W_SIZE = 8
ACB$B_TYPE = 10
ACB$B_RMOD = 11                         ; the access mode the AST is for
ACB$L_PID = 12                          ; the process it is for
ACB$L_AST = 16                          ; the AST routine, called in that mode
ACB$L_ASTPRM = 20                       ; its parameter
ACB$L_KAST = 24                         ; or the executive's routine, for a kernel mode AST: JSB'd with R4 = the PCB, R5 = the ACB, which it frees, at IPL$_SYNCH
ACB$K_LENGTH = 32
DYN$C_ACB = 2                           ; ACB$B_TYPE
        .ENDM   $ACBDEF

; $VCBDEF: a volume control block: a disk and the Files-11 volume mounted
; on it, if one is (vms/exec/f11.mar).
        .MACRO  $VCBDEF
VCB$L_STATUS = 0                        ; VCB$V_
VCB$L_HDRVBN = 4                        ; INDEXF.SYS's VBN of file 1's header
VCB$L_IBMAPLBN = 8                      ; the index file bitmap's LBN
VCB$L_SBMAPLBN = 12                     ; the storage bitmap's LBN
VCB$T_DEVNAM = 16                       ; the device's name, DDCU:, 5 characters
VCB$B_UNIT = 21                         ; the PAL's unit: 0 DKA0:, 1 DKB0:
VCB$W_CLUSTER = 22                      ; the volume's cluster, in blocks
VCB$T_VOLNAME = 24                      ; the volume's label, .ASCIC, 12 characters
VCB$AB_INDEXF = 48                      ; INDEXF.SYS's header, 512 bytes
VCB$L_UCB = 560                         ; the disk's UCB, whose driver the file system's I/O goes through
VCB$L_OWNER = 564                       ; the volume's owner, a UIC
VCB$W_PROT = 568                        ; and protection, a file header's mask: who may use its files
VCB$L_SBMAPBLKS = 572                   ; the storage bitmap's blocks, past its SCB
VCB$K_LENGTH = 576
VCB$V_MOUNTED = 0                       ; a volume is mounted on it
VCB$V_WRITE = 1                         ; the device can be written
VCB$V_RAMDISK = 2                       ; the device is the ramdisk, MDA0:, not one of the PAL's disks
        .ENDM   $VCBDEF

; $UCBDEF: a unit control block: a device, the requests waiting for it,
; and its driver (vms/exec/qio.mar). UCB$L_STS's bits are also
; $GETDVI's DVI$_STS.
        .MACRO  $UCBDEF
UCB$L_IOQFL = 0                         ; IRPs waiting for the device
UCB$L_IOQBL = 4
UCB$L_FDT = 8                           ; the driver's FDT routine, which $QIO JSBs
UCB$L_VCB = 12                          ; a disk's VCB, or 0
UCB$T_NAME = 16                         ; the device's name, DDCU, 4 characters
UCB$L_START = 20                        ; a disk driver's start I/O routine, which does an IRP's I/O, or 0
UCB$L_ERRCNT = 24                       ; the errors the device reported, SS$_DRVERR
UCB$K_LENGTH = 28
UCB$L_CONN = 28                         ; a network unit's or a TELNET terminal's connection on the port, 0 none
UCB$L_MBSTS = 28                        ; a mailbox's UCB$V_PRMMBX
UCB$L_LINK = 32                         ; a cloned unit's, a network unit's, a mailbox's or a terminal's: the next of its kind
UCB$L_REFC = 36                         ; the channels assigned to it
UCB$L_UNIT = 40                         ; its number, n in its name, BGnn, MBnn or TNAn
UCB$L_PROTO = 44                        ; a network unit's socket's protocol, TCPIP$C_
UCB$K_NETLENGTH = 48                    ; a network unit, which BGA0: clones
UCB$L_MSGQFL = 44                       ; a mailbox's messages, oldest first
UCB$L_MSGQBL = 48
UCB$L_MAXMSG = 52                       ; the longest message it takes
UCB$L_BUFQUO = 56                       ; the bytes of messages it may still hold
UCB$K_MBLENGTH = 60                     ; a mailbox
UCB$A_TT_CHAR = 44                      ; a terminal's characteristics, IO$_SENSEMODE's 12 bytes: class, type, width, TT$ bits and page, TT2$ bits
UCB$L_TT_STS = 56                       ; UCB$V_TT_
UCB$L_TT_PUT = 60                       ; the type-ahead buffer, a ring: where the next character received goes
UCB$L_TT_GET = 64                       ; and where a read takes the next from
UCB$Q_TT_CTRLC = 68                     ; the CTRL/C ASTs enabled: IRPs, as ACBs
UCB$Q_TT_CTRLY = 76                     ; and the CTRL/Y ones
UCB$L_TT_LEN = 84                       ; the line being read: its length,
UCB$L_TT_CURSOR = 88                    ; where the cursor is in it,
UCB$L_TT_BACK = 92                      ; and how many lines back a recall is, 0 none
UCB$L_TT_ESC = 96                       ; an escape sequence being read: its state, and its length in the high word
UCB$L_TT_RECALL = 100                   ; the recall buffer's slot the next line read goes in
UCB$L_TT_NRECALL = 104                  ; how many lines the recall buffer holds
UCB$Q_TT_WRTQ = 108                     ; a TELNET terminal's writes waiting to be sent, IRPs
UCB$L_TT_SEND = 116                     ; its send on the port, an IRP, or 0
UCB$L_TT_OUTLEN = 120                   ; the bytes in UCB$A_TT_OUT
UCB$L_TT_TELNET = 124                   ; Telnet's state, the command and option it is in, a subnegotiation's count
UCB$L_TT_SB = 128                       ; a subnegotiation's last four bytes
UCB$A_TT_TQE = 132                      ; a timed read's timer queue entry, TQE$K_LENGTH bytes
UCB$A_TT_RING = 180                     ; the type-ahead buffer, UCB$K_TT_TYPEAHEAD bytes
UCB$A_TT_RECALL = 436                   ; the lines read, UCB$K_TT_RECALL of 256 bytes, each .ASCIC
UCB$A_TT_OUT = 4532                     ; a TELNET terminal's echo and prompts, not yet sent, UCB$K_TT_OUTSIZE bytes
UCB$L_TT_CTRL = 5556                    ; CTRL/C and CTRL/Y that came, for SERVICE: the console's interrupt sets them
UCB$K_TTLENGTH = 5560                   ; a terminal
UCB$K_TT_TYPEAHEAD = 256
UCB$K_TT_RECALL = 16                    ; a power of 2
UCB$K_TT_OUTSIZE = 1024
UCB$V_TT_CTRLC = 0                      ; UCB$L_TT_CTRL: CTRL/C came
UCB$V_TT_CTRLY = 1                      ; CTRL/Y came
UCB$V_TT_HANGUP = 2                     ; UCB$L_TT_STS: the line is gone: reads and writes end with SS$_HANGUP
UCB$V_TT_TIMER = 3                      ; UCB$A_TT_TQE is on the timer queue
UCB$V_TT_OVER = 4                       ; the line being read is in overstrike mode, CTRL/A's
UCB$V_TT_RECV = 5                       ; a TELNET terminal's receive is on the port
UCB$V_TT_TN = 6                         ; a TELNET terminal, TNAn, not the console
UCB$V_PRMMBX = 0                        ; UCB$L_MBSTS: permanent, until $DELMBX
UCB$M_PRMMBX = 1
UCB$V_ONLINE = 4                        ; the device is online
UCB$M_ONLINE = ^X10
        .ENDM   $UCBDEF

; $IRPDEF: an I/O request packet, from pool, which a driver makes for a
; $QIO, or the file system's own, with no process. Its head is an ACB's: IOC$REQCOM queues it to its process as a
; kernel mode AST, IOC$POST, and that may queue it again as the caller's
; AST. A buffered read's prompt and data follow it.
        .MACRO  $IRPDEF
IRP$L_IOQFL = 0                         ; the UCB's queue, then the AST queue
IRP$L_IOQBL = 4
IRP$W_SIZE = 8                          ; with the prompt and data
IRP$B_TYPE = 10
IRP$B_RMOD = 11                         ; the AST's mode: kernel, then the caller's
IRP$L_PID = 12                          ; the process it is for
IRP$L_AST = 16                          ; the caller's AST routine, or 0
IRP$L_ASTPRM = 20                       ; its parameter
IRP$L_KAST = 24                         ; IOC$POST once done, then 0
IRP$L_UCB = 28                          ; the device
IRP$L_FUNC = 32                         ; the function code and its modifiers
IRP$L_EFN = 36                          ; the event flag
IRP$L_IOSB = 40                         ; the caller's I/O status block, or 0
IRP$W_CHAN = 44                         ; the channel
IRP$B_PMOD = 46                         ; the caller's access mode
IRP$L_STS = 48                          ; IRP$V_
IRP$L_IOST1 = 52                        ; once done, the IOSB's first longword: a status and a byte count
IRP$L_IOST2 = 56                        ; and its second
IRP$L_BUFADR = 60                       ; the caller's buffer, p1
IRP$L_BCNT = 64                         ; its size, p2
IRP$L_PROMPT = 68                       ; a read's prompt's size: it is past IRP$K_LENGTH, and the data past it
IRP$L_MEDIA = 72                        ; a disk's LBN, p3
IRP$L_POST = 76                         ; a routine IOC$POST JSBs, R6 the IRP, in its process, or 0
IRP$K_LENGTH = 80
IRP$V_BUFIO = 0                         ; a read whose data IOC$POST copies to the caller's buffer
IRP$M_BUFIO = 1
IRP$V_STARTED = 1                       ; the terminal has written its prompt
DYN$C_IRP = 10                          ; IRP$B_TYPE
        .ENDM   $IRPDEF

; $PORTDEF: the port, the pages the executive shares with the TCP/IP
; component below it (pal/tcpip/include/port.h, which this must match;
; docs/design/0003-tcpip-port.md). Page 0 is the header and two rings of
; PORT$K_RING messages, the executive's commands and the component's
; responses; page 1 + n is tag n's buffer, for the first PORT$K_BUFFERS.
        .MACRO  $PORTDEF
PORT$K_VERSION = 2                      ; PORT$L_VERSION once the component is ready
PORT$K_PAGES = 17
PORT$K_RING = 32                        ; messages in a ring
PORT$K_TAGS = 32                        ; tags, a command's each: the credits
PORT$K_BUFFERS = 16                     ; the tags that have a buffer
PORT$K_BUFSIZE = 4096
PORT$L_VERSION = 0
PORT$L_CMDPUT = 4                       ; commands written, by the executive
PORT$L_CMDGET = 8                       ; and taken, by the component
PORT$L_RSPPUT = 12                      ; responses written, by the component
PORT$L_RSPGET = 16                      ; and taken, by the executive
PORT$A_CMD = ^X100                      ; the command ring
PORT$A_RSP = ^X500                      ; the response ring
PORTMSG$B_TYPE = 0                      ; PORT$C_
PORTMSG$B_FLAGS = 1
PORTMSG$W_TAG = 2                       ; the executive's, echoed in the response
PORTMSG$L_CONN = 4                      ; the connection, 0 the control connection
PORTMSG$L_STATUS = 8                    ; a response's PORT$C_ST_
PORTMSG$L_LEN = 12                      ; bytes in the tag's buffer
PORTMSG$L_ADDR = 16                     ; an IPv4 address, network order
PORTMSG$W_PORT = 20                     ; a TCP or UDP port
PORTMSG$W_PROTO = 22
PORTMSG$L_ARG1 = 24
PORTMSG$L_ARG2 = 28
PORTMSG$K_LENGTH = 32
PORT$C_OPEN = 1                         ; PROTO: TCP, UDP or ICMP; then as SETMODE; response: CONN
PORT$C_SETMODE = 2                      ; FLAGS BIND: ADDR, PORT the local address; LISTEN: ARG1 the backlog
PORT$C_ACCEPT = 3                       ; response: ARG1 the new connection, ADDR and PORT the peer's
PORT$C_CONNECT = 4                      ; ADDR, PORT: the peer's
PORT$C_SEND = 5                         ; LEN bytes from the buffer, a datagram to ADDR, PORT with FLAGS TO
PORT$C_RECV = 6                         ; at most LEN bytes into the buffer, 0 if the peer closed; a datagram's sender
PORT$C_CLOSE = 7
PORT$C_IFCONFIG = 8                     ; sets those FLAGS has: ADDR, ARG1 the mask, ARG2 the gateway, or DHCP's; response: all
PORT$C_CANCEL = 9                       ; ends the connection's commands
PORT$C_GETNAME = 10                     ; response: ADDR and PORT the local name, ARG1 and ARG2 the peer's
PORT$C_SHUTDOWN = 11                    ; ARG1: 0 no more receives, 1 no more sends, 2 neither
PORT$C_ICMP = 1                         ; PROTO, a raw socket's
PORT$C_TCP = 6
PORT$C_UDP = 17
PORT$M_BIND = 1                         ; OPEN, SETMODE: bind
PORT$M_LISTEN = 2                       ; OPEN, SETMODE: listen
PORT$M_TO = 1                           ; SEND: to ADDR, PORT
PORT$M_ADDR = 1                         ; IFCONFIG: set the address
PORT$M_MASK = 2                         ; the mask
PORT$M_GW = 4                           ; the gateway
PORT$M_DHCP = 8                         ; ask a DHCP server, and answer once it has
PORT$M_LINKUP = 16                      ; IFCONFIG's response: the link is up
PORT$C_ST_OK = 0                        ; the statuses, which the driver maps to SS$_
PORT$C_ST_BADPARAM = 1
PORT$C_ST_NOMEM = 2
PORT$C_ST_INUSE = 3
PORT$C_ST_REFUSED = 4
PORT$C_ST_RESET = 5
PORT$C_ST_TIMEOUT = 6
PORT$C_ST_ABORTED = 7
PORT$C_ST_UNREACH = 8
PORT$C_ST_CLOSED = 9
PORT$C_ST_NOLINKS = 10
PORT$C_ST_ISCONN = 11
PORT$C_ST_IVADDR = 12
        .ENDM   $PORTDEF

; $IFBDEF: an IFAB, the block of pool RMS keeps an open file in, by its
; IFI: the file's attributes, its header, and its organization's state,
; with buffers after the fixed part.
        .MACRO  $IFBDEF
IFB$L_POS = 0                           ; sequential: the next byte; relative: the next record number
IFB$L_EOF = 4                           ; sequential: the bytes in the file; relative: the VBN after the last bucket
IFB$L_BLOCK = 8                         ; the VBN in the buffer, or 0
IFB$L_VCB = 12                          ; the file's volume
IFB$L_FLAGS = 16                        ; IFB$V_
IFB$L_SIZE = 20                         ; the IFAB's size, to give it back
IFB$L_BUF = 24                          ; its buffer: a block, or a bucket
IFB$L_CUR = 28                          ; the current record: sequential, its offset, -1 for none; relative, its number, 0 for none
IFB$L_CURDAT = 32                       ; sequential: its data's offset
IFB$L_CURSZ = 36                        ; sequential: its data's size
IFB$B_ORG = 40                          ; organization, FAB$C_SEQ, REL or IDX
IFB$B_RFM = 41                          ; record format, FAB$C_
IFB$B_RAT = 42                          ; record attributes
IFB$B_FSZ = 43                          ; VFC header size
IFB$W_MRS = 44                          ; record size, or the largest
IFB$B_BKS = 46                          ; bucket size, blocks
IFB$B_FAC = 47                          ; the access $OPEN or $CREATE gave, FAB$M_
IFB$L_MRN = 48                          ; relative: the highest record number
IFB$L_DVBN = 52                         ; relative: the first bucket's VBN
IFB$L_CELLS = 56                        ; relative: cells in a bucket
IFB$L_CELLSZ = 60                       ; relative: a cell's size
IFB$L_IDX = 64                          ; indexed: its state, past the buffers
IFB$L_RAB = 68                          ; the RAB connected, or 0
IFB$L_BUFSZ = 72                        ; the buffer's size, to give it back
IFB$AB_HDR = 80                         ; the file's header
IFB$K_LENGTH = 592                      ; the fixed part
IFB$V_WRITE = 0                         ; it may be written: $CREATE made it or $OPEN opened it for that
IFB$V_DIRTY = 1                         ; the buffer holds what the file hasn't yet
IFB$V_HDR = 2                           ; the header changed: its end of file
IFB$V_BIO = 3                           ; block I/O only
IFB$V_BRO = 4                           ; block and record I/O
IFB$V_PLG = 5                           ; relative: the prologue's end of file changed
IFB$V_FOUND = 6                         ; the last record service was a $FIND: a sequential $GET reads the record it found
IFB$V_DATA = 7                          ; indexed: a bucket was written, the end of file goes past the last block
        .ENDM   $IFBDEF

; $PLGDEF, $KEYDEF, $AREADEF, $BKTDEF, $IRCDEF, $DLCDEF: relative and
; prologue 3 indexed files on the disk (crosstools/ods/docs/relative.md, indexed.md).
        .MACRO  $PLGDEF
PLG$B_AVBN = 102                        ; first area descriptor's VBN
PLG$B_AMAX = 103                        ; areas
PLG$W_DVBN = 104                        ; relative: first bucket
PLG$L_MRN = 108                         ; relative: highest record number
PLG$L_EOF = 112                         ; relative: the VBN after the last bucket
PLG$W_VER_NO = 116                      ; prologue version
PLG$C_VER_REL = 1                       ; a relative file's
PLG$C_VER_3 = 3                         ; an indexed file's
PLG$W_CHECKSUM = 510                    ; the 16-bit sum of the block's first 255 words
        .ENDM   $PLGDEF

        .MACRO  $KEYDEF
KEY$L_IDXFL = 0                         ; the next key descriptor's VBN, 0 for none
KEY$W_NOFF = 4                          ; and offset
KEY$B_IANUM = 6                         ; area of the index above level 1
KEY$B_LANUM = 7                         ; area of the level 1 index
KEY$B_DANUM = 8                         ; area of the data
KEY$B_ROOTLEV = 9                       ; root bucket's level
KEY$B_IDXBKTSZ = 10                     ; index bucket size
KEY$B_DATBKTSZ = 11                     ; data bucket size
KEY$L_ROOTVBN = 12                      ; root bucket
KEY$B_FLAGS = 16                        ; KEY$V_
KEY$B_DATATYPE = 17                     ; KEY$C_
KEY$B_SEGMENTS = 18
KEY$B_NULLCHAR = 19                     ; null value, with NULKEYS
KEY$B_KEYSZ = 20                        ; the key's size
KEY$B_KEYREF = 21                       ; key of reference
KEY$W_MINRECSZ = 22                     ; shortest record holding the key
KEY$W_IDXFILL = 24                      ; index fill, bytes
KEY$W_DATFILL = 26                      ; data fill, bytes
KEY$W_POSITION = 28                     ; segment positions, 8 words
KEY$B_SIZE = 44                         ; segment sizes, 8 bytes
KEY$T_KEYNAM = 52                       ; name, 32 bytes, space padded
KEY$L_LDVBN = 84                        ; first data bucket
KEY$B_TYPE = 88                         ; segment types, 8 bytes
KEY$K_BLN = 102                         ; a key descriptor's size
KEY$V_DUPKEYS = 0                       ; duplicates
KEY$M_DUPKEYS = 1
KEY$V_CHGKEYS = 1                       ; $UPDATE may change it
KEY$M_CHGKEYS = 2
KEY$V_NULKEYS = 2                       ; a null key isn't indexed
KEY$M_NULKEYS = 4
KEY$V_IDX_COMPR = 3                     ; index compression
KEY$M_IDX_COMPR = 8
KEY$V_INITIDX = 4                       ; no index yet
KEY$M_INITIDX = 16
KEY$V_KEY_COMPR = 6                     ; key compression in data and SIDR buckets
KEY$M_KEY_COMPR = 64
KEY$V_REC_COMPR = 7                     ; data record compression
KEY$M_REC_COMPR = 128
KEY$C_STRING = 0
KEY$C_SGNWORD = 1
KEY$C_UNSGNWORD = 2
KEY$C_SGNLONG = 3
KEY$C_UNSGNLONG = 4
KEY$C_PACKED = 5
KEY$C_SGNQUAD = 6
KEY$C_UNSGNQUAD = 7
KEY$C_COLLATED = 8
KEY$C_DESCENDING = 32                   ; added to one of those
        .ENDM   $KEYDEF

        .MACRO  $AREADEF
AREA$B_AREAID = 2                       ; its number
AREA$B_ARBKTSZ = 3                      ; bucket size
AREA$W_VOLUME = 4
AREA$B_ALN = 6                          ; placement
AREA$B_AOP = 7                          ; allocation options
AREA$L_AVAIL = 8                        ; first reclaimed bucket, 0 for none
AREA$L_CVBN = 12                        ; current extent's first VBN
AREA$L_CNBLK = 16                       ; and blocks
AREA$L_USED = 20                        ; blocks of it used
AREA$L_NXTVBN = 24                      ; next VBN to use
AREA$L_NXT = 28                         ; next extent, 0 for none
AREA$L_NXBLK = 32                       ; its blocks
AREA$W_DEQ = 36                         ; default extension
AREA$L_LOC = 40                         ; placement location
AREA$W_RFI = 44                         ; related file, 3 words
AREA$L_TOTAL_ALLOC = 50                 ; blocks the area has
AREA$K_BLN = 64                         ; an area descriptor's size
        .ENDM   $AREADEF

        .MACRO  $BKTDEF
BKT$B_CHECKCHAR = 0                     ; as the bucket's last byte
BKT$B_INDEXNO = 1                       ; key of reference
BKT$W_ADRSAMPLE = 2                     ; low word of its VBN
BKT$W_FREESPACE = 4                     ; first free byte
BKT$W_NXTRECID = 6                      ; next record ID
BKT$L_NXTBKT = 8                        ; next bucket of the level
BKT$B_LEVEL = 12                        ; 0 for data and SIDR buckets
BKT$B_BKTCB = 13                        ; BKT$V_
BKT$K_OVERHDSZ = 14                     ; the header's size
BKT$V_LASTBKT = 0                       ; the last of its level
BKT$V_ROOTBKT = 1                       ; the root
BKT$V_PTR_SZ = 3                        ; index pointers' size less 2, 2 bits
BKT$K_ENDOVHD = 4                       ; an index bucket's end: VBN free space word, 0, check character
        .ENDM   $BKTDEF

        .MACRO  $IRCDEF
IRC$B_CONTROL = 0                       ; IRC$V_
IRC$W_ID = 1                            ; record ID
IRC$W_RRV_ID = 3                        ; its RFA's ID
IRC$L_RRV_VBN = 5                       ; and VBN
IRC$K_HDRSZ = 9                         ; a data record's header, with a 4-byte pointer
IRC$V_PTRSZ = 0                         ; the pointer's size less 2, 2 bits
IRC$V_DELETED = 2
IRC$V_RRV = 3                           ; a record reference vector
IRC$V_NOPTRSZ = 4                       ; no pointer: a deleted SIDR pointer
IRC$V_FIRST = 7                         ; a SIDR's first pointer
        .ENDM   $IRCDEF

        .MACRO  $DLCDEF
DLC$V_DELETED = 2                       ; a relative cell's record was deleted
DLC$V_REC = 3                           ; it has a record
        .ENDM   $DLCDEF

; $IDXDEF: an indexed file's state, in its IFAB's buffer: its keys and
; areas, the stream's place, the keys being worked on, and walks, each a
; place in a bucket. rmsidx.mar and rmsidxw.mar's.
        .MACRO  $IDXDEF
; A walk: a bucket, an entry in it, what the entry is, and the keys
; before it and of it, expanded.
W$L_BUF = 0                             ; the bucket's room
W$L_VBN = 4                             ; the bucket
W$L_SIZE = 8                            ; its bytes
W$L_OFF = 12                            ; the entry's offset
W$L_FREE = 16                           ; where the entries end
W$L_INDEX = 20                          ; the entry's number from 0
W$L_CTL = 24                            ; its control byte
W$L_ID = 28                             ; its ID
W$L_RRVID = 32                          ; a record's RFA, an RRV's new place, an index entry's pointer: ID
W$L_RRVVBN = 36                         ; and VBN
W$L_BODY = 40                           ; a record's or SIDR's body, after its size
W$L_BLEN = 44                           ; the body's bytes
W$L_LEN = 48                            ; the entry's bytes
W$L_KLEN = 52                           ; the bytes of its key in the body, before the rest
W$L_PTR = 56                            ; a SIDR's pointer
W$L_PEND = 60                           ; and where its pointers end
W$T_PREV = 64                           ; the key before the entry
W$T_CUR = 320                           ; the entry's key
W$K_LENGTH = 576
X$L_NKEYS = 0                           ; keys
X$L_NAREAS = 4                          ; areas
X$L_KEYS = 8                            ; their descriptors, KEY$K_BLN each
X$L_KLOC = 12                           ; where each is: VBN and offset, a longword each
X$L_AREAS = 16                          ; area descriptors, AREA$K_BLN each
X$L_AVBN = 20                           ; the first area descriptor's VBN
X$L_BKS = 24                            ; the largest bucket, blocks
X$L_BUF0 = 28                           ; a bucket's room each: a descent's and walk 0's,
X$L_BUF1 = 32                           ; walk 1's: a record by RFA, a split's new bucket,
X$L_BUF2 = 36                           ; walk 2's: an RRV's bucket
X$L_WORK = 40                           ; a record being made
X$L_LEVEL = 44                          ; a descent's level
X$B_KRF = 48                            ; the stream's key of reference
X$B_STATE = 49                          ; X$C_: where the stream is
X$W_CURID = 50                          ; the current record's RFA: ID,
X$L_CURVBN = 52                         ; and VBN, 0 if there is none
X$L_CTXVBN = 56                         ; the stream's record's RFA: VBN,
X$W_CTXID = 60                          ; and ID
X$W_FLAGS = 62                          ; X$V_
X$T_CTXKEY = 64                         ; and its key along X$B_KRF
X$T_KEY = 320                           ; a key looked for or made
X$T_KEY2 = 576                          ; another
X$L_PATH = 832                          ; a descent's buckets and entries, a quadword a level
X$T_LASTPUT = 1088                      ; the key of the last $PUT by RAB$C_SEQ
X$T_QPREV = 1344                        ; where a key goes in a bucket: the key before,
X$T_QCUR = 1600                         ; and the entry's there
X$L_Q = 1856                            ; that entry's number,
X$L_QOFF = 1860                         ; and offset
X$L_N = 1864                            ; the bucket's records or SIDRs
X$L_END = 1868                          ; and where they end, before its RRVs
X$L_WORK2 = 1872                        ; another record being made
X$L_WORKSZ = 1876                       ; X$L_WORK's bytes
X$L_NMOV = 1880                         ; records a split moved, in X$L_WORK2: home VBN, ID, new ID
X$L_RVBN = 1884                         ; a split's new bucket
X$L_RFAVBN = 1888                       ; a record's RFA, being put: VBN,
X$W_RFAID = 1892                        ; and ID
X$L_PRREC = 1896                        ; a record being packed,
X$L_PRLEN = 1900                        ; and its size
X$L_M = 1904                            ; a split's first entry that goes
X$K_WALK0 = 1908                        ; the walks
X$K_WALK1 = 1908+W$K_LENGTH
X$K_WALK2 = 1908+<2*W$K_LENGTH>
X$K_LENGTH = 1908+<3*W$K_LENGTH>
X$C_BOF = 0                             ; before the first record
X$C_AFTER = 1                           ; after the stream's record
X$C_AT = 2                              ; at it: a $FIND found it
X$C_EOF = 3                             ; past the last
X$V_LASTPUT = 0                         ; X$T_LASTPUT holds a key
X$V_OKDUP = 1                           ; a $PUT found a key it has
        .ENDM   $IDXDEF

; $UAFDEF: a SYSUAF.DAT record, VMS's layout: the user's name, UIC,
; password, privileges and quotas. The username and the account are blank
; padded; the other strings are counted, then blank padded. Keys: 0 the
; username, 1 the UIC, 2 the UIC and sub-identifier, 3 the parent
; identifier.
        .MACRO  $UAFDEF
UAF$B_RTYPE = 0                         ; the record's type: UAF$C_USER_ID
UAF$B_VERSION = 1                       ; its format: UAF$C_VERSION1
UAF$W_USRDATOFF = 2                     ; where the user data is, a counted string
UAF$T_USERNAME = 4                      ; the username, 32 characters
UAF$L_UIC = 36
UAF$W_MEM = 36                          ; the UIC's member,
UAF$W_GRP = 38                          ; and its group
UAF$L_SUB_ID = 40                       ; the user's sub-identifier
UAF$Q_PARENT_ID = 44                    ; the identifier that owns the account
UAF$T_ACCOUNT = 52                      ; the account, 32 characters
UAF$T_OWNER = 84                        ; the owner's name, 32
UAF$T_DEFDEV = 116                      ; the default device, 32
UAF$T_DEFDIR = 148                      ; the default directory, 64
UAF$T_LGICMD = 212                      ; the login command file, 64
UAF$T_DEFCLI = 276                      ; the command interpreter, 32
UAF$T_CLITABLES = 308                   ; its tables, 32
UAF$Q_PWD = 340                         ; the password's hash
UAF$Q_PWD2 = 348                        ; the second password's
UAF$W_LOGFAILS = 356                    ; login failures since the last login
UAF$W_SALT = 358                        ; the hash's salt
UAF$B_ENCRYPT = 360                     ; its algorithm: UAI$C_ in starlet.mlb
UAF$B_ENCRYPT2 = 361                    ; the second password's algorithm
UAF$B_PWD_LENGTH = 362                  ; the shortest password
UAF$Q_EXPIRATION = 364                  ; when the account expires
UAF$Q_PWD_LIFETIME = 372                ; how long a password lasts
UAF$Q_PWD_DATE = 380                    ; when the password changed
UAF$Q_PWD2_DATE = 388                   ; when the second one changed
UAF$Q_LASTLOGIN_I = 396                 ; the last interactive login
UAF$Q_LASTLOGIN_N = 404                 ; and the last other one
UAF$Q_PRIV = 412                        ; the authorized privileges, $PRVDEF's bits
UAF$Q_DEF_PRIV = 420                    ; those a login enables
UAF$L_FLAGS = 468                       ; UAF$V_
UAF$B_PRI = 516                         ; the base priority
UAF$B_QUEPRI = 517                      ; the highest priority of its jobs in a queue
UAF$W_MAXJOBS = 518                     ; its processes at once, 0 for any
UAF$W_MAXACCTJOBS = 520                 ; its account's
UAF$W_MAXDETACH = 522                   ; its detached processes
UAF$W_PRCCNT = 524                      ; subprocesses: PRCLM
UAF$W_BIOLM = 526                       ; buffered I/O
UAF$W_DIOLM = 528                       ; direct I/O
UAF$W_TQCNT = 530                       ; timer queue entries: TQELM
UAF$W_ASTLM = 532
UAF$W_ENQLM = 534                       ; locks
UAF$W_FILLM = 536                       ; open files
UAF$W_SHRFILLM = 538                    ; shared files
UAF$L_WSQUOTA = 540                     ; the working set's quota,
UAF$L_DFWSCNT = 544                     ; its default size,
UAF$L_WSEXTENT = 548                    ; and its most
UAF$L_PGFLQUOTA = 552                   ; page file pages
UAF$L_CPUTIM = 556                      ; CPU time, 10 ms ticks, 0 for any
UAF$L_BYTLM = 560                       ; buffered I/O bytes
UAF$L_PBYTLM = 564                      ; paged buffered I/O bytes
UAF$L_JTQUOTA = 568                     ; the job table's bytes
UAF$C_FIXED = 644                       ; the record's fixed part: a record without user data
UAF$C_LENGTH = 1412                     ; the longest record
UAF$C_USER_ID = 1
UAF$C_VERSION1 = 1
UAF$V_DISCTLY = 0                       ; FLAGS: no CTRL/Y
UAF$V_DEFCLI = 1                        ; only the default command interpreter
UAF$V_LOCKPWD = 2                       ; no SET PASSWORD
UAF$V_CAPTIVE = 3
UAF$V_DISACNT = 4                       ; no login
UAF$V_DISWELCOM = 5                     ; no welcome message
        .ENDM   $UAFDEF
