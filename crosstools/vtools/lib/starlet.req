    RMS$_FTM = 100292,  ! network file transfer mode precludes operation (SQO set)
    RMS$_GBC = 100300,  ! invalid global buffer count
    RMS$_DEADLOCK = 100308,  ! deadlock detected
    RMS$_EXENQLM = 100316,  ! exceeded enqueue quota
    RMS$_JOP = 100324,  ! journaling options not supported on device
    RMS$_RUM = 100332,  ! recovery-unit handler called from incorrect access mode
    RMS$_JNS = 100340,  ! operation not supported by RMS journaling
    RMS$_NRU = 100348,  ! operation prohibited outside recovery-unit
    RMS$_IFF = 100356,  ! invalid file attributes for requested file access
    RMS$_DTFTRATBL = 100364,  ! error loading translation table; reason code %X!XL
    RMS$_DTFUNSTYP = 100372,  ! unsupported data type in record; reason code %X!XL
    RMS$_DTFVERMIS = 100380,  ! incompatible version of control file; reason code %X!XL
    RMS$_DTFACC = 100386,  ! error accessing file; reason code %X!XL
    RMS$_BOGUSCOL = 100396,  ! invalid or inaccessible collate table
    RMS$_ERRREADCOL = 100404,  ! error encountered while reading collate table
    RMS$_ERRWRITECOL = 100412,  ! error encountered while writing collate table
    RMS$_SNS = 100420,  ! statistics monitoring not supported for non-disk devices
    RMS$_NOEXTEND = 100428,  ! previous $EXTEND operation failed - further $EXTENDs prohibited
    RMS$_DTFCRE = 100434,  ! error creating file; reason code %X!XL
    RMS$_DELJNS = 100444,  ! deleting a file marked for journaling not yet supported (unmark file for journaling first)
    RMS$_NOTSAMEJNL = 100452,  ! files in a recovery unit must use same RMS journal
    RMS$_SNPPF = 100460,  ! statistics monitoring not supported for process permanent files
    RMS$_NAML = 100468,  ! invalid NAML block or NAML block not accessible
    RMS$_NAMLESS = 100476,  ! NAML expanded string area too small
    RMS$_NAMLRSS = 100484,  ! NAML resultant string area too small
    RMS$_NAMLFSSIZ = 100492,  ! NAML file system string area too small
    RMS$_NAMLFSINV = 100500,  ! NAML file system string address invalid
    RMS$_BADGBH = 100508,  ! Bad GBH
    RMS$_BADGBD = 100516,  ! Bad GBD
    RMS$_FOPEXTMBZ = 100524,  ! reserved fields asociated with FAB$V_EXTEND_FOP must be zero
    RMS$_INVOP_SSIO = 100532,  ! invalid operation for SSIO access
    RMS$_IVSF = 100540,  ! invalid special file format
    RMS$_ATR = 114892,  ! file attributes read error
    RMS$_ATW = 114900,  ! file attributes write error
    RMS$_CCF = 114908,  ! cannot close file
    RMS$_CDA = 114916,  ! cannot deliver AST
    RMS$_CHN = 114924,  ! assign channel system service request failed
    RMS$_RER = 114932,  ! file read error
    RMS$_RMV = 114940,  ! ACP remove function failed
    RMS$_RPL = 114948,  ! error detected while reading prolog
    RMS$_SYS = 114956,  ! QIO system service request failed
    RMS$_WER = 114964,  ! file write error
    RMS$_WPL = 114972,  ! error detected while writing prolog
    RMS$_IFA = 114980,  ! illegal file attributes detected (file header corrupted)
    RMS$_WBE = 114988,  ! error on write behind
    RMS$_ENQ = 114996,  ! ENQ system service request failed
    RMS$_NETFAIL = 115004,  ! network operation failed at remote node
    RMS$_SUPPORT = 115012,  ! network operation not supported
    RMS$_CRMP = 115020,  ! CRMPSC system service failed to map global buffers
    RMS$_DTFCFGFIL = 115028,  ! error accessing configuration file
    RMS$_REENT = 115036,  ! file could not be renamed and recovery failed; file has been lost
    RMS$_ACC_RUJ = 115044,  ! recovery unit journal can not be accessed
    RMS$_TMR = 115052,  ! SETIMR system service request failed
    RMS$_ACC_AIJ = 115060,  ! after image journal can not be accessed
    RMS$_ACC_BIJ = 115068,  ! before image journal can not be accessed
    RMS$_ACC_ATJ = 115076,  ! audit trail journal can not be accessed
    RMS$_DTFDEFFIL = 115084,  ! error accessing file definition file
    RMS$_DTFREGFIL = 115092,  ! error accessing registration file
    RMS$_JNLNOTAUTH = 115100,  ! RMS Journaling not authorized; operation not performed
    RMS$_CRBUFOBJ = 115108,  ! CREATE_BUFOBJ system service failed to create buffer object
    RMS$_RSESTK_ALLOC = 115116;  ! allocation of KP RSE stack failed

! $FABDEF
LITERAL
    FAB$C_BID = 3,
    FAB$C_BLN = 80,
    FAB$K_BLN = 80,
    FAB$V_MXV = 1,  ! $CREATE: a version above the highest
    FAB$M_MXV = 2,
    FAB$V_SUP = 2,  ! $CREATE: supersede a version that exists
    FAB$M_SUP = 4,
    FAB$V_TMP = 3,  ! temporary: no directory entry
    FAB$M_TMP = 8,
    FAB$V_TMD = 4,  ! temporary, deleted when closed
    FAB$M_TMD = 16,
    FAB$V_DFW = 5,  ! deferred write
    FAB$M_DFW = 32,
    FAB$V_SQO = 6,  ! sequential access only
    FAB$M_SQO = 64,
    FAB$V_RWO = 7,  ! rewind on open
    FAB$M_RWO = 128,
    FAB$V_POS = 8,
    FAB$M_POS = 256,
    FAB$V_WCK = 9,  ! write check
    FAB$M_WCK = 512,
    FAB$V_NEF = 10,  ! don't position to end of file
    FAB$M_NEF = 1024,
    FAB$V_RWC = 11,  ! rewind on close
    FAB$M_RWC = 2048,
    FAB$V_DMO = 12,
    FAB$M_DMO = 4096,
    FAB$V_SPL = 13,  ! spool when closed
    FAB$M_SPL = 8192,
    FAB$V_SCF = 14,  ! submit as a batch job when closed
    FAB$M_SCF = 16384,
    FAB$V_DLT = 15,  ! delete when closed
    FAB$M_DLT = 32768,
    FAB$V_NFS = 16,  ! non-file-structured
    FAB$M_NFS = 65536,
    FAB$V_UFO = 17,  ! user file open: no RMS
    FAB$M_UFO = 131072,
    FAB$V_PPF = 18,
    FAB$M_PPF = 262144,
    FAB$V_INP = 19,
    FAB$M_INP = 524288,
    FAB$V_CTG = 20,  ! contiguous
    FAB$M_CTG = 1048576,
    FAB$V_CBT = 21,  ! contiguous best try
    FAB$M_CBT = 2097152,
    FAB$V_RCK = 23,  ! read check
    FAB$M_RCK = 8388608,
    FAB$V_NAM = 24,  ! the file the NAM block names, by its resultant string
    FAB$M_NAM = 16777216,
    FAB$V_CIF = 25,  ! $CREATE: open the file if it exists
    FAB$M_CIF = 33554432,
    FAB$V_ESC = 27,
    FAB$M_ESC = 134217728,
    FAB$V_TEF = 28,  ! truncate at end of file when closed
    FAB$M_TEF = 268435456,
    FAB$V_OFP = 29,  ! output file parse
    FAB$M_OFP = 536870912,
    FAB$V_KFO = 30,
    FAB$M_KFO = 1073741824,
    FAB$V_PUT = 0,
    FAB$M_PUT = 1,
    FAB$V_GET = 1,
    FAB$M_GET = 2,
    FAB$V_DEL = 2,
    FAB$M_DEL = 4,
    FAB$V_UPD = 3,
    FAB$M_UPD = 8,
    FAB$V_TRN = 4,  ! $TRUNCATE
    FAB$M_TRN = 16,
    FAB$V_BIO = 5,  ! block I/O only
    FAB$M_BIO = 32,
    FAB$V_BRO = 6,  ! block and record I/O
    FAB$M_BRO = 64,
    FAB$V_EXE = 7,
    FAB$M_EXE = 128,
    FAB$V_SHRPUT = 0,
    FAB$M_SHRPUT = 1,
    FAB$V_SHRGET = 1,
    FAB$M_SHRGET = 2,
    FAB$V_SHRDEL = 2,
    FAB$M_SHRDEL = 4,
    FAB$V_SHRUPD = 3,
    FAB$M_SHRUPD = 8,
    FAB$V_MSE = 4,  ! several streams
    FAB$M_MSE = 16,
    FAB$V_NIL = 5,  ! no sharing
    FAB$M_NIL = 32,
    FAB$V_UPI = 6,  ! user provided interlock
    FAB$M_UPI = 64,
    FAB$V_ORG = 4,
    FAB$S_ORG = 4,
    FAB$C_SEQ = 0,
    FAB$C_REL = 16,
    FAB$C_IDX = 32,
    FAB$C_HSH = 48,
    FAB$V_FTN = 0,  ! FORTRAN carriage control
    FAB$M_FTN = 1,
    FAB$V_CR = 1,  ! carriage return carriage control
    FAB$M_CR = 2,
    FAB$V_PRN = 2,  ! print carriage control, in the VFC header
    FAB$M_PRN = 4,
    FAB$V_BLK = 3,  ! records don't span blocks
    FAB$M_BLK = 8,
    FAB$V_MSB = 4,  ! VAR sizes most significant byte first
    FAB$M_MSB = 16,
    FAB$C_UDF = 0,  ! undefined: block I/O only
    FAB$C_FIX = 1,
    FAB$C_VAR = 2,
    FAB$C_VFC = 3,  ! VAR with a fixed control header
    FAB$C_STM = 4,  ! stream: CR LF ends a record
    FAB$C_STMLF = 5,
    FAB$C_STMCR = 6,
    FAB$C_MAXRFM = 6;
MACRO
    FAB$B_BID = 0, 0, 8, 0 %,
    FAB$B_BLN = 1, 0, 8, 0 %,
    FAB$W_IFI = 2, 0, 16, 0 %,  ! internal file index, from $OPEN or $CREATE
    FAB$L_FOP = 4, 0, 32, 0 %,  ! file processing options: FAB$M_
    FAB$L_STS = 8, 0, 32, 0 %,  ! the status of the last operation
    FAB$L_STV = 12, 0, 32, 0 %,  ! its secondary status
    FAB$L_ALQ = 16, 0, 32, 0 %,  ! blocks allocated
    FAB$W_DEQ = 20, 0, 16, 0 %,  ! default extension, blocks
    FAB$B_FAC = 22, 0, 8, 0 %,  ! access wanted: FAB$M_PUT to FAB$M_BRO
    FAB$B_SHR = 23, 0, 8, 0 %,  ! access others may have: FAB$M_SHRPUT to FAB$M_NQL
    FAB$L_CTX = 24, 0, 32, 0 %,  ! the caller's
    FAB$B_RTV = 28, 0, 8, 0 %,  ! retrieval window size
    FAB$B_ORG = 29, 0, 8, 0 %,  ! organization: FAB$C_SEQ, REL or IDX
    FAB$B_RAT = 30, 0, 8, 0 %,  ! record attributes: FAB$M_FTN to FAB$M_BLK
    FAB$B_RFM = 31, 0, 8, 0 %,  ! record format: FAB$C_UDF to FAB$C_STMCR
    FAB$B_JOURNAL = 32, 0, 8, 0 %,
    FAB$L_XAB = 36, 0, 32, 0 %,  ! the first XAB, or 0
    FAB$L_NAM = 40, 0, 32, 0 %,  ! a NAM block, or 0
    FAB$L_FNA = 44, 0, 32, 0 %,  ! the file specification
    FAB$L_DNA = 48, 0, 32, 0 %,  ! the default one
    FAB$B_FNS = 52, 0, 8, 0 %,  ! their lengths
    FAB$B_DNS = 53, 0, 8, 0 %,
    FAB$W_MRS = 54, 0, 16, 0 %,  ! maximum record size, 0 for any
    FAB$L_MRN = 56, 0, 32, 0 %,  ! maximum record number of a relative file
    FAB$W_BLS = 60, 0, 16, 0 %,  ! block size, magnetic tape
    FAB$B_BKS = 62, 0, 8, 0 %,  ! bucket size, blocks
    FAB$B_FSZ = 63, 0, 8, 0 %,  ! VFC header size
    FAB$L_DEV = 64, 0, 32, 0 %,  ! device characteristics, from $OPEN
    FAB$L_SDC = 68, 0, 32, 0 %,  ! spooling device's
    FAB$W_GBC = 72, 0, 16, 0 %;  ! global buffer count

! $RABDEF
LITERAL
    RAB$C_BID = 1,
    RAB$C_BLN = 68,
    RAB$K_BLN = 68,
    RAB$V_ASY = 0,  ! asynchronous
    RAB$M_ASY = 1,
    RAB$V_TPT = 1,  ! $PUT truncates the file after the record
    RAB$M_TPT = 2,
    RAB$V_REA = 2,  ! lock for read
    RAB$M_REA = 4,
    RAB$V_RRL = 3,  ! read regardless of lock
    RAB$M_RRL = 8,
    RAB$V_UIF = 4,  ! $PUT of a record that exists updates it
    RAB$M_UIF = 16,
    RAB$V_MAS = 5,  ! mass insert
    RAB$M_MAS = 32,
    RAB$V_FDL = 6,  ! fast delete
    RAB$M_FDL = 64,
    RAB$V_REV = 7,  ! reverse search
    RAB$M_REV = 128,
    RAB$V_EOF = 8,  ! $CONNECT at the end of the file
    RAB$M_EOF = 256,
    RAB$V_RAH = 9,  ! read ahead
    RAB$M_RAH = 512,
    RAB$V_WBH = 10,  ! write behind
    RAB$M_WBH = 1024,
    RAB$V_BIO = 11,  ! block I/O on a FAB$M_BRO file
    RAB$M_BIO = 2048,
    RAB$V_CDK = 12,
    RAB$M_CDK = 4096,
    RAB$V_LOA = 13,  ! load buckets to their fill quantity
    RAB$M_LOA = 8192,
    RAB$V_LIM = 14,
    RAB$M_LIM = 16384,
    RAB$V_LOC = 16,  ! locate mode: RBF may point into RMS's buffer
    RAB$M_LOC = 65536,
    RAB$V_WAT = 17,  ! wait for a locked record
    RAB$M_WAT = 131072,
    RAB$V_ULK = 18,  ! manual unlocking
    RAB$M_ULK = 262144,
    RAB$V_RLK = 19,  ! lock for write, others may read
    RAB$M_RLK = 524288,
    RAB$V_NLK = 20,  ! no lock
    RAB$M_NLK = 1048576,
    RAB$V_KGE = 21,  ! key greater than or equal
    RAB$M_KGE = 2097152,
    RAB$V_EQNXT = 21,
    RAB$M_EQNXT = 2097152,
    RAB$V_KGT = 22,  ! key greater than
    RAB$M_KGT = 4194304,
    RAB$V_NXT = 22,
    RAB$M_NXT = 4194304,
    RAB$V_NXR = 23,  ! nonexistent record
    RAB$M_NXR = 8388608,
    RAB$V_RNE = 24,  ! terminals: no echo
    RAB$M_RNE = 16777216,
    RAB$V_TMO = 25,  ! timeout
    RAB$M_TMO = 33554432,
    RAB$V_CVT = 26,  ! convert to upper case
    RAB$M_CVT = 67108864,
    RAB$V_RNF = 27,  ! no filter
    RAB$M_RNF = 134217728,
    RAB$V_PMT = 30,  ! prompt
    RAB$M_PMT = 1073741824,
    RAB$V_CCO = 31,  ! cancel CTRL/O
    RAB$M_CCO = 2147483648,
    RAB$C_SEQ = 0,  ! sequential
    RAB$C_KEY = 1,  ! by key, or relative record number
    RAB$C_RFA = 2;  ! by record's file address
MACRO
    RAB$B_BID = 0, 0, 8, 0 %,
    RAB$B_BLN = 1, 0, 8, 0 %,
    RAB$W_ISI = 2, 0, 16, 0 %,  ! internal stream index, from $CONNECT
    RAB$L_ROP = 4, 0, 32, 0 %,  ! record processing options: RAB$M_
    RAB$L_STS = 8, 0, 32, 0 %,
    RAB$L_STV = 12, 0, 32, 0 %,
    RAB$W_RFA = 16, 0, 16, 0 %,  ! the record's file address, 6 bytes
    RAB$L_RFA0 = 16, 0, 32, 0 %,  ! its VBN, or a relative record number
    RAB$W_RFA4 = 20, 0, 16, 0 %,  ! its ID, or a sequential record's offset in the block
    RAB$L_CTX = 24, 0, 32, 0 %,  ! the caller's
    RAB$B_RAC = 30, 0, 8, 0 %,  ! record access: RAB$C_SEQ, KEY or RFA
    RAB$B_TMO = 31, 0, 8, 0 %,  ! timeout, seconds
    RAB$W_USZ = 32, 0, 16, 0 %,  ! the user's buffer: its size
    RAB$W_RSZ = 34, 0, 16, 0 %,  ! the record's size
    RAB$L_UBF = 36, 0, 32, 0 %,  ! the user's buffer
    RAB$L_RBF = 40, 0, 32, 0 %,  ! where $GET put the record, what $PUT writes
    RAB$L_RHB = 44, 0, 32, 0 %,  ! a VFC record's fixed control header
    RAB$L_KBF = 48, 0, 32, 0 %,  ! the key, or relative record number
    RAB$L_PBF = 48, 0, 32, 0 %,  ! the prompt, for terminals
    RAB$B_KSZ = 52, 0, 8, 0 %,  ! the key's size
    RAB$B_PSZ = 52, 0, 8, 0 %,
    RAB$B_KRF = 53, 0, 8, 0 %,  ! key of reference
    RAB$B_MBF = 54, 0, 8, 0 %,  ! multibuffer count
    RAB$B_MBC = 55, 0, 8, 0 %,  ! multiblock count
    RAB$L_BKT = 56, 0, 32, 0 %,  ! bucket or VBN, for $READ, $WRITE, $SPACE; a relative file's record number
    RAB$L_FAB = 60, 0, 32, 0 %,  ! the FAB $CONNECT connects to
    RAB$L_XAB = 64, 0, 32, 0 %;

! $NAMDEF
LITERAL
    NAM$C_BID = 2,
    NAM$C_BLN = 96,
    NAM$M_WILDCARD = 256,  ! the specification has a wildcard
    NAM$M_SEARCH_LIST = 2048;  ! its device is a search list
MACRO
    NAM$B_BID = 0, 0, 8, 0 %,
    NAM$B_BLN = 1, 0, 8, 0 %,
    NAM$B_RSS = 2, 0, 8, 0 %,  ! the resultant string area: size
    NAM$B_RSL = 3, 0, 8, 0 %,  ! the string's length
    NAM$L_RSA = 4, 0, 32, 0 %,  ! its address
    NAM$B_ESS = 10, 0, 8, 0 %,  ! the expanded string area: size
    NAM$B_ESL = 11, 0, 8, 0 %,
    NAM$L_ESA = 12, 0, 32, 0 %,
    NAM$W_FID = 36, 0, 16, 0 %,  ! file ID, 3 words
    NAM$W_DID = 42, 0, 16, 0 %,  ! directory ID, 3 words
    NAM$L_WCC = 48, 0, 32, 0 %,  ! $SEARCH's context
    NAM$L_FNB = 52, 0, 32, 0 %,  ! NAM$M_ bits
    NAM$B_DEV = 57, 0, 8, 0 %,  ! the lengths of the string's parts
    NAM$B_DIR = 58, 0, 8, 0 %,
    NAM$B_NAME = 59, 0, 8, 0 %,
    NAM$B_TYPE = 60, 0, 8, 0 %,
    NAM$B_VER = 61, 0, 8, 0 %,
    NAM$L_DEV = 68, 0, 32, 0 %,  ! and their addresses
    NAM$L_DIR = 72, 0, 32, 0 %,
    NAM$L_NAME = 76, 0, 32, 0 %,
    NAM$L_TYPE = 80, 0, 32, 0 %,
    NAM$L_VER = 84, 0, 32, 0 %;

! $DVIDEF
LITERAL
    DVI$_DEVCHAR = 2,  ! the DEV$ bits, a longword
    DVI$_DEVCLASS = 4,  ! DC$_DISK or DC$_TERM
    DVI$_DEVTYPE = 6,  ! a terminal's DT$ type
    DVI$_DEVBUFSIZ = 8,  ! a terminal's width, a disk's block size
    DVI$_DEVDEPEND = 10,  ! a terminal's TT$ bits, its page in the top byte
    DVI$_UNIT = 12,
    DVI$_ERRCNT = 20,
    DVI$_DEVDEPEND2 = 28,  ! a terminal's TT2$ bits
    DVI$_REFCNT = 30,  ! the channels assigned to it
    DVI$_DEVNAM = 32,  ! the device's name, _DDCU:
    DVI$_VOLNAM = 34,  ! the mounted volume's label
    DVI$_FREEBLOCKS = 42,  ! its free blocks
    DVI$_MOUNTCNT = 56,  ! 1 if a volume is mounted, else 0
    DVI$_CLUSTER = 58,  ! its cluster, in blocks
    DVI$_AVL = 98,  ! DEVCHAR's bits, each 1 or 0
    DVI$_MNT = 100,
    DVI$_SWL = 112,
    DVI$_STS = 226,  ! the UCB$ status bits: UCB$M_ONLINE
    DVI$_DEVDEPEND3 = 292;  ! a terminal's TT3$ bits

! $BRKDEF
LITERAL
    BRK$C_DEVICE = 1,  ! the terminal sendto names
    BRK$C_USERNAME = 2,  ! the terminals of the processes logged in as sendto
    BRK$C_ALLUSERS = 3,  ! the terminals of every process logged in
    BRK$C_ALLTERMS = 4,  ! every terminal
    BRK$C_GENERAL = 0,  ! requester IDs, SET BROADCAST's classes
    BRK$C_PHONE = 1,
    BRK$C_MAIL = 2,
    BRK$C_QUEUE = 3,
    BRK$C_SHUTDOWN = 4,
    BRK$C_URGENT = 5,
    BRK$C_DCL = 6,
    BRK$C_OPCOM = 7,
    BRK$C_USER1 = 32,  ! the customer's, to BRK$C_USER1+15
    BRK$V_ERASE_LINES = 0,  ! flags: lines to erase, 8 bits, with SCREEN
    BRK$S_ERASE_LINES = 8,
    BRK$V_SCREEN = 8,  ! a screen formatted write
    BRK$M_SCREEN = 256,
    BRK$V_BOTTOM = 9,  ! with SCREEN, at the bottom
    BRK$M_BOTTOM = 512,
    BRK$V_NOREFRESH = 10,  ! don't write an interrupted read's prompt and line again
    BRK$M_NOREFRESH = 1024,
    BRK$V_CLUSTER = 11,  ! to the cluster's terminals too
    BRK$M_CLUSTER = 2048;

! $DVSDEF
LITERAL
    DVS$_DEVCLASS = 1;  ! only devices of this class, a longword

! $DCDEF
LITERAL
    DC$_DISK = 1,
    DC$_TERM = 66,
    DC$_MAILBOX = 160,
    DT$_TTYUNKN = 0,  ! a terminal's type: unknown
    DT$_VT52 = 64,
    DT$_VT100 = 96,
    DT$_VT102 = 98,
    DT$_VT200_SERIES = 110,
    DT$_VT300_SERIES = 112,
    DT$_VT400_SERIES = 113,
    DT$_VT500_SERIES = 114;

! $TTDEF
LITERAL
    TT$V_PASSALL = 0,  ! no editing and no control keys
    TT$V_NOECHO = 1,  ! reads don't echo
    TT$V_NOTYPEAHD = 2,
    TT$V_ESCAPE = 3,  ! reads end at an escape sequence
    TT$V_HOSTSYNC = 4,
    TT$V_TTSYNC = 5,
    TT$V_LOWER = 7,  ! it has lowercase
    TT$V_MECHTAB = 8,  ! it has tab stops
    TT$V_WRAP = 9,  ! it wraps at its width
    TT$V_SCOPE = 12,  ! a screen, not paper
    TT$V_REMOTE = 13,
    TT$V_EIGHTBIT = 15,
    TT$V_NOBRDCST = 17,  ! no broadcast messages
    TT$V_READSYNC = 18,
    TT$V_MECHFORM = 19,
    TT$V_HALFDUP = 20,
    TT$V_MODEM = 21,
    TT$V_PAGE = 24,  ! the page length, a byte
    TT$C_BAUD_50 = 1,  ! speeds, IO$_SETMODE's p3 and IO$_SENSEMODE's IOSB
    TT$C_BAUD_75 = 2,
    TT$C_BAUD_110 = 3,
    TT$C_BAUD_134 = 4,
    TT$C_BAUD_150 = 5,
    TT$C_BAUD_300 = 6,
    TT$C_BAUD_600 = 7,
    TT$C_BAUD_1200 = 8,
    TT$C_BAUD_1800 = 9,
    TT$C_BAUD_2000 = 10,
    TT$C_BAUD_2400 = 11,
    TT$C_BAUD_3600 = 12,
    TT$C_BAUD_4800 = 13,
    TT$C_BAUD_7200 = 14,
    TT$C_BAUD_9600 = 15,
    TT$C_BAUD_19200 = 16,
    TT$C_BAUD_38400 = 17,
    TT$C_BAUD_57600 = 18,
    TT$C_BAUD_76800 = 19,
    TT$C_BAUD_115200 = 20,
    TT$M_PASSALL = 1,
    TT$M_NOECHO = 2,
    TT$M_ESCAPE = 8,
    TT$M_TTSYNC = 32,
    TT$M_LOWER = 128,
    TT$M_MECHTAB = 256,
    TT$M_WRAP = 512,
    TT$M_SCOPE = 4096,
    TT$M_REMOTE = 8192,  ! a TELNET terminal's
    TT$M_EIGHTBIT = 32768,
    TT$M_NOBRDCST = 131072,
    TT$M_MECHFORM = 524288;

! $TT2DEF
LITERAL
    TT2$V_LOCALECHO = 0,
    TT2$V_AUTOBAUD = 1,
    TT2$V_HANGUP = 2,
    TT2$V_BRDCSTMBX = 4,
    TT2$V_DMA = 6,
    TT2$V_ALTYPEAHD = 7,
    TT2$V_SETSPEED = 8,
    TT2$V_DECCRT4 = 10,
    TT2$V_COMMSYNC = 11,
    TT2$V_EDITING = 12,  ! line editing
    TT2$V_INSERT = 13,  ! in insert mode, not overstrike
    TT2$V_FALLBACK = 14,
    TT2$V_DIALUP = 15,
    TT2$V_SECURE = 16,
    TT2$V_DISCONNECT = 17,
    TT2$V_PASTHRU = 18,  ! reads pass every character, CTRL/C and CTRL/Y too, unedited
    TT2$V_SYSPWD = 19,
    TT2$V_SIXEL = 20,
    TT2$V_DRCS = 21,  ! soft characters
    TT2$V_PRINTER = 22,
    TT2$V_APP_KEYPAD = 23,  ! the keypad in application mode
    TT2$V_ANSICRT = 24,
    TT2$V_REGIS = 25,
    TT2$V_BLOCK = 26,
    TT2$V_AVO = 27,  ! advanced video
    TT2$V_EDIT = 28,  ! edit mode
    TT2$V_DECCRT = 29,
    TT2$V_DECCRT2 = 30,
    TT2$V_DECCRT3 = 31,
    TT2$M_EDITING = 4096,
    TT2$M_INSERT = 8192,
    TT2$M_PASTHRU = 262144,
    TT2$M_ANSICRT = 16777216,
    TT2$M_AVO = 134217728,
    TT2$M_EDIT = 268435456,
    TT2$M_DECCRT = 536870912,
    TT2$M_DECCRT4 = 1024,
    TT2$M_SIXEL = 1048576,
    TT2$M_DRCS = 2097152,
    TT2$M_PRINTER = 4194304,
    TT2$M_REGIS = 33554432,
    TT2$M_BLOCK = 67108864,
    TT2$M_DECCRT2 = 1073741824,
    TT2$M_DECCRT3 = 2147483648;

! $TT3DEF
LITERAL
    TT3$V_POSIX = 0,  ! POSIX style input, not VMS's
    TT3$V_ANSI_COLOR = 1,  ! ANSI colour escape sequences
    TT3$V_DECCRT5 = 2,
    TT3$V_RTS_FLOW = 3,
    TT3$V_BS = 4,  ! CTRL/H deletes, not back to the line's start
    TT3$M_POSIX = 1,
    TT3$M_ANSI_COLOR = 2,
    TT3$M_DECCRT5 = 4,
    TT3$M_RTS_FLOW = 8,
    TT3$M_BS = 16;

! $DEVDEF
LITERAL
    DEV$M_REC = 1,  ! record oriented
    DEV$M_CCL = 2,  ! carriage control
    DEV$M_TRM = 4,  ! a terminal
    DEV$M_DIR = 8,  ! directory structured
    DEV$M_FOD = 16384,  ! files oriented
    DEV$M_SHR = 65536,  ! shareable
    DEV$M_AVL = 262144,  ! available
    DEV$V_AVL = 18,
    DEV$M_MNT = 524288,  ! a volume is mounted
    DEV$V_MNT = 19,
    DEV$M_SWL = 33554432,  ! software write locked: the volume is read only
    DEV$V_SWL = 25,
    DEV$M_IDV = 67108864,  ! input
    DEV$M_ODV = 134217728,  ! output
    DEV$M_RND = 268435456;  ! random access

! $MSGDEF
LITERAL
    MSG$_DELPROC = 3;  ! a process was deleted: its termination message, $ACCDEF

! $ACCDEF
LITERAL
    ACC$K_TERMLEN = 84;  ! the message's size
MACRO
    ACC$W_MSGTYP = 0, 0, 16, 0 %,  ! MSG$_DELPROC
    ACC$L_FINALSTS = 4, 0, 32, 0 %,  ! the status of its last $EXIT, or 0
    ACC$L_PID = 8, 0, 32, 0 %,
    ACC$L_JOBID = 12, 0, 32, 0 %,
    ACC$Q_TERMTIME = 16, 0, 0, 0 %,  ! the system time it was deleted at
    ACC$T_ACCOUNT = 24, 0, 0, 0 %,  ! 8 characters
    ACC$T_USERNAME = 32, 0, 0, 0 %,  ! 12 characters
    ACC$L_CPUTIM = 44, 0, 32, 0 %,
    ACC$L_PAGEFLTS = 48, 0, 32, 0 %,
    ACC$L_PGFLPEAK = 52, 0, 32, 0 %,
    ACC$L_WSPEAK = 56, 0, 32, 0 %,
    ACC$L_BIOCNT = 60, 0, 32, 0 %,
    ACC$L_DIOCNT = 64, 0, 32, 0 %,
    ACC$L_VOLUMES = 68, 0, 32, 0 %,
    ACC$Q_LOGIN = 72, 0, 0, 0 %,
    ACC$L_OWNER = 80, 0, 32, 0 %;  ! its creator's PID

! $MNTDEF
LITERAL
    MNT$_DEVNAM = 1,  ! the device
    MNT$_VOLNAM = 2,  ! the volume's label
    MNT$_OWNER = 13,  ! the volume's owner, a UIC, for this mount
    MNT$_VPROT = 14;  ! and protection, a word

! $INITDEF
LITERAL
    INIT$_OWNER = 1,  ! the volume's owner, a UIC: the caller's by default
    INIT$_VOLPRO = 2;  ! its protection, a word: 0, all may, by default

! $ARMDEF
LITERAL
    ARM$M_READ = 1,
    ARM$M_WRITE = 2,
    ARM$M_EXECUTE = 4,  ! a file's; a directory's: look a name up in it
    ARM$M_DELETE = 8,
    ARM$M_CONTROL = 16,  ! change the protection: the owner's and the system's
    ARM$M_SYSTEM = 32;  ! vaxpunk's: change the owner, the system's only

! $XABDEF
MACRO
    XAB$B_COD = 0, 0, 8, 0 %,  ! its type: XAB$C_KEY, ALL, SUM, FHC, DAT, RDT, PRO
    XAB$B_BLN = 1, 0, 8, 0 %,  ! its size
    XAB$L_NXT = 4, 0, 32, 0 %;  ! the next XAB, or 0

! $XABKEYDEF
LITERAL
    XAB$C_KEY = 21,
    XAB$C_KEYLEN = 100,
    XAB$K_KEYLEN = 100,
    XAB$C_KEYLEN_V2 = 64,
    XAB$C_PRG1 = 1,
    XAB$C_PRG2 = 2,
    XAB$C_PRG3 = 3,
    XAB$V_DUP = 0,  ! duplicates allowed
    XAB$M_DUP = 1,
    XAB$V_CHG = 1,  ! $UPDATE may change it
    XAB$M_CHG = 2,
    XAB$V_NUL = 2,  ! a null key isn't indexed
    XAB$M_NUL = 4,
    XAB$V_IDX_NCMPR = 3,  ! no index compression
    XAB$M_IDX_NCMPR = 8,
    XAB$V_KEY_NCMPR = 6,  ! no key compression
    XAB$M_KEY_NCMPR = 64,
    XAB$V_DAT_NCMPR = 7,  ! no data record compression
    XAB$M_DAT_NCMPR = 128,
    XAB$C_STG = 0,  ! string
    XAB$C_IN2 = 1,  ! signed word
    XAB$C_BN2 = 2,  ! unsigned word
    XAB$C_IN4 = 3,
    XAB$C_BN4 = 4,
    XAB$C_PAC = 5,  ! packed decimal
    XAB$C_IN8 = 6,
    XAB$C_BN8 = 7,
    XAB$C_COL = 8,  ! collated string
    XAB$C_DSTG = 32,  ! descending: 32 more
    XAB$C_DIN2 = 33,
    XAB$C_DBN2 = 34,
    XAB$C_DIN4 = 35,
    XAB$C_DBN4 = 36,
    XAB$C_DPAC = 37,
    XAB$C_DIN8 = 38,
    XAB$C_DBN8 = 39,
    XAB$C_DCOL = 40;
MACRO
    XAB$B_IAN = 8, 0, 8, 0 %,  ! area of the index above level 1
    XAB$B_LAN = 9, 0, 8, 0 %,  ! area of the level 1 index
    XAB$B_DAN = 10, 0, 8, 0 %,  ! area of the data
    XAB$B_LVL = 11, 0, 8, 0 %,  ! root level
    XAB$B_IBS = 12, 0, 8, 0 %,  ! index bucket size
    XAB$B_DBS = 13, 0, 8, 0 %,  ! data bucket size
    XAB$L_RVB = 14, 0, 32, 0 %,  ! root VBN
    XAB$B_FLG = 18, 0, 8, 0 %,  ! XAB$M_ flags
    XAB$B_DTP = 19, 0, 8, 0 %,  ! data type: XAB$C_STG to XAB$C_DBN8
    XAB$B_NSG = 20, 0, 8, 0 %,  ! segments
    XAB$B_NUL = 21, 0, 8, 0 %,  ! null value
    XAB$B_TKS = 22, 0, 8, 0 %,  ! total key size
    XAB$B_REF = 23, 0, 8, 0 %,  ! key of reference
    XAB$W_MRL = 24, 0, 16, 0 %,  ! minimum record length
    XAB$W_IFL = 26, 0, 16, 0 %,  ! index fill, bytes
    XAB$W_DFL = 28, 0, 16, 0 %,  ! data fill, bytes
    XAB$W_POS = 30, 0, 16, 0 %,  ! segment positions, 8 words
    XAB$W_POS0 = 30, 0, 16, 0 %,
    XAB$B_SIZ = 46, 0, 8, 0 %,  ! segment sizes, 8 bytes
    XAB$B_SIZ0 = 46, 0, 8, 0 %,
    XAB$L_KNM = 56, 0, 32, 0 %,  ! the key's name, 32 bytes, or 0
    XAB$L_DVB = 60, 0, 32, 0 %,  ! first data bucket's VBN
    XAB$B_TYP = 64, 0, 8, 0 %,  ! segment types, 8 bytes
    XAB$B_TYP0 = 64, 0, 8, 0 %,
    XAB$B_PROLOG = 72, 0, 8, 0 %;  ! prologue level: XAB$C_PRG3

! $XABALLDEF
LITERAL
    XAB$C_ALL = 20,
    XAB$C_ALLLEN = 32,
    XAB$K_ALLLEN = 32,
    XAB$V_HRD = 0,  ! hard: fail if the placement can't be had
    XAB$M_HRD = 1,
    XAB$V_ONC = 1,  ! on cylinder
    XAB$M_ONC = 2,
    XAB$V_CBT = 5,  ! contiguous best try
    XAB$M_CBT = 32,
    XAB$V_CTG = 7,  ! contiguous
    XAB$M_CTG = 128,
    XAB$C_ANY = 0,
    XAB$C_CYL = 1,
    XAB$C_LBN = 2,
    XAB$C_VBN = 3,
    XAB$C_RFI = 4;
MACRO
    XAB$B_AOP = 8, 0, 8, 0 %,  ! allocation options
    XAB$B_ALN = 9, 0, 8, 0 %,  ! alignment: XAB$C_ANY to XAB$C_RFI
    XAB$W_VOL = 10, 0, 16, 0 %,  ! relative volume
    XAB$L_LOC = 12, 0, 32, 0 %,  ! location
    XAB$L_ALQ = 16, 0, 32, 0 %,  ! blocks
    XAB$W_DEQ = 20, 0, 16, 0 %,  ! default extension
    XAB$B_BKZ = 22, 0, 8, 0 %,  ! bucket size
    XAB$B_AID = 23, 0, 8, 0 %,  ! area number
    XAB$W_RFI = 24, 0, 16, 0 %;  ! related file, 3 words

! $XABSUMDEF
LITERAL
    XAB$C_SUM = 22,
    XAB$C_SUMLEN = 12,
    XAB$K_SUMLEN = 12;
MACRO
    XAB$B_NOA = 8, 0, 8, 0 %,  ! areas
    XAB$B_NOK = 9, 0, 8, 0 %,  ! keys
    XAB$W_PVN = 10, 0, 16, 0 %;  ! prologue version

! $XABFHCDEF
LITERAL
    XAB$C_FHC = 29,
    XAB$C_FHCLEN = 44,
    XAB$K_FHCLEN = 44;
MACRO
    XAB$B_RFO = 8, 0, 8, 0 %,  ! organization and record format, as FAT$B_RTYPE
    XAB$B_ATR = 9, 0, 8, 0 %,  ! record attributes
    XAB$W_LRL = 10, 0, 16, 0 %,  ! longest record
    XAB$L_HBK = 12, 0, 32, 0 %,  ! highest block allocated
    XAB$L_EBK = 16, 0, 32, 0 %,  ! end of file block
    XAB$W_FFB = 20, 0, 16, 0 %,  ! first free byte in it
    XAB$B_HSZ = 23, 0, 8, 0 %,  ! VFC header size
    XAB$W_MRZ = 24, 0, 16, 0 %,  ! maximum record size
    XAB$W_DXQ = 26, 0, 16, 0 %,  ! default extension
    XAB$W_GBC = 28, 0, 16, 0 %,  ! global buffer count
    XAB$W_VERLIMIT = 38, 0, 16, 0 %,  ! version limit
    XAB$L_SBN = 40, 0, 32, 0 %;  ! starting LBN, if contiguous

! $XABDATDEF
LITERAL
    XAB$C_DAT = 18,
    XAB$C_DATLEN = 44,
    XAB$K_DATLEN = 44,
    XAB$C_DATLEN_V2 = 36;
MACRO
    XAB$W_RVN = 8, 0, 16, 0 %,  ! revision number
    XAB$Q_RDT = 12, 0, 0, 0 %,  ! revised
    XAB$Q_CDT = 20, 0, 0, 0 %,  ! created
    XAB$Q_EDT = 28, 0, 0, 0 %,  ! expires
    XAB$Q_BDT = 36, 0, 0, 0 %;  ! backed up

! $XABRDTDEF
LITERAL
    XAB$C_RDT = 30,
    XAB$C_RDTLEN = 20,
    XAB$K_RDTLEN = 20;

! $XABPRODEF
LITERAL
    XAB$C_PRO = 19,  ! XAB$B_COD
    XAB$C_PROLEN = 16,  ! XAB$B_BLN
    XAB$V_NOREAD = 0,  ! a category's bits
    XAB$V_NOWRITE = 1,
    XAB$V_NOEXE = 2,
    XAB$V_NODEL = 3;
MACRO
    XAB$W_PRO = 8, 0, 16, 0 %,  ! the protection: 4 bits each for system, owner, group, world, a set bit denying
    XAB$L_UIC = 12, 0, 32, 0 %;  ! the owner

! $PSLDEF
LITERAL
    PSL$V_IPL = 16,
    PSL$V_PRVMOD = 22,  ! the mode before the last change
    PSL$V_CURMOD = 24,
    PSL$C_KERNEL = 0,
    PSL$C_EXEC = 1,
    PSL$C_SUPER = 2,
    PSL$C_USER = 3;

! $DSCDEF
LITERAL
    DSC$K_S_BLN = 8,
    DSC64$K_S_BLN = 24,
    DSC$K_DTYPE_T = 14,  ! text
    DSC$K_CLASS_S = 1;  ! static: a string where the pointer says
MACRO
    DSC$W_LENGTH = 0, 0, 16, 0 %,
    DSC$B_DTYPE = 2, 0, 8, 0 %,
    DSC$B_CLASS = 3, 0, 8, 0 %,
    DSC$A_POINTER = 4, 0, 32, 1 %,
    DSC64$W_MBO = 0, 0, 16, 0 %,  ! 1
    DSC64$B_DTYPE = 2, 0, 8, 0 %,
    DSC64$B_CLASS = 3, 0, 8, 0 %,
    DSC64$L_MBMO = 4, 0, 32, 0 %,  ! -1
    DSC64$Q_LENGTH = 8, 0, 0, 0 %,
    DSC64$PQ_POINTER = 16, 0, 0, 1 %;

! $ILEDEF
LITERAL
    ILE3$K_LENGTH = 12,
    ILEA_64$K_LENGTH = 24,
    ILEB_64$K_LENGTH = 32;
MACRO
    ILE3$W_LENGTH = 0, 0, 16, 0 %,
    ILE3$W_CODE = 2, 0, 16, 0 %,
    ILE3$PS_BUFADDR = 4, 0, 32, 1 %,
    ILE3$PS_RETLEN_ADDR = 8, 0, 32, 1 %,
    ILEA_64$W_MBO = 0, 0, 16, 0 %,  ! 1
    ILEA_64$W_CODE = 2, 0, 16, 0 %,
    ILEA_64$L_MBMO = 4, 0, 32, 0 %,  ! -1
    ILEA_64$Q_LENGTH = 8, 0, 0, 0 %,
    ILEA_64$PQ_BUFADDR = 16, 0, 0, 1 %,
    ILEB_64$W_MBO = 0, 0, 16, 0 %,
    ILEB_64$W_CODE = 2, 0, 16, 0 %,
    ILEB_64$L_MBMO = 4, 0, 32, 0 %,
    ILEB_64$Q_LENGTH = 8, 0, 0, 0 %,
    ILEB_64$PQ_BUFADDR = 16, 0, 0, 1 %,
    ILEB_64$PQ_RETLEN_ADDR = 24, 0, 0, 1 %;

! $CHFDEF
LITERAL
    CHF$S_MCH = 200;
MACRO
    CHF$L_SIGARGLST = 4, 0, 32, 0 %,  ! a handler's first argument
    CHF$L_MCHARGLST = 8, 0, 32, 0 %,  ! its second
    CHF$L_SIG_ARGS = 0, 0, 32, 0 %,  ! the signal array's count
    CHF$L_SIG_NAME = 4, 0, 32, 0 %,  ! the condition
    CHF$L_SIG_ARG1 = 8, 0, 32, 0 %,
    CHF64$L_SIG_ARGS = 0, 0, 32, 0 %,  ! the 64-bit one's count
    CHF64$L_SIGNAL64 = 4, 0, 32, 0 %,  ! SS$_SIGNAL64
    CHF64$Q_SIG_NAME = 8, 0, 0, 0 %,  ! the condition
    CHF64$Q_SIG_ARG1 = 16, 0, 0, 0 %,
    CHF$IS_MCH_ARGS = 0, 0, 32, 1 %,  ! the quadwords after the first, 24
    CHF$IS_MCH_FLAGS = 4, 0, 32, 1 %,
    CHF$PH_MCH_FRAME = 8, 0, 0, 1 %,  ! the establisher's FP
    CHF$IS_MCH_DEPTH = 16, 0, 32, 1 %,  ! 0 the frame that signaled, 1 its caller
    CHF$PH_MCH_DADDR = 24, 0, 0, 1 %,  ! handler data, 0
    CHF$PH_MCH_ESF_ADDR = 32, 0, 0, 1 %,  ! the exception's frame, 0 for a signal
    CHF$PH_MCH_SIG_ADDR = 40, 0, 0, 1 %,  ! the 32-bit signal array
    CHF$IH_MCH_RETVAL = 48, 0, 0, 1 %,  ! R0
    CHF$IH_MCH_RETVAL2 = 56, 0, 0, 1 %,  ! R1
    CHF$IH_MCH_SAVX2 = 64, 0, 0, 1 %,  ! x2-x17, 8 bytes each
    CHF$PH_MCH_SIG64_ADDR = 192, 0, 0, 1 %,  ! the 64-bit signal array
    CHF$L_MCH_FRAME = 8, 0, 32, 0 %,
    CHF$L_MCH_DEPTH = 16, 0, 32, 0 %,
    CHF$L_MCH_SAVR0 = 48, 0, 32, 0 %,
    CHF$IH_MCH_SAVR0 = 48, 0, 0, 1 %,  ! OpenVMS Alpha's name for it
    CHF$L_MCH_SAVR1 = 56, 0, 32, 0 %;

! $STSDEF
LITERAL
    STS$K_WARNING = 0,
    STS$K_SUCCESS = 1,
    STS$K_ERROR = 2,
    STS$K_INFO = 3,
    STS$K_SEVERE = 4,
    STS$M_SEVERITY = 7,
    STS$V_FAC_NO = 16,  ! the facility, 12 bits: 0 for the system's
    STS$M_INHIB_MSG = 268435456;  ! the message was written already

! $IODEF
LITERAL
    IO$_WRITEPBLK = 11,
    IO$_WRITELBLK = 32,
    IO$_WRITEVBLK = 48,
    IO$_READPBLK = 12,
    IO$_READLBLK = 33,
    IO$_READVBLK = 49,
    IO$_READPROMPT = 55,  ! writes the prompt in p5 and p6 first
    IO$_WRITEOF = 40,  ! a mailbox: an end of file, which a read gets as SS$_ENDOFFILE
    IO$_TTY_PORT = 41,  ! a TCP connection's socket: becomes a TELNET terminal, TNAn
    IO$_SETMODE = 35,  ! a terminal: sets its characteristics, or enables a CTRL/C or CTRL/Y AST
    IO$V_CTRLYAST = 7,  ! SETMODE: the AST is CTRL/Y's
    IO$M_CTRLYAST = 128,
    IO$V_CTRLCAST = 8,  ! SETMODE: the AST is CTRL/C's
    IO$M_CTRLCAST = 256,
    IO$V_NOECHO = 6,  ! a read doesn't echo
    IO$M_NOECHO = 64,
    IO$V_NOFILTR = 9,  ! a read doesn't edit: DEL, CTRL/U are data
    IO$M_NOFILTR = 512,
    IO$V_TIMED = 7,  ! a terminal read ends p3 seconds after the last character
    IO$M_TIMED = 128,
    IO$V_CVTLOW = 8,  ! a terminal read makes lowercase uppercase
    IO$M_CVTLOW = 256,
    IO$V_PURGE = 11,  ! a terminal read empties the type-ahead buffer first
    IO$M_PURGE = 2048,
    IO$V_TRMNOECHO = 12,  ! a terminal read doesn't echo its terminator
    IO$M_TRMNOECHO = 4096,
    IO$V_ESCAPE = 14,  ! a terminal read ends at an escape sequence
    IO$M_ESCAPE = 16384,
    IO$V_TYPEAHDCNT = 6,  ! a terminal's SENSEMODE: what the type-ahead buffer holds
    IO$M_TYPEAHDCNT = 64,
    IO$V_NOFORMAT = 8,  ! a terminal write: as it is, which every write is here
    IO$M_NOFORMAT = 256,
    IO$V_NOW = 6,  ! a mailbox's read doesn't wait for a message
    IO$M_NOW = 64,
    IO$_SETCHAR = 26,  ! a terminal: its permanent characteristics and its current ones; a socket: as IO$_SETMODE
    IO$_SENSECHAR = 27,  ! a terminal: its permanent characteristics; a socket: as IO$_SENSEMODE
    IO$_ACCESS = 50,  ! a disk: looks a file up, reads its attributes; a socket: connects, or accepts
    IO$_MODIFY = 54,  ! a disk: writes a file's attributes
    IO$_DEACCESS = 52,  ! a socket: closes it
    IO$_SENSEMODE = 39,  ! a terminal: its characteristics; a socket: its names, ioctls
    IO$V_ACCEPT = 7,  ! a socket's ACCESS: accepts a connection
    IO$M_ACCEPT = 128,
    IO$V_SHUTDOWN = 7,  ! a socket's DEACCESS: shuts down a direction, p4
    IO$M_SHUTDOWN = 128,
    IO$V_READATTN = 7,  ! a socket's SETMODE: an AST when data comes
    IO$M_READATTN = 128,
    IO$V_WRTATTN = 8,  ! a socket's SETMODE: an AST when it can be written
    IO$M_WRTATTN = 256,
    IO$V_INTERRUPT = 6,  ! a socket's read or write: out-of-band data
    IO$M_INTERRUPT = 64,
    IO$V_OUTBAND = 10,  ! a socket's SETMODE: an AST for out-of-band data
    IO$M_OUTBAND = 1024,
    IO$V_EXTEND = 15,  ! a socket name written is BSD 4.4's
    IO$M_EXTEND = 32768;

! $FIBDEF
LITERAL
    FIB$V_FINDFID = 11,  ! find the entry for FIB$W_FID in the directory, not p2's name
    FIB$M_FINDFID = 2048,
    FIB$C_ACCDATA = 10,  ! the shortest FIB a request takes
    FIB$C_LENGTH = 64;
MACRO
    FIB$L_ACCTL = 0, 0, 32, 0 %,  ! how the file is accessed
    FIB$W_FID = 4, 0, 16, 0 %,  ! the file's ID, 3 words: number, sequence, RVN and its number's high byte
    FIB$W_FID_NUM = 4, 0, 16, 0 %,
    FIB$W_FID_SEQ = 6, 0, 16, 0 %,
    FIB$B_FID_NMX = 9, 0, 8, 0 %,
    FIB$W_DID = 10, 0, 16, 0 %,  ! its directory's ID, 3 words, 0 for none
    FIB$W_DID_NUM = 10, 0, 16, 0 %,
    FIB$W_DID_SEQ = 12, 0, 16, 0 %,
    FIB$B_DID_NMX = 15, 0, 8, 0 %,
    FIB$L_WCC = 16, 0, 32, 0 %,  ! a wildcard lookup's context
    FIB$W_NMCTL = 20, 0, 16, 0 %,  ! FIB$M_ bits: how the name is looked up
    FIB$W_VERLIMIT = 44, 0, 16, 0 %,  ! the name's version limit
    FIB$L_ACLCTX = 48, 0, 32, 0 %,  ! the ACL attributes' position: an ACE's number, from 1
    FIB$L_ACL_STATUS = 52, 0, 32, 0 %;  ! and their status, the first failure's

! $FATDEF
LITERAL
    FAT$V_RTYPE = 0,
    FAT$S_RTYPE = 4,
    FAT$C_UNDEFINED = 0,
    FAT$C_FIXED = 1,
    FAT$C_VARIABLE = 2,
    FAT$C_VFC = 3,
    FAT$C_STREAM = 4,
    FAT$C_STREAMLF = 5,
    FAT$C_STREAMCR = 6,
    FAT$V_FILEORG = 4,
    FAT$S_FILEORG = 4,
    FAT$C_SEQUENTIAL = 0,
    FAT$C_RELATIVE = 1,
    FAT$C_INDEXED = 2,
    FAT$V_FORTRANCC = 0,
    FAT$V_IMPLIEDCC = 1,
    FAT$V_PRINTCC = 2,
    FAT$V_NOSPAN = 3,
    FAT$V_MSBRCW = 4;
MACRO
    FAT$B_RTYPE = 0, 0, 8, 0 %,  ! the record format, FAT$V_RTYPE, and the organization, FAT$V_FILEORG
    FAT$B_RATTRIB = 1, 0, 8, 0 %,  ! the record attributes: carriage control, records across blocks
    FAT$W_RSIZE = 2, 0, 16, 0 %,  ! the record size, a fixed record's, or the longest
    FAT$L_HIBLK = 4, 0, 32, 0 %,  ! the blocks allocated, high word first
    FAT$L_EFBLK = 8, 0, 32, 0 %,  ! the end of file's block, high word first
    FAT$W_FFBYTE = 12, 0, 16, 0 %,  ! and the first free byte in it
    FAT$B_BKTSIZE = 14, 0, 8, 0 %,  ! a bucket's blocks
    FAT$B_VFCSIZE = 15, 0, 8, 0 %,  ! a VFC record's fixed part
    FAT$W_MAXREC = 16, 0, 16, 0 %,  ! the longest record allowed
    FAT$W_DEFEXT = 18, 0, 16, 0 %,  ! the blocks an extend takes by default
    FAT$W_GBC = 20, 0, 16, 0 %,  ! the global buffers
    FAT$W_VERSIONS = 30, 0, 16, 0 %;  ! a directory's default version limit

! $ATRDEF
LITERAL
    ATR$C_UCHAR = 3,  ! the file's characteristics, FH2$L_FILECHAR
    ATR$S_UCHAR = 4,
    ATR$C_RECATTR = 4,  ! its record attributes, 32 bytes, $FATDEF's
    ATR$S_RECATTR = 32,
    ATR$C_HEADER = 10,  ! its header, read only
    ATR$S_HEADER = 512,
    ATR$C_CREDATE = 17,  ! when it was created
    ATR$S_CREDATE = 8,
    ATR$C_REVDATE = 18,  ! when it was last changed
    ATR$S_REVDATE = 8,
    ATR$C_EXPDATE = 19,  ! when it expires, 0 never
    ATR$S_EXPDATE = 8,
    ATR$C_BAKDATE = 20,  ! when it was last backed up
    ATR$S_BAKDATE = 8,
    ATR$C_UIC = 21,  ! its owner
    ATR$S_UIC = 4,
    ATR$C_FPRO = 22,  ! its protection mask
    ATR$S_FPRO = 2,
    ATR$C_UIC_RO = 26,  ! its owner, read only
    ATR$S_UIC_RO = 4,
    ATR$C_ADDACLENT = 31,  ! adds the ACEs at ATR$L_ADDR before the one at FIB$L_ACLCTX
    ATR$S_ADDACLENT = 255,
    ATR$C_DELACLENT = 32,  ! deletes the ACE that matches the one there
    ATR$S_DELACLENT = 255,
    ATR$C_FNDACLENT = 34,  ! puts the position of the ACE that matches it in FIB$L_ACLCTX
    ATR$S_FNDACLENT = 255,
    ATR$C_DELETEACL = 36,  ! deletes the ACL but its PROTECTED ACEs
    ATR$S_DELETEACL = 255,
    ATR$C_READACL = 37,  ! the whole ACEs from FIB$L_ACLCTX's, 0s after
    ATR$S_READACL = 512,
    ATR$C_ACLLENGTH = 38,  ! the ACL's bytes, a longword
    ATR$S_ACLLENGTH = 4,
    ATR$C_READACE = 39,  ! the ACE after FIB$L_ACLCTX's, which it moves on
    ATR$S_READACE = 255,
    ATR$C_DELETE_ALL = 52,  ! deletes the whole ACL
    ATR$S_DELETE_ALL = 255;
MACRO
    ATR$W_SIZE = 0, 0, 16, 0 %,  ! the bytes at ATR$L_ADDR
    ATR$W_TYPE = 2, 0, 16, 0 %,  ! which attribute, ATR$C_
    ATR$L_ADDR = 4, 0, 32, 0 %;

! $ACEDEF
LITERAL
    ACE$C_LENGTH = 8,  ! the bytes before them
    ACE$C_KEYID = 1,  ! an identifier ACE
    ACE$C_DIRDEF = 9,  ! a default protection ACE
    ACE$K_DIRDEF_LENGTH = 24,  ! vaxpunk's name: a default protection ACE's size
    ACE$S_RESERVED = 4,
    ACE$V_DEFAULT = 8,  ! a directory's: given to its new files, not checked
    ACE$V_PROTECTED = 9,  ! kept when the ACL is deleted
    ACE$V_HIDDEN = 10,
    ACE$V_NOPROPAGATE = 11,  ! not given to the file's next version
    ACE$M_DEFAULT = 256,
    ACE$M_PROTECTED = 512,
    ACE$M_HIDDEN = 1024,
    ACE$M_NOPROPAGATE = 2048,
    ACE$M_READ = 1,
    ACE$M_WRITE = 2,
    ACE$M_EXECUTE = 4,
    ACE$M_DELETE = 8,
    ACE$M_CONTROL = 16;
MACRO
    ACE$B_SIZE = 0, 0, 8, 0 %,  ! its bytes
    ACE$B_TYPE = 1, 0, 8, 0 %,  ! ACE$C_
    ACE$W_FLAGS = 2, 0, 16, 0 %,  ! its options, ACE$M_; bits 3:0 the reserved longwords before the identifiers
    ACE$L_ACCESS = 4, 0, 32, 0 %,  ! ACE$M_ READ to CONTROL, the access it grants
    ACE$L_KEY = 8, 0, 32, 0 %,  ! its identifiers
    ACE$L_SYS_PROT = 8, 0, 32, 0 %,  ! its protection, a longword each, a set bit denying
    ACE$L_OWN_PROT = 12, 0, 32, 0 %,
    ACE$L_GRP_PROT = 16, 0, 32, 0 %,
    ACE$L_WOR_PROT = 20, 0, 32, 0 %;

! $UICDEF
LITERAL
    UIC$V_FORMAT = 30,
    UIC$S_FORMAT = 2,
    UIC$K_UIC_FORMAT = 0,
    UIC$K_ID_FORMAT = 2,
    UIC$V_GROUP = 16,
    UIC$S_GROUP = 14,
    UIC$K_WILD_GROUP = 16383,  ! [*,m]
    UIC$K_WILD_MEMBER = 65535,  ! [g,*]
    UIC$K_MAX_UIC = 1073741823,
    UIC$K_MATCH_ALL = -1,  ! *: anyone
    UIC$K_FIRST_ID = 2147549184;  ! the first general identifier AUTHORIZE gives

! $KGBDEF
LITERAL
    KGB$S_NAME = 32,
    KGB$K_HOLD_RECORD = 16,  ! a holder's record's bytes,
    KGB$K_IDENT_RECORD = 48,  ! an identifier's,
    KGB$K_MAINT_RECORD = 64,  ! the maintenance record's
    KGB$K_LEVEL1 = 257,
    KGB$M_RESOURCE = 1,  ! its holders may charge disk space to it
    KGB$M_DYNAMIC = 2,  ! its holders may turn it off and on
    KGB$M_NOACCESS = 4,
    KGB$M_SUBSYSTEM = 8,
    KGB$M_IMPERSONATE = 16,
    KGB$M_HOLDER_HIDDEN = 32,
    KGB$M_NAME_HIDDEN = 64,
    KGB$K_BATCH_ID = 2147483649,  ! the environmental identifiers, by how the process logged in
    KGB$K_DIALUP_ID = 2147483650,
    KGB$K_INTERACTIVE_ID = 2147483651,
    KGB$K_LOCAL_ID = 2147483652,
    KGB$K_NETWORK_ID = 2147483653,
    KGB$K_REMOTE_ID = 2147483654;
MACRO
    KGB$L_IDENTIFIER = 0, 0, 32, 0 %,  ! the identifier: key 0
    KGB$L_ATTRIBUTES = 4, 0, 32, 0 %,  ! KGB$M_
    KGB$Q_HOLDER = 8, 0, 0, 0 %,  ! a holder's UIC and a longword of 0, else 0: key 1
    KGB$T_NAME = 16, 0, 0, 0 %,  ! the identifier's name, padded with blanks: key 2
    KGB$W_LEVEL = 48, 0, 16, 0 %,  ! the maintenance record's: KGB$K_LEVEL1
    KGB$Q_SYS_ID = 52, 0, 0, 0 %,
    KGB$L_NEXT_ID = 60, 0, 32, 0 %;  ! the next general identifier

! $OSSDEF
LITERAL
    OSS$_ACL_ADD_ENTRY = 3,  ! add an ACE, at the context's position
    OSS$_ACL_DELETE_ENTRY = 4,  ! delete the ACE that matches this one
    OSS$_ACL_DELETE = 5,  ! delete the ACL but its PROTECTED ACEs
    OSS$_ACL_DELETE_ALL = 6,  ! delete the whole ACL
    OSS$_ACL_FIND_ENTRY = 7,  ! move the context to the ACE that matches this one
    OSS$_ACL_LENGTH = 11,  ! the ACL's bytes, a longword
    OSS$_ACL_POSITION_TOP = 14,  ! the context to the ACL's top
    OSS$_ACL_POSITION_BOTTOM = 15,  ! and past its end
    OSS$_ACL_READ_ENTRY = 16,  ! the ACE after the context's, which moves on
    OSS$_ACL_READ = 17,  ! the ACEs from the context's
    OSS$_OWNER = 21,  ! the owner, a longword
    OSS$_PROTECTION = 22;  ! the protection mask, a word or a longword

! $INETSYMDEF
LITERAL
    TCPIP$C_ICMP = 1,  ! protocols: a raw socket's
    TCPIP$C_TCP = 6,
    TCPIP$C_UDP = 17,
    TCPIP$C_RAW_IP = 255,
    TCPIP$C_STREAM = 1,  ! socket types
    TCPIP$C_DGRAM = 2,
    TCPIP$C_RAW = 3,
    TCPIP$C_AF_UNSPEC = 0,  ! address families
    TCPIP$C_AF_INET = 2,
    TCPIP$C_INADDR_ANY = 0,
    TCPIP$C_INADDR_BROADCAST = -1,
    TCPIP$C_IPOPT = 0,  ! item list types
    TCPIP$C_SOCKOPT = 1,
    TCPIP$C_IOCTL = 2,
    TCPIP$C_DATA = 3,
    TCPIP$C_SOCK_NAME = 4,
    TCPIP$C_TCPOPT = 6,
    TCPIP$C_REUSEADDR = 4,  ! socket options
    TCPIP$C_KEEPALIVE = 8,
    TCPIP$C_BROADCAST = 32,
    TCPIP$C_LINGER = 128,
    TCPIP$C_MSG_OOB = 1,  ! a read's or a write's p4 flags
    TCPIP$C_MSG_PEEK = 2,
    TCPIP$C_MSG_DONTROUTE = 4,
    TCPIP$C_MSG_NBIO = 64,
    TCPIP$C_DSC_RCV = 0,  ! IO$_DEACCESS!IO$M_SHUTDOWN's p4
    TCPIP$C_DSC_SND = 1,
    TCPIP$C_DSC_ALL = 2;

! $SOCKADDRINDEF
LITERAL
    SIN$K_LENGTH = 16,
    SIN44$K_LENGTH = 16;
MACRO
    SIN$W_FAMILY = 0, 0, 16, 0 %,  ! BSD 4.3's: TCPIP$C_AF_INET
    SIN$W_PORT = 2, 0, 16, 0 %,  ! in network order
    SIN$L_ADDR = 4, 0, 32, 0 %,  ! in network order
    SIN$T_ZERO = 8, 0, 0, 0 %,
    SIN44$B_LEN = 0, 0, 8, 0 %,  ! BSD 4.4's, IO$M_EXTEND's: 16
    SIN44$B_FAMILY = 1, 0, 8, 0 %;

! $IFREQDEF
LITERAL
    IFR$K_LENGTH = 32,
    IFR$M_IFF_UP = 1,
    IFR$M_IFF_BROADCAST = 2,
    IFR$M_IFF_RUNNING = 64;  ! the link is up
MACRO
    IFR$T_NAME = 0, 0, 0, 0 %,  ! the interface's name, WE0, zero filled
    IFR$T_ADDR = 16, 0, 0, 0 %,  ! an address, a SOCKADDRIN
    IFR$W_FLAGS = 16, 0, 16, 0 %;  ! IFR$M_IFF_

! $ORTENTRYDEF
LITERAL
    ORT$K_LENGTH = 48,
    ORT$M_RTF_UP = 1,
    ORT$M_RTF_GATEWAY = 2,
    ORT$M_RTF_HOST = 4;
MACRO
    ORT$L_HASH = 0, 0, 32, 0 %,
    ORT$T_DST = 4, 0, 0, 0 %,  ! the destination, a SOCKADDRIN
    ORT$L_DST_SIN_ADDR = 8, 0, 32, 0 %,
    ORT$T_GATEWAY = 20, 0, 0, 0 %,  ! the gateway, a SOCKADDRIN
    ORT$L_GATEWAY_SIN_ADDR = 24, 0, 32, 0 %,
    ORT$W_FLAGS = 36, 0, 16, 0 %;  ! ORT$M_RTF_

! $SIOCDEF
LITERAL
    SIOCADDRT = -2144308726,  ! adds a route, an ORTENTRY
    SIOCDELRT = -2144308725,  ! deletes one
    SIOCGETRT = -1070566869,  ! the route to ORT$T_DST
    SIOCSIFADDR = -2145359604,  ! sets an interface's address, an IFREQ
    SIOCGIFADDR = -1071617779,
    SIOCSIFFLAGS = -2145359600,
    SIOCGIFFLAGS = -1071617775,
    SIOCGIFNETMASK = -1071617771,
    SIOCSIFNETMASK = -2145359594,
    SIOCSIFDHCP = -2145359489,  ! vaxpunk's, not VMS's: a DHCP server sets the interface
    SIOCGIFDNS = -1071617666;  ! vaxpunk's, not VMS's: the DNS server DHCP gave, 0.0.0.0 if none

! $LNMDEF
LITERAL
    LNM$_INDEX = 1,  ! which equivalence string the items after it are about, a longword
    LNM$_STRING = 2,  ! the equivalence string
    LNM$_TABLE = 4,  ! the name of the table it was found in
    LNM$_LENGTH = 5,  ! the equivalence string's length, a longword
    LNM$_MAX_INDEX = 7,  ! the last equivalence string's index, a longword
    LNM$C_NAMLENGTH = 255,  ! the longest name or equivalence string
    LNM$C_MAXDEPTH = 10;  ! translations of a device name, at most

! $JPIDEF
LITERAL
    JPI$_PRI = 770,  ! the current priority, 0-31, a longword
    JPI$_OWNER = 771,  ! the creator's PID
    JPI$_STS = 773,  ! the PCB$V_ bits
    JPI$_STATE = 774,  ! the scheduling state, SCH$C_
    JPI$_PRIB = 777,  ! the base priority
    JPI$_PID = 793,
    JPI$_PRCNAM = 796,  ! the process's name
    JPI$_USERNAME = 514,  ! its user's name, 12 characters padded with blanks
    JPI$_IMAGNAME = 519,  ! the image it runs, or ran last
    JPI$_UIC = 772,  ! its UIC, a longword
    JPI$_MEM = 775,  ! the UIC's member, and its group
    JPI$_GRP = 776,
    JPI$_PROCPRIV = 516,  ! its privileges, quadwords: permanent,
    JPI$_CURPRIV = 1024,  ! current,
    JPI$_AUTHPRIV = 1042,  ! and authorized
    JPI$_TERMINAL = 797,  ! an interactive process's terminal, DDCU:, else empty
    JPI$_MODE = 802,  ! its mode, a JPI$K_ value
    JPI$_BIOCNT = 783,  ! buffered I/O requests it may still make
    JPI$_BIOLM = 784,  ! and its limit
    JPI$_BYTCNT = 785,  ! bytes of buffered I/O it may still take
    JPI$_BYTLM = 794,  ! and its limit
    JPI$_DIOCNT = 786,  ! direct I/O requests it may still make
    JPI$_DIOLM = 787,  ! and its limit
    JPI$_BUFIO = 1036,  ! buffered I/O requests it has made
    JPI$_DIRIO = 1035,  ! direct I/O requests it has made
    JPI$_RIGHTSLIST = 806,  ! its rights, quadwords: an identifier, its attributes
    JPI$_PROCESS_RIGHTS = 814,  ! its own: its UIC, then those its user holds
    JPI$_SYSTEM_RIGHTS = 815,  ! the system's, which every process holds
    JPI$_RIGHTS_SIZE = 817,  ! the bytes JPI$_RIGHTSLIST returns
    JPI$K_OTHER = 0,  ! a detached process's mode
    JPI$K_NETWORK = 1,
    JPI$K_BATCH = 2,
    JPI$K_INTERACTIVE = 3;  ! one logged in at a terminal

! $SYIDEF
LITERAL
    SYI$_VERSION = 4096,  ! the system's version, 8 characters
    SYI$_MAXPROCESSCNT = 4105,  ! how many processes there may be
    SYI$_QUANTUM = 4137,  ! ticks of 10 ms in a quantum
    SYI$_BOOTTIME = 4286,  ! the system time at boot, a quadword
    SYI$_STARTUP_P1 = 4289,  ! the SYSGEN parameter STARTUP_P1, 4 characters
    SYI$_STARTUP_P2 = 4290,  ! STARTUP_P2
    SYI$_STARTUP_P3 = 4291,  ! STARTUP_P3
    SYI$_STARTUP_P4 = 4292,  ! STARTUP_P4
    SYI$_STARTUP_P5 = 4293,  ! STARTUP_P5
    SYI$_STARTUP_P6 = 4294,  ! STARTUP_P6
    SYI$_STARTUP_P7 = 4295,  ! STARTUP_P7
    SYI$_STARTUP_P8 = 4296,  ! STARTUP_P8
    SYI$_HW_NAME = 4362,  ! the machine's model, a string
    SYI$_ACTIVECPU_CNT = 4382,  ! the CPUs running
    SYI$_AVAILCPU_CNT = 4381,  ! the CPUs there are
    SYI$_PAGE_SIZE = 4452,  ! a page's bytes
    SYI$_MEMSIZE = 4459,  ! the pages of memory the executive has
    SYI$_PRIMARY_CPUID = 4528,  ! the primary CPU's ID
    SYI$_FREE_PAGES = 32512,  ! the free pages
    SYI$_NPAGED_TOTAL = 32513,  ! nonpaged pool's bytes,
    SYI$_NPAGED_FREE = 32514,  ! those free,
    SYI$_NPAGED_INUSE = 32515,  ! those in use,
    SYI$_NPAGED_LARGEST = 32516,  ! and its largest free block's
    SYI$_PROCESS_CNT = 32517;  ! the processes there are

! $UAIDEF
LITERAL
    UAI$C_AD_II = 0,  ! VMS's: a CRC
    UAI$C_PURDY = 1,  ! Purdy's polynomial
    UAI$C_PURDY_V = 2,  ! with the username's length
    UAI$C_PURDY_S = 3,  ! and its blanks
    UAI$C_SHA256 = 128;  ! salted, iterated SHA-256: vaxpunk's

! $PRVDEF
LITERAL
    PRV$V_CMKRNL = 0,  ! $CMKRNL
    PRV$V_CMEXEC = 1,  ! $CMEXEC
    PRV$V_SYSNAM = 2,  ! LNM$SYSTEM_TABLE's names, and volumes mounted for all
    PRV$V_GRPNAM = 3,
    PRV$V_ALLSPOOL = 4,
    PRV$V_DETACH = 5,  ! a process with another UIC
    PRV$V_DIAGNOSE = 6,
    PRV$V_LOG_IO = 7,  ! a disk's blocks by LBN
    PRV$V_GROUP = 8,  ! other processes in its UIC group
    PRV$V_NOACNT = 9,
    PRV$V_PRMCEB = 10,
    PRV$V_PRMMBX = 11,  ! permanent mailboxes
    PRV$V_PSWAPM = 12,
    PRV$V_ALTPRI = 13,
    PRV$V_SETPRV = 14,  ! any privilege, not just the authorized ones
    PRV$V_TMPMBX = 15,  ! temporary mailboxes
    PRV$V_WORLD = 16,  ! any other process
    PRV$V_MOUNT = 17,
    PRV$V_OPER = 18,  ! the operator's: the network's interface
    PRV$V_EXQUOTA = 19,
    PRV$V_NETMBX = 20,
    PRV$V_VOLPRO = 21,  ! INITIALIZE a volume
    PRV$V_PHY_IO = 22,  ! a disk's blocks, physical or logical
    PRV$V_BUGCHK = 23,
    PRV$V_PRMGBL = 24,
    PRV$V_SYSGBL = 25,
    PRV$V_PFNMAP = 26,
    PRV$V_SHMEM = 27,
    PRV$V_SYSPRV = 28,
    PRV$V_BYPASS = 29,
    PRV$V_SYSLCK = 30,
    PRV$V_SHARE = 31,
    PRV$V_UPGRADE = 32,
    PRV$V_DOWNGRADE = 33,
    PRV$V_GRPPRV = 34,
    PRV$V_READALL = 35,
    PRV$V_IMPORT = 36,
    PRV$V_AUDIT = 37,
    PRV$V_SECURITY = 38,
    PRV$K_NUMBER = 39,  ! how many there are
    PRV$M_CMKRNL = 1,
    PRV$M_CMEXEC = 2,
    PRV$M_SYSNAM = 4,
    PRV$M_DETACH = 32,
    PRV$M_LOG_IO = 128,
    PRV$M_GROUP = 256,
    PRV$M_PRMMBX = 2048,
    PRV$M_SETPRV = 16384,
    PRV$M_TMPMBX = 32768,
    PRV$M_WORLD = 65536,
    PRV$M_OPER = 262144,
    PRV$M_VOLPRO = 2097152,
    PRV$M_PHY_IO = 4194304,
    PRV$M_SYSPRV = 268435456,
    PRV$M_BYPASS = 536870912;

! $PRTDEF
LITERAL
    PRT$C_NA = 0,
    PRT$C_KW = 2,
    PRT$C_KR = 3,
    PRT$C_UW = 4,
    PRT$C_EW = 5,
    PRT$C_ERKW = 6,
    PRT$C_ER = 7,
    PRT$C_SW = 8,
    PRT$C_SREW = 9,
    PRT$C_SRKW = 10,
    PRT$C_SR = 11,
    PRT$C_URSW = 12,
    PRT$C_UREW = 13,
    PRT$C_URKW = 14,
    PRT$C_UR = 15;

! $SECDEF
LITERAL
    SEC$M_GBL = 1,  ! a global section, by name
    SEC$M_CRF = 2,  ! copy on reference
    SEC$M_DZRO = 4,  ! demand zero
    SEC$M_WRT = 8,  ! writable
    SEC$M_PERM = 16384,  ! permanent: there until $DGBLSC
    SEC$M_SYSGBL = 32768,  ! a system global section, else the creator's group's
    SEC$M_PFNMAP = 65536,  ! physical pages, by PFN
    SEC$M_EXPREG = 131072,  ! mapped at the region's first free page
    SEC$M_PAGFIL = 524288,  ! a global page file section: no file behind it
    SEC$K_MATALL = 0,  ! any version
    SEC$K_MATEQU = 1,  ! the same version
    SEC$K_MATLEQ = 2;  ! the same major, the section's minor at least the one asked for

! $LCKDEF
LITERAL
    LCK$K_NLMODE = 0,  ! null: holds the name, blocks nothing
    LCK$K_CRMODE = 1,  ! concurrent read
    LCK$K_CWMODE = 2,  ! concurrent write
    LCK$K_PRMODE = 3,  ! protected read
    LCK$K_PWMODE = 4,  ! protected write
    LCK$K_EXMODE = 5,  ! exclusive
    LCK$M_VALBLK = 1,  ! $ENQ: a value block in the status block
    LCK$M_CONVERT = 2,  ! $ENQ: convert the lock in the status block
    LCK$M_NOQUEUE = 4,  ! $ENQ: SS$_NOTQUEUED rather than wait
    LCK$M_SYNCSTS = 8,  ! $ENQ: SS$_SYNCH and no AST if granted at once
    LCK$M_SYSTEM = 16,  ! $ENQ: a name of the system's, not the UIC group's
    LCK$M_DEQALL = 1,  ! $DEQ: all of the caller's locks
    LCK$M_CANCEL = 2,  ! $DEQ: cancel a waiting conversion
    LCK$M_INVVALBLK = 4;  ! $DEQ: mark the value block not valid

! $LKIDEF
LITERAL
    LKI$_PID = 256,  ! the lock's process
    LKI$_STATE = 257,  ! 3 bytes: the mode asked for, the mode granted, the queue
    LKI$_PARENT = 258,  ! the parent lock's ID, or 0
    LKI$_LCKREFCNT = 259,  ! a word: the lock's sublocks
    LKI$_LOCKID = 260,
    LKI$_NAMSPACE = 512,  ! the resource's UIC group, a word, its access mode, a byte, and LKI$M_SYSNAM
    LKI$_RESNAM = 513,  ! the resource's name
    LKI$_VALBLK = 515,  ! its value block, 16 bytes
    LKI$_LCKCOUNT = 517,  ! the locks granted on it
    LKI$_BLOCKEDBY = 518,  ! a list: the locks the lock blocks
    LKI$_BLOCKING = 519,  ! a list: the locks that block it
    LKI$_LOCKS = 520,  ! a list: every lock on the resource
    LKI$M_SYSNAM = 2147483648,  ! LKI$_NAMSPACE: a resource of the system's
    LKI$C_GRANTED = 1,  ! LKI$B_QUEUE's
    LKI$C_CONVERT = 0,
    LKI$C_WAITING = -1,
    LKI$C_LENGTH = 24;
MACRO
    LKI$L_LOCKID = 0, 0, 32, 0 %,  ! a list's entry
    LKI$L_PID = 4, 0, 32, 0 %,
    LKI$L_SYSID = 8, 0, 32, 0 %,  ! 0: one node
    LKI$B_RQMODE = 12, 0, 8, 0 %,
    LKI$B_GRMODE = 13, 0, 8, 0 %,
    LKI$B_QUEUE = 14, 0, 8, 0 %,
    LKI$L_REMLKID = 16, 0, 32, 0 %,  ! 0
    LKI$L_REMSYSID = 20, 0, 32, 0 %;  ! 0

! $LBRDEF
LITERAL
    LBR$C_TYP_UNK = 0,  ! any type, when opening
    LBR$C_TYP_OBJ = 1,  ! object modules, VAX's
    LBR$C_TYP_MLB = 2,  ! macros
    LBR$C_TYP_HLP = 3,  ! help text
    LBR$C_TYP_TXT = 4,  ! text modules
    LBR$C_TYP_SHSTB = 5,  ! shareable image symbol tables, VAX's
    LBR$C_TYP_NCS = 6,  ! character set definitions
    LBR$C_TYP_EOBJ = 7,  ! object modules, Alpha's and vaxpunk's
    LBR$C_TYP_ESHSTB = 8,  ! shareable image symbol tables, Alpha's
    LBR$C_CREATE = 0,  ! LBR$INI_CONTROL's function: make a new library
    LBR$C_READ = 1,  ! read one
    LBR$C_UPDATE = 2,  ! change one
    LBR$C_MAXKEYLEN = 128,  ! the longest key
    LBR$C_MAXCTL = 16;  ! libraries open at once

! $CREDEF
LITERAL
    CRE$C_VMSV2 = 2,
    CRE$C_VMSV3 = 3,
    CRE$M_NOCASECMP = 1,  ! don't upper-case a key looked for
    CRE$M_NOCASENTR = 2,  ! don't upper-case the index's keys to compare
    CRE$M_UPCASNTRY = 4,  ! upper-case a key put in the index
    CRE$C_HLPCASING = 6,  ! help libraries' options
    CRE$C_OBJCASING = 3,  ! object libraries'
    CRE$C_MACTXTCAS = 0,  ! macro and text libraries'
    CRE$K_LENGTH = 80;
MACRO
    CRE$L_TYPE = 0, 0, 32, 0 %,  ! its type, LBR$C_TYP_x
    CRE$L_KEYLEN = 4, 0, 32, 0 %,  ! its keys' longest length
    CRE$L_ALLOC = 8, 0, 32, 0 %,  ! blocks to allocate
    CRE$L_IDXMAX = 12, 0, 32, 0 %,  ! its indexes, 1 to 8
    CRE$L_UHDMAX = 16, 0, 32, 0 %,  ! bytes past a module header's 16 the user keeps there
    CRE$L_ENTALL = 20, 0, 32, 0 %,  ! index entries to allocate
    CRE$L_LUHMAX = 24, 0, 32, 0 %,  ! update history records to keep
    CRE$L_VERTYP = 28, 0, 32, 0 %,  ! format: CRE$C_VMSV3
    CRE$L_IDXOPT = 32, 0, 32, 0 %;  ! index options: CRE$M_x

! $LHIDEF
MACRO
    LHI$L_TYPE = 0, 0, 32, 0 %,  ! LBR$C_TYP_x
    LHI$L_NINDEX = 4, 0, 32, 0 %,  ! indexes
    LHI$L_MAJORID = 8, 0, 32, 0 %,  ! format, 3
    LHI$L_MINORID = 12, 0, 32, 0 %,
    LHI$T_LBRVER = 16, 0, 0, 0 %,  ! who made it, .ASCIC in 32 bytes
    LHI$L_CREDAT = 48, 0, 32, 0 %,  ! when, VMS time
    LHI$L_UPDTIM = 56, 0, 32, 0 %,  ! last changed
    LHI$L_UPDHIS = 64, 0, 32, 0 %,  ! update history's VBN
    LHI$L_FREEVBN = 68, 0, 32, 0 %,  ! first deleted block
    LHI$L_FREEBLK = 72, 0, 32, 0 %,  ! deleted blocks
    LHI$B_NEXTRFA = 76, 0, 8, 0 %,  ! the end of the library, an RFA
    LHI$L_NEXTVBN = 84, 0, 32, 0 %,  ! the next block to allocate
    LHI$L_FREIDXBLK = 88, 0, 32, 0 %,
    LHI$L_FREEIDX = 92, 0, 32, 0 %,
    LHI$L_HIPREAL = 96, 0, 32, 0 %,  ! the last index block
    LHI$L_IDXBLKS = 100, 0, 32, 0 %,  ! index blocks
    LHI$L_IDXCNT = 104, 0, 32, 0 %,  ! index entries, all indexes'
    LHI$L_MODCNT = 108, 0, 32, 0 %,  ! modules: index 1's entries
    LHI$L_MHDUSZ = 112, 0, 32, 0 %,  ! CRE$L_UHDMAX
    LHI$L_MAXLUHREC = 116, 0, 32, 0 %,
    LHI$L_NUMLUHREC = 120, 0, 32, 0 %,
    LHI$L_LIBSTATUS = 124, 0, 32, 0 %;  ! 0 if a write to it failed

! $HLPDEF
LITERAL
    HLP$M_PROMPT = 1,  ! prompt for topics and subtopics
    HLP$M_PROCESS = 2,  ! search HLP$LIBRARY in the process table
    HLP$M_GROUP = 4,  ! the group table
    HLP$M_SYSTEM = 8,  ! the system table
    HLP$M_LIBLIST = 16,  ! list the libraries
    HLP$M_HELP = 32;  ! help on HELP before the topics
