    2	    115     PRINT(ZAP(-1, %X'0F'));
    2	    116     PRINT(ZAPNOT(%X'1122334455667788', %X'81'));
    2	    117     TRAPB();
    2	    118 
    2	    119     ! Longword queues: insert two, remove them.
    2	    120     HEAD[0] = HEAD;
    2	    121     HEAD[1] = HEAD;
    2	    122     PRINT(PAL_INSQUEL(HEAD, E1));
    2	    123     PRINT(PAL_INSQUEL(E1, E2));
    2	    124     PRINT(.HEAD[0] EQL E1);
    2	    125     PRINT(.HEAD[1] EQL E2);
    2	    126     PRINT(PAL_REMQUEL(.HEAD[0]; R));
    2	    127     PRINT(.R EQL E1);
    2	    128     PRINT(PAL_REMQUEL(.HEAD[0]; R));
    2	    129     PRINT(.R EQL E2);
    2	    130     PRINT(PAL_REMQUEL(HEAD; R));
    2	    131     ! A quadword queue.
    2	    132     QHEAD[0] = QHEAD;
    2	    133     QHEAD[1] = QHEAD;
    2	    134     PRINT(PAL_INSQUEQ(QHEAD, QE1));
    2	    135     PRINT(.QHEAD[1] EQL QE1);
    2	    136     PRINT(PAL_REMQUEQ(QE1; R));
    2	    137 
    2	    138         BEGIN
    3	    139         BIND
    3	    140             TAB = CH$TRANSTABLE(REP 32 OF (%C'*'), %C' ', REP 10 OF (%C'*'), %C'+',
    3	    141                 REP 1 OF (%C'*'), %C'-', REP 2 OF (%C'*'), %C'0', %C'1', %C'2', %C'3',
    3	    142                 %C'4', %C'5', %C'6', %C'7', %C'8', %C'9', REP 198 OF (%C'*'));
    3	    143         R = CH$TRANSLATE(TAB, 8, SRC, %C'.', 12, DST);
    3	    144         PRINT(.R - DST);
    3	    145         PRINT(.DST[0] + .DST[1] ^ 8 + .DST[2] ^ 16 + .DST[3] ^ 24 + .DST[4] ^ 32
    3	    146             + .DST[5] ^ 40 + .DST[6] ^ 48 + .DST[7] ^ 56);
    3	    147         PRINT(.DST[8] + .DST[11] ^ 8);
    3	    148         END;
    2	    149     1
    2	    150     END;
    1	    151 
    1	    152 END
    1	    153 ELUDOM


