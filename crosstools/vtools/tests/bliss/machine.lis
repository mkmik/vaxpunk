    1	     58     ADD_ATOMIC_QUAD, ADD_ATOMIC_LONG, AND_ATOMIC_LONG, OR_ATOMIC_QUAD,
    1	     59     TESTBITSS, TESTBITSC, TESTBITCS, TESTBITCC, TESTBITSSI, TESTBITCCI,
    1	     60     ADAWI, UMULH, CMPBGE, ZAP, ZAPNOT, TRAPB,
    1	     61     PAL_INSQUEL, PAL_REMQUEL, PAL_INSQUEQ, PAL_REMQUEQ;
    1	     62 
    1	     63 OWN
    1	     64     Q : INITIAL(10),
    1	     65     L : VECTOR[2, LONG] INITIAL(LONG(-1, 7)),
    1	     66     FLAGS : BITVECTOR[64],
    1	     67     W : VECTOR[4, WORD] INITIAL(WORD(%X'7FFF', 0, %X'FFFF', 5)),
    1	     68     ADD : VECTOR[2, WORD] INITIAL(WORD(1, -2)),
    1	     69     HEAD : VECTOR[2, LONG],
    1	     70     E1 : VECTOR[2, LONG],
    1	     71     E2 : VECTOR[2, LONG],
    1	     72     QHEAD : VECTOR[2] ALIGN(4),
    1	     73     QE1 : VECTOR[2] ALIGN(4),
    1	     74     SRC : VECTOR[8, BYTE] INITIAL(BYTE(%C'+', %C'1', %C'x', %C'2', %C' ', %C'?', %C'-', %C'9')),
    1	     75     DST : VECTOR[12, BYTE];
    1	     76 
    1	     77 ROUTINE MAIN =
    1	     78     BEGIN
    2	     79     LOCAL
    2	     80         OLD,
    2	     81         DONE,
    2	     82         R;
    2	     83     PRINT(ADD_ATOMIC_QUAD(Q, 5; OLD));
    2	     84     PRINT(.OLD);
    2	     85     PRINT(.Q);
    2	     86     PRINT(ADD_ATOMIC_LONG(L, 1, 3; OLD));
    2	     87     PRINT(.OLD);
    2	     88     PRINT(.L[0]);
    2	     89     PRINT(.L[1]);
    2	     90     AND_ATOMIC_LONG(L[1], 3);
    2	     91     PRINT(.L[1]);
    2	     92     OR_ATOMIC_QUAD(Q, %X'100');
    2	     93     PRINT(.Q);
    2	     94 
    2	     95     PRINT(TESTBITSS(FLAGS[3]));
    2	     96     PRINT(TESTBITSS(FLAGS[3]));
    2	     97     PRINT(TESTBITCS(FLAGS[40], 5; DONE));
    2	     98     PRINT(.DONE);
    2	     99     PRINT(TESTBITSC(FLAGS[40]));
    2	    100     PRINT(TESTBITCC(FLAGS[40]));
    2	    101     PRINT(TESTBITSSI(FLAGS[63]));
    2	    102     PRINT(TESTBITCCI(FLAGS[63]));
    2	    103     PRINT(.FLAGS<0, 64>);
    2	    104 
    2	    105     PRINT(ADAWI(ADD[0], W[0]));
    2	    106     PRINT(.W[0]);
    2	    107     PRINT(ADAWI(ADD[0], W[2]));
    2	    108     PRINT(.W[2]);
    2	    109     PRINT(ADAWI(ADD[1], W[3]));
    2	    110     PRINT(.W[3]);
    2	    111 
    2	    112     PRINT(UMULH(-1, 16));
    2	    113     PRINT(UMULH(%X'123456789', %X'1000000000'));
    2	    114     PRINT(CMPBGE(%X'0102030405060708', %X'0807060504030201'));

MACHINE                         Source Listing                  DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 3
