    0	      1 MODULE GSMALL (MAIN = M) =
    0	      2 BEGIN
    1	      3 ! G floating at the bottom of G's range, below the double's normal
    1	      4 ! range: 2**-1024, G's smallest, and 2**-1023, read, written, computed
    1	      5 ! and compared to their lowest bit; half the smallest is zero.
    1	      6 REQUIRE 'PRINT';
 R  1	      7 ! PRINT: prints a value as a signed decimal and as 16 hex digits, on a line
 R  1	      8 ! of its own, through LIB$PUT_OUTPUT. The behaviour tests print with it,
 R  1	      9 ! here under vrun and on OpenVMS for the oracle.
 R  1	     10 
 R  1	     11 EXTERNAL ROUTINE
 R  1	     12     LIB$PUT_OUTPUT;
 R  1	     13 
 R  1	     14 ROUTINE PRINT (V) : NOVALUE =
 R  1	     15     BEGIN
 R  2	     16     LOCAL
 R  2	     17         BUF : VECTOR[48, BYTE],
 R  2	     18         DESC : VECTOR[2, LONG],
 R  2	     19         X,
 R  2	     20         I;
 R  2	     21     I = 48;
 R  2	     22     X = .V;
 R  2	     23     INCR K FROM 1 TO 16 DO
 R  2	     24         BEGIN
 R  3	     25         LOCAL D;
 R  3	     26         D = .X AND 15;
 R  3	     27         I = .I - 1;
 R  3	     28         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     29         X = .X ^ -4 AND %X'0FFFFFFFFFFFFFFF'
 R  3	     30         END;
 R  2	     31     I = .I - 1;
 R  2	     32     BUF[.I] = %C' ';
 R  2	     33     ! Digits from the remainders, negative for a negative value, so that
 R  2	     34     ! the most negative one prints too.
 R  2	     35     X = .V;
 R  2	     36     DO
 R  2	     37         BEGIN
 R  3	     38         LOCAL D;
 R  3	     39         D = .X - (.X / 10) * 10;
 R  3	     40         IF .D LSS 0 THEN D = -.D;
 R  3	     41         I = .I - 1;
 R  3	     42         BUF[.I] = %C'0' + .D;
 R  3	     43         X = .X / 10
 R  3	     44         END
 R  3	     45     UNTIL .X EQL 0;
 R  2	     46     IF .V LSS 0
 R  2	     47     THEN
 R  2	     48         BEGIN
 R  3	     49         I = .I - 1;
 R  3	     50         BUF[.I] = %C'-'
 R  3	     51         END;
 R  2	     52     DESC[0] = 48 - .I + %X'010E0000';
 R  2	     53     DESC[1] = BUF[.I];
 R  2	     54     LIB$PUT_OUTPUT(DESC)
 R  2	     55     END;
    1	     56 BUILTIN
    1	     57     ADDG, SUBG, MULG, DIVG, CMPG, CVTTG;

GSMALL                          Source Listing                  DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 2
                                                                DD-MMM-YYYY HH:MM:SS  SYS$SYSDEVICE:[ORACLE]GSMALL.B64;1

    1	     58 OWN
    1	     59     A, B, C;
    1	     60 ROUTINE M =
    1	     61     BEGIN
    2	     62     B = %G'0';
    2	     63     A = %X'10'; ADDG(A, B, C); PRINT(.C);
    2	     64     A = %X'8018'; ADDG(A, B, C); PRINT(.C);
    2	     65     A = %X'20'; ADDG(A, B, C); PRINT(.C);
    2	     66     A = %X'0001000000000020'; ADDG(A, B, C); PRINT(.C);
    2	     67     A = %X'30'; B = %G'2'; DIVG(B, A, C); PRINT(.C);
    2	     68     B = %G'4'; DIVG(B, A, C); PRINT(.C);
    2	     69     B = %G'8'; DIVG(B, A, C); PRINT(.C);
    2	     70     A = %X'10'; B = %G'4'; MULG(A, B, C); PRINT(.C);
    2	     71     A = %G'1E-307'; B = %G'8'; DIVG(B, A, C); PRINT(.C);
    2	     72     MULG(B, C, A); PRINT(.A);
    2	     73     A = %X'30'; B = %X'0001000000000020'; SUBG(B, A, C); PRINT(.C);
    2	     74     A = %X'0008000000000000'; CVTTG(A, C); PRINT(.C);
    2	     75     A = %X'0001000000000020'; B = %G'1E-300'; DIVG(A, B, C); PRINT(.C);
    2	     76     A = %X'0003000000000020'; B = %X'30'; ADDG(A, B, C); PRINT(.C);
    2	     77     A = %X'0001000000000020'; B = %X'20';
    2	     78     PRINT(CMPG(A, B)); PRINT(CMPG(B, A));
    2	     79     A = %X'FFFFFFFFFFFF002F'; B = %X'30'; PRINT(CMPG(A, B));
    2	     80     1
    2	     81     END;
    1	     82 END
    1	     83 ELUDOM


