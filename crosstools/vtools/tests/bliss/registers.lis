    1	     58     JSB_2 = JSB(REGISTER = 2, REGISTER = 3; REGISTER = 4, REGISTER = 5),
    1	     59     CALL_REG = CALL(STANDARD, REGISTER = 4),
    1	     60     JSB_G = JSB(REGISTER = 2) : GLOBAL(COUNTER = 6),
    1	     61     CALL_G = CALL : GLOBAL(COUNTER = 6);
    1	     62 
    1	     63 FORWARD ROUTINE
    1	     64     DIVIDE : JSB_2 NOVALUE,
    1	     65     SCALE : CALL_REG,
    1	     66     TALLY : JSB_G,
    1	     67     PEEK : CALL_G,
    1	     68     NEST : CALL_G;
    1	     69 
    1	     70 ROUTINE DIVIDE (A, B; Q, R) : JSB_2 NOVALUE =
    1	     71     BEGIN
    2	     72     Q = .A / .B;
    2	     73     R = .A MOD .B
    2	     74     END;
    1	     75 
    1	     76 ROUTINE SCALE (X, F) : CALL_REG =
    1	     77     .X * .F;
    1	     78 
    1	     79 ROUTINE TALLY (N) : JSB_G =
    1	     80     BEGIN
    2	     81     EXTERNAL REGISTER
    2	     82         COUNTER;
    2	     83     COUNTER = .COUNTER + .N;
    2	     84     .COUNTER
    2	     85     END;
    1	     86 
    1	     87 ROUTINE PEEK : CALL_G =
    1	     88     ! COUNTER isn't declared here: the caller's stays as it was.
    1	     89     BEGIN
    2	     90     REGISTER
    2	     91         LOCALREG;
    2	     92     LOCALREG = 99;
    2	     93     .LOCALREG
    2	     94     END;
    1	     95 
    1	     96 ROUTINE NEST : CALL_G =
    1	     97     BEGIN
    2	     98     EXTERNAL REGISTER
    2	     99         COUNTER = 6;
    2	    100     ! Passed on, and changed on the way.
    2	    101     TALLY(1000);
    2	    102     COUNTER = .COUNTER * 2;
    2	    103     .COUNTER
    2	    104     END;
    1	    105 
    1	    106 ROUTINE MAIN =
    1	    107     BEGIN
    2	    108     GLOBAL REGISTER
    2	    109         COUNTER = 6;
    2	    110     LOCAL
    2	    111         QUO,
    2	    112         REM;
    2	    113     DIVIDE(47, 5; QUO, REM);
    2	    114     PRINT(.QUO);

REGISTERS                       Source Listing                  DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 3
