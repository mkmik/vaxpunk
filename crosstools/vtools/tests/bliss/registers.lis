    0	      1 MODULE REGISTERS (MAIN = MAIN) =
    0	      2 BEGIN
    1	      3 ! Register data and the linkages that pass it (LRM 10.7-10.9, 13): register
    1	      4 ! parameters of JSB and CALL linkages, output parameters, and global
    1	      5 ! register segments that callees read and change.
    1	      6 REQUIRE 'PRINT';
 R  1	      7 ! PRINT: prints a value as a signed decimal and as 16 hex digits, on a line
 R  1	      8 ! of its own, through LIB$PUT_OUTPUT. The behaviour tests print with it,
 R  1	      9 ! here under vrun and on OpenVMS for the oracle.
 R  1	     10 
 R  1	     11 EXTERNAL ROUTINE
 R  1	     12     LIB$PUT_OUTPUT;
 R  1	     13 
 R  1	     14 ROUTINE PRINT (V) : NOVALUE =
 R  1	     15     BEGIN
 R  2	     16     LOCAL
 R  2	     17         BUF : VECTOR[48, BYTE],
 R  2	     18         DESC : VECTOR[2, LONG],
 R  2	     19         X,
 R  2	     20         I;
 R  2	     21     I = 48;
 R  2	     22     X = .V;
 R  2	     23     INCR K FROM 1 TO 16 DO
 R  2	     24         BEGIN
 R  3	     25         LOCAL D;
 R  3	     26         D = .X AND 15;
 R  3	     27         I = .I - 1;
 R  3	     28         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     29         X = .X ^ -4 AND %X'0FFFFFFFFFFFFFFF'
 R  3	     30         END;
 R  2	     31     I = .I - 1;
 R  2	     32     BUF[.I] = %C' ';
 R  2	     33     ! Digits from the remainders, negative for a negative value, so that
 R  2	     34     ! the most negative one prints too.
 R  2	     35     X = .V;
 R  2	     36     DO
 R  2	     37         BEGIN
 R  3	     38         LOCAL D;
 R  3	     39         D = .X - (.X / 10) * 10;
 R  3	     40         IF .D LSS 0 THEN D = -.D;
 R  3	     41         I = .I - 1;
 R  3	     42         BUF[.I] = %C'0' + .D;
 R  3	     43         X = .X / 10
 R  3	     44         END
 R  3	     45     UNTIL .X EQL 0;
 R  2	     46     IF .V LSS 0
 R  2	     47     THEN
 R  2	     48         BEGIN
 R  3	     49         I = .I - 1;
 R  3	     50         BUF[.I] = %C'-'
 R  3	     51         END;
 R  2	     52     DESC[0] = 48 - .I + %X'010E0000';
 R  2	     53     DESC[1] = BUF[.I];
 R  2	     54     LIB$PUT_OUTPUT(DESC)
 R  2	     55     END;
    1	     56 
    1	     57 LINKAGE

REGISTERS                       Source Listing                  DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 2
