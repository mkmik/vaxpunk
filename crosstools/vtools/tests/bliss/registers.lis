    2	    115     PRINT(.REM);
    2	    116     DIVIDE(9, 2; , REM);
    2	    117     PRINT(.REM);
    2	    118     PRINT(SCALE(6, 7));
    2	    119     COUNTER = 10;
    2	    120     PRINT(TALLY(5));
    2	    121     PRINT(TALLY(7));
    2	    122     PRINT(.COUNTER);
    2	    123     PRINT(PEEK());
    2	    124     PRINT(.COUNTER);
    2	    125     PRINT(NEST());
    2	    126     PRINT(.COUNTER);
    2	    127     1
    2	    128     END;
    1	    129 
    1	    130 END
    1	    131 ELUDOM


