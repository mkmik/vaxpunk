    1	     58     ADDF, MULF, DIVF, CMPF, CVTFL, CVTLF, CVTRFL,
    1	     59     ADDD, MULD, CMPD, CVTDL, CVTLD,
    1	     60     CVTFD, CVTDF, CVTFG, CVTGF, CVTDG, CVTGD, CVTGT, CVTTG;
    1	     61 OWN
    1	     62     A, B, C, Q;
    1	     63 ROUTINE M =
    1	     64     BEGIN
    2	     65     A = %T'1.5'; B = %T'2.25';
    2	     66     ADDT(A, B, C); PRINT(.C);
    2	     67     SUBT(A, B, C); PRINT(.C);
    2	     68     MULT(A, B, C); PRINT(.C);
    2	     69     DIVT(A, B, C); PRINT(.C);
    2	     70     PRINT(CMPT(A, B)); PRINT(CMPT(B, A)); PRINT(CMPT(A, A));
    2	     71     A = %T'-2.5';
    2	     72     CVTTQ(A, Q); PRINT(.Q);
    2	     73     CVTRTQ(A, Q); PRINT(.Q);
    2	     74     CVTTL(A, Q); PRINT(.Q);
    2	     75     CVTTI(A, Q); PRINT(.Q);
    2	     76     Q = -7; CVTQT(Q, C); PRINT(.C);
    2	     77     CVTLT(Q, C); PRINT(.C);
    2	     78     CVTIT(Q, C); PRINT(.C);
    2	     79     A = %S'1.5'; B = %S'0.25';
    2	     80     ADDS(A, B, C); PRINT(.C);
    2	     81     MULS(A, B, C); PRINT(.C);
    2	     82     PRINT(CMPS(A, B));
    2	     83     CVTST(A, C); PRINT(.C);
    2	     84     A = %T'0.1'; CVTTS(A, C); PRINT(.C);
    2	     85     Q = 3; CVTLS(Q, C); PRINT(.C);
    2	     86     A = %S'2.5'; CVTSL(A, Q); PRINT(.Q);
    2	     87     A = %G'1.5'; B = %G'2.25';
    2	     88     ADDG(A, B, C); PRINT(.C);
    2	     89     SUBG(A, B, C); PRINT(.C);
    2	     90     MULG(A, B, C); PRINT(.C);
    2	     91     DIVG(A, B, C); PRINT(.C);
    2	     92     PRINT(CMPG(A, B));
    2	     93     A = %G'-2.5';
    2	     94     CVTGQ(A, Q); PRINT(.Q);
    2	     95     CVTRGQ(A, Q); PRINT(.Q);
    2	     96     CVTGL(A, Q); PRINT(.Q);
    2	     97     Q = 9; CVTQG(Q, C); PRINT(.C);
    2	     98     CVTLG(Q, C); PRINT(.C);
    2	     99     A = %E'1.5'; B = %E'0.25';
    2	    100     ADDF(A, B, C); PRINT(.C);
    2	    101     MULF(A, B, C); PRINT(.C);
    2	    102     DIVF(A, B, C); PRINT(.C);
    2	    103     PRINT(CMPF(A, B));
    2	    104     A = %E'-3.5'; CVTFL(A, Q); PRINT(.Q);
    2	    105     CVTRFL(A, Q); PRINT(.Q);
    2	    106     Q = 6; CVTLF(Q, C); PRINT(.C);
    2	    107     A = %D'1.5'; B = %D'0.25';
    2	    108     ADDD(A, B, C); PRINT(.C);
    2	    109     MULD(A, B, C); PRINT(.C);
    2	    110     PRINT(CMPD(A, B));
    2	    111     CVTDL(A, Q); PRINT(.Q);
    2	    112     Q = 5; CVTLD(Q, C); PRINT(.C);
    2	    113     A = %E'0.1'; CVTFD(A, C); PRINT(.C); CVTFG(A, C); PRINT(.C);
    2	    114     A = %D'0.1'; CVTDF(A, C); PRINT(.C); CVTDG(A, C); PRINT(.C);

