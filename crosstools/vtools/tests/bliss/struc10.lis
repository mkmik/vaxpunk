    1	     62 ROUTINE M =
    1	     63     BEGIN
    2	     64     PRINT(.V[1]);
    2	     65     PRINT(.V[3]);
    2	     66     PRINT(.B[1, 8, 16, 0]);
		.......................1    
%BLS64-W-TEXT, (1) Word field reference is not Word aligned

    2	     67     PRINT(.B[0, 56, 8, 1]);
    2	     68     BV[69] = 1;
    2	     69     BV[3] = 1;
    2	     70     PRINT(.BV[69]);
    2	     71     PRINT(.BV[3]);
    2	     72     PRINT(.BV[4]);
    2	     73     PRINT(.BV<0, 8>);
    2	     74     BK[1, 2, 0, 16, 0] = 77;
    2	     75     PRINT(.BK[1, 2, 0, 16, 0]);
    2	     76     PRINT(.(BK + 40));
    2	     77     1
    2	     78     END;
    1	     79 END
    1	     80 ELUDOM


