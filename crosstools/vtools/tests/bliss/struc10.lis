    1	     58     BV : BITVECTOR[70],
    1	     59     BK : BLOCKVECTOR[2, 3];
    1	     60 %PRINT(%SIZE(VECTOR[4, WORD]), ' ', %SIZE(BITVECTOR[70]), ' ', %SIZE(BLOCKVECTOR[2, 3, WORD]))

