    1	     58     W : WORD,
    1	     59     WS : WORD SIGNED,
    1	     60     BU : BYTE,
    1	     61     BS : BYTE SIGNED,
    1	     62     Q,
    1	     63     I : LONG INITIAL(-5),
    1	     64     V : VECTOR[4, WORD, SIGNED];
    1	     65 
    1	     66 GLOBAL
    1	     67     G : INITIAL(%X'123456789ABCDEF0');
    1	     68 
    1	     69 ROUTINE MAIN =
    1	     70     BEGIN
    2	     71     LOCAL
    2	     72         X,
    2	     73         Y : BYTE;
    2	     74     L = -1;
    2	     75     LS = -1;
    2	     76     W = -1;
    2	     77     WS = -1;
    2	     78     BU = -1;
    2	     79     BS = -1;
    2	     80     PRINT(.L);
    2	     81     PRINT(.LS);
    2	     82     PRINT(.W);
    2	     83     PRINT(.WS);
    2	     84     PRINT(.BU);
    2	     85     PRINT(.BS);
    2	     86     PRINT(.L<0, 32, 1>);
    2	     87     PRINT(.I);
    2	     88     PRINT(.G<8, 16>);
    2	     89     PRINT(.G<60, 4, 1>);
    2	     90     PRINT(.G<4, 8, 1>);
    2	     91     Q = 0;
    2	     92     Q<4, 8> = %X'FF';
    2	     93     PRINT(.Q);
    2	     94     Q<62, 2> = 1;
    2	     95     PRINT(.Q);
    2	     96     X = 300;
    2	     97     Y = .X;
    2	     98     PRINT(.Y);
    2	     99     X<0, 8> = 1;
    2	    100     PRINT(.X);
    2	    101     PRINT((X = 5) + 1);
    2	    102     PRINT(.X);
    2	    103     INCR K FROM 0 TO 3 DO V[.K] = -.K;
    2	    104     INCR K FROM 0 TO 3 DO PRINT(.V[.K]);
    2	    105     PRINT(.V[1]<0, 8>);
