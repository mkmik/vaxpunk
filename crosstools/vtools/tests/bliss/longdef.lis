		; %PRINT:	sizes 4 12 8 8 8 8
    1	     68 
    1	     69 ROUTINE MAIN =
    1	     70     BEGIN
    2	     71     S = -1;
    2	     72     PRINT(.S);
    2	     73     PRINT(.I);
    2	     74     V[1] = -2;
    2	     75     PRINT(.V[1]);
    2	     76     PRINT(.(V + 4));
    2	     77     BL[1, 0, 32, 1] = -3;
    2	     78     PRINT(.BL[1, 0, 32, 1]);
    2	     79     INCR J FROM 0 TO 8 DO
    2	     80         PRINT(.P[.J]);
    2	     81     1
    2	     82     END;
    1	     83 
    1	     84 END
    1	     85 ELUDOM


