    0	      1 MODULE FV (MAIN = M) =
    0	      2 BEGIN
    1	      3 ! A floating actual passes the value it had when it was evaluated, though
    1	      4 ! a later actual changes it.
    1	      5 REQUIRE 'PRINT';
 R  1	      6 ! PRINT: prints a value as a signed decimal and as 16 hex digits, on a line
 R  1	      7 ! of its own, through LIB$PUT_OUTPUT. The behaviour tests print with it,
 R  1	      8 ! here under vrun and on OpenVMS for the oracle.
 R  1	      9 
 R  1	     10 EXTERNAL ROUTINE
 R  1	     11     LIB$PUT_OUTPUT;
 R  1	     12 
 R  1	     13 ROUTINE PRINT (V) : NOVALUE =
 R  1	     14     BEGIN
 R  2	     15     LOCAL
 R  2	     16         BUF : VECTOR[48, BYTE],
 R  2	     17         DESC : VECTOR[2, LONG],
 R  2	     18         X,
 R  2	     19         I;
 R  2	     20     I = 48;
 R  2	     21     X = .V;
 R  2	     22     INCR K FROM 1 TO 16 DO
 R  2	     23         BEGIN
 R  3	     24         LOCAL D;
 R  3	     25         D = .X AND 15;
 R  3	     26         I = .I - 1;
 R  3	     27         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     28         X = .X ^ -4 AND %X'0FFFFFFFFFFFFFFF'
 R  3	     29         END;
 R  2	     30     I = .I - 1;
 R  2	     31     BUF[.I] = %C' ';
 R  2	     32     ! Digits from the remainders, negative for a negative value, so that
 R  2	     33     ! the most negative one prints too.
 R  2	     34     X = .V;
 R  2	     35     DO
 R  2	     36         BEGIN
 R  3	     37         LOCAL D;
 R  3	     38         D = .X - (.X / 10) * 10;
 R  3	     39         IF .D LSS 0 THEN D = -.D;
 R  3	     40         I = .I - 1;
 R  3	     41         BUF[.I] = %C'0' + .D;
 R  3	     42         X = .X / 10
 R  3	     43         END
 R  3	     44     UNTIL .X EQL 0;
 R  2	     45     IF .V LSS 0
 R  2	     46     THEN
 R  2	     47         BEGIN
 R  3	     48         I = .I - 1;
 R  3	     49         BUF[.I] = %C'-'
 R  3	     50         END;
 R  2	     51     DESC[0] = 48 - .I + %X'010E0000';
 R  2	     52     DESC[1] = BUF[.I];
 R  2	     53     LIB$PUT_OUTPUT(DESC)
 R  2	     54     END;
    1	     55 BUILTIN ACTUALPARAMETER;
    1	     56 OWN
    1	     57     X,

FV                              Source Listing                  DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 2
                                                                DD-MMM-YYYY HH:MM:SS  SYS$SYSDEVICE:[ORACLE]FV.B64;1

    1	     58     Y : LONG;
    1	     59 ROUTINE R1 = ACTUALPARAMETER(1);
    1	     60 ROUTINE R2 = ACTUALPARAMETER(2);
    1	     61 ROUTINE M =
    1	     62     BEGIN
    2	     63     PRINT(R1(%TFLOAT((X = %T'1.0'; X)), %TFLOAT((X = %T'2.0'; X))));
    2	     64     PRINT(R2(%TFLOAT((X = %T'1.0'; X)), %TFLOAT((X = %T'2.0'; X))));
    2	     65     PRINT(R1(%SFLOAT((Y = %S'1.0'; Y)), (Y = %S'2.0'; 0)));
    2	     66     1
    2	     67     END;
    1	     68 END
    1	     69 ELUDOM


