    1	     93 
    1	     94 MACRO
    1	     95     ! %EXITMACRO ends the expansion early.
    1	     96     EARLY (X) = X %IF X GTR 5 %THEN %EXITMACRO %FI + 100 %,
    1	     97     ! Parameters in brackets and angle brackets too.
    1	     98     PAIR (A, B) = (A) * 10 + (B) %,
    1	     99     ! %EXPAND expands PAIR as EXPANDED is defined.
    1	    100     EXPANDED = %EXPAND PAIR(1, 2) %,
		;;    [PAIR]=  ( 1 ) * 10 + ( 2 )
    1	    101     WRAP (A) = A %;
    1	    102 
    1	    103 ROUTINE MAIN =
    1	    104     BEGIN
    2	    105     LOCAL
    2	    106         V;
    2	    107     V = 3;
    2	    108     PRINT(SQUARE(.V + 1));
		;;    [SQUARE]=  ( ( . V + 1 ) * ( . V + 1 ) )
    2	    109     PRINT(TWO + TWO);
		;;    [TWO]=  2
		;;    [TWO]=  2
    2	    110     PRINT(ADD3(1, 2, 3));
		;;    [ADD3]=  ( 1 + 2 + 3 )
    2	    111     PRINT(ADD3(1, 2));
