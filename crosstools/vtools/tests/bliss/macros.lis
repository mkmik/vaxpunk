    0	      1 MODULE MACROS (MAIN = MAIN) =
    0	      2 BEGIN
    1	      3 ! Macros: simple, keyword, conditional (recursive) and iterative, with
    1	      4 ! %REMAINING, %LENGTH, %COUNT, the quote functions and nested definitions.
    1	      5 REQUIRE 'PRINT';
 R  1	      6 ! PRINT: prints a value as a signed decimal and as 16 hex digits, on a line
 R  1	      7 ! of its own, through LIB$PUT_OUTPUT. The behaviour tests print with it,
 R  1	      8 ! here under vrun and on OpenVMS for the oracle.
 R  1	      9 
 R  1	     10 EXTERNAL ROUTINE
 R  1	     11     LIB$PUT_OUTPUT;
 R  1	     12 
 R  1	     13 ROUTINE PRINT (V) : NOVALUE =
 R  1	     14     BEGIN
 R  2	     15     LOCAL
 R  2	     16         BUF : VECTOR[48, BYTE],
 R  2	     17         DESC : VECTOR[2, LONG],
 R  2	     18         X,
 R  2	     19         I;
 R  2	     20     I = 48;
 R  2	     21     X = .V;
 R  2	     22     INCR K FROM 1 TO 16 DO
 R  2	     23         BEGIN
 R  3	     24         LOCAL D;
 R  3	     25         D = .X AND 15;
 R  3	     26         I = .I - 1;
 R  3	     27         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     28         X = .X ^ -4 AND %X'0FFFFFFFFFFFFFFF'
 R  3	     29         END;
 R  2	     30     I = .I - 1;
 R  2	     31     BUF[.I] = %C' ';
 R  2	     32     ! Digits from the remainders, negative for a negative value, so that
 R  2	     33     ! the most negative one prints too.
 R  2	     34     X = .V;
 R  2	     35     DO
 R  2	     36         BEGIN
 R  3	     37         LOCAL D;
 R  3	     38         D = .X - (.X / 10) * 10;
 R  3	     39         IF .D LSS 0 THEN D = -.D;
 R  3	     40         I = .I - 1;
 R  3	     41         BUF[.I] = %C'0' + .D;
 R  3	     42         X = .X / 10
 R  3	     43         END
 R  3	     44     UNTIL .X EQL 0;
 R  2	     45     IF .V LSS 0
 R  2	     46     THEN
 R  2	     47         BEGIN
 R  3	     48         I = .I - 1;
 R  3	     49         BUF[.I] = %C'-'
 R  3	     50         END;
 R  2	     51     DESC[0] = 48 - .I + %X'010E0000';
 R  2	     52     DESC[1] = BUF[.I];
 R  2	     53     LIB$PUT_OUTPUT(DESC)
 R  2	     54     END;
    1	     55 
    1	     56 MACRO
    1	     57     SQUARE (X) = ((X) * (X)) %,

MACROS                          Source Listing                   DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 2
                                                                 DD-MMM-YYYY HH:MM:SS  SYS$SYSDEVICE:[ORACLE]MACROS.B64;1

    1	     58     TWO = 2 %,
    1	     59     ADD3 (A, B, C) = (A + B + C) %,
    1	     60     FIRST (A) = A %,
    1	     61     SECOND (A, B) = B %;
    1	     62 
    1	     63 KEYWORDMACRO
    1	     64     RANGE (LO = 1, HI = 10, STEP) = ((HI) - (LO) + 0 STEP) %,
    1	     65     KW (A = 1, B) = A B %;
    1	     66 
    1	     67 MACRO
    1	     68     ! Conditional: the sum of its parameters, recursively.
    1	     69     SUM (A) [] = (A + SUM(%REMAINING) + 0) %,
    1	     70     ! Iterative, with a fixed formal.
    1	     71     SCALED (K) [V] = (K) * (V) %,
    1	     72     ! The number of parameters, and the iteration count.
    1	     73     NPARAMS [] = %LENGTH %,
    1	     74     COUNTS [A] = %COUNT %,
    1	     75     DEPTH (A) [] = %IF %NULL(%REMAINING) %THEN %COUNT %ELSE DEPTH(%REMAINING) %FI %,
    1	     76     IT [A] = A %,
    1	     77     ! %EXITITERATION skips the rest of one copy, keeping its separator.
    1	     78     SKIP2 [A] = %IF A EQL 2 %THEN %EXITITERATION %FI A %,
    1	     79     ! After OF, the copies are case lines between SET and TES.
    1	     80     ARMS [V] = [V]: V * 10 %;
    1	     81 
    1	     82 LITERAL
    1	     83     MARK = 4;
    1	     84 
    1	     85 MACRO
    1	     86     BOTH = MARK + %UNQUOTE MARK %;
    1	     87 
    1	     88 ! A macro that defines a macro.
    1	     89 MACRO
    1	     90     DEFINE (NAME, VALUE) = MACRO NAME = VALUE %QUOTE % %;
    1	     91 
    1	     92 DEFINE(SEVEN, 7);

MACROS                          Source Listing                   DD-MMM-YYYY HH:MM:SS  BLISS-64E V1.11-007-48G4L         Page 3
