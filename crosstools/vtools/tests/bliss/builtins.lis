    2	    115     PRINT(ABS(-.X));
    2	    116     PRINT(ABS(.X));
    2	    117     PRINT(SIGN(-.X) * 100 + SIGN(0) * 10 + SIGN(.X));
    2	    118     PRINT(SLL(-1, 60));
    2	    119     PRINT(SRL(-1, 60));
    2	    120     PRINT(SRA(-16, 2));
    2	    121     PRINT(ROT(%X'8000000000000001', 4));
    2	    122     PRINT(ROT(%X'1234', 60));
    2	    123     PRINT(DEREF(%REF(.X + 1)));
    2	    124     1
    2	    125     END;
    1	    126 
    1	    127 END
    1	    128 ELUDOM


