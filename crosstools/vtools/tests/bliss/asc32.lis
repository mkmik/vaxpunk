    0	      1 MODULE ASC32 (MAIN = M) =
    0	      2 BEGIN
    1	      3 ! Probe 17: %ASCID under /A32, its first four bytes.
    1	      4 REQUIRE 'PRINT32';
 R  1	      5 ! PRINT for BLISS-32 programs: prints a value as a signed decimal and as 8
 R  1	      6 ! hex digits, on a line of its own, through LIB$PUT_OUTPUT, under vrun and
 R  1	      7 ! on OpenVMS for the oracle.
 R  1	      8 
 R  1	      9 EXTERNAL ROUTINE
 R  1	     10     LIB$PUT_OUTPUT;
 R  1	     11 
 R  1	     12 ROUTINE PRINT (V) : NOVALUE =
 R  1	     13     BEGIN
 R  2	     14     LOCAL
 R  2	     15         BUF : VECTOR[32, BYTE],
 R  2	     16         DESC : VECTOR[2],
 R  2	     17         X,
 R  2	     18         I;
 R  2	     19     I = 32;
 R  2	     20     X = .V;
 R  2	     21     INCR K FROM 1 TO 8 DO
 R  2	     22         BEGIN
 R  3	     23         LOCAL D;
 R  3	     24         D = .X AND 15;
 R  3	     25         I = .I - 1;
 R  3	     26         BUF[.I] = (IF .D LSS 10 THEN %C'0' + .D ELSE %C'A' + .D - 10);
 R  3	     27         X = .X ^ -4 AND %X'0FFFFFFF'
 R  3	     28         END;
 R  2	     29     I = .I - 1;
 R  2	     30     BUF[.I] = %C' ';
 R  2	     31     X = .V;
 R  2	     32     DO
 R  2	     33         BEGIN
 R  3	     34         LOCAL D;
 R  3	     35         D = .X - (.X / 10) * 10;
 R  3	     36         IF .D LSS 0 THEN D = -.D;
 R  3	     37         I = .I - 1;
 R  3	     38         BUF[.I] = %C'0' + .D;
 R  3	     39         X = .X / 10
 R  3	     40         END
 R  3	     41     UNTIL .X EQL 0;
 R  2	     42     IF .V LSS 0
 R  2	     43     THEN
 R  2	     44         BEGIN
 R  3	     45         I = .I - 1;
 R  3	     46         BUF[.I] = %C'-'
 R  3	     47         END;
 R  2	     48     DESC[0] = 32 - .I + %X'010E0000';
 R  2	     49     DESC[1] = BUF[.I];
 R  2	     50     LIB$PUT_OUTPUT(DESC)
 R  2	     51     END;
    1	     52 BIND D = %ASCID 'HELLO' : VECTOR[, BYTE];
    1	     53 ROUTINE M =
    1	     54     BEGIN
    2	     55     INCR I FROM 0 TO 3 DO
    2	     56         PRINT(.D[.I]);
    2	     57     1

