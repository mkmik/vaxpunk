MODULE SWIT (MAIN = M, NOSAFE, ZIP, LIST(NOEXPAND)) =
BEGIN
! What %SWITCHES says after the module head and SWITCHES set switches.
%PRINT('head ', %SWITCHES(SAFE), %SWITCHES(ZIP), %SWITCHES(ERRS), %SWITCHES(OPTIMIZE))
%PRINT('align ', %SWITCHES(CHECK_ALIGNMENT), %SWITCHES(OVERFLOW), %SWITCHES(QUAD_LITERALS))
SWITCHES SAFE, NOZIP, NOCHECK_ALIGNMENT;
%PRINT('decl ', %SWITCHES(SAFE), %SWITCHES(ZIP), %SWITCHES(CHECK_ALIGNMENT))
ROUTINE M =
    BEGIN
    SWITCHES NOSAFE;
    %PRINT('block ', %SWITCHES(SAFE))
    0
    END;
%PRINT('after ', %SWITCHES(SAFE))
END
ELUDOM
