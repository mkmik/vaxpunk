! BLISS: /SOURCE_LIST=(TRACE_MACROS,NOREQUIRE)
MODULE LSTTRACE (MAIN = M) =
BEGIN
! The listing with /SOURCE_LIST=(TRACE_MACROS,NOREQUIRE).
REQUIRE 'PRINT';
LIBRARY 'LA';
MACRO
    TWICE(X) = X + X %,
    SUM[A] = + A %;
ROUTINE M =
    BEGIN
    LOCAL Y;
    Y = TWICE(3) SUM(1, 2);
    PRINT(.Y);
    1
    END;
END
ELUDOM
