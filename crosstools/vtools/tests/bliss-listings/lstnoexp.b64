! BLISS: /SOURCE_LIST=(NOEXPAND_MACROS,REQUIRE)
MODULE LSTNOEXP (MAIN = M) =
BEGIN
! The listing with /SOURCE_LIST=(NOEXPAND_MACROS,REQUIRE).
REQUIRE 'PRINT';
LIBRARY 'LA';
MACRO
    TWICE(X) = X + X %,
    SUM[A] = + A %;
ROUTINE M =
    BEGIN
    LOCAL Y;
    Y = TWICE(3) SUM(1, 2);
    PRINT(.Y);
    1
    END;
END
ELUDOM
