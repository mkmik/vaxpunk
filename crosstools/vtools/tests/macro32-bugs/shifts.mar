        .TITLE  SHIFTS  Shift counts of 32 and more in a register (PRD-0003 item 17)
        .LIBRARY "vrun.mlb"

; ASHL by 32 or more clears the result, left; right, it leaves the sign.
; ASHQ the same from 64. A failed check returns 2 * N.

        .MACRO  EXPECT  COND, N, ?OK
        B'COND  OK
        MOVL    #<N * 2>, R0
        RET
OK:
        .ENDM   EXPECT

        .PSECT  CODE, EXE, LONG
        .ENTRY  SHIFTS, ^M<R2, R3, R4, R5>
        MOVL    #32, R1
        ASHL    R1, #1, R2
        EXPECT  EQL, 1
        MOVL    #40, R1
        ASHL    R1, #1, R2
        EXPECT  EQL, 2
        MOVL    #-32, R1
        ASHL    R1, #-8, R2
        CMPL    R2, #-1
        EXPECT  EQL, 3
        ASHL    R1, #8, R2
        EXPECT  EQL, 4
        MOVL    #64, R1
        ASHQ    R1, #1, R2
        TSTL    R2
        EXPECT  EQL, 5
        TSTL    R3
        EXPECT  EQL, 6
        MOVL    #-64, R1
        MOVQ    #-8, R4
        ASHQ    R1, R4, R2
        CMPL    R2, #-1
        EXPECT  EQL, 7
        CMPL    R3, #-1
        EXPECT  EQL, 8
        $PUT    "shifts ok"<10>
        MOVL    #1, R0
        RET

        .END    SHIFTS
