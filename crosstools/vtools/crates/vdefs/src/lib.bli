
! The VAX built-ins BLISS-32 had and BLISS on Alpha dropped, as macros,
! so VAX BLISS-32 code compiles unchanged: written for vaxpunk after UM
! chapter 4; vdefs copies this file in after LIB's definitions.
!
! Such code declares the built-in, BUILTIN FFS, then calls it, FFS(...).
! FFS is a macro without parameters for both: in the BUILTIN declaration
! it ends the list with BARRIER, marks the block as having declared FFS
! with a literal, and starts a new list; once the block has the mark, it
! is $FFS, the macro that does the work. As on the VAX, the parameters
! are addresses, of a word for a length or of a byte for a character
! (%REF(n) gives one), and the output parameters after a semicolon are
! not taken. The decimal string built-ins and CRC's are left out; BUGW
! and BUGL wait for the PAL call they need, and CALLG, EMUL and EDIV
! under BLISS-32 for LIB$CALLG, LIB$EMUL and LIB$EDIV.

MACRO
    ! In a BUILTIN declaration: the mark that the block declared it, and
    ! the built-ins it is made of. A block inside one that declared X
    ! can't declare it again, as with DEC's LIB (oracle NESTB): it
    ! needn't, X is declared there already.
    $$VAX_BUILTIN(MARK)[] =
        BARRIER; LITERAL MARK = 1; BUILTIN %REMAINING %IF %LENGTH GTR 1 %THEN , %FI BARRIER %;

MACRO
    FFS = %IF %DECLARED($$VAX_FFS) %THEN $FFS %ELSE $$VAX_BUILTIN($$VAX_FFS) %FI %,
    FFC = %IF %DECLARED($$VAX_FFC) %THEN $FFC %ELSE $$VAX_BUILTIN($$VAX_FFC) %FI %,
    LOCC = %IF %DECLARED($$VAX_LOCC) %THEN $LOCC %ELSE $$VAX_BUILTIN($$VAX_LOCC) %FI %,
    SKPC = %IF %DECLARED($$VAX_SKPC) %THEN $SKPC %ELSE $$VAX_BUILTIN($$VAX_SKPC) %FI %,
    SCANC = %IF %DECLARED($$VAX_SCANC) %THEN $SCANC %ELSE $$VAX_BUILTIN($$VAX_SCANC) %FI %,
    SPANC = %IF %DECLARED($$VAX_SPANC) %THEN $SPANC %ELSE $$VAX_BUILTIN($$VAX_SPANC) %FI %,
    MATCHC = %IF %DECLARED($$VAX_MATCHC) %THEN $MATCHC %ELSE $$VAX_BUILTIN($$VAX_MATCHC) %FI %,
    MOVC3 = %IF %DECLARED($$VAX_MOVC3) %THEN $MOVC3 %ELSE $$VAX_BUILTIN($$VAX_MOVC3) %FI %,
    MOVC5 = %IF %DECLARED($$VAX_MOVC5) %THEN $MOVC5 %ELSE $$VAX_BUILTIN($$VAX_MOVC5) %FI %,
    MOVTC = %IF %DECLARED($$VAX_MOVTC) %THEN $MOVTC %ELSE $$VAX_BUILTIN($$VAX_MOVTC) %FI %,
    MOVTUC = %IF %DECLARED($$VAX_MOVTUC) %THEN $MOVTUC %ELSE $$VAX_BUILTIN($$VAX_MOVTUC) %FI %,
    CMPC3 = %IF %DECLARED($$VAX_CMPC3) %THEN $CMPC3 %ELSE $$VAX_BUILTIN($$VAX_CMPC3) %FI %,
    CMPC5 = %IF %DECLARED($$VAX_CMPC5) %THEN $CMPC5 %ELSE $$VAX_BUILTIN($$VAX_CMPC5) %FI %,
    EMUL = %IF %DECLARED($$VAX_EMUL) %THEN $EMUL %ELSE $$VAX_BUILTIN($$VAX_EMUL) %FI %,
    EDIV = %IF %DECLARED($$VAX_EDIV) %THEN $EDIV %ELSE $$VAX_BUILTIN($$VAX_EDIV) %FI %,
    ASHQ = %IF %DECLARED($$VAX_ASHQ) %THEN $ASHQ %ELSE $$VAX_BUILTIN($$VAX_ASHQ) %FI %,
    ADDM = %IF %DECLARED($$VAX_ADDM) %THEN $ADDM %ELSE $$VAX_BUILTIN($$VAX_ADDM) %FI %,
    SUBM = %IF %DECLARED($$VAX_SUBM) %THEN $SUBM %ELSE $$VAX_BUILTIN($$VAX_SUBM) %FI %,
    CMPM = %IF %DECLARED($$VAX_CMPM) %THEN $CMPM %ELSE $$VAX_BUILTIN($$VAX_CMPM) %FI %,
    INDEX = %IF %DECLARED($$VAX_INDEX) %THEN $INDEX %ELSE $$VAX_BUILTIN($$VAX_INDEX) %FI %,
    INSQUE = %IF %DECLARED($$VAX_INSQUE) %THEN $INSQUE %ELSE $$VAX_BUILTIN($$VAX_INSQUE, PAL_INSQUEL) %FI %,
    REMQUE = %IF %DECLARED($$VAX_REMQUE) %THEN $REMQUE %ELSE $$VAX_BUILTIN($$VAX_REMQUE, PAL_REMQUEL) %FI %,
    INSQHI = %IF %DECLARED($$VAX_INSQHI) %THEN $INSQHI %ELSE $$VAX_BUILTIN($$VAX_INSQHI, PAL_INSQHIL) %FI %,
    INSQTI = %IF %DECLARED($$VAX_INSQTI) %THEN $INSQTI %ELSE $$VAX_BUILTIN($$VAX_INSQTI, PAL_INSQTIL) %FI %,
    REMQHI = %IF %DECLARED($$VAX_REMQHI) %THEN $REMQHI %ELSE $$VAX_BUILTIN($$VAX_REMQHI, PAL_REMQHIL) %FI %,
    REMQTI = %IF %DECLARED($$VAX_REMQTI) %THEN $REMQTI %ELSE $$VAX_BUILTIN($$VAX_REMQTI, PAL_REMQTIL) %FI %,
    PROBER = %IF %DECLARED($$VAX_PROBER) %THEN $PROBER %ELSE $$VAX_BUILTIN($$VAX_PROBER, PAL_PROBER) %FI %,
    PROBEW = %IF %DECLARED($$VAX_PROBEW) %THEN $PROBEW %ELSE $$VAX_BUILTIN($$VAX_PROBEW, PAL_PROBEW) %FI %,
    MTPR = %IF %DECLARED($$VAX_MTPR) %THEN $MTPR %ELSE $$VAX_BUILTIN($$VAX_MTPR, PAL_MTPR_IPL, PAL_MTPR_SIRR, PAL_MTPR_SCBB) %FI %,
    MFPR = %IF %DECLARED($$VAX_MFPR) %THEN $MFPR %ELSE $$VAX_BUILTIN($$VAX_MFPR, PAL_MFPR_IPL, PAL_MFPR_SISR, PAL_MFPR_SCBB, PAL_MFPR_PCBB) %FI %,
    MOVPSL = %IF %DECLARED($$VAX_MOVPSL) %THEN $MOVPSL %ELSE $$VAX_BUILTIN($$VAX_MOVPSL, PAL_RD_PS) %FI %,
    BISPSW = %IF %DECLARED($$VAX_BISPSW) %THEN $BISPSW %ELSE $$VAX_BUILTIN($$VAX_BISPSW) %FI %,
    BICPSW = %IF %DECLARED($$VAX_BICPSW) %THEN $BICPSW %ELSE $$VAX_BUILTIN($$VAX_BICPSW) %FI %,
    HALT = %IF %DECLARED($$VAX_HALT) %THEN $HALT %ELSE $$VAX_BUILTIN($$VAX_HALT, PAL_HALT) %FI %,
    BPT = %IF %DECLARED($$VAX_BPT) %THEN $BPT %ELSE $$VAX_BUILTIN($$VAX_BPT, PAL_BPT) %FI %,
    NOP = %IF %DECLARED($$VAX_NOP) %THEN $NOP %ELSE $$VAX_BUILTIN($$VAX_NOP) %FI %,
    BUGW = %IF %DECLARED($$VAX_BUGW) %THEN $BUGW %ELSE $$VAX_BUILTIN($$VAX_BUGW, PAL_BUGCHK) %FI %,
    BUGL = %IF %DECLARED($$VAX_BUGL) %THEN $BUGL %ELSE $$VAX_BUILTIN($$VAX_BUGL, PAL_BUGCHK) %FI %,
    CHME = %IF %DECLARED($$VAX_CHME) %THEN $CHME %ELSE $$VAX_BUILTIN($$VAX_CHME, PAL_CHME) %FI %,
    CHMK = %IF %DECLARED($$VAX_CHMK) %THEN $CHMK %ELSE $$VAX_BUILTIN($$VAX_CHMK, PAL_CHMK) %FI %,
    CHMS = %IF %DECLARED($$VAX_CHMS) %THEN $CHMS %ELSE $$VAX_BUILTIN($$VAX_CHMS, PAL_CHMS) %FI %,
    CHMU = %IF %DECLARED($$VAX_CHMU) %THEN $CHMU %ELSE $$VAX_BUILTIN($$VAX_CHMU, PAL_CHMU) %FI %,
    CALLG = %IF %DECLARED($$VAX_CALLG) %THEN $CALLG %ELSE $$VAX_BUILTIN($$VAX_CALLG) %FI %;

! What each does. A loop tests the length with IF, not AND: BLISS
! evaluates both of AND's operands, and the byte past the end may be in
! no page. No comma is outside brackets, LOCAL $$A; LOCAL $$B; and not
! LOCAL $$A, $$B; so that one can be another macro's actual parameter,
! CHECK(1, FFS(...)), whose commas end it (oracle MACA).
MACRO
    ! FFS and FFC: the first bit set or clear in the field of .SIZA<0, 8>
    ! bits at bit .POSA of BASE; its position to DSTA, or the field's end;
    ! 1 if there is none.
    $FFS(POSA, SIZA, BASE, DSTA) = $$VAX_FIND(1, POSA, SIZA, BASE, DSTA) %,
    $FFC(POSA, SIZA, BASE, DSTA) = $$VAX_FIND(0, POSA, SIZA, BASE, DSTA) %,
    $$VAX_FIND(STATE, POSA, SIZA, BASE, DSTA) =
        BEGIN
        LOCAL $$B; LOCAL $$P; LOCAL $$E;
        $$B = BASE;
        $$P = .(POSA)<0, 32, 1>;
        $$E = .$$P + .(SIZA)<0, 8>;
        WHILE (IF .$$P LSS .$$E THEN .(.$$B + .$$P ^ -3)<.$$P AND 7, 1> NEQ STATE ELSE 0) DO
            $$P = .$$P + 1;
        (DSTA)<0, 32> = .$$P;
        .$$P GEQ .$$E
        END %,

    ! The character string ones, by BLISS's CH$ functions: LOCC, SKPC and
    ! MATCHC 1 if they find what they look for, else 0.
    $LOCC(CHARA, LENA, ADDR) =
        CH$FAIL(CH$FIND_CH(.(LENA)<0, 16>, ADDR, .(CHARA)<0, 8>)) EQL 0 %,
    $SKPC(CHARA, LENA, ADDR) =
        CH$FAIL(CH$FIND_NOT_CH(.(LENA)<0, 16>, ADDR, .(CHARA)<0, 8>)) EQL 0 %,
    $MATCHC(OBJLENA, OBJ, SRCLENA, SRC) =
        CH$FAIL(CH$FIND_SUB(.(SRCLENA)<0, 16>, SRC, .(OBJLENA)<0, 16>, OBJ)) EQL 0 %,
    ! MOVC3 and MOVC5 move as if the operands and the source were all
    ! read first, so that the strings may overlap, which CH$MOVE's and
    ! CH$COPY's must not (LRM 20.2.5.1): backwards when the destination is
    ! after the source; MOVC5's fill byte before anything moves.
    $MOVC3(LENA, SRC, DST) = $$VAX_MOVE(.(LENA)<0, 16>, SRC, DST) %,
    $MOVC5(SRCLENA, SRC, FILLA, DSTLENA, DST) =
        BEGIN
        LOCAL $$N; LOCAL $$M; LOCAL $$D; LOCAL $$F;
        $$F = .(FILLA)<0, 8>;
        $$N = .(DSTLENA)<0, 16>;
        $$M = MINU(.(SRCLENA)<0, 16>, .$$N);
        $$D = DST;
        $$VAX_MOVE(.$$M, SRC, .$$D);
        CH$FILL(.$$F, .$$N - .$$M, .$$D + .$$M);
        END %,
    $$VAX_MOVE(LEN, SRC, DST) =
        BEGIN
        LOCAL $$MN; LOCAL $$MS; LOCAL $$MD;
        $$MN = LEN;
        $$MS = SRC;
        $$MD = DST;
        IF .$$MD GTRA .$$MS
        THEN DECR $$I FROM .$$MN - 1 TO 0 DO (.$$MD + .$$I)<0, 8> = .(.$$MS + .$$I)<0, 8>
        ELSE CH$MOVE(.$$MN, .$$MS, .$$MD);
        END %,
    $MOVTC(SRCLENA, SRC, FILLA, TBL, DSTLENA, DST) =
        CH$TRANSLATE(TBL, .(SRCLENA)<0, 16>, SRC, .(FILLA)<0, 8>, .(DSTLENA)<0, 16>, DST) %,
    $CMPC3(LENA, SRC, DST) =
        CH$COMPARE(.(LENA)<0, 16>, SRC, .(LENA)<0, 16>, DST) %,
    $CMPC5(SRCLENA, SRC, FILLA, DSTLENA, DST) =
        CH$COMPARE(.(SRCLENA)<0, 16>, SRC, .(DSTLENA)<0, 16>, DST, .(FILLA)<0, 8>) %,

    ! SCANC: the address of the first byte whose table entry AND the mask
    ! isn't 0, or 0; SPANC the first whose is.
    $SCANC(LENA, ADDR, TBL, MASKA) = $$VAX_SCAN(1, LENA, ADDR, TBL, MASKA) %,
    $SPANC(LENA, ADDR, TBL, MASKA) = $$VAX_SCAN(0, LENA, ADDR, TBL, MASKA) %,
    $$VAX_SCAN(HIT, LENA, ADDR, TBL, MASKA) =
        BEGIN
        LOCAL $$A; LOCAL $$N; LOCAL $$T; LOCAL $$M;
        $$A = ADDR;
        $$N = .(LENA)<0, 16>;
        $$T = TBL;
        $$M = .(MASKA)<0, 8>;
        WHILE (IF .$$N GTR 0 THEN ((.(.$$T + .(.$$A)<0, 8>)<0, 8> AND .$$M) NEQ 0) NEQ HIT ELSE 0) DO
            ($$A = .$$A + 1; $$N = .$$N - 1);
        IF .$$N GTR 0 THEN .$$A ELSE 0
        END %,

    ! MOVTUC: translates until the escape character, read before anything
    ! moves; 0, or the address of the source byte that was it.
    $MOVTUC(SRCLENA, SRC, ESCA, TBL, DSTLENA, DST) =
        BEGIN
        LOCAL $$S; LOCAL $$D; LOCAL $$N; LOCAL $$T; LOCAL $$C; LOCAL $$E;
        $$S = SRC;
        $$E = .(ESCA)<0, 8>;
        $$D = DST;
        $$T = TBL;
        $$N = MINU(.(SRCLENA)<0, 16>, .(DSTLENA)<0, 16>);
        WHILE (IF .$$N GTR 0 THEN ($$C = .(.$$T + .(.$$S)<0, 8>)<0, 8>) NEQ .$$E ELSE 0) DO
            ((.$$D)<0, 8> = .$$C; $$S = .$$S + 1; $$D = .$$D + 1; $$N = .$$N - 1);
        IF .$$N GTR 0 THEN .$$S ELSE 0
        END %,

    ! EMUL: .MULR * .MULD + .ADDA, longwords, to the quadword at PROD;
    ! EDIV: the quadword at DVD by the longword at DIVR, quotient and
    ! remainder to longwords. ASHQ shifts a quadword. Their result, the
    ! VAX's PSL, is 1 here.
    $EMUL(MULR, MULD, ADDA, PROD) =
        %IF %BPVAL EQL 64 %THEN
            ((PROD)<0, 64> = .(MULR)<0, 32, 1> * .(MULD)<0, 32, 1> + .(ADDA)<0, 32, 1>; 1)
        %ELSE
            BEGIN EXTERNAL ROUTINE LIB$EMUL : BLISS; LIB$EMUL(MULR, MULD, ADDA, PROD); 1 END
        %FI %,
    $EDIV(DIVR, DVD, QUO, RMD) =
        %IF %BPVAL EQL 64 %THEN
            BEGIN
            LOCAL $$Q; LOCAL $$D;
            $$Q = .(DVD)<0, 64>;
            $$D = .(DIVR)<0, 32, 1>;
            (QUO)<0, 32> = .$$Q / .$$D;
            (RMD)<0, 32> = .$$Q MOD .$$D;
            1
            END
        %ELSE
            BEGIN EXTERNAL ROUTINE LIB$EDIV : BLISS; LIB$EDIV(DIVR, DVD, QUO, RMD); 1 END
        %FI %,
    $ASHQ(SHIFTA, SRC, DST) =
        %IF %BPVAL EQL 64 %THEN
            ((DST)<0, 64> = .(SRC)<0, 64> ^ .(SHIFTA)<0, 8, 1>; 1)
        %ELSE
            %ERROR('ASHQ needs BLISS-64: its quadwords are no BLISS-32 values')
        %FI %,

    ! ADDM, SUBM and CMPM: multiword integers of SIZE fullwords, the low
    ! one first.
    $ADDM(SIZE, SRC1, SRC2, DST) = $$VAX_MULTI(1, SIZE, SRC1, SRC2, DST) %,
    $SUBM(SIZE, SRC1, SRC2, DST) = $$VAX_MULTI(-1, SIZE, SRC1, SRC2, DST) %,
    $$VAX_MULTI(SIGN, SIZE, SRC1, SRC2, DST) =
        BEGIN
        ! Each fullword wraps into the carry, under the caller's OVERFLOW too.
        SWITCHES NOOVERFLOW;
        LOCAL $$C; LOCAL $$K; LOCAL $$A; LOCAL $$B; LOCAL $$S;
        ! Each operand once, in order, as the VAX reads them.
        LOCAL $$N; LOCAL $$P1; LOCAL $$P2; LOCAL $$PD;
        $$N = SIZE; $$P1 = SRC1; $$P2 = SRC2; $$PD = DST;
        $$C = 0;
        INCR $$I FROM 0 TO .$$N - 1 DO
            BEGIN
            $$A = .(.$$P1 + %UPVAL * .$$I)<0, %BPVAL>;
            $$B = .(.$$P2 + %UPVAL * .$$I)<0, %BPVAL>;
            ! ADDM: .$$A + .$$B, SUBM: .$$B - .$$A, with the carry or borrow
            ! from the fullword before.
            %IF SIGN GTR 0 %THEN
                $$S = .$$A + .$$B;
                $$K = .$$S LSSU .$$A;
                $$S = .$$S + .$$C;
                $$C = .$$K OR .$$S LSSU .$$C;
            %ELSE
                $$S = .$$B - .$$A;
                $$K = .$$B LSSU .$$A OR .$$S LSSU .$$C;
                $$S = .$$S - .$$C;
                $$C = .$$K;
            %FI
            (.$$PD + %UPVAL * .$$I)<0, %BPVAL> = .$$S
            END
        END %,
    $CMPM(SIZE, SRC1, SRC2) =
        BEGIN
        LOCAL $$R; LOCAL $$A; LOCAL $$B;
        LOCAL $$N; LOCAL $$P1; LOCAL $$P2;
        $$N = SIZE; $$P1 = SRC1; $$P2 = SRC2;
        $$R = 0;
        DECR $$I FROM .$$N - 1 TO 0 DO
            BEGIN
            $$A = .(.$$P1 + %UPVAL * .$$I)<0, %BPVAL>;
            $$B = .(.$$P2 + %UPVAL * .$$I)<0, %BPVAL>;
            IF .$$A NEQ .$$B THEN
                BEGIN
                $$R = (IF (IF .$$I EQL .$$N - 1
                        THEN .(.$$P1 + %UPVAL * .$$I)<0, %BPVAL, 1> LSS .(.$$P2 + %UPVAL * .$$I)<0, %BPVAL, 1>
                        ELSE .$$A LSSU .$$B) THEN -1 ELSE 1);
                EXITLOOP
                END
            END;
        .$$R
        END %,

    ! INDEX: (.INA + .SUB) * .SCALE to OUTA, the subscript checked against
    ! LOW and HIGH; out of range it signals SS$_SUBRNG, 1196.
    $INDEX(SUB, LOW, HIGH, SCALE, INA, OUTA) =
        BEGIN
        IF .(SUB)<0, 32, 1> LSS .(LOW)<0, 32, 1> OR .(SUB)<0, 32, 1> GTR .(HIGH)<0, 32, 1>
        THEN SIGNAL(1196);
        (OUTA)<0, 32> = (.(INA)<0, 32, 1> + .(SUB)<0, 32, 1>) * .(SCALE)<0, 32, 1>
        END %,

    ! The queues, by the PAL's calls, with the VAX's values (UM 4.64,
    ! 4.65, 4.83, 4.84) where the PAL's differ: INSQUE 1 if the entry is
    ! the queue's only one; INSQHI and INSQTI 2 if it is, else 0; REMQUE,
    ! REMQHI and REMQTI 0 if they removed one, 2 if they removed the
    ! last, 3 if the queue was empty, with the entry's address to the
    ! longword ADDR. The interlocked ones are 1 if another CPU held the
    ! queue.
    $INSQUE(ENTRY, PRED) = PAL_INSQUEL(PRED, ENTRY) %,
    $REMQUE(ENTRY, ADDR) =
        BEGIN
        LOCAL $$R; LOCAL $$E;
        $$R = PAL_REMQUEL(ENTRY; $$E);
        (ADDR)<0, 32> = .$$E;
        IF .$$R LSS 0 THEN 3 ELSE IF .$$R EQL 0 THEN 2 ELSE 0
        END %,
    $INSQHI(ENTRY, HEADER) = $$INSQI(PAL_INSQHIL(HEADER, ENTRY)) %,
    $INSQTI(ENTRY, HEADER) = $$INSQI(PAL_INSQTIL(HEADER, ENTRY)) %,
    $REMQHI(HEADER, ADDR) = $$REMQI(PAL_REMQHIL, HEADER, ADDR) %,
    $REMQTI(HEADER, ADDR) = $$REMQI(PAL_REMQTIL, HEADER, ADDR) %,
    ! The PAL's -1, 0 and 1 for an insert.
    $$INSQI(CALL) =
        BEGIN
        LOCAL $$R;
        $$R = CALL;
        IF .$$R LSS 0 THEN 1 ELSE 2 * .$$R
        END %,
    ! The PAL's -1, 0, 1 and 2 for a remove.
    $$REMQI(CALL, HEADER, ADDR) =
        BEGIN
        LOCAL $$R; LOCAL $$E;
        $$R = CALL(HEADER; $$E);
        (ADDR)<0, 32> = .$$E;
        IF .$$R LSS 0 THEN 1 ELSE IF .$$R EQL 0 THEN 3 ELSE IF .$$R EQL 1 THEN 0 ELSE 2
        END %,

    ! Probes, the PS, processor registers and the rest of the machine.
    $PROBER(MODEA, LENA, BASE) =
        PAL_PROBER(BASE, .(LENA)<0, 16>, .(MODEA)<0, 8>) %,
    $PROBEW(MODEA, LENA, BASE) =
        PAL_PROBEW(BASE, .(LENA)<0, 16>, .(MODEA)<0, 8>) %,
    $MOVPSL(DSTA) = (DSTA)<0, 32> = PAL_RD_PS() %,
    ! The VAX's arithmetic trap enables: ARM64 has none to set.
    $BISPSW(MASKA) = (0) %,
    $BICPSW(MASKA) = (0) %,
    $MTPR(SRCA, PROCREG) =
        %IF %IDENTICAL(PROCREG, PR$_IPL) %THEN PAL_MTPR_IPL(.(SRCA)<0, 32>)
        %ELSE %IF %IDENTICAL(PROCREG, PR$_SIRR) %THEN PAL_MTPR_SIRR(.(SRCA)<0, 32>)
        %ELSE %IF %IDENTICAL(PROCREG, PR$_SCBB) %THEN PAL_MTPR_SCBB(.(SRCA)<0, 32>)
        %ELSE %ERROR('MTPR: vaxpunk''s PAL has calls for PR$_IPL, PR$_SIRR and PR$_SCBB')
        %FI %FI %FI %,
    $MFPR(PROCREG, DSTA) =
        %IF %IDENTICAL(PROCREG, PR$_IPL) %THEN (DSTA)<0, 32> = PAL_MFPR_IPL()
        %ELSE %IF %IDENTICAL(PROCREG, PR$_SISR) %THEN (DSTA)<0, 32> = PAL_MFPR_SISR()
        %ELSE %IF %IDENTICAL(PROCREG, PR$_SCBB) %THEN (DSTA)<0, 32> = PAL_MFPR_SCBB()
        %ELSE %IF %IDENTICAL(PROCREG, PR$_PCBB) %THEN (DSTA)<0, 32> = PAL_MFPR_PCBB()
        %ELSE %ERROR('MFPR: vaxpunk''s PAL has calls for PR$_IPL, PR$_SISR, PR$_SCBB and PR$_PCBB')
        %FI %FI %FI %FI %,
    $HALT = PAL_HALT() %,
    $BPT = PAL_BPT() %,
    $NOP = (0) %,
    $BUGW(CODEA) = PAL_BUGCHK(.(CODEA)<0, 16>) %,
    $BUGL(CODEA) = PAL_BUGCHK(.(CODEA)<0, 32>) %,
    $CHME(CODEA) = PAL_CHME(.(CODEA)<0, 16, 1>) %,
    $CHMK(CODEA) = PAL_CHMK(.(CODEA)<0, 16, 1>) %,
    $CHMS(CODEA) = PAL_CHMS(.(CODEA)<0, 16, 1>) %,
    $CHMU(CODEA) = PAL_CHMU(.(CODEA)<0, 16, 1>) %,

    ! CALLG: the routine called with the argument list at ARGLIST.
    $CALLG(ARGLIST, RTN) =
        BEGIN EXTERNAL ROUTINE LIB$CALLG : BLISS; LIB$CALLG(ARGLIST, RTN) END %;
