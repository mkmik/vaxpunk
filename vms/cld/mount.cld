! MOUNT device label [logical-name] [/OVERRIDE=IDENTIFICATION]
! [/OWNER_UIC=uic] [/PROTECTION=(code[,...])] [/SYSTEM] [/[NO]WRITE]:
! MOUNT.EXE mounts a volume. A label is required, as on VMS, but with
! /OVERRIDE=IDENTIFICATION, whose syntax takes any or none.
define verb MOUNT
	image MOUNT
	parameter P1, label=DEVICE, prompt="Device", value(required)
	parameter P2, label=LABEL, prompt="Label", value(required)
	parameter P3, label=LOGNAM
	qualifier OVERRIDE, value(required, list, type=OVERRIDE_KEYWORDS)
	qualifier OWNER_UIC, value(required, type=$uic)
	qualifier PROTECTION, value(required, list)
	qualifier SYSTEM
	qualifier WRITE, default

define syntax MOUNT_ANY_LABEL
	parameter P1, label=DEVICE, prompt="Device", value(required)
	parameter P2, label=LABEL
	parameter P3, label=LOGNAM

define type OVERRIDE_KEYWORDS
	keyword IDENTIFICATION, syntax=MOUNT_ANY_LABEL
