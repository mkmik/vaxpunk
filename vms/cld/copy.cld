! COPY from to: COPY.EXE copies files, from a list, with wildcards, into
! one file, /CONCATENATE, or a file each. COPY/HTTP node::"/path" to, or
! URL::"http://host[:port]/path" to, fetches one from a web server;
! /BINARY makes it FIX 512.
define verb COPY
	image COPY
	parameter P1, label=FROM, prompt="From", value(required, list, type=$infile)
	parameter P2, label=TO, prompt="To", value(required, type=$outfile)
	qualifier ALLOCATION, value(type=$number)
	qualifier BINARY
	qualifier CONCATENATE, default
	qualifier CONFIRM
	qualifier HTTP
	qualifier LOG
	qualifier OVERLAY
	qualifier PROTECTION, value(required, list)
	qualifier REPLACE
