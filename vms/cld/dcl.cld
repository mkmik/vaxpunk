! The verbs DCL does itself: CLIROUTINE names the code in DCL that does
! each, which takes its values from the parse.

! CLOSE logical-name: closes the file OPEN opened as logical-name.
! ponytail: no /DISPOSITION.
define verb CLOSE
	cliroutine CLOSE
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	qualifier ERROR, value(required)
	qualifier LOG, default

! CONNECT virtual-terminal: connects the terminal's line to the user's
! disconnected virtual terminal, VTAn:, and logs this process out, or
! with /NOLOGOUT or /CONTINUE disconnects it; /CONTINUE continues the
! image CTRL/Y stopped first.
define verb CONNECT
	cliroutine CONNECT
	parameter P1, label=VIRTUAL_TERMINAL, prompt="Virtual terminal", value(required)
	qualifier CONTINUE
	qualifier LOGOUT, default

define verb CONTINUE
	cliroutine CONTINUE

! DISCONNECT: disconnects the virtual terminal from its line, which
! closes, and the process waits to be connected to again; /CONTINUE
! continues the image CTRL/Y stopped.
define verb DISCONNECT
	cliroutine DISCONNECT
	qualifier CONTINUE

define verb DEASSIGN
	cliroutine DEASSIGN
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

! DECK and EOD: RMS's, as an image reads a procedure's data; DCL gets
! them only when none does (dcl/proc.mar).
define verb DECK
	cliroutine DECK
	qualifier DOLLARS, value

define verb DEFINE
	cliroutine DEFINE
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=EQUIVALENCE_NAME, prompt="Equ_name", value(required, list)
	qualifier LOG, default
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

define verb ELSE
	cliroutine ELSE
	parameter P1, label=COMMAND, value(type=$rest_of_line)

define verb ENDIF
	cliroutine ENDIF

define verb EOD
	cliroutine ENDIF

define verb EXIT
	cliroutine EXIT
	parameter P1, label=STATUS, value(type=$rest_of_line)

define verb GOTO
	cliroutine GOTO
	parameter P1, label=LABEL, prompt="Label", value(required)

! HELP [@library] [topic ...]: HELP.EXE writes it from SYS$HELP:HELPLIB.HLB,
! the help library /LIBRARY names, or the user libraries, HLP$LIBRARY and
! on, and prompts for more unless /NOPROMPT.
define verb HELP
	image HELP
	parameter P1, label=TOPIC, value(type=$rest_of_line)
	qualifier INSTRUCTIONS, default
	qualifier LIBLIST, default
	qualifier LIBRARY, value(required, type=$infile)
	qualifier OUTPUT, value(type=$outfile)
	qualifier PAGE, default
	qualifier PROMPT, default
	qualifier USERLIBRARY, default, value(list, type=HELP_LEVELS)

define type HELP_LEVELS
	keyword ALL
	keyword NONE
	keyword PROCESS
	keyword GROUP
	keyword SYSTEM

define verb IF
	cliroutine IF
	parameter P1, label=EXPRESSION, prompt="Expression", value(required, type=$rest_of_line)

! INQUIRE symbol [prompt]: asks the terminal for a local symbol's value,
! or with /GLOBAL a global one's. ponytail: no symbol is CLI's INSFPRM,
! a prompt of two words MAXPARM, where VMS's DCL says PARMDEL; and
! qualifiers may follow the prompt, which VMS's don't.
define verb INQUIRE
	cliroutine INQUIRE
	parameter P1, label=SYMBOL, value(required)
	parameter P2, label=PROMPT
	qualifier GLOBAL
	qualifier LOCAL
	qualifier PUNCTUATION, default

define verb LOGOUT
	cliroutine LOGOUT

! ON condition THEN command: condition is WARNING, ERROR, SEVERE_ERROR or
! CONTROL_Y, which DCL parses itself, with THEN and the command.
define verb ON
	cliroutine ON
	parameter P1, label=ARGUMENT, prompt="Condition", value(required, type=$rest_of_line)

! OPEN logical-name file-spec: opens a file for READ and WRITE, for
! reading by default; /WRITE alone makes a new sequential file, /READ/WRITE
! opens one of any organization for both, and /APPEND writes after its
! last record. ponytail: /SHARE is taken and does nothing, as RMS has
! one stream per file until PRD-0008's step 9.
define verb OPEN
	cliroutine OPEN
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=FILE, prompt="Filename", value(required, type=$file)
	qualifier APPEND
	qualifier ERROR, value(required)
	qualifier READ
	qualifier SHARE, value(type=SHARE_OPTIONS)
	qualifier WRITE
	disallow APPEND and WRITE

define type SHARE_OPTIONS
	keyword READ
	keyword WRITE

define verb PIPE
	cliroutine PIPE
	parameter P1, label=COMMAND, prompt="Command", value(required, type=$rest_of_line)

! READ logical-name symbol: reads the next record of the file OPEN
! opened, or with /KEY the one with that key, along key /INDEX, into a
! local symbol; SYS$INPUT a procedure's next data line, or the terminal,
! after /PROMPT's text, as SYS$COMMAND. ponytail: no /NOLOCK or
! /TIME_OUT, which read shared files and terminals.
define verb READ
	cliroutine READ
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=SYMBOL, prompt="Symbol", value(required)
	qualifier DELETE
	qualifier END_OF_FILE, value(required)
	qualifier ERROR, value(required)
	qualifier INDEX, value(required, type=$number)
	qualifier KEY, value(required)
	qualifier MATCH, value(required, type=MATCH_OPTIONS)
	qualifier PROMPT, value(required)

define type MATCH_OPTIONS
	keyword EQ
	keyword GE
	keyword GT

! RUN image: DCL runs it in the process. With a qualifier for a process
! of its own, RUNDET.EXE runs it in a new one, as VMS's RUN does.
define verb RUN
	cliroutine RUN
	parameter P1, label=FILE, prompt="File", value(required, type=$infile)
	qualifier DETACHED, syntax=RUNDET
	qualifier PROCESS_NAME, value(required), syntax=RUNDET
	qualifier PRIORITY, value(required, type=$number), syntax=RUNDET
	qualifier INPUT, value(required, type=$infile), syntax=RUNDET
	qualifier OUTPUT, value(required, type=$outfile), syntax=RUNDET
	qualifier ERROR, value(required, type=$outfile), syntax=RUNDET
	qualifier PRIVILEGES, value(required, list), syntax=RUNDET
	qualifier UIC, value(required, type=$uic), syntax=RUNDET
	qualifier MAILBOX, value(required, type=$number), syntax=RUNDET
	qualifier AST_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier BUFFER_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier ENQUEUE_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier EXTENT, value(required, type=$number), syntax=RUNDET
	qualifier FILE_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier IO_BUFFERED, value(required, type=$number), syntax=RUNDET
	qualifier IO_DIRECT, value(required, type=$number), syntax=RUNDET
	qualifier JOB_TABLE_QUOTA, value(required, type=$number), syntax=RUNDET
	qualifier MAXIMUM_WORKING_SET, value(required, type=$number), syntax=RUNDET
	qualifier PAGE_FILE, value(required, type=$number), syntax=RUNDET
	qualifier QUEUE_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier SUBPROCESS_LIMIT, value(required, type=$number), syntax=RUNDET
	qualifier WORKING_SET, value(required, type=$number), syntax=RUNDET

define syntax RUNDET
	image RUNDET

define verb SET
	cliroutine SET
	parameter P1, label=OPTION, prompt="What", value(required, type=SET_OPTIONS)

define type SET_OPTIONS
	keyword COMMAND, syntax=SET_COMMAND
	keyword CONTROL, negatable, value(list, type=CONTROL_OPTIONS)
	keyword DEFAULT, syntax=SET_DEFAULT
	keyword DIRECTORY, syntax=SET_DIRECTORY
	keyword FILE, syntax=SET_FILE
	keyword HOST, syntax=SET_HOST
	keyword PASSWORD, syntax=SET_PASSWORD
	keyword ON, negatable
	keyword PROCESS, syntax=SET_PROCESS
	keyword PROMPT, value
	keyword PROTECTION, value(list), syntax=SET_PROTECTION
	keyword SECURITY, syntax=SET_SECURITY
	keyword TERMINAL, syntax=SET_TERMINAL
	keyword VERIFY, negatable
	keyword VOLUME, syntax=SET_VOLUME

! SET [NO]CONTROL[=Y]: CTRL/Y, and CTRL/C no image takes, on or off.
! ponytail: no T, CTRL/T has no status line to show.
define type CONTROL_OPTIONS
	keyword Y

! SET COMMAND file: compiles file.CLD's verbs into the process's tables.
define syntax SET_COMMAND
	cliroutine SET_COMMAND
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)

define syntax SET_DEFAULT
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DIRECTORY, prompt="Directory", value(required)

! SET HOST address: RTPAD.EXE, a remote login.
define syntax SET_HOST
	image RTPAD
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=NODE, prompt="Node", value(required)

! SET PASSWORD: SETPWD.EXE asks for the old password and the new one.
define syntax SET_PASSWORD
	image SETPWD
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)

! SET PROCESS/PRIVILEGES=(priv[,...]): SET.EXE.
define syntax SET_PROCESS
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	qualifier PRIVILEGES, value(required, list)
	disallow not PRIVILEGES

! SET PROTECTION=(code[,...]) file: SET.EXE gives the file's categories
! that access.
define syntax SET_PROTECTION
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)

! SET SECURITY object[,...]: SET.EXE changes each object's owner,
! protection and ACL with $SET_SECURITY: /ACL's ACEs are added at the
! top, after /AFTER's, deleted with /DELETE, all but the protected ones
! without ACEs, all with /DELETE=ALL, or put in place of /REPLACE's;
! /LIKE=NAME=object copies another's, /DEFAULT gives the default ones.
! ponytail: the class FILE; no /CONFIRM, or the qualifiers that pick
! files by date or owner.
define syntax SET_SECURITY
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=OBJECT, prompt="Object", value(required, list, type=$infile)
	qualifier ACL, value(list, type=$acl)
	qualifier AFTER, nonnegatable, value(required, type=$acl)
	qualifier REPLACE, nonnegatable, value(required, list, type=$acl)
	qualifier DELETE, nonnegatable, value(type=DELETE_OPTIONS)
	qualifier LIKE, nonnegatable, value(required, list, type=LIKE_OPTIONS)
	qualifier DEFAULT, nonnegatable
	qualifier CLASS, nonnegatable, value(required)
	qualifier OWNER, nonnegatable, value(required, type=$uic)
	qualifier PROTECTION, nonnegatable, value(required, list)
	qualifier LOG
	disallow REPLACE and DELETE
	disallow AFTER and (DELETE or REPLACE)

define type DELETE_OPTIONS
	keyword ALL

define type LIKE_OPTIONS
	keyword NAME, value(required)
	keyword CLASS, value(required)

! SET FILE file: SET.EXE gives the file the owner, record attributes,
! expiration date and version limit its qualifiers say.
define syntax SET_FILE
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)
	qualifier ATTRIBUTE, nonnegatable, value(required, list)
	qualifier EXPIRATION_DATE, value(required, type=$datetime)
	qualifier OWNER_UIC, nonnegatable, value(required, type=$uic)
	qualifier VERSION_LIMIT, nonnegatable, value(type=$number)
	disallow not (ATTRIBUTE or EXPIRATION_DATE or neg EXPIRATION_DATE or OWNER_UIC or VERSION_LIMIT)

! SET DIRECTORY/VERSION_LIMIT[=n] directory: SET.EXE gives the directory
! the default version limit its new names get.
define syntax SET_DIRECTORY
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DIRECTORY, prompt="Directory", value(required, type=$infile)
	qualifier VERSION_LIMIT, nonnegatable, value(type=$number)
	disallow not VERSION_LIMIT

! SET VOLUME device: SET.EXE changes the label, owner, protection and
! default file protection of the volume mounted there.
define syntax SET_VOLUME
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DEVICE, prompt="Device", value(required)
	qualifier FILE_PROTECTION, nonnegatable, value(required, list)
	qualifier LABEL, nonnegatable, value(required)
	qualifier OWNER_UIC, nonnegatable, value(required, type=$uic)
	qualifier PROTECTION, nonnegatable, value(required, list)

! SET TERMINAL [device]: SET.EXE sets the terminal's characteristics.
! ponytail: the ones a terminal keeps that a program may care about; no
! /INQUIRE=OLD, /BACKSPACE, /PARITY, fill, modem or hardware ones.
define syntax SET_TERMINAL
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DEVICE_NAME
	qualifier WIDTH, nonnegatable, value(required, type=$number)
	qualifier PAGE, nonnegatable, value(required, type=$number)
	qualifier DEVICE_TYPE, nonnegatable, value(required)
	qualifier INQUIRE, nonnegatable
	qualifier PERMANENT, nonnegatable
	qualifier SPEED, nonnegatable, value(required, list)
	qualifier BROADCAST
	qualifier COLOR
	qualifier ECHO
	qualifier EIGHTBIT
	qualifier ESCAPE
	qualifier INSERT, nonnegatable
	qualifier LINE_EDITING
	qualifier LOWERCASE
	qualifier OVERSTRIKE, nonnegatable
	qualifier PASTHRU
	qualifier TAB
	qualifier WRAP
	disallow INSERT and OVERSTRIKE

define verb SHOW
	cliroutine SHOW
	parameter P1, label=OPTION, prompt="What", value(required, type=SHOW_OPTIONS)

define type SHOW_OPTIONS
	keyword CPU, syntax=SHOW_CPU
	keyword DEFAULT
	keyword DEVICES, syntax=SHOW_DEVICES
	keyword ERROR, syntax=SHOW_ERROR
	keyword LOGICAL, syntax=SHOW_LOGICAL
	keyword MEMORY, syntax=SHOW_MEMORY
	keyword PROCESS, syntax=SHOW_IMAGE
	keyword QUOTA, syntax=SHOW_QUOTA
	keyword SECURITY, syntax=SHOW_SECURITY
	keyword SYMBOL, syntax=SHOW_SYMBOL
	keyword SYSTEM, syntax=SHOW_IMAGE
	keyword TERMINAL, syntax=SHOW_TERMINAL
	keyword USERS, syntax=SHOW_USERS

define syntax SHOW_DEVICES
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=DEVICE_NAME
	qualifier FULL
	qualifier MOUNTED

! SHOW LOGICAL [name] [/PROCESS|/SYSTEM|/TABLE=table]: SHOW.EXE, which
! is installed with CMKRNL to list the tables.
define syntax SHOW_LOGICAL
	image SHOW
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=LOGICAL_NAME
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

define syntax SHOW_SYMBOL
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=SYMBOL
	qualifier ALL
	qualifier GLOBAL
	qualifier LOCAL
	disallow GLOBAL and LOCAL
	disallow P2 and ALL

! SHOW PROCESS [/PRIVILEGES] [/QUOTAS] [/RIGHTS] and SHOW SYSTEM: SHOW.EXE.
define syntax SHOW_IMAGE
	image SHOW
	qualifier PRIVILEGES
	qualifier QUOTAS
	qualifier RIGHTS

! SHOW SECURITY object [/CLASS=class]: SHOW.EXE shows the owner,
! protection and ACL of each object, $GET_SECURITY's.
define syntax SHOW_SECURITY
	image SHOW
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=OBJECT, prompt="Object", value(required, type=$infile)
	qualifier CLASS, nonnegatable, value(required)

! SHOW USERS [username] [/FULL]: SHOW.EXE.
define syntax SHOW_USERS
	image SHOW
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=USERNAME
	qualifier FULL

! SHOW MEMORY [/PHYSICAL_PAGES] [/SLOTS] [/POOL] [/ALL]: SHOW.EXE.
define syntax SHOW_MEMORY
	image SHOW
	qualifier ALL
	qualifier PHYSICAL_PAGES
	qualifier POOL
	qualifier SLOTS

! SHOW ERROR [/FULL]: SHOW.EXE.
define syntax SHOW_ERROR
	image SHOW
	qualifier FULL

! SHOW QUOTA [/USER=uic] [/DISK=device]: SHOW.EXE.
define syntax SHOW_QUOTA
	image SHOW
	qualifier USER, value(required)
	qualifier DISK, value

! SHOW CPU [/BRIEF] [/FULL]: SHOW.EXE.
define syntax SHOW_CPU
	image SHOW
	qualifier BRIEF
	qualifier FULL
	disallow BRIEF and FULL

! SHOW TERMINAL [device] [/PERMANENT]: SHOW.EXE.
define syntax SHOW_TERMINAL
	image SHOW
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=DEVICE_NAME
	qualifier PERMANENT, nonnegatable

! SPAWN [command]: a subprocess that runs DCL with a copy of this
! process's symbols, logical names, default directory and prompt, which
! does the command and logs out, or reads the terminal until LOGOUT;
! this process waits for it unless /NOWAIT. ponytail: no /OUTPUT, /CLI,
! /TABLE, /KEYPAD, /NOTIFY, /CARRIAGE_CONTROL or /[NO]LOGICAL_NAMES.
define verb SPAWN
	cliroutine SPAWN
	parameter P1, label=COMMAND, value(type=$rest_of_line)
	qualifier INPUT, value(required, type=$infile)
	qualifier LOG, default
	qualifier PROCESS, value(required)
	qualifier PROMPT, value
	qualifier SYMBOLS, default
	qualifier WAIT, default

define verb STOP
	cliroutine STOP
	parameter P1, label=PROCESS_NAME
	qualifier IDENTIFICATION, value(required)

! TCPIP command: TCP/IP Services' management commands, which TCPIP.EXE
! parses with its own tables, sysexe/tcpip.cld; with none, it prompts
! TCPIP> for them.
define verb TCPIP
	image TCPIP
	parameter P1, label=COMMAND, value(type=$rest_of_line)

! WRITE logical-name expression[,...]: writes a record to the file OPEN
! opened, or a line to SYS$OUTPUT or SYS$ERROR; /UPDATE rewrites the
! record READ read last. ponytail: no /SYMBOL.
define verb WRITE
	cliroutine WRITE
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=EXPRESSION, prompt="Expression", value(required, type=$rest_of_line)
	qualifier ERROR, value(required)
	qualifier UPDATE
