        .TITLE  TELNETD The remote login server
        .IDENT  /V0.3/
;
; SET HOST's other end. TCPIP.EXE starts it at boot, as the process
; TCPIP$TELNET. It listens on TCP port 23, a socket on TCPIP$DEVICE:, and
; makes each connection it accepts a TELNET terminal, _TNAn:, with
; IO$_TTY_PORT, as TCP/IP Services' TELNET server gives a remote login a
; TNA device; the executive's terminal driver speaks Telnet on it. Then it
; creates a process that runs LOGINOUT with the terminal as its SYS$INPUT,
; SYS$OUTPUT and SYS$ERROR, named so, as VMS names a process on a
; terminal before anyone logs in. LOGINOUT asks for a username and a
; password, and gives the process the user's DCL, which reads the
; commands typed there and writes there; LOGOUT, three failed logins, or
; the line going, deletes the process, and the terminal's last channel
; closes the connection. The server keeps its channel until LOGINOUT has
; assigned its own, which $GETDVI's DVI$_REFCNT shows.
; As TCP/IP Services', it gives a login a virtual terminal, _VTAn:, whose
; physical terminal is _TNAn:, while the system logical name
; TCPIP$TELNET_VTA is TRUE: a session that outlives the connection,
; which the user connects to again at the next login
; (docs/adr/0041-virtual-terminals-take-the-telnet-line.md).
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $IODEF
        $DVIDEF
        $INETSYMDEF
        $SOCKADDRINDEF
        $LNMDEF
        $TT2DEF
        $PRCDEF

        .PSECT  DATA, NOEXE, WRT, LONG
DEVICE: .ASCID  "TCPIP$DEVICE:"
LOGINOUT:
        .ASCID  "LOGINOUT.EXE"
TCP:    .WORD   TCPIP$C_TCP             ; a TCP socket: protocol, type, family
        .BYTE   TCPIP$C_STREAM, TCPIP$C_AF_INET
NAME:   .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME ; port 23, any address
        .ADDRESS .+4
        .WORD   TCPIP$C_AF_INET
        .BYTE   0, 23, 0, 0, 0, 0
        .BLKB   8
LCHAN:  .LONG   0                       ; the listening channel
CHAN:   .LONG   0                       ; a connection's
IOSB:   .BLKQ   1
MS50:   .LONG   -500000, -1             ; 50 ms
UNIT:   .LONG   0                       ; the terminal's name, _TNAn:, its length NAMEITEM's
        .ADDRESS UNITNAME
UNITNAME:
        .BLKB   16
REFCNT: .LONG   0                       ; the terminal's channels
SYSTAB: .ASCID  "LNM$SYSTEM"
VTANAME:.ASCID  "TCPIP$TELNET_VTA"
VTAITEM:.WORD   1, LNM$_STRING          ; $TRNLNM's item: its first character
        .ADDRESS VTAVALUE, 0
        .LONG   0
VTAVALUE:
        .BLKB   1
PORTCHAR:                               ; IO$_TTY_PORT's p1: TT2$M_DISCONNECT for a virtual terminal
        .LONG   0
NAMEITEM:                               ; $GETDVI's items: the name
        .WORD   16, DVI$_DEVNAM
        .ADDRESS UNITNAME, UNIT
        .LONG   0
REFITEM:                                ; the channels
        .WORD   4, DVI$_REFCNT
        .ADDRESS REFCNT, 0
        .LONG   0

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2>
        $ASSIGN_S DEVNAM=DEVICE, CHAN=LCHAN
        BLBC    R0, 90$
        $QIOW_S CHAN=LCHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=TCP, P3=#NAME, P4=#4
        BSBW    STATUS
        BLBC    R0, 90$
10$:    $ASSIGN_S DEVNAM=DEVICE, CHAN=CHAN
        BLBC    R0, 90$
        $QIOW_S CHAN=LCHAN, FUNC=#IO$_ACCESS!IO$M_ACCEPT, IOSB=IOSB, P4=#CHAN
        BSBW    STATUS
        BLBC    R0, 80$
        BSBW    VTA
        $QIOW_S CHAN=CHAN, FUNC=#IO$_TTY_PORT, IOSB=IOSB, P1=@PORTCHAR
        BSBW    STATUS
        BLBC    R0, 80$
        BSBW    LOGIN
80$:    $DASSGN_S CHAN=CHAN
        BRB     10$
90$:    RET

; LOGIN: creates the process for the terminal on CHAN, and waits until
; it has assigned a channel to it, or 5 seconds.
LOGIN:
        .JSB_ENTRY  SCRATCH=<R2>
        $GETDVIW_S CHAN=CHAN, ITMLST=NAMEITEM
        BLBC    R0, 90$
        $CREPRC_S IMAGE=LOGINOUT, INPUT=UNIT, OUTPUT=UNIT, ERROR=UNIT, PRCNAM=UNIT, BASPRI=#4, STSFLG=#PRC$M_DETACH
        BLBC    R0, 90$
        MOVL    #100, R2
10$:    $SETIMR_S EFN=#1, DAYTIM=MS50
        $WAITFR_S EFN=#1
        $GETDVIW_S CHAN=CHAN, ITMLST=REFITEM
        CMPL    REFCNT, #2              ; its channel and ours
        BGEQ    90$
        SOBGTR  R2, 10$
90$:    RSB

; VTA: PORTCHAR = TT2$M_DISCONNECT if TCPIP$TELNET_VTA is TRUE, its
; value starting with T, Y or 1, as DCL takes a string for true, else 0.
; Uses R0, R1.
VTA:
        .JSB_ENTRY
        CLRL    PORTCHAR
        CLRB    VTAVALUE
        $TRNLNM_S TABNAM=SYSTAB, LOGNAM=VTANAME, ITMLST=VTAITEM
        BLBC    R0, 90$
        BICB3   #^X20, VTAVALUE, R0     ; in capitals
        CMPB    R0, #^A/T/
        BEQL    10$
        CMPB    R0, #^A/Y/
        BEQL    10$
        CMPB    VTAVALUE, #^A/1/
        BNEQ    90$
10$:    MOVL    #TT2$M_DISCONNECT, PORTCHAR
90$:    RSB

; STATUS: R0 = $QIOW's status. R0 = the IOSB's, if that was a success.
STATUS:
        .JSB_ENTRY
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

        .END    START
