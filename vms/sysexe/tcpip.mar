        .TITLE  TCPIP   TCP/IP Services' management commands
        .IDENT  /V0.5/
;
; DCL's TCPIP verb runs this. It parses the rest of the line, or with
; none each line it reads after TCPIP> until EXIT or CTRL/Z, with its
; own tables, TCPIP.CLD, as TCP/IP Services' TCPIP does, and
; CLI$DISPATCH calls the command's routine. WE0 is the one interface.
; As there, SET INTERFACE and SET ROUTE change the running system, and
; SET CONFIGURATION INTERFACE and SET ROUTE /PERMANENT the saved
; configuration, which START COMMUNICATION applies at boot: the first two
; sense the settings with ioctls on a UDP socket, IO$_SENSEMODE on
; TCPIP$DEVICE:, the network's port driver (netdriver.mar), change theirs
; and set them with IO$_SETMODE's ioctls, as TCP/IP Services' sockets
; have them: SIOCGIFADDR, SIOCSIFADDR and the rest on WE0, SIOCGETRT and
; SIOCADDRT on the default route;
; the last two read the saved ones, change theirs and write INTERFACE
; address mask gateway, and DHCP if /DHCP said so, in a new version of
; MDA0:[000000]TCPIP$CONFIG.DAT, on the ramdisk that SYSTARTUP_VMS.COM
; makes afresh at each boot, so the saved configuration is what its
; commands save (ADR-0025). /DHCP
; has the TCP/IP component ask a DHCP server for the address, mask and
; gateway instead. SHOW INTERFACE senses them and writes them, and
; whether the link is up. START COMMUNICATION, which SYLOGIN.COM runs at
; boot, sets the interface from the saved settings, or with DHCP if there
; are none, and says so, and starts TELNETD, the remote login server SET
; HOST talks to. PING sends ICMP echo requests on a raw ICMP socket, one
; each second, and writes a line for each reply, as TCP/IP Services' does.
; SET HOST, SET NOHOST and SHOW HOST keep the hosts database,
; MDA0:[000000]TCPIP$HOST.DAT, TCP/IP Services' indexed file of names and
; addresses, which HOST_ADDR (lib/inet.mar) looks names up in for PING,
; TELNET and COPY (ADR-0025), before DNS (ADR-0026); the first of them to find none makes it,
; with LOCALHOST, as TCP/IP Services' CREATE HOST does. The ramdisk is
; made afresh at each boot, so the hosts are those SYSTARTUP_VMS.COM sets.
; ponytail: one interface and one route, the default; the hosts read at
; once up to TABSIZE bytes of them.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $XABKEYDEF
        $IODEF
        $CLIMSGDEF
        $JPIDEF
        $INETSYMDEF
        $SOCKADDRINDEF
        $IFREQDEF
        $ORTENTRYDEF
        $SIOCDEF

        .EXTERNAL PUT_LINE, INET_ADDR, HOST_ADDR, CLI$GET_VALUE, CLI$DCL_PARSE, CLI$DISPATCH
        .EXTERNAL LIB$GET_FOREIGN, LIB$GET_INPUT, LIB$SIGNAL, TCPIP_TABLES, HELP$TOPIC

DHCP = 4                                ; SETTINGS' flags: ask a DHCP server
ECHOLEN = 64                            ; an echo request: its header and 56 data bytes
HOST_REC = 271                          ; a hosts database record: 0 a host, 1 an alias,
HOST_ADDRLEN = 15                       ; then the address, padded with blanks,
HOST_NAME = 16                          ; and from here the name, padded too
TABSIZE = 16384                         ; the hosts read at once, at most
INHIB = ^X10000000                      ; STS$M_INHIB_MSG: reported already
TCPIP$_HOSTERROR = ^X0764835A           ; cannot process host request
TCPIP$_NORECORD = ^X076486A0            ; information not found

; APPEND "text": appends text to LINE. Uses R0-R5.
        .MACRO  APPEND  TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        BSBW    ADDSTR
        .ENDM   APPEND

        .PSECT  DATA, NOEXE, WRT, LONG
DEVICE: .ASCID  "TCPIP$DEVICE:"
CHAN:   .LONG   0                       ; a UDP socket, for the ioctls
IOSB:   .BLKQ   1
UDP:    .WORD   TCPIP$C_UDP             ; a socket: protocol, type, family
        .BYTE   TCPIP$C_DGRAM, TCPIP$C_AF_INET
ICMP:   .WORD   TCPIP$C_ICMP            ; PING's, a raw one
        .BYTE   TCPIP$C_RAW, TCPIP$C_AF_INET
; The ioctls' arguments: WE0's address, mask and flags, and the default
; route, each with its SOCKADDRINs' family.
IFADDR: .ASCII  "WE0"
        .BLKB   13
        .WORD   TCPIP$C_AF_INET
        .BLKB   14
IFMASK: .ASCII  "WE0"
        .BLKB   13
        .WORD   TCPIP$C_AF_INET
        .BLKB   14
IFFLAGS:
        .ASCII  "WE0"
        .BLKB   29
ROUTE:  .LONG   0
        .WORD   TCPIP$C_AF_INET         ; to 0.0.0.0
        .BLKB   14
        .WORD   TCPIP$C_AF_INET         ; through the gateway
        .BLKB   14
        .WORD   ORT$M_RTF_UP!ORT$M_RTF_GATEWAY
        .BLKB   10
; The ioctl lists, each an item_list_2 of ioctl_comms: sensing all of
; them, setting all of them, and having a DHCP server set them.
SENSEIOC:
        .WORD   32, TCPIP$C_IOCTL
        .ADDRESS .+4
        .LONG   SIOCGIFADDR
        .ADDRESS IFADDR
        .LONG   SIOCGIFNETMASK
        .ADDRESS IFMASK
        .LONG   SIOCGIFFLAGS
        .ADDRESS IFFLAGS
        .LONG   SIOCGETRT
        .ADDRESS ROUTE
SETIOC: .WORD   24, TCPIP$C_IOCTL
        .ADDRESS .+4
        .LONG   SIOCSIFADDR
        .ADDRESS IFADDR
        .LONG   SIOCSIFNETMASK
        .ADDRESS IFMASK
        .LONG   SIOCADDRT
        .ADDRESS ROUTE
DHCPIOC:
        .WORD   8, TCPIP$C_IOCTL
        .ADDRESS .+4
        .LONG   SIOCSIFDHCP
        .ADDRESS IFADDR
SETTINGS:                               ; address, mask, gateway, flags: 2 the link is up, 4 DHCP
        .BLKL   4
CMD:    .BLKB   256                     ; the saved settings, .ASCIC
LINDSC: .LONG   255                     ; a command, after TCPIP or TCPIP>
        .ADDRESS LINBUF
LINLEN: .WORD   0
LINBUF: .BLKB   255
PROMPT: .ASCID  "TCPIP> "
DONE:   .LONG   0                       ; 1 once EXIT
IFNAME: .LONG   16                      ; INTERFACE, the parameter
        .ADDRESS IFBUF
IFBUF:  .BLKB   16
IFLEN:  .WORD   0
VALUE:  .LONG   0                       ; an address the command gives
        .ADDRESS VALBUF
VALBUF: .BLKB   64
FAB:    $FAB    FNA=CONFIG, FNS=CONFIGLEN
RAB:    $RAB    FAB=FAB, UBF=CMD+1, USZ=255
LINE:   .BLKB   256                     ; a line being written, .ASCIC
CONFIG: .ASCII  "MDA0:[000000]TCPIP$CONFIG.DAT"
CONFIGLEN = . - CONFIG
INTERFACE:
        .ASCIC  "INTERFACE"
DHCPWORD:
        .ASCIC  "DHCP"
WE0:    .ASCII  "WE0"
P_HOST: .ASCID  "HOST"
P_MASK: .ASCID  "NETWORK_MASK"
P_GATEWAY:
        .ASCID  "GATEWAY"
TELNETD:
        .ASCID  "TELNETD.EXE"
TELNETD_NAME:
        .ASCID  "TCPIP$TELNET"
TARGET: .LONG   0                       ; PING's host
PNAME:  .BLKB   65                      ; as it was given, .ASCIC
COUNT:  .LONG   0                       ; PING's /NUMBER_PACKETS, 0 until CTRL/C
SECOND: .LONG   -10000000, -1           ; between two of PING's requests
PCHAN:  .LONG   0                       ; PING's socket
RIOSB:  .BLKQ   1                       ; its read's
TNAME:  .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME ; the host's name
        .ADDRESS TSIN
TSIN:   .WORD   TCPIP$C_AF_INET
        .BLKB   14
PIDITEM:                                ; $GETJPI's item: the PID
        .WORD   4, JPI$_PID
        .ADDRESS PID, 0
        .LONG   0
PID:    .LONG   0                       ; the requests' identifier
NOW:    .BLKQ   1
TTL:    .LONG   0                       ; a reply's TTL,
MS:     .LONG   0                       ; its round trip,
NBYTES: .LONG   0                       ; and its ICMP bytes
PKT:    .BLKB   ECHOLEN                 ; an echo request
REPLY:  .BLKB   256                     ; what came: an IP header and ICMP
; The hosts database: key 0 the name, key 1 the address, as TCP/IP
; Services makes it.
DBFAB:  $FAB    FNA=DBSPEC, FNS=DBSPECLEN, FAC=<GET,PUT,DEL>, ORG=IDX, RAT=CR, MRS=HOST_REC, XAB=KEY0
DBRAB:  $RAB    FAB=DBFAB, UBF=REC, USZ=HOST_REC, RBF=REC, RSZ=HOST_REC
KEY0:   $XABKEY REF=0, POS=HOST_NAME, SIZ=HOST_REC-HOST_NAME, FLG=<DUP,IDX_NCMPR>, NXT=KEY1
KEY1:   $XABKEY REF=1, POS=1, SIZ=HOST_ADDRLEN, FLG=<DUP,IDX_NCMPR,KEY_NCMPR>
DBSPEC: .ASCII  "MDA0:[000000]TCPIP$HOST.DAT"
DBSPECLEN = . - DBSPEC
REC:    .BLKB   HOST_REC                ; a record
OLD:    .BLKB   HOST_REC                ; the host SET NOHOST takes out
NAME:   .LONG   255                     ; NAME, the parameter
        .ADDRESS NAMEBUF
NAMEBUF:
        .BLKB   255
NAMELEN:
        .WORD   0
FILTER: .BLKB   16                      ; SHOW HOST's address, .ASCIC, or none
FOUND:  .LONG   0                       ; the hosts SET NOHOST found
ANSWER: .LONG   8                       ; to Remove?
        .ADDRESS ANSBUF
ANSBUF: .BLKB   8
ANSLEN: .WORD   0
REMOVE: .ASCID  "Remove? [N]: "
LOCALHOST:
        .ASCIC  "LOCALHOST"
LOCALALIAS:
        .ASCIC  "localhost"
TABEND: .LONG   0                       ; past TABLE's last host
TABLE:  .BLKB   TABSIZE                 ; the hosts: each a type, then address and name, .ASCIC

        .PSECT  CODE, EXE, LONG
; START: the command after TCPIP, or, with none, each one read after
; TCPIP> until EXIT or the end of the input. R0 = the command's status,
; or, after TCPIP>, SS$_NORMAL: the errors are reported there.
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7>
        $ASSIGN_S DEVNAM=DEVICE, CHAN=CHAN
        BLBC    R0, 90$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=UDP
        PUSHAW  LINLEN
        CLRL    -(SP)                   ; no prompt: none
        PUSHAQ  LINDSC
        CALLS   #3, G^LIB$GET_FOREIGN
        BLBC    R0, 90$
        TSTW    LINLEN
        BEQL    10$
        BSBW    DO
        RET
10$:    PUSHAW  LINLEN
        PUSHAQ  PROMPT
        PUSHAQ  LINDSC
        CALLS   #3, G^LIB$GET_INPUT
        BLBC    R0, 80$                 ; CTRL/Z
        BSBW    DO
        BLBS    R0, 20$
        CMPL    R0, #CLI$_NOCOMD        ; a blank line
        BEQL    20$
        BBS     #28, R0, 20$            ; STS$V_INHIB_MSG: reported
        BSBW    REPORT
20$:    BLBC    DONE, 10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; DO: parses the command in LINBUF, LINLEN long, and calls its routine.
; R0 = its status, or the parse's.
DO:
        .JSB_ENTRY
        PUSHL   LINDSC
        MOVW    LINLEN, LINDSC
        PUSHAB  G^TCPIP_TABLES
        PUSHAQ  LINDSC
        CALLS   #2, G^CLI$DCL_PARSE
        MOVL    (SP)+, LINDSC
        BLBC    R0, 90$
        CALLS   #0, G^CLI$DISPATCH
90$:    RSB

; REPORT: R0 = an error. Writes its message, as a warning, so that
; LIB$SIGNAL returns even for a severe one. Uses R0-R1.
REPORT:
        .JSB_ENTRY
        BICL2   #7, R0                  ; STS$M_SEVERITY: STS$K_WARNING
        PUSHL   R0
        CALLS   #1, G^LIB$SIGNAL
        RSB

; EXIT: the end of the commands after TCPIP>.
        .ENTRY  EXIT, ^M<>
        MOVL    #1, DONE
        MOVL    #SS$_NORMAL, R0
        RET

; HELP: HELP [command]: describes the commands, from TCPIP_TABLES
; (help/describe.mar).
        .ENTRY  HELP, ^M<>
        PUSHAB  G^TCPIP_TABLES
        CALLS   #1, G^HELP$TOPIC
        BLBC    R1, 90$
        PRINT   ""
        PRINT   "  HELP command describes a command, its parameters and qualifiers."
        MOVL    #SS$_NORMAL, R0
90$:    RET

; SET_INTERFACE: SET INTERFACE WE0 /HOST=address /NETWORK_MASK=mask, or
; /DHCP, on the running system.
        .ENTRY  SET_INTERFACE, ^M<R2, R3, R4, R5, R6, R7>
        BSBW    CHKIF
        BLBC    R0, 90$
        BSBW    SENSE
        BLBC    R0, 90$
        BSBW    TAKEIF
        BLBC    R0, 90$
        BSBW    SETCHAR
90$:    RET

; SET_CONFIGURATION: SET CONFIGURATION INTERFACE WE0 /HOST=address
; /NETWORK_MASK=mask, or /DHCP, in the saved settings, keeping their
; gateway.
        .ENTRY  SET_CONFIGURATION, ^M<R2, R3, R4, R5, R6, R7>
        BSBW    CHKIF
        BLBC    R0, 90$
        BSBW    LOAD
        BSBW    TAKEIF
        BLBC    R0, 90$
        BSBW    SAVE
90$:    RET

; SET_ROUTE: SET ROUTE /DEFAULT /GATEWAY=address, on the running system,
; which stops DHCP there, or with /PERMANENT in the saved settings.
        .ENTRY  SET_ROUTE, ^M<R2, R3, R4, R5, R6, R7>
        PRESENT "PERMANENT"
        BLBC    R0, 10$
        BSBW    LOAD
        BSBB    GATEWAY
        BLBC    R0, 90$
        BSBW    SAVE
        RET
10$:    BSBW    SENSE
        BLBC    R0, 90$
        BSBB    GATEWAY
        BLBC    R0, 90$
        BSBW    SETCHAR
90$:    RET

; GATEWAY: /GATEWAY into SETTINGS. R0 = SS$_NORMAL, or SS$_IVADDR. Uses
; R0-R6.
GATEWAY:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVAB   P_GATEWAY, R5
        MOVAB   SETTINGS+8, R6
        BRW     TAKE

; CHKIF: R0 = SS$_NORMAL if the command's INTERFACE is WE0, or not
; given, else SS$_NOSUCHDEV. Uses R0-R1.
CHKIF:
        .JSB_ENTRY
        GETVALUE "INTERFACE", IFNAME, IFLEN
        BLBC    R0, 80$
        CMPW    IFLEN, #3
        BNEQ    70$
        CMPW    IFBUF, WE0
        BNEQ    70$
        CMPB    IFBUF+2, WE0+2
        BEQL    80$
70$:    MOVL    #SS$_NOSUCHDEV, R0
        RSB
80$:    MOVL    #SS$_NORMAL, R0
        RSB

; TAKEIF: /DHCP, or /HOST and /NETWORK_MASK, into SETTINGS. R0 =
; SS$_NORMAL, or SS$_IVADDR. Uses R0-R6.
TAKEIF:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        PRESENT "DHCP"
        BLBC    R0, 10$
        BISL2   #DHCP, SETTINGS+12
        MOVL    #SS$_NORMAL, R0
        RSB
10$:    BICL2   #DHCP, SETTINGS+12
        MOVAB   P_HOST, R5
        MOVAB   SETTINGS, R6
        BSBW    TAKE
        BLBC    R0, 90$
        MOVAB   P_MASK, R5
        MOVAB   SETTINGS+4, R6
        BSBW    TAKE
90$:    RSB

; TAKE: R5 = an entity's name, a descriptor, R6 = a longword. Puts the
; address the command gives the entity there. R0 = SS$_NORMAL, or
; SS$_IVADDR for one that isn't an address. Uses R0-R5.
TAKE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVW    #64, VALUE
        PUSHAW  VALUE
        PUSHAQ  VALUE
        PUSHL   R5
        CALLS   #3, G^CLI$GET_VALUE
        BLBC    R0, 90$
        MOVAB   VALBUF, R0
        MOVZWL  VALUE, R1
        BSBW    ADDRESS
        BLBC    R0, 90$
        MOVL    R3, (R6)
90$:    RSB

; PING: PING host [/NUMBER_PACKETS=n]: an echo request to the host, an
; address or a name in the hosts database, each second, on a raw ICMP socket, which needs SYSPRV or
; BYPASS, and a line for each reply, until CTRL/C, or n of them and how
; many came back. A request's identifier is the PID, its sequence number
; its count from 0, and its data starts with when it went, so a reply
; says its round trip; other ICMP messages are passed over.
; ponytail: no round trips' minimum, average and maximum.
        .ENTRY  PING, ^M<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVW    #64, VALUE
        GETVALUE "HOST", VALUE, VALUE
        BLBC    R0, 95$
        MOVZWL  VALUE, R0
        MOVB    R0, PNAME
        MOVC3   R0, VALBUF, PNAME+1
        PUSHAL  TARGET
        PUSHAB  VALBUF
        MOVZWL  VALUE, -(SP)
        CALLS   #3, G^HOST_ADDR
        BLBC    R0, 95$
        CLRL    COUNT
        PRESENT "NUMBER_PACKETS"
        BLBC    R0, 10$
        BSBW    NUMBER
        BLBC    R0, 95$
10$:    $GETJPIW_S ITMLST=PIDITEM
        BLBC    R0, 95$
        $ASSIGN_S DEVNAM=DEVICE, CHAN=PCHAN
        BLBC    R0, 95$
        $QIOW_S CHAN=PCHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=ICMP
        BLBC    R0, 15$
        MOVZWL  IOSB, R0
15$:    BLBS    R0, 18$
        BRW     90$
18$:    MOVL    TARGET, TSIN+SIN$L_ADDR
        CLRB    LINE
        APPEND  "PING "
        MOVAB   PNAME, R1
        BSBW    ADDSTR
        APPEND  " ("
        MOVL    TARGET, R3
        BSBW    ADDTEXT
        APPEND  "): 56 data bytes"
        BSBW    SAY
        CLRQ    R8                      ; R8 sent, R9 answered
20$:    BSBW    ECHO
        $SETIMR_S EFN=#2, DAYTIM=SECOND
        $QIOW_S CHAN=PCHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=PKT, P2=#ECHOLEN, P3=#TNAME
        BLBC    R0, 25$
        MOVZWL  IOSB, R0
25$:    BLBS    R0, 28$
        BRW     90$
28$:    INCL    R8
30$:    CLRQ    RIOSB                   ; the reply, or the second's end
        $QIO_S  EFN=#1, CHAN=PCHAN, FUNC=#IO$_READVBLK, IOSB=RIOSB, P1=REPLY, P2=#256
        BLBS    R0, 32$
        BRW     90$
32$:    $WFLOR_S EFN=#1, MASK=#6        ; flag 1 or 2
        TSTW    RIOSB
        BEQL    40$
        MOVZWL  RIOSB, R0
        BLBS    R0, 34$
        BRW     90$
34$:    BSBW    MATCH
        BLBC    R0, 30$                 ; not our reply
        INCL    R9
        MOVL    NBYTES, R1
        BSBW    ADDDEC
        APPEND  " bytes from "
        MOVL    TARGET, R3
        BSBW    ADDTEXT
        APPEND  ": icmp_seq="
        SUBL3   #1, R8, R1
        BSBW    ADDDEC
        APPEND  " ttl="
        MOVL    TTL, R1
        BSBW    ADDDEC
        APPEND  " time="
        MOVL    MS, R1
        BSBW    ADDDEC
        APPEND  " ms"
        BSBW    SAY
        BRB     50$
40$:    $CANCEL_S CHAN=PCHAN            ; no reply: no line
        $WAITFR_S EFN=#1
50$:    CMPL    R8, COUNT
        BEQL    60$
        $WAITFR_S EFN=#2                ; the rest of the second
        BRW     20$
60$:    $CANTIM_S
        APPEND  "----"
        MOVAB   PNAME, R1
        BSBW    ADDSTR
        APPEND  " PING Statistics----"
        BSBW    SAY
        MOVL    R8, R1
        BSBW    ADDDEC
        APPEND  " packets transmitted, "
        MOVL    R9, R1
        BSBW    ADDDEC
        APPEND  " packets received, "
        SUBL3   R9, R8, R1
        MULL2   #100, R1
        DIVL2   R8, R1
        BSBW    ADDDEC
        APPEND  "% packet loss"
        BSBW    SAY
        MOVL    #SS$_NORMAL, R0
90$:    PUSHL   R0
        $DASSGN_S CHAN=PCHAN
        MOVL    (SP)+, R0
95$:    RET

; ECHO: R8 = a count. Makes PKT an echo request, its sequence number the
; count, its identifier the PID, its data when it goes, then zeros, with
; its checksum. Uses R0-R4.
ECHO:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        MOVAB   PKT, R0
        MOVL    #ECHOLEN/4, R1
10$:    CLRL    (R0)+
        SOBGTR  R1, 10$
        MOVB    #8, PKT                 ; ICMP's echo request
        MOVW    PID, PKT+4
        ROTL    #-8, R8, R0             ; the sequence number, high byte first
        MOVB    R0, PKT+6
        MOVB    R8, PKT+7
        $GETTIM_S TIMADR=PKT+8
        CLRL    R2                      ; the sum of its words, high byte first
        MOVAB   PKT, R3
        MOVL    #ECHOLEN/2, R4
20$:    MOVZBL  (R3)+, R0
        ASHL    #8, R0, R0
        MOVZBL  (R3)+, R1
        BISL2   R1, R0
        ADDL2   R0, R2
        SOBGTR  R4, 20$
30$:    EXTZV   #16, #16, R2, R0        ; with the carries added back
        BEQL    40$
        MOVZWL  R2, R2
        ADDL2   R0, R2
        BRB     30$
40$:    MCOML   R2, R2
        ROTL    #-8, R2, R0
        MOVB    R0, PKT+2
        MOVB    R2, PKT+3
        RSB

; MATCH: R8 = the requests sent. R0 = 1 if REPLY, RIOSB's bytes, is the
; echo reply to the last, and TTL, MS and NBYTES its TTL, round trip and
; ICMP bytes, else 0. Uses R0-R4.
MATCH:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        MOVZBL  REPLY, R4               ; the IP header's length
        BICL2   #^C15, R4
        ASHL    #2, R4, R4
        MOVZWL  RIOSB+2, R3
        SUBL2   R4, R3                  ; the ICMP message's
        CMPL    R3, #16
        BLSS    80$
        MOVAB   REPLY[R4], R2
        TSTB    (R2)                    ; an echo reply
        BNEQ    80$
        CMPW    4(R2), PID
        BNEQ    80$
        SUBL3   #1, R8, R0
        ROTL    #-8, R0, R1
        CMPB    6(R2), R1
        BNEQ    80$
        CMPB    7(R2), R0
        BNEQ    80$
        MOVL    R3, NBYTES
        MOVZBL  REPLY+8, TTL
        $GETTIM_S TIMADR=NOW
        SUBL3   8(R2), NOW, R0          ; in 100 ns
        CLRL    R1
        EDIV    #10000, R0, MS, R0
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; NUMBER: the command's /NUMBER_PACKETS, in decimal, into COUNT. R0 =
; SS$_NORMAL, or SS$_BADPARAM for one that isn't a number above 0. Uses
; R0-R2.
NUMBER:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVW    #64, VALUE
        GETVALUE "NUMBER_PACKETS", VALUE, VALUE
        BLBC    R0, 90$
        CLRL    COUNT
        MOVZWL  VALUE, R2
        BEQL    80$
        MOVAB   VALBUF, R1
10$:    SUBB3   #^A/0/, (R1)+, R0
        CMPB    R0, #9
        BGTRU   80$
        MOVZBL  R0, R0
        MULL2   #10, COUNT
        ADDL2   R0, COUNT
        SOBGTR  R2, 10$
        TSTL    COUNT
        BEQL    80$
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADPARAM, R0
90$:    RSB

; START_COMMUNICATION: unless the interface has an address already, the
; saved settings from the ramdisk, or DHCP if there are none; a failure
; to set them is reported. Then the remote login server, TELNETD, unless it
; runs already. Without a network, nothing.
        .ENTRY  START_COMMUNICATION, ^M<R2, R3, R4, R5, R6, R7>
        BSBW    SENSE
        BLBC    R0, 80$
        TSTL    SETTINGS
        BNEQ    50$
        BSBW    LOAD
        BLBS    R0, 20$
        BISL2   #DHCP, SETTINGS+12      ; none saved: LOAD left zeros
20$:    BSBW    SETCHAR
        BLBS    R0, 30$
        BSBW    REPORT                  ; a DHCP server that doesn't answer, say
        BRB     50$
30$:    BSBW    SENSE
        BLBC    R0, 90$
        MOVAB   SETMSG, R1
        BSBW    SHOWLINE
50$:    $CREPRC_S IMAGE=TELNETD, PRCNAM=TELNETD_NAME, BASPRI=#4
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; LOAD: puts the saved settings, INTERFACE address mask gateway [DHCP]
; in the ramdisk's file, in SETTINGS, or zeros if there are none. R0 = RMS's
; status if it can't read them, or PARSE's. Uses R0-R6.
LOAD:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CLRQ    SETTINGS
        CLRQ    SETTINGS+8
        $OPEN   FAB=FAB
        BLBC    R0, 90$
        $CONNECT RAB=RAB
        BLBC    R0, 40$
        $GET    RAB=RAB
        BLBC    R0, 40$
        MOVB    RAB+RAB$W_RSZ, CMD
40$:    PUSHL   R0
        $CLOSE  FAB=FAB
        MOVL    (SP)+, R0
        BLBC    R0, 90$
        BSBW    PARSE
90$:    RSB

; SAVE: writes INTERFACE and the settings' address, mask and gateway, and
; DHCP if they say so, in a new version of the saved file. R0 = RMS's
; status if it can't. Uses R0-R6.
SAVE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVZBL  INTERFACE, R2
        MOVB    R2, LINE
        MOVC3   R2, INTERFACE+1, LINE+1
        MOVAB   SETTINGS, R6
10$:    MOVZBL  LINE, R0                ; a blank, then the address
        MOVB    #^A/ /, LINE+1[R0]
        INCB    LINE
        MOVL    (R6)+, R3
        BSBW    ADDTEXT
        MOVAB   SETTINGS+12, R0
        CMPL    R6, R0
        BLSSU   10$
        BBC     #2, (R6), 20$           ; DHCP
        MOVZBL  LINE, R0
        MOVB    #^A/ /, LINE+1[R0]
        MOVZBL  DHCPWORD, R2
        ADDB3   #1, R2, R1
        ADDB2   R1, LINE
        MOVC3   R2, DHCPWORD+1, LINE+2[R0]
20$:    MOVB    #FAB$C_VAR, FAB+FAB$B_RFM
        MOVB    #FAB$M_CR, FAB+FAB$B_RAT
        $CREATE FAB=FAB
        BLBC    R0, 80$
        $CONNECT RAB=RAB
        BLBC    R0, 70$
        MOVAB   LINE+1, RAB+RAB$L_RBF
        MOVZBW  LINE, RAB+RAB$W_RSZ
        $PUT    RAB=RAB
70$:    MOVL    R0, R2
        $CLOSE  FAB=FAB
        MOVL    R2, R0
80$:    RSB

; SETCHAR: sets the interface as SETTINGS says: its address, mask and
; default route, or with DHCP whatever a DHCP server gives. R0 = a status.
SETCHAR:
        .JSB_ENTRY
        BBC     #2, SETTINGS+12, 10$    ; DHCP
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P5=#DHCPIOC
        BRB     80$
10$:    MOVL    SETTINGS, IFADDR+IFR$T_ADDR+SIN$L_ADDR
        MOVL    SETTINGS+4, IFMASK+IFR$T_ADDR+SIN$L_ADDR
        MOVL    SETTINGS+8, ROUTE+ORT$L_GATEWAY_SIN_ADDR
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P5=#SETIOC
80$:    BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

; PARSE: CMD = INTERFACE address mask gateway [DHCP]. Puts the three in
; SETTINGS, and DHCP in its flags. R0 = SS$_NORMAL, or SS$_IVADDR for one
; that isn't an address or isn't there. Uses R0-R6.
PARSE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVL    #2, R2
        MOVAB   SETTINGS, R6
10$:    BSBW    WORD
        BSBW    ADDRESS
        BLBC    R0, 90$
        MOVL    R3, (R6)+
        AOBLEQ  #4, R2, 10$
        BSBW    WORD                    ; R2 = 5
        CMPB    R1, DHCPWORD
        BNEQ    80$
        CMPL    (R0), DHCPWORD+1
        BNEQ    80$
        BISL2   #DHCP, (R6)
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; SHOW_INTERFACE: SHOW INTERFACE [WE0]: writes the interface's address,
; mask and gateway, and the link's state.
        .ENTRY  SHOW_INTERFACE, ^M<R2, R3, R4, R5, R6, R7>
        BSBW    CHKIF
        BLBC    R0, 90$
        BSBW    SENSE
        BLBC    R0, 90$
        PRINT   "Interface  IP_Addr          Network mask     Gateway          Link"
        MOVAB   SHOWMSG, R1
        BSBW    SHOWLINE
        MOVL    #SS$_NORMAL, R0
90$:    RET

; SET_HOST: SET HOST host /ADDRESS=address [/ALIAS=(alias,...)]: puts the
; host's record in the hosts database, then one for each alias. Another
; host with the name stays.
; ponytail: no %TCPIP-I-DUPHOSTNAME for one that has it already.
        .ENTRY  SET_HOST, ^M<R2, R3, R4, R5, R6, R7>
        GETVALUE "NAME", NAME, NAMELEN
        BLBC    R0, 95$
        MOVW    #64, VALUE
        GETVALUE "ADDRESS", VALUE, VALUE
        BLBC    R0, 95$
        MOVAB   VALBUF, R0
        MOVZWL  VALUE, R1
        BSBW    ADDRESS
        BLBC    R0, 95$
        MOVL    R3, R7
        BSBW    OPENDB
        BLBC    R0, 90$
        CLRB    LINE
        MOVL    R7, R3
        BSBW    ADDTEXT
        CLRL    R1                      ; the host
10$:    MOVAB   NAMEBUF, R3
        MOVZWL  NAMELEN, R4
        BSBW    PUTREC
        BLBC    R0, 80$
        GETVALUE "ALIAS", NAME, NAMELEN
        MOVL    #1, R1                  ; and its aliases
        BLBS    R0, 10$
        MOVL    #SS$_NORMAL, R0
80$:    BSBW    CLOSEDB
90$:    BLBS    R0, 95$
        BSBW    HOSTERR
95$:    RET

; SET_NOHOST: SET NOHOST host [/NOCONFIRM]: takes each host with the
; name, in any case, out of the hosts database, and its aliases, the
; names at its address; with /CONFIRM, the default, writes it, as SHOW
; HOST does, and asks Remove? first: Y removes it, N or nothing keeps it.
; ponytail: an alias's name isn't found, where TCP/IP Services says it is
; an alias; another host's names at the address go too.
        .ENTRY  SET_NOHOST, ^M<R2, R3, R4, R5, R6>
        GETVALUE "NAME", NAME, NAMELEN
        BLBC    R0, 95$
        CLRL    FOUND
        BSBW    OPENDB
        BLBC    R0, 90$
        BSBW    LOADDB
        BLBC    R0, 80$
        MOVAB   TABLE, R6
10$:    CMPL    R6, TABEND
        BGEQU   70$
        TSTB    (R6)
        BNEQ    60$
        MOVL    R6, R0
        BSBW    FIELDS
        BSBW    MATCHNAME
        BLBC    R0, 60$
        INCL    FOUND
        PRESENT "CONFIRM"
        BLBC    R0, 40$
        BSBW    HEADER
        BSBW    HOSTLINE
20$:    PUSHAW  ANSLEN
        PUSHAQ  REMOVE
        PUSHAQ  ANSWER
        CALLS   #3, G^LIB$GET_INPUT
        BLBC    R0, 60$                 ; CTRL/Z: keep it
        TSTW    ANSLEN
        BEQL    60$
        BICB3   #^X20, ANSBUF, R0       ; in capitals
        CMPB    R0, #^A/N/
        BEQL    60$
        CMPB    R0, #^A/Y/
        BNEQ    20$
40$:    BSBW    DELHOST
        BLBC    R0, 80$
60$:    MOVL    R6, R0
        BSBW    FIELDS
        MOVL    R0, R6
        BRB     10$
70$:    MOVL    #SS$_NORMAL, R0
        TSTL    FOUND
        BNEQ    80$
        MOVL    #RMS$_RNF, R0
80$:    BSBW    CLOSEDB
90$:    BLBS    R0, 95$
        BSBW    HOSTERR
95$:    RET

; SHOW_HOST: SHOW HOST [host] [/ADDRESS=address] [/LOCAL]: the hosts in
; the hosts database, in their names' order, or those at the address of
; the host, a name, an alias or an address, or at /ADDRESS, as TCP/IP
; Services' LOCAL database: each host's address, its name and its
; aliases. The hosts database is all /LOCAL asks for, and all there is.
        .ENTRY  SHOW_HOST, ^M<R2, R3, R4, R5, R6>
        BSBW    OPENDB
        BLBC    R0, 90$
        BSBW    LOADDB
        BSBW    CLOSEDB
        BLBC    R0, 90$
        CLRB    FILTER
        GETVALUE "NAME", NAME, NAMELEN
        BLBC    R0, 10$
        PUSHAL  TARGET
        PUSHAB  NAMEBUF
        MOVZWL  NAMELEN, -(SP)
        CALLS   #3, G^HOST_ADDR
        BLBC    R0, 90$
        MOVL    TARGET, R3
        BRB     15$
10$:    MOVW    #64, VALUE
        GETVALUE "ADDRESS", VALUE, VALUE
        BLBC    R0, 20$                 ; neither: every host
        MOVAB   VALBUF, R0
        MOVZWL  VALUE, R1
        BSBW    ADDRESS
        BLBC    R0, 95$
15$:    CLRB    LINE
        BSBW    ADDTEXT
        MOVC3   #16, LINE, FILTER
20$:    MOVAB   TABLE, R6
        BSBW    NEXTHOST
        TSTL    R6
        BNEQ    30$
        MOVL    #RMS$_RNF, R0
        BRB     90$
30$:    BSBW    HEADER
40$:    BSBW    HOSTLINE
        MOVL    R6, R0
        BSBW    FIELDS
        MOVL    R0, R6
        BSBW    NEXTHOST
        TSTL    R6
        BNEQ    40$
        MOVL    #SS$_NORMAL, R0
        RET
90$:    CMPL    R0, #TCPIP$_NORECORD    ; HOST_ADDR's
        BNEQ    92$
        MOVL    #RMS$_RNF, R0
92$:    BSBW    HOSTERR
95$:    RET

; HOSTERR: R0 = why a hosts command failed, RMS's status. Signals
; %TCPIP-E-HOSTERROR with it, after -TCPIP-W-NORECORD if it is RMS$_RNF,
; as TCP/IP Services does. R0 = TCPIP$_HOSTERROR, reported. Uses R0-R1.
HOSTERR:
        .JSB_ENTRY
        PUSHL   R0
        CMPL    R0, #RMS$_RNF
        BNEQ    10$
        CLRL    -(SP)
        PUSHL   #TCPIP$_NORECORD
        CLRL    -(SP)
        PUSHL   #TCPIP$_HOSTERROR
        CALLS   #5, G^LIB$SIGNAL
        BRB     20$
10$:    CLRL    -(SP)
        PUSHL   #TCPIP$_HOSTERROR
        CALLS   #3, G^LIB$SIGNAL
20$:    MOVL    #TCPIP$_HOSTERROR!INHIB, R0
        RSB

; OPENDB: opens the hosts database and connects DBRAB, making it first,
; with LOCALHOST, alias localhost, at 127.0.0.1, if there is none. R0 =
; RMS's status. Uses R0-R5.
OPENDB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $OPEN   FAB=DBFAB
        BLBS    R0, 50$
        CMPL    R0, #RMS$_FNF
        BNEQ    90$
        $CREATE FAB=DBFAB
        BLBC    R0, 90$
        $CONNECT RAB=DBRAB
        BLBC    R0, 80$
        CLRB    LINE
        APPEND  "127.0.0.1"
        CLRL    R1
        MOVAB   LOCALHOST+1, R3
        MOVZBL  LOCALHOST, R4
        BSBW    PUTREC
        BLBC    R0, 80$
        MOVL    #1, R1
        MOVAB   LOCALALIAS+1, R3
        MOVZBL  LOCALALIAS, R4
        BSBW    PUTREC
        BLBC    R0, 80$
        RSB
50$:    $CONNECT RAB=DBRAB
        BLBS    R0, 90$
80$:    BSBW    CLOSEDB
90$:    RSB

; CLOSEDB: closes the hosts database. Keeps R0.
CLOSEDB:
        .JSB_ENTRY  SCRATCH=<R1>
        PUSHL   R0
        $CLOSE  FAB=DBFAB
        MOVL    (SP)+, R0
        RSB

; PUTREC: R1 = a type, 0 a host or 1 an alias, R3 and R4 = its name and
; its length, LINE = its address, .ASCIC. Puts the record in the hosts
; database. R0 = RMS's status. Uses R0-R5.
PUTREC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAB   LINE, R2
        BSBW    MAKEREC
        MOVB    #RAB$C_KEY, DBRAB+RAB$B_RAC
        $PUT    RAB=DBRAB
        RSB

; MAKEREC: R1 = a type, R2 = an address, .ASCIC, R3 and R4 = a name and
; its length. Makes REC the record. Uses R0-R5.
MAKEREC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R1, R2, R3, R4>
        MOVC5   #0, (SP), #^A/ /, #HOST_REC, REC
        POPR    #^M<R1, R2, R3, R4>
        MOVB    R1, REC
        PUSHR   #^M<R3, R4>
        MOVZBL  (R2)+, R0
        MOVC3   R0, (R2), REC+1
        POPR    #^M<R3, R4>
        MOVC3   R4, (R3), REC+HOST_NAME
        RSB

; LOADDB: reads the open hosts database, in its names' order, into
; TABLE: each record's type, then its address and its name without their
; blanks, each .ASCIC, and TABEND past the last. R0 = SS$_NORMAL, or
; RMS's error. Uses R0-R6.
LOADDB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVAB   TABLE, R6
        MOVB    #RAB$C_SEQ, DBRAB+RAB$B_RAC
        $REWIND RAB=DBRAB
        BLBC    R0, 80$
10$:    $GET    RAB=DBRAB
        BLBC    R0, 80$
        CMPW    DBRAB+RAB$W_RSZ, #HOST_REC
        BNEQ    10$
        MOVAB   TABLE+TABSIZE-HOST_REC-2, R0
        CMPL    R6, R0                  ; no room for another
        BGTRU   85$
        MOVB    REC, (R6)+
        MOVAB   REC+1, R1
        MOVL    #HOST_ADDRLEN, R2
        BSBB    TRIMCOPY
        MOVAB   REC+HOST_NAME, R1
        MOVL    #HOST_REC-HOST_NAME, R2
        BSBB    TRIMCOPY
        BRB     10$
80$:    CMPL    R0, #RMS$_EOF
        BNEQ    90$
85$:    MOVL    #SS$_NORMAL, R0
90$:    MOVL    R6, TABEND
        RSB

; TRIMCOPY: R1 and R2 = a text and its length, R6 = where to. Writes it
; there without the blanks at its end, .ASCIC, and R6 past it. Uses
; R0-R5.
TRIMCOPY:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>, OUTPUT=<R6>
10$:    TSTL    R2
        BEQL    20$
        CMPB    -1(R1)[R2], #^A/ /
        BNEQ    20$
        DECL    R2
        BRB     10$
20$:    MOVB    R2, (R6)+
        MOVC3   R2, (R1), (R6)
        MOVL    R3, R6
        RSB

; FIELDS: R0 = a host in TABLE. R1 = its name, .ASCIC, and R0 the next.
FIELDS:
        .JSB_ENTRY  OUTPUT=<R0, R1>
        MOVZBL  1(R0), R1
        MOVAB   2(R0)[R1], R1
        MOVZBL  (R1), R0
        MOVAB   1(R1)[R0], R0
        RSB

; NEXTHOST: R6 = a place in TABLE. R6 = the host there or the first
; after it, not an alias, at FILTER's address if it has one, or 0 if none
; is. Uses R0-R5.
NEXTHOST:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>, OUTPUT=<R6>
10$:    CMPL    R6, TABEND
        BGEQU   80$
        TSTB    (R6)
        BNEQ    20$
        TSTB    FILTER
        BEQL    90$
        MOVAB   FILTER, R1
        MOVL    R6, R2
        BSBW    SAMEADDR
        BLBS    R0, 90$
20$:    MOVL    R6, R0
        BSBW    FIELDS
        MOVL    R0, R6
        BRB     10$
80$:    CLRL    R6
90$:    RSB

; SAMEADDR: R1 = an address, .ASCIC, R2 = a host in TABLE. R0 = 1 if it
; is the host's, else 0. Uses R0-R3.
SAMEADDR:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVZBL  (R1), R0
        INCL    R0
        CMPC3   R0, (R1), 1(R2)
        BNEQ    80$
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; MATCHNAME: R1 = a name, .ASCIC. R0 = 1 if it is NAME, in any case,
; else 0. Uses R0-R4.
MATCHNAME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        MOVZBL  (R1)+, R2
        CMPW    R2, NAMELEN
        BNEQ    80$
        MOVAB   NAMEBUF, R3
        TSTL    R2
        BEQL    70$
10$:    MOVZBL  (R1)+, R0
        BSBB    UPCASE
        MOVL    R0, R4
        MOVZBL  (R3)+, R0
        BSBB    UPCASE
        CMPB    R0, R4
        BNEQ    80$
        SOBGTR  R2, 10$
70$:    MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; UPCASE: R0 = a character. Makes it a capital, if it is a small letter.
UPCASE:
        .JSB_ENTRY
        CMPB    R0, #^A/a/
        BLSSU   10$
        CMPB    R0, #^A/z/
        BGTRU   10$
        SUBB2   #^A/a/-^A/A/, R0
10$:    RSB

; HEADER: writes the head of SHOW HOST's list, TCP/IP Services', blanks
; and all. Uses R0-R1.
HEADER:
        .JSB_ENTRY
        PRINT   "       "
        PRINT   "     LOCAL database"
        PRINT   "  "
        PRINT   "Host address    Host name"
        PRINT   " "
        RSB

; HOSTLINE: R6 = a host in TABLE. Writes its line: its address, in 16
; columns, its name, and a comma and each alias's, the names at its
; address. Uses R0-R5.
HOSTLINE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R7
        CLRB    LINE
        MOVAB   1(R6), R1
        BSBW    ADDSTR
10$:    CMPB    LINE, #16
        BGEQU   20$
        MOVZBL  LINE, R0
        MOVB    #^A/ /, LINE+1[R0]
        INCB    LINE
        BRB     10$
20$:    MOVL    R6, R0
        BSBW    FIELDS
        BSBB    ADDNAME
        MOVAB   TABLE, R7
30$:    CMPL    R7, TABEND
        BGEQU   80$
        TSTB    (R7)
        BEQL    40$
        MOVAB   1(R6), R1
        MOVL    R7, R2
        BSBW    SAMEADDR
        BLBC    R0, 40$
        CMPB    LINE, #253              ; no room for ", "
        BGEQU   80$
        APPEND  ", "
        MOVL    R7, R0
        BSBW    FIELDS
        BSBB    ADDNAME
40$:    MOVL    R7, R0
        BSBW    FIELDS
        MOVL    R0, R7
        BRB     30$
80$:    BSBW    SAY
        MOVL    (SP)+, R7
        RSB

; ADDNAME: R1 = a name, .ASCIC. Appends it to LINE, as much as fits.
; Uses R0-R5.
ADDNAME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  (R1)+, R2
        MOVZBL  LINE, R0
        SUBL3   R0, #255, R3
        CMPL    R2, R3
        BLEQ    10$
        MOVL    R3, R2
10$:    ADDB2   R2, LINE
        MOVC3   R2, (R1), LINE+1[R0]
        RSB

; DELHOST: R6 = a host in TABLE. Takes its record out of the open hosts
; database, and its aliases', the records of names at its address. R0 =
; SS$_NORMAL, or RMS's error. Uses R0-R5.
DELHOST:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R6, R0
        BSBW    FIELDS
        MOVZBL  (R1)+, R4
        MOVL    R1, R3
        CLRL    R1
        MOVAB   1(R6), R2
        BSBW    MAKEREC
        MOVC3   #HOST_REC, REC, OLD
10$:    MOVB    #RAB$C_SEQ, DBRAB+RAB$B_RAC
        $REWIND RAB=DBRAB               ; from the first again, after each
        BLBC    R0, 90$
20$:    $GET    RAB=DBRAB
        BLBC    R0, 80$
        CMPW    DBRAB+RAB$W_RSZ, #HOST_REC
        BNEQ    20$
        CMPC3   #HOST_ADDRLEN, REC+1, OLD+1
        BNEQ    20$
        TSTB    REC                     ; an alias there
        BNEQ    30$
        CMPC3   #HOST_REC, REC, OLD     ; the host
        BNEQ    20$
30$:    $DELETE RAB=DBRAB
        BLBS    R0, 10$
        RSB
80$:    CMPL    R0, #RMS$_EOF
        BNEQ    90$
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; SENSE: senses the settings, into SETTINGS, and whether the link is up,
; 2 in its flags. R0 = a status.
SENSE:
        .JSB_ENTRY
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SENSEMODE, IOSB=IOSB, P6=#SENSEIOC
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
        BLBC    R0, 90$
        MOVL    IFADDR+IFR$T_ADDR+SIN$L_ADDR, SETTINGS
        MOVL    IFMASK+IFR$T_ADDR+SIN$L_ADDR, SETTINGS+4
        MOVL    ROUTE+ORT$L_GATEWAY_SIN_ADDR, SETTINGS+8
        CLRL    SETTINGS+12
        BITW    #IFR$M_IFF_RUNNING, IFFLAGS+IFR$W_FLAGS
        BEQL    90$
        MOVL    #2, SETTINGS+12
90$:    RSB

; SHOWLINE: R1 = a heading, .ASCIC. Writes it, then the settings, each in
; 17 columns, and the link's state. Keeps R0.
SHOWLINE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        PUSHL   R0
        MOVB    (R1)+, LINE
        MOVZBL  LINE, R2
        MOVC3   R2, (R1), LINE+1
        MOVAB   SETTINGS, R6
10$:    MOVL    (R6)+, R3
        MOVZBL  LINE, R4
        BSBW    ADDTEXT
        ADDB3   #17, R4, R5             ; pad to the column's end
20$:    CMPB    LINE, R5
        BGEQU   30$
        MOVZBL  LINE, R0
        MOVB    #^A/ /, LINE+1[R0]
        INCB    LINE
        BRB     20$
30$:    MOVAB   SETTINGS+12, R0
        CMPL    R6, R0
        BLSSU   10$
        MOVAB   DOWN, R1
        BBC     #1, (R6), 40$
        MOVAB   UP, R1
40$:    BSBW    ADDSTR
        BSBW    SAY
        MOVL    (SP)+, R0
        RSB
SHOWMSG:
        .ASCIC  " WE0       "
SETMSG: .ASCIC  "%TCPIP-I-SET, WE0: "
UP:     .ASCIC  "up"
DOWN:   .ASCIC  "down"

; ADDTEXT: R3 = an address. Appends it to LINE, four numbers and dots.
; Uses R0-R3.
ADDTEXT:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHL   R3
        PUSHL   #4                      ; the numbers left
10$:    MOVZBL  4(SP), R1
        BSBB    ADDDEC
        ROTL    #-8, 4(SP), 4(SP)
        DECL    (SP)
        BEQL    90$
        MOVZBL  LINE, R0
        MOVB    #^A/./, LINE+1[R0]
        INCB    LINE
        BRB     10$
90$:    ADDL2   #8, SP
        RSB

; ADDDEC: appends R1 in decimal to LINE. Uses R0-R3.
ADDDEC:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        CLRL    R3                      ; digits, on the stack
10$:    DIVL3   #10, R1, R2
        MULL3   #10, R2, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R3
        MOVL    R2, R1
        BNEQ    10$
20$:    MOVZBL  LINE, R0
        MOVL    (SP)+, R1
        MOVB    R1, LINE+1[R0]
        INCB    LINE
        SOBGTR  R3, 20$
        RSB

; ADDSTR: R1 = a string, .ASCIC. Appends it to LINE. Uses R0-R5.
ADDSTR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  (R1)+, R2
        MOVZBL  LINE, R0
        ADDB2   R2, LINE
        MOVC3   R2, (R1), LINE+1[R0]
        RSB

; SAY: writes LINE, and empties it. Uses R0-R1.
SAY:
        .JSB_ENTRY
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        RSB

; WORD: R2 = n. R0 = the address of CMD's nth word, from 1, R1 = its
; length, 0 if there are fewer. Keeps every other register.
WORD:
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4>
        MOVAB   CMD+1, R0
        MOVZBL  CMD, R3
        ADDL2   R0, R3                  ; past the last character
10$:    CMPL    R0, R3                  ; past the blanks
        BGEQU   80$
        CMPB    (R0), #^A/ /
        BNEQ    20$
        INCL    R0
        BRB     10$
20$:    MOVL    R0, R4                  ; to the next blank
30$:    CMPL    R0, R3
        BGEQU   40$
        CMPB    (R0), #^A/ /
        BEQL    40$
        INCL    R0
        BRB     30$
40$:    SOBGTR  R2, 10$
        SUBL3   R4, R0, R1
        MOVL    R4, R0
        BRB     90$
80$:    CLRL    R1
90$:    POPR    #^M<R2, R3, R4>
        RSB

; ADDRESS: R0 and R1 = a word. R3 = the address it is (INET_ADDR), and
; R0 = SS$_NORMAL, or SS$_IVADDR. Keeps R2.
ADDRESS:
        .JSB_ENTRY  OUTPUT=<R3>
        CLRL    -(SP)
        PUSHAL  (SP)
        PUSHL   R0
        PUSHL   R1
        CALLS   #3, G^INET_ADDR
        MOVL    (SP)+, R3
        RSB

        .END    START
