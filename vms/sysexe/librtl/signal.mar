        .TITLE  SIGNAL  Condition handling routines, as VMS's LIB$
        .IDENT  /V0.1/
;
; LIB$SIGNAL and LIB$STOP signal a condition, LIB$ESTABLISH and
; LIB$REVERT set the caller's condition handler, and LIB$SIG_TO_RET is a
; handler that makes a condition its establisher's status. The executive
; looks for the handlers, in the vector (vms/exec/sysunwind.mar,
; ADR-0021). They are in LIBRTL.EXE, the shareable image every program
; calls (build.rs).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $CHFDEF
        $FRMDEF
        $PALDEF
        $SSDEF
        $STSDEF

        .EXTERNAL EXE$SIGNAL, EXE$CATCHALL

        .PSECT  SIGNAL_CODE, EXE, LONG
; LIB$ESTABLISH new_handler: makes new_handler, a routine's address, the
; condition handler of the caller's frame. R0 = the one it had, or 0.
        .ENTRY  LIB$ESTABLISH, ^M<>
        MOVL    FP, R1
        MOVL    FRM$Q_FP(R1), R1        ; the caller's frame
        MOVL    FRM$Q_HANDLER(R1), R0
        MOVL    4(AP), FRM$Q_HANDLER(R1)
        RET

; LIB$REVERT: takes the caller's frame's condition handler away. R0 = it,
; or 0.
        .ENTRY  LIB$REVERT, ^M<>
        MOVL    FP, R1
        MOVL    FRM$Q_FP(R1), R1
        MOVL    FRM$Q_HANDLER(R1), R0
        CLRL    FRM$Q_HANDLER(R1)
        RET

; LIB$SIG_TO_RET sigargs, mchargs: a condition handler that returns from
; the routine that established it, with the condition as its status:
; $UNWINDs to its caller with R0 = the condition. The unwind calls it
; again, with SS$_UNWIND, which it leaves alone.
        .ENTRY  LIB$SIG_TO_RET, ^M<>
        MOVL    CHF$L_SIGARGLST(AP), R0
        MOVL    CHF$L_SIG_NAME(R0), R0
        CMPL    R0, #SS$_UNWIND
        BEQL    90$
        MOVL    CHF$L_MCHARGLST(AP), R1
        EVAX_STQ R0, CHF$IH_MCH_RETVAL(R1)
        $UNWIND_S
90$:    RET

; LIB$SIGNAL condition [,arguments...]: signals condition, as VMS's: the
; signal arrays are the arguments, then the PC LIB$SIGNAL returns to and
; the PSL, and EXE$SIGNAL looks for a handler from the caller's frame,
; depth 0, out. Returns once one continues, with R0 and R1 from the
; mechanism array, which has R0 and R1 as LIB$SIGNAL got them at first:
; its first two arguments, by the calling standard. If none takes it,
; EXE$CATCHALL writes its message, and exits if it is severe, or returns.
LIB$SIGNAL::
        .CALL_ENTRY MAX_ARGS=255
        CLRL    R2
        BRB     SIGNAL

; LIB$STOP condition [,arguments...]: signals condition as LIB$SIGNAL
; does, made severe, and then, unless a handler unwinds, EXE$CATCHALL
; writes its message and exits. Doesn't return.
LIB$STOP::
        .CALL_ENTRY MAX_ARGS=255
        MOVL    #1, R2
; SIGNAL: R2 = 1 for LIB$STOP, 0 for LIB$SIGNAL, whose frames are alike.
SIGNAL: .GLOBAL_LABEL                   ; LIB$SIGNAL's too
        SUBL2   #CHF$S_MCH, SP          ; the mechanism array
        MOVL    SP, R3
        EVAX_STQ R0, CHF$IH_MCH_RETVAL(R3) ; R0 and R1 as they came
        EVAX_STQ R1, CHF$IH_MCH_RETVAL2(R3)
        MOVL    #CHF$S_MCH/8-1, CHF$IS_MCH_ARGS(R3)
        CLRL    CHF$IS_MCH_FLAGS(R3)
        MOVL    FP, R1
        MOVQ    FRM$Q_FP(R1), CHF$PH_MCH_FRAME(R3) ; the caller's frame
        CLRQ    CHF$IS_MCH_DEPTH(R3)
        CLRQ    CHF$PH_MCH_DADDR(R3)
        CLRQ    CHF$PH_MCH_ESF_ADDR(R3)
        MOVAB   CHF$IH_MCH_SAVX2(R3), R4
        MOVL    #16, R5
5$:     CLRQ    (R4)+                   ; x2-x17: none to give
        SOBGTR  R5, 5$
        CALL_PAL #PAL$_RD_PS
        MOVL    R0, R6                  ; the PSL
        MOVZBL  (AP), R5                ; the condition and its arguments
        CLRL    -(SP)                   ; the 64-bit signal array, quadwords
        PUSHL   R6
        PUSHL   FRM$Q_PC+4(R1)
        PUSHL   FRM$Q_PC(R1)            ; the PC LIB$SIGNAL returns to
        MOVL    R5, R4
10$:    MOVL    (AP)[R4], R7            ; the arguments, the last first
        ASHL    #-31, R7, R8
        PUSHL   R8
        PUSHL   R7
        SOBGTR  R4, 10$
        PUSHL   #SS$_SIGNAL64
        ADDL3   #2, R5, -(SP)
        MOVL    SP, R7
        MOVL    R7, CHF$PH_MCH_SIG64_ADDR(R3)
        CLRL    CHF$PH_MCH_SIG64_ADDR+4(R3)
        PUSHL   R6                      ; the 32-bit one, longwords
        PUSHL   FRM$Q_PC(R1)
        MOVL    R5, R4
20$:    PUSHL   (AP)[R4]
        SOBGTR  R4, 20$
        ADDL3   #2, R5, -(SP)
        MOVL    SP, R4
        MOVL    R4, CHF$PH_MCH_SIG_ADDR(R3)
        CLRL    CHF$PH_MCH_SIG_ADDR+4(R3)
        BLBC    R2, 30$
        INSV    #STS$K_SEVERE, #0, #3, CHF$L_SIG_NAME(R4)
        INSV    #STS$K_SEVERE, #0, #3, CHF64$Q_SIG_NAME(R7)
30$:    PUSHL   R3
        PUSHL   R4
        CALLS   #2, G^EXE$SIGNAL
        BLBS    R2, 40$
        BLBS    R0, 50$
40$:    PUSHL   R4
        CALLS   #1, G^EXE$CATCHALL
50$:    EVAX_LDQ R0, CHF$IH_MCH_RETVAL(R3)
        EVAX_LDQ R1, CHF$IH_MCH_RETVAL2(R3)
        RET

        .END
