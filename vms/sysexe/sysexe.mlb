; sysexe.mlb: console output for the system disk's programs, which run in
; user mode and print with PUT_LINE in lib/print.mar, a line on OPA0: with
; $QIOW. Each line is written whole, so no other process's comes in
; between.

; PRINT "text": writes text and CR LF. Uses R0-R1.
        .MACRO  PRINT   TEXT, ?L
        .EXTERNAL PUT_LINE
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        PUSHAB  L
        CALLS   #1, G^PUT_LINE
        .ENDM   PRINT

; PRINTHEX "text", value: writes text, value in hex, and CR LF. Uses R0-R1.
        .MACRO  PRINTHEX TEXT, VALUE, ?L
        .EXTERNAL PUT_LINE
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        PUSHL   VALUE
        PUSHAB  L
        CALLS   #2, G^PUT_LINE
        .ENDM   PRINTHEX

; EXPECT status, n: returns 2 * n, an error the executive reports with the
; process's name, unless R0 is status.
        .MACRO  EXPECT  STATUS, N, ?OK
        CMPL    R0, STATUS
        BEQL    OK
        MOVL    #<N * 2>, R0
        RET
OK:
        .ENDM   EXPECT

; GETVALUE "name", desc, len: CLI$GET_VALUE of the command's entity name
; into the string desc describes, its length into the word len. R0 =
; SS$_NORMAL, CLI$_COMMA or CLI$_CONCAT, or CLI$_ABSENT, low bit clear,
; past the last value (ADR-0017).
        .MACRO  GETVALUE NAME, DESC, LEN, ?L
        .EXTERNAL CLI$GET_VALUE
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  CLI_NAMES, NOEXE, NOWRT, LONG
L:      .ASCID  NAME
        .RESTORE_PSECT
        PUSHAW  LEN
        PUSHAQ  DESC
        PUSHAQ  L
        CALLS   #3, G^CLI$GET_VALUE
        .ENDM   GETVALUE

; PRESENT "name": CLI$PRESENT of the command's entity name. R0 =
; CLI$_PRESENT or CLI$_DEFAULTED, low bit set, or CLI$_NEGATED or
; CLI$_ABSENT, clear.
        .MACRO  PRESENT NAME, ?L
        .EXTERNAL CLI$PRESENT
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  CLI_NAMES, NOEXE, NOWRT, LONG
L:      .ASCID  NAME
        .RESTORE_PSECT
        PUSHAQ  L
        CALLS   #1, G^CLI$PRESENT
        .ENDM   PRESENT
