        .TITLE  DIRECTORY Lists files
        .IDENT  /V0.5/
;
; DCL's DIRECTORY [spec] runs this. Lists the files spec names, as VMS's DIRECTORY
; does: the directory, then their names, four to a line or /COLUMNS's,
; then how many. A name too long for its column takes two.
; spec is a list, by commas or plus signs. Each takes the device and
; directory it leaves out from the one before; one that finds nothing is
; passed over, and only none at all is %DIRECT-W-NOFILES. Files of the
; same directory share a heading, unless a specification names a device
; or a directory, which starts one of its own, as VMS's does.
; A search list's files are in more than one: each has its heading and
; total, and a grand total follows.
; RMS's $PARSE expands spec, what it leaves out taken from *.*;*, and the
; directory from the default one; $SEARCH finds each file. * matches any
; characters, % one. /VERSIONS=n lists each name's n highest versions.
; /SIZE, /DATE, /OWNER and /PROTECTION list a file a line, with its
; blocks, dates, owner's UIC and protection, which $OPEN puts in XABs; a
; name too long for its column has a line of its own. /TOTAL lists only
; the totals.
; /FULL lists all VMS's does about each, from its XABs, and the blocks
; they use and have.
; A wildcard directory, [*], [A...] or [...], is many directories, each
; with its heading and total, as a search list's are.
; ponytail: a file the process may not read shows neither, where VMS's
; DIRECTORY asks the XQP for them. /FULL's directories are contiguous,
; and the times Files-11 doesn't keep, like the last access, are <None
; specified>. An error but no file ends the list, where VMS's says
; %DIRECT-E-OPENIN and goes on. Lines are 80 characters, not the terminal's width, and
; /COLUMNS lists more than one file a line only without /SIZE, /DATE,
; /OWNER and /PROTECTION, where VMS's cuts names to fit.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $NAMDEF
        $CLIMSGDEF
        $XABPRODEF
        $XABDATDEF
        $XABFHCDEF
        $XABSUMDEF

        .EXTERNAL PUT_LINE

COLUMN = 20                             ; a name and its blanks
LINEMAX = 80
NAMEMAX = 18                            ; with /SIZE..., longer: a line of its own
DIRECT_SYNTAX = ^X107910FC              ; %DIRECT-F-SYNTAX, inhibited, as VMS's
D_OWNER = 0                             ; DETAIL's bits
D_PROT = 1
D_FULL = 2
D_USED = 3                              ; /SIZE=USED
D_ALLOC = 4                             ; /SIZE=ALLOCATION
D_TOTAL = 5
M_SIZE = <1@D_USED>!<1@D_ALLOC>         ; /SIZE=ALL
M_LINE = <1@D_OWNER>!<1@D_PROT>!M_SIZE  ; a file a line
DATEMAX = 9                             ; /DATE's dates, DATES's bits

; ADDTEXT "text": appends text to LINE. Uses R0-R2.
        .MACRO  ADDTEXT TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        .ENDM   ADDTEXT

; IFPRESENT "name", mask, cell: sets mask's bits in cell if the command
; has name. Uses R0 and R1.
        .MACRO  IFPRESENT NAME, MASK, CELL, ?L
        PRESENT NAME
        BLBC    R0, L
        BISL2   #MASK, CELL
L:
        .ENDM   IFPRESENT

        .PSECT  DATA, NOEXE, WRT, LONG
DEFSPEC:                                ; what spec leaves out
        .ASCII  "*.*;*"
DEFLEN = .-DEFSPEC
        .ALIGN  LONG
FAB:    $FAB    FNA=SPEC, DNA=DEFSPEC, DNS=DEFLEN, NAM=NAM
SPECDSC:                                ; FILE, the parameter, if given
        .LONG   255
        .ADDRESS SPEC
SPEC:   .BLKB   255
MORE:   .LONG   0                       ; CLI$GET_VALUE's: CLI$_COMMA or CLI$_CONCAT if more follow
STICKY: .BLKB   260                     ; the next one's default: the last one's device and directory, *.*;*
STICKLEN:                               ; its length
        .BLKB   1
NAM:    $NAM    ESA=EXP, ESS=255, RSA=RES, RSS=255
EXP:    .BLKB   255
RES:    .BLKB   255
LINE:   .BLKB   256                     ; a line being made, .ASCIC
SLOT:   .LONG   0                       ; the columns its names take
FILES:  .LONG   0                       ; in this directory
DIRS:   .LONG   0                       ; the directories before it,
GFILES: .LONG   0                       ; their files
GUSED:  .LONG   0                       ; and blocks
GALLOC: .LONG   0
CURDIR: .BLKB   256                     ; its device and directory, .ASCIC
DETAIL: .LONG   0                       ; D_x bits: what to list
DATES:  .LONG   0                       ; bit n: DATEADR's nth date
COLUMNS:                                ; names to a line
        .LONG   4
VERSIONS:                               ; of each name
        .LONG   -1
VERSION:                                ; this name's, so far
        .LONG   0
LASTNAME:                               ; the last file's, up to its version, .ASCIC
        .BLKB   256
NUMDSC:                                 ; /COLUMNS's or /VERSIONS's value
        .LONG   10
        .ADDRESS NUM
NUM:    .BLKB   10
FAB2:   $FAB    FNA=RES, XAB=XAB        ; $OPEN's, of the file $SEARCH found
XAB:    $XABPRO NXT=DAT
DAT:    $XABDAT NXT=FHC
FHC:    $XABFHC
SUM:    $XABSUM                         ; an indexed file's keys
FUSED:  .LONG   0                       ; the file's blocks used
USED:   .LONG   0                       ; the directory's: used
ALLOC:  .LONG   0                       ; and allocated
TIME:   .BLKB   23                      ; a time, as $ASCTIM writes it
TIMEDSC:
        .LONG   23
        .ADDRESS TIME
DATEADR:                                ; /DATE's, in VMS's order: CREATED,
        .ADDRESS DAT+XAB$Q_CDT          ; MODIFIED, EXPIRED, BACKUP, then
        .ADDRESS DAT+XAB$Q_RDT          ; EFFECTIVE, RECORDING, ACCESSED,
        .ADDRESS DAT+XAB$Q_EDT          ; ATTRIBUTES and DATA_MODIFIED,
        .ADDRESS DAT+XAB$Q_BDT          ; which Files-11 doesn't keep
        .LONG   0, 0, 0, 0, 0
LETTERS:                                ; the access a protection's bits deny
        .ASCII  "RWED"
CATS:   .BYTE   0, 8, 15, 22            ; each category's name in CATNAMES
CATNAMES:
        .ASCIC  "System:"
        .ASCIC  "Owner:"
        .ASCIC  "Group:"
        .ASCIC  "World:"
DIRTYPE:
        .ASCII  ".DIR"

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7, R8>
        IFPRESENT "OWNER", <1@D_OWNER>, DETAIL
        IFPRESENT "PROTECTION", <1@D_PROT>, DETAIL
        IFPRESENT "FULL", <<1@D_FULL>!M_SIZE>, DETAIL
        IFPRESENT "TOTAL", <1@D_TOTAL>, DETAIL
        PRESENT "SIZE"
        BLBC    R0, 2$
        IFPRESENT "SIZE.ALL", M_SIZE, DETAIL
        IFPRESENT "SIZE.ALLOCATION", <1@D_ALLOC>, DETAIL
        BITL    #M_SIZE, DETAIL
        BNEQ    2$
        BISL2   #1@D_USED, DETAIL       ; USED, unless it says
2$:     PRESENT "DATE"
        BLBC    R0, 3$
        IFPRESENT "DATE.CREATED", 1, DATES
        IFPRESENT "DATE.MODIFIED", 2, DATES
        IFPRESENT "DATE.EXPIRED", 4, DATES
        IFPRESENT "DATE.BACKUP", 8, DATES
        IFPRESENT "DATE.EFFECTIVE", 16, DATES
        IFPRESENT "DATE.RECORDING", 32, DATES
        IFPRESENT "DATE.ACCESSED", 64, DATES
        IFPRESENT "DATE.ATTRIBUTES", 128, DATES
        IFPRESENT "DATE.DATA_MODIFIED", 256, DATES
        IFPRESENT "DATE.ALL", <<1@DATEMAX>-1>, DATES
        TSTL    DATES
        BNEQ    3$
        INCL    DATES                   ; CREATED, unless it says
3$:     PRESENT "COLUMNS"
        BLBC    R0, 4$
        GETVALUE "COLUMNS", NUMDSC, NUMDSC
        BSBW    NUMBER
        BLBC    R0, 90$
        MOVL    R1, COLUMNS
        BNEQ    35$
        INCL    COLUMNS                 ; 0 is 1
35$:    CMPL    COLUMNS, #LINEMAX/COLUMN
        BLEQU   4$
        MOVL    #LINEMAX/COLUMN, COLUMNS ; as many as fit
4$:     PRESENT "VERSIONS"
        BLBC    R0, 45$
        MOVL    #10, NUMDSC
        GETVALUE "VERSIONS", NUMDSC, NUMDSC
        BSBW    NUMBER
        BLBC    R0, 90$
        MOVL    R1, VERSIONS
        BNEQ    45$
        BSBW    SYNTAX                  ; 0 isn't a number of versions
        BRB     90$
45$:    GETVALUE "FILE", SPECDSC, SPECDSC
        MOVL    R0, MORE
        BLBS    R0, 5$
        CLRL    SPECDSC
5$:     MOVB    SPECDSC, FAB+FAB$B_FNS
        $PARSE  FAB=FAB
        BLBC    R0, 90$
        BSBW    STICK
10$:    $SEARCH FAB=FAB
        BLBC    R0, 50$
        BSBW    NEWVER
        BLBC    R0, 10$
        BSBW    NEWDIR
        INCL    FILES
        BBC     #D_TOTAL, DETAIL, 20$
        BITL    #M_SIZE, DETAIL
        BEQL    10$
        BSBW    OPEN                    ; /TOTAL: only its blocks
        BRB     10$
20$:    BBC     #D_FULL, DETAIL, 22$
        BSBW    FULL
        BRB     10$
22$:    BITL    #M_LINE, DETAIL
        BNEQ    25$
        TSTL    DATES
        BEQL    30$
25$:    BSBW    DETAILS
        BRB     10$
30$:    BSBW    BRIEF
        BRB     10$
50$:    CMPL    R0, #RMS$_NMF
        BEQL    55$
        CMPL    R0, #RMS$_FNF
        BNEQ    90$
55$:    BSBW    NEXTSPEC
        BLBC    R0, 57$
        BRW     5$
57$:    TSTL    FILES
        BNEQ    60$
        PRINT   "%DIRECT-W-NOFILES, no files found"
        BRB     80$
60$:    BSBW    TOTAL
        CMPL    DIRS, #1
        BLEQ    80$
        PRINT   ""
        ADDTEXT "Grand total of "
        MOVL    DIRS, R1
        BSBW    ADDDEC
        ADDTEXT " directories, "
        MOVL    GFILES, R1
        MOVL    GUSED, R2
        MOVL    GALLOC, R3
        BSBW    COUNTS
        BSBW    SAY
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; STICK: after $PARSE, the next specification's default: the device
; and directory of the expanded string, then *.*;*, in STICKY. Uses
; R0-R5.
STICK:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM+NAM$B_DEV, R2
        MOVZBL  NAM+NAM$B_DIR, R0
        ADDL2   R0, R2
        PUSHL   R2
        MOVC3   R2, @NAM+NAM$L_DEV, STICKY
        MOVL    (SP)+, R2
        ADDB3   #DEFLEN, R2, STICKLEN
        MOVC3   #DEFLEN, DEFSPEC, STICKY[R2]
        RSB

; NEXTSPEC: the next specification of FILE's list into SPEC, if MORE
; says one follows, and STICKY FAB's default. One that names a device
; or a directory empties CURDIR, for a heading of its own. R0 = 1 if
; there is one, 0 if not. Uses R0-R5.
NEXTSPEC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CMPL    MORE, #CLI$_COMMA
        BEQL    10$
        CMPL    MORE, #CLI$_CONCAT
        BEQL    10$
        CLRL    R0
        RSB
10$:    MOVB    STICKLEN, FAB+FAB$B_DNS
        MOVAB   STICKY, FAB+FAB$L_DNA
        MOVL    #255, SPECDSC
        GETVALUE "FILE", SPECDSC, SPECDSC
        MOVL    R0, MORE
        MOVZWL  SPECDSC, R2
20$:    DECL    R2
        BLSS    40$
        CMPB    SPEC[R2], #58           ; :
        BEQL    30$
        CMPB    SPEC[R2], #91           ; [
        BEQL    30$
        CMPB    SPEC[R2], #60           ; <
        BNEQ    20$
30$:    CLRB    CURDIR
40$:    MOVL    #1, R0
        RSB

; NUMBER: NUMDSC = a qualifier's value. R1 = it, if it is decimal
; digits, and R0 = 1; or, as VMS's DIRECTORY, it says it can't parse it,
; and R0 = DIRECT_SYNTAX. Uses R0-R5.
NUMBER:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CLRL    R1
        CLRL    R2
        MOVZWL  NUMDSC, R3
        BEQL    SYNTAX
10$:    MOVZBL  NUM[R2], R0
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BGTRU   SYNTAX
        MULL2   #10, R1
        ADDL2   R0, R1
        AOBLSS  R3, R2, 10$
        MOVL    #1, R0
        RSB
; SYNTAX: says NUMDSC's value can't be parsed. R0 = DIRECT_SYNTAX. Uses
; R0-R5.
SYNTAX:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        ADDTEXT "%DIRECT-F-SYNTAX, error parsing '"
        MOVAB   NUM, R1
        MOVZWL  NUMDSC, R2
        BSBW    ADD
        ADDTEXT "'"
        BSBW    SAY
        MOVL    #DIRECT_SYNTAX, R0
        RSB

; NEWVER: R0 = 1 if the file $SEARCH found is one of the VERSIONS highest
; of its name, which $SEARCH finds highest first; 0 if not. Uses R0-R5.
NEWVER:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        SUBL3   #RES, NAM+NAM$L_VER, R2 ; up to its version
        MOVZBL  LASTNAME, R0
        CMPC5   R2, RES, #0, R0, LASTNAME+1
        BEQL    10$
        SUBL3   #RES, NAM+NAM$L_VER, R2 ; another name
        MOVB    R2, LASTNAME
        MOVC3   R2, RES, LASTNAME+1
        CLRL    VERSION
10$:    INCL    VERSION
        CLRL    R0
        CMPL    VERSION, VERSIONS
        BGTRU   90$
        INCL    R0
90$:    RSB

; BRIEF: adds the name of the file $SEARCH found to the line of names,
; in the next column, or the next line's first if the line has COLUMNS
; names or no room. Uses R0-R5.
BRIEF:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM+NAM$B_NAME, R2      ; NAME.TYPE;VERSION
        ADDB2   NAM+NAM$B_TYPE, R2
        ADDB2   NAM+NAM$B_VER, R2
        DIVL3   #COLUMN, R2, R5         ; R5 = the columns it takes
        INCL    R5
        TSTL    SLOT
        BEQL    20$
        CMPL    SLOT, COLUMNS
        BGEQU   10$
        ADDL3   SLOT, R5, R0
        CMPL    R0, #LINEMAX/COLUMN
        BLEQU   15$
10$:    BSBW    SAY
        BRB     20$
15$:    MULL3   #COLUMN, SLOT, R3
        BSBW    PADTO
20$:    MOVZBL  NAM+NAM$B_NAME, R2
        ADDB2   NAM+NAM$B_TYPE, R2
        ADDB2   NAM+NAM$B_VER, R2
        MOVL    NAM+NAM$L_NAME, R1
        BSBW    ADD
        ADDL2   R5, SLOT
        RSB

; NEWDIR: before the file $SEARCH found, if its directory isn't the last
; one's: that one's total, then its heading. Uses R0-R5.
NEWDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM+NAM$B_DEV, R2
        ADDB2   NAM+NAM$B_DIR, R2
        MOVZBL  CURDIR, R0
        CMPC5   R2, @NAM+NAM$L_DEV, #0, R0, CURDIR+1
        BNEQ    10$
        TSTL    DIRS                    ; the same, but for the first
        BNEQ    90$
        TSTL    FILES
        BNEQ    90$
10$:    TSTL    FILES
        BEQL    20$
        BSBW    TOTAL
20$:    MOVZBL  NAM+NAM$B_DEV, R2
        ADDB2   NAM+NAM$B_DIR, R2
        MOVB    R2, CURDIR
        MOVC3   R2, @NAM+NAM$L_DEV, CURDIR+1
        PRINT   ""
        ADDTEXT "Directory "
        MOVAB   CURDIR, R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        BSBW    SAY
        PRINT   ""
90$:    RSB

; TOTAL: ends the directory's list with how many files it has, and adds
; them, and their blocks, to the grand total. Uses R0-R5.
TOTAL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        TSTB    LINE
        BEQL    10$
        BSBW    SAY
10$:    BBS     #D_TOTAL, DETAIL, 20$   ; under its heading
        PRINT   ""
20$:    ADDTEXT "Total of "
        MOVL    FILES, R1
        MOVL    USED, R2
        MOVL    ALLOC, R3
        BSBW    COUNTS
        BSBW    SAY
        INCL    DIRS
        ADDL2   FILES, GFILES
        ADDL2   USED, GUSED
        ADDL2   ALLOC, GALLOC
        CLRQ    USED                    ; and ALLOC
        CLRL    FILES
        RSB

; COUNTS: appends "R1 files.", or "file" for one, and with /SIZE or
; /FULL ", R2 blocks", or R3 with /SIZE=ALLOCATION, or "R2/R3 blocks" for
; both, to LINE. Uses R0-R5.
COUNTS:
        .JSB_ENTRY  SCRATCH=<R4, R5>
        PUSHR   #^M<R1, R2, R3>
        BSBW    ADDDEC
        CMPL    (SP), #1
        BEQL    10$
        ADDTEXT " files"
        BRB     20$
10$:    ADDTEXT " file"
20$:    BITL    #M_SIZE, DETAIL
        BEQL    30$                     ; and their blocks
        ADDTEXT ", "
        MOVL    4(SP), R1
        BBC     #D_ALLOC, DETAIL, 25$
        MOVL    8(SP), R1
        BBC     #D_USED, DETAIL, 25$
        MOVL    4(SP), R1               ; both
        BSBW    ADDDEC
        ADDTEXT "/"
        MOVL    8(SP), R1
        BSBW    ADDDEC
        BRB     27$
25$:    PUSHL   R1
        BSBW    ADDDEC
        CMPL    (SP)+, #1
        BNEQ    27$
        ADDTEXT " block"
        BRB     30$
27$:    ADDTEXT " blocks"
30$:    ADDTEXT "."
        POPR    #^M<R1, R2, R3>
        RSB

; DETAILS: writes a line for the file $SEARCH found: its name, then, as
; DETAIL and DATES ask, its blocks, dates, owner and protection, in VMS's
; columns, or, if the process may not read it, VMS's words for that.
; Uses R0-R8.
DETAILS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8>
        MOVZBL  NAM+NAM$B_NAME, R2      ; NAME.TYPE;VERSION
        ADDB2   NAM+NAM$B_TYPE, R2
        ADDB2   NAM+NAM$B_VER, R2
        MOVL    NAM+NAM$L_NAME, R1
        BSBW    ADD
        CMPB    LINE, #NAMEMAX
        BLEQU   5$
        BSBW    SAY                     ; too long: a line of its own
5$:     MOVL    #NAMEMAX+1, R6          ; R6 = where the next column starts
        BSBW    OPEN
        BLBS    R0, 10$
        CMPL    R0, #RMS$_PRV
        BNEQ    80$
        MOVL    R6, R3
        BSBW    PADTO
        ADDTEXT "  No privilege for attempted operation"
        BRB     80$
10$:    BITL    #M_SIZE, DETAIL
        BEQL    20$
        MOVL    FUSED, R1               ; blocks: used, ending in column 31,
        BBS     #D_USED, DETAIL, 12$
        MOVL    FAB2+FAB$L_ALQ, R1      ; or allocated
12$:    MOVL    #31, R3
        BSBW    RIGHT
        MOVL    #31, R6
        BBC     #D_USED, DETAIL, 20$
        BBC     #D_ALLOC, DETAIL, 20$
        ADDTEXT "/"                     ; or both
        MOVL    FAB2+FAB$L_ALQ, R1
        BSBW    ADDDEC
        MOVL    #42, R6
20$:    CLRL    R7                      ; each date asked for
22$:    BBC     R7, DATES, 28$
        MOVL    R6, R3
        BSBW    PADTO
        MOVL    DATEADR[R7], R8
        BEQL    24$
        TSTL    (R8)
        BNEQ    23$
        TSTL    4(R8)
        BEQL    24$
23$:    ADDTEXT "  "
        MOVL    R8, R0
        BSBW    ADDTIME
        BRB     27$
24$:    CMPL    R7, #3
        BNEQ    25$
        ADDTEXT "   <No backup recorded>"
        BRB     27$
25$:    ADDTEXT "   <None specified>"
27$:    MOVZBL  LINE, R6
28$:    AOBLSS  #DATEMAX, R7, 22$
        BBC     #D_OWNER, DETAIL, 40$
        MOVL    R6, R3                  ; [group,member], in octal, and
        BSBW    PADTO                   ; room for an identifier's
        ADDL2   #33, R6
        ADDTEXT "  ["
        MOVZWL  XAB+XAB$L_UIC+2, R1
        BSBW    ADDOCT
        ADDTEXT ","
        MOVZWL  XAB+XAB$L_UIC, R1
        BSBW    ADDOCT
        ADDTEXT "]"
40$:    BBC     #D_PROT, DETAIL, 80$
        MOVL    R6, R3                  ; (RWED,RWED,RE,): what each may do
        BSBW    PADTO
        ADDTEXT "  ("
        MOVZWL  XAB+XAB$W_PRO, R4
        CLRL    R5                      ; the category
50$:    CLRL    R3                      ; the bit
55$:    BBS     R3, R4, 57$
        MOVZBL  LETTERS[R3], R0
        BSBW    ADDCHAR
57$:    AOBLSS  #4, R3, 55$
        ASHL    #-4, R4, R4
        AOBLSS  #4, R5, 60$
        ADDTEXT ")"
80$:    BRW     SAY
60$:    MOVZBL  #44, R0
        BSBW    ADDCHAR
        BRB     50$

; OPEN: opens and closes the file $SEARCH found, for its XABs, and an
; indexed file's keys in SUM; FUSED = the blocks it uses, which, and the
; blocks it has, it adds to USED and ALLOC. R0 = $OPEN's status. Uses
; R0-R5.
OPEN:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVB    NAM+NAM$B_RSL, FAB2+FAB$B_FNS
        $OPEN   FAB=FAB2
        BLBS    R0, 5$
        RSB
5$:     MOVAB   SUM, FAB2+FAB$L_XAB     ; an indexed file's keys
        CMPB    FAB2+FAB$B_ORG, #FAB$C_IDX
        BNEQ    7$
        $DISPLAY FAB=FAB2
7$:     MOVAB   XAB, FAB2+FAB$L_XAB
        $CLOSE  FAB=FAB2
        MOVL    FHC+XAB$L_EBK, R1       ; used: up to the end of file, or
        BEQL    10$                     ; all of an indexed file's that
        DECL    R1                      ; has none
        TSTW    FHC+XAB$W_FFB
        BEQL    12$
        INCL    R1
        BRB     12$
10$:    MOVL    FAB2+FAB$L_ALQ, R1
12$:    MOVL    R1, FUSED
        ADDL2   R1, USED
        ADDL2   FAB2+FAB$L_ALQ, ALLOC
        MOVL    #1, R0
        RSB

; FULL: writes what VMS's DIRECTORY/FULL does about the file $SEARCH
; found, from $OPEN's XABs, and adds its blocks to USED and ALLOC. Uses
; R0-R5.
FULL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM+NAM$B_NAME, R2      ; NAME.TYPE;VERSION
        ADDB2   NAM+NAM$B_TYPE, R2
        ADDB2   NAM+NAM$B_VER, R2
        MOVL    NAM+NAM$L_NAME, R1
        BSBW    ADD
        MOVL    #30, R3
        BSBW    PADTO
        BSBW    OPEN
        BLBS    R0, 5$
        ADDTEXT "No privilege for attempted operation"
        BSBW    SAY
        PRINT   ""
        RSB
5$:     ADDTEXT "File ID:  ("
        MOVZWL  NAM+NAM$W_FID, R1
        BSBW    ADDDEC
        ADDTEXT ","
        MOVZWL  NAM+NAM$W_FID+2, R1
        BSBW    ADDDEC
        ADDTEXT ","
        MOVZWL  NAM+NAM$W_FID+4, R1
        BSBW    ADDDEC
        ADDTEXT ")"
        MOVL    #62, R3
        BSBW    PADTO
        BSBW    SAY
        ADDTEXT "Size:"
        MOVL    FUSED, R1
        MOVL    #18, R3
        BSBW    RIGHT
        ADDTEXT "/"
        MOVL    FAB2+FAB$L_ALQ, R1
        BSBW    ADDDEC
        MOVL    #30, R3
        BSBW    PADTO
        ADDTEXT "Owner:    ["
        MOVZWL  XAB+XAB$L_UIC+2, R1
        BSBW    ADDOCT
        ADDTEXT ","
        MOVZWL  XAB+XAB$L_UIC, R1
        BSBW    ADDOCT
        ADDTEXT "]"
        BSBW    SAY
        ADDTEXT "Created:    "
        MOVAB   DAT+XAB$Q_CDT, R0
        BSBW    ADDTIME
        BSBW    SAY
        ADDTEXT "Modified:   "
        MOVAB   DAT+XAB$Q_RDT, R0
        BSBW    ADDTIME
        ADDTEXT " ("
        MOVZWL  DAT+XAB$W_RVN, R1
        BSBW    ADDDEC
        ADDTEXT ")"
        BSBW    SAY
        ADDTEXT "Expires:    "
        MOVAB   DAT+XAB$Q_EDT, R0
        TSTL    (R0)
        BNEQ    15$
        TSTL    4(R0)
        BNEQ    15$
        ADDTEXT "<None specified>"
        BRB     17$
15$:    BSBW    ADDTIME
17$:    BSBW    SAY
        ADDTEXT "Backup:     "
        MOVAB   DAT+XAB$Q_BDT, R0
        TSTL    (R0)
        BNEQ    18$
        TSTL    4(R0)
        BNEQ    18$
        ADDTEXT "<No backup recorded>"
        BRB     19$
18$:    BSBW    ADDTIME
19$:    BSBW    SAY
        PRINT   "Effective:  <None specified>"
        PRINT   "Recording:  <None specified>"
        PRINT   "Accessed:   <None specified>"
        PRINT   "Attr Mod:   <None specified>"
        PRINT   "Data Mod:   <None specified>"
        PRINT   "Linkcount:  1"
        ADDTEXT "File organization:  "
        MOVZBL  FAB2+FAB$B_ORG, R0
        CMPL    R0, #FAB$C_REL
        BEQL    22$
        BGTRU   24$
        ADDTEXT "Sequential"
        BRB     26$
22$:    ADDTEXT "Relative, maximum record number: "
        MOVL    FAB2+FAB$L_MRN, R1
        BSBW    ADDDEC
        BRB     26$
24$:    ADDTEXT "Indexed, Prolog: "
        MOVZWL  SUM+XAB$W_PVN, R1
        BSBW    ADDDEC
        ADDTEXT ", Using "
        MOVZBL  SUM+XAB$B_NOK, R1
        BSBW    ADDDEC
        ADDTEXT " key"
        CMPB    SUM+XAB$B_NOK, #1
        BEQL    25$
        ADDTEXT "s"
25$:    CMPB    SUM+XAB$B_NOA, #1       ; and its areas, if more than one
        BLEQU   26$
        BSBW    SAY
        MOVL    #29, R3
        BSBW    PADTO
        ADDTEXT "In "
        MOVZBL  SUM+XAB$B_NOA, R1
        BSBW    ADDDEC
        ADDTEXT " areas"
26$:    BSBW    SAY
        PRINT   "Shelved state:      Online "
        PRINT   "Caching attribute:  Writethrough"
        ADDTEXT "File attributes:    Allocation: "
        MOVL    FAB2+FAB$L_ALQ, R1
        BSBW    ADDDEC
        ADDTEXT ", Extend: "
        MOVZWL  FAB2+FAB$W_DEQ, R1
        BSBW    ADDDEC
        CMPB    FAB2+FAB$B_ORG, #FAB$C_REL
        BLSSU   30$
        BGTRU   28$
        ADDTEXT ", Bucket size: "
        BRB     29$
28$:    ADDTEXT ", Maximum bucket size: "
29$:    MOVZBL  FAB2+FAB$B_BKS, R1
        BSBW    ADDDEC
30$:    ADDTEXT ", Global buffer count: 0"
        BSBW    ISDIR
        BLBS    R0, 32$
        ADDTEXT ", No version limit"
        BRB     34$
32$:    ADDTEXT ", No default version limit, Contiguous, Directory file"
34$:    BSBW    SAY
        ADDTEXT "Record format:      "
        BSBW    RECFMT
        BSBW    SAY
        ADDTEXT "Record attributes:  "
        BBC     #FAB$V_CR, FAB2+FAB$B_RAT, 40$
        ADDTEXT "Carriage return carriage control"
        BRB     46$
40$:    BBC     #FAB$V_FTN, FAB2+FAB$B_RAT, 42$
        ADDTEXT "Fortran carriage control"
        BRB     46$
42$:    BBC     #FAB$V_PRN, FAB2+FAB$B_RAT, 44$
        ADDTEXT "Print file carriage control"
        BRB     46$
44$:    ADDTEXT "No carriage control"
46$:    BBC     #FAB$V_BLK, FAB2+FAB$B_RAT, 48$
        ADDTEXT ", Non-spanned"
48$:    BSBW    SAY
        PRINT   "RMS attributes:     None"
        PRINT   "Journaling enabled: None"
        ADDTEXT "File protection:    "
        MOVZWL  XAB+XAB$W_PRO, R4
        CLRL    R5                      ; each category: what it may do
50$:    MOVZBL  CATS[R5], R0
        MOVAB   CATNAMES[R0], R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        CLRL    R3
52$:    BBS     R3, R4, 54$
        MOVZBL  LETTERS[R3], R0
        BSBW    ADDCHAR
54$:    AOBLSS  #4, R3, 52$
        ASHL    #-4, R4, R4
        INCL    R5
        CMPL    R5, #4
        BGEQU   56$
        ADDTEXT ", "
        BRB     50$
56$:    BSBW    SAY
        PRINT   "Access Cntrl List:  None"
        PRINT   "Client attributes:  None"
        PRINT   ""
        RSB

; RECFMT: appends FAB2's record format, as DIRECTORY/FULL words it.
; Uses R0-R5.
RECFMT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  FAB2+FAB$B_RFM, R0
        CMPL    R0, #FAB$C_FIX
        BNEQ    10$
        ADDTEXT "Fixed length "
        MOVZWL  FAB2+FAB$W_MRS, R1
        BSBW    ADDDEC
        ADDTEXT " byte records"
        RSB
10$:    TSTL    R0
        BNEQ    20$
        ADDTEXT "Undefined"
        RSB
20$:    CMPL    R0, #FAB$C_VAR
        BNEQ    30$
        ADDTEXT "Variable length"
        BRB     80$
30$:    CMPL    R0, #FAB$C_VFC
        BNEQ    40$
        ADDTEXT "VFC, "
        MOVZBL  FAB2+FAB$B_FSZ, R1
        BSBW    ADDDEC
        ADDTEXT " byte header"
        BRB     80$
40$:    CMPL    R0, #FAB$C_STM
        BNEQ    50$
        ADDTEXT "Stream"
        BRB     80$
50$:    CMPL    R0, #FAB$C_STMLF
        BNEQ    60$
        ADDTEXT "Stream_LF"
        BRB     80$
60$:    ADDTEXT "Stream_CR"
80$:    ADDTEXT ", maximum "
        MOVZWL  FAB2+FAB$W_MRS, R1
        BSBW    ADDDEC
        ADDTEXT " bytes, longest "
        MOVZWL  FHC+XAB$W_LRL, R1
        BSBW    ADDDEC
        ADDTEXT " bytes"
        RSB

; ISDIR: R0 = 1 if the file $SEARCH found is a directory, NAME.DIR;1.
; Uses R0-R1.
ISDIR:
        .JSB_ENTRY
        CLRL    R0
        CMPB    NAM+NAM$B_TYPE, #4
        BNEQ    90$
        MOVL    NAM+NAM$L_TYPE, R1
        CMPL    (R1), DIRTYPE
        BNEQ    90$
        INCL    R0
90$:    RSB

; ADDTIME: R0 = a quadword time. Appends it, as $ASCTIM writes it. Uses
; R0-R5.
ADDTIME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $ASCTIM_S TIMBUF=TIMEDSC, TIMADR=(R0)
        MOVAB   TIME, R1
        MOVL    #23, R2
        BSBW    ADD
        RSB

; RIGHT: R1 = a value, R3 = a column. Appends it in decimal, ending at the
; column, blanks before it. Uses R0-R5.
RIGHT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R1, R4                  ; its digits
        MOVL    #1, R2
10$:    DIVL2   #10, R4
        BEQL    20$
        INCL    R2
        BRB     10$
20$:    SUBL2   R2, R3
        PUSHL   R1
        BSBW    PADTO
        MOVL    (SP)+, R1
        BSBW    ADDDEC
        RSB

; PADTO: appends blanks to LINE until it is R3 characters long. Uses R0-R2.
PADTO:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
        CMPL    R0, R3
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
        BRB     PADTO
10$:    RSB

; ADDDEC: appends R1 in decimal to LINE, ADDOCT in octal. Uses R0-R5.
ADDDEC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    #10, R3
        BRB     ADDNUM
ADDOCT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    #8, R3
ADDNUM: .GLOBAL_LABEL                   ; ADDDEC's too
        CLRL    R4                      ; digits, on the stack
10$:    DIVL3   R3, R1, R5
        MULL3   R3, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R4
        MOVL    R5, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBB    ADDCHAR
        SOBGTR  R4, 30$
        RSB

; SAY: writes the line in LINE, and empties it. Uses R0 and R1.
SAY:
        .JSB_ENTRY
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        CLRL    SLOT
        RSB

; ADDCHAR: appends the character in R0 to LINE. Uses R0-R2.
ADDCHAR:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
; ADD: appends the R2 bytes at R1 to LINE, as many as fit. Uses R0-R2.
ADD:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, LINE[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, LINE
        RSB

        .PSECT  DATA
CHAR:   .BLKB   1

        .END    START
