        .TITLE  PRINT   Console output for the system disk's programs
        .IDENT  /V0.1/
;
; PUT_LINE writes a line with LIB$PUT_OUTPUT, in LIBRTL.EXE, on SYS$OUTPUT
; (librtl/putoutput.mar). build.rs links this module into each program;
; sysexe.mlb's PRINT and PRINTHEX call it, and a program written for VMS
; calls LIB$PUT_OUTPUT itself.
;
        .EXTERNAL LIB$PUT_OUTPUT

        .PSECT  PRINT_DATA, NOEXE, WRT, LONG
HEX:    .ASCII  "0123456789ABCDEF"
LINE:   .BLKB   264                     ; the text, then the value
DESC:   .WORD   0                       ; LINE's descriptor: the length
        .BYTE   14, 1                   ; DSC$K_DTYPE_T, DSC$K_CLASS_S
        .ADDRESS LINE

        .PSECT  PRINT_CODE, EXE, LONG
; PUT_LINE text, value: writes the .ASCIC text, value in 8 hex digits if
; there is a value, and CR LF. R0 = LIB$PUT_OUTPUT's status.
        .ENTRY  PUT_LINE, ^M<R2, R3, R4>
        MOVL    4(AP), R1
        MOVZBL  (R1)+, R2
        CLRL    R3                      ; the bytes in LINE
10$:    CMPL    R3, R2
        BGEQU   20$
        MOVB    (R1)[R3], LINE[R3]
        INCL    R3
        BRB     10$
20$:    CMPB    (AP), #2
        BLSSU   40$
        MOVL    8(AP), R4
        MOVL    #8, R2
30$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVB    HEX[R0], LINE[R3]
        INCL    R3
        SOBGTR  R2, 30$
40$:    MOVW    R3, DESC
        PUSHAB  DESC
        CALLS   #1, G^LIB$PUT_OUTPUT
        RET

        .END
