        .TITLE  PRVNAM  The privileges' names
        .IDENT  /V0.1/
;
; SET PROCESS/PRIVILEGES, SHOW PROCESS/PRIVILEGES and AUTHORIZE name the
; privileges as VMS does. build.rs links this module into each image, as
; it does lib/print.mar.
;
        .PSECT  PRVNAM_DATA, NOEXE, NOWRT, LONG
; PRV_NAMES: each privilege's name, .ASCIC, by its $PRVDEF bit, then a 0.
PRV_NAMES::
        .ASCIC  "CMKRNL"
        .ASCIC  "CMEXEC"
        .ASCIC  "SYSNAM"
        .ASCIC  "GRPNAM"
        .ASCIC  "ALLSPOOL"
        .ASCIC  "DETACH"
        .ASCIC  "DIAGNOSE"
        .ASCIC  "LOG_IO"
        .ASCIC  "GROUP"
        .ASCIC  "NOACNT"
        .ASCIC  "PRMCEB"
        .ASCIC  "PRMMBX"
        .ASCIC  "PSWAPM"
        .ASCIC  "ALTPRI"
        .ASCIC  "SETPRV"
        .ASCIC  "TMPMBX"
        .ASCIC  "WORLD"
        .ASCIC  "MOUNT"
        .ASCIC  "OPER"
        .ASCIC  "EXQUOTA"
        .ASCIC  "NETMBX"
        .ASCIC  "VOLPRO"
        .ASCIC  "PHY_IO"
        .ASCIC  "BUGCHK"
        .ASCIC  "PRMGBL"
        .ASCIC  "SYSGBL"
        .ASCIC  "PFNMAP"
        .ASCIC  "SHMEM"
        .ASCIC  "SYSPRV"
        .ASCIC  "BYPASS"
        .ASCIC  "SYSLCK"
        .ASCIC  "SHARE"
        .ASCIC  "UPGRADE"
        .ASCIC  "DOWNGRADE"
        .ASCIC  "GRPPRV"
        .ASCIC  "READALL"
        .ASCIC  "IMPORT"
        .ASCIC  "AUDIT"
        .ASCIC  "SECURITY"
        .BYTE   0
ALLNAM: .ASCIC  "ALL"
ALL:    .LONG   ^XFFFFFFFF, ^X7F        ; every privilege

        .PSECT  PRVNAM_CODE, EXE, LONG
; PRV_LOOKUP name, len, mask: the privilege the len characters at name
; name, in capitals, or ALL: puts its bit, or every one for ALL, in the
; quadword at mask, cleared first. R0 = 1, or 0 for a name it doesn't
; know.
        .ENTRY  PRV_LOOKUP, ^M<R2, R3, R4, R5, R6>
        MOVL    4(AP), R5
        MOVL    8(AP), R6
        MOVL    12(AP), R4
        CLRQ    (R4)
        MOVAB   ALLNAM, R1
        BSBB    MATCH
        BLBC    R0, 5$
        MOVQ    ALL, (R4)
        RET
5$:     MOVAB   PRV_NAMES, R1
        CLRL    R2                      ; its bit
10$:    TSTB    (R1)
        BEQL    80$
        PUSHL   R1
        BSBB    MATCH
        MOVL    (SP)+, R1
        BLBS    R0, 20$
        MOVZBL  (R1), R0
        ADDL2   R0, R1
        INCL    R1
        INCL    R2
        BRB     10$
20$:    BBSS    R2, (R4), 30$
30$:    MOVL    #1, R0
        RET
80$:    CLRL    R0
        RET

; MATCH: R1 = a .ASCIC name, R5 = a value, R6 = its length. R0 = 1 if
; they are the same, else 0. Uses R0, R1 and R3.
MATCH:
        .JSB_ENTRY  SCRATCH=<R3>
        MOVZBL  (R1)+, R0
        CMPL    R0, R6
        BNEQ    80$
        CLRL    R3
10$:    CMPL    R3, R6
        BEQL    70$
        CMPB    (R1)[R3], (R5)[R3]
        BNEQ    80$
        INCL    R3
        BRB     10$
70$:    MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

        .END
