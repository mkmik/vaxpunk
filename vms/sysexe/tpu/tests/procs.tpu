! Procedures: parameters in and out, optional ones, results, recursion,
! locals, globals, constants.
CONSTANT user_ten := 10, user_hello := "Hello";
VARIABLE counter;
PROCEDURE fact (n)
    IF n <= 1 THEN RETURN 1; ENDIF;
    RETURN n * fact (n - 1);
ENDPROCEDURE;
PROCEDURE swap (a, b)
    LOCAL t;
    t := a;
    a := b;
    b := t;
ENDPROCEDURE;
PROCEDURE opt (a; b, c)
    LOCAL s;
    s := STR (a);
    IF b = TPU$K_UNSPECIFIED THEN s := s + " no-b"; ELSE s := s + " b=" + STR (b); ENDIF;
    IF GET_INFO (c, "type") = UNSPECIFIED THEN s := s + " no-c"; ELSE s := s + " c=" + STR (c); ENDIF;
    RETURN s;
ENDPROCEDURE;
PROCEDURE by_name
    by_name := 7;
ENDPROCEDURE;
PROCEDURE nothing
ENDPROCEDURE;
PROCEDURE local_zero
    LOCAL x;
    RETURN x;
ENDPROCEDURE;
PROCEDURE bump
    counter := counter + 1;
ENDPROCEDURE;
PROCEDURE early (x)
    IF x THEN RETURN; ENDIF;
    MESSAGE ("not early");
ENDPROCEDURE;
PROCEDURE add (int1, int2)
    MESSAGE (STR (int1 + int2));
ENDPROCEDURE;
MESSAGE (STR (fact (10)));
x := 1;
y := 2;
swap (x, y);
MESSAGE (STR (x) + " " + STR (y));
MESSAGE (opt (1));
MESSAGE (opt (1, 2));
MESSAGE (opt (1, 2, 3));
MESSAGE (opt (1, , 3));
MESSAGE (STR (by_name));
MESSAGE (STR (nothing));
MESSAGE (STR (local_zero));
counter := 0;
bump;
bump;
bump;
MESSAGE (STR (counter));
early (1);
early (0);
add (5, 6);
MESSAGE (user_hello + " " + STR (user_ten));
z := 5;
swap (z, y);
MESSAGE (STR (z) + " " + STR (y));
QUIT (OFF);
