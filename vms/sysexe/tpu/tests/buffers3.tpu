! Reading into a buffer, overstrike past the end, MOVE_TEXT of a buffer,
! CHANGE_CASE of ranges, WRITE_FILE of a range.
b := CREATE_BUFFER ("main");
POSITION (b);
COPY_TEXT ("top line");
SPLIT_LINE;
COPY_TEXT ("bottom line");
POSITION (2);
f := READ_FILE ("DATA.TXT");
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (BEGINNING_OF (b));
MESSAGE (CURRENT_LINE);
MOVE_VERTICAL (1);
MESSAGE (CURRENT_LINE);
POSITION (END_OF (b));
MOVE_VERTICAL (-1);
MESSAGE (CURRENT_LINE);
SET (OVERSTRIKE, b);
MOVE_HORIZONTAL (7);
COPY_TEXT ("LINE AND MORE");
MESSAGE (CURRENT_LINE);
SET (INSERT, b);
POSITION (BEGINNING_OF (b));
MOVE_VERTICAL (1);
m1 := MARK (NONE);
MOVE_VERTICAL (2);
MOVE_HORIZONTAL (5);
r := CREATE_RANGE (m1, MARK (NONE), NONE);
CHANGE_CASE (r, UPPER);
POSITION (m1);
MESSAGE (CURRENT_LINE);
MOVE_VERTICAL (2);
MESSAGE (CURRENT_LINE);
CHANGE_CASE (b, INVERT);
POSITION (BEGINNING_OF (b));
MESSAGE (CURRENT_LINE);
WRITE_FILE (r, "BUFFERS3.OUT");
c := CREATE_BUFFER ("c");
POSITION (c);
MOVE_TEXT (b);
MESSAGE (STR (GET_INFO (b, "record_count")) + " " + STR (GET_INFO (c, "record_count")));
POSITION (END_OF (c));
SPLIT_LINE;
MESSAGE (STR (GET_INFO (c, "record_count")));
POSITION (END_OF (c));
x := ERASE_LINE;
MESSAGE ("[" + x + "] " + STR (GET_INFO (c, "record_count")));
POSITION (BEGINNING_OF (c));
APPEND_LINE;
MESSAGE (CURRENT_LINE);
QUIT (OFF);
