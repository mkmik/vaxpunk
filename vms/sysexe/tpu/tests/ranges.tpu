! Markers and ranges, and how they follow edits.
b := CREATE_BUFFER ("r");
POSITION (b);
COPY_TEXT ("one two three");
SPLIT_LINE;
COPY_TEXT ("four five");
POSITION (BEGINNING_OF (b));
MOVE_HORIZONTAL (4);
m1 := MARK (NONE);
MOVE_HORIZONTAL (2);
m2 := MARK (NONE);
r := CREATE_RANGE (m1, m2, NONE);
MESSAGE (STR (r));
MESSAGE (STR (LENGTH (r)));
POSITION (BEGINNING_OF (b));
COPY_TEXT ("ZERO ");
MESSAGE (STR (r));
POSITION (m1);
MESSAGE (STR (CURRENT_OFFSET));
r2 := CREATE_RANGE (BEGINNING_OF (b), END_OF (b), NONE);
MESSAGE (STR (r2));
MESSAGE (STR (LENGTH (r2)));
POSITION (BEGINNING_OF (b));
MOVE_VERTICAL (1);
m3 := MARK (NONE);
MOVE_HORIZONTAL (4);
r3 := CREATE_RANGE (m3, MARK (NONE), NONE);
MESSAGE ("[" + STR (r3) + "]");
ERASE (r3);
MESSAGE (CURRENT_LINE);
MESSAGE (STR (m1 < m3) + STR (m3 > m1) + STR (m1 = m1));
x := SUBSTR (r2, 1, 4);
MESSAGE (x);
POSITION (BEGINNING_OF (b));
MESSAGE (STR (BEGINNING_OF (r) = m1));
r4 := CREATE_RANGE (BEGINNING_OF (b), END_OF (b), NONE);
y := STR (r4, "|");
MESSAGE (y);
MOVE_TEXT (r);
MESSAGE (CURRENT_LINE);
QUIT (OFF);
