! More buffers: GET_INFO, the ends, ranges' text copied, DELETE.
b := CREATE_BUFFER ("Two");
POSITION (b);
COPY_TEXT ("alpha beta");
SPLIT_LINE;
COPY_TEXT ("gamma");
SPLIT_LINE;
COPY_TEXT ("delta epsilon");
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (BEGINNING_OF (b));
MOVE_HORIZONTAL (-1);
MESSAGE ("after begofbuf: " + STR (CURRENT_OFFSET));
POSITION (END_OF (b));
MOVE_HORIZONTAL (1);
MOVE_VERTICAL (1);
POSITION (2);
MESSAGE (CURRENT_LINE);
POSITION (LINE_END);
MESSAGE (STR (CURRENT_OFFSET) + "[" + CURRENT_CHARACTER + "]");
POSITION (LINE_BEGIN);
MESSAGE (STR (CURRENT_OFFSET) + "[" + CURRENT_CHARACTER + "]");
POSITION (BEGINNING_OF (b));
MOVE_HORIZONTAL (6);
m1 := MARK (NONE);
POSITION (3);
MOVE_HORIZONTAL (4);
m2 := MARK (NONE);
r := CREATE_RANGE (m1, m2, NONE);
MESSAGE (STR (r, "/"));
MESSAGE (STR (GET_INFO (m1, "record_number")) + " " + STR (GET_INFO (m2, "record_number")));
c := CREATE_BUFFER ("copy");
POSITION (c);
x := COPY_TEXT (r);
MESSAGE (STR (GET_INFO (c, "record_count")) + " [" + STR (x, "/") + "]");
POSITION (BEGINNING_OF (c));
MESSAGE (CURRENT_LINE);
POSITION (END_OF (c));
MESSAGE (STR (CURRENT_OFFSET));
r2 := CREATE_RANGE (m2, m1, NONE);
MESSAGE (STR (r2, "/"));
ERASE (r);
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (BEGINNING_OF (b));
MESSAGE (CURRENT_LINE);
MESSAGE (STR (GET_INFO (b, "name")) + " " + STR (GET_INFO (b, "mode")) + " " + STR (GET_INFO (b, "direction")));
SET (OVERSTRIKE, b);
SET (REVERSE, b);
MESSAGE (STR (GET_INFO (b, "mode")) + " " + STR (GET_INFO (b, "direction")));
d := CREATE_BUFFER ("TWO");
e := CREATE_BUFFER ("other");
n := 0;
w := GET_INFO (BUFFERS, "first");
LOOP
    EXITIF w = 0;
    n := n + 1;
    MESSAGE (GET_INFO (w, "name"));
    w := GET_INFO (BUFFERS, "next");
ENDLOOP;
DELETE (c);
IF c = TPU$K_UNSPECIFIED THEN MESSAGE ("c is unspecified"); ENDIF;
w := GET_INFO (BUFFERS, "first");
LOOP
    EXITIF w = 0;
    MESSAGE ("left: " + GET_INFO (w, "name"));
    w := GET_INFO (BUFFERS, "next");
ENDLOOP;
QUIT (OFF);
