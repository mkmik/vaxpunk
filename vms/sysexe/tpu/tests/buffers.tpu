! Buffers: reading a file, moving, inserting, erasing, writing.
b := CREATE_BUFFER ("main", "DATA.TXT");
MESSAGE (GET_INFO (b, "name"));
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (BEGINNING_OF (b));
MESSAGE (CURRENT_LINE);
MOVE_VERTICAL (1);
MESSAGE (CURRENT_LINE);
MOVE_HORIZONTAL (3);
MESSAGE (STR (CURRENT_OFFSET) + " " + CURRENT_CHARACTER);
COPY_TEXT ("XYZ");
MESSAGE (CURRENT_LINE);
MESSAGE (STR (CURRENT_OFFSET));
SPLIT_LINE;
MESSAGE (CURRENT_LINE);
MESSAGE (STR (GET_INFO (b, "record_count")));
MOVE_VERTICAL (-1);
MESSAGE (CURRENT_LINE);
APPEND_LINE;
MESSAGE (CURRENT_LINE);
ERASE_CHARACTER (3);
MESSAGE (CURRENT_LINE);
ERASE_LINE;
MESSAGE (CURRENT_LINE);
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (END_OF (b));
MESSAGE ("[" + CURRENT_LINE + "] " + STR (CURRENT_OFFSET));
COPY_TEXT ("appended");
SPLIT_LINE;
COPY_TEXT ("tail");
MESSAGE (STR (GET_INFO (b, "record_count")));
POSITION (BEGINNING_OF (b));
MOVE_VERTICAL (2);
MESSAGE (CURRENT_LINE);
MESSAGE (STR (LENGTH (CURRENT_LINE)));
MOVE_HORIZONTAL (-1);
MESSAGE (STR (CURRENT_OFFSET) + " [" + CURRENT_CHARACTER + "]");
MOVE_HORIZONTAL (1);
MESSAGE (STR (CURRENT_OFFSET) + " [" + CURRENT_CHARACTER + "]");
SET (OVERSTRIKE, b);
POSITION (BEGINNING_OF (b));
COPY_TEXT ("FIRST");
MESSAGE (CURRENT_LINE);
SET (INSERT, b);
MESSAGE (STR (GET_INFO (b, "modified")));
MESSAGE (STR (GET_INFO (CURRENT_BUFFER, "name") = "main"));
WRITE_FILE (b, "BUFFERS.OUT");
QUIT (OFF);
