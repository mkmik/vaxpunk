MODULE BUFFER (IDENT = 'V0.1') =
%TITLE 'TPU: buffers, markers and ranges'
BEGIN
REQUIRE 'TPU';

GLOBAL ROUTINE BUF_CALL (B, ARGS, N, R) = -1;
GLOBAL ROUTINE BUF_STR (V, SEP) = 0;
GLOBAL ROUTINE BUF_INFO (ARGS, N, R) = -1;
GLOBAL ROUTINE BUF_TEXT (V, LENP) = 0;
GLOBAL ROUTINE MARK_COMPARE (A, B) = 2;
GLOBAL ROUTINE MARK_FREE (P) : NOVALUE = MEM_FREE(.P);
GLOBAL ROUTINE RANGE_FREE (P) : NOVALUE = MEM_FREE(.P);

END
ELUDOM
