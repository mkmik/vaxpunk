MODULE SYM (IDENT = 'V0.1') =
%TITLE 'TPU: symbols, keywords and messages'
BEGIN
!
! The global symbol table: every name TPU knows, upper case, found
! through a hash table: variables, constants and procedures, which
! programs make, and the keywords, built-ins and predefined constants,
! which SYM_INIT makes from tpukw.r64. A keyword's code is its place in
! that table, the TPU$_ messages first.
!
REQUIRE 'TPU';
REQUIRE 'TPUKW';

LITERAL
    BUCKETS = 4096;                     ! a power of two

OWN
    TABLE : VECTOR[BUCKETS],
    KWNAME : VECTOR[KW_COUNT + 1],      ! each keyword's name: a length byte, then text
    MSGSEV : VECTOR[KW_NMSG + 1, BYTE],
    MSGTEXT : VECTOR[KW_NMSG + 1];      ! each message's text: a length byte, then text

BIND
    MSGTAB = UPLIT BYTE (MSGSTR(MESSAGES), 0) : VECTOR[, BYTE],
    KWTAB = UPLIT BYTE (NAMESTR(KEYWORDS), 0) : VECTOR[, BYTE],
    BITAB = UPLIT BYTE (NAMESTR(BUILTINS), 0) : VECTOR[, BYTE];

ROUTINE UPPER (C) =
    IF .C GEQU %C'a' AND .C LEQU %C'z' THEN .C - 32 ELSE .C;

ROUTINE HASH (TEXT, LEN) =
    BEGIN
    LOCAL
        H;
    H = 0;
    INCR I FROM 0 TO .LEN - 1 DO
        H = (.H * 31 + UPPER(GETB(.TEXT + .I))) AND %X'FFFFFF';
    .H AND (BUCKETS - 1)
    END;

! SYM_LOOK name, length: the symbol of that name, case ignored, or 0.
GLOBAL ROUTINE SYM_LOOK (TEXT, LEN) =
    BEGIN
    LOCAL
        Y : REF VECTOR;
    Y = .TABLE[HASH(.TEXT, .LEN)];
    WHILE .Y NEQ 0 DO
        BEGIN
        IF .Y[Y_LEN] EQL .LEN
        THEN
            BEGIN
            LOCAL
                SAME;
            SAME = TRUE;
            INCR I FROM 0 TO .LEN - 1 DO
                IF GETB(YNAME(.Y) + .I) NEQ UPPER(GETB(.TEXT + .I)) THEN (SAME = FALSE; EXITLOOP);
            IF .SAME THEN RETURN .Y
            END;
        Y = .Y[Y_NEXT]
        END;
    0
    END;

! SYM_WALK routine: calls the routine on each symbol.
GLOBAL ROUTINE SYM_WALK (FN) : NOVALUE =
    INCR H FROM 0 TO BUCKETS - 1 DO
        BEGIN
        LOCAL
            Y : REF VECTOR;
        Y = .TABLE[.H];
        WHILE .Y NEQ 0 DO ((.FN)(.Y); Y = .Y[Y_NEXT])
        END;

! SYM_FIND name, length: the symbol of that name, made, of no kind yet,
! if there is none.
GLOBAL ROUTINE SYM_FIND (TEXT, LEN) =
    BEGIN
    LOCAL
        Y : REF VECTOR,
        H;
    Y = SYM_LOOK(.TEXT, .LEN);
    IF .Y NEQ 0 THEN RETURN .Y;
    Y = MEM_GET(Y_SIZE * 8 + .LEN);
    INCR I FROM 0 TO .LEN - 1 DO PUTB(YNAME(.Y) + .I, UPPER(GETB(.TEXT + .I)));
    Y[Y_LEN] = .LEN;
    Y[Y_KIND] = YK_NONE;
    H = HASH(.TEXT, .LEN);
    Y[Y_NEXT] = .TABLE[.H];
    TABLE[.H] = .Y;
    .Y
    END;

! CONST name, value: a predefined constant.
ROUTINE CONST (TEXT, LEN, V) : NOVALUE =
    BEGIN
    LOCAL
        Y : REF VECTOR;
    Y = SYM_FIND(.TEXT, .LEN);
    Y[Y_KIND] = YK_CONST;
    Y[Y_VALUE] = .V
    END;

! SYM_INIT: the keywords, the built-ins and the predefined constants.
GLOBAL ROUTINE SYM_INIT : NOVALUE =
    BEGIN
    LOCAL
        I,
        K,
        Y : REF VECTOR;
    I = 0;
    K = 1;
    WHILE .MSGTAB[.I] NEQ 0 DO
        BEGIN
        KWNAME[.K] = MSGTAB[.I];
        Y = SYM_FIND(MSGTAB[.I + 1], .MSGTAB[.I]);
        Y[Y_KIND] = YK_KEYWORD;
        Y[Y_CODE] = .K;
        I = .I + .MSGTAB[.I] + 1;
        MSGSEV[.K] = .MSGTAB[.I];
        MSGTEXT[.K] = MSGTAB[.I + 1];
        I = .I + 2 + .MSGTAB[.I + 1];
        K = .K + 1
        END;
    I = 0;
    WHILE .KWTAB[.I] NEQ 0 DO
        BEGIN
        KWNAME[.K] = KWTAB[.I];
        Y = SYM_FIND(KWTAB[.I + 1], .KWTAB[.I]);
        Y[Y_KIND] = YK_KEYWORD;
        Y[Y_CODE] = .K;
        I = .I + .KWTAB[.I] + 1;
        K = .K + 1
        END;
    I = 0;
    K = 1;
    WHILE .BITAB[.I] NEQ 0 DO
        BEGIN
        Y = SYM_FIND(BITAB[.I + 1], .BITAB[.I]);
        Y[Y_KIND] = YK_BUILTIN;
        Y[Y_CODE] = .K;
        I = .I + .BITAB[.I] + 1;
        K = .K + 1
        END;
    CONST(T('TRUE'), MKINT(1));
    CONST(T('FALSE'), MKINT(0));
    CONST(T('TPU$K_UNSPECIFIED'), 0);
    CONST(T('TPU$K_MESSAGE_TEXT'), MKINT(1));
    CONST(T('TPU$K_MESSAGE_ID'), MKINT(2));
    CONST(T('TPU$K_MESSAGE_SEVERITY'), MKINT(4));
    CONST(T('TPU$K_MESSAGE_FACILITY'), MKINT(8));
    CONST(T('TPU$K_SEARCH_CASE'), MKINT(1));
    CONST(T('TPU$K_SEARCH_DIACRITICAL'), MKINT(2));
    CONST(T('TPU$K_SHIFT_MODIFIED'), MKINT(1));
    CONST(T('TPU$K_CTRL_MODIFIED'), MKINT(2));
    CONST(T('TPU$K_HELP_MODIFIED'), MKINT(4));
    CONST(T('TPU$K_ALT_MODIFIED'), MKINT(8))
    END;

! KW_NAME code, address: a keyword's name, its length stored at the
! address, or 0 if there is no such keyword.
GLOBAL ROUTINE KW_NAME (K, LENP) =
    BEGIN
    LOCAL
        P;
    IF .K LEQ 0 OR .K GTR KW_COUNT THEN RETURN 0;
    P = .KWNAME[.K];
    .LENP = GETB(.P);
    .P + 1
    END;

! KW_FIND name, length: the code of the keyword of that name, or 0.
GLOBAL ROUTINE KW_FIND (TEXT, LEN) =
    BEGIN
    LOCAL
        Y : REF VECTOR;
    Y = SYM_LOOK(.TEXT, .LEN);
    IF .Y EQL 0 THEN RETURN 0;
    IF .Y[Y_KIND] NEQ YK_KEYWORD THEN RETURN 0;
    .Y[Y_CODE]
    END;

! KW_ISERROR code: whether the keyword is one of the TPU$_ messages.
GLOBAL ROUTINE KW_ISERROR (K) =
    .K GEQ 1 AND .K LEQ KW_NMSG;

! MSG_SEVERITY code: a message's severity letter, S, I, W, E or F.
GLOBAL ROUTINE MSG_SEVERITY (K) =
    IF KW_ISERROR(.K) THEN .MSGSEV[.K] ELSE %C'E';

! MSG_TEXT code, address: a message's text, an FAO control string, with
! its length stored at the address.
GLOBAL ROUTINE MSG_TEXT (K, LENP) =
    BEGIN
    LOCAL
        P;
    IF NOT KW_ISERROR(.K) THEN (.LENP = 0; RETURN 0);
    P = .MSGTEXT[.K];
    .LENP = GETB(.P);
    .P + 1
    END;

END
ELUDOM
