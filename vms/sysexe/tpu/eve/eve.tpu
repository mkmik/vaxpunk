! ---- Keys

PROCEDURE eve$keys
DEFINE_KEY ("eve$find_key", E1, "find");
DEFINE_KEY ("eve_insert_here", E2, "insert here");
DEFINE_KEY ("eve_remove", E3, "remove");
DEFINE_KEY ("eve_select", E4, "select");
DEFINE_KEY ("eve_previous_screen", E5, "previous screen");
DEFINE_KEY ("eve_next_screen", E6, "next screen");
DEFINE_KEY ("eve_do", DO, "do");
DEFINE_KEY ("eve_help", HELP, "help");
DEFINE_KEY ("eve_exit", F10, "exit");
DEFINE_KEY ("eve_start_of_line", F12, "start of line");
DEFINE_KEY ("eve_erase_previous_word", F13, "erase previous word");
DEFINE_KEY ("eve_change_mode", F14, "change mode");
DEFINE_KEY ("eve_move_up", UP, "move up");
DEFINE_KEY ("eve_move_down", DOWN, "move down");
DEFINE_KEY ("eve_move_left", LEFT, "move left");
DEFINE_KEY ("eve_move_right", RIGHT, "move right");
DEFINE_KEY ("eve_return", RET_KEY, "return");
DEFINE_KEY ("eve_delete", DEL_KEY, "delete");
DEFINE_KEY ("eve_tab", TAB_KEY, "tab");
DEFINE_KEY ("eve_change_mode", CTRL_A_KEY, "change mode");
DEFINE_KEY ("eve_end_of_line", CTRL_E_KEY, "end of line");
DEFINE_KEY ("eve_start_of_line", BS_KEY, "start of line");
DEFINE_KEY ("eve_erase_word", LF_KEY, "erase word");
DEFINE_KEY ("eve_insert_page_break", CTRL_L_KEY, "insert page break");
DEFINE_KEY ("eve_remember", CTRL_R_KEY, "remember");
DEFINE_KEY ("eve_erase_start_of_line", CTRL_U_KEY, "erase start of line");
DEFINE_KEY ("eve_quote", CTRL_V_KEY, "quote");
DEFINE_KEY ("eve_refresh", CTRL_W_KEY, "refresh");
DEFINE_KEY ("eve_exit", CTRL_Z_KEY, "exit");
ENDPROCEDURE;

! ---- Starting

PROCEDURE tpu$init_procedure
LOCAL file, rows, b;
eve$x_ncommands := 0;
eve$x_help := "";
eve$x_cmd_words := CREATE_ARRAY;
eve$x_cmd_count := CREATE_ARRAY;
eve$x_cmd_name := CREATE_ARRAY;
eve$x_cmd_kind := CREATE_ARRAY;
eve$x_cmd_prompt := CREATE_ARRAY;
eve$x_marks := CREATE_ARRAY;
eve$x_select := 0;
eve$x_found := 0;
eve$x_target := "";
eve$x_restore_char := "";
eve$x_restore_word := "";
eve$x_restore_line := "";
eve$commands;
SET (MESSAGE_FLAGS, 1);
rows := GET_INFO (SCREEN, "visible_length");
IF rows = 0 THEN
    ! /NODISPLAY: no windows, only the file's buffer, for a command file.
    file := GET_INFO (COMMAND_LINE, "file_name");
    IF file = "" THEN
        b := eve$new_buffer ("MAIN", "");
    ELSE
        b := eve$new_buffer (eve$file_buffer_name (file), file);
    ENDIF;
    POSITION (BEGINNING_OF (b));
    RETURN;
ENDIF;
eve$x_prompt_row := rows - 1;
message_buffer := CREATE_BUFFER ("MESSAGES");
SET (SYSTEM, message_buffer);
SET (NO_WRITE, message_buffer);
SET (EOB_TEXT, message_buffer, "");
message_window := CREATE_WINDOW (rows, 1, OFF);
MAP (message_window, message_buffer);
! The prompt area: an empty window, which clears what was asked there at
! the next update.
eve$x_prompt_buffer := CREATE_BUFFER ("PROMPTS");
SET (SYSTEM, eve$x_prompt_buffer);
SET (NO_WRITE, eve$x_prompt_buffer);
SET (EOB_TEXT, eve$x_prompt_buffer, "");
eve$x_prompt_window := CREATE_WINDOW (eve$x_prompt_row, 1, OFF);
MAP (eve$x_prompt_window, eve$x_prompt_buffer);
eve$x_paste_buffer := CREATE_BUFFER ("INSERT HERE");
SET (SYSTEM, eve$x_paste_buffer);
SET (NO_WRITE, eve$x_paste_buffer);
file := GET_INFO (COMMAND_LINE, "file_name");
IF file = "" THEN
    b := eve$new_buffer ("MAIN", "");
ELSE
    b := eve$new_buffer (eve$file_buffer_name (file), file);
ENDIF;
eve$x_main_window := eve$window (1, eve$text_rows, b);
eve$x_windows := 1;
POSITION (BEGINNING_OF (b));
MESSAGE (TPU$_NOJOURNAL);
ENDPROCEDURE;

! The keys, defined once, which a section file keeps.
eve$keys;
