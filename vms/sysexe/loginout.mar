        .TITLE  LOGINOUT        Logs a user in
        .IDENT  /V0.1/
;
; The executive runs this on the console, and TELNETD on each TELNET
; terminal, in a process of its own named after the terminal, with every
; privilege. It asks for a username and a password, finds the user's
; record in SYSUAF.DAT, SYS$SYSTEM:SYSUAF.DAT unless the logical name
; SYSUAF says where, by key 0, the username, and checks the password's
; hash ($HASH_PASSWORD). A wrong username and a wrong password both say
; User authorization failure; only a wrong password counts, in the
; record's UAF$W_LOGFAILS, which the next login reports and clears. Three
; failures, or the line going, end the process, and so a TELNET
; connection. Once both are right, it names the process after the user,
; unless another process has that name, defines SYS$LOGIN,
; SYS$LOGIN_DEVICE, SYS$SCRATCH and SYS$DISK in its table from the
; record's default device and directory, which it makes the default
; directory, and calls EXE$LOGIN in kernel mode, which gives the process
; the user's UIC, privileges and priority, and the command interpreter
; the record names, DCL, and the rights list it builds: INTERACTIVE,
; and REMOTE on a TELNET terminal, TNAn: or VTAn:, or LOCAL on another, then the
; identifiers the rights database, RIGHTSLIST.DAT, says the user's UIC
; holds ($FIND_HELD) (ADR-0040). The executive calls DCL when this
; image exits, and DCL runs SYLOGIN.COM and the user's LOGIN.COM.
; Before that, on a virtual terminal, it lists the user's processes on
; disconnected ones and asks which to connect to, as VMS's LOGINOUT
; does: the terminal's line goes to that one, and this process goes
; (docs/adr/0041-virtual-terminals-take-the-telnet-line.md).
; In a subprocess, which DCL's SPAWN makes with this image, there is no
; username or password: EXE$LOGIN gives it DCL and a copy of its owner's
; process logical names, and it keeps the user, privileges and the rest
; $CREPRC gave it (docs/adr/0045-spawn-passes-its-context-as-vms-does.md).
; It is a known image with CMKRNL for that, as VMS installs it; a login
; from SYSUAF.DAT takes a process authorized CMKRNL, as those the
; executive and TELNETD make are.
; The system logical name SYS$ANNOUNCE, if there is one, is written
; before the first Username:, and SYS$WELCOME after the login, in place
; of the system's own welcome, with its version from $GETSYI, unless the record says DISWELCOME. A value that
; begins with @ names a file whose lines are written instead, as in
; DEFINE/SYSTEM SYS$ANNOUNCE "@SYS$MANAGER:ANNOUNCE.TXT".
; A terminal the Automatic Login Facility's file, SYS$SYSTEM:SYSALF.DAT
; unless the logical name SYSALF says where, names is logged in at once
; as its user, without a username or a password. Each of its lines is a
; terminal and a username, as SYSMAN's ALF ADD takes them: OPA0: SYSTEM.
; ponytail: VMS's SYSALF.DAT is an indexed file SYSMAN writes; ours is
; text, which boot --autologin writes, until there is a SYSMAN.
; ponytail: of the quotas, EXE$LOGIN sets the I/O ones, BIOLM, DIOLM and
; BYTLM; no others, account restrictions, password expiry or last login
; times (PRD-0003's later steps).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $IODEF
        $LNMDEF
        $FABDEF
        $RABDEF
        $UAFDEF
        $DVIDEF
        $SYIDEF
        $KGBDEF
        $JPIDEF
        $DEVDEF
        $TT2DEF
        $DCDEF

        .EXTERNAL EXE$LOGIN, PUT_LINE, LIB$SIGNAL

NAMESIZE = 32                           ; the longest username, and password
MAXRIGHTS = 1024                        ; identifiers a rights list holds, as EXE$SETRIGHTS takes

        .PSECT  DATA, NOEXE, WRT, LONG
INPUT:  .ASCID  "SYS$INPUT"
CHAN:   .LONG   0                       ; the terminal's
IOSB:   .BLKQ   1
UPROMPT:
        .ASCII  <13><10>"Username: "
UPROMPTLEN = .-UPROMPT
PPROMPT:
        .ASCII  "Password: "
PPROMPTLEN = .-PPROMPT
TRIES:  .LONG   0                       ; the logins left
NAMDSC: .LONG   NAMESIZE                ; the username, in capitals, padded with blanks: the key
        .ADDRESS NAME
NAME:   .BLKB   NAMESIZE
NAMLEN: .LONG   0                       ; without the blanks
PWDDSC: .LONG   0                       ; the password, in capitals
        .ADDRESS PWD
PWD:    .BLKB   NAMESIZE
HASH:   .BLKQ   1
UAFFAB: $FAB    FNA=UAFNAM, FNS=UAFNAMLEN, DNA=UAFDEF, DNS=UAFDEFLEN, FAC=<GET,UPD>
UAFRAB: $RAB    FAB=UAFFAB, UBF=REC, USZ=UAF$C_LENGTH, RBF=REC, RAC=KEY, KBF=NAME, KSZ=NAMESIZE
UAFNAM: .ASCII  "SYSUAF"
UAFNAMLEN = .-UAFNAM
UAFDEF: .ASCII  "SYS$SYSTEM:.DAT"
UAFDEFLEN = .-UAFDEF
REC:    .BLKB   UAF$C_LENGTH            ; the user's record
FAILS:  .LONG   0                       ; its failures, before this login
SUBARGS:.LONG   1, 0                    ; EXE$LOGIN's in a subprocess: no record
OWNERITEM:                              ; $GETJPI's: the owner, if it is a subprocess
        .WORD   4, JPI$_OWNER
        .ADDRESS OWNER, 0
        .LONG   0
OWNER:  .LONG   0
CLASSITEM:                              ; $GETDVI's: SYS$INPUT's class
        .WORD   4, DVI$_DEVCLASS
        .ADDRESS DEVCLASS, 0
        .LONG   0
DEVCLASS:
        .LONG   0
KARGS:  .LONG   2                       ; EXE$LOGIN's arguments: the record
        .ADDRESS REC
        .ADDRESS RLIST                  ; and the rights list
RLIST:  .LONG   0                       ; its identifiers, a quadword each:
        .BLKQ   MAXRIGHTS               ; the value and its attributes
HOLDER: .BLKQ   1                       ; $FIND_HELD's: the user's UIC
HELDID: .LONG   0                       ; an identifier it holds
HELDATR:.LONG   0                       ; and its attributes
RDBCTX: .LONG   0                       ; the search's context
PROCTAB:
        .ASCID  "LNM$PROCESS_TABLE"
LNMDSC: .LONG   0                       ; a logical name being defined
        .ADDRESS 0
ITEMS:  .WORD   0, LNM$_STRING          ; and its string
        .ADDRESS VALUE
        .LONG   0, 0
VALUE:  .BLKB   96                      ; the device, then the directory
DIRDSC: .LONG   0                       ; the directory
        .ADDRESS 0
; The logical names, the device's or the login directory's: 0 the
; device, 1 with the directory.
NAMES:  .BYTE   0
        .ASCIC  "SYS$LOGIN_DEVICE"
        .BYTE   0
        .ASCIC  "SYS$DISK"
        .BYTE   1
        .ASCIC  "SYS$LOGIN"
        .BYTE   1
        .ASCIC  "SYS$SCRATCH"
        .BYTE   255
LINE:   .BLKB   64                      ; a line being made, .ASCIC, or SYSALF.DAT's
ALFFAB: $FAB    FNA=ALFNAM, FNS=ALFNAMLEN, DNA=UAFDEF, DNS=UAFDEFLEN, FAC=GET
ALFRAB: $RAB    FAB=ALFFAB, UBF=LINE, USZ=64
ALFNAM: .ASCII  "SYSALF"
ALFNAMLEN = .-ALFNAM
DVIITEM:                                ; $GETDVI's items: the terminal's name
        .WORD   16, DVI$_DEVNAM
        .ADDRESS TERM, TERMLEN
        .LONG   0
TERM:   .BLKB   16                      ; _DDCU:
TERMLEN:.WORD   0                       ; and its length
SYSTAB: .ASCID  "LNM$SYSTEM"
ANNOUNCE:
        .ASCID  "SYS$ANNOUNCE"
WELCOMENAM:
        .ASCID  "SYS$WELCOME"
MSGITEM:.WORD   255, LNM$_STRING        ; $TRNLNM's items: the message
        .ADDRESS TEXT+1, TEXTLEN
        .LONG   0
TEXTLEN:.LONG   0
TEXT:   .BLKB   256                     ; the message, or a line of its file, .ASCIC
SYIITEM:.WORD   8, SYI$_VERSION         ; $GETSYI's items: the system's version
        .ADDRESS VERSION, 0
        .LONG   0
VERSION:.ASCII  "        "
MSGFAB: $FAB    FNA=TEXT+2, FAC=GET
MSGRAB: $RAB    FAB=MSGFAB, UBF=TEXT+1, USZ=255
MAXDET = 16                             ; the disconnected processes it lists, at most
MYITEM: .WORD   4, DVI$_DEVDEPEND2      ; $GETDVI's items: the terminal's TT2$ bits
        .ADDRESS MYCHAR2, 0
        .LONG   0
MYCHAR2:.LONG   0
JPICTX: .LONG   0                       ; a wildcard $GETJPI's context
FINDITEMS:                              ; and its items: a process's username,
        .WORD   12, JPI$_USERNAME
        .ADDRESS JUSER, 0
        .WORD   15, JPI$_TERMINAL       ; terminal,
        .ADDRESS JTERM+1, JTERMLEN
        .WORD   4, JPI$_UIC             ; UIC
        .ADDRESS JUIC, 0
        .WORD   4, JPI$_PID             ; and PID
        .ADDRESS JPID, 0
        .LONG   0
LISTITEMS:                              ; a disconnected one's terminal,
        .WORD   15, JPI$_TERMINAL
        .ADDRESS JTERM+1, JTERMLEN
        .WORD   15, JPI$_PRCNAM         ; process name
        .ADDRESS JPRC, JPRCLEN
        .WORD   64, JPI$_IMAGNAME       ; and image
        .ADDRESS JIMG, JIMGLEN
        .LONG   0
DETITEM:.WORD   4, DVI$_DEVCHAR2        ; $GETDVI's: a terminal's DEV$ bits of DEVCHAR2
        .ADDRESS JCHAR2, 0
        .LONG   0
JUSER:  .BLKB   12
JTDSC:  .LONG   0                       ; the terminal, _DDCU:
        .ADDRESS JTERM
JTERM:  .ASCII  "_"
        .BLKB   15
JTERMLEN:
        .WORD   0
JUIC:   .LONG   0
JPID:   .LONG   0
JCHAR2: .LONG   0
JPRC:   .BLKB   15
JPRCLEN:.WORD   0
JIMG:   .BLKB   64
JIMGLEN:.WORD   0
NPIDS:  .LONG   0                       ; those found
PIDS:   .BLKL   MAXDET
FIRST:  .BLKB   16                      ; the first one's terminal, _DDCU:
FIRSTLEN:
        .LONG   0
PROMPT: .BLKB   64                      ; the question
ANSWER: .BLKB   32
CONNDSC:.LONG   0, 0                    ; the terminal to connect to
MSGDSC: .LONG   255                     ; a status's message
        .ADDRESS TEXT+1
MSGLEN: .WORD   0

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6>
        $GETJPIW_S ITMLST=OWNERITEM
        TSTL    OWNER
        BEQL    2$
        BRW     SUBPROCESS
2$:     $ASSIGN_S DEVNAM=INPUT, CHAN=CHAN
        BLBC    R0, 90$
        BSBW    ALF
        BLBC    R0, 5$
        BSBW    FIND
        BLBS    R0, LOGIN
5$:     MOVAQ   ANNOUNCE, R1
        BSBW    MESSAGE
        MOVL    #3, TRIES
10$:    BSBW    ASK
        BLBC    R0, 90$
        TSTL    NAMLEN
        BEQL    10$                     ; an empty line: ask again
        BSBW    CHECK
        BLBS    R0, LOGIN
        PRINT   "User authorization failure"
        SOBGTR  TRIES, 10$
90$:    $EXIT_S #SS$_NORMAL             ; the process goes
        RET                             ; $EXIT doesn't return

; LOGIN: REC = the user's record, the file open. Clears and keeps its
; failures, makes the process the user's, reports the failures and exits
; to the command interpreter.
LOGIN:  MOVZWL  REC+UAF$W_LOGFAILS, FAILS
        CLRW    REC+UAF$W_LOGFAILS
        $UPDATE RAB=UAFRAB
        $CLOSE  FAB=UAFFAB
        MOVL    NAMLEN, NAMDSC
        $SETPRN_S PRCNAM=NAMDSC         ; one that has it already: keep the terminal's
        BSBW    DEFAULTS
        BLBC    R0, 80$
        BSBW    RIGHTS
        $CMKRNL_S ROUTIN=G^EXE$LOGIN, ARGLST=KARGS
        BLBC    R0, 80$
        BSBW    RECONNECT
        BBS     #UAF$V_DISWELCOM, REC+UAF$L_FLAGS, 10$
        MOVAQ   WELCOMENAM, R1
        BSBW    MESSAGE
        BLBS    R0, 10$
        BSBW    GREET
10$:    MOVL    FAILS, R1
        BEQL    20$
        BSBW    FAILURES
20$:    $EXIT_S #SS$_NORMAL
        RET                             ; $EXIT doesn't return
80$:    PUSHL   R0
        CALLS   #1, G^LIB$SIGNAL
        $EXIT_S #SS$_NORMAL
        RET

; SUBPROCESS: in a subprocess, as SPAWN makes one, there is no username
; or password: EXE$LOGIN gives the process DCL and a copy of its owner's
; process logical names, and keeps the rest $CREPRC gave it. SYS$INPUT,
; if it is a terminal, stays assigned, the process's terminal.
SUBPROCESS:
        $ASSIGN_S DEVNAM=INPUT, CHAN=CHAN
        BLBC    R0, 10$
        $GETDVIW_S CHAN=CHAN, ITMLST=CLASSITEM
        CMPL    DEVCLASS, #DC$_TERM
        BEQL    10$
        $DASSGN_S CHAN=CHAN
10$:    $CMKRNL_S ROUTIN=G^EXE$LOGIN, ARGLST=SUBARGS
        BLBS    R0, 20$
        PUSHL   R0
        CALLS   #1, G^LIB$SIGNAL
20$:    $EXIT_S #SS$_NORMAL
        RET

; RIGHTS: REC = the user's record, TERM = the terminal's name. Makes the
; process's rights list in RLIST: INTERACTIVE, REMOTE or LOCAL, then the
; identifiers $FIND_HELD finds for the user's UIC, as many as fit. With
; no rights database, only the first two. Uses R0-R5.
RIGHTS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAQ   RLIST+4, R1
        MOVL    #KGB$K_INTERACTIVE_ID, (R1)+
        CLRL    (R1)+
        MOVL    #KGB$K_LOCAL_ID, (R1)
        CMPW    TERM+1, #^A/TN/         ; _TNAn:, a TELNET terminal
        BEQL    3$
        CMPW    TERM+1, #^A/VT/         ; _VTAn:, TELNET's virtual one
        BNEQ    5$
3$:     MOVL    #KGB$K_REMOTE_ID, (R1)
5$:     CLRL    4(R1)
        MOVL    #2, RLIST
        MOVL    REC+UAF$L_UIC, HOLDER
        CLRL    HOLDER+4
        CLRL    RDBCTX
10$:    $FIND_HELD_S HOLDER=HOLDER, ID=HELDID, ATTRIB=HELDATR, CONTXT=RDBCTX
        BLBC    R0, 30$
        MOVL    RLIST, R1
        CMPL    R1, #MAXRIGHTS
        BGEQU   10$
        MOVAQ   RLIST+4[R1], R1
        MOVL    HELDID, (R1)+
        MOVL    HELDATR, (R1)
        INCL    RLIST
        BRB     10$
30$:    $FINISH_RDB_S CONTXT=RDBCTX
        RSB

; RECONNECT: REC = the user's record, the process the user's. Unless the
; record says DISRECONNECT, or the terminal isn't a virtual one, lists
; the processes of the user's name and UIC on disconnected virtual
; terminals, up to MAXDET, as VMS's LOGINOUT does, and asks which to
; connect to: for one, Connect to above listed process [YES]:, for more
; a terminal's name, the first's by default; NONE, or N, connects to
; none. Once the terminal's line is connected to it, the process goes;
; if it can't be, it says why, and the login goes on. Uses R0-R6.
RECONNECT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        BBC     #UAF$V_DISRECONNECT, REC+UAF$L_FLAGS, 2$
        RSB
2$:     $GETDVIW_S CHAN=CHAN, ITMLST=MYITEM
        BLBC    R0, 5$
        BITL    #TT2$M_DISCONNECT, MYCHAR2
        BNEQ    7$
5$:     RSB
7$:     CLRL    NPIDS
        MNEGL   #1, JPICTX
10$:    CLRW    JTERMLEN
        $GETJPIW_S PIDADR=JPICTX, ITMLST=FINDITEMS
        BLBC    R0, 30$                 ; past the last
        MOVZWL  JTERMLEN, R6
        BEQL    10$                     ; not interactive
        CMPC3   #12, JUSER, REC+UAF$T_USERNAME
        BNEQ    10$
        CMPL    JUIC, REC+UAF$L_UIC
        BNEQ    10$
        ADDL3   #1, R6, JTDSC
        $GETDVIW_S DEVNAM=JTDSC, ITMLST=DETITEM
        BLBC    R0, 10$
        BBC     #DEV$V_DET, JCHAR2, 10$
        MOVL    NPIDS, R0
        MOVL    JPID, PIDS[R0]
        AOBLSS  #MAXDET, NPIDS, 10$
30$:    TSTL    NPIDS
        BEQL    5$
        CLRL    R6                      ; listed
        CLRL    FIRSTLEN
40$:    MOVL    PIDS[R6], JPID
        CLRW    JTERMLEN
        CLRW    JPRCLEN
        CLRW    JIMGLEN
        $GETJPIW_S PIDADR=JPID, ITMLST=LISTITEMS
        BLBC    R0, 60$                 ; gone since
        TSTL    FIRSTLEN
        BNEQ    50$
        MOVZWL  JTERMLEN, R0
        ADDL3   #1, R0, FIRSTLEN
        MOVC3   FIRSTLEN, JTERM, FIRST
        CMPL    NPIDS, #1
        BNEQ    45$
        PRINT   "    You have the following disconnected process:"
        BRB     47$
45$:    PRINT   "    You have the following disconnected processes:"
47$:    PRINT   "Terminal   Process name    Image name"
50$:    CLRB    TEXT                    ; !10AF !15AF !AF
        MOVAB   JTERM+1, R1
        MOVZWL  JTERMLEN, R2
        MOVL    #11, R3
        BSBW    COLUMN
        MOVAB   JPRC, R1
        MOVZWL  JPRCLEN, R2
        MOVL    #27, R3
        BSBW    COLUMN
        MOVAB   JIMG, R1
        MOVZWL  JIMGLEN, R2
        BNEQ    55$
        MOVAB   NONE, R1
        MOVL    #6, R2
55$:    CLRL    R3
        BSBW    COLUMN
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
60$:    AOBLSS  NPIDS, R6, 40$
        TSTL    FIRSTLEN
        BEQL    5$                      ; all gone
        MOVW    #<10@8>!13, PROMPT
        CMPL    NPIDS, #1
        BNEQ    62$
        MOVC3   #CONNECTQLEN, CONNECTQ, PROMPT+2
        BRB     64$
62$:    MOVC3   #ENTERQLEN, ENTERQ, PROMPT+2
        SUBL3   #1, FIRSTLEN, R0
        MOVC3   R0, FIRST+1, (R3)
        MOVB    #^X5D, (R3)+            ; ]: after it
        MOVB    #^A/:/, (R3)+
        MOVB    #^A/ /, (R3)+
64$:    MOVAB   PROMPT, R0
        SUBL3   R0, R3, R0
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=ANSWER, P2=#32, P5=#PROMPT, P6=R0
        BSBW    STATUS
        BLBC    R0, 5$
        MOVZWL  IOSB+2, R2
        MOVL    R2, CONNDSC
        MOVAB   ANSWER, CONNDSC+4
        MOVAB   ANSWER, R1
        BSBW    UPCASE
        MOVL    CONNDSC, R2
        BEQL    70$                     ; the first
        CMPL    R2, #4
        BGTRU   80$
        CMPC3   R2, ANSWER, NONEWORD
        BNEQ    66$
        RSB
66$:    CMPL    CONNDSC, #3
        BGTRU   80$
        CMPC3   CONNDSC, ANSWER, YESWORD
        BNEQ    80$
70$:    MOVL    FIRSTLEN, CONNDSC
        MOVAB   FIRST, CONNDSC+4
80$:    CLRB    TEXT
        MOVAB   CONNECTING, R1
        MOVZBL  (R1)+, R2
        CLRL    R3
        BSBW    COLUMN
        MOVL    CONNDSC+4, R1
        MOVL    CONNDSC, R2
        CLRL    R3
        BSBW    COLUMN
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE!IO$M_TT_CONNECT, IOSB=IOSB, P1=CONNDSC
        BSBW    STATUS
        BLBC    R0, 90$
        $DELPRC_S                       ; the line is the other's: this process goes
        RSB
90$:    PUSHL   R0                      ; %LOGIN-E-CONNERR, then why
        CLRB    TEXT
        MOVAB   CONNERR, R1
        MOVZBL  (R1)+, R2
        CLRL    R3
        BSBW    COLUMN
        MOVL    CONNDSC+4, R1
        MOVL    CONNDSC, R2
        CLRL    R3
        BSBW    COLUMN
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        MOVL    (SP)+, R0
        $GETMSG_S MSGID=R0, MSGLEN=MSGLEN, BUFADR=MSGDSC
        MOVB    MSGLEN, TEXT
        MOVB    #^A/-/, TEXT+1
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        RSB

; COLUMN: appends the R2 characters at R1 to TEXT, .ASCIC, then blanks
; up to column R3, if it is short of it. Uses R0-R5.
COLUMN:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R3
        MOVZBL  TEXT, R3
        ADDB2   R2, TEXT
        MOVC3   R2, (R1), TEXT+1[R3]
        MOVL    (SP)+, R0
        MOVZBL  TEXT, R1
10$:    CMPL    R1, R0
        BGEQ    90$
        MOVB    #^A/ /, TEXT+1[R1]
        INCL    R1
        BRB     10$
90$:    MOVB    R1, TEXT
        RSB

; ASK: reads the username and the password, without echoing it, into
; NAME and PWD, in capitals. R0 = SS$_NORMAL, or the read's error, such
; as SS$_HANGUP. Uses R0-R5.
ASK:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=NAME, P2=#NAMESIZE, P5=#UPROMPT, P6=#UPROMPTLEN
        BSBW    STATUS
        BLBC    R0, 90$
        MOVZWL  IOSB+2, R2
        BSBW    PADNAME
        TSTL    NAMLEN
        BEQL    90$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT!IO$M_NOECHO, IOSB=IOSB, P1=PWD, P2=#NAMESIZE, P5=#PPROMPT, P6=#PPROMPTLEN
        BSBW    STATUS
        BLBC    R0, 90$
        PRINT   ""                      ; the line the password didn't echo
        MOVZWL  IOSB+2, R2
        MOVW    R2, PWDDSC
        MOVAB   PWD, R1
        BSBW    UPCASE
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; PADNAME: NAME = a username, R2 = its length. Puts it in capitals,
; with blanks after it, and its length in NAMLEN. Uses R0-R5.
PADNAME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R2, NAMLEN
        MOVAB   NAME, R1
        BSBW    UPCASE
        SUBL3   NAMLEN, #NAMESIZE, R0   ; blanks after it
        MOVAB   NAME, R1
        ADDL2   NAMLEN, R1
        MOVC5   #0, (SP), #^A/ /, R0, (R1)
        RSB

; ALF: finds the terminal's line in SYSALF.DAT, if there is the file. R0
; = 1 with its username in NAME and NAMLEN, else 0. Uses R0-R5.
ALF:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $GETDVIW_S CHAN=CHAN, ITMLST=DVIITEM
        BLBC    R0, 80$
        $OPEN   FAB=ALFFAB
        BLBC    R0, 80$
        $CONNECT RAB=ALFRAB
        BLBC    R0, 70$
10$:    $GET    RAB=ALFRAB
        BLBC    R0, 70$
        MOVZWL  TERMLEN, R3             ; DDCU:, without its underscore
        DECL    R3
        MOVZWL  ALFRAB+RAB$W_RSZ, R4
        SUBL2   R3, R4                  ; after it
        BLEQ    10$
        CMPC3   R3, LINE, TERM+1        ; R1 = after it
        BNEQ    10$
        MOVL    R4, R2
20$:    CMPB    (R1), #^A/ /            ; the blanks before the username
        BNEQ    30$
        INCL    R1
        SOBGTR  R2, 20$
        BRB     10$
30$:    CLRL    R3                      ; its length, to a blank or the end
40$:    CMPB    (R1)[R3], #^A/ /
        BEQL    50$
        INCL    R3
        CMPL    R3, R2
        BLSS    40$
50$:    CMPL    R3, #NAMESIZE
        BGTR    10$
        PUSHL   R3
        MOVC3   R3, (R1), NAME
        MOVL    (SP)+, R2
        BSBW    PADNAME
        $CLOSE  FAB=ALFFAB
        MOVL    #1, R0
        RSB
70$:    $CLOSE  FAB=ALFFAB
80$:    CLRL    R0
        RSB

; UPCASE: R1 = a string, R2 = its length. Puts its letters in capitals.
; Uses R0-R2.
UPCASE:
        .JSB_ENTRY  SCRATCH=<R2>
10$:    TSTL    R2
        BEQL    90$
        CMPB    (R1), #^A/a/
        BLSSU   20$
        CMPB    (R1), #^A/z/
        BGTRU   20$
        SUBB2   #^A/a/-^A/A/, (R1)
20$:    INCL    R1
        DECL    R2
        BRB     10$
90$:    RSB

; STATUS: R0 = $QIOW's status. R0 = the IOSB's, if that was a success.
STATUS:
        .JSB_ENTRY
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

; CHECK: finds NAME's record in SYSUAF.DAT and checks PWD against its
; hash. R0 = 1 if they match, with REC the record and the file open, else
; 0, with the file closed and a wrong password counted. Uses R0-R5.
CHECK:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BSBW    FIND
        BLBC    R0, 80$
        MOVZBL  REC+UAF$B_ENCRYPT, R0
        MOVZWL  REC+UAF$W_SALT, R1
        $HASH_PASSWORD_S PWDDSC=PWDDSC, ALG=R0, SALT=R1, USRDSC=NAMDSC, HASH=HASH
        BLBC    R0, 60$
        CMPL    HASH, REC+UAF$Q_PWD
        BNEQ    60$
        CMPL    HASH+4, REC+UAF$Q_PWD+4
        BNEQ    60$
        MOVL    #1, R0
        RSB
60$:    INCW    REC+UAF$W_LOGFAILS      ; the password: count it
        $UPDATE RAB=UAFRAB
        $CLOSE  FAB=UAFFAB
80$:    CLRL    R0
        RSB

; FIND: opens SYSUAF.DAT and reads NAME's record into REC. R0 = 1 with
; the file open, else 0, with it closed, for no such user or one
; DISUSERed. Uses R0-R5.
FIND:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVB    #FAB$M_GET!FAB$M_UPD, UAFFAB+FAB$B_FAC
        $OPEN   FAB=UAFFAB
        BLBS    R0, 10$
        MOVB    #FAB$M_GET, UAFFAB+FAB$B_FAC    ; a disk that is write locked
        $OPEN   FAB=UAFFAB
        BLBS    R0, 10$
        PUSHL   R0                      ; no one may log in: say why
        CALLS   #1, G^LIB$SIGNAL
        BRB     80$
10$:    $CONNECT RAB=UAFRAB
        BLBC    R0, 70$
        $GET    RAB=UAFRAB
        BLBC    R0, 70$
        BBS     #UAF$V_DISACNT, REC+UAF$L_FLAGS, 70$
        MOVL    #1, R0
        RSB
70$:    $CLOSE  FAB=UAFFAB
80$:    CLRL    R0
        RSB

; DEFAULTS: REC = the user's record. Makes its default directory the
; process's, and defines the logical names NAMES lists from its default
; device and directory. R0 = SS$_NORMAL, or $SETDDIR's or $CRELNM's
; error. Uses R0-R6.
DEFAULTS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVZBL  REC+UAF$T_DEFDIR, DIRDSC
        MOVAB   REC+UAF$T_DEFDIR+1, DIRDSC+4
        $SETDDIR_S NEWDIR=DIRDSC
        BLBC    R0, 90$
        MOVZBL  REC+UAF$T_DEFDEV, R6
        MOVC3   R6, REC+UAF$T_DEFDEV+1, VALUE
        MOVZBL  REC+UAF$T_DEFDIR, R0
        MOVC3   R0, REC+UAF$T_DEFDIR+1, VALUE[R6]
        MOVAB   NAMES, R5
10$:    MOVZBL  (R5)+, R0               ; with the directory?
        CMPL    R0, #255
        BEQL    80$
        MOVW    R6, ITEMS
        BLBC    R0, 20$
        ADDW2   DIRDSC, ITEMS
20$:    MOVZBL  (R5)+, LNMDSC
        MOVL    R5, LNMDSC+4
        ADDL2   LNMDSC, R5
        PUSHL   R5
        $CRELNM_S TABNAM=PROCTAB, LOGNAM=LNMDSC, ITMLST=ITEMS
        MOVL    (SP)+, R5
        BLBC    R0, 90$
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; MESSAGE: R1 = a system logical name's descriptor. Writes its string,
; or, if it begins with @, the lines of the file the rest names. R0 = 1,
; or 0 if there is no such name. Uses R0-R5.
MESSAGE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $TRNLNM_S TABNAM=SYSTAB, LOGNAM=(R1), ITMLST=MSGITEM
        BLBC    R0, 90$
        MOVZWL  TEXTLEN, R2
        BEQL    80$
        CMPB    TEXT+1, #^A/@/
        BEQL    10$
        MOVB    R2, TEXT
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        BRB     80$
10$:    DECL    R2                      ; the file's name, after the @
        MOVB    R2, MSGFAB+FAB$B_FNS
        $OPEN   FAB=MSGFAB
        BLBC    R0, 80$                 ; no file: no message
        $CONNECT RAB=MSGRAB
        BLBC    R0, 70$
20$:    $GET    RAB=MSGRAB
        BLBC    R0, 70$
        MOVB    MSGRAB+RAB$W_RSZ, TEXT
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        BRB     20$
70$:    $CLOSE  FAB=MSGFAB
80$:    MOVL    #1, R0
        RSB
90$:    CLRL    R0
        RSB

; GREET: writes the system's own welcome, for no SYS$WELCOME, with the
; version $GETSYI says, as VMS's Welcome to OpenVMS ... Version V8.4.
; Uses R0-R5.
GREET:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $GETSYIW_S ITMLST=SYIITEM
        MOVZBL  WELCOME, R2
        MOVC3   R2, WELCOME+1, TEXT+1
        MOVC3   #8, VERSION, (R3)
10$:    CMPB    -1(R3), #^A/ /          ; without the version's blanks
        BNEQ    20$
        DECL    R3
        BRB     10$
20$:    MOVAB   TEXT+1, R0
        SUBL3   R0, R3, R0
        MOVB    R0, TEXT
        PUSHAB  TEXT
        CALLS   #1, G^PUT_LINE
        RSB

; FAILURES: R1 = the login failures since the last login, 1 or more.
; Says how many, as VMS does. Uses R0-R5.
FAILURES:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAB   LINE+1, R3
        MOVB    #9, (R3)+
        CLRL    R4                      ; the digits, on the stack
10$:    DIVL3   #10, R1, R5
        MULL3   #10, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R4
        MOVL    R5, R1
        BNEQ    10$
20$:    MOVL    (SP)+, R0
        MOVB    R0, (R3)+
        SOBGTR  R4, 20$
        MOVAB   FAILURE, R1
        CMPL    FAILS, #1
        BEQL    30$
        MOVAB   FAILURES2, R1
30$:    MOVZBL  (R1)+, R2
        MOVC3   R2, (R1), (R3)
        MOVAB   LINE+1, R0
        SUBL3   R0, R3, R0
        MOVB    R0, LINE
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        RSB

        .PSECT  $LITERAL$
WELCOME:
        .ASCIC  <9>"Welcome to vaxpunk arm64 Operating System, Version "
FAILURE:
        .ASCIC  " failure since last successful login"
FAILURES2:
        .ASCIC  " failures since last successful login"
NONE:   .ASCII  "(none)"
NONEWORD:
        .ASCII  "NONE"
YESWORD:.ASCII  "YES"
CONNECTQ:
        .ASCII  "Connect to above listed process [YES]: "
CONNECTQLEN = .-CONNECTQ
ENTERQ: .ASCII  "Enter terminal to connect to ["
ENTERQLEN = .-ENTERQ
CONNECTING:
        .ASCIC  "Connecting to terminal "
CONNERR:.ASCIC  "%LOGIN-E-CONNERR, error connecting to "

        .END    START
