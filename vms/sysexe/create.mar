        .TITLE  CREATE  Makes directories and files
        .IDENT  /V0.4/
;
; DCL's CREATE/DIRECTORY spec runs this: $CREATE_DIR makes the
; directory, [dev:][dir.dir...], and those above it that aren't there.
; Returns its status: SS$_CREATED, or SS$_NORMAL if the directory was
; there already. CREATE/FDL=fdl [file] makes the empty file the FDL file
; describes (FDL$PARSE in rms/fdl.mar), named file, with the FDL's FILE
; NAME for what it leaves out, as VMS's CREATE/FDL does; RMS$_NORMAL, or
; %FDL-F-CREATE and FDL$_CREATE if the FDL file had statements it didn't
; take or RMS can't make the file.
; CREATE file, without either, makes a text file, a new version, of the
; lines read from SYS$INPUT up to CTRL/Z, as VMS's CREATE does: variable
; length records with carriage return carriage control. With /LOG it says
; %CREATE-I-CREATED, name created. Returns RMS's status if it can't.
; CREATE/MAILBOX name makes a mailbox, MBAn:, that the logical name name
; stands for, as VMS's does; /MESSAGE_SIZE and /BUFFER_SIZE are $CREMBX's
; maxmsg and bufquo. A temporary one, the default, outlives CREATE: it
; is made in executive mode, which takes CMEXEC, on a supervisor mode
; channel, DCL's, so it goes when the process does. /PERMANENT makes a
; permanent one, which stays when CREATE's channel goes. With /LOG it says
; %CREATE-I-CREATED, MBAn: created. Returns $CREMBX's status.
; ponytail: one directory or file; a command procedure's data lines are
; skipped by DCL, so there CREATE makes an empty file. A mailbox's name
; goes in the system table, so it takes SYSNAM (t8y:/exec/mailboxes#name-tables).
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $NAMDEF
        $IODEF
        $PSLDEF
        $DVIDEF

        .EXTERNAL FDL$PARSE, FDL$T_NAME, FDL$GB_NAMELEN
        .EXTERNAL LIN$TEXT, LIN$STR, LIN$PUT, LIN$STATUS

INHIB = ^X10000000                      ; STS$M_INHIB_MSG: reported already
FDL$_CREATE = ^X00B4806C                ; error creating !AS
FDL$_OPENFDL = ^X00B4807C
FDL$_WARNING = ^X00B48058               ; parsed with warnings

        .PSECT  DATA, NOEXE, WRT, LONG
SPEC:   .LONG   255                     ; FILE, the parameter
        .ADDRESS SPECBUF
SPECBUF:
        .BLKB   255
FDLSPEC:
        .LONG   255                     ; /FDL's value
        .ADDRESS FDLBUF
FDLBUF: .BLKB   255
FAB:    .LONG   0                       ; FDL$PARSE's FAB and RAB
RAB:    .LONG   0
M_CREATE:
        .ASCIC  "%FDL-F-CREATE, error creating "
M_WARNING:
        .ASCIC  "-FDL-W-WARNING, parsed with warnings"
M_CREATED:
        .ASCIC  "%CREATE-I-CREATED, "
M_SUFFIX:
        .ASCIC  " created"
TFAB:   $FAB    FNA=SPECBUF, NAM=TNAM, RFM=VAR, RAT=CR
TNAM:   $NAM    RSA=TRES, RSS=255
TRAB:   $RAB    FAB=TFAB, RBF=LINE
INPUT:  .ASCID  "SYS$INPUT"
CHAN:   .LONG   0                       ; SYS$INPUT's
IOSB:   .BLKQ   1                       ; a read's: its length, terminator
LINESIZE = 1024
LINE:   .BLKB   LINESIZE
TRES:   .BLKB   255
NUMDSC: .LONG   10                      ; /MESSAGE_SIZE's or /BUFFER_SIZE's digits
        .ADDRESS NUMBUF
NUMBUF: .BLKB   10
PRMFLG: .LONG   0                       ; $CREMBX's arguments
MAXMSG: .LONG   0
BUFQUO: .LONG   0
MCHAN:  .LONG   0
DVIITEMS:                               ; the mailbox's name, _MBAn:
        .WORD   16, DVI$_DEVNAM
        .ADDRESS DEVNAM, DEVLEN
        .LONG   0
DEVNAM: .BLKB   16
DEVLEN: .LONG   0

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3>
        PRESENT "MAILBOX"
        BLBC    R0, 5$
        BRW     MAILBOX
5$:     PRESENT "FDL"
        BLBS    R0, 20$
        PRESENT "DIRECTORY"
        BLBS    R0, 10$
        BRW     TEXT
10$:    GETVALUE "FILE", SPEC, SPEC
        $CREATE_DIR_S DEVDIRSPEC=SPEC
        RET
20$:    GETVALUE "FDL", FDLSPEC, FDLSPEC
        GETVALUE "FILE", SPEC, SPEC
        BLBS    R0, 25$
        CLRL    SPEC                    ; none: the FDL's NAME
25$:    PUSHAL  RAB
        PUSHAL  FAB
        PUSHAQ  FDLSPEC
        CALLS   #3, G^FDL$PARSE
        CMPL    R0, #SS$_NORMAL
        BEQL    30$
        BICL3   #INHIB, R0, R2
        CMPL    R2, #FDL$_OPENFDL       ; reported
        BEQL    90$
        MOVL    R0, R2                  ; parsed with warnings
        BRB     80$
30$:    MOVL    FAB, R3
        MOVZWL  SPEC, R0
        MOVB    R0, FAB$B_FNS(R3)
        MOVAB   SPECBUF, FAB$L_FNA(R3)
        MOVAB   FDL$T_NAME, FAB$L_DNA(R3)
        MOVB    FDL$GB_NAMELEN, FAB$B_DNS(R3)
        $CREATE FAB=(R3)
        MOVL    R0, R2
        BLBC    R0, 80$
        $CLOSE  FAB=(R3)
        RET
80$:    PUSHL   R2                      ; %FDL-F-CREATE, and why
        MOVAB   M_CREATE, R1
        BSBW    LIN$TEXT
        MOVAB   SPECBUF, R1
        MOVZWL  SPEC, R2
        BNEQ    85$
        MOVAB   FDL$T_NAME, R1
        MOVZBL  FDL$GB_NAMELEN, R2
85$:    BSBW    LIN$STR
        BSBW    LIN$PUT
        MOVL    (SP)+, R0
        CMPL    R0, #FDL$_WARNING
        BEQL    87$
        BSBW    LIN$STATUS
        BRB     88$
87$:    MOVAB   M_WARNING, R1
        BSBW    LIN$TEXT
        BSBW    LIN$PUT
88$:    MOVL    #FDL$_CREATE!INHIB, R0
90$:    RET

; TEXT: CREATE file. Reads the lines on SYS$INPUT's channel up to
; CTRL/Z: the console's terminator, a network terminal's last byte, or a
; read that fails.
TEXT:   GETVALUE "FILE", SPEC, SPEC
        $ASSIGN_S DEVNAM=INPUT, CHAN=CHAN
        BLBC    R0, 90$
        MOVB    SPEC, TFAB+FAB$B_FNS
        $CREATE FAB=TFAB
        BLBC    R0, 90$
        $CONNECT RAB=TRAB
        BLBC    R0, 80$
10$:    $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=LINE, P2=#LINESIZE
        BLBC    R0, 30$
        BLBC    IOSB, 30$
        CMPB    IOSB+4, #26             ; the console's CTRL/Z
        BEQL    30$
        MOVZWL  IOSB+2, R0
        BEQL    20$
        CMPB    LINE-1[R0], #26         ; a network terminal's
        BEQL    30$
20$:    MOVW    IOSB+2, TRAB+RAB$W_RSZ
        $PUT    RAB=TRAB
        BLBS    R0, 10$
        BRB     80$
30$:    PRESENT "LOG"
        BLBC    R0, 40$
        MOVAB   M_CREATED, R1           ; %CREATE-I-CREATED, name created
        BSBW    LIN$TEXT
        MOVAB   TRES, R1
        MOVZBL  TNAM+NAM$B_RSL, R2
        BSBW    LIN$STR
        MOVAB   M_SUFFIX, R1
        BSBW    LIN$TEXT
        BSBW    LIN$PUT
40$:    MOVL    #RMS$_NORMAL, R0
80$:    PUSHL   R0
        $CLOSE  FAB=TFAB
        MOVL    (SP)+, R0
90$:    RET

; MAILBOX: CREATE/MAILBOX name.
MAILBOX:
        GETVALUE "LOGICAL_NAME", SPEC, SPEC
        PRESENT "MESSAGE_SIZE"
        BLBC    R0, 10$
        GETVALUE "MESSAGE_SIZE", NUMDSC, NUMDSC
        BSBW    NUMBER
        MOVL    R1, MAXMSG
10$:    PRESENT "BUFFER_SIZE"
        BLBC    R0, 20$
        GETVALUE "BUFFER_SIZE", NUMDSC, NUMDSC
        BSBW    NUMBER
        MOVL    R1, BUFQUO
20$:    PRESENT "PERMANENT"
        BLBC    R0, 30$
        MOVL    #1, PRMFLG
        CALLS   #0, MKMBX
        BRB     40$
30$:    $CMEXEC_S ROUTIN=MKMBX
40$:    BLBC    R0, 90$
        PRESENT "LOG"
        BLBC    R0, 80$
        $GETDVIW_S CHAN=MCHAN, ITMLST=DVIITEMS
        BLBC    R0, 90$
        MOVAB   M_CREATED, R1           ; %CREATE-I-CREATED, MBAn: created
        BSBW    LIN$TEXT
        MOVAB   DEVNAM+1, R1            ; without its underscore
        SUBL3   #1, DEVLEN, R2
        BSBW    LIN$STR
        MOVAB   M_SUFFIX, R1
        BSBW    LIN$TEXT
        BSBW    LIN$PUT
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; MKMBX: makes the mailbox, on a channel of supervisor mode or the
; caller's, whichever is less privileged. R0 = $CREMBX's status.
        .ENTRY  MKMBX, ^M<>
        $CREMBX_S PRMFLG=PRMFLG, CHAN=MCHAN, MAXMSG=MAXMSG, BUFQUO=BUFQUO, ACMODE=#PSL$C_SUPER, LOGNAM=SPEC
        RET

; NUMBER: NUMDSC = a qualifier's digits. R1 = their value, 0 if one isn't
; a digit. Uses R0-R2.
NUMBER:
        .JSB_ENTRY  SCRATCH=<R2>
        CLRL    R1
        CLRL    R2
10$:    CMPW    R2, NUMDSC
        BGEQU   90$
        MOVZBL  NUMBUF[R2], R0
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BGTRU   80$
        MULL2   #10, R1
        ADDL2   R0, R1
        INCL    R2
        BRB     10$
80$:    CLRL    R1
90$:    RSB

        .END    START
