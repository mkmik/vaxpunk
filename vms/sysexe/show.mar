        .TITLE  SHOW    Shows the process and the system
        .IDENT  /V0.1/
;
; DCL's SHOW PROCESS and SHOW SYSTEM run this, as VMS's DCL runs SHOW.EXE
; for them; OPTION, the parameter, says which. SHOW PROCESS
; shows the date, $ASCTIM's, and this process, what $GETJPI says of it,
; and with /PRIVILEGES its authorized and current privileges. SHOW SYSTEM
; shows the version, the date and how long the system has been up, from
; $GETSYI, then a line for each process, from a wildcard $GETJPI: its PID,
; name, state, priority and image.
; SHOW TERMINAL shows the terminal's characteristics (lib/term.mar), under
; VMS's headings and names, four to a line.
; ponytail: no node, CPU time, I/O or page counts: the counters don't
; exist yet. A terminal has no speed, parity or fill,
; so SHOW TERMINAL shows a VT100's on a 9600 baud line; and it has no
; TT3$ characteristics, so no DEC_CRT5, Ansi_Color or VMS Style Input.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $JPIDEF
        $SYIDEF
        $DVIDEF
        $DCDEF
        $TTDEF
        $TT2DEF

        .EXTERNAL PUT_LINE, PRV_NAMES, TERM_SENSE

TT2 = 1                                 ; CHARS: a TT2$ bit, not a TT$ one,
NOT = 2                                 ; on when it is clear,
ALT = 4                                 ; with a name for off, not No and the name

; ADDTEXT "text": appends text to LINE. Uses R0-R2.
        .MACRO  ADDTEXT TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        .ENDM   ADDTEXT

        .PSECT  DATA, NOEXE, WRT, LONG
DESC:   .LONG   8                       ; OPTION, the keyword
        .ADDRESS WHAT
WHAT:   .BLKB   8
CTX:    .LONG   -1                      ; the wildcard $GETJPI's scan
JPIITEMS:                               ; what $GETJPIW returns of a process
        .WORD   4, JPI$_PID
        .ADDRESS PID
        .LONG   0
        .WORD   15, JPI$_PRCNAM
        .ADDRESS NAME
        .ADDRESS NAMLEN
        .WORD   4, JPI$_STATE
        .ADDRESS STATE
        .LONG   0
        .WORD   4, JPI$_PRI
        .ADDRESS PRI
        .LONG   0
        .WORD   4, JPI$_PRIB
        .ADDRESS PRIB
        .LONG   0
        .WORD   39, JPI$_IMAGNAME
        .ADDRESS IMAGE
        .ADDRESS IMGLEN
        .WORD   4, JPI$_UIC
        .ADDRESS UIC
        .LONG   0
        .WORD   8, JPI$_CURPRIV
        .ADDRESS CURPRIV
        .LONG   0
        .WORD   8, JPI$_AUTHPRIV
        .ADDRESS AUTHPRIV
        .LONG   0
        .LONG   0
SYIITEMS:                               ; and $GETSYIW of the system
        .WORD   8, SYI$_VERSION
        .ADDRESS VERSION
        .LONG   0
        .WORD   8, SYI$_BOOTTIME
        .ADDRESS BOOTTIME
        .LONG   0
        .LONG   0
PID:    .LONG   0
STATE:  .LONG   0
PRI:    .LONG   0
PRIB:   .LONG   0
UIC:    .LONG   0
CURPRIV:
        .BLKQ   1
AUTHPRIV:
        .BLKQ   1
NAMLEN: .WORD   0
IMGLEN: .WORD   0
NAME:   .BLKB   15
IMAGE:  .BLKB   39
VERSION:
        .BLKB   8
BOOTTIME:
        .BLKQ   1
NOW:    .BLKQ   1
DATEDSC:
        .LONG   23                      ; $ASCTIM's buffer
        .ADDRESS DATE
DATE:   .BLKB   23
DATELEN:
        .WORD   0
; The scheduling states' names, VMS's, by SCH$C_ value, 5 characters each.
STATES: .ASCII  "     COLPGMWAITCEF  PFW  LEF  LEFO HIB  "
        .ASCII  "HIBO SUSP SUSPOFPG  COM  COMO CUR  "
MAXSTATE = 14
HEX:    .ASCII  "0123456789ABCDEF"
LINE:   .BLKB   256                     ; a line being made, .ASCIC
CHAR:   .BLKB   1
TTCHAN: .LONG   0                       ; the terminal's
TTCHAR: .BLKB   12                      ; its characteristics
DVIITEMS:                               ; what $GETDVIW returns of it
        .WORD   64, DVI$_DEVNAM
        .ADDRESS TTNAME
        .ADDRESS TTNAMLEN
        .LONG   0
TTNAMLEN:
        .WORD   0
TTNAME: .BLKB   64
; The characteristics SHOW TERMINAL shows, in VMS's order: each a bit,
; its flags, TT2, NOT and ALT, and its name, .ASCIC, then for ALT the
; name for off; a 255 ends them.
CHARS:  .BYTE   TT$V_PASSALL, NOT!ALT
        .ASCIC  "Interactive"
        .ASCIC  "Passall"
        .BYTE   TT$V_NOECHO, NOT
        .ASCIC  "Echo"
        .BYTE   TT$V_NOTYPEAHD, NOT
        .ASCIC  "Type_ahead"
        .BYTE   TT$V_ESCAPE, 0
        .ASCIC  "Escape"
        .BYTE   TT$V_HOSTSYNC, 0
        .ASCIC  "Hostsync"
        .BYTE   TT$V_TTSYNC, 0
        .ASCIC  "TTsync"
        .BYTE   TT$V_LOWER, 0
        .ASCIC  "Lowercase"
        .BYTE   TT$V_MECHTAB, 0
        .ASCIC  "Tab"
        .BYTE   TT$V_WRAP, 0
        .ASCIC  "Wrap"
        .BYTE   TT$V_SCOPE, 0
        .ASCIC  "Scope"
        .BYTE   TT$V_REMOTE, 0
        .ASCIC  "Remote"
        .BYTE   TT$V_EIGHTBIT, 0
        .ASCIC  "Eightbit"
        .BYTE   TT$V_NOBRDCST, NOT
        .ASCIC  "Broadcast"
        .BYTE   TT$V_READSYNC, 0
        .ASCIC  "Readsync"
        .BYTE   TT$V_MECHFORM, 0
        .ASCIC  "Form"
        .BYTE   TT$V_HALFDUP, NOT!ALT
        .ASCIC  "Fulldup"
        .ASCIC  "Halfdup"
        .BYTE   TT$V_MODEM, 0
        .ASCIC  "Modem"
        .BYTE   TT2$V_LOCALECHO, TT2
        .ASCIC  "Local_echo"
        .BYTE   TT2$V_AUTOBAUD, TT2
        .ASCIC  "Autobaud"
        .BYTE   TT2$V_HANGUP, TT2
        .ASCIC  "Hangup"
        .BYTE   TT2$V_BRDCSTMBX, TT2
        .ASCIC  "Brdcstmbx"
        .BYTE   TT2$V_DMA, TT2
        .ASCIC  "DMA"
        .BYTE   TT2$V_ALTYPEAHD, TT2
        .ASCIC  "Altypeahd"
        .BYTE   TT2$V_SETSPEED, TT2
        .ASCIC  "Set_speed"
        .BYTE   TT2$V_COMMSYNC, TT2
        .ASCIC  "Commsync"
        .BYTE   TT2$V_EDITING, TT2
        .ASCIC  "Line Editing"
        .BYTE   TT2$V_INSERT, TT2!ALT
        .ASCIC  "Insert editing"
        .ASCIC  "Overstrike editing"
        .BYTE   TT2$V_FALLBACK, TT2
        .ASCIC  "Fallback"
        .BYTE   TT2$V_DIALUP, TT2
        .ASCIC  "Dialup"
        .BYTE   TT2$V_SECURE, TT2
        .ASCIC  "Secure server"
        .BYTE   TT2$V_DISCONNECT, TT2
        .ASCIC  "Disconnect"
        .BYTE   TT2$V_PASTHRU, TT2
        .ASCIC  "Pasthru"
        .BYTE   TT2$V_SYSPWD, TT2
        .ASCIC  "Syspassword"
        .BYTE   TT2$V_SIXEL, TT2
        .ASCIC  "SIXEL Graphics"
        .BYTE   TT2$V_DRCS, TT2
        .ASCIC  "Soft Characters"
        .BYTE   TT2$V_PRINTER, TT2
        .ASCIC  "Printer Port"
        .BYTE   TT2$V_APP_KEYPAD, TT2!NOT!ALT
        .ASCIC  "Numeric Keypad"
        .ASCIC  "Application keypad"
        .BYTE   TT2$V_ANSICRT, TT2
        .ASCIC  "ANSI_CRT"
        .BYTE   TT2$V_REGIS, TT2
        .ASCIC  "Regis"
        .BYTE   TT2$V_BLOCK, TT2
        .ASCIC  "Block_mode"
        .BYTE   TT2$V_AVO, TT2
        .ASCIC  "Advanced_video"
        .BYTE   TT2$V_EDIT, TT2
        .ASCIC  "Edit_mode"
        .BYTE   TT2$V_DECCRT, TT2
        .ASCIC  "DEC_CRT"
        .BYTE   TT2$V_DECCRT2, TT2
        .ASCIC  "DEC_CRT2"
        .BYTE   TT2$V_DECCRT3, TT2
        .ASCIC  "DEC_CRT3"
        .BYTE   TT2$V_DECCRT4, TT2
        .ASCIC  "DEC_CRT4"
        .BYTE   255

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7, R8, R9>
        GETVALUE "OPTION", DESC, DESC
        BLBC    R0, SYSTEM
        CMPB    WHAT, #^A/T/
        BNEQ    5$
        BRW     SHOWTERM
5$:     CMPB    WHAT, #^A/P/
        BNEQ    SYSTEM

; SHOW PROCESS
        $GETJPIW_S ITMLST=JPIITEMS
        BLBC    R0, 90$
        PRINT   ""
        BSBW    ADDDATE
        BSBW    SAY
        ADDTEXT "Process ID:         "
        MOVL    PID, R1
        BSBW    ADDHEX
        BSBW    SAY
        ADDTEXT "Process name:       "
        MOVZBL  #34, R0
        BSBW    ADDCHAR
        BSBW    ADDNAME
        MOVZBL  #34, R0
        BSBW    ADDCHAR
        BSBW    SAY
        ADDTEXT "Priority:           "
        MOVL    PRI, R1
        BSBW    ADDDEC
        BSBW    SAY
        ADDTEXT "Base priority:      "
        MOVL    PRIB, R1
        BSBW    ADDDEC
        BSBW    SAY
        ADDTEXT "UIC:                ["
        MOVZWL  UIC+2, R1
        BSBW    ADDOCT
        ADDTEXT ","
        MOVZWL  UIC, R1
        BSBW    ADDOCT
        ADDTEXT "]"
        BSBW    SAY
        PRESENT "PRIVILEGES"
        BLBC    R0, 80$
        PRINT   ""
        PRINT   "Authorized privileges:"
        MOVAQ   AUTHPRIV, R6
        BSBW    PRIVS
        PRINT   ""
        PRINT   "Process privileges:"
        MOVAQ   CURPRIV, R6
        BSBW    PRIVS
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; SHOW SYSTEM
SYSTEM: $GETSYIW_S ITMLST=SYIITEMS
        BLBC    R0, 90$
        $GETTIM_S TIMADR=NOW
        SUBL2   BOOTTIME+4, NOW+4       ; how long it has been up,
        SUBL2   BOOTTIME, NOW
        BCC     5$
        DECL    NOW+4
5$:        EDIV    #10000000, NOW, R4, R0  ; in seconds
        ADDTEXT "vaxpunk "
        MOVAB   VERSION, R1
        MOVL    #8, R2
        BSBW    ADD
        ADDTEXT "  "
        BSBW    ADDDATE
        ADDTEXT "  Uptime  "
        DIVL3   #86400, R4, R1          ; days
        MULL3   #86400, R1, R0
        SUBL2   R0, R4
        BSBW    ADDDEC
        ADDTEXT " "
        DIVL3   #3600, R4, R1           ; hours
        MULL3   #3600, R1, R0
        SUBL2   R0, R4
        BSBW    ADD2
        ADDTEXT ":"
        DIVL3   #60, R4, R1             ; minutes
        MULL3   #60, R1, R0
        SUBL2   R0, R4
        BSBW    ADD2
        ADDTEXT ":"
        MOVL    R4, R1                  ; seconds
        BSBW    ADD2
        BSBW    SAY
        PRINT   "  Pid    Process Name    State  Pri Image"
10$:    $GETJPIW_S PIDADR=CTX, ITMLST=JPIITEMS
        CMPL    R0, #SS$_NOMOREPROC
        BEQL    80$
        BLBC    R0, 90$
        MOVL    PID, R1
        BSBW    ADDHEX
        ADDTEXT " "
        BSBW    ADDNAME
        MOVL    #25, R3
        BSBW    PADTO
        MOVL    STATE, R1
        CMPL    R1, #MAXSTATE
        BLEQU   20$
        CLRL    R1
20$:    MULL2   #5, R1
        MOVAB   STATES[R1], R1
        MOVL    #5, R2
        BSBW    ADD
        MOVL    #32, R3
        BSBW    PADTO
        MOVL    PRI, R1
        CMPL    R1, #10
        BGEQU   30$
        ADDTEXT " "
        MOVL    PRI, R1
30$:    BSBW    ADDDEC
        ADDTEXT " "
        MOVAB   IMAGE, R1
        MOVZWL  IMGLEN, R2
        BSBW    ADD
        BSBW    SAY
        BRW     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; SHOW TERMINAL
SHOWTERM:
        PUSHAB  TTCHAR
        PUSHAW  TTCHAN
        CALLS   #2, G^TERM_SENSE
        BLBC    R0, 5$
        $GETDVIW_S CHAN=TTCHAN, ITMLST=DVIITEMS
        BLBC    R0, 5$
        $GETJPIW_S ITMLST=JPIITEMS
        BLBS    R0, 10$
5$:     RET
10$:    ADDTEXT "Terminal: "
        MOVAB   TTNAME, R1
        MOVZWL  TTNAMLEN, R2
        BSBW    ADD
        MOVL    #22, R3
        BSBW    PADTO
        ADDTEXT "Device_Type: "
        CMPB    TTCHAR+1, #DT$_VT100
        BNEQ    15$
        ADDTEXT "VT100"
        BRB     20$
15$:    ADDTEXT "Unknown"
20$:    MOVL    #49, R3
        BSBW    PADTO
        ADDTEXT "Owner: "
        BSBW    ADDNAME
        BSBW    SAY
        PRINT   ""
        ADDTEXT "   Input:    9600     LFfill:  0      Width: "
        MOVZWL  TTCHAR+2, R1
        BSBW    ADD3
        MOVL    #54, R3
        BSBW    PADTO
        ADDTEXT "Parity: None"
        BSBW    SAY
        ADDTEXT "   Output:   9600     CRfill:  0      Page:  "
        MOVZBL  TTCHAR+7, R1
        BSBW    ADD3
        BSBW    SAY
        PRINT   ""
        PRINT   "Terminal Characteristics:"
        MOVAB   CHARS, R6
        CLRL    R7                      ; on the line
30$:    MOVZBL  (R6)+, R8               ; the bit
        CMPL    R8, #255
        BEQL    70$
        MOVZBL  (R6)+, R9               ; its flags
        MULL3   #19, R7, R3
        ADDL2   #3, R3
        BSBW    PADTO
        MOVL    TTCHAR+4, R0
        BBC     #0, R9, 35$             ; TT2
        MOVL    TTCHAR+8, R0
35$:    EXTZV   R8, #1, R0, R0
        BBC     #1, R9, 40$             ; NOT
        XORL2   #1, R0
40$:    BBS     #2, R9, 50$             ; ALT
        BLBS    R0, 45$
        ADDTEXT "No "
45$:    BSBW    ADDCIC
        BRB     60$
50$:    BLBS    R0, 55$
        BSBW    SKIPCIC                 ; off: the second name
        BSBW    ADDCIC
        BRB     60$
55$:    BSBW    ADDCIC
        BSBW    SKIPCIC
60$:    AOBLSS  #4, R7, 30$
        BSBW    SAY
        CLRL    R7
        BRB     30$
70$:    TSTL    R7
        BEQL    80$
        BSBW    SAY
80$:    MOVL    #SS$_NORMAL, R0
        RET

; ADDCIC: appends the .ASCIC string at R6 to LINE, and moves R6 past it.
; SKIPCIC moves R6 past it only. Uses R0-R2.
ADDCIC:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2>
        MOVZBL  (R6), R2
        ADDL3   #1, R6, R1
        BSBW    ADD
        BRB     SKIPCIC                 ; a tail call
SKIPCIC:
        .JSB_ENTRY  OUTPUT=<R6>
        MOVZBL  (R6), R0
        ADDL2   R0, R6
        INCL    R6
        RSB

; ADD3: appends R1, below 1000, in decimal to LINE, right aligned in 3
; characters. Uses R0-R3, R5.
ADD3:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        PUSHL   R1
        CMPL    R1, #100
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
        CMPL    (SP), #10
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
10$:    MOVL    (SP)+, R1
        BRW     ADDDEC

; PRIVS: R6 = a quadword of privileges. Writes their names, six to a
; line. Uses R0-R3, R7-R9.
PRIVS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R7, R8, R9>
        MOVAB   G^PRV_NAMES, R7
        CLRL    R8                      ; the bit
        CLRL    R9                      ; names on the line
10$:    TSTB    (R7)
        BEQL    40$
        BBC     R8, (R6), 30$
        MULL3   #13, R9, R3
        INCL    R3
        BSBW    PADTO
        MOVZBL  (R7), R2
        ADDL3   #1, R7, R1
        BSBW    ADD
        INCL    R9
        CMPL    R9, #6
        BLSS    30$
        BSBW    SAY
        CLRL    R9
30$:    MOVZBL  (R7), R0
        ADDL2   R0, R7
        INCL    R7
        INCL    R8
        BRB     10$
40$:    TSTL    R9
        BEQL    50$
        BSBW    SAY
50$:    RSB

; ADDOCT: appends R1 in octal to LINE. Uses R0-R3.
ADDOCT:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        CLRL    R3                      ; digits, on the stack
10$:    EXTZV   #0, #3, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R3
        ASHL    #-3, R1, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBW    ADDCHAR
        SOBGTR  R3, 30$
        RSB

; ADDNAME: appends the process's name, NAME, to LINE. Uses R0-R2.
ADDNAME:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVAB   NAME, R1
        MOVZWL  NAMLEN, R2
        BRB     ADD

; PADTO: appends blanks to LINE until it is R3 characters long. Uses R0-R2.
PADTO:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
        CMPL    R0, R3
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBB    ADDCHAR
        BRB     PADTO
10$:    RSB

; ADDHEX: appends R1 in 8 hex digits to LINE. Uses R0-R5.
ADDHEX:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R1, R4
        MOVL    #8, R5
10$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVZBL  HEX[R0], R0
        BSBB    ADDCHAR
        SOBGTR  R5, 10$
        RSB

; ADD2: appends R1, below 100, in 2 decimal digits to LINE. Uses R0-R5.
ADD2:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CMPL    R1, #10
        BGEQU   ADDDEC
        PUSHL   R1
        MOVZBL  #^A/0/, R0
        BSBB    ADDCHAR
        MOVL    (SP)+, R1
        BRB     ADDDEC                  ; a tail call, not a fall-through
; ADDDEC: appends R1 in decimal to LINE. Uses R0-R3, R5.
ADDDEC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        CLRL    R3                      ; digits, on the stack
10$:    DIVL3   #10, R1, R5
        MULL3   #10, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R3
        MOVL    R5, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBB    ADDCHAR
        SOBGTR  R3, 30$
        RSB

; SAY: writes the line in LINE, and empties it. Uses R0 and R1.
SAY:
        .JSB_ENTRY
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        RSB

; ADDDATE: appends the date and time to LINE. Uses R0-R2.
ADDDATE:
        .JSB_ENTRY  SCRATCH=<R2>
        $ASCTIM_S TIMLEN=DATELEN, TIMBUF=DATEDSC
        MOVAB   DATE, R1
        MOVZWL  DATELEN, R2
        BSBW    ADD
        RSB

; ADDCHAR: appends the character in R0 to LINE. Uses R0-R2.
ADDCHAR:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
; ADD: appends the R2 bytes at R1 to LINE, as many as fit. Uses R0-R2.
ADD:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, LINE[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, LINE
        RSB

        .END    START
