        .TITLE  SHOW    Shows the process and the system
        .IDENT  /V0.1/
;
; DCL's SHOW PROCESS and SHOW SYSTEM run this, as VMS's DCL runs SHOW.EXE
; for them; OPTION, the parameter, says which. SHOW PROCESS
; shows the date, $ASCTIM's, and this process, what $GETJPI says of it,
; and with /PRIVILEGES its authorized and current privileges, with /QUOTAS
; what is left of its I/O quotas, as VMS's shows them. SHOW SYSTEM
; shows the version, the date and how long the system has been up, from
; $GETSYI, then a line for each process, from a wildcard $GETJPI: its PID,
; name, state, priority and image.
; SHOW TERMINAL shows the terminal's characteristics (lib/term.mar), or
; with /PERMANENT its permanent ones, under VMS's headings and names,
; four to a line.
; SHOW USERS lists the users logged in at terminals, the interactive
; processes, from a wildcard $GETJPI, sorted by username: how many each
; has, or with /FULL each process and its terminal; with a username,
; only the users whose names start so. SHOW MEMORY shows the physical
; pages, the process slots and nonpaged pool, from $GETSYI; /PHYSICAL_PAGES,
; /SLOTS and /POOL choose among them. SHOW ERROR lists the devices that
; have had errors, $DEVICE_SCAN's with $GETDVI's DVI$_ERRCNT, or with
; /FULL every device, the CPU's and memory's too. SHOW QUOTA says the
; disk, /DISK's or SYS$DISK's, has no disk quotas, which none has
; (t8y:/files/disk-quotas). SHOW CPU shows the machine and its CPU sets,
; or with /BRIEF the CPU and the process it runs, with /FULL its page
; size too.
; SHOW PROCESS/RIGHTS lists the process's rights, $GETJPI's
; JPI$_PROCESS_RIGHTS: its UIC's identifier and those it holds, with their
; attributes. SHOW SECURITY shows each file a specification names, with
; wildcards, its owner, protection and ACL, $GET_SECURITY's, the ACEs as
; $FORMAT_ACL writes them (docs/adr/0040-acls-in-file-headers-and-rights-
; identifiers.md).
; ponytail: no node, CPU time, I/O or page counts: the counters don't
; exist yet. No SCSNODE, so no Node column or node name; no subprocesses
; or batch jobs, so SHOW USERS counts interactive processes only; no
; paged pool, balance set, page or swap files for SHOW MEMORY; no machine
; check or memory error counts for SHOW ERROR, which shows 0; SHOW
; QUOTA's /USER is taken and ignored, as no volume has a quota file. No
; system rights for SHOW PROCESS/RIGHTS, and SHOW SECURITY's class is
; FILE; lines are 80 characters, not the terminal's width. A
; terminal has no parity or fill, and its input is VMS style, CTRL/H
; back to the line's start.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $JPIDEF
        $SYIDEF
        $DVIDEF
        $DCDEF
        $TTDEF
        $TT2DEF
        $TT3DEF
        $DVSDEF
        $RMSDEF
        $FABDEF
        $NAMDEF
        $OSSDEF

        .EXTERNAL PUT_LINE, PRV_NAMES, TERM_SENSE, TERM_NAME, TERM_SPEEDS, ID_TEXT

TT2 = 1                                 ; CHARS: a TT2$ bit, not a TT$ one,
NOT = 2                                 ; on when it is clear,
ALT = 4                                 ; with a name for off, not No and the name,
TT3 = 8                                 ; a TT3$ bit

; ADDTEXT "text": appends text to LINE. Uses R0-R2.
        .MACRO  ADDTEXT TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        .ENDM   ADDTEXT

REC = 48                                ; SHOW USERS's table: a process each,
R_USER = 0                              ; its username,
R_PID = 12                              ; PID,
R_NAMLEN = 16                           ; process name's length,
R_TERMLEN = 18                          ; terminal's length,
R_NAME = 20                             ; process name
R_TERM = 36                             ; and terminal

        .PSECT  DATA, NOEXE, WRT, LONG
DESC:   .LONG   8                       ; OPTION, the keyword
        .ADDRESS WHAT
WHAT:   .BLKB   8
CTX:    .LONG   -1                      ; the wildcard $GETJPI's scan
JPIITEMS:                               ; what $GETJPIW returns of a process
        .WORD   4, JPI$_PID
        .ADDRESS PID
        .LONG   0
        .WORD   15, JPI$_PRCNAM
        .ADDRESS NAME
        .ADDRESS NAMLEN
        .WORD   4, JPI$_STATE
        .ADDRESS STATE
        .LONG   0
        .WORD   4, JPI$_PRI
        .ADDRESS PRI
        .LONG   0
        .WORD   4, JPI$_PRIB
        .ADDRESS PRIB
        .LONG   0
        .WORD   39, JPI$_IMAGNAME
        .ADDRESS IMAGE
        .ADDRESS IMGLEN
        .WORD   4, JPI$_UIC
        .ADDRESS UIC
        .LONG   0
        .WORD   8, JPI$_CURPRIV
        .ADDRESS CURPRIV
        .LONG   0
        .WORD   8, JPI$_AUTHPRIV
        .ADDRESS AUTHPRIV
        .LONG   0
        .WORD   12, JPI$_USERNAME
        .ADDRESS USER
        .LONG   0
        .WORD   7, JPI$_TERMINAL
        .ADDRESS TERM
        .ADDRESS TERMLEN
        .WORD   4, JPI$_MODE
        .ADDRESS MODE
        .LONG   0
        .WORD   4, JPI$_BIOCNT
        .ADDRESS BIOCNT
        .LONG   0
        .WORD   4, JPI$_DIOCNT
        .ADDRESS DIOCNT
        .LONG   0
        .WORD   4, JPI$_BYTCNT
        .ADDRESS BYTCNT
        .LONG   0
        .LONG   0
SYIITEMS:                               ; and $GETSYIW of the system
        .WORD   8, SYI$_VERSION
        .ADDRESS VERSION
        .LONG   0
        .WORD   8, SYI$_BOOTTIME
        .ADDRESS BOOTTIME
        .LONG   0
        .LONG   0
SYSITEMS:                               ; SHOW MEMORY's and SHOW CPU's $GETSYIW
        .WORD   4, SYI$_MEMSIZE
        .ADDRESS MEMSIZE
        .LONG   0
        .WORD   4, SYI$_FREE_PAGES
        .ADDRESS FREEPG
        .LONG   0
        .WORD   4, SYI$_PAGE_SIZE
        .ADDRESS PAGSIZ
        .LONG   0
        .WORD   4, SYI$_MAXPROCESSCNT
        .ADDRESS MAXPRC
        .LONG   0
        .WORD   4, SYI$_PROCESS_CNT
        .ADDRESS PRCCNT
        .LONG   0
        .WORD   4, SYI$_NPAGED_TOTAL
        .ADDRESS NPGTOT
        .LONG   0
        .WORD   4, SYI$_NPAGED_FREE
        .ADDRESS NPGFREE
        .LONG   0
        .WORD   4, SYI$_NPAGED_INUSE
        .ADDRESS NPGUSE
        .LONG   0
        .WORD   4, SYI$_NPAGED_LARGEST
        .ADDRESS NPGBIG
        .LONG   0
        .WORD   31, SYI$_HW_NAME
        .ADDRESS HWNAME
        .ADDRESS HWNAMLEN
        .WORD   4, SYI$_ACTIVECPU_CNT
        .ADDRESS ACTCPU
        .LONG   0
        .WORD   4, SYI$_AVAILCPU_CNT
        .ADDRESS AVLCPU
        .LONG   0
        .WORD   4, SYI$_PRIMARY_CPUID
        .ADDRESS PRICPU
        .LONG   0
        .LONG   0
MEMSIZE:.LONG   0                       ; pages of memory,
FREEPG: .LONG   0                       ; those free,
PAGSIZ: .LONG   0                       ; a page's bytes,
MAXPRC: .LONG   0                       ; the processes there may be,
PRCCNT: .LONG   0                       ; and are,
NPGTOT: .LONG   0                       ; nonpaged pool's bytes,
NPGFREE:.LONG   0                       ; free,
NPGUSE: .LONG   0                       ; in use,
NPGBIG: .LONG   0                       ; and its largest free block's,
ACTCPU: .LONG   0                       ; the CPUs running,
AVLCPU: .LONG   0                       ; those there are,
PRICPU: .LONG   0                       ; the primary's ID,
HWNAMLEN:                               ; and the machine's name
        .WORD   0
HWNAME: .BLKB   31
USRDSC: .LONG   12                      ; SHOW USERS's username, its start
        .ADDRESS USRPAT
USRPAT: .BLKB   12
RANGE:  .BLKQ   1                       ; its table's pages, $EXPREG's
SCANCTX:                                ; SHOW ERROR's $DEVICE_SCAN's context
        .BLKQ   1
DEVDSC: .LONG   16                      ; the device it found, _DDCU:
        .ADDRESS DEVNAM
DEVRET: .LONG   0                       ; and its length, a descriptor of it
        .ADDRESS DEVNAM
DEVNAM: .BLKB   16
ERRITEMS:                               ; what $GETDVIW returns of it
        .WORD   4, DVI$_ERRCNT
        .ADDRESS ERRCNT
        .LONG   0
        .LONG   0
ERRCNT: .LONG   0
QDSC:   .LONG   64                      ; SHOW QUOTA's disk
        .ADDRESS QDISK
QDISK:  .BLKB   64
SYSDISK:.ASCID  "SYS$DISK"
CLSITEMS:                               ; what $GETDVIW returns of it
        .WORD   4, DVI$_DEVCLASS
        .ADDRESS ERRCNT
        .LONG   0
        .LONG   0
PID:    .LONG   0
STATE:  .LONG   0
PRI:    .LONG   0
PRIB:   .LONG   0
UIC:    .LONG   0
BIOCNT: .LONG   0                       ; what is left of its I/O quotas
DIOCNT: .LONG   0
BYTCNT: .LONG   0
CURPRIV:
        .BLKQ   1
AUTHPRIV:
        .BLKQ   1
USER:   .BLKB   12
TERMLEN:.WORD   0
TERM:   .BLKB   7
MODE:   .LONG   0
NAMLEN: .WORD   0
IMGLEN: .WORD   0
NAME:   .BLKB   15
IMAGE:  .BLKB   39
VERSION:
        .BLKB   8
BOOTTIME:
        .BLKQ   1
NOW:    .BLKQ   1
DATEDSC:
        .LONG   23                      ; $ASCTIM's buffer
        .ADDRESS DATE
DATE:   .BLKB   23
DATELEN:
        .WORD   0
; The scheduling states' names, VMS's, by SCH$C_ value, 5 characters each.
STATES: .ASCII  "     COLPGMWAITCEF  PFW  LEF  LEFO HIB  "
        .ASCII  "HIBO SUSP SUSPOFPG  COM  COMO CUR  "
MAXSTATE = 14
HEX:    .ASCII  "0123456789ABCDEF"
NRIGHTS = 1025                          ; SHOW PROCESS/RIGHTS's: its UIC and the identifiers a process may hold
RIGHTSITEMS:
        .WORD   NRIGHTS*8, JPI$_PROCESS_RIGHTS
        .ADDRESS RIGHTS, RIGHTSLEN
        .LONG   0
RIGHTSLEN:
        .WORD   0
RIGHTS: .BLKQ   NRIGHTS
IDNAME: .LONG   32                      ; an identifier's name
        .ADDRESS IDBUF
IDLEN:  .WORD   0
IDBUF:  .BLKB   48
SECCLS: .LONG   16                      ; SHOW SECURITY's /CLASS
        .ADDRESS SECCLSBUF
SECCLSBUF:
        .BLKB   16
FILECLS:.ASCID  "FILE"
MSGDSC: .LONG   255                     ; a message, $GETMSG's
        .ADDRESS LINE+1
MSGLEN: .WORD   0
SPECDSC:.LONG   255                     ; its object, the parameter
        .ADDRESS SPEC
SPEC:   .BLKB   255
FAB:    $FAB    FNA=SPEC, NAM=NAM
NAM:    $NAM    ESA=EXP, ESS=255, RSA=RES, RSS=255
EXP:    .BLKB   255
RES:    .BLKB   255
        .ALIGN  LONG
OBJDSC: .LONG   0                       ; a file's resultant string
        .ADDRESS RES
OWNER:  .LONG   0                       ; what $GET_SECURITY reads of it
PROT:   .LONG   0
ACLLEN: .LONG   0
SECITEMS:
        .WORD   4, OSS$_OWNER
        .ADDRESS OWNER, 0
        .WORD   4, OSS$_PROTECTION
        .ADDRESS PROT, 0
        .WORD   4, OSS$_ACL_LENGTH
        .ADDRESS ACLLEN, 0
        .LONG   0
ACEITEMS:                               ; and of its ACEs, one at a time
        .WORD   256, OSS$_ACL_READ_ENTRY
        .ADDRESS ACE, 0
        .LONG   0
SECCTX: .LONG   0
ACE:    .BLKB   256
ACEDSC: .LONG   256
        .ADDRESS ACE
FMTDSC: .LONG   1024                    ; an ACE's text
        .ADDRESS FMTBUF
FMTLEN: .WORD   0
FMTBUF: .BLKB   1024
FMTWIDTH:
        .WORD   80
FMTINDENT:
        .WORD   10
NEWLINE:.ASCID  <10>
CATNAMES:                               ; the protection's categories
        .ASCIC  "System"
        .ASCIC  "Owner"
        .ASCIC  "Group"
        .ASCIC  "World"
LETTERS:.ASCII  "RWED"
LINE:   .BLKB   256                     ; a line being made, .ASCIC
CHAR:   .BLKB   1
TTCHAN: .LONG   0                       ; the terminal's
TTCHAR: .BLKB   16                      ; its characteristics,
TTIOSB: .BLKQ   1                       ; and speeds
DVIITEMS:                               ; what $GETDVIW returns of it
        .WORD   64, DVI$_DEVNAM
        .ADDRESS TTNAME
        .ADDRESS TTNAMLEN
        .LONG   0
TTNAMLEN:
        .WORD   0
TTNAME: .BLKB   64
; The characteristics SHOW TERMINAL shows, in VMS's order: each a bit,
; its flags, TT2, NOT and ALT, and its name, .ASCIC, then for ALT the
; name for off; a 255 ends them.
CHARS:  .BYTE   TT$V_PASSALL, NOT!ALT
        .ASCIC  "Interactive"
        .ASCIC  "Passall"
        .BYTE   TT$V_NOECHO, NOT
        .ASCIC  "Echo"
        .BYTE   TT$V_NOTYPEAHD, NOT
        .ASCIC  "Type_ahead"
        .BYTE   TT$V_ESCAPE, 0
        .ASCIC  "Escape"
        .BYTE   TT$V_HOSTSYNC, 0
        .ASCIC  "Hostsync"
        .BYTE   TT$V_TTSYNC, 0
        .ASCIC  "TTsync"
        .BYTE   TT$V_LOWER, 0
        .ASCIC  "Lowercase"
        .BYTE   TT$V_MECHTAB, 0
        .ASCIC  "Tab"
        .BYTE   TT$V_WRAP, 0
        .ASCIC  "Wrap"
        .BYTE   TT$V_SCOPE, 0
        .ASCIC  "Scope"
        .BYTE   TT$V_REMOTE, 0
        .ASCIC  "Remote"
        .BYTE   TT$V_EIGHTBIT, 0
        .ASCIC  "Eightbit"
        .BYTE   TT$V_NOBRDCST, NOT
        .ASCIC  "Broadcast"
        .BYTE   TT$V_READSYNC, 0
        .ASCIC  "Readsync"
        .BYTE   TT$V_MECHFORM, 0
        .ASCIC  "Form"
        .BYTE   TT$V_HALFDUP, NOT!ALT
        .ASCIC  "Fulldup"
        .ASCIC  "Halfdup"
        .BYTE   TT$V_MODEM, 0
        .ASCIC  "Modem"
        .BYTE   TT2$V_LOCALECHO, TT2
        .ASCIC  "Local_echo"
        .BYTE   TT2$V_AUTOBAUD, TT2
        .ASCIC  "Autobaud"
        .BYTE   TT2$V_HANGUP, TT2
        .ASCIC  "Hangup"
        .BYTE   TT2$V_BRDCSTMBX, TT2
        .ASCIC  "Brdcstmbx"
        .BYTE   TT2$V_DMA, TT2
        .ASCIC  "DMA"
        .BYTE   TT2$V_ALTYPEAHD, TT2
        .ASCIC  "Altypeahd"
        .BYTE   TT2$V_SETSPEED, TT2
        .ASCIC  "Set_speed"
        .BYTE   TT2$V_COMMSYNC, TT2
        .ASCIC  "Commsync"
        .BYTE   TT2$V_EDITING, TT2
        .ASCIC  "Line Editing"
        .BYTE   TT2$V_INSERT, TT2!ALT
        .ASCIC  "Insert editing"
        .ASCIC  "Overstrike editing"
        .BYTE   TT2$V_FALLBACK, TT2
        .ASCIC  "Fallback"
        .BYTE   TT2$V_DIALUP, TT2
        .ASCIC  "Dialup"
        .BYTE   TT2$V_SECURE, TT2
        .ASCIC  "Secure server"
        .BYTE   TT2$V_DISCONNECT, TT2
        .ASCIC  "Disconnect"
        .BYTE   TT2$V_PASTHRU, TT2
        .ASCIC  "Pasthru"
        .BYTE   TT2$V_SYSPWD, TT2
        .ASCIC  "Syspassword"
        .BYTE   TT2$V_SIXEL, TT2
        .ASCIC  "SIXEL Graphics"
        .BYTE   TT2$V_DRCS, TT2
        .ASCIC  "Soft Characters"
        .BYTE   TT2$V_PRINTER, TT2!ALT
        .ASCIC  "Printer port"
        .ASCIC  "No Printer Port"
        .BYTE   TT2$V_APP_KEYPAD, TT2!NOT!ALT
        .ASCIC  "Numeric Keypad"
        .ASCIC  "Application keypad"
        .BYTE   TT2$V_ANSICRT, TT2
        .ASCIC  "ANSI_CRT"
        .BYTE   TT2$V_REGIS, TT2
        .ASCIC  "Regis"
        .BYTE   TT2$V_BLOCK, TT2
        .ASCIC  "Block_mode"
        .BYTE   TT2$V_AVO, TT2
        .ASCIC  "Advanced_video"
        .BYTE   TT2$V_EDIT, TT2
        .ASCIC  "Edit_mode"
        .BYTE   TT2$V_DECCRT, TT2
        .ASCIC  "DEC_CRT"
        .BYTE   TT2$V_DECCRT2, TT2
        .ASCIC  "DEC_CRT2"
        .BYTE   TT2$V_DECCRT3, TT2
        .ASCIC  "DEC_CRT3"
        .BYTE   TT2$V_DECCRT4, TT2
        .ASCIC  "DEC_CRT4"
        .BYTE   TT3$V_DECCRT5, TT3
        .ASCIC  "DEC_CRT5"
        .BYTE   TT3$V_ANSI_COLOR, TT3
        .ASCIC  "Ansi_Color"
        .BYTE   255

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7, R8, R9>
        GETVALUE "OPTION", DESC, DESC
        BLBC    R0, 4$
        MOVZBL  WHAT, R0
        CMPB    R0, #^A/T/
        BEQL    5$
        CMPB    R0, #^A/U/
        BEQL    6$
        CMPB    R0, #^A/M/
        BEQL    7$
        CMPB    R0, #^A/E/
        BEQL    8$
        CMPB    R0, #^A/Q/
        BEQL    9$
        CMPB    R0, #^A/C/
        BEQL    3$
        CMPB    R0, #^A/P/
        BEQL    PROCESS
        CMPW    WHAT, #^A/SE/
        BNEQ    4$
        CALLS   #0, SECURITY
        RET
4$:     BRW     SYSTEM
3$:     BRW     SHOWCPU
5$:     BRW     SHOWTERM
6$:     BRW     SHOWUSERS
7$:     BRW     SHOWMEM
8$:     BRW     SHOWERR
9$:     BRW     SHOWQUOTA

; SHOW PROCESS
PROCESS:
        $GETJPIW_S ITMLST=JPIITEMS
        BLBC    R0, 90$
        PRINT   ""
        BSBW    ADDDATE
        BSBW    SAY
        ADDTEXT "Process ID:         "
        MOVL    PID, R1
        BSBW    ADDHEX
        BSBW    SAY
        ADDTEXT "Process name:       "
        MOVZBL  #34, R0
        BSBW    ADDCHAR
        BSBW    ADDNAME
        MOVZBL  #34, R0
        BSBW    ADDCHAR
        BSBW    SAY
        ADDTEXT "Priority:           "
        MOVL    PRI, R1
        BSBW    ADDDEC
        BSBW    SAY
        ADDTEXT "Base priority:      "
        MOVL    PRIB, R1
        BSBW    ADDDEC
        BSBW    SAY
        ADDTEXT "UIC:                ["
        MOVZWL  UIC+2, R1
        BSBW    ADDOCT
        ADDTEXT ","
        MOVZWL  UIC, R1
        BSBW    ADDOCT
        ADDTEXT "]"
        BSBW    SAY
        PRESENT "PRIVILEGES"
        BLBC    R0, 80$
        PRINT   ""
        PRINT   "Authorized privileges:"
        MOVAQ   AUTHPRIV, R6
        BSBW    PRIVS
        PRINT   ""
        PRINT   "Process privileges:"
        MOVAQ   CURPRIV, R6
        BSBW    PRIVS
80$:    PRESENT "QUOTAS"
        BLBC    R0, 85$
        PRINT   ""
        PRINT   "Process Quotas:"
        ADDTEXT " CPU limit:                      Infinite  Direct I/O limit:"
        MOVL    DIOCNT, R1
        MOVL    #71, R3
        BSBW    RIGHT
        BSBW    SAY
        ADDTEXT " Buffered I/O byte count quota:"
        MOVL    BYTCNT, R1
        MOVL    #41, R3
        BSBW    RIGHT
        ADDTEXT "  Buffered I/O limit:"
        MOVL    BIOCNT, R1
        MOVL    #71, R3
        BSBW    RIGHT
        BSBW    SAY
85$:    PRESENT "RIGHTS"
        BLBC    R0, 87$
        BSBW    SHOWRIGHTS
87$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; SHOW SYSTEM
SYSTEM: $GETSYIW_S ITMLST=SYIITEMS
        BLBC    R0, 90$
        $GETTIM_S TIMADR=NOW
        SUBL2   BOOTTIME+4, NOW+4       ; how long it has been up,
        SUBL2   BOOTTIME, NOW
        BCC     5$
        DECL    NOW+4
5$:        EDIV    #10000000, NOW, R4, R0  ; in seconds
        ADDTEXT "vaxpunk "
        MOVAB   VERSION, R1
        MOVL    #8, R2
        BSBW    ADD
        ADDTEXT "  "
        BSBW    ADDDATE
        ADDTEXT "  Uptime  "
        DIVL3   #86400, R4, R1          ; days
        MULL3   #86400, R1, R0
        SUBL2   R0, R4
        BSBW    ADDDEC
        ADDTEXT " "
        DIVL3   #3600, R4, R1           ; hours
        MULL3   #3600, R1, R0
        SUBL2   R0, R4
        BSBW    ADD2
        ADDTEXT ":"
        DIVL3   #60, R4, R1             ; minutes
        MULL3   #60, R1, R0
        SUBL2   R0, R4
        BSBW    ADD2
        ADDTEXT ":"
        MOVL    R4, R1                  ; seconds
        BSBW    ADD2
        BSBW    SAY
        PRINT   "  Pid    Process Name    State  Pri Image"
10$:    $GETJPIW_S PIDADR=CTX, ITMLST=JPIITEMS
        CMPL    R0, #SS$_NOMOREPROC
        BEQL    80$
        BLBC    R0, 90$
        MOVL    PID, R1
        BSBW    ADDHEX
        ADDTEXT " "
        BSBW    ADDNAME
        MOVL    #25, R3
        BSBW    PADTO
        MOVL    STATE, R1
        CMPL    R1, #MAXSTATE
        BLEQU   20$
        CLRL    R1
20$:    MULL2   #5, R1
        MOVAB   STATES[R1], R1
        MOVL    #5, R2
        BSBW    ADD
        MOVL    #32, R3
        BSBW    PADTO
        MOVL    PRI, R1
        CMPL    R1, #10
        BGEQU   30$
        ADDTEXT " "
        MOVL    PRI, R1
30$:    BSBW    ADDDEC
        ADDTEXT " "
        MOVAB   IMAGE, R1
        MOVZWL  IMGLEN, R2
        BSBW    ADD
        BSBW    SAY
        BRW     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; SHOW TERMINAL
SHOWTERM:
        PUSHAQ  TTIOSB
        PUSHAB  TTCHAR
        PUSHAW  TTCHAN
        CALLS   #3, G^TERM_SENSE
        BLBC    R0, 5$
        $GETDVIW_S CHAN=TTCHAN, ITMLST=DVIITEMS
        BLBC    R0, 5$
        $GETJPIW_S ITMLST=JPIITEMS
        BLBS    R0, 10$
5$:     RET
10$:    ADDTEXT "Terminal: "
        MOVAB   TTNAME, R1
        MOVZWL  TTNAMLEN, R2
        BSBW    ADD
        MOVL    #22, R3
        BSBW    PADTO
        ADDTEXT "Device_Type: "
        MOVZBL  TTCHAR+1, -(SP)
        CALLS   #1, G^TERM_NAME
        MOVL    R0, R6
        BSBW    ADDCIC
        MOVL    #49, R3
        BSBW    PADTO
        ADDTEXT "Owner: "
        BSBW    ADDNAME
        BSBW    SAY
        PRINT   ""
        ADDTEXT "   Input:"
        MOVZBL  TTIOSB+3, R1            ; receive
        BSBW    SPEED
        ADDTEXT "     LFfill:  0      Width: "
        MOVZWL  TTCHAR+2, R1
        BSBW    ADD3
        MOVL    #54, R3
        BSBW    PADTO
        ADDTEXT "Parity: None"
        BSBW    SAY
        ADDTEXT "   Output:"
        MOVZBL  TTIOSB+2, R1            ; transmit
        BSBW    SPEED
        ADDTEXT "     CRfill:  0      Page:  "
        MOVZBL  TTCHAR+7, R1
        BSBW    ADD3
        BSBW    SAY
        PRINT   ""
        PRINT   "Terminal Characteristics:"
        MOVAB   CHARS, R6
        CLRL    R7                      ; on the line
30$:    MOVZBL  (R6)+, R8               ; the bit
        CMPL    R8, #255
        BEQL    70$
        MOVZBL  (R6)+, R9               ; its flags
        MULL3   #19, R7, R3
        ADDL2   #3, R3
        BSBW    PADTO
        MOVL    TTCHAR+4, R0
        BBC     #0, R9, 34$             ; TT2
        MOVL    TTCHAR+8, R0
34$:    BBC     #3, R9, 35$             ; TT3
        MOVL    TTCHAR+12, R0
35$:    EXTZV   R8, #1, R0, R0
        BBC     #1, R9, 40$             ; NOT
        XORL2   #1, R0
40$:    BBS     #2, R9, 50$             ; ALT
        BLBS    R0, 45$
        ADDTEXT "No "
45$:    BSBW    ADDCIC
        BRB     60$
50$:    BLBS    R0, 55$
        BSBW    SKIPCIC                 ; off: the second name
        BSBW    ADDCIC
        BRB     60$
55$:    BSBW    ADDCIC
        BSBW    SKIPCIC
60$:    AOBLSS  #4, R7, 30$
        BSBW    SAY
        CLRL    R7
        BRB     30$
70$:    TSTL    R7
        BEQL    80$
        BSBW    SAY
80$:    PRINT   "   VMS Style Input    <CTRL-H> Backspace"
        MOVL    #SS$_NORMAL, R0
        RET

; SHOW USERS [username]
SHOWUSERS:
        GETVALUE "USERNAME", USRDSC, USRDSC
        BLBS    R0, 2$
        CLRW    USRDSC
2$:     $GETSYIW_S ITMLST=SYSITEMS
        BLBC    R0, 5$
        MULL3   #REC, MAXPRC, R0        ; a table with room for every process
        ADDL2   PAGSIZ, R0
        DECL    R0
        DIVL2   PAGSIZ, R0
        $EXPREG_S PAGCNT=R0, RETADR=RANGE
        BLBS    R0, 6$
5$:     RET
6$:     MOVL    RANGE, R8               ; the table
        CLRL    R9                      ; its processes
10$:    $GETJPIW_S PIDADR=CTX, ITMLST=JPIITEMS
        CMPL    R0, #SS$_NOMOREPROC
        BEQL    40$
        BLBC    R0, 5$
        CMPL    MODE, #JPI$K_INTERACTIVE
        BNEQ    10$
        MOVZWL  USRDSC, R0
        BEQL    15$
        CMPC3   R0, USRPAT, USER        ; a username that starts so
        BNEQ    10$
15$:    CLRL    R6                      ; where it goes, by username
16$:    CMPL    R6, R9
        BGEQ    20$
        MULL3   #REC, R6, R7
        ADDL2   R8, R7
        CMPC3   #12, USER, (R7)
        BLSSU   20$
        INCL    R6
        BRB     16$
20$:    MOVL    R9, R7                  ; those after it move down
22$:    CMPL    R7, R6
        BLEQ    25$
        MULL3   #REC, R7, R1
        ADDL2   R8, R1
        SUBL3   #REC, R1, R0
        MOVC3   #REC, (R0), (R1)
        DECL    R7
        BRB     22$
25$:    MULL3   #REC, R6, R7
        ADDL2   R8, R7
        MOVC3   #12, USER, R_USER(R7)
        MOVL    PID, R_PID(R7)
        MOVW    NAMLEN, R_NAMLEN(R7)
        MOVW    TERMLEN, R_TERMLEN(R7)
        MOVC3   #15, NAME, R_NAME(R7)
        MOVC3   #7, TERM, R_TERM(R7)
        INCL    R9
        BRW     10$
40$:    TSTL    R9
        BNEQ    45$
        MOVZWL  USRDSC, R0
        BEQL    45$
        ADDTEXT "%SHOW-I-NOSUCHUSER, no processes found for user "
        MOVAB   USRPAT, R1
        MOVZWL  USRDSC, R2
        BSBW    ADD
        BSBW    SAY
        BRW     90$
45$:    CLRL    R6                      ; the users: each name unlike the one before
        CLRL    R7
        MOVL    R8, R5
46$:    CMPL    R7, R9
        BGEQ    48$
        TSTL    R7
        BEQL    47$
        CMPC3   #12, -REC(R5), (R5)
        BEQL    44$
47$:    INCL    R6
44$:    INCL    R7
        ADDL2   #REC, R5
        BRB     46$
48$:    ADDTEXT "      vaxpunk User Processes at "
        BSBW    ADDSHORT
        BSBW    SAY
        ADDTEXT "    Total number of users = "
        MOVL    R6, R1
        BSBW    ADDDEC
        ADDTEXT ",  number of processes = "
        MOVL    R9, R1
        BSBW    ADDDEC
        BSBW    SAY
        PRINT   ""
        PRESENT "FULL"
        BLBS    R0, 60$
        PRINT   " Username     Interactive  Subprocess   Batch"
        CLRL    R7                      ; a line per user
        MOVL    R8, R6
50$:    CMPL    R7, R9
        BGEQ    90$
        CLRL    R4                      ; its processes
52$:    INCL    R4
        INCL    R7
        ADDL2   #REC, R6
        CMPL    R7, R9
        BGEQ    54$
        CMPC3   #12, -REC(R6), (R6)
        BEQL    52$
54$:    ADDTEXT " "
        SUBL3   #REC, R6, R1
        MOVL    #12, R2
        BSBW    ADD
        MOVL    R4, R1
        MOVL    #23, R3
        BSBW    RIGHT
        BSBW    SAY
        BRB     50$
60$:    PRINT   " Username    Process Name    PID       Terminal"
        CLRL    R7                      ; a line per process
        MOVL    R8, R6
62$:    CMPL    R7, R9
        BGEQ    90$
        ADDTEXT " "
        MOVAB   R_USER(R6), R1
        MOVL    #12, R2
        BSBW    ADD
        MOVAB   R_NAME(R6), R1
        MOVZWL  R_NAMLEN(R6), R2
        BSBW    ADD
        MOVL    #29, R3
        BSBW    PADTO
        MOVL    R_PID(R6), R1
        BSBW    ADDHEX
        MOVL    #39, R3
        BSBW    PADTO
        MOVAB   R_TERM(R6), R1
        MOVZWL  R_TERMLEN(R6), R2
        BSBW    ADD
        BSBW    SAY
        INCL    R7
        ADDL2   #REC, R6
        BRB     62$
90$:    MOVL    #SS$_NORMAL, R0
        RET

; SHOW MEMORY
SHOWMEM:
        $GETSYIW_S ITMLST=SYSITEMS
        BLBS    R0, 2$
        RET
2$:     CLRL    R6                      ; what to show: 1 the pages, 2 the
        PRESENT "PHYSICAL_PAGES"        ; slots, 4 pool
        BLBC    R0, 4$
        BISL2   #1, R6
4$:     PRESENT "SLOTS"
        BLBC    R0, 6$
        BISL2   #2, R6
6$:     PRESENT "POOL"
        BLBC    R0, 8$
        BISL2   #4, R6
8$:     PRESENT "ALL"
        BLBS    R0, 9$
        TSTL    R6
        BNEQ    10$
9$:     MOVL    #7, R6
10$:    ADDTEXT "              System Memory Resources on "
        BSBW    ADDDATE
        BSBW    SAY
        BBC     #0, R6, 20$
        PRINT   ""
        PRINT   "Physical Memory Usage (pages):   Total      Free     In Use  Modified"
        ADDTEXT " Main Memory ("
        MULL3   #100, PAGSIZ, R0        ; in hundredths of a Mb
        EMUL    MEMSIZE, R0, #0, R2
        EDIV    #1024*1024, R2, R1, R0
        CMPL    R1, #1024*100
        BGEQU   12$
        BSBW    ADDFIX
        ADDTEXT "Mb)"
        BRB     14$
12$:    DIVL2   #1024, R1               ; or a Gb
        BSBW    ADDFIX
        ADDTEXT "Gb)"
14$:    MOVL    MEMSIZE, R1
        MOVL    #38, R3
        BSBW    RIGHT
        MOVL    FREEPG, R1
        MOVL    #48, R3
        BSBW    RIGHT
        SUBL3   FREEPG, MEMSIZE, R1
        MOVL    #59, R3
        BSBW    RIGHT
        CLRL    R1
        MOVL    #69, R3
        BSBW    RIGHT
        BSBW    SAY
20$:    BBC     #1, R6, 30$
        PRINT   ""
        PRINT   "Slot Usage (slots):               Total    Free   Resident    Swapped"
        ADDTEXT " Process Entry Slots"
        MOVL    MAXPRC, R1
        MOVL    #39, R3
        BSBW    RIGHT
        SUBL3   PRCCNT, MAXPRC, R1
        MOVL    #47, R3
        BSBW    RIGHT
        MOVL    PRCCNT, R1
        MOVL    #58, R3
        BSBW    RIGHT
        CLRL    R1
        MOVL    #69, R3
        BSBW    RIGHT
        BSBW    SAY
30$:    BBC     #2, R6, 90$
        PRINT   ""
        PRINT   "Dynamic Memory Usage:             Total    Free     In Use    Largest"
        ADDTEXT " Nonpaged Dynamic Memory (Mb)"
        MOVL    NPGTOT, R1
        MOVL    #39, R3
        BSBW    RIGHTMB
        MOVL    NPGFREE, R1
        MOVL    #47, R3
        BSBW    RIGHTMB
        MOVL    NPGUSE, R1
        MOVL    #58, R3
        BSBW    RIGHTMB
        MOVL    NPGBIG, R1
        MOVL    #69, R3
        BSBW    RIGHTMB
        BSBW    SAY
90$:    MOVL    #SS$_NORMAL, R0
        RET

; SHOW ERROR
SHOWERR:
        PRESENT "FULL"
        BICL3   #^C1, R0, R6
        CLRL    R7                      ; 1 once the heading is out
        CLRQ    SCANCTX
        TSTL    R6
        BEQL    10$
        BSBW    ERRHEAD
        ADDTEXT "CPU"
        CLRL    R1
        MOVL    #41, R3
        BSBW    RIGHT
        BSBW    SAY
        ADDTEXT "MEMORY"
        CLRL    R1
        MOVL    #41, R3
        BSBW    RIGHT
        BSBW    SAY
10$:    $DEVICE_SCAN_S RETURN_DEVNAM=DEVDSC, RETLEN=DEVRET, CONTXT=SCANCTX
        BLBC    R0, 50$
        $GETDVIW_S DEVNAM=DEVRET, ITMLST=ERRITEMS
        BLBC    R0, 10$
        TSTL    R6
        BNEQ    20$
        TSTL    ERRCNT
        BEQL    10$
20$:    BSBW    ERRHEAD
        MOVAB   DEVNAM+1, R1            ; without its underscore
        MOVZWL  DEVRET, R2
        DECL    R2
        BSBW    ADD
        MOVL    ERRCNT, R1
        MOVL    #41, R3
        BSBW    RIGHT
        BSBW    SAY
        BRB     10$
50$:    TSTL    R7
        BNEQ    60$
        PRINT   "%SHOW-S-NOERRORS, no device errors found"
60$:    MOVL    #SS$_NORMAL, R0
        RET

; SHOW QUOTA
SHOWQUOTA:
        GETVALUE "DISK", QDSC, QDSC
        MOVAQ   QDSC, R6
        BLBS    R0, 10$
        MOVAQ   SYSDISK, R6
10$:    $GETDVIW_S DEVNAM=(R6), ITMLST=CLSITEMS
        BLBC    R0, 20$
        MOVL    #SS$_QFNOTACT, R0       ; there is the disk, with no quotas
20$:    RET

; SHOW CPU
SHOWCPU:
        $GETSYIW_S ITMLST=SYSITEMS
        BLBS    R0, 5$
        RET
5$:     ADDTEXT "System: "
        MOVAB   HWNAME, R1
        MOVZWL  HWNAMLEN, R2
        BSBW    ADD
        BSBW    SAY
        PRESENT "BRIEF"
        BLBS    R0, 50$
        PRESENT "FULL"
        BLBS    R0, 40$
        PRINT   "CPU ownership sets:"
        ADDTEXT "   Active               "
        MOVL    ACTCPU, R1
        BSBW    CPUSET
        ADDTEXT "   Configure            "
        MOVL    ACTCPU, R1
        BSBW    CPUSET
        PRINT   "CPU state sets:"
        ADDTEXT "   Potential            "
        MOVL    AVLCPU, R1
        BSBW    CPUSET
        ADDTEXT "   Autostart            "
        MOVL    AVLCPU, R1
        BSBW    CPUSET
        PRINT   "   Powered Down         None"
        PRINT   "   Not Present          None"
        PRINT   "   Hard Excluded        None"
        PRINT   "   Failover             None"
        BRB     90$
40$:    ADDTEXT "  Primary CPU   = "
        MOVL    PRICPU, R1
        BSBW    ADDDEC
        BSBW    SAY
        ADDTEXT "  Page Size     = "
        MOVL    PAGSIZ, R1
        BSBW    ADDDEC
        BSBW    SAY
50$:    $GETJPIW_S ITMLST=JPIITEMS      ; the process it runs: this one
        BLBC    R0, 95$
        ADDTEXT "CPU "
        MOVL    PRICPU, R1
        BSBW    ADDDEC
        MOVL    #9, R3
        BSBW    PADTO
        ADDTEXT "State: RUN"
        BSBW    SAY
        ADDTEXT "       Process: "
        BSBW    ADDNAME
        MOVL    #40, R3
        BSBW    PADTO
        ADDTEXT "PID: "
        MOVL    PID, R1
        BSBW    ADDHEX
        BSBW    SAY
90$:    MOVL    #SS$_NORMAL, R0
95$:    RET

; ERRHEAD: writes SHOW ERROR's heading, unless R7 says it is out, and sets
; R7. Uses R0-R1.
ERRHEAD:
        .JSB_ENTRY  OUTPUT=<R7>
        BLBS    R7, 10$
        PRINT   "Device                          Error Count"
        MOVL    #1, R7
10$:    RSB

; CPUSET: R1 = how many CPUs. Writes the line, with their IDs, from 0,
; after commas. Uses R0-R5.
CPUSET:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R1                      ; how many,
        CLRL    -(SP)                   ; the next
10$:    MOVL    (SP), R1
        BSBW    ADDDEC
        INCL    (SP)
        CMPL    (SP), 4(SP)
        BGEQ    20$
        ADDTEXT ","
        BRB     10$
20$:    ADDL2   #8, SP
        BRW     SAY

; RIGHTMB: appends R1 bytes in Mb, with 2 decimals, to LINE, ending at
; column R3. Uses R0-R5.
RIGHTMB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        EMUL    R1, #100, #0, R4
        EDIV    #1024*1024, R4, R1, R0
        SUBL2   #3, R3
        PUSHL   R1
        DIVL2   #100, R1
        BSBW    RIGHT
        MOVL    (SP)+, R1
        BRB     ADDFRAC

; ADDFIX: appends R1, hundredths, to LINE, with 2 decimals. Uses R0-R5.
ADDFIX:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R1
        DIVL2   #100, R1
        BSBW    ADDDEC
        MOVL    (SP)+, R1
        BRB     ADDFRAC                 ; a tail call, not a fall-through
; ADDFRAC: appends a point and R1's last 2 decimal digits to LINE. Uses
; R0-R5.
ADDFRAC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        DIVL3   #100, R1, R0
        MULL2   #100, R0
        SUBL2   R0, R1
        PUSHL   R1
        ADDTEXT "."
        MOVL    (SP)+, R1
        BRW     ADD2

; RIGHT: appends R1 in decimal to LINE, ending at column R3. Uses R0-R3,
; R5.
RIGHT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        MOVL    R1, R2                  ; its digits
10$:    DIVL2   #10, R2
        BEQL    20$
        DECL    R3
        BRB     10$
20$:    DECL    R3
        PUSHL   R1
        BSBW    PADTO
        MOVL    (SP)+, R1
        BRW     ADDDEC

; ADDSHORT: appends the date and time, as SHOW USERS writes them, to LINE:
; 15-OCT-2026 02:23 PM. Uses R0-R5.
ADDSHORT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        $ASCTIM_S TIMLEN=DATELEN, TIMBUF=DATEDSC
        MOVAB   DATE, R1                ; the date and a blank,
        MOVL    #12, R2
        CMPB    (R1), #^A/ /
        BNEQ    10$
        INCL    R1
        DECL    R2
10$:    BSBW    ADD
        MOVZBL  DATE+12, R1             ; the hour, of 12,
        SUBL2   #^A/0/, R1
        MULL2   #10, R1
        MOVZBL  DATE+13, R0
        SUBL2   #^A/0/, R0
        ADDL2   R0, R1
        PUSHL   #^A/A/
        CMPL    R1, #12
        BLSS    20$
        MOVL    #^A/P/, (SP)
        SUBL2   #12, R1
20$:    TSTL    R1
        BNEQ    30$
        MOVL    #12, R1
30$:    BSBW    ADD2
        MOVAB   DATE+14, R1             ; the minutes,
        MOVL    #3, R2
        BSBW    ADD
        ADDTEXT " "                     ; and AM or PM
        MOVL    (SP)+, R0
        BSBW    ADDCHAR
        ADDTEXT "M"
        RSB

; ADDCIC: appends the .ASCIC string at R6 to LINE, and moves R6 past it.
; SKIPCIC moves R6 past it only. Uses R0-R2.
ADDCIC:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2>
        MOVZBL  (R6), R2
        ADDL3   #1, R6, R1
        BSBW    ADD
        BRB     SKIPCIC                 ; a tail call
SKIPCIC:
        .JSB_ENTRY  OUTPUT=<R6>
        MOVZBL  (R6), R0
        ADDL2   R0, R6
        INCL    R6
        RSB

; ADD3: appends R1, below 1000, in decimal to LINE, right aligned in 3
; characters. Uses R0-R3, R5.
ADD3:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        PUSHL   R1
        CMPL    R1, #100
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
        CMPL    (SP), #10
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
10$:    MOVL    (SP)+, R1
        BRW     ADDDEC

; PRIVS: R6 = a quadword of privileges. Writes their names, six to a
; line. Uses R0-R3, R7-R9.
PRIVS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R7, R8, R9>
        MOVAB   G^PRV_NAMES, R7
        CLRL    R8                      ; the bit
        CLRL    R9                      ; names on the line
10$:    TSTB    (R7)
        BEQL    40$
        BBC     R8, (R6), 30$
        MULL3   #13, R9, R3
        INCL    R3
        BSBW    PADTO
        MOVZBL  (R7), R2
        ADDL3   #1, R7, R1
        BSBW    ADD
        INCL    R9
        CMPL    R9, #6
        BLSS    30$
        BSBW    SAY
        CLRL    R9
30$:    MOVZBL  (R7), R0
        ADDL2   R0, R7
        INCL    R7
        INCL    R8
        BRB     10$
40$:    TSTL    R9
        BEQL    50$
        BSBW    SAY
50$:    RSB

; ADDOCT: appends R1 in octal to LINE. Uses R0-R3.
ADDOCT:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        CLRL    R3                      ; digits, on the stack
10$:    EXTZV   #0, #3, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R3
        ASHL    #-3, R1, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBW    ADDCHAR
        SOBGTR  R3, 30$
        RSB

; ADDNAME: appends the process's name, NAME, to LINE. Uses R0-R2.
ADDNAME:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVAB   NAME, R1
        MOVZWL  NAMLEN, R2
        BRB     ADD

; PADTO: appends blanks to LINE until it is R3 characters long. Uses R0-R2.
PADTO:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
        CMPL    R0, R3
        BGEQU   10$
        MOVZBL  #^A/ /, R0
        BSBB    ADDCHAR
        BRB     PADTO
10$:    RSB

; ADDHEX: appends R1 in 8 hex digits to LINE. Uses R0-R5.
ADDHEX:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R1, R4
        MOVL    #8, R5
10$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVZBL  HEX[R0], R0
        BSBB    ADDCHAR
        SOBGTR  R5, 10$
        RSB

; ADD2: appends R1, below 100, in 2 decimal digits to LINE. Uses R0-R5.
ADD2:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CMPL    R1, #10
        BGEQU   ADDDEC
        PUSHL   R1
        MOVZBL  #^A/0/, R0
        BSBB    ADDCHAR
        MOVL    (SP)+, R1
        BRB     ADDDEC                  ; a tail call, not a fall-through
; ADDDEC: appends R1 in decimal to LINE. Uses R0-R3, R5.
ADDDEC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        CLRL    R3                      ; digits, on the stack
10$:    DIVL3   #10, R1, R5
        MULL3   #10, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R3
        MOVL    R5, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBB    ADDCHAR
        SOBGTR  R3, 30$
        RSB

; SPEED: R1 = a speed, TT$C_BAUD_. Appends it in baud to LINE, ending at
; column 17, as SHOW TERMINAL's Input and Output. Uses R0-R3, R5.
SPEED:
        .JSB_ENTRY  SCRATCH=<R2, R3, R5>
        MOVAL   G^TERM_SPEEDS, R0
        MOVL    (R0)[R1], R1
        MOVL    #17, R3
        BRW     RIGHT                   ; a tail call

; SAY: writes the line in LINE, and empties it. Uses R0 and R1.
SAY:
        .JSB_ENTRY
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        RSB

; ADDDATE: appends the date and time to LINE. Uses R0-R2.
ADDDATE:
        .JSB_ENTRY  SCRATCH=<R2>
        $ASCTIM_S TIMLEN=DATELEN, TIMBUF=DATEDSC
        MOVAB   DATE, R1
        MOVZWL  DATELEN, R2
        BSBW    ADD
        RSB

; ADDCHAR: appends the character in R0 to LINE. Uses R0-R2.
ADDCHAR:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
; ADD: appends the R2 bytes at R1 to LINE, as many as fit. Uses R0-R2.
ADD:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVZBL  LINE, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, LINE[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, LINE
        RSB

; SHOWRIGHTS: SHOW PROCESS/RIGHTS's list: each identifier the process
; holds, by its name, and its attributes. Uses R0-R6.
SHOWRIGHTS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        $GETJPIW_S ITMLST=RIGHTSITEMS
        BLBC    R0, 90$
        PRINT   " "
        PRINT   "Process rights:"
        MOVAQ   RIGHTS, R6
        MOVZWL  RIGHTSLEN, R5
        ADDL2   R6, R5
10$:    CMPL    R6, R5
        BGEQU   80$
        ADDTEXT " "
        MOVW    #32, IDNAME
        $IDTOASC_S ID=(R6), NAMLEN=IDLEN, NAMBUF=IDNAME
        BLBS    R0, 20$
        PUSHAB  IDBUF                   ; one with no name: [g,m] or %X
        PUSHL   (R6)
        CALLS   #2, G^ID_TEXT
        MOVW    R0, IDLEN
20$:    MOVAB   IDBUF, R1
        MOVZWL  IDLEN, R2
        BSBW    ADD
        MOVL    #35, R3
        BSBW    PADTO
        BBC     #0, 4(R6), 30$          ; KGB$M_RESOURCE
        ADDTEXT "resource"
30$:    BBC     #1, 4(R6), 40$          ; KGB$M_DYNAMIC
        BBC     #0, 4(R6), 35$
        ADDTEXT " "
35$:    ADDTEXT "dynamic"
40$:    BSBW    SAY
        ADDL2   #8, R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; SHOW SECURITY: each file the specification names: its name, owner,
; protection and ACL, as VMS's shows them. %SHOW-F-READERR for one it
; can't find.
        .ENTRY  SECURITY, ^M<R2, R3, R4, R5, R6>
        GETVALUE "CLASS", SECCLS, SECCLS
        BLBC    R0, 5$
        MOVL    #SS$_NOCLASS, R0
        CMPW    SECCLS, #4
        BNEQ    2$
        CMPL    SECCLSBUF, #^A/FILE/
        BEQL    5$
2$:     RET
5$:     GETVALUE "OBJECT", SPECDSC, SPECDSC
        BLBC    R0, 90$
        MOVB    SPECDSC, FAB+FAB$B_FNS
        $PARSE  FAB=FAB
        BLBC    R0, 60$
        CLRL    R6                      ; files shown
10$:    $SEARCH FAB=FAB
        BLBC    R0, 50$
        INCL    R6
        BSBW    SECFILE
        BLBS    R0, 10$
        BRB     65$
50$:    CMPL    R0, #RMS$_NMF
        BNEQ    60$
        TSTL    R6
        BNEQ    80$
        MOVL    #RMS$_FNF, R0
60$:    PUSHL   R0                      ; %SHOW-F-READERR
        ADDTEXT "%SHOW-F-READERR, error reading "
        MOVAB   EXP, R1
        MOVZBL  NAM+NAM$B_ESL, R2
        BSBW    ADD
        BSBW    SAY
        MOVL    (SP)+, R0
65$:    PUSHL   R0
        $GETMSG_S MSGID=R0, MSGLEN=MSGLEN, BUFADR=MSGDSC
        MOVB    MSGLEN, LINE
        MOVB    #^A/-/, LINE+1
        BSBW    SAY
        BISL3   #^X10000000, (SP)+, R0  ; STS$M_INHIB_MSG: said
        RET
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; SECFILE: RES = a file's resultant string, NAM's. Shows its owner,
; protection and ACL. R0 = SS$_NORMAL or $GET_SECURITY's failure. Uses
; R0-R5.
SECFILE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM+NAM$B_RSL, OBJDSC
        $GET_SECURITY_S CLSNAM=FILECLS, OBJNAM=OBJDSC, ITMLST=SECITEMS
        BLBS    R0, 5$
        RSB
5$:     PRINT   ""
        MOVAB   RES, R1
        MOVZBL  NAM+NAM$B_RSL, R2
        BSBW    ADD
        ADDTEXT " object of class FILE"
        BSBW    SAY
        ADDTEXT "     Owner: "
        PUSHAB  IDBUF
        PUSHL   OWNER
        CALLS   #2, G^ID_TEXT
        MOVL    R0, R2
        MOVAB   IDBUF, R1
        BSBW    ADD
        BSBW    SAY
        ADDTEXT "     Protection: ("
        CLRL    R4                      ; the category
        MOVAB   CATNAMES, R5
10$:    MOVZBL  (R5)+, R2               ; Category: letters, or Category
        MOVL    R5, R1
        ADDL2   R2, R5
        BSBW    ADD
        MULL3   #4, R4, R0
        EXTZV   R0, #4, PROT, R3        ; what it may not do
        CMPL    R3, #^XF
        BEQL    20$
        ADDTEXT ": "
        CLRL    R2
15$:    BBS     R2, R3, 17$
        MOVZBL  LETTERS[R2], R0
        PUSHL   R2
        BSBW    ADDCHAR
        MOVL    (SP)+, R2
17$:    AOBLSS  #4, R2, 15$
20$:    CMPL    R4, #3
        BEQL    25$
        ADDTEXT ", "
25$:    AOBLSS  #4, R4, 10$
        ADDTEXT ")"
        BSBW    SAY
        TSTL    ACLLEN
        BNEQ    30$
        PRINT   "     Access Control List: <empty>"
        BRB     80$
30$:    PRINT   "     Access Control List:"
        CLRL    SECCTX
40$:    $GET_SECURITY_S CLSNAM=FILECLS, OBJNAM=OBJDSC, ITMLST=ACEITEMS, CONTXT=SECCTX
        BLBC    R0, 80$
        MOVW    #1024, FMTDSC
        $FORMAT_ACL_S ACLENT=ACEDSC, ACLLEN=FMTLEN, ACLSTR=FMTDSC, WIDTH=FMTWIDTH, TRMDSC=NEWLINE, INDENT=FMTINDENT
        MOVAB   FMTBUF, R1              ; a line each
        MOVZWL  FMTLEN, R3
        ADDL2   R1, R3
50$:    MOVL    R1, R2
55$:    CMPL    R2, R3
        BGEQU   60$
        CMPB    (R2), #10
        BEQL    60$
        INCL    R2
        BRB     55$
60$:    PUSHL   R2
        PUSHL   R3
        SUBL2   R1, R2
        BSBW    ADD
        BSBW    SAY
        MOVL    (SP)+, R3
        MOVL    (SP)+, R1
        INCL    R1
        CMPL    R1, R3
        BLEQU   50$
        BRB     40$
80$:    MOVL    #SS$_NORMAL, R0
        RSB

        .END    START
