        .TITLE  HELP    Describes DCL's commands, from its command tables
        .IDENT  /V0.2/
;
; DCL's HELP [topic] runs this, which build.rs links with DCL$TABLES,
; DCL's command tables, and help/describe.mar, which describes them. With
; no topic it lists the verbs, then what DCL does with no verb: symbols,
; labels, procedures.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"

        .EXTERNAL HELP$TOPIC, DCL$TABLES

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<>
        PUSHAB  G^DCL$TABLES
        CALLS   #1, G^HELP$TOPIC
        BLBC    R1, 90$
        PRINT   ""
        PRINT   "  @file [p1 ... p8]     runs the command procedure file, file.COM"
        PRINT   "  name = expression     sets a local symbol, == a global one"
        PRINT   "  name := string        the same with a string, :== a global one"
        PRINT   "  'name'                stands for the symbol's value in a command"
        PRINT   "  label:                a label in a procedure, for GOTO"
        PRINT   ""
        PRINT   "  HELP verb describes a verb, its parameters and qualifiers."
        MOVL    #1, R0
90$:    RET

        .END    START
