        .TITLE  SET     Sets the process's privileges, files, directories, volumes and the terminal
        .IDENT  /V0.5/
;
; DCL runs this, as VMS's DCL runs SET.EXE, for
; - SET PROCESS/PRIVILEGES=(priv[,...]). Each priv enables that
;   privilege, NOpriv disables it, and ALL and NOALL every one, with
;   $SETPRV, permanently, so they stay when the image exits. One the
;   process isn't authorized for stays off, with %SYSTEM-S-NOTALLPRIV; a
;   name it doesn't know is %DCL-W-IVKEYW, and ends the list there.
; - SET PROTECTION=(code[,...]) file, which gives the file's categories
;   the codes' access (lib/protect.mar), and SET FILE file with
;   /OWNER_UIC=uic, /ATTRIBUTE=(kw:value[,...]), its record attributes,
;   /[NO]EXPIRATION_DATE[=time] and /VERSION_LIMIT[=n], its name's in
;   its directory, 0 or none for none. It finds the file with $PARSE and
;   $SEARCH, reads its attributes with a $QIO to its disk, IO$_ACCESS,
;   changes them, and writes them back with IO$_MODIFY, as VMS's SET
;   does through the XQP: no read access to the file is needed.
; - SET DIRECTORY/VERSION_LIMIT[=n] directory, the default version limit
;   of the names made in it later, the same way.
; - SET VOLUME device with /LABEL=label, /OWNER_UIC=uic, /PROTECTION and
;   /FILE_PROTECTION=(code[,...]), which FIL$SETVOLUME writes in the
;   volume's home blocks, in kernel mode, which takes CMKRNL.
; - SET SECURITY object[,...], with wildcards: each file's owner,
;   /OWNER=uic or identifier, protection, /PROTECTION=(code[,...]), and
;   ACL, through $SET_SECURITY (docs/adr/0040-acls-in-file-headers-and-
;   rights-identifiers.md): /ACL=(ace[,...]) adds the ACEs at its top,
;   with /AFTER=ace after that one, with /DELETE deletes them, or all but
;   the protected ones without ACEs, all with /DELETE=ALL, with
;   /REPLACE=(ace[,...]) puts those in their place; /LIKE=NAME=file gives
;   it that one's owner, protection and ACL, /DEFAULT the default
;   protection and an ACL of the protected ACEs alone; /LOG says so. The
;   ACEs' text is $PARSE_ACL's; a hidden one may not be given.
; - SET TERMINAL [device], which reads the terminal's characteristics
;   (lib/term.mar), changes those its qualifiers name, and sets them with
;   IO$_SETMODE, or with /PERMANENT the permanent ones, which it reads,
;   and the current ones with IO$_SETCHAR, as VMS's does. /INQUIRE asks
;   the terminal its type (INQUIRE), or /DEVICE_TYPE=type names it, one
;   of TERM_TYPES, which gives its characteristics; then /WIDTH=n from 1
;   to 511, /PAGE=n up to 255, /[NO]BROADCAST, COLOR, ECHO, EIGHTBIT,
;   ESCAPE, LINE_EDITING, LOWERCASE, PASTHRU, TAB and WRAP, /INSERT or
;   /OVERSTRIKE, the line editing's mode, and /SPEED=rate or
;   /SPEED=(input,output), each one of TERM_SPEEDS.
; ponytail: SET SECURITY's class FILE alone, its /DEFAULT gives no
; directory's default ACEs or protection, and an owner the file keeps;
; one file, the first a wildcard finds, for the others, one directory, one
; volume; no /LOG or /CONFIRM; /ATTRIBUTE has no dates or HBK; a time is
; absolute, TODAY+1- and the like aren't; SET VOLUME has no
; /[NO]ERASE_ON_DELETE, /[NO]HIGHWATER_MARKING or the qualifiers VMS's
; mount and cache take. SET TERMINAL/INQUIRE doesn't put a VT200 or
; later in 7-bit mode, as VMS's does, nor the keypad in numeric mode,
; and /WIDTH no DEC CRT in 132 columns; /DEVICE_TYPE knows TERM_TYPES's
; types only.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $CLIMSGDEF
        $FABDEF
        $NAMDEF
        $FIBDEF
        $ATRDEF
        $FATDEF
        $IODEF
        $TTDEF
        $TT2DEF
        $TT3DEF
        $DVIDEF
        $ACEDEF
        $OSSDEF

        .EXTERNAL PRV_LOOKUP, LIB$SIGNAL, PUT_LINE, GET_PROT, GET_UIC
        .EXTERNAL TERM_SENSE, TERM_FIND, TERM_TYPE, TERM_SPEEDS
        .EXTERNAL FIL$SETVOLUME

; TTBIT "name", bit, base, ON=BBSS, OFF=BBCC: sets the bit at base for
; the qualifier /name, and clears it for /NOname; ON=BBCC, OFF=BBSS the
; other way round, for a bit that says NO. Uses R0-R1.
        .MACRO  TTBIT   NAME, BIT, BASE, ON=BBSS, OFF=BBCC, ?L1, ?L2
        PRESENT NAME
        BLBS    R0, L1
        CMPL    R0, #CLI$_NEGATED
        BNEQ    L2
        OFF     #BIT, BASE, L2
        BRB     L2
L1:     ON      #BIT, BASE, L2
L2:
        .ENDM   TTBIT

; TTNUM "name", min, max: R1 = the qualifier /name's value, a decimal
; number from min to max, or a RET with SS$_BADPARAM if it isn't one, or
; with GETVALUE's failure. Uses R0-R5.
        .MACRO  TTNUM   NAME, MIN, MAX, ?L1, ?L2
        MOVW    #16, NUMDSC
        GETVALUE NAME, NUMDSC, NUMDSC
        BLBS    R0, L1
        RET
L1:     MOVL    #MIN, R2
        MOVL    #MAX, R3
        BSBW    DECIMAL
        BLBS    R0, L2
        RET
L2:
        .ENDM   TTNUM

INHIB = ^X10000000                      ; STS$M_INHIB_MSG

; INVALID "name", desc, c: writes %SET-E-INVQUAVAL for desc's value of
; the qualifier /name, with c, PERCENT, or DASH after another message, as
; its first character. Uses R0-R5.
        .MACRO  INVALID NAME, DESC, C, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  NAME
        .RESTORE_PSECT
        MOVAB   L, R0
        MOVAQ   DESC, R1
        MOVZBL  #C, R2
        BSBW    INVQUAVAL
        .ENDM   INVALID
ASKREAD = IO$_READPROMPT!IO$M_TIMED!IO$M_PURGE!IO$M_NOFILTR!IO$M_NOECHO
SEMI = 59                               ; ;
PERCENT = 37                            ; %
DASH = 45                               ; -
WARNING = INHIB                         ; what a warning or an error SET TERMINAL
ERROR = INHIB!2                         ; has already written returns

        .PSECT  DATA, NOEXE, WRT, LONG
DESC:   .LONG   31                      ; a value of PRIVILEGES
        .ADDRESS NAME
LEN:    .WORD   0
NAME:   .BLKB   31
MASK:   .BLKQ   1                       ; $SETPRV's
STATUS: .LONG   SS$_NORMAL              ; or SS$_NOTALLPRIV once one stays off
LINE:   .BLKB   256                     ; " \name\", or a message, .ASCIC
FAB:    $FAB    FNA=SPEC, NAM=NAM
NAM:    $NAM    ESA=EXP, ESS=255, RSA=RES, RSS=255
EXP:    .BLKB   255                     ; $PARSE's expanded specification
RES:    .BLKB   255                     ; the file's specification, which $SEARCH found
        .ALIGN  LONG
DEVDSC: .LONG   0                       ; its device
        .ADDRESS 0
FCHAN:  .LONG   0                       ; a channel to it
FIBDSC: .LONG   FIB$C_LENGTH
        .ADDRESS FIB
FIB:    .BLKB   FIB$C_LENGTH            ; the file, by its ID
GETATR: .WORD   ATR$S_FPRO, ATR$C_FPRO  ; what IO$_ACCESS reads: its protection,
        .ADDRESS PRO
        .WORD   ATR$S_UIC, ATR$C_UIC    ; owner,
        .ADDRESS UIC
        .WORD   ATR$S_RECATTR, ATR$C_RECATTR    ; record attributes
        .ADDRESS FAT
        .WORD   ATR$S_EXPDATE, ATR$C_EXPDATE    ; and expiration date
        .ADDRESS EXPDAT
        .LONG   0
PUTATR: .BLKB   4*8+4                   ; what IO$_MODIFY writes: those the command changes
DIRATR: .WORD   ATR$S_RECATTR, ATR$C_RECATTR    ; a directory's record attributes
        .ADDRESS FAT
        .LONG   0
PRO:    .WORD   0
        .ALIGN  QUAD
EXPDAT: .BLKQ   1
ONEDAY: .LONG   ^X2A69C000, ^XC9        ; a day, in 100 ns units
UIC:    .LONG   0
FAT:    .BLKB   ATR$S_RECATTR
RATSET: .LONG   0                       ; 1 once a RAT has replaced the record attributes
ATTDSC: .LONG   64                      ; a value of ATTRIBUTE or EXPIRATION_DATE
        .ADDRESS ATTBUF
ATTBUF: .BLKB   64
TIMDSC: .LONG   0                       ; EXPIRATION_DATE's, as $BINTIM takes it
        .ADDRESS TIMBUF
TIMBUF: .BLKB   68
MIDNIGHT:                               ; today's
        .ASCID  "-- 00:00"
DAYWORDS:                               ; KWINDEX's: midnight of today, today, tomorrow, yesterday
        .ASCIC  "TODAY"
        .ASCIC  "0"
        .ASCIC  "TOMORROW"
        .ASCIC  "YESTERDAY"
        .BYTE   0
; /ATTRIBUTE's keywords: each, the size of its number, or 5, 6 or 7 for
; ORG, RFM or RAT, and where it goes in FAT.
ATTKW:  .ASCII  "BKS"
        .BYTE   1, FAT$B_BKTSIZE
        .ASCII  "DEQ"
        .BYTE   2, FAT$W_DEFEXT
        .ASCII  "EBK"
        .BYTE   4, FAT$L_EFBLK
        .ASCII  "FFB"
        .BYTE   2, FAT$W_FFBYTE
        .ASCII  "FSZ"
        .BYTE   1, FAT$B_VFCSIZE
        .ASCII  "GBC"
        .BYTE   2, FAT$W_GBC
        .ASCII  "LRL"
        .BYTE   2, FAT$W_RSIZE
        .ASCII  "MRS"
        .BYTE   2, FAT$W_MAXREC
        .ASCII  "VRS"
        .BYTE   2, FAT$W_VERSIONS
        .ASCII  "ORG"
        .BYTE   5, 0
        .ASCII  "RFM"
        .BYTE   6, 0
        .ASCII  "RAT"
        .BYTE   7, 0
        .BYTE   0
ORGS:   .ASCIC  "SEQ"                   ; FAT$C_SEQUENTIAL, RELATIVE, INDEXED
        .ASCIC  "REL"
        .ASCIC  "IDX"
        .BYTE   0
RFMS:   .ASCIC  "UDF"                   ; FAT$C_UNDEFINED, FIXED, VARIABLE, ...
        .ASCIC  "FIX"
        .ASCIC  "VAR"
        .ASCIC  "VFC"
        .ASCIC  "STM"
        .ASCIC  "STMLF"
        .ASCIC  "STMCR"
        .BYTE   0
RATS:   .ASCIC  "NONE"                  ; then FAT$V_FORTRANCC's bit, IMPLIEDCC's, ...
        .ASCIC  "FTN"
        .ASCIC  "CR"
        .ASCIC  "PRN"
        .ASCIC  "BLK"
        .ASCIC  "MSB"
        .BYTE   0
PROT0:  .WORD   0                       ; VOLPROT's: GET_PROT of none
PROTF:  .WORD   0                       ; and of all
        .ALIGN  LONG
VARGS:  .LONG   6                       ; FIL$SETVOLUME's arguments
        .ADDRESS PHYSDSC                ; the device
VWHAT:  .LONG   0                       ; what to change: 1 the label, 2 owner, 4 protection, 8 file protection
        .ADDRESS LBLDSC
VOWNER: .LONG   0
VPROT:  .LONG   0                       ; VOLPROT's
VFPROT: .LONG   0
PHYSDSC:                                ; the device's name, _DDCU:
        .LONG   16
        .ADDRESS PHYS
PHYS:   .BLKB   16
VOLITEMS:
        .WORD   16, DVI$_DEVNAM
        .ADDRESS PHYS
        .ADDRESS PHYSDSC                ; its length, in the descriptor
        .LONG   0
LBLDSC: .LONG   64                      ; /LABEL's
        .ADDRESS LBLBUF
LBLBUF: .BLKB   64
VPROTECTION:
        .ASCID  "PROTECTION"
FILE_PROTECTION:
        .ASCID  "FILE_PROTECTION"
SPECDSC:                                ; FILE, the parameter
        .LONG   255
        .ADDRESS SPEC
SPEC:   .BLKB   255
        .ALIGN  LONG
PROTECTION:                             ; the entities GET_PROT and GET_UIC take
        .ASCID  "OPTION.PROTECTION"
OWNER_UIC:
        .ASCID  "OWNER_UIC"
NUMDSC: .LONG   16                      ; /WIDTH's or /PAGE's value
        .ADDRESS NUMBUF
NUMBUF: .BLKB   16
CHAN:   .LONG   0                       ; the terminal's
CHAR:   .BLKB   16                      ; its characteristics (lib/term.mar)
IOSB:   .BLKQ   1
FUNC:   .LONG   0                       ; IO$_SETMODE, or IO$_SETCHAR
SPEED:  .LONG   0                       ; IO$_SETMODE's p3, or 0
VALDSC: .LONG   16                      ; DEVICE_TYPE's value
        .ADDRESS VALBUF
VALBUF: .BLKB   16
MSGDSC: .LONG   255                     ; a message, $GETMSG's
        .ADDRESS LINE+1
MSGLEN: .WORD   0
DVIITEMS:                               ; what $GETDVIW returns of the terminal
        .WORD   16, DVI$_DEVNAM
        .ADDRESS DEVNAM
        .ADDRESS DEVLEN
        .LONG   0
DEVLEN: .WORD   0
DEVNAM: .BLKB   16
REPLY:  .BLKB   64                      ; the terminal's answer to INQUIRE
NUMS:   .BLKL   8                       ; its numbers
NNUMS = 8
TERM:   .WORD   16, 0                   ; the terminators: c and R alone, the
        .ADDRESS TERMASK                ; long form, so the answer's ESC
TERMASK:.LONG   0, 0, <1@<^A/R/-64>>, <1@<^A/c/-96>> ; doesn't end the read
DA:     .ASCII  <27>"[c"                ; what are you?
DALEN = .-DA
CPR:    .ASCII  <27>"7"<27>"[255;255H"<27>"[6n"<27>"8"  ; where is the cursor at 255;255?
CPRLEN = .-CPR
NOTSETTXT:
        .ASCII  "%SET-W-NOTSET, error modifying "
INVTXT: .ASCII  "%SET-E-INVQUAVAL, value '"     ; 25
        .ASCII  "' invalid for /"               ; 15
        .ASCII  " qualifier"                    ; 10
; SET SECURITY's
SECCLS: .LONG   16                      ; /CLASS, FILE by default
        .ADDRESS SECCLSBUF
SECCLSBUF:
        .BLKB   16
FILECLS:.ASCID  "FILE"
NACE = 64                               ; ACEs /ACL or /REPLACE take, at most
ACEBUF: .BLKB   NACE*256                ; /ACL's ACEs, 256 bytes each
NACES:  .LONG   0
REPBUF: .BLKB   NACE*256                ; /REPLACE's
NREPS:  .LONG   0
AFTERACE:                               ; /AFTER's
        .BLKB   256
SECWHAT:.LONG   0                       ; S_ bits: what it changes
NEWOWNER:                               ; /OWNER's
        .LONG   0
NEWPROT:.WORD   0, 0                    ; /PROTECTION's: the bits it sets, and those it keeps
CURPROT:.LONG   0                       ; a file's protection
LIKEOWNER:                              ; /LIKE's file's owner,
        .LONG   0
LIKEPROT:                               ; protection,
        .LONG   0
LIKELEN:.WORD   0                       ; and ACL
LIKEACL:.BLKB   512
LIKEITEMS:                              ; what $GET_SECURITY reads of it
        .WORD   4, OSS$_OWNER
        .ADDRESS LIKEOWNER, 0
        .WORD   4, OSS$_PROTECTION
        .ADDRESS LIKEPROT, 0
        .WORD   512, OSS$_ACL_READ
        .ADDRESS LIKEACL, LIKELEN
        .LONG   0
PROTITEMS:                              ; and of a file's protection
        .WORD   4, OSS$_PROTECTION
        .ADDRESS CURPROT, 0
        .LONG   0
SECITEMS:                               ; $SET_SECURITY's items, made for a file
        .BLKB   <<NACE*2>+8>*12+4
SECCTX: .LONG   0                       ; the ACL's position
ACETXT: .LONG   255                     ; an ACE's text, a value
        .ADDRESS ACETXTBUF
ACETXTBUF:
        .BLKB   255
ACEDSC: .LONG   256                     ; an ACE's slot
        .ADDRESS 0
ERRPOS: .WORD   0                       ; where $PARSE_ACL stopped
OBJDSC: .LONG   0                       ; the object's name, the file's resultant string
        .ADDRESS RES
FMTDSC: .LONG   255                     ; an ACE's text, $FORMAT_ACL's
        .ADDRESS FMTBUF
FMTLEN: .WORD   0
FMTBUF: .BLKB   255
FMTWIDTH:
        .WORD   80
FMTINDENT:
        .WORD   4
NEWLINE:.ASCID  <10>
DEFPROT = ^XFA00                        ; (S:RWED,O:RWED,G:RE,W): VMS's default
S_OWNER = 0                             ; SECWHAT's bits
S_PROT = 1
S_ACL = 2                               ; ACEs given
S_DELETE = 3
S_ALL = 4                               ; /DELETE=ALL
S_REPLACE = 5
S_AFTER = 6
S_LIKE = 7
S_DEFAULT = 8
S_LOG = 9
ACLNAME:.ASCID  "ACL"                   ; the qualifiers whose values are ACEs
REPNAME:.ASCID  "REPLACE"
AFTERNAME:
        .ASCID  "AFTER"
OWNERDSC:                               ; (IDENTIFIER=owner), or /LIKE's file
        .LONG   0
        .ADDRESS FMTBUF
IDPREFIX:
        .ASCII  "(IDENTIFIER="
OPENOUTTXT:
        .ASCIC  "%SET-E-OPENOUT, error opening "
ASOUTPUT:
        .ASCIC  " as output"
SYNTAXTXT:
        .ASCIC  "%SET-F-SYNTAX, error parsing '"
QUOTE:  .ASCIC  "'"
MODIFIEDTXT:
        .ASCIC  "%SET-I-MODIFIED, "
MODIFIED2TXT:
        .ASCIC  " modified"
WRITEERRTXT:
        .ASCIC  "%SET-F-WRITEERR, error writing "
READERRTXT:
        .ASCIC  "%SET-F-READERR, error reading "
NOSUCHTXT:
        .ASCIC  "%SET-W-NOSUCHACE, ACE for object "
NOSUCH2TXT:
        .ASCIC  ", does not exist"
SECFAILED:                              ; the worst status, for the image's exit
        .LONG   SS$_NORMAL
VT100:  .ASCID  "VT100"
VT102:  .ASCID  "VT102"
VT200:  .ASCID  "VT200"                 ; to VT500, 2 to 5 after

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6>
        PRESENT "OPTION.TERMINAL"
        BLBC    R0, 4$
        BRW     SETTERM
4$:     PRESENT "OPTION.SECURITY"
        BLBC    R0, 5$
        CALLS   #0, SETSEC
        RET
5$:     PRESENT "OPTION.PROCESS"
        BLBS    R0, 10$
        BRW     FILE
10$:    GETVALUE "PRIVILEGES", DESC, LEN
        BLBC    R0, 60$                 ; past the last
        MOVAB   NAME, R5
        MOVZWL  LEN, R6
        MOVL    #1, R4                  ; enable
        BSBW    LOOKUP
        BLBS    R0, 40$
        CMPL    R6, #2                  ; NOpriv: disable
        BLEQ    80$
        CMPW    (R5), #^A/NO/
        BNEQ    80$
        CLRL    R4
        ADDL2   #2, R5
        SUBL2   #2, R6
        BSBW    LOOKUP
        BLBC    R0, 80$
40$:    $SETPRV_S ENBFLG=R4, PRVADR=MASK, PRMFLG=#1
        BLBC    R0, 90$
        CMPL    R0, #SS$_NOTALLPRIV
        BNEQ    10$
        MOVL    R0, STATUS
        BRB     10$
60$:    CMPL    STATUS, #SS$_NOTALLPRIV
        BNEQ    70$
        PUSHL   STATUS
        CALLS   #1, G^LIB$SIGNAL
70$:    MOVL    STATUS, R0
        RET
80$:    PRINT   "%DCL-W-IVKEYW, unrecognized keyword - check validity and spelling"
        MOVAB   LINE+1, R1
        MOVW    #^A/ \/, (R1)+
        MOVZWL  LEN, R0
        MOVC3   R0, NAME, (R1)
        MOVB    #^A/\/, (R3)
        MOVAB   LINE, R1
        SUBL3   R1, R3, R0              ; up to the backslash
        MOVB    R0, LINE
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        MOVL    #<CLI$_IVKEYW!INHIB>, R0
90$:    RET

; FILE: SET PROTECTION, SET FILE, or SET DIRECTORY or SET VOLUME:
; finds the file, reads its attributes, changes those the command
; names, and writes them back. R0 = the first failure, or SS$_NORMAL.
FILE:   PRESENT "OPTION.DIRECTORY"
        BLBC    R0, 1$
        BRW     SETDIR
1$:     PRESENT "OPTION.VOLUME"
        BLBC    R0, 2$
        BRW     SETVOL
2$:     GETVALUE "FILE", SPECDSC, SPECDSC
        BLBC    R0, 5$
        MOVB    SPECDSC, FAB+FAB$B_FNS
        $PARSE  FAB=FAB
        BLBC    R0, 5$
        $SEARCH FAB=FAB
        BLBC    R0, 5$
        MOVL    NAM+NAM$W_FID, FIB+FIB$W_FID
        MOVW    NAM+NAM$W_FID+4, FIB+FIB$W_FID+4
        BSBW    ASSIGN
        BLBS    R0, 6$
5$:     RET
6$:     $QIOW_S CHAN=FCHAN, FUNC=#IO$_ACCESS, IOSB=IOSB, P1=FIBDSC, P5=#GETATR
        BSBW    IOSTAT
        BLBS    R0, 7$
        BRW     80$
7$:     MOVAB   PUTATR, R6              ; what it changes
        PRESENT "OPTION.PROTECTION"
        BLBC    R0, 10$
        PUSHAW  PRO
        PUSHAQ  PROTECTION
        CALLS   #2, G^GET_PROT
        BLBC    R0, 80$
        MOVW    #ATR$S_FPRO, (R6)+
        MOVW    #ATR$C_FPRO, (R6)+
        MOVAW   PRO, (R6)+
        CLRL    (R6)
        BRW     50$                     ; SET PROTECTION has no qualifiers
10$:    PRESENT "OWNER_UIC"
        BLBC    R0, 20$
        PUSHAL  UIC
        PUSHAQ  OWNER_UIC
        CALLS   #2, G^GET_UIC
        BLBC    R0, 80$
        MOVW    #ATR$S_UIC, (R6)+
        MOVW    #ATR$C_UIC, (R6)+
        MOVAL   UIC, (R6)+
20$:    PRESENT "ATTRIBUTE"
        BLBC    R0, 30$
        PUSHL   R6
        BSBW    ATTRIB
        MOVL    (SP)+, R6
        BLBC    R0, 80$
        MOVW    #ATR$S_RECATTR, (R6)+
        MOVW    #ATR$C_RECATTR, (R6)+
        MOVAB   FAT, (R6)+
30$:    PRESENT "EXPIRATION_DATE"
        BLBS    R0, 32$
        CMPL    R0, #CLI$_NEGATED
        BNEQ    40$
        CLRQ    EXPDAT                  ; /NOEXPIRATION_DATE: none
        BRB     35$
32$:    PUSHL   R6
        BSBW    EXPIRES
        MOVL    (SP)+, R6
        BLBC    R0, 80$
35$:    MOVW    #ATR$S_EXPDATE, (R6)+
        MOVW    #ATR$C_EXPDATE, (R6)+
        MOVAQ   EXPDAT, (R6)+
40$:    CLRL    (R6)
        PRESENT "VERSION_LIMIT"
        BLBC    R0, 50$
        BSBW    LIMIT                   ; the name's, in its directory's entry
        BLBC    R0, 80$
        TSTL    R1
        BNEQ    45$
        MOVL    #32767, R1              ; 0 is none, which in the FIB leaves it
45$:    MOVW    R1, FIB+FIB$W_VERLIMIT
        MOVL    NAM+NAM$W_DID, FIB+FIB$W_DID
        MOVW    NAM+NAM$W_DID+4, FIB+FIB$W_DID+4
        MOVW    #FIB$M_FINDFID, FIB+FIB$W_NMCTL
50$:    $QIOW_S CHAN=FCHAN, FUNC=#IO$_MODIFY, IOSB=IOSB, P1=FIBDSC, P5=#PUTATR
        BSBW    IOSTAT
80$:    MOVL    R0, R2
        $DASSGN_S CHAN=FCHAN
        MOVL    R2, R0
        RET

; SETDIR: SET DIRECTORY/VERSION_LIMIT[=n]: the directory's default
; version limit, FAT$W_VERSIONS, which the names made in it later get, 0
; for none. R0 = the first failure, or SS$_NORMAL.
SETDIR: GETVALUE "DIRECTORY", SPECDSC, SPECDSC
        BLBC    R0, 90$
        MOVB    SPECDSC, FAB+FAB$B_FNS
        $PARSE  FAB=FAB                 ; whose NAM$W_DID is its .DIR file
        BLBC    R0, 90$
        MOVL    NAM+NAM$W_DID, FIB+FIB$W_FID
        MOVW    NAM+NAM$W_DID+4, FIB+FIB$W_FID+4
        BSBW    ASSIGN
        BLBC    R0, 90$
        $QIOW_S CHAN=FCHAN, FUNC=#IO$_ACCESS, IOSB=IOSB, P1=FIBDSC, P5=#DIRATR
        BSBW    IOSTAT
        BLBC    R0, 80$
        BSBW    LIMIT
        BLBC    R0, 80$
        MOVW    R1, FAT+FAT$W_VERSIONS
        $QIOW_S CHAN=FCHAN, FUNC=#IO$_MODIFY, IOSB=IOSB, P1=FIBDSC, P5=#DIRATR
        BSBW    IOSTAT
80$:    MOVL    R0, R2
        $DASSGN_S CHAN=FCHAN
        MOVL    R2, R0
90$:    RET

; SETVOL: SET VOLUME device: the label, owner, protection and default file
; protection of the volume mounted there, which FIL$SETVOLUME, in kernel
; mode, writes in its home blocks. R0 = its status, $GETDVI's, or the
; CLI's.
SETVOL: GETVALUE "DEVICE", SPECDSC, SPECDSC
        BLBC    R0, 90$
        $GETDVIW_S DEVNAM=SPECDSC, ITMLST=VOLITEMS
        BLBC    R0, 90$
        CLRL    VWHAT
        PRESENT "LABEL"
        BLBC    R0, 10$
        MOVW    #64, LBLDSC
        GETVALUE "LABEL", LBLDSC, LBLDSC
        BLBC    R0, 90$
        BISL2   #1, VWHAT
10$:    PRESENT "OWNER_UIC"
        BLBC    R0, 20$
        PUSHAL  VOWNER
        PUSHAQ  OWNER_UIC
        CALLS   #2, G^GET_UIC
        BLBC    R0, 90$
        BISL2   #2, VWHAT
20$:    PRESENT "PROTECTION"
        BLBC    R0, 30$
        MOVAQ   VPROTECTION, R2
        MOVAL   VPROT, R3
        BSBW    VOLPROT
        BLBC    R0, 90$
        BISL2   #4, VWHAT
30$:    PRESENT "FILE_PROTECTION"
        BLBC    R0, 40$
        MOVAQ   FILE_PROTECTION, R2
        MOVAL   VFPROT, R3
        BSBW    VOLPROT
        BLBC    R0, 90$
        BISL2   #8, VWHAT
40$:    $CMKRNL_S ROUTIN=G^FIL$SETVOLUME, ARGLST=VARGS
90$:    RET

; SETTERM: SET TERMINAL: changes the characteristics the qualifiers
; name, and sets them. R0 = the first failure, or SS$_NORMAL; one SET
; has written already has STS$M_INHIB_MSG.
SETTERM:
        PUSHAQ  IOSB
        PUSHAB  CHAR
        PUSHAW  CHAN
        CALLS   #3, G^TERM_SENSE
        BLBS    R0, 2$
        TSTW    CHAN
        BEQL    1$                      ; not a terminal
        BSBW    NOTSET
1$:     RET
2$:     MOVL    #IO$_SETMODE, FUNC
        PRESENT "PERMANENT"
        BLBC    R0, 3$
        MOVL    #IO$_SETCHAR, FUNC
3$:     PRESENT "INQUIRE"
        BLBC    R0, 4$
        BSBW    INQUIRE
        BLBS    R0, 5$
        RET
4$:     MOVW    #16, VALDSC
        GETVALUE "DEVICE_TYPE", VALDSC, VALDSC
        BLBC    R0, 5$
        PUSHAQ  VALDSC
        CALLS   #1, G^TERM_FIND
        TSTL    R0
        BNEQ    45$
        BSBW    HEAD
        INVALID "DEVICE_TYPE", VALDSC, DASH
        MOVL    #ERROR, R0
        RET
45$:    PUSHL   R0
        PUSHAB  CHAR
        CALLS   #2, G^TERM_TYPE
5$:     PRESENT "WIDTH"
        BLBC    R0, 10$
        TTNUM   "WIDTH", 1, 511
        MOVW    R1, CHAR+2
10$:    PRESENT "PAGE"
        BLBC    R0, 20$
        TTNUM   "PAGE", 0, 255
        MOVB    R1, CHAR+7
20$:    TTBIT   "BROADCAST", TT$V_NOBRDCST, CHAR+4, ON=BBCC, OFF=BBSS
        TTBIT   "ECHO", TT$V_NOECHO, CHAR+4, ON=BBCC, OFF=BBSS
        TTBIT   "EIGHTBIT", TT$V_EIGHTBIT, CHAR+4
        TTBIT   "ESCAPE", TT$V_ESCAPE, CHAR+4
        TTBIT   "LOWERCASE", TT$V_LOWER, CHAR+4
        TTBIT   "TAB", TT$V_MECHTAB, CHAR+4
        TTBIT   "WRAP", TT$V_WRAP, CHAR+4
        TTBIT   "PASTHRU", TT2$V_PASTHRU, CHAR+8
        TTBIT   "LINE_EDITING", TT2$V_EDITING, CHAR+8
        TTBIT   "INSERT", TT2$V_INSERT, CHAR+8
        TTBIT   "OVERSTRIKE", TT2$V_INSERT, CHAR+8, ON=BBCC
        TTBIT   "COLOR", TT3$V_ANSI_COLOR, CHAR+12
        CLRL    SPEED
        PRESENT "SPEED"
        BLBC    R0, 40$
30$:    MOVW    #16, NUMDSC             ; each rate: the last in the low byte
        GETVALUE "SPEED", NUMDSC, NUMDSC
        BLBC    R0, 40$
        MOVL    #1, R2
        MOVL    #115200, R3
        BSBW    DECIMAL
        BLBC    R0, 38$
        MOVAL   G^TERM_SPEEDS, R2
        MOVL    #1, R3
35$:    CMPL    R1, (R2)[R3]
        BEQL    37$
        AOBLEQ  #TT$C_BAUD_115200, R3, 35$
        BRB     38$
37$:    ASHL    #8, SPEED, SPEED
        BISL2   R3, SPEED
        BRB     30$
38$:    INVALID "SPEED", NUMDSC, PERCENT
        MOVL    #ERROR, R0
        RET
40$:    $QIOW_S CHAN=CHAN, FUNC=FUNC, IOSB=IOSB, P1=CHAR, P2=#16, P3=SPEED
        BLBC    R0, 80$
        MOVZWL  IOSB, R0
        BLBC    R0, 80$
        RET
80$:    BSBW    NOTSET
        RET

; INQUIRE: SET TERMINAL/INQUIRE: asks the terminal what it is, DA's
; ESC [ c, and gives CHAR the type its answer, ESC [ ? n ; ... c, says
; (TERM_TYPE), as VMS's does: n 1 a VT100, whose advanced video is bit 1
; of the next number; 6 or 61 a VT102; 62 to 65 a VT200 to a VT500, whose
; next numbers 2, 3, 4 and 22 say it has a printer port, ReGIS, sixel
; graphics and ANSI colour. Then it asks the terminal where the cursor
; lands at row and column 255, ESC [ row ; column R, its page and width.
; R0 = SS$_NORMAL, or with STS$M_INHIB_MSG a failure SET has written:
; %SET-I-UNKTERM if the terminal doesn't answer within 3 seconds, or
; answers so. Uses R0-R7.
INQUIRE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        MOVAB   DA, R6
        MOVL    #DALEN, R7
        BSBW    ASK
        BLBS    R0, 5$
        CMPW    R0, #SS$_TIMEOUT
        BEQL    80$
        BRW     NOTSET                  ; a tail call
5$:     CMPB    (R1)+, #^A/[/
        BNEQ    80$
        CMPB    (R1)+, #^A/?/
        BNEQ    80$
        BSBW    NUMBERS
        CMPB    -1(R1), #^A/c/
        BNEQ    80$
        MOVL    NUMS, R0                ; the class
        MOVAQ   VT100, R6
        CMPL    R0, #1
        BEQL    20$
        MOVAQ   VT102, R6
        CMPL    R0, #6
        BEQL    20$
        CMPL    R0, #61
        BEQL    20$
        SUBL2   #62, R0
        CMPL    R0, #3
        BGTRU   80$
        ADDB3   #^A/2/, R0, VT200+10    ; VT200 to VT500: its third character
        MOVAQ   VT200, R6
20$:    PUSHL   R6
        CALLS   #1, G^TERM_FIND
        PUSHL   R0
        PUSHAB  CHAR
        CALLS   #2, G^TERM_TYPE
        CMPL    NUMS, #60
        BGTRU   40$
        CMPL    NUMS, #1
        BNEQ    50$
        CMPL    R7, #2                  ; a VT100's advanced video
        BLSSU   35$
        BBS     #1, NUMS+4, 50$
35$:    BICL2   #TT2$M_AVO, CHAR+8
        BRB     50$
40$:    MOVL    #1, R2                  ; a VT200's options
45$:    CMPL    R2, R7
        BGEQU   50$
        MOVL    NUMS[R2], R0
        CMPL    R0, #2
        BNEQ    46$
        BISL2   #TT2$M_PRINTER, CHAR+8
46$:    CMPL    R0, #3
        BNEQ    47$
        BISL2   #TT2$M_REGIS, CHAR+8
47$:    CMPL    R0, #4
        BNEQ    48$
        BISL2   #TT2$M_SIXEL, CHAR+8
48$:    CMPL    R0, #22
        BNEQ    49$
        BISL2   #TT3$M_ANSI_COLOR, CHAR+12
49$:    AOBLSS  R7, R2, 45$
50$:    MOVAB   CPR, R6                 ; its size
        MOVL    #CPRLEN, R7
        BSBW    ASK
        BLBC    R0, 70$
        CMPB    (R1)+, #^A/[/
        BNEQ    70$
        BSBW    NUMBERS
        CMPB    -1(R1), #^A/R/
        BNEQ    70$
        CMPL    R7, #2
        BNEQ    70$
        MOVL    NUMS, R0                ; the row
        BEQL    70$
        CMPL    R0, #255
        BGTRU   70$
        MOVL    NUMS+4, R1              ; and the column
        BEQL    70$
        CMPL    R1, #511
        BGTRU   70$
        MOVW    R1, CHAR+2
        MOVB    R0, CHAR+7
70$:    MOVL    #SS$_NORMAL, R0
        RSB
80$:    BSBW    HEAD
        PRINT   "-SET-I-UNKTERM, unknown terminal type"
        MOVL    #WARNING, R0
        RSB

; ASK: R6 = a question for the terminal, R7 its length. Writes it and
; reads the answer, an escape sequence that ends in c or R, waiting 3
; seconds for it; NOFILTR keeps line editing from taking it for a key's.
; R0 = SS$_NORMAL, and R1 = the sequence's first byte past ESC; or the
; failure, SS$_TIMEOUT if none came. Uses R0-R3.
ASK:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        CLRB    REPLY+63                ; NUMBERS stops there
        $QIOW_S CHAN=CHAN, FUNC=#ASKREAD, IOSB=IOSB, P1=REPLY, P2=#62, P3=#3, P4=#TERM, P5=R6, P6=R7
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
        BLBC    R0, 90$
        MOVZWL  IOSB+2, R2              ; the answer's ESC, past what was typed ahead
        MOVAB   REPLY, R1
        LOCC    #27, R2, (R1)
        BEQL    80$
        INCL    R1                      ; past it
        MOVB    IOSB+4, REPLY[R2]       ; and the terminator after it
        CLRB    REPLY+1[R2]
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVZWL  #SS$_TIMEOUT, R0        ; no escape sequence
90$:    RSB

; NUMBERS: R1 = decimal numbers, each ended by ; or another character.
; Puts the first NNUMS of them in NUMS. R7 = how many, R1 = past the
; character that ended the last. Uses R0, R2.
NUMBERS:
        .JSB_ENTRY  OUTPUT=<R1, R7>, SCRATCH=<R2>
        CLRL    R7
10$:    CLRL    R2
20$:    MOVZBL  (R1)+, R0
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BGTRU   30$
        MULL2   #10, R2
        ADDL2   R0, R2
        BRB     20$
30$:    CMPL    R7, #NNUMS
        BGEQU   40$
        MOVL    R2, NUMS[R7]
        INCL    R7
40$:    CMPB    -1(R1), #SEMI
        BEQL    10$
        RSB

; NOTSET: R0 = why SET TERMINAL failed. Writes it as VMS's SET does,
; %SET-W-NOTSET with the terminal's name, then its own message. R0 = it,
; with STS$M_INHIB_MSG. Uses R0-R5.
NOTSET:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R0
        BSBW    HEAD
        MOVL    (SP), R0
        $GETMSG_S MSGID=R0, MSGLEN=MSGLEN, BUFADR=MSGDSC
        MOVB    MSGLEN, LINE
        MOVB    #^A/-/, LINE+1
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        BISL3   #INHIB, (SP)+, R0
        RSB

; INVQUAVAL: R0 = a qualifier's name, .ASCIC, R1 = its value's
; descriptor, R2 = % or -. Writes %SET-E-INVQUAVAL for them. Uses R0-R5.
INVQUAVAL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R0
        PUSHL   R1
        PUSHL   R2
        MOVAB   LINE+1, R3
        MOVC3   #25, INVTXT, (R3)
        MOVL    4(SP), R1
        MOVC3   (R1), @4(R1), (R3)
        MOVC3   #15, INVTXT+25, (R3)
        MOVL    8(SP), R1
        MOVZBL  (R1)+, R0
        MOVC3   R0, (R1), (R3)
        MOVC3   #10, INVTXT+40, (R3)
        MOVAB   LINE+1, R1
        SUBL3   R1, R3, R0
        MOVB    R0, LINE
        MOVL    (SP)+, R0
        MOVB    R0, LINE+1
        ADDL2   #8, SP
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        RSB

; HEAD: writes %SET-W-NOTSET, error modifying, and the terminal's name,
; as VMS's SET TERMINAL's error messages begin. Uses R0-R5.
HEAD:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CLRW    DEVLEN
        $GETDVIW_S CHAN=CHAN, ITMLST=DVIITEMS
        MOVAB   LINE+1, R3
        MOVC3   #31, NOTSETTXT, (R3)
        MOVAB   DEVNAM, R1
        MOVZWL  DEVLEN, R0
        CMPB    (R1), #^A/_/
        BNEQ    10$
        INCL    R1                      ; _OPA0: is OPA0:
        DECL    R0
10$:    MOVC3   R0, (R1), (R3)
        MOVAB   LINE+1, R1
        SUBL3   R1, R3, R0
        MOVB    R0, LINE
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        RSB

; DECIMAL: NUMDSC = a decimal number, R2 = the least it may be, R3 = the
; most. R1 = it, R0 = SS$_NORMAL, or SS$_BADPARAM if it isn't one of
; those. Uses R0-R5.
DECIMAL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CLRL    R1
        MOVZWL  NUMDSC, R4
        BEQL    80$
        MOVAB   NUMBUF, R0
10$:    MOVZBL  (R0)+, R5
        SUBL2   #^A/0/, R5
        CMPL    R5, #9
        BGTRU   80$
        MULL2   #10, R1
        ADDL2   R5, R1
        CMPL    R1, R3
        BGTRU   80$
        SOBGTR  R4, 10$
        CMPL    R1, R2
        BLSSU   80$
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADPARAM, R0
        RSB

; LOOKUP: R5 = a privilege's name, R6 = its length. Puts its bit in MASK,
; or every bit for ALL. R0 = 1, or 0 for a name it doesn't know. Uses
; R0-R1.
LOOKUP:
        .JSB_ENTRY
        PUSHAQ  MASK
        PUSHL   R6
        PUSHL   R5
        CALLS   #3, G^PRV_LOOKUP
        RSB

; IOSTAT: R0 = a $QIOW's status. R0 = it, if it failed, else IOSB's.
IOSTAT:
        .JSB_ENTRY
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

; ASSIGN: NAM = the file's, from $PARSE. Assigns FCHAN to its device. R0
; = $ASSIGN's status.
ASSIGN:
        .JSB_ENTRY
        MOVZBL  NAM+NAM$B_DEV, DEVDSC
        MOVL    NAM+NAM$L_DEV, DEVDSC+4
        $ASSIGN_S DEVNAM=DEVDSC, CHAN=FCHAN
        RSB

; LIMIT: R1 = /VERSION_LIMIT's value, from 0 to 32767, 0 if it has none.
; R0 = SS$_NORMAL, or SS$_BADPARAM. Uses R0-R5.
LIMIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVW    #16, NUMDSC
        GETVALUE "VERSION_LIMIT", NUMDSC, NUMDSC
        CLRL    R1
        BLBC    R0, 10$
        CLRL    R2
        MOVL    #32767, R3
        BSBW    DECIMAL
        RSB
10$:    MOVL    #SS$_NORMAL, R0
        RSB

; EXPIRES: EXPDAT = /EXPIRATION_DATE's time, as DCL writes times:
; dd-MMM-yyyy:hh:mm:ss.cc, the parts left out as $BINTIM leaves them, a
; time alone today's; or TODAY, or 0, TOMORROW or YESTERDAY, that day's
; midnight. R0 = SS$_NORMAL, $BINTIM's SS$_IVTIME, or the CLI's error.
; Uses R0-R6.
EXPIRES:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVW    #64, ATTDSC
        GETVALUE "EXPIRATION_DATE", ATTDSC, ATTDSC
        BLBC    R0, 90$
        MOVAB   ATTBUF, R1
        MOVZWL  ATTDSC, R2
        MOVAB   DAYWORDS, R3
        BSBW    KWINDEX
        MOVL    R0, R6
        BLSS    20$
        $BINTIM_S TIMBUF=MIDNIGHT, TIMADR=EXPDAT
        BLBC    R0, 90$
        CMPL    R6, #2
        BLSSU   80$
        EVAX_LDQ R0, EXPDAT
        EVAX_LDQ R1, ONEDAY
        CMPL    R6, #2
        BNEQ    15$
        EVAX_ADDQ R0, R1, R0
        BRB     17$
15$:    EVAX_SUBQ R0, R1, R0
17$:    EVAX_STQ R0, EXPDAT
        BRB     80$
20$:    MOVZWL  ATTDSC, R6              ; DCL's time as $BINTIM's: has it a date?
        CLRL    R5
        CLRL    R4
21$:    CMPL    R4, R6
        BGEQU   23$
        CMPB    ATTBUF[R4], #^A/-/
        BNEQ    22$
        MOVL    #1, R5
22$:    INCL    R4
        BRB     21$
23$:    MOVAB   TIMBUF, R3
        TSTL    R5
        BNEQ    24$
        MOVB    #^A/-/, (R3)+           ; a time alone: today's
        MOVB    #^A/-/, (R3)+
        MOVB    #^A/ /, (R3)+
24$:    CLRL    R4
25$:    CMPL    R4, R6
        BGEQU   28$
        MOVB    ATTBUF[R4], R0
        CMPB    R0, #^A/:/
        BNEQ    26$
        BLBC    R5, 26$
        CLRL    R5                      ; the colon after the date: a blank
        MOVB    #^A/ /, R0
26$:    MOVB    R0, (R3)+
        INCL    R4
        BRB     25$
28$:    MOVAB   TIMBUF, R0
        SUBL3   R0, R3, R0
        MOVW    R0, TIMDSC
        $BINTIM_S TIMBUF=TIMDSC, TIMADR=EXPDAT
        RSB
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; ATTRIB: changes FAT, the record attributes, as /ATTRIBUTE's values
; say: BKS, DEQ, EBK, FFB, FSZ, GBC, LRL, MRS and VRS:n, a number, and
; ORG:{SEQ|REL|IDX}, RFM:{UDF|FIX|VAR|VFC|STM|STMLF|STMCR} and
; RAT:{NONE|FTN|CR|PRN|BLK|MSB}, the first RAT replacing the record
; attributes, any more adding to them; = for the colon too. R0 =
; SS$_NORMAL, SS$_BADPARAM for a value it doesn't know, or the CLI's
; error. Uses R0-R7.
ATTRIB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        CLRL    RATSET
10$:    MOVW    #64, ATTDSC
        GETVALUE "ATTRIBUTE", ATTDSC, ATTDSC
        BLBS    R0, 15$
        MOVL    #SS$_NORMAL, R0         ; past the last
        RSB
15$:    MOVZWL  ATTDSC, R7
        SUBL2   #4, R7                  ; the value's length, past KW:
        BLEQ    80$
        CMPB    ATTBUF+3, #^A/:/
        BEQL    20$
        CMPB    ATTBUF+3, #^A/=/
        BNEQ    80$
20$:    MOVAB   ATTKW, R6
25$:    TSTB    (R6)
        BEQL    80$
        CMPC3   #3, (R6), ATTBUF
        BEQL    30$
        ADDL2   #5, R6
        BRB     25$
30$:    CMPB    3(R6), #4
        BGTRU   50$
        CMPL    R7, #16                 ; a number, of 3(R6) bytes
        BGTRU   80$
        MOVW    R7, NUMDSC
        MOVC3   R7, ATTBUF+4, NUMBUF
        CLRL    R2
        MOVL    #255, R3
        CMPB    3(R6), #1
        BEQL    35$
        MOVZWL  #65535, R3
        CMPB    3(R6), #2
        BEQL    35$
        MOVL    #^X7FFFFFFF, R3
35$:    BSBW    DECIMAL
        BLBC    R0, 90$
        MOVZBL  4(R6), R4
        MOVAB   FAT[R4], R4
        CMPB    3(R6), #2
        BLSSU   40$
        BEQL    42$
        ROTL    #16, R1, (R4)           ; high word first
        BRB     10$
40$:    MOVB    R1, (R4)
        BRB     10$
42$:    MOVW    R1, (R4)
        BRB     10$
50$:    MOVAB   ORGS, R3                ; a keyword
        CMPB    3(R6), #5
        BEQL    52$
        MOVAB   RFMS, R3
        CMPB    3(R6), #6
        BEQL    52$
        MOVAB   RATS, R3
52$:    MOVAB   ATTBUF+4, R1
        MOVL    R7, R2
        BSBW    KWINDEX
        TSTL    R0
        BLSS    80$
        CMPB    3(R6), #6
        BLSSU   55$
        BEQL    57$
        TSTL    RATSET                  ; RAT
        BNEQ    53$
        CLRB    FAT+FAT$B_RATTRIB
        MOVL    #1, RATSET
53$:    TSTL    R0
        BEQL    59$                     ; NONE
        DECL    R0
        BBSS    R0, FAT+FAT$B_RATTRIB, 59$
59$:    BRW     10$
55$:    BICB2   #^XF0, FAT+FAT$B_RTYPE  ; ORG
        ASHL    #FAT$V_FILEORG, R0, R0
        BISB2   R0, FAT+FAT$B_RTYPE
        BRW     10$
57$:    BICB2   #^X0F, FAT+FAT$B_RTYPE  ; RFM
        BISB2   R0, FAT+FAT$B_RTYPE
        BRW     10$
80$:    MOVL    #SS$_BADPARAM, R0
90$:    RSB

; KWINDEX: R1 = a word, R2 = its length, R3 = words, each .ASCIC, a 0
; after the last. R0 = its index among them, or -1. Uses R0-R5.
KWINDEX:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7, R8>
        MOVL    R1, R6
        MOVL    R2, R7
        MOVL    R3, R8
        CLRL    R4
10$:    MOVZBL  (R8)+, R5
        BEQL    80$
        CMPL    R5, R7
        BNEQ    20$
        CMPC3   R7, (R6), (R8)
        BEQL    70$
20$:    ADDL2   R5, R8
        INCL    R4
        BRB     10$
70$:    MOVL    R4, R0
        BRB     90$
80$:    MNEGL   #1, R0
90$:    POPR    #^M<R6, R7, R8>
        RSB

; VOLPROT: R2 = an entity's name, a descriptor, R3 = a longword. Puts in
; its low word the protection codes the entity gives, and in its high
; word the bits of the mask they leave as they were, those of the
; categories it doesn't name: GET_PROT of none and of all differ there.
; R0 = GET_PROT's status. Uses R0-R1.
VOLPROT:
        .JSB_ENTRY
        CLRW    PROT0
        MOVW    #^XFFFF, PROTF
        PUSHAW  PROT0
        PUSHL   R2
        CALLS   #2, G^GET_PROT
        BLBC    R0, 90$
        PUSHAW  PROTF
        PUSHL   R2
        CALLS   #2, G^GET_PROT
        BLBC    R0, 90$
        MOVW    PROT0, (R3)
        XORW3   PROT0, PROTF, 2(R3)
90$:    RSB

; SETSEC: SET SECURITY: takes the qualifiers, then changes each file
; the parameter's values name, wildcards too. R0 = the worst status,
; with STS$M_INHIB_MSG once written.
        .ENTRY  SETSEC, ^M<R2, R3, R4, R5, R6>
        GETVALUE "CLASS", SECCLS, SECCLS
        BLBC    R0, 10$
        MOVL    #SS$_NOCLASS, R0
        CMPW    SECCLS, #4
        BNEQ    5$
        CMPL    SECCLSBUF, #^A/FILE/
        BEQL    10$
5$:     RET
10$:    BSBW    SECQUALS
        BLBS    R0, 20$
        RET
20$:    GETVALUE "OBJECT", SPECDSC, SPECDSC
        BLBC    R0, 80$
        MOVB    SPECDSC, FAB+FAB$B_FNS
        MOVW    #255, SPECDSC
        $PARSE  FAB=FAB
        BLBC    R0, 60$
30$:    $SEARCH FAB=FAB
        BLBC    R0, 50$
        BSBW    SECONE
        BRB     30$
50$:    CMPL    R0, #RMS$_NMF
        BEQL    20$
60$:    PUSHL   R0                      ; %SET-E-OPENOUT
        BSBW    SAYSTART
        MOVAB   OPENOUTTXT, R1
        BSBW    SAYC
        MOVZBL  NAM+NAM$B_ESL, R2
        MOVAB   EXP, R1
        BSBW    SAYS
        MOVAB   ASOUTPUT, R1
        BSBW    SAYC
        BSBW    SAYEND
        MOVL    (SP)+, R0
        BSBW    SAYMSG
        MOVL    #SS$_ABORT!INHIB, SECFAILED
        BRB     20$
80$:    MOVL    SECFAILED, R0
        RET

; SECQUALS: takes SET SECURITY's qualifiers into SECWHAT and the ACEs,
; owner and protection they give. R0 = SS$_NORMAL, or an error, written.
; Uses R0-R6.
SECQUALS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CLRL    SECWHAT
        PRESENT "LOG"
        BLBC    R0, 2$
        BISL2   #1@S_LOG, SECWHAT
2$:     PRESENT "OWNER"
        BLBC    R0, 10$
        BISL2   #1@S_OWNER, SECWHAT
        MOVW    #255, ACETXT
        GETVALUE "OWNER", ACETXT, ACETXT
        BLBC    R0, 90$
        BSBW    OWNERID
        BLBC    R0, 90$
10$:    PRESENT "PROTECTION"
        BLBC    R0, 20$
        BISL2   #1@S_PROT, SECWHAT
        MOVAQ   VPROTECTION, R2
        MOVAL   NEWPROT, R3
        BSBW    VOLPROT
        BLBC    R0, 90$
20$:    PRESENT "DEFAULT"
        BLBC    R0, 25$
        BISL2   #1@S_DEFAULT, SECWHAT
25$:    PRESENT "DELETE"
        BLBC    R0, 30$
        BISL2   #1@S_DELETE, SECWHAT
        PRESENT "DELETE.ALL"
        BLBC    R0, 30$
        BISL2   #1@S_ALL, SECWHAT
30$:    MOVAB   ACEBUF, R6              ; /ACL's ACEs
        MOVAQ   ACLNAME, R5
        BSBW    ACES
        BLBC    R0, 90$
        MOVL    R1, NACES
        BEQL    35$
        BISL2   #1@S_ACL, SECWHAT
        BRB     40$
35$:    PRESENT "ACL"                   ; /ACL alone: with /DELETE only
        BLBC    R0, 40$
        BBS     #S_DELETE, SECWHAT, 40$
        PRINT   "%CLI-W-VALREQ, missing qualifier or keyword value - supply all required values"
        MOVL    #CLI$_VALREQ!INHIB, R0
        RSB
40$:    MOVAB   REPBUF, R6              ; /REPLACE's
        MOVAQ   REPNAME, R5
        BSBW    ACES
        BLBC    R0, 90$
        MOVL    R1, NREPS
        BEQL    45$
        BISL2   #1@S_REPLACE, SECWHAT
45$:    MOVAB   AFTERACE, R6            ; /AFTER's
        MOVAQ   AFTERNAME, R5
        BSBW    ACES
        BLBC    R0, 90$
        TSTL    R1
        BEQL    50$
        BISL2   #1@S_AFTER, SECWHAT
50$:    PRESENT "LIKE"
        BLBC    R0, 80$
        BISL2   #1@S_LIKE, SECWHAT
        BSBW    LIKE
        RSB
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; ACES: R5 = a qualifier's name, a descriptor, R6 = where its ACEs go,
; 256 bytes each. Parses each of its values with $PARSE_ACL. R1 = how
; many. R0 = SS$_NORMAL, or an error, written as VMS's SET writes it:
; %SET-F-SYNTAX with the text from where $PARSE_ACL stopped, then why.
; A hidden ACE is %SET-E-NOHIDDEN. Uses R0-R6.
ACES:
        .JSB_ENTRY  OUTPUT=<R1>, SCRATCH=<R2, R3, R4, R5, R6>
        PUSHL   #0                      ; how many
10$:    MOVW    #255, ACETXT
        PUSHAW  ACETXT
        PUSHAQ  ACETXT
        PUSHL   R5
        CALLS   #3, G^CLI$GET_VALUE
        BLBC    R0, 80$
        CMPL    (SP), #NACE
        BGEQU   10$
        MOVL    R6, ACEDSC+4
        $PARSE_ACL_S ACLSTR=ACETXT, ACLENT=ACEDSC, ERRPOS=ERRPOS
        BLBC    R0, 50$
        BBC     #ACE$V_HIDDEN, ACE$W_FLAGS(R6), 20$
        PRINT   "%SET-E-NOHIDDEN, cannot modify hidden ACEs"
        MOVL    #SS$_ABORT!INHIB, R0
        BRB     90$
20$:    ADDL2   #256, R6
        INCL    (SP)
        BRB     10$
50$:    PUSHL   R0                      ; %SET-F-SYNTAX
        BSBW    SAYSTART
        MOVAB   SYNTAXTXT, R1
        BSBW    SAYC
        MOVZWL  ERRPOS, R0
        MOVZWL  ACETXT, R2
        SUBL2   R0, R2
        MOVAB   ACETXTBUF[R0], R1
        BSBW    SAYS
        MOVAB   QUOTE, R1
        BSBW    SAYC
        BSBW    SAYEND
        MOVL    (SP)+, R0
        BSBW    SAYMSG
        MOVL    #SS$_ABORT!INHIB, R0
        BRB     90$
80$:    MOVL    #SS$_NORMAL, R0
90$:    MOVL    (SP)+, R1
        RSB

; OWNERID: ACETXT = /OWNER's value: a UIC, [g,m], an identifier's name,
; or [name]. Puts its identifier in NEWOWNER, by $PARSE_ACL. R0 =
; SS$_NORMAL, or %SET-F-SYNTAX, written. Uses R0-R5.
OWNERID:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAB   FMTBUF, R3              ; (IDENTIFIER=value)
        MOVC3   #12, IDPREFIX, (R3)
        MOVZWL  ACETXT, R0
        MOVC3   R0, ACETXTBUF, (R3)
        MOVB    #41, (R3)+              ; )
        MOVAB   FMTBUF, R1
        SUBL3   R1, R3, R0
        MOVL    R0, OWNERDSC
        MOVAB   AFTERACE, ACEDSC+4      ; scratch, until /AFTER's
        $PARSE_ACL_S ACLSTR=OWNERDSC, ACLENT=ACEDSC
        BLBC    R0, 50$
        MOVL    AFTERACE+ACE$L_KEY, R0
        CMPL    R0, #-1                 ; not *
        BEQL    50$
        MOVL    R0, NEWOWNER
        MOVL    #SS$_NORMAL, R0
        RSB
50$:    BSBW    SAYSTART
        MOVAB   SYNTAXTXT, R1
        BSBW    SAYC
        MOVZWL  ACETXT, R2
        MOVAB   ACETXTBUF, R1
        BSBW    SAYS
        MOVAB   QUOTE, R1
        BSBW    SAYC
        BSBW    SAYEND
        MOVL    #SS$_ABORT!INHIB, R0
        RSB

; LIKE: /LIKE's values: NAME=file, the file whose owner, protection and
; ACL the files get, which $GET_SECURITY reads, and CLASS=FILE. R0 =
; SS$_NORMAL, or an error, written. Uses R0-R5.
LIKE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
10$:    MOVW    #255, ACETXT
        GETVALUE "LIKE", ACETXT, ACETXT
        BLBC    R0, 80$
        CMPW    ACETXT, #5
        BLEQU   10$
        CMPL    ACETXTBUF, #^A/NAME/
        BNEQ    10$
        CMPB    ACETXTBUF+4, #^A/=/
        BNEQ    10$
        SUBW3   #5, ACETXT, OWNERDSC    ; the file's name
        MOVAB   ACETXTBUF+5, OWNERDSC+4
        CLRW    LIKELEN
        $GET_SECURITY_S CLSNAM=FILECLS, OBJNAM=OWNERDSC, ITMLST=LIKEITEMS
        BLBS    R0, 10$
        CMPL    R0, #SS$_ACLEMPTY
        BEQL    10$
        PUSHL   R0                      ; %SET-F-READERR
        BSBW    SAYSTART
        MOVAB   READERRTXT, R1
        BSBW    SAYC
        MOVZWL  OWNERDSC, R2
        MOVL    OWNERDSC+4, R1
        BSBW    SAYS
        BSBW    SAYEND
        MOVL    (SP)+, R0
        BSBW    SAYMSG
        MOVL    #SS$_ABORT!INHIB, R0
        RSB
80$:    MOVL    #SS$_NORMAL, R0
        RSB

; SECONE: RES = a file's resultant string, NAM's. Changes it, as
; SECWHAT says: its owner and protection with one $SET_SECURITY, its
; ACL with another, and /LOG says so. Uses R0-R6.
SECONE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVZBL  NAM+NAM$B_RSL, OBJDSC
        MOVAB   SECITEMS, R6
        BBC     #S_OWNER, SECWHAT, 10$
        MOVL    #OSS$_OWNER, R0
        MOVAL   NEWOWNER, R1
        MOVL    #4, R2
        BSBW    ADDITEM
10$:    BBC     #S_PROT, SECWHAT, 20$
        $GET_SECURITY_S CLSNAM=FILECLS, OBJNAM=OBJDSC, ITMLST=PROTITEMS
        BLBC    R0, 85$
        BICW3   NEWPROT+2, #^XFFFF, R0  ; what it keeps, and sets
        BICW2   R0, CURPROT
        BISW2   NEWPROT, CURPROT
        MOVL    #OSS$_PROTECTION, R0
        MOVAL   CURPROT, R1
        MOVL    #2, R2
        BSBW    ADDITEM
20$:    BBC     #S_DEFAULT, SECWHAT, 25$
        MOVL    #DEFPROT, CURPROT
        MOVL    #OSS$_PROTECTION, R0
        MOVAL   CURPROT, R1
        MOVL    #2, R2
        BSBW    ADDITEM
25$:    BBC     #S_LIKE, SECWHAT, 30$
        MOVL    #OSS$_OWNER, R0
        MOVAL   LIKEOWNER, R1
        MOVL    #4, R2
        BSBW    ADDITEM
        MOVL    #OSS$_PROTECTION, R0
        MOVAL   LIKEPROT, R1
        MOVL    #2, R2
        BSBW    ADDITEM
30$:    MOVAB   SECITEMS, R0
        CMPL    R6, R0
        BEQL    40$
        BSBW    SECSET
        BLBC    R0, 85$
40$:    BSBW    SECACL
        BLBC    R0, 90$
        BBC     #S_LOG, SECWHAT, 90$
        BSBW    SAYSTART                ; %SET-I-MODIFIED
        MOVAB   MODIFIEDTXT, R1
        BSBW    SAYC
        MOVZBL  NAM+NAM$B_RSL, R2
        MOVAB   RES, R1
        BSBW    SAYS
        MOVAB   MODIFIED2TXT, R1
        BSBW    SAYC
        BSBW    SAYEND
        RSB
85$:    BSBW    WRITEERR
90$:    RSB

; SECACL: changes the file's ACL as SECWHAT says, by /LIKE or /DEFAULT,
; /DELETE, /REPLACE, /AFTER or /ACL, in that order of choice. R0 =
; SS$_NORMAL or an error, written. Uses R0-R6.
SECACL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CLRL    SECCTX
        MOVAB   SECITEMS, R6
        BITL    #<1@S_LIKE>!<1@S_DEFAULT>, SECWHAT
        BEQL    20$
        MOVL    #OSS$_ACL_DELETE, R0    ; the protected ones stay
        BSBW    ADDNONE
        BBC     #S_LIKE, SECWHAT, 15$
        MOVL    #OSS$_ACL_POSITION_BOTTOM, R0
        BSBW    ADDNONE
        MOVAB   LIKEACL, R5             ; and the other's ACEs, after them
        MOVZWL  LIKELEN, R4
        ADDL2   R5, R4
10$:    CMPL    R5, R4
        BGEQU   15$
        MOVZBL  (R5), R2
        BEQL    15$
        BITW    #ACE$M_HIDDEN!ACE$M_NOPROPAGATE, ACE$W_FLAGS(R5)
        BNEQ    12$
        MOVL    #OSS$_ACL_ADD_ENTRY, R0
        MOVL    R5, R1
        BSBW    ADDITEM
12$:    ADDL2   R2, R5
        BRB     10$
15$:    BRW     SECSET
20$:    BBC     #S_DELETE, SECWHAT, 50$
        MOVL    #OSS$_ACL_DELETE_ALL, R0
        BBS     #S_ALL, SECWHAT, 25$
        TSTL    NACES
        BNEQ    30$
        MOVL    #OSS$_ACL_DELETE, R0
25$:    BSBW    ADDNONE
        BRW     SECSET
30$:    CLRL    R4                      ; each one, apart: those not there are said
        MOVAB   ACEBUF, R5
        PUSHL   #SS$_NORMAL
35$:    MOVAB   SECITEMS, R6
        MOVL    #OSS$_ACL_DELETE_ENTRY, R0
        MOVL    R5, R1
        MOVZBL  (R5), R2
        BSBW    ADDITEM
        BSBW    SECSET1
        BLBS    R0, 40$
        CMPL    R0, #SS$_NOENTRY
        BEQL    37$
        CMPL    R0, #SS$_ACLEMPTY
        BNEQ    45$
37$:    BSBW    NOSUCHACE
        MOVL    #SS$_NOENTRY, (SP)
40$:    ADDL2   #256, R5
        AOBLSS  NACES, R4, 35$
        MOVL    (SP)+, R0
        BLBS    R0, 48$
        BSBW    SAYSTART                ; %SET-F-WRITEERR, alone
        MOVAB   WRITEERRTXT, R1
        BSBW    SAYC
        MOVZBL  NAM+NAM$B_RSL, R2
        MOVAB   RES, R1
        BSBW    SAYS
        BSBW    SAYEND
        MOVL    #SS$_ABORT!INHIB, R0
        MOVL    R0, SECFAILED
48$:    RSB
45$:    TSTL    (SP)+
        BSBW    WRITEERR
        RSB
50$:    MOVAB   ACEBUF, R5
        BBC     #S_REPLACE, SECWHAT, 60$
        TSTL    NACES                   ; /REPLACE: the first's place
        BEQL    90$
        MOVL    #OSS$_ACL_FIND_ENTRY, R0
        MOVL    R5, R1
        MOVZBL  (R5), R2
        BSBW    ADDITEM
        MOVL    NACES, R4               ; then each goes
52$:    MOVL    #OSS$_ACL_DELETE_ENTRY, R0
        MOVL    R5, R1
        MOVZBL  (R5), R2
        BSBW    ADDITEM
        ADDL2   #256, R5
        SOBGTR  R4, 52$
        MOVAB   REPBUF, R5              ; and the new ones go there
        MOVL    NREPS, R4
        BRB     70$
60$:    BBC     #S_AFTER, SECWHAT, 65$
        MOVL    #OSS$_ACL_FIND_ENTRY, R0        ; /AFTER: past that one
        MOVAB   AFTERACE, R1
        MOVZBL  AFTERACE, R2
        BSBW    ADDITEM
        BSBW    SECSET1
        BLBC    R0, 85$
        EXTZV   #0, #24, SECCTX, R0
        ADDL3   #1, R0, SECCTX
        MOVAB   SECITEMS, R6
65$:    MOVL    NACES, R4
        BEQL    90$
70$:    TSTL    R4
        BEQL    80$
72$:    MOVL    #OSS$_ACL_ADD_ENTRY, R0
        MOVL    R5, R1
        MOVZBL  (R5), R2
        BSBW    ADDITEM
        ADDL2   #256, R5
        SOBGTR  R4, 72$
80$:    BRW     SECSET
85$:    BSBW    WRITEERR
        RSB
90$:    MOVL    #SS$_NORMAL, R0
        RSB

; NOSUCHACE: R5 = an ACE. Writes %SET-W-NOSUCHACE for it, and the ACE,
; as $FORMAT_ACL writes it, 4 blanks in. Uses R0-R3.
NOSUCHACE:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVZBL  (R5), ACEDSC
        MOVL    R5, ACEDSC+4
        MOVW    #255, FMTDSC
        $FORMAT_ACL_S ACLENT=ACEDSC, ACLLEN=FMTLEN, ACLSTR=FMTDSC, WIDTH=FMTWIDTH, TRMDSC=NEWLINE, INDENT=FMTINDENT
        MOVW    #256, ACEDSC
        BSBW    SAYSTART
        MOVAB   NOSUCHTXT, R1
        BSBW    SAYC
        MOVZBL  NAM+NAM$B_RSL, R2
        MOVAB   RES, R1
        BSBW    SAYS
        MOVAB   NOSUCH2TXT, R1
        BSBW    SAYC
        BSBW    SAYEND
        MOVAB   FMTBUF, R1              ; a line each
        MOVZWL  FMTLEN, R3
        ADDL2   R1, R3
10$:    MOVL    R1, R2
20$:    CMPL    R2, R3
        BGEQU   30$
        CMPB    (R2), #10
        BEQL    30$
        INCL    R2
        BRB     20$
30$:    PUSHL   R2
        PUSHL   R3
        SUBL2   R1, R2
        BSBW    SAYSTART
        BSBW    SAYS
        BSBW    SAYEND
        MOVL    (SP)+, R3
        MOVL    (SP)+, R1
        INCL    R1
        CMPL    R1, R3
        BLEQU   10$
        RSB

; ADDITEM: R0 = an OSS$_ item, R1 = its buffer, R2 = its size, R6 = the
; next item in SECITEMS. Puts it there, a longword of 0 after it, R6
; past it. ADDNONE: the same for an item with no buffer. Keeps R0-R5.
ADDNONE:
        .JSB_ENTRY  OUTPUT=<R6>
        CLRW    (R6)+
        MOVW    R0, (R6)+
        MOVAB   SECCTX, (R6)+           ; a buffer it doesn't read
        CLRL    (R6)+
        CLRL    (R6)
        RSB
ADDITEM:
        .JSB_ENTRY  OUTPUT=<R6>
        MOVW    R2, (R6)+
        MOVW    R0, (R6)+
        MOVL    R1, (R6)+
        CLRL    (R6)+
        CLRL    (R6)
        RSB

; SECSET: $SET_SECURITY of the items in SECITEMS on the file, at
; SECCTX's position. R0 = its status, an error written, %SET-F-WRITEERR
; and why. SECSET1: the same, the error not written. Uses R0-R5.
SECSET:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BSBB    SECSET1
        BLBS    R0, 10$
        BSBW    WRITEERR
10$:    RSB
SECSET1:
        .JSB_ENTRY
        $SET_SECURITY_S CLSNAM=FILECLS, OBJNAM=OBJDSC, ITMLST=SECITEMS, CONTXT=SECCTX
        RSB

; WRITEERR: R0 = why a file couldn't be changed. Writes %SET-F-WRITEERR
; and it. R0 = it, with STS$M_INHIB_MSG. Uses R0-R5.
WRITEERR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R0
        BSBW    SAYSTART
        MOVAB   WRITEERRTXT, R1
        BSBW    SAYC
        MOVZBL  NAM+NAM$B_RSL, R2
        MOVAB   RES, R1
        BSBW    SAYS
        BSBW    SAYEND
        MOVL    (SP)+, R0
        BSBW    SAYMSG
        BISL2   #INHIB, R0
        MOVL    R0, SECFAILED
        RSB

; SAYSTART: starts a line in LINE. SAYC: R1 = text, .ASCIC; SAYS: R1 =
; text, R2 = its length: appends it, as much as fits. SAYEND: writes the
; line. Use R0-R5.
SAYSTART:
        .JSB_ENTRY
        CLRB    LINE
        RSB
SAYC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  (R1)+, R2
        BSBB    SAYS
        RSB
SAYS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  LINE, R3
        ADDL3   R3, R2, R0
        CMPL    R0, #255
        BLEQU   10$
        SUBL3   R3, #255, R2
10$:    ADDB2   R2, LINE
        MOVAB   LINE+1[R3], R3
        MOVC3   R2, (R1), (R3)
        RSB
SAYEND:
        .JSB_ENTRY
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        RSB

; SAYMSG: R0 = a status. Writes its message, -FACILITY-S-NAME, text, as
; a secondary one. Keeps R0. Uses R1-R5.
SAYMSG:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R0
        $GETMSG_S MSGID=R0, MSGLEN=MSGLEN, BUFADR=MSGDSC
        MOVB    MSGLEN, LINE
        MOVB    #^A/-/, LINE+1
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        MOVL    (SP)+, R0
        RSB

        .END    START
