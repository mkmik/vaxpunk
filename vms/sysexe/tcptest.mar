        .TITLE  TCPTEST TCP and UDP over $QIO, both ways
        .IDENT  /V0.2/
;
; Tries sockets on TCPIP$DEVICE:, the network's port driver, both ways,
; as a program written for TCP/IP Services would. It connects to port
; 7777 on 10.0.2.100, which QEMU's user network forwards to a server on
; the host (image/tests/network.rs), sends a line, writes the line that
; comes back and closes. Then it listens on port 7778, which the host
; reaches through QEMU, accepts a connection, writes where it came from
; and the line that comes, sends it back and closes. Then it waits on
; UDP port 7780, which IO$_SENSEMODE must say it has, for a datagram,
; writes where it came from and what it says, and sends it back there; then connects the socket to the sender
; and sends it again, as a connected socket's write, without a name.
; Each step says what it did, and the first that fails ends it with its
; status.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $IODEF
        $INETSYMDEF
        $SOCKADDRINDEF

        .EXTERNAL PUT_LINE

        .PSECT  DATA, NOEXE, WRT, LONG
DEVICE: .ASCID  "TCPIP$DEVICE:"
CHAN:   .LONG   0                       ; the connection's channel
LCHAN:  .LONG   0                       ; the listening one's
UCHAN:  .LONG   0                       ; the UDP socket's
IOSB:   .BLKQ   1
TCP:    .WORD   TCPIP$C_TCP             ; a TCP socket: protocol, type, family
        .BYTE   TCPIP$C_STREAM, TCPIP$C_AF_INET
UDP:    .WORD   TCPIP$C_UDP             ; a UDP socket
        .BYTE   TCPIP$C_DGRAM, TCPIP$C_AF_INET
; Socket names, each an item_list_2 of a SOCKADDRIN, the port in network
; order: the host's server, 10.0.2.100 port 7777, and the local ports.
SERVER: .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS .+4
        .WORD   TCPIP$C_AF_INET
        .BYTE   ^X1E, ^X61, 10, 0, 2, 100
        .BLKB   8
TCPNAME:
        .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS .+4
        .WORD   TCPIP$C_AF_INET
        .BYTE   ^X1E, ^X62, 0, 0, 0, 0  ; port 7778, any address
        .BLKB   8
UDPNAME:
        .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS .+4
        .WORD   TCPIP$C_AF_INET
        .BYTE   ^X1E, ^X64, 0, 0, 0, 0  ; port 7780
        .BLKB   8
; The peer's name: an item_list_3 that gets it, and an item_list_2 that
; gives it back.
PEERGET:
        .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS PEER, PEERLEN
PEERPUT:
        .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS PEER
PEER:   .BLKB   SIN$K_LENGTH
PEERLEN:
        .LONG   0
LOCALGET:                               ; the socket's own name, sensed
        .WORD   SIN$K_LENGTH, TCPIP$C_SOCK_NAME
        .ADDRESS LOCAL, 0
LOCAL:  .BLKB   SIN$K_LENGTH
HELLO:  .ASCII  "hello from vaxpunk"<13><10>
HELLOLEN = . - HELLO
LEN:    .LONG   0                       ; what came: its length,
LINE:   .BLKB   1                       ; and it, .ASCIC, without its line end
BUF:    .BLKB   255

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2>
        $ASSIGN_S DEVNAM=DEVICE, CHAN=CHAN
        BLBC    R0, 90$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=TCP
        BSBW    STATUS
        BLBC    R0, 90$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_ACCESS, IOSB=IOSB, P3=#SERVER
        BSBW    STATUS
        BLBC    R0, 90$
        PRINT   "TCPTEST: connected to 10.0.2.100 port 7777"
        $QIOW_S CHAN=CHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=HELLO, P2=#HELLOLEN
        BSBW    STATUS
        BLBC    R0, 90$
        BSBW    READ
        BLBC    R0, 90$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_DEACCESS, IOSB=IOSB
        BSBW    STATUS
        BLBC    R0, 90$
        PRINT   "TCPTEST: closed"
        $DASSGN_S CHAN=CHAN
        BRB     LISTEN
90$:    RET

; The socket is made, bound and set listening in one request.
LISTEN: $ASSIGN_S DEVNAM=DEVICE, CHAN=LCHAN
        BLBC    R0, 95$
        $QIOW_S CHAN=LCHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=TCP, P3=#TCPNAME, P4=#1
        BSBW    STATUS
        BLBC    R0, 95$
        PRINT   "TCPTEST: listening on port 7778"
        $ASSIGN_S DEVNAM=DEVICE, CHAN=CHAN
        BLBC    R0, 95$
        $QIOW_S CHAN=LCHAN, FUNC=#IO$_ACCESS!IO$M_ACCEPT, IOSB=IOSB, P3=#PEERGET, P4=#CHAN
        BSBW    STATUS
        BLBC    R0, 95$
        PRINTHEX "TCPTEST: accepted a connection from address ", PEER+SIN$L_ADDR
        BSBW    READ
        BLBC    R0, 95$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=BUF, P2=LEN
        BSBW    STATUS
        BLBC    R0, 95$
        $QIOW_S CHAN=CHAN, FUNC=#IO$_DEACCESS, IOSB=IOSB
        BSBW    STATUS
        BLBC    R0, 95$
        $DASSGN_S CHAN=CHAN
        $DASSGN_S CHAN=LCHAN
        BRB     DGRAM
95$:    RET

; A UDP socket on port 7780: a datagram back to its sender, named, then
; again on the socket connected to it.
DGRAM:  $ASSIGN_S DEVNAM=DEVICE, CHAN=UCHAN
        BLBC    R0, 99$
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_SETMODE, IOSB=IOSB, P1=UDP, P3=#UDPNAME
        BSBW    STATUS
        BLBC    R0, 99$
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_SENSEMODE, IOSB=IOSB, P3=#LOCALGET
        BSBW    STATUS
        BLBC    R0, 99$
        MOVL    #SS$_BADPARAM, R0
        CMPW    LOCAL+SIN$W_PORT, UDPNAME+8+SIN$W_PORT
        BNEQ    99$
        PRINT   "TCPTEST: UDP on port 7780"
        MOVL    UCHAN, CHAN
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_READVBLK, IOSB=IOSB, P1=BUF, P2=#255, P3=#PEERGET
        BSBW    STATUS
        BLBC    R0, 99$
        PRINTHEX "TCPTEST: a datagram from address ", PEER+SIN$L_ADDR
        BSBW    SHOW
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=BUF, P2=LEN, P3=#PEERPUT
        BSBW    STATUS
        BLBC    R0, 99$
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_ACCESS, IOSB=IOSB, P3=#PEERPUT
        BSBW    STATUS
        BLBC    R0, 99$
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=BUF, P2=LEN
        BSBW    STATUS
        BLBC    R0, 99$
        $QIOW_S CHAN=UCHAN, FUNC=#IO$_WRITEVBLK, IOSB=IOSB, P1=BUF, P2=LEN, P3=#PEERPUT
        BSBW    STATUS
        CMPL    R0, #SS$_FILALRACC      ; a name on a connected socket
        BNEQ    99$
        $DASSGN_S CHAN=UCHAN
        PRINT   "TCPTEST: ok"
        MOVL    #SS$_NORMAL, R0
99$:    RET

; READ: receives what comes on CHAN into BUF, LEN bytes, and writes it,
; without its line end. R0 = the status. SHOW: writes it.
READ:
        .JSB_ENTRY
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READVBLK, IOSB=IOSB, P1=BUF, P2=#255
        BSBW    STATUS
        BLBC    R0, 90$
        BSBB    SHOW
90$:    RSB
SHOW:
        .JSB_ENTRY
        MOVZWL  IOSB+2, R1
        MOVL    R1, LEN
10$:    TSTL    R1                      ; without the CR LF
        BEQL    20$
        CMPB    BUF-1[R1], #13
        BEQL    15$
        CMPB    BUF-1[R1], #10
        BNEQ    20$
15$:    DECL    R1
        BRB     10$
20$:    MOVB    R1, LINE
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        MOVL    #SS$_NORMAL, R0
        RSB

; STATUS: R0 = $QIOW's status. R0 = the IOSB's, if that was a success.
STATUS:
        .JSB_ENTRY
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

        .END    START
