        .TITLE  PROCESS Process creation, deletion and control
        .IDENT  /V0.1/
;
; A process is a PCB and a kernel stack in S0, an image and stacks in its
; own P0 and P1, and the threads the PAL makes for it: the first time the
; scheduler switches to the process's HWPCB, and the first time it enters
; each outer mode. $CREPRC builds the PCB and a kernel stack holding the
; frame REI pops, which starts the process at EXE$PROCSTRT, in kernel mode
; at IPL 0. There it activates its image from the system disk and REIs to
; user mode, which calls the image; when the image returns, or calls $EXIT,
; the process is deleted, as a VMS process is when its image exits and it
; has no command interpreter.
;
; An image linked in P1 is a command interpreter: it is activated there
; and called in supervisor mode, and stays. It runs images with $IMGACT,
; and when one exits, the process runs it down and calls the command
; interpreter again (docs/design/0002-executive-processes.md). CTRL/Y
; is the command interpreter's supervisor mode AST, which stops the image
; where it is, and returns to it for CONTINUE (ADR-0014).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $PALDEF
        $PCBDEF
        $PRVDEF
        $PSLDEF
        $STATEDEF
        $HWPCBDEF
        $INTSTKDEF
        $PTEDEF
        $PRTDEF
        $VADEF
        $LNMDEF
        $ACBDEF
        $ACCDEF
        $MSGDEF
        $SSDEF

        .EXTERNAL SCH$GL_CURPCB, SCH$GL_SWPPCB, SCH$GL_PCBVEC, SCH$GL_SEQ
        .EXTERNAL SCH$GQ_HIBWQ, SCH$GQ_SUSPWQ, SCH$GQ_DELQ
        .EXTERNAL SCH$REMCOM, SCH$MAKECOM, SCH$WAKEPCB, SCH$WAKE, SCH$WAIT
        .EXTERNAL SCH$SCHED, SCH$DACEFC_ALL, SGN$GW_QUANTUM
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ, MMG$CREPAG, MMG$DELPAG
        .EXTERNAL MMG$SETPRT, EXE$RMVTIMQ, EXE$USRSTART, EXE$CLISTART
        .EXTERNAL FIL$OPENFILE, FIL$OPENSHR, FIL$READIMG, RMS$RUNDOWN
        .EXTERNAL EXE$OUTZSTRING, EXE$OUTCSTRING, EXE$OUTHEX, EXE$OUTCRLF
        .EXTERNAL LNM$CREATE, LNM$DELTBL, SCH$QAST, EXE$FLUSHAST, IOC$CANCEL, SYS$EXIT
        .EXTERNAL MB$FINDNUM, MB$SEND, EXE$GQ_SYSTIME

KSTACK = 16384                          ; a process's kernel stack
BLOCK = 512                             ; an image's blocks
KW = PTE$M_VALID ! <PRT$C_KW @ PTE$V_PROT>
UR = PTE$M_VALID ! <PRT$C_UR @ PTE$V_PROT>
UW = PTE$M_VALID ! <PRT$C_UW @ PTE$V_PROT>
SR = PTE$M_VALID ! <PRT$C_SR @ PTE$V_PROT>
SW = PTE$M_VALID ! <PRT$C_SW @ PTE$V_PROT>
EW = PTE$M_VALID ! <PRT$C_EW @ PTE$V_PROT>
; Image header fields (crosstools/vtools/docs/image-format.md).
EIHD$L_SIZE = 8
EIHD$L_ISDOFF = 12
EIHD$L_ACTIVOFF = 16
EIHD$Q_IAFVA = 32
EIHD$Q_SYMVVA = 40
EIHD$L_IMGTYPE = 52
EIHD$L_LNKFLAGS = 80
EIHD$L_SYMVECT_SIZE = 96
EIHD$L_ARCH = 112
EIHD$K_EXE = 1
EIHD$K_LIM = 2                          ; a shareable image
EIHD$V_LNKNOTFR = 1
EIHD$V_PICIMG = 3                       ; it may move: its fixup section says how
EIHA$Q_TFRADR1 = 8
EISD$L_EISDSIZE = 8
EISD$L_SECSIZE = 12
EISD$Q_VIRT_ADDR = 16
EISD$L_FLAGS = 24
EISD$L_VBN = 28
EISD$V_GBL = 0
EISD$V_DZRO = 2
EISD$V_WRT = 3
EISD$V_EXE = 11
EIAF$L_QRELFIXOFF = 32                  ; the fixup section's
EIAF$L_LRELFIXOFF = 36
EIAF$L_QDOTADROFF = 40
EIAF$L_SHLSTOFF = 60
EIAF$L_SHRIMGCNT = 64
EIAF$L_LW_MAX = 88
SHL$T_IMGNAM = 24                       ; a shareable image list entry's name, .ASCIC
SHL$K_LENGTH = 64

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
EXITMSG:
        .ASCIZ  "%EXEC-W-EXITED, process "
EXITMSG2:
        .ASCIZ  " exited with status "
STDNAMES:                               ; for $CREPRC's input, output and error
        .ASCIC  "SYS$INPUT"
        .ASCIC  "SYS$OUTPUT"
        .ASCIC  "SYS$ERROR"
        .BYTE   0

        .PSECT  $CODE$

; EXE$MATCHNAME: compares the .ASCIC string at R0 with the R7 bytes at R6.
; R0 = 1 if they are the same, else 0. Uses R1.
EXE$MATCHNAME::
        .JSB_ENTRY
        CMPB    (R0)+, R7
        BNEQ    20$
        CLRL    R1
10$:    CMPL    R1, R7
        BEQL    30$
        CMPB    (R0)[R1], (R6)[R1]
        BNEQ    20$
        INCL    R1
        BRB     10$
20$:    CLRL    R0
        RSB
30$:    MOVL    #1, R0
        RSB

; COPYNAME: copies R7 bytes from R1 to R0. Uses R5.
COPYNAME:
        .JSB_ENTRY  SCRATCH=<R5>
        CLRL    R5
        BRB     20$
10$:    MOVB    (R1)[R5], (R0)[R5]
        INCL    R5
20$:    CMPL    R5, R7
        BLSSU   10$
        RSB

; EXE$PROBER_DSC: R1 = the address of a string descriptor a caller passed.
; R0 = SS$_NORMAL if the previous mode may read it and its string, else
; SS$_ACCVIO. Keeps every other register.
EXE$PROBER_DSC::
        .JSB_ENTRY
        IFNORD  #8, (R1), 90$
        PUSHL   R2
        MOVZWL  (R1), R0
        MOVL    4(R1), R2
        IFNORD  R0, (R2), 80$
        MOVL    (SP)+, R2
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    (SP)+, R2
90$:    MOVL    #SS$_ACCVIO, R0
        RSB

; EXE$NAMPID: R4 = the current PCB, R2 = a pidadr argument and R3 = a
; prcnam argument, each an address or 0. Finds the process they name: by
; PID if pidadr points at one that isn't 0, else by name among those in
; the current process's UIC group if there is prcnam, as names are a
; group's, else the current process. R1 = its PCB, R0 = SS$_NORMAL,
; SS$_NOPRIV if EXE$PRCPRIV says the current process may not touch it,
; SS$_NONEXPR, SS$_IVLOGNAM, or SS$_ACCVIO if the caller can't write
; pidadr or read prcnam. Its PID goes to pidadr. IPL$_SYNCH.
EXE$NAMPID::
        .JSB_ENTRY
        PUSHR   #^M<R5, R6, R7>
        TSTL    R2
        BEQL    20$
        IFNOWRT #4, (R2), 90$
        MOVL    (R2), R0
        BEQL    20$
        MOVZWL  R0, R1                  ; the PID's index
        CMPL    R1, #SCH$C_MAXPIX
        BGEQU   80$
        MOVL    SCH$GL_PCBVEC[R1], R1
        BEQL    80$
        CMPL    PCB$L_PID(R1), R0
        BNEQ    80$
        BRB     60$
20$:    TSTL    R3
        BNEQ    30$
        MOVL    R4, R1
        BRB     60$
30$:    MOVL    R3, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 75$
        MOVZWL  (R3), R7
        CMPL    R7, #15
        BGTRU   85$
        MOVL    4(R3), R6
        MOVL    #SCH$C_MAXPIX-1, R5
40$:    MOVL    SCH$GL_PCBVEC[R5], R1
        BEQL    50$
        CMPW    PCB$L_UIC+2(R1), PCB$L_UIC+2(R4)
        BNEQ    50$
        MOVAB   PCB$T_LNAME(R1), R0
        PUSHL   R1
        BSBW    EXE$MATCHNAME
        MOVL    (SP)+, R1
        BLBS    R0, 60$
50$:    SOBGTR  R5, 40$
        BRB     80$
60$:    BSBW    EXE$PRCPRIV
        BLBC    R0, 75$
        TSTL    R2
        BEQL    75$
        MOVL    PCB$L_PID(R1), (R2)
75$:    POPR    #^M<R5, R6, R7>
        RSB
80$:    MOVL    #SS$_NONEXPR, R0
        BRB     75$
85$:    MOVL    #SS$_IVLOGNAM, R0
        BRB     75$
90$:    MOVL    #SS$_ACCVIO, R0
        BRB     75$

; EXE$PRCPRIV: R4 = the current PCB, R1 = a PCB. R0 = SS$_NORMAL if the
; current process may touch that process, as VMS's rules say: one with
; its UIC, itself included, with GROUP one in its UIC group, with WORLD
; any; else SS$_NOPRIV. Keeps every other register.
EXE$PRCPRIV::
        .JSB_ENTRY
        MOVL    #SS$_NORMAL, R0
        CMPL    PCB$L_UIC(R1), PCB$L_UIC(R4)
        BEQL    90$
        IFPRIV  WORLD, 90$
        CMPW    PCB$L_UIC+2(R1), PCB$L_UIC+2(R4)
        BNEQ    80$
        IFPRIV  GROUP, 90$
80$:    MOVL    #SS$_NOPRIV, R0
90$:    RSB

; $CREPRC pidadr, image, input, output, error, prvadr, quota, prcnam,
; baspri, uic, mbxunt, stsflg: makes a process that runs image, called
; prcnam, at priority baspri, and puts its PID in pidadr. input, output
; and error, if given, are the equivalence strings of its process-permanent
; logical names SYS$INPUT, SYS$OUTPUT and SYS$ERROR; SS$_BADPARAM for one
; that is empty or longer than 255. It starts in its creator's default
; directory. mbxunt, if it isn't 0, is the unit number of a mailbox, MBnn,
; which gets the process's termination message when it is deleted. Its
; UIC is uic, or its creator's for 0; another one than the creator's takes
; DETACH, else SS$_NOPRIV. Its privileges, current and permanent, are those
; in the quadword prvadr points at that its creator has, or its creator's
; for 0; a creator with SETPRV gives any, and authorizes them too.
; Otherwise it has its creator's authorized privileges. quota and stsflg
; are ignored.
        .ENTRY  EXE$CREPRC, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R1
        BEQL    3$
        IFNOWRT #4, (R1), 95$
3$:     MOVAL   12(AP), R2              ; input, output, error
4$:     MOVL    (R2)+, R1
        BEQL    5$
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        TSTW    (R1)
        BEQL    87$
        CMPW    (R1), #LNM$C_NAMLENGTH
        BGTRU   87$
5$:     SUBL3   AP, R2, R0
        CMPL    R0, #24
        BLSSU   4$
        MOVL    24(AP), R1              ; prvadr
        BEQL    6$
        IFNORD  #8, (R1), 95$
6$:     MOVL    40(AP), R0              ; uic: another one takes DETACH
        BEQL    7$
        CMPL    R0, PCB$L_UIC(R4)
        BEQL    7$
        IFNPRIV DETACH, 96$
7$:     MOVL    8(AP), R6               ; the image's descriptor
        BEQL    85$
        MOVL    R6, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R6), R7
        BEQL    85$
        CMPL    R7, #39
        BGTRU   85$
        MOVL    32(AP), R3              ; the name's, or 0
        BEQL    10$
        MOVL    R3, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        CMPW    (R3), #15
        BGTRU   85$
10$:    MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R2, R8
        MOVL    #PCB$K_LENGTH/8, R0
        MOVL    R8, R1
15$:    CLRQ    (R1)+
        SOBGTR  R0, 15$
        MOVW    #PCB$K_LENGTH, PCB$W_SIZE(R8)
        MOVB    #DYN$C_PCB, PCB$B_TYPE(R8)
        MOVAB   PCB$T_IMAGE(R8), R0
        MOVB    R7, (R0)+
        MOVL    4(R6), R1
        BSBB    COPYNAME
        TSTL    R3
        BEQL    20$
        MOVZWL  (R3), R7
        MOVAB   PCB$T_LNAME(R8), R0
        MOVB    R7, (R0)+
        MOVL    4(R3), R1
        BSBB    COPYNAME
20$:    BICL3   #^C31, 36(AP), R0
        MOVB    R0, PCB$B_PRI(R8)
        MOVB    R0, PCB$B_PRIB(R8)
        MOVL    40(AP), PCB$L_UIC(R8)
        BNEQ    21$
        MOVL    PCB$L_UIC(R4), PCB$L_UIC(R8)
21$:    MOVQ    PCB$Q_AUTHPRIV(R4), PCB$Q_AUTHPRIV(R8)
        MOVQ    PCB$Q_PRIV(R4), R0
        MOVL    24(AP), R2
        BEQL    23$
        MOVQ    (R2), R0                ; prvadr's,
        IFPRIV  SETPRV, 22$
        MCOML   PCB$Q_PRIV(R4), R5      ; those of them its creator has
        BICL2   R5, R0
        MCOML   PCB$Q_PRIV+4(R4), R5
        BICL2   R5, R1
        BRB     23$
22$:    BISL2   R0, PCB$Q_AUTHPRIV(R8)  ; or all of them, authorized too
        BISL2   R1, PCB$Q_AUTHPRIV+4(R8)
23$:    MOVQ    R0, PCB$Q_PRIV(R8)
        MOVQ    R0, PCB$Q_PROCPRIV(R8)
        MNEGW   SGN$GW_QUANTUM, PCB$W_QUANT(R8)
        MOVL    PCB$L_PID(R4), PCB$L_OWNER(R8)
        MOVZWL  44(AP), PCB$L_TMBU(R8)
        PUSHR   #^M<R3, R4>                     ; the creator's default directory
        MOVC3   #64, PCB$T_DEFDIR(R4), PCB$T_DEFDIR(R8)
        POPR    #^M<R3, R4>
        MOVAB   PCB$Q_HWPCB(R8), PCB$L_HWPCB(R8)
        MOVL    #VA$C_P0BASE, PCB$L_FREP0VA(R8) ; no pages yet, should it be deleted first
        MOVL    #VA$C_P1END, PCB$L_FREP1VA(R8)
        MOVAQ   PCB$Q_ASTQFL(R8), R0    ; no ASTs, all of them enabled
        MOVL    R0, (R0)
        MOVL    R0, 4(R0)
        MOVB    #^XF, PCB$B_ASTEN(R8)
        MOVB    #^XF, PCB$Q_HWPCB+HWPCB$B_ASTEN(R8)
        BSBW    PPNAMES
        BLBC    R0, 80$
; The kernel stack, and on it the frame the PAL pops, as REI does, when
; the process first runs: PC EXE$PROCSTRT, PSL kernel mode at IPL 0.
        MOVL    #KSTACK, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, PCB$L_KSTACK(R8)
        ADDL2   #KSTACK, R2
        SUBL3   #INTSTK$K_LENGTH, R2, R1
        MOVL    R1, PCB$Q_HWPCB+HWPCB$Q_KSP(R8)
        MOVL    #INTSTK$K_LENGTH/8, R0
        MOVL    R1, R5
25$:    CLRQ    (R5)+
        SOBGTR  R0, 25$
        MOVAB   EXE$PROCSTRT, INTSTK$Q_PC(R1)
        MOVL    R2, INTSTK$Q_SP(R1)
        MOVL    R2, INTSTK$Q_X_SP(R1)
; A unique name, a slot and a PID, and on the COM queue.
        DSBINT  #IPL$_SYNCH
        TSTB    PCB$T_LNAME(R8)
        BEQL    30$
        PUSHR   #^M<R2, R4>
        CLRL    R2
        MOVL    R8, R4                  ; its name in its own group
        BSBW    EXE$NAMPID
        POPR    #^M<R2, R4>
        CMPL    R0, #SS$_NONEXPR
        BNEQ    75$
30$:    MOVL    #2, R5
35$:    TSTL    SCH$GL_PCBVEC[R5]
        BEQL    40$
        AOBLSS  #SCH$C_MAXPIX, R5, 35$
        BRB     76$
40$:    MOVL    R8, SCH$GL_PCBVEC[R5]
        INCL    SCH$GL_SEQ
        MOVZWL  SCH$GL_SEQ, R0
        ASHL    #16, R0, R0
        BISL3   R5, R0, PCB$L_PID(R8)
        PUSHL   R4
        MOVL    R8, R4
        BSBW    SCH$MAKECOM
        MOVL    (SP)+, R4
        MOVL    4(AP), R0
        BEQL    45$
        MOVL    PCB$L_PID(R8), (R0)
45$:    ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
75$:    MOVL    #SS$_DUPLNAM, R0
        BRB     77$
76$:    MOVL    #SS$_EXQUOTA, R0
77$:    ENBINT
        PUSHL   R0
        MOVL    PCB$L_KSTACK(R8), R0
        MOVL    #KSTACK, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
80$:    PUSHL   R0
        MOVAQ   PCB$Q_LNMHD(R8), R2
        BSBW    LNM$DELTBL
        MOVL    R8, R0
        MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        RET
85$:    MOVL    #SS$_IVLOGNAM, R0
90$:    RET
87$:    MOVL    #SS$_BADPARAM, R0
        RET
95$:    MOVL    #SS$_ACCVIO, R0
        RET
96$:    MOVL    #SS$_NOPRIV, R0
        RET

; PPNAMES: R8 = a new PCB, AP = $CREPRC's arguments, checked. Makes its
; logical name table, with its process-permanent names: SYS$INPUT,
; SYS$OUTPUT and SYS$ERROR, those of input, output and error it was given.
; R0 = SS$_NORMAL or SS$_INSFMEM. Uses R1, R2, R5-R7, R9 and R10.
PPNAMES:
        .JSB_ENTRY  SCRATCH=<R2, R5, R6, R7, R9, R10>
        PUSHR   #^M<R3, R8>
        MOVAQ   PCB$Q_LNMHD(R8), R5
        MOVL    R5, (R5)
        MOVL    R5, 4(R5)
        MOVAL   12(AP), R2              ; input, output, error
        MOVAB   STDNAMES, R10           ; SYS$INPUT, SYS$OUTPUT, SYS$ERROR
10$:    MOVZBL  (R10)+, R7
        BEQL    70$
        MOVL    R10, R6
        ADDL2   R7, R10
        MOVL    (R2)+, R1
        BEQL    10$
        MOVZWL  (R1), R9
        MOVL    4(R1), R8
        PUSHL   R2
        BSBW    LNM$CREATE
        MOVL    (SP)+, R2
        BLBS    R0, 10$
        BRB     80$
70$:    MOVL    #SS$_NORMAL, R0
80$:    POPR    #^M<R3, R8>
        RSB

; EXE$PROCSTRT: where a process starts, in kernel mode at IPL 0 on its
; kernel stack. Makes its stacks in P1, executive, supervisor and user,
; and activates its image. Calls a command interpreter in supervisor mode,
; at EXE$CLIENTRY, and any other image in user mode, at EXE$USRENTRY.
EXE$PROCSTRT::
        .EXCEPTION_ENTRY
        MOVL    SCH$GL_CURPCB, R4
        MOVL    #VA$C_STACKS, PCB$L_FREP1VA(R4)
        MOVL    #VA$C_STACKS, R0
        MOVL    #<VA$C_ESP-VA$C_STACKS>/MMG$C_PAGESIZE, R1
        MOVL    #EW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
        MOVL    #VA$C_ESP, R0
        MOVL    #<VA$C_SSP-VA$C_ESP>/MMG$C_PAGESIZE, R1
        MOVL    #SW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
        MOVL    #VA$C_SSP, R0
        MOVL    #<VA$C_USP-VA$C_SSP>/MMG$C_PAGESIZE, R1
        MOVL    #UW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
        MOVL    PCB$L_HWPCB(R4), R0
        MOVL    #VA$C_ESP, HWPCB$Q_ESP(R0)
        MOVL    #VA$C_SSP, HWPCB$Q_SSP(R0)
        MOVL    #VA$C_USP, HWPCB$Q_USP(R0)
        MOVL    #1, R5                  ; it may be a command interpreter
        BSBW    IMG$ACTIVATE
        BLBC    R0, 90$
        TSTL    PCB$L_CLI(R4)
        BNEQ    20$
        BRW     EXE$USRENTRY
20$:    BRW     EXE$CLIENTRY
90$:    $EXIT_S R0
        HALT                            ; $EXIT doesn't return

; EXE$USRENTRY: R4 = the current PCB, R1 = an image's transfer address.
; Calls the image in user mode, at EXE$USRSTART, on an empty user stack
; below VA$C_CLI_RESULT, which holds its command's parse. Doesn't return.
EXE$USRENTRY::
        .EXCEPTION_ENTRY
        MOVAB   EXE$USRSTART, R2
        MOVL    #<PSL$C_USER@PSL$V_CURMOD>!<PSL$C_USER@PSL$V_PRVMOD>, R3
        MOVL    #VA$C_CLI_RESULT, R5    ; below the command's parse
        BRB     REIOUT

; EXE$CLIENTRY: R4 = the current PCB, which has a command interpreter,
; R0 = the status of the image that ran last. Calls the command
; interpreter with it, in supervisor mode, at EXE$CLISTART, on an empty
; supervisor stack. Doesn't return.
EXE$CLIENTRY::
        .EXCEPTION_ENTRY
        ADDL3   #KSTACK, PCB$L_KSTACK(R4), SP   ; an empty kernel stack
CLICALL:
        MOVL    PCB$L_CLI(R4), R1
        MOVAB   EXE$CLISTART, R2
        MOVL    #<PSL$C_SUPER@PSL$V_CURMOD>!<PSL$C_SUPER@PSL$V_PRVMOD>, R3
        MOVL    #VA$C_SSP, R5
        BRB     EXE$REISP
; REIOUT: R2 = a PC, R3 = a PSL with an outer mode, R5 = that mode's stack
; pointer. Empties the kernel stack and REIs there, with R0 and R1 as they
; are.
REIOUT: .GLOBAL_LABEL
        ADDL3   #KSTACK, PCB$L_KSTACK(R4), SP

; EXE$REISP: R2 = a PC, R3 = a PSL, R5 = the stack pointer of its mode.
; REIs there on the kernel stack as it is, 16-byte aligned, with R0 and R1
; as they are, leaving what is above it there. Doesn't return.
EXE$REISP::
        .EXCEPTION_ENTRY
        SUBL2   #INTSTK$K_LENGTH, SP
        MOVL    #INTSTK$K_LENGTH/8, R6
        MOVL    SP, R7
10$:    CLRQ    (R7)+
        SOBGTR  R6, 10$
        MOVL    R2, INTSTK$Q_PC(SP)
        MOVL    R3, INTSTK$Q_PS(SP)
        MOVL    R5, INTSTK$Q_SP(SP)
        MOVL    R5, INTSTK$Q_X_SP(SP)
        EVAX_STQ R0, INTSTK$Q_R0(SP)
        EVAX_STQ R1, INTSTK$Q_R1(SP)
        REI

; NEXTISD: R8 = an image file, R10 = the offset of an EISD in its header.
; R3 = that EISD, or 0 past the last, and R10 = the next one's offset.
; Uses R0.
NEXTISD:
        .JSB_ENTRY  OUTPUT=<R3, R10>
10$:    CMPL    R10, EIHD$L_SIZE(R8)
        BGEQU   30$
        ADDL3   R8, R10, R3
        MOVL    EISD$L_EISDSIZE(R3), R0
        BEQL    30$
        CMPL    R0, #-1
        BNEQ    20$
        ADDL2   #BLOCK, R10             ; on in the next block
        BICL2   #BLOCK-1, R10
        BRB     10$
20$:    ADDL2   R0, R10
        RSB
30$:    CLRL    R3
        RSB

; IMG$ACTIVATE: R4 = the current PCB, R5 = 1 if the image may be a command
; interpreter, else 0. Activates the image the PCB names, which
; FIL$OPENFILE reads from SYS$SYSTEM: unless its name says where: maps its
; sections at their addresses, with their contents and protection. An
; image in P0 is user readable and, where it is writable, user writable,
; and the end of P0 goes past it, and past each shareable image it calls,
; which SHRACT activates after it. One from VA$C_CLI up to the stacks in P1
; is a command interpreter: supervisor readable and writable instead, P1
; starts at it, and its transfer address goes in PCB$L_CLI. R1 = the
; transfer address, R0 = SS$_NORMAL, FIL$OPENFILE's or FIL$OPENSHR's
; error, such as RMS$_FNF, SS$_BADIMGHDR, SS$_VASFULL or SS$_INSFMEM.
; ponytail: an image runs where it is linked; only shareable images move.
IMG$ACTIVATE::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        PUSHL   R5
        MOVZBL  PCB$T_IMAGE(R4), R7
        MOVAB   PCB$T_IMAGE+1(R4), R6
        BSBW    FIL$OPENFILE
        BLBC    R0, 98$
        PUSHL   R3                      ; the file's pool block, to free
        PUSHL   R1
        MOVL    R1, R8
        CMPL    (R8), #3                ; an ARM64 executable image
        BNEQ    90$
        CMPL    EIHD$L_IMGTYPE(R8), #EIHD$K_EXE
        BNEQ    90$
        CMPL    EIHD$L_ARCH(R8), #183
        BNEQ    90$
        BBS     #EIHD$V_LNKNOTFR, EIHD$L_LNKFLAGS(R8), 90$
        BSBW    RANGE
        BLBC    R0, 99$
        CMPL    R9, #VA$C_P0BASE
        BLSSU   95$
        MOVL    #UW, R6                 ; writable sections' PTE
        MOVL    #UR, R7                 ; the others'
        CMPL    R11, #VA$C_S0BASE
        BGTRU   30$
        MOVL    R11, PCB$L_FREP0VA(R4)
        BRB     35$
30$:    TSTL    8(SP)                   ; a command interpreter? R5's copy
        BEQL    95$
        CMPL    R9, #VA$C_CLI
        BLSSU   95$
        CMPL    R11, #VA$C_STACKS
        BGTRU   95$
        MOVL    R9, PCB$L_FREP1VA(R4)
        MOVL    #SW, R6
        MOVL    #SR, R7
35$:    CLRL    R2                      ; where it is linked
        BSBW    MAPISD
        BLBC    R0, 99$
; The shareable images it calls, which only an image in P0 may.
        MOVL    EIHD$Q_IAFVA(R8), R10
        BEQL    40$
        TSTL    EIAF$L_SHRIMGCNT(R10)
        BEQL    40$
        CMPL    R11, #VA$C_S0BASE
        BGTRU   90$
        BSBW    SHRLIST
        BLBC    R0, 99$
40$:    CLRL    R2
        BSBW    PROTECT
        ADDL3   R8, EIHD$L_ACTIVOFF(R8), R0
        MOVL    EIHA$Q_TFRADR1(R0), R1
        CMPL    R11, #VA$C_S0BASE
        BLEQU   65$
        MOVL    SCH$GL_CURPCB, R0       ; R4 is gone
        MOVL    R1, PCB$L_CLI(R0)
65$:    MOVL    #SS$_NORMAL, R0
99$:    MOVL    (SP)+, R2               ; the file's pool block
        MOVL    (SP)+, R3
        PUSHR   #^M<R0, R1>
        MOVL    R2, R0
        MOVL    R3, R1
        BSBW    EXE$DEANONPGDSIZ
        POPR    #^M<R0, R1>
98$:    TSTL    (SP)+                   ; R5's copy
        POPR    #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB
90$:    MOVL    #SS$_BADIMGHDR, R0
        BRB     99$
95$:    MOVL    #SS$_VASFULL, R0
        BRB     99$

; RANGE: R8 = an image file. R9 = the lowest address of its sections, R11
; the end of the highest, rounded up to a page. R0 = SS$_NORMAL, or
; SS$_BADIMGHDR for a global section or one past 4 GB.
RANGE:
        .JSB_ENTRY  OUTPUT=<R9, R11>
        PUSHR   #^M<R3, R10>
        MOVL    #-1, R9
        CLRL    R11
        MOVL    EIHD$L_ISDOFF(R8), R10
10$:    BSBW    NEXTISD
        TSTL    R3
        BEQL    80$
        BBS     #EISD$V_GBL, EISD$L_FLAGS(R3), 90$
        TSTL    EISD$Q_VIRT_ADDR+4(R3)
        BNEQ    90$
        MOVL    EISD$Q_VIRT_ADDR(R3), R0
        CMPL    R0, R9
        BGEQU   20$
        MOVL    R0, R9
20$:    ADDL2   EISD$L_SECSIZE(R3), R0
        ADDL2   #MMG$C_PAGESIZE-1, R0
        BICL2   #MMG$C_PAGESIZE-1, R0
        CMPL    R0, R11
        BLEQU   10$
        MOVL    R0, R11
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
        BRB     95$
90$:    MOVL    #SS$_BADIMGHDR, R0
95$:    POPR    #^M<R3, R10>
        RSB

; MAPISD: R8 = an image's header, from FIL$OPENFILE or FIL$OPENSHR, R2 =
; how far from where it is linked it goes. Maps each of its sections
; there, kernel writable, and reads their contents in with FIL$READIMG.
; R0 = SS$_NORMAL, MMG$CREPAG's error, or FIL$READIMG's.
MAPISD:
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6, R9, R10>
        MOVL    R2, R6
        MOVL    EIHD$L_ISDOFF(R8), R10
10$:    BSBW    NEXTISD
        TSTL    R3
        BEQL    80$
        ADDL3   R6, EISD$Q_VIRT_ADDR(R3), R0
        MOVL    EISD$L_SECSIZE(R3), R1
        ADDL2   #MMG$C_PAGESIZE-1, R1
        ASHL    #-MMG$C_VPCTX, R1, R1
        MOVL    #KW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
        BBS     #EISD$V_DZRO, EISD$L_FLAGS(R3), 10$
        MOVL    EISD$L_VBN(R3), R0      ; from the file
        MOVL    EISD$L_SECSIZE(R3), R1
        ADDL3   R6, EISD$Q_VIRT_ADDR(R3), R2
        BSBW    FIL$READIMG
        BLBC    R0, 90$
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    POPR    #^M<R2, R3, R4, R5, R6, R9, R10>
        RSB

; PROTECT: R8 = an image file, mapped R2 bytes from where it is linked,
; R6 = the PTE of its writable sections, R7 = the others'. Gives each
; section its protection, executable if it is code. Uses R0-R2.
PROTECT:
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4, R10>
        MOVL    R2, R4
        MOVL    EIHD$L_ISDOFF(R8), R10
10$:    BSBW    NEXTISD
        TSTL    R3
        BEQL    90$
        ADDL3   R4, EISD$Q_VIRT_ADDR(R3), R0
        MOVL    EISD$L_SECSIZE(R3), R1
        ADDL2   #MMG$C_PAGESIZE-1, R1
        ASHL    #-MMG$C_VPCTX, R1, R1
        MOVL    R6, R2
        BBS     #EISD$V_WRT, EISD$L_FLAGS(R3), 20$
        MOVL    R7, R2
        BBC     #EISD$V_EXE, EISD$L_FLAGS(R3), 20$
        BISL2   #PTE$M_EXEC, R2
20$:    BSBW    MMG$SETPRT
        BRB     10$
90$:    POPR    #^M<R3, R4, R10>
        RSB

; SHRLIST: R10 = the fixup section of an image in P0, mapped where it is
; linked, from R9 up. Activates each shareable image of its list, with
; SHRACT, and sets the quadwords its .ADDRESS fixups name, which the
; image calls through, to the addresses in that image's symbol vector.
; R0 = SS$_NORMAL, SHRACT's error, or SS$_BADIMGHDR.
SHRLIST:
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6, R7>
        CLRL    R7                      ; the shareable image's index
10$:    CMPL    R7, EIAF$L_SHRIMGCNT(R10)
        BGEQU   80$
        MULL3   #SHL$K_LENGTH, R7, R0
        ADDL2   EIAF$L_SHLSTOFF(R10), R0
        ADDL2   R10, R0                 ; its list entry
        BSBW    SHRACT                  ; R1 = its symbol vector, R2 = its size
        BLBC    R0, 90$
        MOVL    EIAF$L_QDOTADROFF(R10), R3
        BEQL    70$
        ADDL2   R10, R3
; A group of fixups: the count and the image's index, then each a pair:
; an offset in the image, from R9, and one in the symbol vector.
20$:    MOVL    (R3)+, R4
        BEQL    70$
        MOVL    (R3)+, R5
        CMPL    R5, R7
        BEQL    30$
        ASHL    #3, R4, R4              ; another image's
        ADDL2   R4, R3
        BRB     20$
30$:    MOVL    (R3)+, R5
        MOVL    (R3)+, R6
        CMPL    R6, R2
        BGEQU   85$
        ADDL2   R9, R5
        ADDL3   R1, R6, R0
        EVAX_LDQ R0, (R0)
        EVAX_STQ R0, (R5)
        SOBGTR  R4, 30$
        BRB     20$
70$:    INCL    R7
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    POPR    #^M<R2, R3, R4, R5, R6, R7>
        RSB
85$:    MOVL    #SS$_BADIMGHDR, R0
        BRB     90$

; SHRACT: R0 = an entry of the shareable image list of the image being
; activated in P0. Activates the shareable image it names, which
; FIL$OPENSHR reads from SYS$SHARE:, at the next 64 KB past the end of P0,
; which then goes past it: maps its sections there, moves the addresses
; it holds with RELOCATE, and gives the sections their protection, user
; readable and, where writable, user writable. R1 = the address of its
; symbol vector, R2 = the vector's size in bytes. R0 = SS$_NORMAL,
; FIL$OPENSHR's error, SS$_BADIMGHDR, SS$_VASFULL or SS$_INSFMEM.
; ponytail: each process maps its own copy, as VMS maps a shareable image
; that isn't installed; global sections and INSTALL share them. One that
; calls shareable images of its own is refused.
SHRACT:
        .JSB_ENTRY  OUTPUT=<R2>
        PUSHR   #^M<R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVZBL  SHL$T_IMGNAM(R0), R7
        MOVAB   SHL$T_IMGNAM+1(R0), R6
        BSBW    FIL$OPENSHR
        BLBC    R0, 98$
        PUSHL   R3                      ; the file's pool block, to free
        PUSHL   R1
        MOVL    R1, R8
        CMPL    (R8), #3                ; an ARM64 shareable image that moves
        BNEQ    90$
        CMPL    EIHD$L_IMGTYPE(R8), #EIHD$K_LIM
        BNEQ    90$
        CMPL    EIHD$L_ARCH(R8), #183
        BNEQ    90$
        BBC     #EIHD$V_PICIMG, EIHD$L_LNKFLAGS(R8), 90$
        TSTL    EIHD$Q_IAFVA(R8)
        BEQL    90$
        BSBW    RANGE
        BLBC    R0, 99$
        MOVL    SCH$GL_CURPCB, R4
        ADDL3   #^XFFFF, PCB$L_FREP0VA(R4), R0
        BICL2   #^XFFFF, R0             ; where it goes
        SUBL3   R9, R0, R5              ; how far it moves
        ADDL3   R5, R11, R0             ; its end
        CMPL    R0, #VA$C_S0BASE
        BGTRU   95$
        MOVL    R0, PCB$L_FREP0VA(R4)
        MOVL    R5, R2
        BSBW    MAPISD
        BLBC    R0, 99$
        ADDL3   R5, EIHD$Q_IAFVA(R8), R10       ; its fixup section, moved
        TSTL    EIAF$L_SHRIMGCNT(R10)
        BNEQ    90$
        BSBW    RELOCATE
        BLBC    R0, 99$
        MOVL    R5, R2
        MOVL    #UW, R6
        MOVL    #UR, R7
        BSBW    PROTECT
        ADDL3   R5, EIHD$Q_SYMVVA(R8), R1
        ASHL    #3, EIHD$L_SYMVECT_SIZE(R8), R2
        MOVL    #SS$_NORMAL, R0
99$:    MOVL    (SP)+, R3               ; the file's pool block
        MOVL    (SP)+, R4
        PUSHR   #^M<R0, R1, R2>
        MOVL    R3, R0
        MOVL    R4, R1
        BSBW    EXE$DEANONPGDSIZ
        POPR    #^M<R0, R1, R2>
98$:    POPR    #^M<R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB
90$:    MOVL    #SS$_BADIMGHDR, R0
        BRB     99$
95$:    MOVL    #SS$_VASFULL, R0
        BRB     99$

; RELOCATE: R10 = the fixup section of an image mapped R5 bytes from where
; it was linked, R9 = its lowest address as linked. Adds R5 to each
; address the image holds, which its relocation records name
; (crosstools/vtools/docs/image-format.md). R0 = SS$_NORMAL, or
; SS$_BADIMGHDR if a longword address would no longer fit in 31 bits.
RELOCATE:
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R6, R7, R8>
        ADDL3   R5, R9, R8              ; where the offsets count from
        TSTL    EIAF$L_LRELFIXOFF(R10)
        BEQL    10$
        ADDL3   R5, EIAF$L_LW_MAX(R10), R0
        BVS     90$
10$:    MOVL    EIAF$L_QRELFIXOFF(R10), R3
        MOVL    #8, R7
        BSBB    RECORDS
        MOVL    EIAF$L_LRELFIXOFF(R10), R3
        MOVL    #4, R7
        BSBB    RECORDS
        MOVL    #SS$_NORMAL, R0
        BRB     95$
90$:    MOVL    #SS$_BADIMGHDR, R0
95$:    POPR    #^M<R2, R3, R4, R6, R7, R8>
        RSB

; RECORDS: R3 = the offset of a list of relocation records in the fixup
; section at R10, or 0 for none, R7 = the bytes in each slot, 8 or 4, R8
; = where the image starts, R5 = how far it moved. Adds R5 to the
; quadword or longword in each slot a record's bits name. Uses R0-R4, R6.
RECORDS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R6>
        TSTL    R3
        BEQL    90$
        ADDL2   R10, R3
10$:    MOVL    (R3)+, R4               ; the bits, a multiple of 32
        BEQL    90$
        ADDL3   R8, (R3)+, R6           ; the first slot
20$:    MOVL    (R3)+, R2               ; the next 32 slots
        MOVL    #32, R1
30$:    BLBC    R2, 50$
        CMPL    R7, #8
        BEQL    40$
        ADDL2   R5, (R6)
        BRB     50$
40$:    EVAX_LDQ R0, (R6)
        EVAX_ADDQ R0, R5, R0
        EVAX_STQ R0, (R6)
50$:    ADDL2   R7, R6
        ASHL    #-1, R2, R2
        SOBGTR  R1, 30$
        SUBL2   #32, R4
        BGTR    20$
        BRB     10$
90$:    RSB

; $EXIT code: ends the image, once the caller's mode has no exit handler
; left. While it has one, takes it off its list and returns SS$_NORMAL
; with R1 = its block, for SYS$EXIT to call it in that mode
; (vms/exec/syssrv.mar); one it can't read ends the list. Else
; EXE$IMGEXIT.
        .ENTRY  EXE$EXIT, ^M<>
        BSBW    EXHLIST
        MOVL    (R0), R1
        BEQL    10$
        IFNORD  #16, (R1), 5$
        MOVL    (R1), (R0)
        MOVL    #SS$_NORMAL, R0
        RET
5$:     CLRL    (R0)
10$:    CALLG   (AP), EXE$IMGEXIT
        HALT                            ; EXE$IMGEXIT doesn't return

; EXE$IMGEXIT: $EXIT without the exit handlers, called with code: ends
; the image. In a process with a command interpreter, it runs the image
; down and calls the command interpreter with code. In one without, the
; image's end is the process's: it is deleted, and a failure status is
; reported on the console, as a command interpreter would. Either way
; code is the process's final status, which its termination message has.
; Doesn't return.
        .ENTRY  EXE$IMGEXIT, ^M<R4, R8>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), PCB$L_FINALSTS(R4)
        TSTL    PCB$L_CLI(R4)
        BEQL    5$
        MOVL    4(AP), R8
        BSBW    EXE$IMGRUNDOWN
        MOVL    R8, R0
        BRW     EXE$CLIENTRY
5$:     BLBS    4(AP), 10$
        DSBINT  #IPL$_SYNCH             ; the console, a line at a time
        MOVAB   EXITMSG, R1
        JSB     G^EXE$OUTZSTRING
        MOVAB   PCB$T_LNAME(R4), R1
        JSB     G^EXE$OUTCSTRING
        MOVAB   EXITMSG2, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    4(AP), R1
        JSB     G^EXE$OUTHEX
        JSB     G^EXE$OUTCRLF
        ENBINT
10$:    BRW     EXE$DELSELF

; $DCLEXH desblk: declares an exit handler for the caller's mode, which its
; $EXIT calls: puts desblk first on the mode's list. desblk is the
; handler's link, which the executive keeps, its address, and its argument
; list, the count, then where $EXIT writes its status, then the rest.
; SS$_NOHANDLER for desblk 0, SS$_ACCVIO if the caller can't write it.
        .ENTRY  EXE$DCLEXH, ^M<>
        MOVL    4(AP), R1
        BEQL    85$
        IFNOWRT #16, (R1), 80$
        BSBW    EXHLIST
        MOVL    4(AP), R1
        MOVL    (R0), (R1)
        MOVL    R1, (R0)
        MOVL    #SS$_NORMAL, R0
        RET
80$:    MOVL    #SS$_ACCVIO, R0
        RET
85$:    MOVL    #SS$_NOHANDLER, R0
        RET

; $CANEXH desblk: takes an exit handler $DCLEXH declared off the caller's
; mode's list, or all of them for desblk 0. SS$_NOHANDLER if it isn't
; there, or the list can't be read.
        .ENTRY  EXE$CANEXH, ^M<R2>
        BSBW    EXHLIST
        MOVL    4(AP), R1
        BNEQ    10$
        CLRL    (R0)
        BRB     30$
10$:    MOVL    (R0), R2                ; R0 = the link to R2
        BEQL    85$
        IFNOWRT #4, (R2), 85$
        CMPL    R2, R1
        BEQL    20$
        MOVL    R2, R0
        BRB     10$
20$:    MOVL    (R2), (R0)
30$:    MOVL    #SS$_NORMAL, R0
        RET
85$:    MOVL    #SS$_NOHANDLER, R0
        RET

; EXHLIST: R0 = the address of the caller's mode's exit handler list, in
; the current PCB. Uses R1.
EXHLIST:
        .JSB_ENTRY
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_PRVMOD, #2, R0, R0
        MOVL    SCH$GL_CURPCB, R1
        MOVAL   PCB$AL_EXH(R1)[R0], R0
        RSB

; EXE$IMGRUNDOWN: R4 = the current PCB. Gives back what the image that ran
; in it holds: its timer queue entries, its user mode ASTs, its pages in
; P0, its common event flag clusters, its user mode exit handlers, and its
; channels and files, all but the command interpreter's, PCB$L_CLICHANS
; and PCB$L_CLIFILES, whose I/O is cancelled first, while P0 is still
; there, and the privileges it enabled: the current ones are the
; permanent ones again. An image CTRL/Y stopped can't be continued any
; more, nor AST routines that ran.
; Uses R0-R3.
; ponytail: what the command interpreter holds too, but its channels; it
; uses nothing else yet.
EXE$IMGRUNDOWN::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        DSBINT  #IPL$_SYNCH
        BICL3   PCB$L_CLICHANS(R4), PCB$L_CHANS(R4), R0
        CLRL    R1
        BSBW    IOC$CANCEL
        ENBINT
        MOVL    PCB$L_PID(R4), R0
        MNEGL   #1, R1
        CLRL    R2
        BSBW    EXE$RMVTIMQ
        BSBB    DELP0
        DSBINT  #IPL$_SYNCH
        MOVL    #PSL$C_USER, R0
        BSBW    EXE$FLUSHAST
        ENBINT
        BSBW    SCH$DACEFC_ALL
        CLRL    PCB$AL_EXH+<4*PSL$C_USER>(R4)
        MOVQ    PCB$Q_PROCPRIV(R4), PCB$Q_PRIV(R4)
        MCOML   PCB$L_CLICHANS(R4), R0
        BICL2   R0, PCB$L_CHANS(R4)
        MOVL    PCB$L_CLIFILES(R4), R0
        BRW     RMS$RUNDOWN

; DELP0: R4 = the current PCB. Deletes the pages of its P0. Uses R0-R3.
; ponytail: every page from P0's start to its end, mapped or not; a list
; of the pages a process has if that gets slow.
DELP0:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    #VA$C_P0BASE, R0
        SUBL3   R0, PCB$L_FREP0VA(R4), R1
        BLEQ    10$
        ASHL    #-MMG$C_VPCTX, R1, R1
        BSBW    MMG$DELPAG
10$:    MOVL    #VA$C_P0BASE, PCB$L_FREP0VA(R4)
        RSB

; EXE$RUNDOWN: R4 = the current PCB. Gives back what its process holds:
; what EXE$IMGRUNDOWN does, then its other ASTs, its logical names, its
; pages in P1, its other channels and files, and its slot, unless
; $DELPRC gave that to another process already, and sends its termination
; message. Runs in the process's own context, since P0 and P1 are the
; current process's. Uses R0-R3.
EXE$RUNDOWN::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        BSBW    EXE$IMGRUNDOWN
        DSBINT  #IPL$_SYNCH
        MOVL    PCB$L_CHANS(R4), R0
        CLRL    R1
        BSBW    IOC$CANCEL
        CLRL    R0
        BSBW    EXE$FLUSHAST
        ENBINT
        MOVAQ   PCB$Q_LNMHD(R4), R2
        BSBW    LNM$DELTBL
        MOVL    PCB$L_FREP1VA(R4), R0
        SUBL3   R0, #VA$C_P1END, R1
        BLEQ    20$
        ASHL    #-MMG$C_VPCTX, R1, R1
        BSBW    MMG$DELPAG
20$:    MOVL    #VA$C_P1END, PCB$L_FREP1VA(R4)
        CLRL    PCB$L_CHANS(R4)
        CLRL    R0
        BSBW    RMS$RUNDOWN
        BSBB    TERMMSG
        DSBINT  #IPL$_SYNCH
        MOVZWL  PCB$L_PID(R4), R0
        CMPL    SCH$GL_PCBVEC[R0], R4
        BNEQ    30$
        CLRL    SCH$GL_PCBVEC[R0]
30$:    ENBINT
        RSB

; TERMMSG: R4 = the current PCB, of a process that goes. Writes its
; termination message, MSG$_DELPROC ($ACCDEF), to the mailbox whose unit
; $CREPRC's mbxunt named, if that is still there and has room for it:
; its final status, its PID, the time, and its creator's PID. Uses R0-R3.
TERMMSG:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        TSTL    PCB$L_TMBU(R4)
        BEQL    90$
        PUSHL   R5
        SUBL2   #88, SP                 ; the message, ACC$K_TERMLEN bytes
        MOVL    SP, R1
        MOVL    #22, R0
10$:    CLRL    (R1)+
        SOBGTR  R0, 10$
        MOVW    #MSG$_DELPROC, ACC$W_MSGTYP(SP)
        MOVL    PCB$L_FINALSTS(R4), ACC$L_FINALSTS(SP)
        MOVL    PCB$L_PID(R4), ACC$L_PID(SP)
        MOVQ    G^EXE$GQ_SYSTIME, ACC$Q_TERMTIME(SP)
        MOVL    PCB$L_OWNER(R4), ACC$L_OWNER(SP)
        MOVL    SP, R1
        MOVL    #ACC$K_TERMLEN, R2
        MOVL    PCB$L_PID(R4), R3
        MOVL    PCB$L_TMBU(R4), R0
        DSBINT  #IPL$_SYNCH
        BSBW    MB$FINDNUM
        TSTL    R5
        BEQL    20$                     ; gone
        BSBW    MB$SEND
20$:    ENBINT
        ADDL2   #88, SP
        MOVL    (SP)+, R5
90$:    RSB

; EXE$DELSELF: R4 = the current PCB. Deletes the current process: runs it
; down, leaves it for the swapper, which deletes its context, kernel stack
; and PCB, and gives up the CPU for good.
EXE$DELSELF::
        .EXCEPTION_ENTRY
        BSBW    EXE$RUNDOWN
        SETIPL  #IPL$_SYNCH
        CLRL    PCB$L_STATE(R4)
        INSQUE  (R4), @SCH$GQ_DELQ+4
        MOVL    SCH$GL_SWPPCB, R1
        BSBW    SCH$WAKE
        BSBW    SCH$SCHED
        HALT                            ; the CPU never comes back

; EXE$DELETEPCB: R4 = the PCB of a deleted process that isn't running.
; Deletes its context, kernel stack and PCB. Uses R0 and R1.
EXE$DELETEPCB::
        .JSB_ENTRY
        MOVL    PCB$L_HWPCB(R4), R0
        CALL_PAL #PAL$_DELCTX
        MOVL    PCB$L_KSTACK(R4), R0
        MOVL    #KSTACK, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    R4, R0
        MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        RSB

; $DELPRC pidadr, prcnam: deletes a process, the current one if none is
; named. Another one's P0 and P1 aren't the current process's, so it runs
; itself down, in a kernel mode AST, DELKAST, which ends its wait or
; suspension; it leaves its slot at once, so no one finds it any more.
; SS$_INSFMEM if there is no pool for the AST.
        .ENTRY  EXE$DELPRC, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    R1, SCH$GL_SWPPCB
        BEQL    80$
        CMPL    R1, R4
        BEQL    50$
        MOVL    R1, R4
        MOVL    #ACB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R2, R5
        MOVW    R1, ACB$W_SIZE(R5)
        MOVB    #DYN$C_ACB, ACB$B_TYPE(R5)
        CLRB    ACB$B_RMOD(R5)
        MOVL    PCB$L_PID(R4), ACB$L_PID(R5)
        MOVAB   DELKAST, ACB$L_KAST(R5)
        BICL2   #<1@PCB$V_SUSPEN>, PCB$L_STS(R4)
        CMPL    PCB$L_STATE(R4), #SCH$C_SUSP
        BNEQ    30$
        BSBW    SCH$WAKEPCB
30$:    BSBW    SCH$QAST                ; and it ends a wait
        MOVZWL  PCB$L_PID(R4), R0
        CLRL    SCH$GL_PCBVEC[R0]
        ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
50$:    ENBINT
        BRW     EXE$DELSELF
80$:    MOVL    #SS$_NOPRIV, R0
90$:    ENBINT
        RET

; DELKAST: $DELPRC's kernel mode AST. R4 = the current PCB, R5 = the ACB:
; frees it and deletes the process.
DELKAST:
        .JSB32_ENTRY                    ; doesn't return
        MOVL    R5, R0
        MOVZWL  ACB$W_SIZE(R5), R1
        BSBW    EXE$DEANONPGDSIZ
        BRW     EXE$DELSELF

; $FORCEX pidadr, prcnam, code: makes a process's image exit with code, or
; SS$_FORCEDEXIT for 0, as if it called $EXIT: queues it a user mode AST
; whose routine is SYS$EXIT, which comes when the image next runs in user
; mode, and ends its wait if it waits. Not while CTRL/Y has it stopped,
; but after CONTINUE. SS$_INSFMEM if there is no pool for the AST.
        .ENTRY  EXE$FORCEX, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    R1, SCH$GL_SWPPCB
        BEQL    80$
        MOVL    R1, R4
        MOVL    #ACB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R2, R5
        MOVW    R1, ACB$W_SIZE(R5)
        MOVB    #DYN$C_ACB, ACB$B_TYPE(R5)
        MOVB    #PSL$C_USER, ACB$B_RMOD(R5)
        MOVL    PCB$L_PID(R4), ACB$L_PID(R5)
        MOVAB   G^SYS$EXIT, ACB$L_AST(R5)
        MOVL    12(AP), ACB$L_ASTPRM(R5)
        BNEQ    20$
        MOVL    #SS$_FORCEDEXIT, ACB$L_ASTPRM(R5)
20$:    CLRL    ACB$L_KAST(R5)
        BSBW    SCH$QAST
        BRB     90$
80$:    MOVL    #SS$_NOPRIV, R0
90$:    ENBINT
        RET

; $HIBER: sleeps until a $WAKE, or returns at once if one came since the
; last $HIBER.
        .ENTRY  EXE$HIBER, ^M<R4>
        MOVL    SCH$GL_CURPCB, R4
        DSBINT  #IPL$_SYNCH
10$:    BBCC    #PCB$V_WAKEPEN, PCB$L_STS(R4), 20$
        ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
20$:    MOVL    #SCH$C_HIB, PCB$L_STATE(R4)
        MOVAQ   SCH$GQ_HIBWQ, R0
        BSBW    SCH$WAIT
        BRB     10$

; $WAKE pidadr, prcnam: wakes a hibernating process.
        .ENTRY  EXE$WAKE, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        BSBW    SCH$WAKE
90$:    ENBINT
        RET

; $SUSPND pidadr, prcnam, flags: suspends a process until a $RESUME. One
; that waits is suspended when its wait ends.
        .ENTRY  EXE$SUSPND, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    R1, SCH$GL_SWPPCB
        BEQL    80$
        CMPL    R1, R4
        BEQL    40$
        CMPL    PCB$L_STATE(R1), #SCH$C_COM
        BEQL    30$
        CMPL    PCB$L_STATE(R1), #SCH$C_SUSP
        BEQL    90$
        BBSS    #PCB$V_SUSPEN, PCB$L_STS(R1), 90$
        BRB     90$
30$:    PUSHL   R4
        MOVL    R1, R4
        BSBW    SCH$REMCOM
        BSBB    SUSPEND
        MOVL    (SP)+, R4
        BRB     90$
40$:    BSBB    SUSPEND
        BSBW    SCH$SCHED
        MOVL    #SS$_NORMAL, R0
90$:    ENBINT
        RET
80$:    MOVL    #SS$_NOPRIV, R0
        BRB     90$

SUSPEND:
        .JSB_ENTRY
        MOVL    #SCH$C_SUSP, PCB$L_STATE(R4)
        INSQUE  (R4), @SCH$GQ_SUSPWQ+4
        RSB

; $RESUME pidadr, prcnam: resumes a suspended process.
        .ENTRY  EXE$RESUME, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    PCB$L_STATE(R1), #SCH$C_SUSP
        BEQL    20$
        BBCC    #PCB$V_SUSPEN, PCB$L_STS(R1), 90$
        BRB     90$
20$:    MOVL    R1, R4
        BSBW    SCH$WAKEPCB
90$:    ENBINT
        RET

; $SETPRI pidadr, prcnam, pri, prvpri: sets a process's priority, base and
; current, and puts the old base priority in prvpri.
        .ENTRY  EXE$SETPRI, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        MOVL    16(AP), R0
        BEQL    10$
        IFNOWRT #4, (R0), 85$
        MOVZBL  PCB$B_PRIB(R1), (R0)
10$:    BICL3   #^C31, 12(AP), R5
        MOVB    R5, PCB$B_PRIB(R1)
        CMPL    PCB$L_STATE(R1), #SCH$C_COM
        BNEQ    20$
        PUSHL   R4
        MOVL    R1, R4
        BSBW    SCH$REMCOM
        MOVB    R5, PCB$B_PRI(R4)
        BSBW    SCH$MAKECOM
        MOVL    (SP)+, R4
        BRB     30$
20$:    MOVB    R5, PCB$B_PRI(R1)
        CMPL    R1, R4
        BNEQ    30$
        SOFTINT #IPL$_RESCHED           ; lower now: maybe another runs first
30$:    MOVL    #SS$_NORMAL, R0
90$:    ENBINT
        RET
85$:    MOVL    #SS$_ACCVIO, R0
        BRB     90$

; $SETPRN prcnam: renames the current process. SS$_DUPLNAM if another in
; its UIC group has that name.
        .ENTRY  EXE$SETPRN, ^M<R2, R3, R4, R5, R6, R7>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R3
        BEQL    85$
        MOVL    R3, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 95$
        MOVZWL  (R3), R7
        CMPL    R7, #15
        BGTRU   85$
        DSBINT  #IPL$_SYNCH
        CLRL    R2
        BSBW    EXE$NAMPID
        CMPL    R0, #SS$_NONEXPR
        BEQL    10$
        CMPL    R1, R4
        BNEQ    80$
10$:    MOVAB   PCB$T_LNAME(R4), R0
        MOVB    R7, (R0)+
        MOVL    4(R3), R1
        BSBW    COPYNAME
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_DUPLNAM, R0
90$:    ENBINT
        RET
85$:    MOVL    #SS$_IVLOGNAM, R0
95$:    RET

; $CMKRNL routin, arglst: calls routin in kernel mode with arglst.
; SS$_NOPRIV without CMKRNL.
        .ENTRY  EXE$CMKRNL, ^M<>
        MOVL    SCH$GL_CURPCB, R0
        IFNPRIV CMKRNL, 90$, R0
        CALLG   @8(AP), @4(AP)
        RET
90$:    MOVL    #SS$_NOPRIV, R0
        RET

; $SETPRV enbflg, prvadr, prmflg, prvprv: enables the privileges in the
; quadword prvadr points at, for enbflg 1, or disables them, for 0: the
; current ones, which go back to the permanent ones when the image exits,
; and the permanent ones too for prmflg 1. Without SETPRV it enables only
; those authorized, and says SS$_NOTALLPRIV if that is fewer. prvprv, if
; given, gets the privileges there were: the permanent ones for prmflg 1,
; else the current ones.
        .ENTRY  EXE$SETPRV, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        CLRQ    R2                      ; the mask
        MOVL    8(AP), R1
        BEQL    5$
        IFNORD  #8, (R1), 95$
        MOVQ    (R1), R2
5$:     MOVL    16(AP), R0
        BEQL    10$
        IFNOWRT #8, (R0), 95$
        MOVAQ   PCB$Q_PRIV(R4), R1
        BLBC    12(AP), 7$
        MOVAQ   PCB$Q_PROCPRIV(R4), R1
7$:     MOVQ    (R1), (R0)
10$:    MOVL    #SS$_NORMAL, R5
        BLBS    4(AP), 20$
        BICL2   R2, PCB$Q_PRIV(R4)
        BICL2   R3, PCB$Q_PRIV+4(R4)
        BLBC    12(AP), 90$
        BICL2   R2, PCB$Q_PROCPRIV(R4)
        BICL2   R3, PCB$Q_PROCPRIV+4(R4)
        BRB     90$
20$:    IFPRIV  SETPRV, 30$
        MCOML   PCB$Q_AUTHPRIV(R4), R0  ; those not authorized
        MCOML   PCB$Q_AUTHPRIV+4(R4), R1
        BITL    R0, R2
        BNEQ    25$
        BITL    R1, R3
        BEQL    30$
25$:    MOVL    #SS$_NOTALLPRIV, R5
        BICL2   R0, R2
        BICL2   R1, R3
30$:    BISL2   R2, PCB$Q_PRIV(R4)
        BISL2   R3, PCB$Q_PRIV+4(R4)
        BLBC    12(AP), 90$
        BISL2   R2, PCB$Q_PROCPRIV(R4)
        BISL2   R3, PCB$Q_PROCPRIV+4(R4)
90$:    MOVL    R5, R0
        RET
95$:    MOVL    #SS$_ACCVIO, R0
        RET

; $IMGACT image, cmdlin: runs image in the current process, as a command
; interpreter does: runs down the image there was, keeping the channels
; and files the process has now, activates image in P0 and calls it in
; user mode, with cmdlin, the result block of its command's parse
; (ADR-0017), if there is one, at VA$C_CLI_RESULT, where CLI$PRESENT and
; CLI$GET_VALUE find it. An image CTRL/Y stopped is run down too, and the
; command interpreter's CTRL/Y AST forgotten. Returns only if the
; activation fails, with its status; SS$_IVLOGNAM for a name longer than
; 39 characters, SS$_BADPARAM for a block longer than VA$C_CLI_RESMAX.
; When the image exits, the command interpreter is called again with its
; status, on an empty supervisor stack, which the image leaves alone
; meanwhile.
; ponytail: VMS's $IMGACT only activates, and the command interpreter
; calls the image itself, whose CLI$ routines read the parse in DCL's
; pages.
        .ENTRY  EXE$IMGACT, ^M<R2, R3, R4, R5, R6, R7, R8>
        MOVL    4(AP), R6
        BEQL    85$
        MOVL    R6, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R6), R7
        BEQL    85$
        CMPL    R7, #39
        BGTRU   85$
        CLRL    R8                      ; the command line, if any
        CMPB    (AP), #2
        BLSSU   10$
        MOVL    8(AP), R8
        BEQL    10$
        MOVL    R8, R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        CMPW    (R8), #VA$C_CLI_RESMAX
        BGTRU   87$
; Both before P0, which may hold them, goes. The user stack starts below
; the parse.
10$:    MOVL    SCH$GL_CURPCB, R4
        MOVAB   PCB$T_IMAGE(R4), R0
        MOVB    R7, (R0)+
        MOVL    4(R6), R1
        BSBW    COPYNAME
        CLRW    @#VA$C_CLI_RESULT
        TSTL    R8
        BEQL    20$
        MOVC3   (R8), @4(R8), @#VA$C_CLI_RESULT
20$:    MOVL    SCH$GL_CURPCB, R4
        BBS     #PSL$C_SUPER, PCB$B_ASTACT(R4), 25$     ; after CTRL/Y, what it had when its image ran
        MOVL    PCB$L_CHANS(R4), PCB$L_CLICHANS(R4)
        MOVL    PCB$L_FILES(R4), PCB$L_CLIFILES(R4)
25$:    BSBW    EXE$IMGRUNDOWN
        CLRL    R5                      ; P0 only
        BSBW    IMG$ACTIVATE
        BLBC    R0, 80$
        MOVL    PCB$L_HWPCB(R4), R2
        MOVL    #VA$C_SSP, HWPCB$Q_SSP(R2)
        BRW     EXE$USRENTRY
80$:    MOVL    R0, R6
        BSBW    DELP0
        MOVL    R6, R0
        RET
85$:    MOVL    #SS$_IVLOGNAM, R0
        RET
87$:    MOVL    #SS$_BADPARAM, R0
90$:    RET

        .END
