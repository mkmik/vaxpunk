        .TITLE  F11WRT  Files-11 writes: headers, blocks, directories, INITIALIZE
        .IDENT  /V0.1/
;
; What VMS's XQP does when files are written, on F11$GL_VCB's volume
; (f11.mar), which must be on a disk that can be written, DKB0: or MDA0::
; a new file gets a header from the index file bitmap, blocks from the
; storage bitmap (crosstools/ods/docs/bitmap.md), with a map pointer for each run of
; them, and an entry in a directory (crosstools/ods/docs/directory.md); deleting it
; gives all three back. FIL$MKDIR makes a directory the same way. FIL$INIT, which $INIT_VOL calls, writes an empty
; volume, laid out as INITIALIZE does (crosstools/ods/docs/initialize.md). RMS
; (rms.mar) calls these holding FIL$LOCK, as it calls f11.mar's. A new
; file is its creator's, with VMS's default protection, FILEPROT; a new
; directory takes its parent's, which no one may delete.
; RMS's $CREATE gives a new version its predecessor's instead.
; ponytail: no process default protection, SET PROTECTION/DEFAULT. The
; bitmaps are as many blocks as the home block and BITMAP.SYS say, each
; contiguous, and a bit of the storage bitmap is a cluster; the index
; file doubles when it fills, up to the volume's maximum files, as its
; map allows; map pointers are format 2, and a directory is rewritten
; whole on each change.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $IPLDEF
        $SSDEF
        $VCBDEF
        $PCBDEF
        $PRVDEF
        $INITDEF
        $ARMDEF
        $PALDEF

        .EXTERNAL F11$GL_VCB, F11$AB_DIRBLK, EXE$GQ_SYSTIME, MD$GL_BLOCKS
        .EXTERNAL FIL$READLBLK, FIL$WRITELBLK, FIL$READVBN, FIL$WRITEVBN
        .EXTERNAL FIL$READHDR, FIL$MAPVBN, FIL$EOF, FIL$SELECT, MD$CREATE
        .EXTERNAL FIL$LOCK, FIL$UNLOCK, FIL$CHKPRO, SCH$GL_CURPCB
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ

BLOCK = 512
BITS = BLOCK*8                          ; in a bitmap block
MFD = 4
MAXVER = 32767
MAXRUN = 16384                          ; blocks a format 2 pointer maps
HEADERS = 16                            ; headers INITIALIZE makes room for, VMS's /HEADERS
MAXVOL = ^X7F000000                     ; blocks FIL$INIT uses at most
; A file header (crosstools/ods/docs/file-header.md).
FH2$B_IDOFFSET = 0
FH2$B_MPOFFSET = 1
FH2$B_ACOFFSET = 2
FH2$B_RSOFFSET = 3
FH2$W_STRUCLEV = 6
FH2$W_FID = 8
FH2$W_FID_SEQ = 10
FH2$B_FID_NMX = 13
FH2$W_RECATTR = 20
FH2$L_FILECHAR = 52
FH2$B_MAP_INUSE = 58
FH2$L_FILEOWNER = 60
FH2$W_FILEPROT = 64
FH2$W_BACKLINK = 66
FH2$W_CHECKSUM = 510
FCH$V_MARKDEL = 15
FCH$M_CONTIG = ^X80
FCH$M_DIRECTORY = ^X2000
IDOFFSET = 40                           ; words: the ident area, then the map
MPOFFSET = 100
FI2$T_FILENAME = 0                      ; in the ident area
FI2$W_REVISION = 20
FI2$Q_CREDATE = 22
FI2$Q_REVDATE = 30
FI2$T_FILENAMEXT = 54
; Its record attributes.
FAT$B_RTYPE = FH2$W_RECATTR+0
FAT$B_RATTRIB = FH2$W_RECATTR+1
FAT$W_RSIZE = FH2$W_RECATTR+2
FAT$L_HIBLK = FH2$W_RECATTR+4           ; high word first
FAT$L_EFBLK = FH2$W_RECATTR+8           ; high word first
FH2$L_HIGHWATER = 76                    ; VBN + 1 of the highest block written
FAT$W_FFBYTE = FH2$W_RECATTR+12
FAT$W_MAXREC = FH2$W_RECATTR+16
FAT$W_VERSIONS = FH2$W_RECATTR+30       ; a directory's default version limit
FILEPROT = ^XFA00                       ; S:RWED,O:RWED,G:RE,W:
MFDPROT = ^XAA88                        ; S:RWE,O:RWE,G:RE,W:RE
HM2$W_ALTIDXVBN = 20                    ; the home block: the backup index file header's VBN
HM2$W_IBMAPVBN = 22
HM2$L_VOLOWNER = 44
HM2$W_PROTECT = 52
HM2$W_FILEPROT = 54
HM2$W_CHECKSUM1 = 58                    ; the sum of the words before it
HM2$T_VOLNAME = 472
HM2$T_FORMAT = 496
HM2$W_CHECKSUM2 = 510
RECSIZE = 20                            ; a RESFILES row

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
BITBLK: .BLKB   BLOCK                   ; a bitmap block, or the home block
SBNUM:  .LONG   0                       ; the storage bitmap's block in it
IBNUM:  .LONG   0                       ; or the index file bitmap's
NEWHDR: .BLKB   BLOCK                   ; a header FIL$INIT makes
ZEROS:  .BLKB   BLOCK                   ; an index file block not yet used
RECBUF: .BLKB   BLOCK+8                 ; a directory record being made, one entry too long at most
DU_MODE:                                ; DIRUPD's: 0 enter, 1 remove, 2 set the version limit
        .LONG   0
DU_LIMIT:                               ; a new record's version limit: its name's, or the directory's default
        .LONG   0
DU_NAME:                                ; the name, NAME.TYPE, and its length
        .LONG   0, 0
DU_VER: .LONG   0                       ; the version
DU_FID: .BLKW   4                       ; the file ID, after the version
DU_DONE:                                ; 1 once the name's record is written
        .LONG   0
DU_PEND:                                ; 1 if the version is below the name's record's
        .LONG   0
DU_LAST:                                ; the record EMIT appended last
        .LONG   0
DU_OUT: .LONG   0, 0                    ; the directory being made: pool, its size
DU_POS: .LONG   0                       ; the next byte of it
LABEL:  .BLKB   12                      ; FIL$INIT's label, padded with blanks
VOLSIZE:                                ; and the volume's size in blocks
        .LONG   0
INDEXF: .LONG   0                       ; INDEXF.SYS's blocks
VOLOWNER:                               ; its owner and protection
        .LONG   0
VOLPROT:
        .LONG   0
; The reserved files: name, record type and attributes, record size,
; characteristics, first LBN and blocks, which FIL$INIT fills in for
; INDEXF.SYS, BITMAP.SYS and the MFD.
RESFILES:
        .ASCII  "INDEXF.SYS"
        .BYTE   1, 0
        .WORD   512, 0, 0, 0
        .ASCII  "BITMAP.SYS"
        .BYTE   1, 0
        .WORD   512, FCH$M_CONTIG, 0, 0
        .ASCII  "BADBLK.SYS"
        .BYTE   1, 0
        .WORD   512, 0, 0, 0
        .ASCII  "000000.DIR"
        .BYTE   2, 8
        .WORD   512, FCH$M_CONTIG!FCH$M_DIRECTORY, 0, 0
        .ASCII  "CORIMG.SYS"
        .BYTE   1, 0
        .WORD   512, 0, 0, 0
        .ASCII  "VOLSET.SYS"
        .BYTE   1, 0
        .WORD   64, 0, 0, 0
        .ASCII  "CONTIN.SYS"
        .BYTE   1, 0
        .WORD   512, 0, 0, 0
        .ASCII  "BACKUP.SYS"
        .BYTE   1, 0
        .WORD   64, 0, 0, 0
        .ASCII  "BADLOG.SYS"
        .BYTE   1, 0
        .WORD   16, 0, 0, 0
RESEND:
FORMAT: .ASCII  "DECFILE11B  "

        .PSECT  $CODE$

; CHECKSUM: R1 = a block, R2 = a word count. R0 = the sum of its first R2
; words, a word. Uses R3.
CHECKSUM:
        .JSB_ENTRY  SCRATCH=<R3>
        CLRL    R0
        CLRL    R3
10$:    ADDW2   (R1)[R3], R0
        AOBLSS  R2, R3, 10$
        MOVZWL  R0, R0
        RSB

; FIL$WRITEHDR: R1 = a file header. Writes it, with its checksum, in its
; file's slot of F11$GL_VCB's index file. R0 = SS$_NORMAL or the disk's
; error. Holding FIL$LOCK. Keeps every other register.
FIL$WRITEHDR::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3>
        MOVL    #255, R2
        BSBB    CHECKSUM
        MOVW    R0, FH2$W_CHECKSUM(R1)
        BSBB    HDRVBN
        MOVL    R1, R2
        MOVL    #1, R1
        BSBW    FIL$WRITEVBN
        POPR    #^M<R1, R2, R3>
        RSB

; HDRVBN: R1 = a file header. R0 = its slot's VBN in the index file, R3 =
; the index file's header.
HDRVBN:
        .JSB_ENTRY  SCRATCH=<R3>
        MOVZBL  FH2$B_FID_NMX(R1), R0
        ASHL    #16, R0, R0
        MOVW    FH2$W_FID(R1), R0
        MOVL    F11$GL_VCB, R3
        ADDL2   VCB$L_HDRVBN(R3), R0
        DECL    R0
        MOVAB   VCB$AB_INDEXF(R3), R3
        RSB

; BITMAP: R0 = 0 to read the index file bitmap's block IBNUM into
; BITBLK, 1 to write it from there, 2 and 3 the same for the storage
; bitmap's block SBNUM. R0 = SS$_NORMAL or the disk's error. Keeps every
; other register.
BITMAP:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2>
        MOVL    F11$GL_VCB, R2
        BBS     #1, R0, 10$
        ADDL3   IBNUM, VCB$L_IBMAPLBN(R2), R2
        BRB     20$
10$:    ADDL3   SBNUM, VCB$L_SBMAPLBN(R2), R2
20$:    MOVL    #1, R1
        BLBS    R0, 30$
        MOVAB   BITBLK, R0
        BSBW    FIL$READLBLK
        BRB     40$
30$:    MOVAB   BITBLK, R0
        BSBW    FIL$WRITELBLK
40$:    POPR    #^M<R1, R2>
        RSB

; EMPTYHDR: R1 = a buffer, R2 = a file number, R3 = a sequence number.
; Makes an empty header there for the file: no blocks, no name, owned by
; the current process's UIC, with FILEPROT, in the MFD, made and revised
; now. Uses R0-R5.
EMPTYHDR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R1, R2, R3>
        MOVC5   #0, (R1), #0, #BLOCK, (R1)
        POPR    #^M<R1, R2, R3>
        MOVB    #IDOFFSET, FH2$B_IDOFFSET(R1)
        MOVB    #MPOFFSET, FH2$B_MPOFFSET(R1)
        MOVB    #255, FH2$B_ACOFFSET(R1)
        MOVB    #255, FH2$B_RSOFFSET(R1)
        MOVW    #^X0201, FH2$W_STRUCLEV(R1)
        MOVW    R2, FH2$W_FID(R1)
        MOVW    R3, FH2$W_FID_SEQ(R1)
        ASHL    #-16, R2, R2
        MOVB    R2, FH2$B_FID_NMX(R1)
        MOVL    SCH$GL_CURPCB, R0
        MOVL    PCB$L_UIC(R0), FH2$L_FILEOWNER(R1)
        MOVW    #FILEPROT, FH2$W_FILEPROT(R1)
        MOVW    #MFD, FH2$W_BACKLINK(R1)
        MOVW    #MFD, FH2$W_BACKLINK+2(R1)
        MOVAB   IDOFFSET*2(R1), R2
        MOVW    #1, FI2$W_REVISION(R2)
        MOVQ    EXE$GQ_SYSTIME, FI2$Q_CREDATE(R2)
        MOVQ    EXE$GQ_SYSTIME, FI2$Q_REVDATE(R2)
        RSB

; FIL$SETNAME: R1 = a file header, R6 = a name, NAME.TYPE, R7 = its
; length, R4 = a version. Puts NAME.TYPE;VERSION in the header's ident
; area, padded with blanks. Keeps every register.
FIL$SETNAME::
        .JSB_ENTRY
        PUSHR   #^M<R0, R2, R3, R5, R6, R7, R8>
        MOVAB   IDOFFSET*2(R1), R8
        CLRL    R2                      ; the characters written
        CLRL    R3
10$:    CMPL    R3, R7
        BGEQU   20$
        MOVZBL  (R6)[R3], R0
        BSBB    PUTNAME
        INCL    R3
        BRB     10$
20$:    MOVZBL  #59, R0                 ; a semicolon, then the version
        BSBB    PUTNAME
        CLRL    R5                      ; its digits, on the stack
        MOVL    R4, R6
25$:    DIVL3   #10, R6, R7
        MULL3   #10, R7, R0
        SUBL3   R0, R6, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R5
        MOVL    R7, R6
        BNEQ    25$
30$:    MOVL    (SP)+, R0
        BSBB    PUTNAME
        SOBGTR  R5, 30$
35$:    CMPL    R2, #86                 ; the rest blank
        BGEQU   38$
        MOVZBL  #^A/ /, R0
        BSBB    PUTNAME
        BRB     35$
38$:    POPR    #^M<R0, R2, R3, R5, R6, R7, R8>
        RSB

; PUTNAME: R8 = a header's ident area, R0 = the R2th character of the
; name, which goes in FI2$T_FILENAME, the first 20, or FI2$T_FILENAMEXT.
; R2 = the next one's.
PUTNAME:
        .JSB_ENTRY  OUTPUT=<R2>
        CMPL    R2, #20
        BGEQU   45$
        MOVB    R0, FI2$T_FILENAME(R8)[R2]
        BRB     48$
45$:    MOVB    R0, FI2$T_FILENAMEXT-20(R8)[R2]
48$:    INCL    R2
        RSB

; FIL$CREHDR: R1 = a buffer. Takes the first free file number from the
; index file bitmap, and makes an empty header for it in the buffer, with
; the next sequence number for its slot; FIL$WRITEHDR writes it. R0 =
; SS$_NORMAL, SS$_IDXFILEFULL if the volume's maximum files are all in
; use, or the disk's error. Holding FIL$LOCK. Keeps every other register.
FIL$CREHDR::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4, R5, R6>
        MOVL    R1, R6
        MOVL    F11$GL_VCB, R5
        CLRL    IBNUM                   ; each bitmap block
5$:     MOVL    #SS$_IDXFILEFULL, R0
        CMPL    IBNUM, VCB$L_IBMAPBLKS(R5)
        BGEQU   90$
        CLRL    R0
        BSBB    BITMAP
        BLBC    R0, 90$
        CLRL    R2                      ; its bit for file R4 + 1
10$:    MULL3   #BITS, IBNUM, R4
        ADDL2   R2, R4
        CMPL    R4, VCB$L_MAXFILES(R5)
        BGEQU   80$
        BBC     R2, BITBLK, 20$
        AOBLSS  #BITS, R2, 10$
        INCL    IBNUM
        BRB     5$
20$:    ADDL3   VCB$L_HDRVBN(R5), R4, R0        ; its slot, in the index file?
        MOVAB   VCB$AB_INDEXF(R5), R1
        BSBW    FIL$MAPVBN
        TSTL    R1
        BNEQ    25$
        BSBW    EXTINDEX                ; not yet: it grows, and the
        BLBC    R0, 90$                 ; storage bitmap took BITBLK
        BRB     5$
25$:    ADDL3   VCB$L_HDRVBN(R5), R4, R0        ; past the end of file?
        MOVAB   VCB$AB_INDEXF(R5), R3
        ROTL    #16, FAT$L_EFBLK(R3), R1
        CMPL    R0, R1
        BLSSU   27$
        ADDL3   #1, R0, R1              ; it moves past the slot
        BSBW    SETEOF
        BSBW    WRITEIDX
        BLBC    R0, 90$
27$:    ADDL3   VCB$L_HDRVBN(R5), R4, R0        ; what was in it
        MOVL    #1, R1
        MOVL    R6, R2
        MOVAB   VCB$AB_INDEXF(R5), R3
        BSBW    FIL$READVBN
        BLBC    R0, 90$
        MOVZWL  FH2$W_FID_SEQ(R6), R3
        INCW    R3
        BNEQ    30$
        INCW    R3
30$:    MULL3   #BITS, IBNUM, R0
        SUBL3   R0, R4, R0
        BBSS    R0, BITBLK, 35$
35$:    MOVL    #1, R0
        BSBW    BITMAP
        BLBC    R0, 90$
        MOVL    R6, R1
        ADDL3   #1, R4, R2
        BSBW    EMPTYHDR
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_IDXFILEFULL, R0
90$:    POPR    #^M<R1, R2, R3, R4, R5, R6>
        RSB

; EXTINDEX: R5 = a VCB. Extends its index file by as many blocks as it
; has, but not past the slot of the volume's last file, VCB$L_MAXFILES,
; with zeros, headers no file has yet, and its end of file past them, and
; writes its header and the header's backup. If the volume hasn't that
; many blocks free, it takes those it has. R0 = SS$_NORMAL, or, if it
; got none, FIL$EXTEND's error, or the disk's. Holding FIL$LOCK. Keeps
; every other register.
EXTINDEX:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4>
        MOVAB   VCB$AB_INDEXF(R5), R3
        BSBW    GETHIBLK
        MOVL    R0, R4                  ; the blocks it has
        ADDL3   VCB$L_HDRVBN(R5), VCB$L_MAXFILES(R5), R1
        DECL    R1                      ; the last file's slot
        SUBL2   R0, R1
        CMPL    R1, R0
        BLEQU   5$
        MOVL    R0, R1
5$:     BSBW    FIL$EXTEND
        PUSHL   R0                      ; how that went
        BSBW    GETHIBLK
        CMPL    R0, R4
        BEQL    80$                     ; no blocks at all
10$:    INCL    R4
        BSBW    GETHIBLK
        CMPL    R4, R0
        BGTRU   20$
        MOVL    R4, R0
        MOVL    #1, R1
        MOVAB   ZEROS, R2
        BSBW    FIL$WRITEVBN
        BLBC    R0, 85$
        BRB     10$
20$:    ADDL3   #1, R0, R1              ; the end of file: past the last block
        BSBW    SETEOF
        BSBW    WRITEIDX
        BLBC    R0, 85$
        MOVL    #SS$_NORMAL, (SP)       ; some blocks: enough for now
80$:    MOVL    (SP)+, R0
        BRB     90$
85$:    TSTL    (SP)+
90$:    POPR    #^M<R1, R2, R3, R4>
        RSB

; SETEOF: R3 = the index file's header, R1 = a VBN. Makes it the end of
; file, and the highwater mark if that is below. Keeps every register.
SETEOF:
        .JSB_ENTRY
        ROTL    #16, R1, FAT$L_EFBLK(R3)
        CLRW    FAT$W_FFBYTE(R3)
        CMPL    FH2$L_HIGHWATER(R3), R1
        BGEQU   10$
        MOVL    R1, FH2$L_HIGHWATER(R3)
10$:    RSB

; WRITEIDX: R5 = a VCB. Writes its index file's header, and the header's
; backup, at VBN 3v+1. R0 = SS$_NORMAL or the disk's error. Keeps every
; other register.
WRITEIDX:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3>
        MOVAB   VCB$AB_INDEXF(R5), R1
        BSBW    FIL$WRITEHDR
        BLBC    R0, 90$
        MOVZWL  VCB$W_CLUSTER(R5), R0
        MULL2   #3, R0
        INCL    R0
        MOVL    #1, R1
        MOVAB   VCB$AB_INDEXF(R5), R2
        MOVL    R2, R3
        BSBW    FIL$WRITEVBN
90$:    POPR    #^M<R1, R2, R3>
        RSB

; ALLOCBLK: R1 = a block count. Takes the first run of free clusters from
; the storage bitmap, a set bit each, enough for R1 blocks at most, and
; no more than a map pointer maps: R2 = its first LBN, R1 = its blocks,
; whole clusters, less VCB$L_FREE once counted. R0 = SS$_NORMAL,
; SS$_DEVICEFULL if none is free, or the disk's error. Uses R3.
ALLOCBLK:
        .JSB_ENTRY  OUTPUT=<R2>, SCRATCH=<R3>
        PUSHR   #^M<R4, R5, R6>
        MOVL    F11$GL_VCB, R6
        MOVZWL  VCB$W_CLUSTER(R6), R5   ; R5 = the cluster
        ADDL3   R5, R1, R4              ; R4 = the clusters wanted
        DECL    R4
        DIVL2   R5, R4
        DIVL3   R5, #MAXRUN, R0
        CMPL    R4, R0
        BLEQU   3$
        MOVL    R0, R4
3$:     CLRL    SBNUM                   ; each bitmap block
5$:     MOVL    #SS$_DEVICEFULL, R0
        CMPL    SBNUM, VCB$L_SBMAPBLKS(R6)
        BGEQU   90$
        MOVL    #2, R0
        BSBW    BITMAP
        BLBC    R0, 90$
        CLRL    R2                      ; a set bit is a free cluster
10$:    BBS     R2, BITBLK, 20$
        AOBLSS  #BITS, R2, 10$
        INCL    SBNUM
        BRB     5$
20$:    MOVL    R2, R3
        CLRL    R1                      ; the run
30$:    BBCC    R3, BITBLK, 40$
        INCL    R1
        INCL    R3
        CMPL    R1, R4
        BGEQU   40$
        CMPL    R3, #BITS
        BLSSU   30$
40$:    MOVL    #3, R0
        BSBW    BITMAP
        MULL3   #BITS, SBNUM, R3        ; in blocks
        ADDL2   R3, R2
        MULL2   R5, R2
        MULL2   R5, R1
        BLBC    R0, 85$
        TSTL    VCB$L_FREE(R6)
        BLSS    90$
        SUBL2   R1, VCB$L_FREE(R6)
        BRB     90$
85$:    MNEGL   #1, VCB$L_FREE(R6)      ; counted again next time
90$:    POPR    #^M<R4, R5, R6>
        RSB

; FREEBLK: R1 = a block count, R2 = an LBN, whole clusters. Gives them
; back to the storage bitmap, and to VCB$L_FREE once counted. R0 =
; SS$_NORMAL or the disk's error. Uses R1-R2.
FREEBLK:
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4, R5>
        MOVL    #SS$_NORMAL, R0
        CLRL    R5                      ; the clusters it frees
        MOVL    F11$GL_VCB, R3
        MOVZWL  VCB$W_CLUSTER(R3), R3
        DIVL2   R3, R2                  ; R2 = the first cluster,
        ADDL2   R3, R1                  ; R1 = how many
        DECL    R1
        DIVL2   R3, R1
        MNEGL   #1, SBNUM               ; none read yet
10$:    TSTL    R1
        BEQL    80$
        DIVL3   #BITS, R2, R3           ; its block: read if another
        CMPL    R3, SBNUM
        BEQL    20$
        TSTL    SBNUM
        BLSS    15$
        MOVL    #3, R0
        BSBW    BITMAP
        BLBC    R0, 87$
15$:    MOVL    R3, SBNUM
        MOVL    #2, R0
        BSBW    BITMAP
        BLBC    R0, 87$
20$:    MULL3   #BITS, SBNUM, R4
        SUBL3   R4, R2, R4
        BBSS    R4, BITBLK, 30$
        INCL    R5
30$:    INCL    R2
        DECL    R1
        BRB     10$
80$:    TSTL    SBNUM
        BLSS    85$
        MOVL    #3, R0
        BSBW    BITMAP
        BLBC    R0, 87$
85$:    MOVL    F11$GL_VCB, R3
        TSTL    VCB$L_FREE(R3)
        BLSS    90$
        MOVZWL  VCB$W_CLUSTER(R3), R4
        MULL2   R4, R5
        ADDL2   R5, VCB$L_FREE(R3)
        BRB     90$
87$:    MOVL    F11$GL_VCB, R3          ; partly written: counted again
        MNEGL   #1, VCB$L_FREE(R3)      ; next time
90$:    POPR    #^M<R3, R4, R5>
        RSB

; GETHIBLK: R3 = a file header. R0 = the blocks allocated to it. And
; PUTHIBLK, R0 = the blocks to set it to. Keep every other register.
GETHIBLK:
        .JSB_ENTRY
        ROTL    #16, FAT$L_HIBLK(R3), R0
        RSB
PUTHIBLK:
        .JSB_ENTRY
        ROTL    #16, R0, FAT$L_HIBLK(R3)
        RSB

; ADDMAP: R1 = a block count, R2 = an LBN, R3 = a file header. Maps the
; blocks past the file's last, merging them into its last pointer if they
; follow it; if they don't, the file is no longer contiguous. R0 =
; SS$_NORMAL, or SS$_HEADERFULL if its map is full. Uses R4-R5.
ADDMAP:
        .JSB_ENTRY  SCRATCH=<R4, R5>
        MOVZBL  FH2$B_MPOFFSET(R3), R4
        MOVZBL  FH2$B_MAP_INUSE(R3), R5
        CMPL    R5, #3
        BLSSU   20$
        ADDL2   R5, R4                  ; the last pointer, if a format 2 one
        SUBL2   #3, R4
        MOVAW   (R3)[R4], R4
        MOVZWL  (R4), R0
        EXTZV   #14, #2, R0, R5
        CMPL    R5, #2
        BNEQ    15$
        BICL2   #^XC000, R0
        INCL    R0                      ; its count
        ADDL3   2(R4), R0, R5
        CMPL    R5, R2
        BNEQ    15$
        ADDL2   R1, R0
        CMPL    R0, #MAXRUN
        BGTRU   15$
        DECL    R0
        BISW3   #^X8000, R0, (R4)
        BRB     70$
15$:    BICL2   #FCH$M_CONTIG, FH2$L_FILECHAR(R3)
        MOVZBL  FH2$B_MPOFFSET(R3), R4
        MOVZBL  FH2$B_MAP_INUSE(R3), R5
20$:    ADDL2   R5, R4                  ; a new pointer past the last
        ADDL3   #3, R4, R0
        MOVZBL  FH2$B_ACOFFSET(R3), R5
        CMPL    R0, R5
        BGTRU   80$
        MOVAW   (R3)[R4], R4
        SUBL3   #1, R1, R0
        BISW3   #^X8000, R0, (R4)
        MOVL    R2, 2(R4)
        ADDB2   #3, FH2$B_MAP_INUSE(R3)
70$:    MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_HEADERFULL, R0
        RSB

; FIL$EXTEND: R1 = a block count, R3 = a file header. Allocates that many
; blocks more to the file, in as few runs as the storage bitmap has, and
; maps them; FIL$WRITEHDR writes the header. R0 = SS$_NORMAL,
; SS$_DEVICEFULL, SS$_HEADERFULL, or the disk's error, with the blocks
; mapped until then still the file's. Holding FIL$LOCK. Keeps every other
; register.
FIL$EXTEND::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R4, R5, R6>
        MOVL    R1, R6                  ; the blocks left
10$:    TSTL    R6
        BLEQ    40$
        MOVL    R6, R1
        CMPL    R1, #MAXRUN
        BLEQU   20$
        MOVL    #MAXRUN, R1
20$:    PUSHL   R3
        BSBW    ALLOCBLK
        MOVL    (SP)+, R3
        BLBC    R0, 90$
        BSBW    ADDMAP
        BLBC    R0, 80$
        SUBL2   R1, R6
        BSBB    GETHIBLK
        ADDL2   R1, R0
        BSBB    PUTHIBLK
        BRB     10$
40$:    MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    PUSHL   R0                      ; the map is full: the run goes back
        BSBW    FREEBLK
        MOVL    (SP)+, R0
90$:    POPR    #^M<R1, R2, R4, R5, R6>
        RSB

; FIL$DELHDR: R1 = a file header. Deletes the file: gives its blocks back
; to the storage bitmap and its slot to the index file bitmap, and marks
; the header deleted, its sequence number kept for the slot's next file.
; R0 = SS$_NORMAL or the disk's error. Holding FIL$LOCK. Uses R1-R5.
FIL$DELHDR::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHL   R6
        MOVL    R1, R6
        MOVL    #1, R4                  ; the next VBN
10$:    MOVL    R4, R0
        MOVL    R6, R1
        BSBW    FIL$MAPVBN
        TSTL    R1
        BEQL    20$
        ADDL2   R1, R4
        MOVL    R0, R2
        BSBW    FREEBLK
        BLBC    R0, 90$
        BRB     10$
20$:    MOVL    R6, R1
        BSBW    HDRVBN
        PUSHL   R0                      ; the slot's VBN
        MOVZBL  FH2$B_FID_NMX(R6), R4   ; the file number
        ASHL    #16, R4, R4
        MOVW    FH2$W_FID(R6), R4
        MOVZWL  FH2$W_FID_SEQ(R6), R5
        PUSHR   #^M<R4, R5>
        MOVC5   #0, (R6), #0, #BLOCK, (R6)
        POPR    #^M<R4, R5>
        MOVW    R5, FH2$W_FID_SEQ(R6)
        BISL2   #1@FCH$V_MARKDEL, FH2$L_FILECHAR(R6)
        MOVL    (SP)+, R0
        MOVL    #1, R1
        MOVL    R6, R2
        MOVL    F11$GL_VCB, R3
        MOVAB   VCB$AB_INDEXF(R3), R3
        BSBW    FIL$WRITEVBN
        BLBC    R0, 90$
        DECL    R4                      ; its bit, in block IBNUM
        DIVL3   #BITS, R4, IBNUM
        MULL3   #BITS, IBNUM, R0
        SUBL2   R0, R4
        CLRL    R0
        BSBW    BITMAP
        BLBC    R0, 90$
        BBCC    R4, BITBLK, 30$
30$:    MOVL    #1, R0
        BSBW    BITMAP
90$:    MOVL    (SP)+, R6
        RSB

; FIL$ENTER: R3 = a directory's header, R6 = a name, NAME.TYPE, R7 = its
; length, R8 = a version, or 0 for one above the highest the directory
; has, R5 = a file ID's address. Enters the file in the directory: R4 =
; its version, R5 = its name's version limit, which a new name gets from
; the directory's default, FAT$W_VERSIONS, or 32767 if it has none. R0 = SS$_NORMAL,
; SS$_DUPFILENAME if that version is there, SS$_BADFILEVER if it would
; be above 32767, SS$_INSFMEM, or the disk's error. Holding FIL$LOCK.
; Uses R0-R5.
FIL$ENTER::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CLRL    DU_MODE
        MOVL    R8, DU_VER
        MOVZWL  FAT$W_VERSIONS(R3), DU_LIMIT
        BNEQ    10$
        MOVL    #MAXVER, DU_LIMIT
10$:
        MOVL    (R5), DU_FID
        MOVW    4(R5), DU_FID+4
        BSBB    DIRUPD
        MOVL    DU_VER, R4
        MOVL    DU_LIMIT, R5
        RSB

; FIL$REMOVE: R3 = a directory's header, R6 = a name, NAME.TYPE, R7 = its
; length, R8 = a version. Removes the file's entry from the directory: R5
; = its file number. R0 = SS$_NORMAL, SS$_NOSUCHFILE if there is no such
; entry, SS$_INSFMEM, or the disk's error. Holding FIL$LOCK. Uses R0-R5.
FIL$REMOVE::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    #1, DU_MODE
        MOVL    R8, DU_VER
        BSBB    DIRUPD
        MOVZBL  DU_FID+5, R5
        ASHL    #16, R5, R5
        MOVW    DU_FID, R5
        RSB

; FIL$SETLIMIT: R3 = a directory's header, R6 = a name, NAME.TYPE, R7 =
; its length, R8 = a version limit, 1 to 32767. Gives the name that
; limit, in each of its records. R0 = SS$_NORMAL, SS$_NOSUCHFILE if the
; directory hasn't the name, SS$_INSFMEM, or the disk's error. Holding
; FIL$LOCK. Uses R0-R5.
FIL$SETLIMIT::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    #2, DU_MODE
        MOVL    R8, DU_VER
        BSBW    DIRUPD
        RSB

; FIL$MKDIR: R3 = a directory's header, R6 = a name, NAME.DIR, R7 = its
; length. Makes an empty directory, NAME.DIR;1, in it, as INITIALIZE
; makes the MFD: a header marked a directory and contiguous, with VAR
; records in blocks, and a block holding only the end of block's -1, the
; one above's protection, but delete, as VMS's CREATE/DIRECTORY does. R1 =
; its header, R0 = SS$_NORMAL, or FIL$CREHDR's, FIL$EXTEND's or
; FIL$ENTER's error, with nothing made. Holding FIL$LOCK. Uses R0-R5.
FIL$MKDIR::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R8, R9>
        MOVL    R3, R9                  ; the one it goes in
        MOVAB   NEWHDR, R1
        BSBW    FIL$CREHDR
        BLBC    R0, 90$
        MOVAB   NEWHDR, R3
        MOVB    #2, FAT$B_RTYPE(R3)     ; VAR
        MOVB    #8, FAT$B_RATTRIB(R3)   ; BLK
        MOVW    #BLOCK, FAT$W_RSIZE(R3)
        MOVW    #BLOCK, FAT$W_MAXREC(R3)
        MOVL    #FCH$M_CONTIG!FCH$M_DIRECTORY, FH2$L_FILECHAR(R3)
        BISW3   #^X8888, FH2$W_FILEPROT(R9), FH2$W_FILEPROT(R3)    ; no one may delete it
        MOVL    FH2$W_FID(R9), FH2$W_BACKLINK(R3)
        MOVW    FH2$W_FID+4(R9), FH2$W_BACKLINK+4(R3)
        MOVL    #1, R1
        BSBW    FIL$EXTEND
        BLBC    R0, 80$
        ROTL    #16, #2, FAT$L_EFBLK(R3)        ; one block in use
        MOVC5   #0, (SP), #0, #BLOCK, BITBLK
        MNEGW   #1, BITBLK
        MOVL    #1, R0
        MOVL    #1, R1
        MOVAB   BITBLK, R2
        MOVAB   NEWHDR, R3
        BSBW    FIL$WRITEVBN
        BLBC    R0, 80$
        MOVAB   NEWHDR, R1
        MOVL    #1, R4
        BSBW    FIL$SETNAME
        BSBW    FIL$WRITEHDR
        BLBC    R0, 80$
        MOVL    R9, R3
        MOVL    #1, R8
        MOVAB   NEWHDR+FH2$W_FID, R5
        BSBW    FIL$ENTER
        BLBC    R0, 80$
        MOVAB   NEWHDR, R1
        BRB     90$
80$:    PUSHL   R0                      ; its block and header go back
        MOVAB   NEWHDR, R1
        BSBW    FIL$DELHDR
        MOVL    (SP)+, R0
90$:    MOVL    R9, R3
        POPR    #^M<R8, R9>
        RSB

; DIRUPD: R3 = a directory's header, R6 = a name, R7 = its length, and
; DU_MODE, DU_VER and DU_FID. Copies the directory's records into a block
; of pool, entering or removing the entry, or setting the name's version
; limit, on the way, packs them into
; blocks again, and writes them back, extending the directory if it grew,
; and its header, with its new end of file. A record holds at most
; BLOCK-2 bytes, as the block's end word is always there; a name whose
; versions fill it continues in the records after it, with the same name.
; R0 = SS$_NORMAL, or the error, and the directory as it was. Uses R0-R5.
DIRUPD:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7, R8, R9, R10, R11>
        MOVL    R6, DU_NAME
        MOVL    R7, DU_NAME+4
        CLRL    DU_DONE
        CLRL    DU_PEND
        CLRL    DU_POS
        MOVL    R3, R9                  ; the header
        MOVL    R9, R1
        BSBW    FIL$EOF
        ADDL2   #BLOCK-1, R0
        DIVL2   #BLOCK, R0
        MOVL    R0, R10                 ; the blocks in use
        ADDL3   #3, R10, R1             ; and two more for new records
        MULL2   #BLOCK, R1
        BSBW    EXE$ALONONPAGED
        BLBS    R0, 5$
        BRW     95$
5$:     MOVL    R1, DU_OUT+4
        MOVL    R2, DU_OUT
        MOVC5   #0, (R2), #0, R1, (R2)
        MOVL    #1, R11                 ; the VBN
10$:    CMPL    R11, R10
        BGTRU   50$
        MOVL    R11, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        MOVL    R9, R3
        BSBW    FIL$READVBN
        BLBS    R0, 15$
        BRW     90$
15$:    MOVAB   F11$AB_DIRBLK, R8       ; the record
20$:    MOVAB   F11$AB_DIRBLK+BLOCK-2, R0
        CMPL    R8, R0
        BGEQU   40$
        CMPW    (R8), #^XFFFF           ; the block's end
        BEQL    40$
        BSBW    ONEREC
        BLBS    R0, 30$
        BRW     90$
30$:    MOVZWL  (R8), R0
        ADDL2   #2, R0
        ADDL2   R0, R8
        BRB     20$
40$:    INCL    R11
        BRB     10$
50$:    TSTL    DU_DONE                 ; past the last record
        BNEQ    60$
        MOVL    #SS$_NOSUCHFILE, R0
        TSTL    DU_MODE
        BNEQ    90$
        BSBW    NEWENT
        BLBC    R0, 90$
60$:    BSBW    ENDBLK
        DIVL3   #BLOCK, DU_POS, R10     ; the blocks it takes now
        MOVL    R9, R3
        BSBW    GETHIBLK
        SUBL3   R0, R10, R1
        BLEQ    70$
        BSBW    FIL$EXTEND
        BLBC    R0, 90$
70$:    MOVL    #1, R0
        MOVL    R10, R1
        MOVL    DU_OUT, R2
        MOVL    R9, R3
        BSBW    FIL$WRITEVBN
        BLBC    R0, 90$
        ADDL3   #1, R10, R0             ; the end of file: past the last block
        ROTL    #16, R0, FAT$L_EFBLK(R9)
        CLRW    FAT$W_FFBYTE(R9)
        MOVL    R9, R1
        BSBW    FIL$WRITEHDR
90$:    MOVL    R0, R6
        MOVL    DU_OUT, R0
        MOVL    DU_OUT+4, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    R6, R0
95$:    MOVL    R9, R3
        POPR    #^M<R6, R7, R8, R9, R10, R11>
        RSB

; ONEREC: R8 = a directory record, and DIRUPD's. Copies it, entering the
; new entry before it, or in it, splitting it if it gets too long,
; removing the entry from it, or giving it the version limit. R0 = SS$_NORMAL, or the error. Uses R0-R6.
ONEREC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CMPL    DU_MODE, #2
        BNEQ    5$
        MOVAB   6(R8), R1               ; a version limit: each of the name's records
        MOVZBL  5(R8), R2
        BSBW    COMPARE
        TSTL    R0
        BNEQ    50$
        MOVW    DU_VER, 2(R8)
        MOVL    #1, DU_DONE
        BRB     50$
5$:     TSTL    DU_DONE
        BNEQ    50$
        MOVAB   6(R8), R1
        MOVZBL  5(R8), R2
        BSBW    COMPARE
        TSTL    R0
        BLSS    50$                     ; before the name
        BGTR    20$
        MOVZWL  2(R8), DU_LIMIT         ; the name's record: its limit, for a record after it
        TSTL    DU_MODE
        BNEQ    10$
        BSBW    ADDENTRY
        TSTL    R0
        BEQL    30$
        BLBC    R0, 90$
        CMPL    R2, #BLOCK-2
        BLEQU   15$
        BSBW    RECSPLIT
        BLBC    R0, 90$
        BRB     15$
10$:    BSBW    DELENTRY
        BLBC    R0, 50$                 ; not there
        TSTL    R2
        BEQL    18$                     ; none left
15$:    BSBW    EMIT
        BLBC    R0, 90$
18$:    MOVL    #1, DU_DONE
        MOVL    #SS$_NORMAL, R0
        RSB
20$:    TSTL    DU_MODE                 ; past it: a new entry goes here
        BNEQ    50$
        BSBW    NEWENT
        BLBC    R0, 90$
        MOVL    #1, DU_DONE
        BRB     50$
30$:    MOVL    #1, DU_PEND             ; below its versions: in the next
50$:
        MOVL    R8, R1
        MOVZWL  (R8), R2
        ADDL2   #2, R2
        BRW     EMIT
90$:    RSB

; NEWENT: puts DU_VER's entry after the name's records, which end in the
; record EMIT appended last if DU_PEND says so: in it, if its block has
; room, else in a new record. R0 = SS$_NORMAL, or EMIT's error. Uses R0-R6.
NEWENT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        TSTL    DU_PEND
        BEQL    10$
        BICL3   #^C<BLOCK-1>, DU_POS, R0
        ADDL2   #8, R0
        CMPL    R0, #BLOCK-2
        BGTRU   10$
        ADDL3   DU_OUT, DU_POS, R6
        BSBB    PUTENTRY
        ADDL2   #8, DU_POS
        MOVL    DU_LAST, R1
        ADDW2   #8, (R1)
        MOVL    #SS$_NORMAL, R0
        RSB
10$:    BSBW    NEWREC
        BRW     EMIT

; RECSPLIT: R1 = RECBUF, a record ADDENTRY made, R2 = its length, too long.
; Emits a record with the higher half of its entries: R1 = one with the
; rest, at its end in RECBUF, R2 = its length. R0 = SS$_NORMAL, or EMIT's
; error. Uses R0-R6.
RECSPLIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVAB   RECBUF, R3
        MOVZBL  5(R3), R4
        INCL    R4
        BICL2   #1, R4
        ADDL2   #6, R4                  ; the head
        SUBL3   R4, R2, R5              ; the entries
        ADDL2   #8, R5
        ASHL    #-4, R5, R5
        ASHL    #3, R5, R5              ; the higher half of them
        SUBL3   R5, R2, R6              ; the second record's length
        ADDL3   R4, R5, R2              ; the first's
        SUBW3   #2, R2, (R3)
        PUSHR   #^M<R4, R5, R6>
        MOVL    R3, R1
        BSBW    EMIT
        POPR    #^M<R4, R5, R6>
        BLBC    R0, 90$
        PUSHL   R6
        MOVAB   RECBUF[R5], R6          ; the head again, before the rest
        MOVC3   R4, RECBUF, (R6)
        MOVL    R6, R1
        MOVL    (SP)+, R2
        SUBW3   #2, R2, (R1)
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; COMPARE: R1 = a name, R2 = its length. R0 = -1, 0 or 1 as it sorts
; before DU_NAME, is it, or sorts after it: byte by byte, a shorter name
; first. Uses R3-R4.
COMPARE:
        .JSB_ENTRY  SCRATCH=<R3, R4>
        CLRL    R3
        MOVL    DU_NAME, R4
10$:    CMPL    R3, R2
        BGEQU   30$
        CMPL    R3, DU_NAME+4
        BGEQU   50$
        CMPB    (R1)[R3], (R4)[R3]
        BLSSU   40$
        BGTRU   50$
        INCL    R3
        BRB     10$
30$:    CLRL    R0
        CMPL    R3, DU_NAME+4
        BEQL    60$
40$:    MNEGL   #1, R0
        RSB
50$:    MOVL    #1, R0
60$:    RSB

; NEWREC: makes a record for DU_NAME in RECBUF, with an entry for DU_FID,
; version DU_VER, 1 if that is 0: R1 = RECBUF, R2 = its length. Uses
; R0-R6.
NEWREC:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVAB   RECBUF, R3
        MOVW    DU_LIMIT, 2(R3)         ; the version limit
        CLRB    4(R3)                   ; the flags
        MOVB    DU_NAME+4, 5(R3)
        MOVC3   DU_NAME+4, @DU_NAME, 6(R3)
        MOVAB   RECBUF, R3
        MOVZBL  5(R3), R0
        CLRB    6(R3)[R0]               ; the pad, if the name's length is odd
        INCL    R0
        BICL2   #1, R0
        ADDL2   #6, R0
        ADDL3   R3, R0, R6              ; the entry
        TSTL    DU_VER
        BNEQ    10$
        MOVL    #1, DU_VER
10$:    BSBB    PUTENTRY
        BRB     RECEND

; PUTENTRY: R6 = where an entry goes. Writes DU_VER's and DU_FID's
; there, R6 past it.
PUTENTRY:
        .JSB_ENTRY  SCRATCH=<R6>
        MOVW    DU_VER, (R6)+
        MOVL    DU_FID, (R6)+
        MOVW    DU_FID+4, (R6)+
        RSB

; RECEND: R3 = a record being made, R6 = past it. Sets its size: R1 =
; it, R2 = its length.
RECEND:
        .JSB_ENTRY  SCRATCH=<R2>
        SUBL3   R3, R6, R2
        SUBW3   #2, R2, (R3)
        MOVL    R3, R1
        RSB

; RECHEAD: R8 = a directory record. Copies its size, version limit,
; flags and name to RECBUF: R3 = RECBUF, R6 = past what was copied there,
; R4 = the record's first entry, R5 = past its last. Uses R0-R6.
RECHEAD:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVZBL  5(R8), R2
        INCL    R2
        BICL2   #1, R2
        ADDL2   #6, R2
        PUSHL   R2
        MOVC3   R2, (R8), RECBUF
        MOVL    (SP)+, R2
        MOVAB   RECBUF, R3
        ADDL3   R3, R2, R6
        ADDL3   R8, R2, R4
        MOVZWL  (R8), R5
        ADDL2   R8, R5
        ADDL2   #2, R5
        RSB

; ADDENTRY: R8 = DU_NAME's record. Makes it in RECBUF with an entry for
; DU_FID, version DU_VER, or one above the record's first, the highest, if
; that is 0; versions go from highest to lowest. R1 = RECBUF, R2 = its
; length, R0 = SS$_NORMAL, SS$_DUPFILENAME, SS$_BADFILEVER, or 0 if
; DU_VER is below all the record's versions. Uses R0-R6.
ADDENTRY:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        BSBB    RECHEAD
        TSTL    DU_VER
        BNEQ    10$
        MOVZWL  (R4), R0
        INCL    R0
        CMPL    R0, #MAXVER
        BGTRU   85$
        MOVL    R0, DU_VER
10$:    CMPL    R4, R5                  ; the higher versions
        BGEQU   20$
        CMPW    (R4), DU_VER
        BLSSU   20$
        BEQL    80$
        MOVQ    (R4)+, (R6)+
        BRB     10$
20$:    CMPL    R4, R5                  ; below them all: not here
        BGEQU   87$
        BSBB    PUTENTRY                ; the new one
30$:    CMPL    R4, R5                  ; the lower ones
        BGEQU   40$
        MOVQ    (R4)+, (R6)+
        BRB     30$
40$:    BSBB    RECEND
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_DUPFILENAME, R0
        RSB
85$:    MOVL    #SS$_BADFILEVER, R0
        RSB
87$:    CLRL    R0
        RSB

; DELENTRY: R8 = DU_NAME's record. Makes it in RECBUF without the entry
; for version DU_VER, whose file ID goes to DU_FID: R1 = RECBUF, R2 = its
; length, 0 if no entry is left. R0 = 1, or 0 if the record has no such
; entry. Uses R0-R6.
DELENTRY:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        BSBB    RECHEAD
        PUSHL   R6                      ; past the head
        CLRL    R0
10$:    CMPL    R4, R5
        BGEQU   30$
        CMPW    (R4), DU_VER
        BNEQ    20$
        MOVL    2(R4), DU_FID
        MOVW    6(R4), DU_FID+4
        MOVL    #1, R0
        ADDL2   #8, R4
        BRB     10$
20$:    MOVQ    (R4)+, (R6)+
        BRB     10$
30$:    BSBB    RECEND
        CMPL    R6, (SP)+
        BNEQ    40$
        CLRL    R2
40$:    RSB

; EMIT: R1 = a directory record, R2 = its length. Appends it to the
; directory being made, in the next block if it doesn't fit in this one
; before its end word, and DU_LAST. R0 = SS$_NORMAL, or SS$_BADIRECTORY if
; it doesn't fit in a block. Uses R0-R5.
EMIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CMPL    R2, #BLOCK-2
        BGTRU   80$
        BICL3   #^C<BLOCK-1>, DU_POS, R0
        ADDL2   R2, R0
        CMPL    R0, #BLOCK-2
        BLEQU   10$
        PUSHR   #^M<R1, R2>
        BSBB    ENDBLK
        POPR    #^M<R1, R2>
10$:    ADDL3   DU_OUT, DU_POS, R3
        MOVL    R3, DU_LAST
        ADDL2   R2, DU_POS
        MOVC3   R2, (R1), (R3)
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADIRECTORY, R0
        RSB

; ENDBLK: ends the block being made, with a record size of all ones, and
; starts the next. The first block always has one. Uses R0-R1.
ENDBLK:
        .JSB_ENTRY
        BICL3   #^C<BLOCK-1>, DU_POS, R0
        BNEQ    10$
        TSTL    DU_POS
        BNEQ    20$
10$:    ADDL3   DU_OUT, DU_POS, R1
        MNEGW   #1, (R1)
        ADDL2   #BLOCK, DU_POS
        BICL2   #BLOCK-1, DU_POS
20$:    RSB

; FIL$INIT: R1 = a label, R2 = its length, 1 to 12, R3 = the volume's
; size in blocks, R4 = its owner, R5 = its protection. Writes an empty
; Files-11 ODS-2 volume on F11$GL_VCB's disk, laid out as VMS's
; INITIALIZE lays it out but from LBN 0 up: the index file, its first
; clusters the boot block and the home block, the backup home block's
; cluster, the backup index file header's, then its bitmap and HEADERS
; headers, zeroed; BITMAP.SYS, the SCB and the storage bitmap; and the
; MFD, which lists the reserved files, the owner's, and which all may
; look in. The cluster is VMS's default: a block up to 50,000 blocks,
; else 3, and more if the storage bitmap would take more than 255
; blocks; the maximum files, size / ((cluster + 1) * 2), VMS's default
; too. The blocks past the MFD are free, whatever they hold. R0 =
; SS$_NORMAL, SS$_DEVICEFULL if the volume is too small, or the disk's
; error. Holding FIL$LOCK. Uses R0-R11.
; ponytail: MAXVOL blocks at most, and a last cluster in part is left
; out of the volume, not put in BADBLK.SYS; the index file isn't in the
; middle of the volume, as VMS's /INDEX=MIDDLE puts it.
FIL$INIT::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    R4, VOLOWNER
        MOVL    R5, VOLPROT
        CMPL    R3, #MAXVOL
        BLEQU   2$
        MOVL    #MAXVOL, R3
2$:     MOVL    R3, R6                  ; R6 = the blocks
        PUSHR   #^M<R1, R2>
        MOVC5   #0, (R1), #^A/ /, #12, LABEL
        POPR    #^M<R1, R2>
        MOVC3   R2, (R1), LABEL
        MOVL    F11$GL_VCB, R11
        MOVL    #1, R7                  ; R7 = the cluster
        CMPL    R6, #50000
        BLEQU   4$
        MOVL    #3, R7
4$:     ADDL3   #<255*BITS>-1, R6, R0
        DIVL2   #255*BITS, R0
        CMPL    R0, R7
        BLEQU   6$
        MOVL    R0, R7
6$:     MOVW    R7, VCB$W_CLUSTER(R11)
        DIVL3   R7, R6, R8              ; R8 = the clusters
        MULL3   R7, R8, VOLSIZE
        ADDL3   #1, R7, R0              ; the maximum files
        ADDL2   R0, R0
        DIVL3   R0, VOLSIZE, R0
        CMPL    R0, #25                 ; the reserved files and 16
        BGEQU   8$
        MOVL    #25, R0
8$:     CMPL    R0, #^XFFFFFF
        BLEQU   10$
        MOVL    #^XFFFFFF, R0
10$:    MOVL    R0, VCB$L_MAXFILES(R11)
        ADDL2   #BITS-1, R0
        DIVL3   #BITS, R0, VCB$L_IBMAPBLKS(R11)
        MULL3   #4, R7, R0              ; the index file bitmap, past
        MOVL    R0, VCB$L_IBMAPLBN(R11) ; four clusters
        ADDL2   VCB$L_IBMAPBLKS(R11), R0
        ADDL3   #1, R0, VCB$L_HDRVBN(R11)
        ADDL2   #HEADERS, R0
        BSBW    CLUSTERS
        MOVL    R0, INDEXF
        MOVW    R0, RESFILES+18
        MOVW    R0, RESFILES+RECSIZE+16 ; BITMAP.SYS, past it
        ADDL3   #1, R0, VCB$L_SBMAPLBN(R11)
        ADDL3   #BITS-1, R8, R0
        DIVL2   #BITS, R0
        INCL    R0                      ; with its SCB
        BSBW    CLUSTERS
        MOVW    R0, RESFILES+RECSIZE+18
        SUBL3   #1, R0, VCB$L_SBMAPBLKS(R11)
        ADDL2   INDEXF, R0              ; the MFD, past that
        MOVW    R0, RESFILES+<3*RECSIZE>+16
        MOVW    R7, RESFILES+<3*RECSIZE>+18
        ADDL3   R7, R0, R10             ; R10 = the first free block
        DIVL3   R7, R10, R9             ; R9 = its cluster
        MOVL    #SS$_DEVICEFULL, R0
        CMPL    R9, R8
        BLSSU   12$
        BRW     90$
; Zeros up to there: no header of another volume's is left in a slot.
12$:    DECL    R10
        MOVAB   ZEROS, R0
        MOVL    #1, R1
        MOVL    R10, R2
        BSBW    FIL$WRITELBLK
        BLBS    R0, 14$
        BRW     90$
14$:    TSTL    R10
        BNEQ    12$
; The index file bitmap: file 1, for now.
        MOVC5   #0, BITBLK, #0, #BLOCK, BITBLK
        MOVB    #1, BITBLK
        CLRL    IBNUM
        MOVL    #1, R0
        BSBW    BITMAP
        BLBS    R0, 15$
        BRW     90$
; The storage bitmap: the clusters from R9 to R8 are free.
15$:    CLRL    SBNUM
20$:    MOVC5   #0, BITBLK, #0, #BLOCK, BITBLK
        MULL3   #BITS, SBNUM, R3        ; the block's first cluster
        SUBL3   R3, R9, R2              ; the first free one in it
        BGEQ    22$
        CLRL    R2
22$:    SUBL3   R3, R8, R4              ; and past the last
        CMPL    R4, #BITS
        BLEQ    24$
        MOVL    #BITS, R4
24$:    CMPL    R2, R4
        BGEQ    28$
26$:    BBSS    R2, BITBLK, 27$
27$:    AOBLSS  R4, R2, 26$
28$:    MOVL    #3, R0
        BSBW    BITMAP
        BLBS    R0, 29$
        BRW     90$
29$:    INCL    SBNUM
        CMPL    SBNUM, VCB$L_SBMAPBLKS(R11)
        BLSSU   20$
; The SCB, before it: the volume's size, and a made-up geometry.
        MOVC5   #0, BITBLK, #0, #BLOCK, BITBLK
        MOVAB   BITBLK, R1
        MOVW    #^X0201, (R1)           ; structure level
        MOVW    VCB$W_CLUSTER(R11), 2(R1)       ; cluster
        MOVL    VOLSIZE, 4(R1)          ; volume size
        MOVL    #1, 8(R1)               ; block size
        MOVL    #1, 12(R1)              ; sectors
        MOVL    #1, 16(R1)              ; tracks
        MOVL    VOLSIZE, 20(R1)         ; cylinders
        MOVL    #255, R2
        BSBW    CHECKSUM
        MOVW    R0, BLOCK-2(R1)
        MOVAB   BITBLK, R0
        MOVL    #1, R1
        MOVL    INDEXF, R2
        BSBW    FIL$WRITELBLK
        BLBS    R0, 30$
        BRW     90$
; INDEXF.SYS's header, in the VCB, where FIL$WRITEHDR finds the index
; file's map, then the others', each in a slot FIL$CREHDR takes.
30$:    MOVAB   VCB$AB_INDEXF(R11), R1
        MOVL    #1, R2
        MOVL    #1, R3
        BSBW    EMPTYHDR
        MOVAB   VCB$AB_INDEXF(R11), R1
        MOVAB   RESFILES, R10
        BSBW    RESHDR
        BLBC    R0, 90$
35$:    ADDL2   #RECSIZE, R10
        MOVAB   RESEND, R0
        CMPL    R10, R0
        BGEQU   40$
        MOVAB   NEWHDR, R1
        BSBW    FIL$CREHDR
        BLBC    R0, 90$
        MOVW    FH2$W_FID(R1), FH2$W_FID_SEQ(R1)        ; (n,n)
        BSBW    RESHDR
        BLBC    R0, 90$
        BRB     35$
; The backup index file header, a copy of INDEXF.SYS's.
40$:    MOVAB   VCB$AB_INDEXF(R11), R0
        MOVL    #1, R1
        MOVZWL  VCB$W_CLUSTER(R11), R2  ; at LBN 3v
        MULL2   #3, R2
        BSBW    FIL$WRITELBLK
        BLBC    R0, 90$
; The MFD lists them all, version 1.
        MOVL    #MFD, R0
        MOVAB   NEWHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVAB   RESFILES, R10
        MOVL    #1, R9                  ; the file number
50$:    MOVW    R9, DU_FID              ; its file ID, (n,n,0)
        MOVW    R9, DU_FID+2
        CLRW    DU_FID+4
        MOVAB   NEWHDR, R3
        MOVL    R10, R6
        MOVL    #10, R7
        MOVL    #1, R8
        MOVAB   DU_FID, R5
        BSBW    FIL$ENTER
        BLBC    R0, 90$
        ADDL2   #RECSIZE, R10
        INCL    R9
        CMPL    R9, #9
        BLEQU   50$
; The home block, last, which makes it a volume, and its backup.
        MOVZWL  VCB$W_CLUSTER(R11), R7
        MOVC5   #0, BITBLK, #0, #BLOCK, BITBLK
        MOVAB   BITBLK, R1
        MOVL    #1, (R1)                ; home LBN
        MULL3   #2, R7, 4(R1)           ; backup home LBN
        MULL3   #3, R7, 8(R1)           ; backup index file header LBN
        MOVW    #^X0201, 12(R1)         ; structure level
        MOVW    R7, 14(R1)              ; cluster
        MOVW    #2, 16(R1)              ; home VBN
        ADDW3   #1, 4(R1), 18(R1)       ; backup home VBN
        ADDW3   #1, 8(R1), 20(R1)       ; backup index file header VBN
        ADDW3   #1, VCB$L_IBMAPLBN(R11), 22(R1) ; index file bitmap VBN
        MOVL    VCB$L_IBMAPLBN(R11), 24(R1)     ; and LBN
        MOVL    VCB$L_MAXFILES(R11), 28(R1)     ; maximum files
        MOVW    VCB$L_IBMAPBLKS(R11), 32(R1)    ; index file bitmap blocks
        MOVW    #9, 34(R1)              ; reserved files
        MOVL    VOLOWNER, 44(R1)        ; volume owner
        MOVW    VOLPROT, 52(R1)         ; volume protection
        MOVW    #FILEPROT, 54(R1)       ; default file protection
        MOVQ    EXE$GQ_SYSTIME, 60(R1)  ; made
        MOVB    #7, 68(R1)              ; window
        MOVB    #3, 69(R1)              ; directory LRU limit
        MOVW    #5, 70(R1)              ; default extend
        MOVC5   #0, BITBLK, #^A/ /, #12, BITBLK+460     ; structure name
        MOVC3   #12, LABEL, BITBLK+472                  ; volume name
        MOVC5   #0, BITBLK, #^A/ /, #12, BITBLK+484     ; owner name
        MOVC3   #12, FORMAT, BITBLK+496
        MOVAB   BITBLK, R1
        MOVL    #29, R2
        BSBW    CHECKSUM
        MOVW    R0, 58(R1)
        MOVL    #255, R2
        BSBW    CHECKSUM
        MOVW    R0, BLOCK-2(R1)
        MOVAB   BITBLK, R0
        MOVL    #1, R1
        MOVL    BITBLK+4, R2
        BSBW    FIL$WRITELBLK
        BLBC    R0, 90$
        MOVAB   BITBLK, R0
        MOVL    #1, R1
        MOVL    #1, R2
        BSBW    FIL$WRITELBLK
90$:    RSB

; CLUSTERS: R0 = a block count, R7 = a cluster. R0 = the blocks of the
; clusters they take. Keeps every other register.
CLUSTERS:
        .JSB_ENTRY
        ADDL2   R7, R0
        DECL    R0
        DIVL2   R7, R0
        MULL2   R7, R0
        RSB

; FIL$SETVOLUME devnam, what, label, owner, prot, fileprot: SET VOLUME's
; work, in kernel mode, which $CMKRNL gives it. Changes the volume mounted
; on the disk the descriptor devnam names, _DKB0: or DKB0:, as the bits
; of what say: 1 its label, to the text label's descriptor gives, 1 to 12
; characters; 2 its owner, to the UIC owner; 4 its protection and 8 its
; default file protection, each a longword: the bits of the mask to keep
; in its high word, those to set in its low one. Rewrites each copy of
; the home block, INDEXF.SYS's VBNs from 2 up to the backup index file
; header's, with its checksums, and the label, owner and protection in
; the VCB. Takes control access to the volume. R0 = SS$_NORMAL,
; SS$_NOSUCHDEV, SS$_DEVNOTMOUNT, SS$_WRITLCK, SS$_NOPRIV, SS$_BADPARAM
; for a label of no characters or more than 12, SS$_NOHOMEBLK, or the
; disk's error.
; vaxpunk: VMS's SET VOLUME, installed with CMKRNL, rewrites the home
; blocks itself with $QIOs through INDEXF.SYS, and changes the VCB in
; kernel mode; SET.EXE here has no privileges of its own, so a volume's
; owner without CMKRNL can't.
        .ENTRY  FIL$SETVOLUME, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        MOVL    #SS$_BADPARAM, R0
        BBC     #0, 8(AP), 5$
        MOVZWL  @12(AP), R1
        BEQL    90$
        CMPL    R1, #12
        BGTRU   90$
5$:     MOVL    4(AP), R0
        MOVZWL  (R0), R2
        MOVL    4(R0), R1
        BSBW    FIL$SELECT
        BLBC    R0, 90$
        MOVL    F11$GL_VCB, R11
        MOVL    #SS$_DEVNOTMOUNT, R0
        BBC     #VCB$V_MOUNTED, VCB$L_STATUS(R11), 90$
        MOVL    #SS$_WRITLCK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R11), 90$
        MOVL    #ARM$M_CONTROL, R0
        MOVL    VCB$L_OWNER(R11), R1
        MOVZWL  VCB$W_PROT(R11), R2
        BSBW    FIL$CHKPRO
        BLBC    R0, 90$
        MOVL    #2, R10                 ; the VBN
        MOVL    #3, R9                  ; past the last copy, as the first says
        CLRL    R8                      ; the copies written
10$:    MOVL    R10, R0
        MOVL    #1, R1
        MOVAB   BITBLK, R2
        MOVAB   VCB$AB_INDEXF(R11), R3
        BSBW    FIL$READVBN
        BLBC    R0, 90$
        BSBW    ISHOME
        BLBC    R0, 30$
        TSTL    R8
        BNEQ    20$
        MOVZWL  BITBLK+HM2$W_ALTIDXVBN, R9
        CMPW    BITBLK+HM2$W_IBMAPVBN, R9
        BGEQU   20$
        MOVZWL  BITBLK+HM2$W_IBMAPVBN, R9
20$:    BSBW    NEWHOME
        MOVL    R10, R0
        MOVL    #1, R1
        MOVAB   BITBLK, R2
        MOVAB   VCB$AB_INDEXF(R11), R3
        BSBW    FIL$WRITEVBN
        BLBC    R0, 90$
        INCL    R8
30$:    INCL    R10
        CMPL    R10, R9
        BLSSU   10$
        MOVL    #SS$_NOHOMEBLK, R0
        TSTL    R8
        BEQL    90$
        BBC     #1, 8(AP), 40$          ; the VCB, as the last copy has them
        MOVL    BITBLK+HM2$L_VOLOWNER, VCB$L_OWNER(R11)
40$:    BBC     #2, 8(AP), 50$
        MOVW    BITBLK+HM2$W_PROTECT, VCB$W_PROT(R11)
50$:    BBC     #0, 8(AP), 80$
        MOVL    #12, R0                 ; the label, without its trailing blanks
55$:    CMPB    BITBLK+HM2$T_VOLNAME-1[R0], #^A/ /
        BNEQ    60$
        SOBGTR  R0, 55$
60$:    MOVB    R0, VCB$T_VOLNAME(R11)
        MOVC3   R0, BITBLK+HM2$T_VOLNAME, VCB$T_VOLNAME+1(R11)
80$:    MOVL    #SS$_NORMAL, R0
90$:    BSBW    FIL$UNLOCK
        RET

; ISHOME: BITBLK = a block. R0 = 1 if it is a Files-11 ODS-2 home block,
; by its format, else 0. Uses R1.
ISHOME:
        .JSB_ENTRY
        CLRL    R1
10$:    CMPB    BITBLK+HM2$T_FORMAT[R1], FORMAT[R1]
        BNEQ    80$
        AOBLSS  #10, R1, 10$
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; NEWHOME: BITBLK = a home block, AP = FIL$SETVOLUME's arguments. Gives
; it what they say, and its checksums. Uses R0-R5.
NEWHOME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BBC     #0, 8(AP), 10$
        MOVL    12(AP), R0
        MOVC5   (R0), @4(R0), #^A/ /, #12, BITBLK+HM2$T_VOLNAME
10$:    BBC     #1, 8(AP), 20$
        MOVL    16(AP), BITBLK+HM2$L_VOLOWNER
20$:    BBC     #2, 8(AP), 30$
        MCOMW   22(AP), R0
        BICW2   R0, BITBLK+HM2$W_PROTECT
        BISW2   20(AP), BITBLK+HM2$W_PROTECT
30$:    BBC     #3, 8(AP), 40$
        MCOMW   26(AP), R0
        BICW2   R0, BITBLK+HM2$W_FILEPROT
        BISW2   24(AP), BITBLK+HM2$W_FILEPROT
40$:    MOVAB   BITBLK, R1
        MOVL    #29, R2
        BSBW    CHECKSUM
        MOVW    R0, BITBLK+HM2$W_CHECKSUM1
        MOVL    #255, R2
        BSBW    CHECKSUM
        MOVW    R0, BITBLK+HM2$W_CHECKSUM2
        RSB

; RESHDR: R1 = a reserved file's empty header, R10 = its RESFILES row.
; Gives it its name, version 1, record attributes and blocks, the
; volume's owner, MFDPROT for the MFD, and writes it. R0 = SS$_NORMAL or
; the disk's error. Uses R0-R7.
RESHDR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        MOVL    R10, R6
        MOVL    #10, R7
        MOVL    #1, R4
        BSBW    FIL$SETNAME
        MOVL    R1, R3
        MOVL    VOLOWNER, FH2$L_FILEOWNER(R3)
        MOVB    10(R10), FAT$B_RTYPE(R3)
        MOVB    11(R10), FAT$B_RATTRIB(R3)
        MOVW    12(R10), FAT$W_RSIZE(R3)
        MOVW    12(R10), FAT$W_MAXREC(R3)
        MOVZWL  14(R10), FH2$L_FILECHAR(R3)
        MOVZWL  18(R10), R1             ; its blocks
        BEQL    10$
        MOVZWL  16(R10), R2
        BSBW    ADDMAP
        BLBC    R0, 90$
        MOVL    R1, R0
        BSBW    PUTHIBLK
10$:    INCL    R1                      ; the end of file: past them,
        BITW    #FCH$M_DIRECTORY, 14(R10)
        BEQL    20$
        MOVL    #1, R1                  ; but the MFD's is FIL$ENTER's
        MOVW    #MFDPROT, FH2$W_FILEPROT(R3)
20$:    ROTL    #16, R1, FAT$L_EFBLK(R3)
        MOVL    R3, R1
        BSBW    FIL$WRITEHDR
90$:    RSB

; $INIT_VOL devnam, volnam, itmlst: writes an empty Files-11 ODS-2
; volume labelled volnam, up to 12 characters, on the disk devnam names,
; DKB0:, the data disk, or MDA0:, the ramdisk, which is made afresh
; first, zeroed. The volume is the disk's size, which the PAL gives
; (GETMAXBLOCK). The disk mustn't be mounted. The item list may give
; INIT$_OWNER, the volume's owner, the caller's UIC by default, and
; INIT$_VOLPRO, its protection, 0 by default, which lets all use it.
; SS$_WRITLCK for DKA0:, SS$_DEVMOUNT if a volume is mounted there,
; SS$_BADPARAM for a label too long or empty, or an item too short,
; SS$_INSFMEM if there isn't the memory for the ramdisk, SS$_NOPRIV for a
; volume someone else owns, without VOLPRO, SS$_MEDOFL without the disk,
; SS$_DEVICEFULL if it is too small for a volume.
; ponytail: no other items.
        .ENTRY  EXE$INIT_VOL, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    4(AP), R6               ; devnam
        IFNORD  #8, (R6), 85$
        MOVZWL  (R6), R7
        MOVL    4(R6), R6
        IFNORD  R7, (R6), 85$
        MOVL    8(AP), R8               ; volnam
        IFNORD  #8, (R8), 85$
        MOVZWL  (R8), R9
        MOVL    4(R8), R8
        IFNORD  R9, (R8), 85$
        MOVL    #SS$_BADPARAM, R0
        TSTL    R9
        BEQL    90$
        CMPL    R9, #12
        BGTRU   90$
        BSBW    FIL$LOCK
        MOVL    SCH$GL_CURPCB, R1
        MOVL    PCB$L_UIC(R1), VOLOWNER
        CLRL    VOLPROT
        MOVL    12(AP), R10             ; itmlst
        BEQL    45$
        BSBW    INITITEMS
        BLBC    R0, 80$
45$:    MOVL    R6, R1
        MOVL    R7, R2
        BSBW    FIL$SELECT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        MOVL    #SS$_DEVMOUNT, R0
        BBS     #VCB$V_MOUNTED, VCB$L_STATUS(R1), 80$
        MOVL    #SS$_WRITLCK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 80$
        BSBW    OWNVOL
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        BBS     #VCB$V_RAMDISK, VCB$L_STATUS(R1), 47$
        MOVZBL  VCB$B_UNIT(R1), R0
        CALL_PAL #PAL$_GETMAXBLOCK
        MOVL    R0, R3
        MOVL    #SS$_MEDOFL, R0
        TSTL    R3
        BEQL    80$
        BRB     50$
47$:    BSBW    MD$CREATE
        BLBC    R0, 80$
        MOVL    MD$GL_BLOCKS, R3
50$:    MOVL    R8, R1
        MOVL    R9, R2
        MOVL    VOLOWNER, R4
        MOVL    VOLPROT, R5
        BSBW    FIL$INIT
80$:    BSBW    FIL$UNLOCK
        RET
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

; INITITEMS: R10 = $INIT_VOL's item list. Takes INIT$_OWNER into VOLOWNER
; and INIT$_VOLPRO into VOLPROT, and skips the others. R0 = SS$_NORMAL,
; SS$_ACCVIO if the caller can't read it, or SS$_BADPARAM for an item
; too short. Uses R0-R2 and R10.
INITITEMS:
        .JSB_ENTRY  SCRATCH=<R2, R10>
10$:    IFNORD  #4, (R10), 85$
        TSTL    (R10)
        BEQL    70$
        IFNORD  #12, (R10), 85$
        MOVZWL  (R10), R2
        MOVL    4(R10), R1
        IFNORD  R2, (R1), 85$
        CMPW    2(R10), #INIT$_OWNER
        BNEQ    20$
        CMPL    R2, #4
        BLSSU   87$
        MOVL    (R1), VOLOWNER
        BRB     30$
20$:    CMPW    2(R10), #INIT$_VOLPRO
        BNEQ    30$
        CMPL    R2, #2
        BLSSU   87$
        MOVZWL  (R1), VOLPROT
30$:    ADDL2   #12, R10
        BRB     10$
70$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
        RSB
87$:    MOVL    #SS$_BADPARAM, R0
        RSB

; OWNVOL: F11$GL_VCB = a disk with no volume mounted. R0 = SS$_NORMAL if
; the current process may write another volume there: with VOLPRO, or if
; the volume there is its own, as its home block says, or if there is
; none, else SS$_NOPRIV. Holding FIL$LOCK. Uses R0-R2.
OWNVOL:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVL    SCH$GL_CURPCB, R2
        IFPRIV  VOLPRO, 70$, R2
        MOVAB   BITBLK, R0
        MOVL    #1, R1
        PUSHL   R2
        MOVL    #1, R2                  ; the home block
        BSBW    FIL$READLBLK
        MOVL    (SP)+, R2
        BLBC    R0, 70$                 ; no disk yet: the ramdisk
        CLRL    R1
10$:    CMPB    BITBLK+HM2$T_FORMAT[R1], FORMAT[R1]
        BNEQ    70$                     ; no volume
        AOBLSS  #10, R1, 10$
        CMPL    BITBLK+HM2$L_VOLOWNER, PCB$L_UIC(R2)
        BEQL    70$
        MOVL    #SS$_NOPRIV, R0
        RSB
70$:    MOVL    #SS$_NORMAL, R0
        RSB

        .END
