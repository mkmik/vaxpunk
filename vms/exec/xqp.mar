        .TITLE  XQP     The file system's $QIO functions on disk channels
        .IDENT  /V0.1/
;
; A program asks the file system for a file's attributes, or changes
; them, as VMS's asks its XQP (docs/adr/0039-xqp-qio-functions.md): a
; $QIO on a channel to the disk, IO$_ACCESS to read them, IO$_MODIFY to
; write them. p1 is a FIB's descriptor ($FIBDEF), which names the file
; by its ID, FIB$W_FID, or by a name in a directory, FIB$W_DID: p2's
; name, NAME.TYPE;VER, the highest version without one, or with
; FIB$M_FINDFID the entry for FIB$W_FID itself. p5 is an attribute list
; ($ATRDEF), descriptors of the attributes to read or write, a longword
; of 0 after the last. IO$_MODIFY of a file named in a directory with
; FIB$W_VERLIMIT not 0 gives its name that version limit, in the
; directory, which takes write access to it. The FIB comes back with the
; file's ID and its name's version limit. DK$FDT makes the IRP; $QIO calls XQP$PERFORM
; once IPL is back below IPL$_SYNCH, in the process, as VMS's XQP runs
; in the process that asked, and it completes the IRP: the IOSB gets the
; status.
; Reading needs read or control access to the file, looking a name up
; execute access to its directory. Writing an owner, protection or date
; needs control access, a new owner the system's, and the
; characteristics or record attributes write access. A write marks the
; file revised, now, as the XQP does; the size the file is allocated
; and the characteristics the file system keeps, contiguous, directory,
; marked for delete, stay as they are.
; vaxpunk: VMS's IO$_MODIFY of the characteristics or the record
; attributes checks no access; and it writes a file that is open,
; where here that is SS$_ACCONFLICT, since RMS writes its own copy of
; the header back. VMS's SET FILE opens the file first, for itself
; alone, and gets the same.
; The ACL attributes change the file's ACL (f11acl.mar), in order, at
; the position FIB$L_ACLCTX holds, the number of an ACE from 1, which
; they move on and the FIB brings back: ADDACLENT puts ACEs before the
; one there, each in place of one that matches it (ACLMATCH), unless that
; one comes before, DELACLENT deletes the one that matches, FNDACLENT
; finds it, DELETEACL deletes all but the PROTECTED ones and DELETE_ALL
; all of them; READACL reads the whole ACEs from the position, READACE
; the next one, and ACLLENGTH the ACL's bytes. Their status, the first
; failure's, goes in FIB$L_ACL_STATUS, and the IOSB's is SS$_NORMAL, as
; on VMS. Changing the ACL takes control access.
; ponytail: no IO$M_ACCESS, files opened on the channel, IO$_DEACCESS,
; IO$_CREATE, IO$_DELETE or IO$_ACPCONTROL; a name with wildcards finds
; its first match, with no FIB$L_WCC to go on from, and no result
; string, p3 and p4. The attributes are those of $ATRDEF; others are
; SS$_BADATTRIB.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $IPLDEF
        $SSDEF
        $RMSDEF
        $VCBDEF
        $UCBDEF
        $IRPDEF
        $IODEF
        $ARMDEF
        $FIBDEF
        $ATRDEF
        $ACEDEF

        .EXTERNAL F11$GL_VCB, F11$GW_FID, EXE$GQ_SYSTIME, EXE$PROBER_DSC
        .EXTERNAL FIL$LOCK, FIL$UNLOCK, FIL$READHDR, FIL$WRITEHDR, FIL$ISDIR
        .EXTERNAL FIL$SEARCHDIR, FIL$CHKHDR, FIL$SETLIMIT, IOC$REQCOM, RMS$FILEBUSY
        .EXTERNAL FIL$ACLGET, FIL$ACLPUT

BLOCK = 512
MAXATR = 30                             ; descriptors in a list, at most
FH2$B_IDOFFSET = 0                      ; a file header: the ident area, in words
FH2$W_FID_SEQ = 10
FH2$W_RECATTR = 20
FAT$L_HIBLK = 4                         ; in it: the blocks allocated
FH2$L_FILECHAR = 52
FH2$L_FILEOWNER = 60
FI2$W_REVISION = 20                     ; in the ident area
FI2$Q_REVDATE = 30
FCH$M_KEEP = ^X1F080                    ; the characteristics the file system keeps:
                                        ; CONTIG, SPOOL, DIRECTORY, BADBLOCK, MARKDEL, NOCHARGE
; An attribute's class, in ATRS.
RO = 1                                  ; read only: a write leaves it
CTL = 2                                 ; a write takes control access
WRT = 4                                 ; a write takes write access
IDENT = 8                               ; its offset is in the ident area
ACL = 16                                ; ACLOP does it, at the offset in ACLOPS
OUT = 32                                ; an ACL attribute that writes its buffer
ACLMAX = 512                            ; an ACL's bytes, at most

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
XQP$GL_IRP::                            ; the IRP DK$FDT made, for $QIO to hand XQP$PERFORM, or 0
        .LONG   0
; Each attribute: its code, class, size and offset in the header.
ATRS:   .BYTE   ATR$C_UCHAR, WRT
        .WORD   ATR$S_UCHAR, FH2$L_FILECHAR
        .BYTE   ATR$C_RECATTR, WRT
        .WORD   ATR$S_RECATTR, FH2$W_RECATTR
        .BYTE   ATR$C_HEADER, RO
        .WORD   ATR$S_HEADER, 0
        .BYTE   ATR$C_CREDATE, CTL!IDENT
        .WORD   ATR$S_CREDATE, 22
        .BYTE   ATR$C_REVDATE, CTL!IDENT
        .WORD   ATR$S_REVDATE, FI2$Q_REVDATE
        .BYTE   ATR$C_EXPDATE, CTL!IDENT
        .WORD   ATR$S_EXPDATE, 38
        .BYTE   ATR$C_BAKDATE, CTL!IDENT
        .WORD   ATR$S_BAKDATE, 46
        .BYTE   ATR$C_UIC, CTL
        .WORD   ATR$S_UIC, FH2$L_FILEOWNER
        .BYTE   ATR$C_FPRO, CTL
        .WORD   ATR$S_FPRO, 64
        .BYTE   ATR$C_UIC_RO, RO
        .WORD   ATR$S_UIC_RO, FH2$L_FILEOWNER
        .BYTE   ATR$C_ADDACLENT, ACL!CTL
        .WORD   ATR$S_ADDACLENT, ADDACE-ACLOPS
        .BYTE   ATR$C_DELACLENT, ACL!CTL
        .WORD   ATR$S_DELACLENT, DELACE-ACLOPS
        .BYTE   ATR$C_FNDACLENT, ACL!RO
        .WORD   ATR$S_FNDACLENT, FNDACE-ACLOPS
        .BYTE   ATR$C_DELETEACL, ACL!CTL
        .WORD   ATR$S_DELETEACL, DELACL-ACLOPS
        .BYTE   ATR$C_DELETE_ALL, ACL!CTL
        .WORD   ATR$S_DELETE_ALL, DELALL-ACLOPS
        .BYTE   ATR$C_READACL, ACL!RO!OUT
        .WORD   ATR$S_READACL, READACL-ACLOPS
        .BYTE   ATR$C_ACLLENGTH, ACL!RO!OUT
        .WORD   ATR$S_ACLLENGTH, ACLLEN-ACLOPS
        .BYTE   ATR$C_READACE, ACL!RO!OUT
        .WORD   ATR$S_READACE, READACE-ACLOPS
        .BYTE   0
FIB:    .BLKB   FIB$C_LENGTH            ; the caller's, made whole with 0s
FIBLEN: .LONG   0                       ; its length, up to FIB$C_LENGTH
DIRHDR: .BLKB   BLOCK                   ; the directory's header
HDR:    .BLKB   BLOCK                   ; the file's
AFTER:  .WORD   0                       ; FIL$SEARCHDIR's entry to go on after: its version,
        .BLKB   1+80                    ; its name, .ASCIC
NAME:   .BLKB   80                      ; p2's name, without its version
ENTNAME:                                ; the name of the entry FINDFILE found, NAME.TYPE,
        .BLKB   80
ENTLEN: .LONG   0                       ; and its length, 0 if it found none
NEWLIM: .LONG   0                       ; IO$_MODIFY's FIB$W_VERLIMIT: the name's new version limit, or 0
ACLBUF: .BLKB   ACLMAX                  ; the file's ACL, while the ACL attributes work on it
ACLBYTES:                               ; its bytes
        .LONG   0
ACLDIRTY:                               ; 1 once they change it
        .LONG   0

        .PSECT  $CODE$

; XQP$PERFORM: R3 = an IRP DK$FDT made for IO$_ACCESS or IO$_MODIFY, R5
; = the disk's UCB, AP = $QIO's arguments. Does it, holding FIL$LOCK,
; writes the FIB back, and completes the IRP with the status:
; SS$_NORMAL; SS$_DEVNOTMOUNT; SS$_INSFARG for a FIB shorter than
; FIB$C_ACCDATA; SS$_ACCVIO; SS$_NOSUCHFILE; SS$_BADIRECTORY if FIB$W_DID
; isn't a directory; SS$_BADATTRIB; SS$_BADPARAM for a bad name or a
; version limit above 32767;
; SS$_NOPRIV; SS$_WRITLCK; SS$_ACCONFLICT; or the disk's error. Below
; IPL$_SYNCH. Keeps every register but R0.
XQP$PERFORM::
        .JSB_ENTRY  INPUT=<R3, R5, AP>
        PUSHR   #^M<R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    R3, R11
        BSBW    FIL$LOCK
        MOVL    UCB$L_VCB(R5), R0
        BEQL    5$
        BBS     #VCB$V_MOUNTED, VCB$L_STATUS(R0), 10$
5$:     MOVL    #SS$_DEVNOTMOUNT, R0
        BRB     80$
10$:    MOVL    R0, F11$GL_VCB
        BSBW    GETFIB
        BLBC    R0, 80$
        MOVL    #SS$_NORMAL, FIB+FIB$L_ACL_STATUS
        MOVZWL  FIB+FIB$W_VERLIMIT, NEWLIM
        BSBW    FINDFILE
        BLBC    R0, 80$
        BICL3   #^C63, IRP$L_FUNC(R11), R0
        CMPL    R0, #IO$_MODIFY
        BEQL    20$
        BSBW    READATTR
        BRB     70$
20$:    MOVL    #SS$_BADPARAM, R0
        CMPL    NEWLIM, #32767
        BGTRU   80$
        BSBW    WRITEATTR
        BLBC    R0, 80$
        BSBW    SETLIMIT
70$:    BLBC    R0, 80$
        MOVL    FIBLEN, R1              ; the FIB back
        MOVL    28(AP), R2
        MOVL    4(R2), R2
        IFNOWRT R1, (R2), 75$
        MOVC3   R1, FIB, (R2)
        MOVL    #SS$_NORMAL, R0
        BRB     80$
75$:    MOVL    #SS$_ACCVIO, R0
80$:    BSBW    FIL$UNLOCK
        DSBINT  #IPL$_SYNCH
        CLRL    R1
        MOVL    R11, R3
        BSBW    IOC$REQCOM
        ENBINT
        POPR    #^M<R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

; GETFIB: AP = $QIO's arguments. Copies p1's FIB into FIB, the bytes
; past its end 0, and its length, up to FIB$C_LENGTH, into FIBLEN. R0 =
; SS$_NORMAL, SS$_INSFARG, or SS$_ACCVIO. Uses R0-R5.
GETFIB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    28(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R0
        CMPL    R0, #FIB$C_LENGTH
        BLEQU   10$
        MOVL    #FIB$C_LENGTH, R0
10$:    MOVL    R0, FIBLEN
        MOVL    #SS$_INSFARG, R0
        CMPL    FIBLEN, #FIB$C_ACCDATA
        BLSSU   90$
        MOVC5   FIBLEN, @4(R1), #0, #FIB$C_LENGTH, FIB
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; FINDFILE: FIB names a file. With a directory, FIB$W_DID, looks its entry
; up there, by p2's name or, with FIB$M_FINDFID, by FIB$W_FID, and puts
; its ID in FIB$W_FID, its version limit in FIB$W_VERLIMIT and its name in
; ENTNAME. Reads its header into HDR. R0 = SS$_NORMAL, SS$_NOSUCHFILE, SS$_BADIRECTORY,
; SS$_BADPARAM, SS$_NOPRIV, SS$_ACCVIO, or the disk's error. Uses R0-R10.
FINDFILE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10>
        CLRL    ENTLEN
        TSTW    FIB+FIB$W_DID_NUM
        BNEQ    10$
        TSTB    FIB+FIB$B_DID_NMX
        BNEQ    10$
        BRW     60$
10$:    MOVZBL  FIB+FIB$B_DID_NMX, R0   ; the directory
        ASHL    #16, R0, R0
        MOVW    FIB+FIB$W_DID_NUM, R0
        MOVZWL  FIB+FIB$W_DID_SEQ, R2
        MOVAB   DIRHDR, R1
        BSBW    READFID
        BLBC    R0, 95$
        MOVL    #SS$_BADIRECTORY, R0
        MOVAB   DIRHDR, R1
        BSBW    FIL$ISDIR
        BLBC    R0, 95$
        MOVL    #ARM$M_EXECUTE, R0
        MOVAB   DIRHDR, R1
        BSBW    FIL$CHKHDR
        BLBC    R0, 95$
        MOVAB   DIRHDR, R3
        CLRL    R9
        BBS     #FIB$V_FINDFID, FIB+FIB$W_NMCTL, 30$
        BSBW    GETNAME
        BLBC    R0, 95$
        MOVAB   DIRHDR, R3
        BSBW    FIL$SEARCHDIR
        BLBC    R0, 80$
        BRB     50$
30$:    MOVAB   STAR, R6                ; FINDFID: every entry, until its
        MOVL    #1, R7
        MNEGL   #1, R8
40$:    BSBW    FIL$SEARCHDIR
        BLBC    R0, 80$
        CMPL    F11$GW_FID, FIB+FIB$W_FID
        BNEQ    45$
        CMPW    F11$GW_FID+4, FIB+FIB$W_FID+4
        BEQL    50$
45$:    MOVAB   AFTER, R9               ; on after this one
        MOVW    R4, (R9)
        MOVB    R2, 2(R9)
        MOVC3   R2, (R1), 3(R9)
        MOVAB   DIRHDR, R3
        BRB     40$
50$:    MOVW    -4(R1), FIB+FIB$W_VERLIMIT      ; its record's DIR$W_VERLIMIT
        MOVL    F11$GW_FID, FIB+FIB$W_FID
        MOVW    F11$GW_FID+4, FIB+FIB$W_FID+4
        MOVL    R2, ENTLEN
        MOVC3   R2, (R1), ENTNAME
60$:    MOVZBL  FIB+FIB$B_FID_NMX, R0   ; the file
        ASHL    #16, R0, R0
        MOVW    FIB+FIB$W_FID_NUM, R0
        MOVZWL  FIB+FIB$W_FID_SEQ, R2
        MOVAB   HDR, R1
        BSBW    READFID
        BRB     95$
80$:    CMPL    R0, #SS$_NOMOREFILES
        BNEQ    95$
        MOVL    #SS$_NOSUCHFILE, R0
95$:    RSB

STAR:   .ASCII  "*"

; READFID: R0 = a file number, R1 = a buffer, R2 = the sequence number
; the FIB gives the file. Reads its header there. R0 = SS$_NORMAL,
; SS$_NOSUCHFILE if it is another file's, or FIL$READHDR's error. Uses R0.
READFID:
        .JSB_ENTRY
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        CMPW    FH2$W_FID_SEQ(R1), R2
        BEQL    90$
        MOVL    #SS$_NOSUCHFILE, R0
90$:    RSB

; GETNAME: AP = $QIO's arguments. Takes p2's name, NAME.TYPE;VER or
; NAME.TYPE.VER, the version absent or empty for the highest, * for any:
; R6 = the name, in capitals, in NAME, R7 = its length, R8 = the version,
; 0 the highest, -1 any. R0 = SS$_NORMAL, SS$_BADPARAM, or SS$_ACCVIO.
; Uses R0-R8.
GETNAME:
        .JSB_ENTRY  OUTPUT=<R6, R7, R8>, SCRATCH=<R2, R3, R4, R5>
        MOVL    32(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2                ; what is left of it
        MOVL    4(R1), R3
        MOVAB   NAME, R6
        CLRL    R7
        CLRL    R4                      ; the dots
10$:    TSTL    R2
        BEQL    50$
        MOVZBL  (R3)+, R0
        DECL    R2
        CMPB    R0, #^A";"
        BEQL    30$
        CMPB    R0, #^A/./
        BNEQ    20$
        INCL    R4
        CMPL    R4, #2
        BEQL    30$
20$:    CMPB    R0, #^A/a/
        BLSSU   25$
        CMPB    R0, #^A/z/
        BGTRU   25$
        SUBB2   #^A/a/-^A/A/, R0
25$:    CMPL    R7, #80
        BGEQU   80$
        MOVB    R0, (R6)[R7]
        INCL    R7
        BRB     10$
30$:    CLRL    R8                      ; the version
        TSTL    R2
        BEQL    60$
        CMPL    R2, #1
        BNEQ    40$
        CMPB    (R3), #^A/*/
        BNEQ    40$
        MNEGL   #1, R8
        BRB     60$
40$:    MOVZBL  (R3)+, R0
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BGTRU   80$
        MULL2   #10, R8
        ADDL2   R0, R8
        CMPL    R8, #32767
        BGTRU   80$
        SOBGTR  R2, 40$
        BRB     60$
50$:    CLRL    R8
60$:    TSTL    R7
        BEQL    80$
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADPARAM, R0
90$:    RSB

; READATTR: AP = $QIO's arguments, HDR = the file's header. Copies each
; attribute p5's list asks for where it says, after a check that the
; process may read the file, or control it; of the ACL attributes, those
; that read. R0 = SS$_NORMAL, SS$_NOPRIV, SS$_BADATTRIB, or SS$_ACCVIO.
; Uses R0-R10.
READATTR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10>
        MOVL    44(AP), R6
        BEQL    80$
        MOVL    #ARM$M_READ, R0
        MOVAB   HDR, R1
        BSBW    FIL$CHKHDR
        BLBS    R0, 5$
        MOVL    #ARM$M_CONTROL, R0
        BSBW    FIL$CHKHDR
        BLBC    R0, 90$
5$:     BSBW    LOADACL
        MOVL    #MAXATR+1, R7
10$:    BSBW    NEXTATR
        BLBC    R0, 90$
        TSTL    R8
        BEQL    80$
        BBC     #4, 1(R8), 20$          ; ACL
        BBC     #0, 1(R8), 15$          ; one that changes it: not here
        BSBW    ACLOP
        BLBC    R0, 90$
15$:    ADDL2   #8, R6
        BRB     10$
20$:    IFNOWRT R10, @ATR$L_ADDR(R6), 85$
        MOVC3   R10, (R9), @ATR$L_ADDR(R6)
        ADDL2   #8, R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; WRITEATTR: AP = $QIO's arguments, HDR = the file's header. Checks the
; attributes in p5's list, the volume, that no stream has the file open
; and the access the process needs, then gives the file each of them,
; marks it revised and writes its header. R0 = SS$_NORMAL, SS$_BADATTRIB,
; SS$_ACCVIO, SS$_WRITLCK, SS$_ACCONFLICT, SS$_INSFMEM, SS$_NOPRIV, or
; the disk's error. Uses R0-R10.
WRITEATTR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10>
        CLRL    R5                      ; the access it takes
        MOVL    44(AP), R6
        BNEQ    5$
        BRW     80$
5$:     MOVL    #MAXATR+1, R7
10$:    PUSHL   R5
        BSBW    NEXTATR
        MOVL    (SP)+, R5
        BLBC    R0, 15$
        TSTL    R8
        BEQL    30$
        IFNORD  R10, @ATR$L_ADDR(R6), 85$
        BBS     #0, 1(R8), 25$          ; RO
        BBC     #1, 1(R8), 20$          ; CTL
        BISL2   #ARM$M_CONTROL, R5
20$:    BBC     #2, 1(R8), 22$          ; WRT
        BISL2   #ARM$M_WRITE, R5
22$:    CMPB    (R8), #ATR$C_UIC        ; another owner: the system's
        BNEQ    25$
        CMPL    R10, #ATR$S_UIC
        BNEQ    25$
        CMPL    @ATR$L_ADDR(R6), HDR+FH2$L_FILEOWNER
        BEQL    25$
        BISL2   #ARM$M_SYSTEM, R5
25$:    ADDL2   #8, R6
        BRB     10$
15$:    RSB
30$:    TSTL    R5
        BNEQ    35$
        BRW     80$                     ; nothing to write
35$:    MOVL    F11$GL_VCB, R1
        MOVL    #SS$_WRITLCK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVL    R5, R0
        MOVAB   HDR, R1
        BSBW    FIL$CHKHDR
        BLBC    R0, 90$
        MOVAB   HDR, R2
        BSBW    RMS$FILEBUSY
        BLBS    R0, 40$
        CMPL    R0, #RMS$_FLK
        BNEQ    38$
        MOVL    #SS$_ACCONFLICT, R0
        RSB
38$:    MOVL    #SS$_INSFMEM, R0
        RSB
40$:
        MOVZBL  HDR+FH2$B_IDOFFSET, R0  ; revised now
        MOVAW   HDR[R0], R0
        MOVQ    EXE$GQ_SYSTIME, FI2$Q_REVDATE(R0)
        INCW    FI2$W_REVISION(R0)
        BSBW    LOADACL
        PUSHL   HDR+FH2$L_FILECHAR      ; what it keeps
        PUSHL   HDR+FH2$W_RECATTR+FAT$L_HIBLK
        MOVL    44(AP), R6
        MOVL    #MAXATR+1, R7
50$:    BSBW    NEXTATR
        TSTL    R8
        BEQL    60$
        BBC     #4, 1(R8), 52$          ; ACL
        BSBW    ACLOP
        BLBS    R0, 55$
        ADDL2   #8, SP
        RSB
52$:    BBS     #0, 1(R8), 55$          ; RO
        MOVC3   R10, @ATR$L_ADDR(R6), (R9)
55$:    ADDL2   #8, R6
        BRB     50$
60$:    MOVL    (SP)+, HDR+FH2$W_RECATTR+FAT$L_HIBLK
        MOVL    (SP)+, R0
        BICL2   #FCH$M_KEEP, HDR+FH2$L_FILECHAR
        BICL2   #^C<FCH$M_KEEP>, R0
        BISL2   R0, HDR+FH2$L_FILECHAR
        BLBC    ACLDIRTY, 70$           ; the ACL, if it changed
        MOVAB   HDR, R1
        MOVAB   ACLBUF, R2
        MOVL    ACLBYTES, R3
        BSBW    FIL$ACLPUT
        BSBW    ACLSTATUS
70$:    MOVAB   HDR, R1
        BSBW    FIL$WRITEHDR
        RSB
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; SETLIMIT: NEWLIM = IO$_MODIFY's version limit, ENTNAME the name
; FINDFILE found in DIRHDR's directory. Gives the name that limit, which
; takes write access to the directory, and puts it in FIB$W_VERLIMIT.
; Nothing without a limit or a name. R0 = SS$_NORMAL, SS$_WRITLCK,
; SS$_NOPRIV, or FIL$SETLIMIT's error. Uses R0-R8.
SETLIMIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8>
        MOVL    #SS$_NORMAL, R0
        TSTL    NEWLIM
        BEQL    90$
        TSTL    ENTLEN
        BEQL    90$
        MOVL    F11$GL_VCB, R1
        MOVL    #SS$_WRITLCK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   DIRHDR, R1
        BSBW    FIL$CHKHDR
        BLBC    R0, 90$
        MOVAB   DIRHDR, R3
        MOVAB   ENTNAME, R6
        MOVL    ENTLEN, R7
        MOVL    NEWLIM, R8
        BSBW    FIL$SETLIMIT
        BLBC    R0, 90$
        MOVW    NEWLIM, FIB+FIB$W_VERLIMIT
90$:    RSB

; LOADACL: HDR = the file's header. Copies its ACL into ACLBUF, its bytes
; into ACLBYTES, for the ACL attributes, which haven't changed it yet.
; Uses R0.
LOADACL:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2>
        MOVAB   HDR, R1
        MOVAB   ACLBUF, R2
        BSBW    FIL$ACLGET
        MOVL    R0, ACLBYTES
        CLRL    ACLDIRTY
        POPR    #^M<R1, R2>
        RSB

; ACLOP: R6 = an ACL attribute's descriptor, R8 = its entry in ATRS, R10
; = its size. Checks that the process may read its buffer, and write it
; if the attribute writes it, and calls its routine in ACLOPS with R1
; = the buffer, R2 = its size, which works on ACLBUF and FIB$L_ACLCTX,
; sets ACLDIRTY if it changes the ACL, and returns its status, which
; ACLSTATUS keeps. One that changes the ACL is skipped once one has
; failed. R0 = SS$_NORMAL, or SS$_ACCVIO. Uses R0-R5.
ACLOP:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    ATR$L_ADDR(R6), R1
        IFNORD  R10, (R1), 85$
        BBC     #5, 1(R8), 10$          ; OUT: it writes its buffer
        IFNOWRT R10, (R1), 85$
10$:    BBC     #1, 1(R8), 20$          ; CTL: it changes the ACL
        BLBC    FIB+FIB$L_ACL_STATUS, 80$
20$:    MOVL    R10, R2
        MOVZWL  4(R8), R0
        MOVAB   ACLOPS[R0], R0
        JSB     (R0)
        BSBB    ACLSTATUS
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
        RSB

; ACLSTATUS: R0 = an ACL attribute's status. Puts it in FIB$L_ACL_STATUS
; if it is a failure and the first. Keeps every register.
ACLSTATUS:
        .JSB_ENTRY
        BLBS    R0, 10$
        BLBC    FIB+FIB$L_ACL_STATUS, 10$
        MOVL    R0, FIB+FIB$L_ACL_STATUS
10$:    RSB

; The ACL attributes' routines: R1 = the attribute's buffer, R2 = its
; size, ACLBUF = the ACL, ACLBYTES its bytes, FIB$L_ACLCTX's bits 23:0
; the position, an ACE's number from 1, 0 the first. Each returns its
; status in R0, and uses R0-R5.
ACLOPS:

; ADDACE: puts each ACE in the buffer, up to one of size 0, before the
; one at the position, which then is past it; one that matches an ACE
; already there takes its place, unless that one comes before the
; position, when it is dropped. SS$_NORMAL, SS$_IVACL for an ACE that
; runs past the buffer or has no ACE's size, SS$_ACLFULL.
ADDACE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7>
        MOVL    R1, R6                  ; the next ACE
        ADDL3   R1, R2, R7              ; past the buffer
10$:    SUBL3   R6, R7, R0              ; the bytes left
        CMPL    R0, #4
        BLSSU   80$
        MOVZBL  (R6), R3
        BEQL    80$
        CMPL    R3, #4
        BLSSU   85$
        CMPL    R3, R0
        BGTRU   85$
        MOVL    R6, R1
        BSBW    ACLFIND                 ; one that matches?
        BSBW    ACLPOS                  ; and the position
        TSTL    R4
        BEQL    20$
        CMPL    R4, R5
        BLSSU   30$                     ; before: this one goes
        BSBW    ACLREMOVE
20$:    MOVL    R6, R1
        BSBW    ACLINSERT
        BLBC    R0, 90$
        ADDL3   #1, R5, FIB+FIB$L_ACLCTX        ; past it
30$:    MOVZBL  (R6), R0
        ADDL2   R0, R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
        BRB     90$
85$:    MOVL    #SS$_IVACL, R0
90$:    POPR    #^M<R6, R7>
        RSB

; DELACE: deletes the ACE that matches the buffer's; the position is the
; one after it. SS$_NORMAL, SS$_ACLEMPTY, SS$_NOENTRY.
DELACE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BSBW    ACEOK
        BLBC    R0, 90$
        MOVL    #SS$_ACLEMPTY, R0
        TSTL    ACLBYTES
        BEQL    90$
        BSBW    ACLFIND
        MOVL    #SS$_NOENTRY, R0
        TSTL    R4
        BEQL    90$
        BSBW    ACLREMOVE
        MOVL    R4, FIB+FIB$L_ACLCTX
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; FNDACE: the position becomes the ACE's that matches the buffer's, its
; type in FIB$L_ACLCTX's bits 31:24, else 0. SS$_NORMAL, SS$_ACLEMPTY,
; SS$_NOENTRY.
FNDACE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CLRL    FIB+FIB$L_ACLCTX
        BSBW    ACEOK
        BLBC    R0, 90$
        MOVL    #SS$_ACLEMPTY, R0
        TSTL    ACLBYTES
        BEQL    90$
        BSBW    ACLFIND
        MOVL    #SS$_NOENTRY, R0
        TSTL    R4
        BEQL    90$
        MOVL    R4, FIB+FIB$L_ACLCTX
        MOVB    ACE$B_TYPE(R2), FIB+FIB$L_ACLCTX+3
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; ACEOK: R1 = a buffer, R2 = its size. R0 = SS$_NORMAL if it holds an
; ACE, SS$_BADPARAM if it is shorter than 4 bytes, SS$_IVACL if the ACE
; is shorter, or runs past it. Keeps every other register.
ACEOK:
        .JSB_ENTRY
        MOVL    #SS$_BADPARAM, R0
        CMPL    R2, #4
        BLSSU   90$
        MOVL    #SS$_IVACL, R0
        CMPB    (R1), #4
        BLSSU   90$
        CMPB    (R1), R2
        BGTRU   90$
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; DELACL: deletes every ACE but the PROTECTED ones; the position is the
; first. SS$_NORMAL.
DELACL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAB   ACLBUF, R2
10$:    MOVAB   ACLBUF, R0
        ADDL2   ACLBYTES, R0
        CMPL    R2, R0
        BGEQU   80$
        BBS     #ACE$V_PROTECTED, ACE$W_FLAGS(R2), 20$
        BSBW    ACLREMOVE
        BRB     10$
20$:    MOVZBL  (R2), R0
        ADDL2   R0, R2
        BRB     10$
80$:    CLRL    FIB+FIB$L_ACLCTX
        MOVL    #SS$_NORMAL, R0
        RSB

; DELALL: deletes every ACE. SS$_NORMAL.
DELALL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        TSTL    ACLBYTES
        BEQL    10$
        CLRL    ACLBYTES
        MOVL    #1, ACLDIRTY
10$:    CLRL    FIB+FIB$L_ACLCTX
        MOVL    #SS$_NORMAL, R0
        RSB

; READACL: copies the whole ACEs from the one after the position that
; fit into the buffer, 0s after them; the position becomes the last's.
; SS$_NORMAL, SS$_ACLEMPTY, SS$_NOMOREACE past the last, SS$_BUFFEROVF
; if the first doesn't fit.
READACL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7, R8>
        MOVL    R1, R6
        MOVL    R2, R7
        MOVL    #SS$_ACLEMPTY, R0
        TSTL    ACLBYTES
        BEQL    90$
        EXTZV   #0, #24, FIB+FIB$L_ACLCTX, R0
        INCL    R0
        BSBW    ACLNTH
        MOVL    #SS$_NOMOREACE, R0
        TSTL    R4
        BEQL    90$
        MOVAB   ACLBUF, R3              ; past the ACL
        ADDL2   ACLBYTES, R3
        MOVL    R1, R2                  ; the first
        DECL    R4                      ; the last copied
10$:    CMPL    R2, R3
        BGEQU   20$
        MOVZBL  (R2), R0
        ADDL2   R2, R0
        SUBL3   R1, R0, R8              ; the bytes, with this one
        CMPL    R8, R7
        BGTRU   20$
        MOVL    R0, R2
        INCL    R4
        BRB     10$
20$:    SUBL3   R1, R2, R8
        BNEQ    30$
        MOVL    #SS$_BUFFEROVF, R0
        BRB     90$
30$:    MOVL    R4, FIB+FIB$L_ACLCTX
        MOVC5   R8, (R1), #0, R7, (R6)
        MOVL    #SS$_NORMAL, R0
90$:    POPR    #^M<R6, R7, R8>
        RSB

; ACLLEN: the ACL's bytes, a longword, as much of it as the buffer has
; room for. SS$_NORMAL.
ACLLEN:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVC5   #4, ACLBYTES, #0, R2, (R1)
        MOVL    #SS$_NORMAL, R0
        RSB

; READACE: copies the ACE after the position into the buffer, 0s after
; it, and makes the position its. SS$_NORMAL, SS$_ACLEMPTY, SS$_NOMOREACE
; past the last, SS$_BUFFEROVF if it doesn't fit.
READACE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7>
        MOVL    R1, R6
        MOVL    R2, R7
        MOVL    #SS$_ACLEMPTY, R0
        TSTL    ACLBYTES
        BEQL    90$
        EXTZV   #0, #24, FIB+FIB$L_ACLCTX, R0
        INCL    R0
        BSBW    ACLNTH
        MOVL    #SS$_NOMOREACE, R0
        TSTL    R4
        BEQL    90$
        MOVZBL  (R1), R2
        MOVL    #SS$_BUFFEROVF, R0
        CMPL    R2, R7
        BGTRU   90$
        MOVL    R4, FIB+FIB$L_ACLCTX
        MOVC5   R2, (R1), #0, R7, (R6)
        MOVL    #SS$_NORMAL, R0
90$:    POPR    #^M<R6, R7>
        RSB

; ACLNTH: R0 = an ACE's number, from 1. R1 = its address in ACLBUF, R4 =
; the number, or R1 = past the last and R4 = 0 if the ACL has fewer.
; Keeps every other register.
ACLNTH:
        .JSB_ENTRY  OUTPUT=<R4>
        PUSHR   #^M<R2, R3>
        MOVAB   ACLBUF, R1
        ADDL3   R1, ACLBYTES, R2
        MOVL    #1, R4
10$:    CMPL    R1, R2
        BGEQU   80$
        CMPL    R4, R0
        BGEQU   90$
        MOVZBL  (R1), R3
        ADDL2   R3, R1
        INCL    R4
        BRB     10$
80$:    CLRL    R4
90$:    POPR    #^M<R2, R3>
        RSB

; ACLPOS: FIB$L_ACLCTX's position, R5 = the ACE's number before which an
; ACE goes: 1 for 0, one past the last for one past it. Uses R0.
ACLPOS:
        .JSB_ENTRY  OUTPUT=<R5>
        PUSHR   #^M<R1, R2>
        EXTZV   #0, #24, FIB+FIB$L_ACLCTX, R5
        BNEQ    10$
        MOVL    #1, R5
10$:    MOVAB   ACLBUF, R1              ; how many there are
        ADDL3   R1, ACLBYTES, R2
        MOVL    #1, R0
20$:    CMPL    R1, R2
        BGEQU   30$
        MOVZBL  (R1), -(SP)
        ADDL2   (SP)+, R1
        INCL    R0
        BRB     20$
30$:    CMPL    R5, R0
        BLEQU   40$
        MOVL    R0, R5
40$:    POPR    #^M<R1, R2>
        RSB

; ACLFIND: R1 = an ACE. Looks in ACLBUF for one that matches it: the same
; type and, for a default protection ACE, nothing else; for an identifier
; ACE, the same identifiers, size and DEFAULT option, whatever its
; access and other options; any other the same bytes. R4 = its number,
; R2 = its address, or R4 = 0. Uses R0, R3.
ACLFIND:
        .JSB_ENTRY  OUTPUT=<R2, R4>, SCRATCH=<R3>
        MOVAB   ACLBUF, R2
        ADDL3   R2, ACLBYTES, R3
        MOVL    #1, R4
10$:    CMPL    R2, R3
        BGEQU   80$
        BSBB    ACLMATCH
        BLBS    R0, 90$
        MOVZBL  (R2), R0
        ADDL2   R0, R2
        INCL    R4
        BRB     10$
80$:    CLRL    R4
90$:    RSB

; ACLMATCH: R1 and R2 = two ACEs. R0 = 1 if they match, as ACLFIND says,
; else 0. Keeps every other register.
ACLMATCH:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4, R5>
        CLRL    R5                      ; no match
        CMPB    ACE$B_TYPE(R1), ACE$B_TYPE(R2)
        BNEQ    90$
        CMPB    ACE$B_TYPE(R1), #ACE$C_DIRDEF
        BEQL    80$
        CMPB    (R1), (R2)
        BNEQ    90$
        MOVZBL  (R1), R0
        CMPB    ACE$B_TYPE(R1), #ACE$C_KEYID
        BNEQ    50$
        CMPL    R0, #ACE$L_KEY
        BLSSU   50$
        XORW3   ACE$W_FLAGS(R1), ACE$W_FLAGS(R2), R3
        BITW    #ACE$M_DEFAULT!^XF, R3
        BNEQ    90$
        SUBL2   #ACE$L_KEY, R0          ; the identifiers
        CMPC3   R0, ACE$L_KEY(R1), ACE$L_KEY(R2)
        BNEQ    90$
        BRB     80$
50$:    CMPC3   R0, (R1), (R2)
        BNEQ    90$
80$:    MOVL    #1, R5
90$:    MOVL    R5, R0
        POPR    #^M<R1, R2, R3, R4, R5>
        RSB

; ACLREMOVE: R2 = an ACE in ACLBUF. Takes it out. Keeps every register.
ACLREMOVE:
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5>
        MOVZBL  (R2), R4
        ADDL3   R2, R4, R1              ; what follows it
        MOVAB   ACLBUF, R0
        ADDL2   ACLBYTES, R0
        SUBL2   R1, R0
        SUBL2   R4, ACLBYTES
        MOVC3   R0, (R1), (R2)
        MOVL    #1, ACLDIRTY
        POPR    #^M<R0, R1, R2, R3, R4, R5>
        RSB

; ACLINSERT: R1 = an ACE, R5 = the number of the one it goes before, at
; most one past the last. Puts it there. R0 = SS$_NORMAL, or SS$_ACLFULL
; if ACLBUF has no room. Keeps every other register.
ACLINSERT:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4, R5, R6, R7>
        MOVL    R1, R6
        MOVZBL  (R6), R7                ; its size
        ADDL3   ACLBYTES, R7, R0
        CMPL    R0, #ACLMAX
        BGTRU   80$
        MOVL    R5, R0
        BSBW    ACLNTH                  ; where: R1, or the end
        MOVAB   ACLBUF, R0              ; what moves up
        ADDL2   ACLBYTES, R0
        SUBL2   R1, R0
        ADDL3   R1, R7, R2
        PUSHL   R1
        MOVC3   R0, (R1), (R2)
        MOVL    (SP)+, R1
        MOVC3   R7, (R6), (R1)
        ADDL2   R7, ACLBYTES
        MOVL    #1, ACLDIRTY
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_ACLFULL, R0
90$:    POPR    #^M<R1, R2, R3, R4, R5, R6, R7>
        RSB

; NEXTATR: R6 = a descriptor in an attribute list, R7 = how many more
; may follow, plus one. R8 = its entry in ATRS, or 0 past the last; R9 =
; where the attribute is in HDR; R10 = its size. R0 = SS$_NORMAL,
; SS$_BADATTRIB for an attribute it doesn't know, one longer than it is,
; or more than MAXATR of them, or SS$_ACCVIO. Uses R0-R2, R7-R10.
NEXTATR:
        .JSB_ENTRY  OUTPUT=<R7, R8, R9, R10>, SCRATCH=<R2>
        CLRL    R8
        IFNORD  #4, (R6), 85$
        TSTL    (R6)
        BEQL    80$
        IFNORD  #8, (R6), 85$
        MOVL    #SS$_BADATTRIB, R0
        SOBGTR  R7, 10$
        RSB
10$:    MOVAB   ATRS, R8
20$:    TSTB    (R8)
        BEQL    70$
        MOVZBL  (R8), R0
        CMPW    R0, ATR$W_TYPE(R6)
        BEQL    30$
        ADDL2   #6, R8
        BRB     20$
30$:    MOVZWL  ATR$W_SIZE(R6), R10
        CMPW    R10, 2(R8)
        BGTRU   70$
        MOVAB   HDR, R9
        BBC     #3, 1(R8), 40$          ; IDENT
        MOVZBL  HDR+FH2$B_IDOFFSET, R0
        MOVAW   HDR[R0], R9
40$:    MOVZWL  4(R8), R0
        ADDL2   R0, R9
80$:    MOVL    #SS$_NORMAL, R0
        RSB
70$:    CLRL    R8
        MOVL    #SS$_BADATTRIB, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
        RSB

        .END
