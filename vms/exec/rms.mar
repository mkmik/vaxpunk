        .TITLE  RMS     Record Management Services: files on Files-11 volumes
        .IDENT  /V0.2/
;
; A program reads and writes files as on VMS: a FAB names a file and a
; RAB reads or writes its records, with $OPEN or $CREATE, $CONNECT, $GET
; or $PUT, $DISCONNECT and $CLOSE; $ERASE deletes one, and $PARSE and
; $SEARCH find the files a specification with wildcards names, into a
; NAM block (starlet.mlb's $FABDEF, $RABDEF, $NAMDEF, with VMS's
; layouts). A specification is [dev:][[dir.dir...]]name.type;ver: what it
; leaves out comes from the FAB's default specification, then from
; SYS$DISK: and the process's default directory, which $SETDDIR sets. A
; device may be a logical name, SYS$SYSTEM:, which stands for some of the
; parts: those the specification gives win. A search list, a logical
; name with more than one equivalence string, stands for each in turn:
; $OPEN, $ERASE and an image's activation take the file from the first
; that has it, $SEARCH finds the files in each, and $CREATE makes one in
; the first. The device is DKA0:, the
; system disk, or MDA0:, the ramdisk, with a volume mounted on it, which
; f11.mar reads and f11wrt.mar writes.
;
; $OPEN reads the file's header into an IFAB, a block of pool, which the
; process's PCB holds by IFI, the index $OPEN puts in FAB$W_IFI; $CONNECT
; puts the same index in RAB$W_ISI. $CREATE makes a new file, a version
; above the highest there is unless the specification gives one, with
; the FAB's record attributes and allocation, and opens it; past its
; name's version limit, the lowest version goes. The record
; services, $GET, $FIND, $PUT, $UPDATE, $DELETE, $TRUNCATE, $REWIND and
; $FLUSH, go to the file's organization: rmsseq.mar for sequential files,
; and block I/O, $READ, $WRITE and $SPACE, for any; rmsrel.mar for
; relative files; rmsidx.mar for indexed ones. rmsxab.mar fills the XABs
; $OPEN and $DISPLAY are given. $CLOSE writes what the buffers hold and
; the header. An image's files close when it exits, those its command
; interpreter opened when the process does.
;
; Each file and volume has an owner and a protection mask, which
; FIL$CHKPRO checks as VMS's XQP does: a lookup takes execute access to
; each directory it looks in, read for a wildcard; $OPEN takes read
; access to the file, $CREATE write to its directory, $ERASE delete to
; the file and write to its directory, else RMS$_PRV. A protection XAB
; in the FAB's chain gets the file's owner and protection from $OPEN,
; gives them to a new file at $CREATE, and to the file at $CLOSE, which
; takes control access, and the system's for a new owner. Without one, a
; new version has the protection of the highest there was.
;
; Each open of a file holds its access arbitration lock, through the lock
; manager, in a mode that FAB$B_FAC and FAB$B_SHR decide, as VMS's XQP's
; (docs/adr/0036-file-access-arbitration-locks.md): an open another's
; lock blocks fails with RMS$_FLK. $ERASE of a file that is open takes its
; directory entry and marks it for delete, and the last stream to close it
; deletes it. Writers of an indexed file that share writing open it
; together, and its records are locked as a stream reads them
; (RMS$LOCKREC, docs/adr/0046-shared-indexed-files-and-record-locks.md);
; a service that changes a file gives its other opens its header
; (RMS$SYNC).
;
; ponytail: the services run in kernel mode holding the file system's
; lock, FIL$LOCK, which keeps its buffers and RMS's to one process; VMS's
; RMS runs in executive mode, in the process's own P1. One stream per
; file; one writer of any other file; no bucket locks, which FIL$LOCK
; makes needless; no concealed devices, ASTs or completion routines. $SEARCH finds its place again from the resultant
; string it made last, as VMS's XQP does with FIB$L_WCC, so a wildcard
; $SEARCH needs one; VMS's RMS keeps its own copy.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PALDEF
        $PSLDEF
        $IPLDEF
        $PCBDEF
        $SSDEF
        $LNMBDEF
        $LNMDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $NAMDEF
        $VCBDEF
        $STATEDEF
        $ARMDEF
        $XABPRODEF
        $IFBDEF
        $XABFHCDEF
        $LCKDEF

        .EXTERNAL SCH$GL_CURPCB, EXE$ALONONPAGED, EXE$DEANONPGDSIZ, EXE$PROBER_DSC
        .EXTERNAL FIL$READHDR, FIL$READVBN, FIL$SEARCHDIR, FIL$MATCH, FIL$EOF, FIL$ISDIR
        .EXTERNAL FIL$SELECT, FIL$CHKALLOC, FIL$CREHDR, FIL$WRITEHDR, FIL$SETNAME, FIL$EXTEND
        .EXTERNAL FIL$ENTER, FIL$REMOVE, FIL$DELHDR, FIL$WRITEVBN, FIL$MKDIR
        .EXTERNAL FIL$LOCK, FIL$UNLOCK, FIL$CHKHDR, FIL$CHKPRO, FIL$ACLINHERIT
        .EXTERNAL F11$GW_FID, F11$GL_VCB, F11$AB_DIRBLK, LNM$TRNLOG, LNM$EQUIV
        .EXTERNAL SCH$GL_PCBVEC, SCH$GL_MAXPIX, LCK$ENQ, LCK$DEQ, LCK$ENQWK
        .EXTERNAL EXE$GQ_SYSTIME, RMS$XABOUT, RMS$FINDXAB
        .EXTERNAL SEQ$OPEN, SEQ$CONNECT, SEQ$GET, SEQ$FIND, SEQ$PUT, SEQ$UPDATE
        .EXTERNAL SEQ$TRUNCATE, SEQ$REWIND, SEQ$FLUSH
        .EXTERNAL BIO$READ, BIO$WRITE, BIO$SPACE
        .EXTERNAL REL$OPEN, REL$CREATE, REL$CONNECT, REL$GET, REL$FIND, REL$PUT
        .EXTERNAL REL$UPDATE, REL$DELETE, REL$REWIND, REL$FLUSH
        .EXTERNAL IDX$OPEN, IDX$CREATE, IDX$CONNECT, IDX$GET, IDX$FIND, IDX$PUT
        .EXTERNAL IDX$UPDATE, IDX$DELETE, IDX$REWIND, IDX$FLUSH, IDX$PEER

BLOCK = 512
MFD = 4                                 ; the MFD's file number
MAXIFI = 15                             ; PCB$A_IFAB's slots, 1-15
RESFILES = 9                            ; the volume's own files, 1-9
WCC_FOUND = ^X80000000                  ; in NAM$L_WCC: $SEARCH found a file,
WCC_V_LIST = 19                         ; the search list string it is in,
WCC_S_LIST = 12
WCC_AFTER = 1                           ; and goes on there after the resultant string's
MAXKEY = 80                             ; NAME.TYPE, at most
FAT$B_RTYPE = 20
FAT$B_RATTRIB = 21
FAT$W_RSIZE = 22
FAT$L_HIBLK = 24                        ; high word first
FAT$L_EFBLK = 28                        ; high word first
FAT$W_FFBYTE = 32
FAT$B_BKTSIZE = 34
FAT$B_VFCSIZE = 35
FAT$W_MAXREC = 36
FAT$W_DEFEXT = 38
FAT$W_GBC = 40
FH2$B_IDOFFSET = 0                      ; the ident area, in words
FH2$W_FID = 8
FH2$W_FID_SEQ = 10
FH2$B_FID_NMX = 13
FH2$L_FILECHAR = 52
FCH$V_MARKDEL = 15                      ; in it: marked for delete
FH2$L_FILEOWNER = 60
FH2$W_FILEPROT = 64
FH2$W_BACKLINK = 66
FI2$W_REVISION = 20                     ; in the ident area
FI2$Q_REVDATE = 30
MAXXAB = 16                             ; XABs in a chain, at most
RLKEFN = 30                             ; the event flag a wait for a record lock is on: one VMS keeps for itself

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
; A specification split into its five parts, device, directory, name,
; type and version, each an address and a length, 0 if it is absent: the
; file's, its default's, and the system's, and a logical name's
; equivalence string's.
SPECT:  .BLKQ   5
DEFT:   .BLKQ   5
SYST:   .BLKQ   5
EQUT:   .BLKQ   5
DEVBUF: .BLKB   3*256                   ; SPECT's, DEFT's and SYST's device, when NAMEDEV adds its colon
SYSDIRQ:                                ; SYST's directory, until XLATE has looked for one
        .BLKQ   1
RMS$T_EXP::                             ; the expanded specification
        .BLKB   256
EXPLEN: .LONG   0
FIELDS: .BLKQ   5                       ; its parts
RMS$L_VERSION::                         ; the version it asks for: -1 any, 0 the highest
        .LONG   0
WILD:   .LONG   0                       ; 1 if it has a wildcard
SLIDX:  .LONG   0                       ; which string of a search list RMS$PARSE takes
SLON:   .LONG   0                       ; 1 until XLATE meets the table with the device
SLOWN:  .LONG   0                       ; 1 while XLATE translates that table's
SLTOP:  .LONG   0                       ; 1 until PICK has counted its strings
SLREM:  .LONG   0                       ; PICK's: which string, in what is left
SLMORE: .LONG   0                       ; 1 if the search list has strings after SLIDX
CREDIR: .LONG   0                       ; 0, or 1 + the directories DIRWALK made
RMS$AB_DIRHDR::                         ; its directory's header
        .BLKB   BLOCK
DIRFID: .BLKW   3                       ; and file ID
DIRPAT: .BLKB   48                      ; a directory's name, NAME.DIR
WPATHL: .LONG   0                       ; the directory $SEARCH is in: its names,
WPATH:  .BLKB   256                     ; dots between, without 000000,
WFIXL:  .LONG   0                       ; the first WFIXL of them those without wildcards
WPATL:  .LONG   0                       ; the rest of the specification's directory,
WPAT:   .BLKB   256                     ; ... as !, dots between: none if it has no wildcards
WFLAGS: .LONG   0                       ; DMATCH's, of WPATH
AFTER:  .WORD   0                       ; the entry $SEARCH goes on after: its version,
        .BLKB   1+MAXKEY                ; its name, .ASCIC, none if empty
SUBKEY: .WORD   1                       ; and the subdirectory, NAME.DIR;1
        .BLKB   1+48
DIRSTAR:
        .ASCII  "*.DIR"
RES:    .BLKB   512                     ; the resultant specification
RESLEN: .LONG   0
RESF:   .BLKQ   5                       ; its parts
RESNAME:
        .LONG   0, 0                    ; the name found, and its length
RESVER: .LONG   0
DEFDIR: .BLKB   256                     ; the default's and the specification's
SPECDIR:                                ; directories, made absolute
        .BLKB   256
SYSDEF: .BYTE   0                       ; the system's default: SYS$DISK: and
SYSDISK:                                ; the process's default directory, .ASCIC
        .ASCII  "SYS$DISK:"
        .BLKB   63
ARBNAM: .ASCII  "F11B$a"                ; an access arbitration lock's name starts so
HDRBUF: .BLKB   BLOCK                   ; the header of a file $ERASE deletes, $CLOSE changes, $CREATE follows or purges
VERLIM: .LONG   0                       ; the version limit of the name SEARCH found last
PURGEAT:                                ; PURGEVER's entry to go on after: its version, its name, .ASCIC
        .WORD   0
        .BLKB   1+MAXKEY
XABPRO: .LONG   0                       ; the FAB's protection XAB, or 0
MFDNAME:
        .ASCII  "000000"
ELLIPSIS:
        .ASCII  "!"                     ; ... in WPAT
DOTDIR: .ASCII  ".DIR"

        .PSECT  $CODE$

; RMS$PARSE: R0 = a file specification, R1 = its length, R2 = a default
; one, R3 = its length, 0 if there is none, R4 = the system's default,
; .ASCIC. Expands the specification into RMS$T_EXP, each one's device
; translated (XLATE), the first string of a search list, the parts it leaves
; out taken from the default, then from the system's, whose directory,
; the process's default one, only if its device's translation gives
; none, as on VMS: SYS$DISK HOME:, a search list, with each string's
; directory, a relative
; directory made absolute (RESOLVE), checks it, finds
; its directory and reads the directory's header into RMS$AB_DIRHDR. R0 =
; RMS$_NORMAL, RMS$_SYN, RMS$_DEV, RMS$_DIR, RMS$_FNM, RMS$_VER, RMS$_DNF,
; or the disk's error. The strings must be readable. Holding FIL$LOCK;
; at IPL$_SYNCH until MERGE has copied the parts XLATE found in logical
; names' blocks, which another process may delete. Uses R1.
RMS$PARSE::
        .JSB_ENTRY
        CLRL    SLIDX
        BRB     PARSEIDX
; PARSEIDX: the same, with the string SLIDX says of a search list. SLMORE
; = 1 if it has more after that one. RMS$_NMF past its last.
PARSEIDX:
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        CLRL    WILD
        MOVL    #1, SLON
        CLRL    SLMORE
        DSBINT  #IPL$_SYNCH
        PUSHL   R4
        PUSHL   R3
        PUSHL   R2
        MOVAQ   SPECT, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        BSBW    XLATE
        BLBC    R0, 10$
        MOVL    (SP), R0
        MOVL    4(SP), R1
        MOVAQ   DEFT, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        BSBW    XLATE
        BLBC    R0, 10$
        MOVL    8(SP), R0
        MOVZBL  (R0)+, R1
        MOVAQ   SYST, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        MOVQ    SYST+8, SYSDIRQ         ; the default directory: VMS's, only if
        CLRQ    SYST+8                  ; SYS$DISK's names give none
        BSBW    XLATE
        TSTL    SYST+12
        BNEQ    10$
        MOVQ    SYSDIRQ, SYST+8
10$:    ADDL2   #12, SP
        BLBC    R0, 20$
        BSBW    RESOLVE
        BLBC    R0, 20$
        BSBW    MERGE
20$:    ENBINT
        BLBC    R0, 90$
        BSBW    CHECK
        BLBC    R0, 90$
        BSBW    WILDDIR
        BLBC    R0, 90$
        MOVL    #RMS$_WLD, R0           ; $CREATE_DIR's can't have wildcards
        TSTL    CREDIR
        BEQL    30$
        TSTL    WPATL
        BNEQ    90$
30$:    MOVAB   WPATH, R10
        ADDL3   R10, WPATHL, R11
        BSBW    DIRWALK
90$:    POPR    #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

; SPLIT: R0 = a specification, R1 = its length, R2 = a table of five
; parts. Splits it: [dev:][[dir]][name][.type][;ver]. A part's punctuation
; is in it: the colon, the brackets, the dot, the semicolon. R0 =
; RMS$_NORMAL, RMS$_DIR or RMS$_SYN. Uses R1-R6.
SPLIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CLRQ    (R2)
        CLRQ    8(R2)
        CLRQ    16(R2)
        CLRQ    24(R2)
        CLRQ    32(R2)
        ADDL3   R0, R1, R6              ; past the end
        MOVL    R0, R3                  ; where the next part starts
        MOVL    R3, R4                  ; the device: up to a colon
10$:    CMPL    R4, R6
        BGEQU   20$
        CMPB    (R4), #^A/:/
        BEQL    15$
        INCL    R4
        BRB     10$
15$:    INCL    R4
        MOVL    R3, (R2)
        SUBL3   R3, R4, 4(R2)
        MOVL    R4, R3
20$:    CMPL    R3, R6                  ; the directory: [...] or <...>
        BGEQU   40$
        CMPB    (R3), #91               ; [
        BEQL    25$
        CMPB    (R3), #60               ; <
        BNEQ    40$
25$:    MOVL    R3, R4
30$:    INCL    R4
        CMPL    R4, R6
        BGEQU   85$
        CMPB    (R4), #93               ; ]
        BEQL    35$
        CMPB    (R4), #62               ; >
        BNEQ    30$
35$:    INCL    R4
        MOVL    R3, 8(R2)
        SUBL3   R3, R4, 12(R2)
        MOVL    R4, R3
40$:    MOVL    R3, R4                  ; the name: up to a dot or semicolon
45$:    CMPL    R4, R6
        BGEQU   50$
        CMPB    (R4), #^A/./
        BEQL    50$
        CMPB    (R4), #59                 ; a semicolon
        BEQL    50$
        INCL    R4
        BRB     45$
50$:    MOVL    R3, 16(R2)
        SUBL3   R3, R4, 20(R2)
        MOVL    R4, R3
        CMPL    R3, R6                  ; the type: from a dot to a semicolon
        BGEQU   80$
        CMPB    (R3), #^A/./
        BNEQ    60$
        MOVL    R3, R4
55$:    INCL    R4
        CMPL    R4, R6
        BGEQU   57$
        CMPB    (R4), #59                 ; a semicolon
        BNEQ    55$
57$:    MOVL    R3, 24(R2)
        SUBL3   R3, R4, 28(R2)
        MOVL    R4, R3
        CMPL    R3, R6                  ; the version: the rest
        BGEQU   80$
60$:    CMPB    (R3), #59                 ; a semicolon
        BNEQ    87$
        MOVL    R3, 32(R2)
        SUBL3   R3, R6, 36(R2)
80$:    MOVL    #RMS$_NORMAL, R0
        RSB
85$:    MOVL    #RMS$_DIR, R0
        RSB
87$:    MOVL    #RMS$_SYN, R0
        RSB

; XLATE: R2 = a table of parts. While its device is a logical name in
; LNM$FILE_DEV, without an underscore before it, up to LNM$C_MAXDEPTH
; times, splits the equivalence string into EQUT: its device becomes the
; table's, and its other parts fill in those the table leaves out.
; SYS$SYSTEM:DCL.EXE is DKA0:[SYSEXE]DCL.EXE. A table, or an equivalence,
; that is only a name is a device if the name is a logical name
; (NAMEDEV): TYPE F with F a file's specification, or a search list's
; string that names another. Of a search list the equivalence is the
; first string, but in the first table with a device, whose device MERGE
; takes: there, the string SLIDX says counting each string of a search
; list inside it as VMS does, one after another (PICK), and SLMORE = 1 if
; there are more. R0 = RMS$_NORMAL, SPLIT's error, or RMS$_NMF past the
; last. IPL$_SYNCH. Uses R0-R9.
XLATE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVL    R2, R8
        BSBW    NAMEDEV
        CLRL    SLOWN
        TSTL    4(R8)
        BEQL    5$
        MOVL    SLON, SLOWN
        MOVL    SLON, SLTOP
        CLRL    SLON
        MOVL    SLIDX, SLREM
5$:     MOVL    #LNM$C_MAXDEPTH, R9
10$:    MOVL    (R8), R6                ; the device, without its colon
        SUBL3   #1, 4(R8), R7
        BLEQ    80$
        CMPB    (R6), #^A/_/
        BEQL    80$
        BSBW    LNM$TRNLOG
        TSTL    R1
        BEQL    80$
        MOVL    R1, R5
        CLRL    R0
        BSBW    LNM$EQUIV               ; R0 = the first string
        TSTL    SLOWN
        BEQL    15$
        BSBW    PICK
        TSTL    R0
        BEQL    85$
15$:    MOVZBL  (R0)+, R1
        MOVAQ   EQUT, R2
        BSBW    SPLIT
        BLBC    R0, 90$
        MOVAQ   EQUT, R2
        BSBW    NAMEDEV
        MOVQ    EQUT, (R8)
        MOVL    #1, R0
20$:    MOVAQ   (R8)[R0], R1
        TSTL    4(R1)
        BNEQ    30$
        MOVAQ   EQUT[R0], R2
        MOVQ    (R2), (R1)
30$:    AOBLSS  #5, R0, 20$
        SOBGTR  R9, 10$
80$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
85$:    MOVL    #RMS$_NMF, R0
90$:    MOVL    R8, R2
        RSB

; NAMEDEV: R2 = a table of parts, R8 = the table, SPECT, DEFT or SYST,
; XLATE translates. If the parts are only a name, without an underscore
; before it, and the name is a logical name, it becomes the device, with
; its colon, in the table's DEVBUF. IPL$_SYNCH. Uses R0-R7.
NAMEDEV:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        TSTL    4(R2)
        BNEQ    90$
        TSTL    12(R2)
        BNEQ    90$
        BISL3   28(R2), 36(R2), R0
        BNEQ    90$
        MOVL    20(R2), R7
        BEQL    90$
        CMPL    R7, #LNM$C_NAMLENGTH
        BGTRU   90$
        MOVL    16(R2), R6
        CMPB    (R6), #^A/_/
        BEQL    90$
        PUSHL   R2
        BSBW    LNM$TRNLOG
        MOVL    (SP)+, R2
        TSTL    R1
        BEQL    90$
        MOVAB   SPECT, R0               ; the table's DEVBUF
        SUBL3   R0, R8, R0
        DIVL2   #40, R0
        ASHL    #8, R0, R0
        MOVAB   DEVBUF[R0], R0
        PUSHR   #^M<R0, R2>
        MOVC3   R7, (R6), (R0)
        MOVB    #^A/:/, (R3)
        POPR    #^M<R0, R2>
        MOVL    R0, (R2)
        ADDL3   #1, R7, 4(R2)
        CLRQ    16(R2)
90$:    RSB

; PICK: R5 = the logical name block of a name XLATE translates, R9 = how
; many more translations it may make. R0 = the string of it SLREM says,
; counting a string that names a search list as its strings, each as
; many as it has, depth first, as VMS's RMS goes through nested search
; lists; SLREM becomes the string's own count. The first time, SLMORE = 1
; if there are more after SLIDX. R0 = 0 past the last. IPL$_SYNCH. Uses
; R0-R3.
PICK:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    R9, R2
        TSTL    SLTOP
        BEQL    5$
        CLRL    SLTOP
        MOVL    R5, R1
        BSBW    LEAVES                  ; how many in all
        CMPL    SLREM, R0
        BGEQU   80$
        ADDL3   #1, SLREM, R1
        CMPL    R1, R0
        BGEQU   5$
        CMPL    R1, #1@WCC_S_LIST       ; as many as NAM$L_WCC holds
        BGEQU   5$
        MOVL    #1, SLMORE
5$:     CLRL    R3
10$:    MOVL    R3, R0
        MOVL    R5, R1
        BSBW    LNM$EQUIV
        CMPL    R3, R1
        BGTR    80$
        PUSHL   R0
        BSBW    STRLEAVES
        CMPL    SLREM, R0
        BLSSU   20$
        SUBL2   R0, SLREM
        TSTL    (SP)+
        INCL    R3
        BRB     10$
20$:    MOVL    (SP)+, R0
        RSB
80$:    CLRL    R0
        RSB

; LEAVES: R1 = a logical name block, R2 = how many more translations
; there may be. R0 = how many strings it stands for, each of its own
; counted as STRLEAVES does. IPL$_SYNCH. Keeps every other register.
LEAVES:
        .JSB_ENTRY
        PUSHR   #^M<R1, R3, R4>
        CLRQ    R3                      ; R3 = the string, R4 = the count
10$:    MOVL    R3, R0
        MOVL    (SP), R1
        BSBW    LNM$EQUIV
        CMPL    R3, R1
        BGTR    80$
        BSBB    STRLEAVES
        ADDL2   R0, R4
        INCL    R3
        BRB     10$
80$:    MOVL    R4, R0
        POPR    #^M<R1, R3, R4>
        RSB

; STRLEAVES: R0 = an equivalence string, .ASCIC, R2 = how many more
; translations there may be. R0 = how many strings it stands for: those
; of its device's logical name, if it has one and there may be another
; translation, else 1. IPL$_SYNCH. Keeps every other register.
STRLEAVES:
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R6, R7>
        BSBB    ELDEV
        TSTL    R7
        BEQL    80$
        DECL    R2
        BLEQ    80$
        PUSHL   R2
        BSBW    LNM$TRNLOG
        MOVL    (SP)+, R2
        TSTL    R1
        BEQL    80$
        BSBB    LEAVES
        BRB     90$
80$:    MOVL    #1, R0
90$:    POPR    #^M<R1, R2, R3, R6, R7>
        RSB

; ELDEV: R0 = an equivalence string, .ASCIC. R6 = the device XLATE would
; translate next, without its colon, R7 = its length: up to a colon, or
; all of it if it is only a name; R7 = 0 if it has none, or if an
; underscore is before it. Uses R0 and R1.
ELDEV:
        .JSB_ENTRY  OUTPUT=<R6, R7>
        MOVZBL  (R0)+, R1
        MOVL    R0, R6
        CLRL    R7
10$:    CMPL    R7, R1
        BGEQU   40$                     ; only a name
        MOVZBL  (R6)[R7], R0
        CMPB    R0, #^A/:/
        BEQL    40$
        CMPB    R0, #91                 ; [
        BEQL    80$
        CMPB    R0, #60                 ; <
        BEQL    80$
        CMPB    R0, #^A/./
        BEQL    80$
        CMPB    R0, #59                 ; a semicolon
        BEQL    80$
        INCL    R7
        BRB     10$
40$:    TSTL    R7
        BEQL    90$
        CMPB    (R6), #^A/_/
        BNEQ    90$
80$:    CLRL    R7
90$:    RSB

; RESOLVE: makes the directories in SPECT and DEFT absolute, as VMS's RMS
; does: the default's relative to the system's, the specification's to the
; default's if it has one, else to the system's. R0 = RMS$_NORMAL or
; RMS$_DIR. Uses R0-R9.
RESOLVE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVAQ   DEFT+8, R0
        MOVAQ   SYST+8, R1
        MOVAB   DEFDIR, R2
        BSBB    RELDIR
        BLBC    R0, 90$
        MOVAQ   SPECT+8, R0
        MOVAQ   DEFT+8, R1
        TSTL    4(R1)
        BNEQ    10$
        MOVAQ   SYST+8, R1
10$:    MOVAB   SPECDIR, R2
        BSBB    RELDIR
90$:    RSB

; RELDIR: R0 = a directory part, its address and length, in a table of
; parts, R1 = the absolute one it is relative to, the same, R2 = a
; 256-byte buffer. If the part is relative, [] the same directory, [-]
; its parent, [--] the one above, [.dir] or [-.dir] a directory in one of
; those, [...] or [-...] the tree under one of those, writes the absolute
; one in the buffer and points the part at it.
; The MFD, [000000], has no parent. R0 = RMS$_NORMAL or RMS$_DIR. Uses
; R0-R9.
RELDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVL    4(R0), R3               ; the part's length
        CMPL    R3, #2
        BLSSU   70$                     ; none, or CHECK's to report
        MOVL    (R0), R4
        CMPL    R3, #2                  ; []
        BEQL    5$
        CMPB    1(R4), #^A/-/
        BEQL    5$
        CMPB    1(R4), #^A/./
        BNEQ    70$
5$:     ADDL3   #1, R4, R5              ; R5 = past the bracket, then the rest
        ADDL3   R4, R3, R6
        DECL    R6                      ; R6 = at the closing bracket
        CLRL    R7                      ; how many levels up
10$:    CMPL    R5, R6
        BGEQU   15$
        CMPB    (R5), #^A/-/
        BNEQ    12$
        INCL    R7
        INCL    R5
        BRB     10$
12$:    CMPB    (R5)+, #^A/./           ; a dot, then names
        BNEQ    80$
        CMPL    R5, R6
        BGEQU   80$
15$:    MOVL    (R1), R9                ; the base's names: R9, R8 long
        SUBL3   #2, 4(R1), R8
        BLEQ    80$
        INCL    R9
        CMPL    R8, #6                  ; the MFD's are none
        BNEQ    20$
        CMPL    (R9), MFDNAME
        BNEQ    20$
        CMPW    4(R9), MFDNAME+4
        BNEQ    20$
        CLRL    R8
20$:    TSTL    R7                      ; up a level: drop the last name
        BEQL    40$
25$:    TSTL    R8
        BEQL    80$
30$:    DECL    R8
        BEQL    35$
        CMPB    (R9)[R8], #^A/./
        BNEQ    30$
35$:    SOBGTR  R7, 25$
40$:    MOVL    R2, R3                  ; [, the base's names, a dot, the rest, ]
        MOVAB   255(R2), R4
        MOVB    #91, (R3)+
        TSTL    R8
        BEQL    50$
45$:    MOVB    (R9)+, (R3)+
        SOBGTR  R8, 45$
        CMPL    R5, R6
        BGEQU   60$
        MOVB    #^A/./, (R3)+
        BRB     55$
50$:    CMPL    R5, R6                  ; no names and no rest: the MFD
        BGEQU   52$
        CMPB    (R5), #^A/./            ; and before ..., [000000...]
        BNEQ    55$
52$:    MOVL    MFDNAME, (R3)+
        MOVW    MFDNAME+4, (R3)+
        CMPL    R5, R6
        BGEQU   60$
        MOVB    #^A/./, (R3)+
        BRB     55$
55$:    CMPL    R5, R6
        BGEQU   60$
        CMPL    R3, R4
        BGEQU   80$
        MOVB    (R5)+, (R3)+
        BRB     55$
60$:    CMPL    R3, R4
        BGTRU   80$
        MOVB    #93, (R3)+
        MOVL    R2, (R0)
        SUBL3   R2, R3, 4(R0)
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DIR, R0
        RSB

; MERGE: builds RMS$T_EXP from the parts in SPECT, else DEFT, else SYST,
; in capitals, and FIELDS from where each part went. An empty type is a
; dot, an empty version a semicolon. R0 = RMS$_NORMAL, or RMS$_SYN if it
; is longer than 255 characters. Uses R0-R6.
MERGE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVAB   RMS$T_EXP, R6           ; the next character
        CLRL    R5                      ; the part
10$:    MOVAQ   SPECT[R5], R1
        TSTL    4(R1)
        BNEQ    20$
        MOVAQ   DEFT[R5], R1
        TSTL    4(R1)
        BNEQ    20$
        MOVAQ   SYST[R5], R1
20$:    MOVAQ   FIELDS[R5], R4
        MOVL    R6, (R4)
        MOVL    (R1), R2
        MOVL    4(R1), R3
        BNEQ    30$
        MOVZBL  #^A/./, R0              ; nothing there: the punctuation
        CMPL    R5, #3
        BEQL    35$
        MOVZBL  #59, R0                 ; a semicolon
        CMPL    R5, #4
        BEQL    35$
        BRB     40$
30$:    MOVZBL  (R2)+, R0
        CMPB    R0, #^A/a/
        BLSSU   35$
        CMPB    R0, #^A/z/
        BGTRU   35$
        SUBB2   #^A/a/-^A/A/, R0
35$:    MOVAB   RMS$T_EXP+255, R1
        CMPL    R6, R1
        BGEQU   80$
        MOVB    R0, (R6)+
        DECL    R3
        BGTR    30$
40$:    SUBL3   (R4), R6, 4(R4)
        AOBLSS  #5, R5, 10$
        MOVAB   RMS$T_EXP, R0
        SUBL3   R0, R6, EXPLEN
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_SYN, R0
        RSB

; CHECK: checks the parts in FIELDS: the device is DKA0: or MDA0:, with a
; volume mounted that isn't another job's private one, which becomes
; F11$GL_VCB, the directory
; and the name and type are made of letters, digits, $, _ and -, with
; dots between the directory's names, wildcards in any of them (WILDDIR
; checks the directory's dots), and the version is a number up to 32767,
; * or nothing. Sets WILD for a wildcard and RMS$L_VERSION. R0 =
; RMS$_NORMAL, RMS$_DEV, RMS$_DNR, RMS$_DIR, RMS$_FNM, RMS$_VER, or
; RMS$_SYN for a version that isn't a number, as VMS's. Uses R0-R4.
CHECK:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        MOVL    FIELDS, R1              ; the device
        MOVL    FIELDS+4, R2
        BSBW    FIL$SELECT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        BBC     #VCB$V_MOUNTED, VCB$L_STATUS(R1), 6$
        BSBW    FIL$CHKALLOC
        BLBS    R0, 7$
6$:     MOVL    #RMS$_DNR, R0
        RSB
7$:     ADDL3   #1, FIELDS+8, R1        ; the directory, inside its brackets
        SUBL3   #2, FIELDS+12, R2
        BLEQ    85$
        MOVL    #3, R3                  ; dots and wildcards
        BSBW    CHARS
        BLBC    R0, 85$
        MOVL    FIELDS+16, R1           ; the name
        MOVL    FIELDS+20, R2
        CMPL    R2, #39
        BGTRU   87$
        MOVL    #1, R3
        BSBW    CHARS
        BLBC    R0, 87$
        ADDL3   #1, FIELDS+24, R1       ; the type, past its dot
        SUBL3   #1, FIELDS+28, R2
        CMPL    R2, #39
        BGTRU   87$
        MOVL    #1, R3
        BSBW    CHARS
        BLBC    R0, 87$
        ADDL3   #1, FIELDS+32, R1       ; the version, past its semicolon
        SUBL3   #1, FIELDS+36, R2
        BNEQ    20$
        CLRL    RMS$L_VERSION           ; none: the highest
        BRB     70$
20$:    CMPB    (R1), #^A/*/
        BNEQ    25$
        CMPL    R2, #1
        BNEQ    88$
        MNEGL   #1, RMS$L_VERSION
        MOVL    #1, WILD
        BRB     70$
25$:    CLRL    R0
30$:    MOVZBL  (R1)+, R3
        SUBL2   #^A/0/, R3
        CMPL    R3, #9
        BGTRU   88$
        MULL2   #10, R0
        ADDL2   R3, R0
        CMPL    R0, #32767
        BGTRU   89$
        SOBGTR  R2, 30$
        MOVL    R0, RMS$L_VERSION
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DEV, R0
        RSB
85$:    MOVL    #RMS$_DIR, R0
        RSB
87$:    MOVL    #RMS$_FNM, R0
        RSB
88$:    MOVL    #RMS$_SYN, R0
        RSB
89$:    MOVL    #RMS$_VER, R0
        RSB

; CHARS: R1 = a string, R2 = its length, R3 = bit 0 set if it may have
; the wildcards * and %, bit 1 if dots. R0 = 1 if it is made of letters,
; digits, $, _, - and those, else 0. Sets WILD for a wildcard. Uses R4.
CHARS:
        .JSB_ENTRY  SCRATCH=<R4>
        CLRL    R4
10$:    CMPL    R4, R2
        BGEQU   70$
        MOVZBL  (R1)[R4], R0
        CMPB    R0, #^A/A/
        BLSSU   20$
        CMPB    R0, #^A/Z/
        BLEQU   60$
20$:    CMPB    R0, #^A/0/
        BLSSU   30$
        CMPB    R0, #^A/9/
        BLEQU   60$
30$:    CMPB    R0, #^A/$/
        BEQL    60$
        CMPB    R0, #^A/_/
        BEQL    60$
        CMPB    R0, #^A/-/
        BEQL    60$
        CMPB    R0, #^A/./
        BNEQ    40$
        BBS     #1, R3, 60$
        BRB     80$
40$:    CMPB    R0, #^A/*/
        BEQL    45$
        CMPB    R0, #^A/%/
        BNEQ    80$
45$:    BBC     #0, R3, 80$
        MOVL    #1, WILD
60$:    INCL    R4
        BRB     10$
70$:    MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; WILDDIR: splits the directory in FIELDS: its names up to the first with
; a wildcard or ..., but 000000, into WPATH, and their length into
; WFIXL; the rest into WPAT, ... as !. Sets WILD if there is a rest. R0
; = RMS$_NORMAL, or RMS$_DIR if a name is empty or longer than 39
; characters, or a dot is out of place. Uses R0-R6.
WILDDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        CLRL    WPATHL
        CLRL    WPATL
        CLRL    R5                      ; 1 from the first wildcard on
        ADDL3   #1, FIELDS+8, R1        ; the next name
        ADDL3   FIELDS+8, FIELDS+12, R2
        DECL    R2                      ; at the closing bracket
10$:    CMPL    R1, R2
        BGEQU   70$
        CMPB    (R1), #^A/./            ; ...
        BNEQ    20$
        SUBL3   R1, R2, R0
        CMPL    R0, #3
        BLSSU   80$
        CMPB    1(R1), #^A/./
        BNEQ    80$
        CMPB    2(R1), #^A/./
        BNEQ    80$
        ADDL2   #3, R1
        MOVL    #1, R5
        PUSHL   R1
        MOVAB   ELLIPSIS, R1
        MOVL    #1, R0
        MOVAL   WPATL, R4
        BSBW    APPNAME
        MOVL    (SP)+, R1
        BRB     10$
20$:    MOVL    R1, R3                  ; a name, up to a dot
25$:    CMPL    R1, R2
        BGEQU   30$
        CMPB    (R1), #^A/./
        BEQL    30$
        CMPB    (R1), #^A/*/
        BEQL    27$
        CMPB    (R1), #^A/%/
        BNEQ    28$
27$:    MOVL    #1, R5
28$:    INCL    R1
        BRB     25$
30$:    SUBL3   R3, R1, R0
        BEQL    80$
        CMPL    R0, #39
        BGTRU   80$
        PUSHL   R1
        MOVL    R3, R1
        MOVAL   WPATL, R4
        TSTL    R5
        BNEQ    40$
        MOVAL   WPATHL, R4
        CMPL    R0, #6                  ; 000000: the MFD, where it starts
        BNEQ    40$
        CLRL    R6
35$:    CMPB    (R1)[R6], MFDNAME[R6]
        BNEQ    40$
        AOBLSS  #6, R6, 35$
        BRB     45$
40$:    BSBW    APPNAME
45$:    MOVL    (SP)+, R1
        CMPL    R1, R2
        BGEQU   70$
        CMPB    1(R1), #^A/./           ; ... after it
        BEQL    10$
        INCL    R1                      ; or a dot, then a name
        CMPL    R1, R2
        BGEQU   80$
        BRB     10$
70$:    MOVL    WPATHL, WFIXL
        TSTL    WPATL
        BEQL    75$
        MOVL    #1, WILD
75$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DIR, R0
        RSB

; APPNAME: R0 = a name's length, R1 = the name, R4 = WPATHL or WPATL.
; Appends it to the names there, after a dot if there are some. R0 = 1,
; or 0 if they would be longer than 255 characters. Uses R1.
APPNAME:
        .JSB_ENTRY
        MOVL    (R4), R2
        ADDL3   R0, R2, R3
        TSTL    R2
        BEQL    10$
        INCL    R3
10$:    CMPL    R3, #255
        BGTRU   80$
        MOVL    R3, (R4)
        ADDL3   #4, R4, R3
        ADDL2   R2, R3
        TSTL    R2
        BEQL    20$
        MOVB    #^A/./, (R3)+
20$:    MOVB    (R1)+, (R3)+
        SOBGTR  R0, 20$
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; DIRWALK: R10 = names, dots between, R11 = past them. Finds the
; directory they name, from the MFD down, each name
; NAME.DIR;1 in the one before: 000000 is the MFD itself. Reads its
; header into RMS$AB_DIRHDR and its file ID into DIRFID. With CREDIR set,
; makes each one that isn't there, counting them in CREDIR. R0 =
; RMS$_NORMAL, RMS$_DNF, RMS$_DIR if a name isn't a directory, RMS$_WLK
; if one can't be made on the volume, RMS$_PRV without execute access to
; a directory it looks in, or write access to one it makes one in, or
; the file system's error. Uses R0-R11.
DIRWALK:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    #MFD, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 99$
10$:    CMPL    R10, R11
        BLSSU   15$
        BRW     80$
15$:    MOVL    R10, R4                 ; the name's end
20$:    CMPL    R4, R11
        BGEQU   25$
        CMPB    (R4), #^A/./
        BEQL    25$
        INCL    R4
        BRB     20$
25$:    SUBL3   R10, R4, R7             ; its length
        BEQL    95$
        CMPL    R7, #6                  ; 000000: the MFD, where we are
        BNEQ    35$
        CLRL    R0
30$:    CMPB    (R10)[R0], MFDNAME[R0]
        BNEQ    35$
        AOBLSS  #6, R0, 30$
        BRB     70$
35$:    CMPL    R7, #39
        BGTRU   95$
        CLRL    R0                      ; NAME.DIR
40$:    MOVB    (R10)[R0], DIRPAT[R0]
        AOBLSS  R7, R0, 40$
        MOVAB   DIRPAT[R7], R0
        MOVL    DOTDIR, (R0)
        ADDL2   #4, R7
        MOVAB   DIRPAT, R6
        MOVL    #1, R8
        CLRL    R9
        MOVL    #ARM$M_EXECUTE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 99$
        MOVAB   RMS$AB_DIRHDR, R3
        PUSHL   R4
        BSBW    FIL$SEARCHDIR
        MOVL    (SP)+, R4
        BLBS    R0, 50$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    99$
        TSTL    CREDIR
        BEQL    90$
        MOVL    F11$GL_VCB, R0          ; not there: make it
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R0), 97$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 99$
        PUSHL   R4
        BSBW    FIL$MKDIR
        BLBC    R0, 98$
        MOVC3   #BLOCK, (R1), RMS$AB_DIRHDR
        MOVL    (SP)+, R4
        INCL    CREDIR
        BRB     70$
50$:    MOVL    R5, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 99$
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$ISDIR
        BLBC    R0, 95$
70$:    ADDL3   #1, R4, R10             ; past the dot
        BRW     10$
80$:    MOVL    RMS$AB_DIRHDR+FH2$W_FID, DIRFID
        MOVW    RMS$AB_DIRHDR+FH2$W_FID+4, DIRFID+4
        MOVL    #RMS$_NORMAL, R0
        RSB
90$:    MOVL    #RMS$_DNF, R0
        RSB
95$:    MOVL    #RMS$_DIR, R0
        RSB
97$:    MOVL    #RMS$_WLK, R0
        RSB
98$:    TSTL    (SP)+
99$:    RSB

; RMS$FIND: after RMS$PARSE, R1 = a buffer. Finds the one file the
; expanded specification names, its highest version unless it gives one,
; makes its resultant specification and reads its header into the
; buffer. R0 = RMS$_NORMAL, RMS$_WLD, RMS$_FNF, RMS$_PRV, or the disk's
; error.
; Holding FIL$LOCK. Uses R0-R9.
RMS$FIND::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
        TSTL    WILD
        BNEQ    80$
        PUSHL   R1
        CLRB    AFTER+2
        BSBW    SEARCH
        MOVL    (SP)+, R1
        BLBS    R0, 10$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    90$
        MOVL    #RMS$_FNF, R0
        RSB
10$:    MOVL    R5, R0
        BRW     FIL$READHDR
80$:    MOVL    #RMS$_WLD, R0
90$:    RSB

; RMS$LOCATE: R0-R4 as for RMS$PARSE, R5 = a buffer. RMS$PARSE, then
; RMS$FIND, with each string of a search list in turn until the file is
; there: the status of the last try. Holding FIL$LOCK. Uses R0-R9.
RMS$LOCATE::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
        CLRL    SLIDX
10$:    PUSHR   #^M<R0, R1, R2, R3, R4, R5>
        BSBW    PARSEIDX
        BLBC    R0, 20$
        MOVL    20(SP), R1
        BSBW    RMS$FIND
20$:    MOVL    R0, R6
        POPR    #^M<R0, R1, R2, R3, R4, R5>
        BLBS    R6, 90$
        TSTL    SLMORE
        BEQL    90$
        CMPL    R6, #RMS$_FNF
        BEQL    30$
        CMPL    R6, #RMS$_DNF
        BNEQ    90$
30$:    INCL    SLIDX
        BRB     10$
90$:    MOVL    R6, R0
        RSB

; SEARCH: after RMS$PARSE, WPATH = a directory and AFTER = an entry in
; it, or none. Finds the next file the expanded specification names,
; after AFTER's in that directory, then in each directory after it that
; its wildcard directory names, depth first, each directory's own files
; before those of the directories in it, in the directories' order, and
; makes its resultant specification. R5 = its file number, R0 =
; SS$_NORMAL, SS$_NOMOREFILES, RMS$_PRV without execute access to the
; directory, or read access for a wildcard, or the disk's error. A
; wildcard directory's directory that can't be looked in or read is
; passed over, with those in it. Uses R0-R8.
SEARCH:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8>
10$:    BSBW    HERE
        MOVL    R0, WFLAGS
        BLBC    R0, 30$
        BSBW    GODIR
        BLBC    R0, 25$
        MOVL    #ARM$M_EXECUTE, R0
        TSTL    WILD
        BEQL    15$
        MOVL    #ARM$M_READ, R0
15$:    MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 25$
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RMS$L_VERSION, R8
        CLRL    R9
        TSTB    AFTER+2
        BEQL    20$
        MOVAB   AFTER, R9
20$:    BSBW    FIL$SEARCHDIR
        BLBS    R0, 80$
        CMPL    R0, #SS$_NOMOREFILES
        BEQL    30$
        RSB
25$:    TSTL    WPATL                   ; a wildcard directory's: passed over
        BNEQ    27$
        RSB
27$:    CLRB    AFTER+2
        BRB     50$
30$:    CLRB    AFTER+2                 ; the first directory in it
        BBC     #1, WFLAGS, 50$
        BLBS    WFLAGS, 35$
        BSBW    GODIR
        BLBC    R0, 50$
        MOVL    #ARM$M_READ, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 50$
35$:    CLRL    R9
        BSBW    SUBDIR
        BLBS    R0, 10$
50$:    CMPL    WPATHL, WFIXL           ; the next one in the one above
        BLEQ    85$
        BSBW    UPDIR
        BSBW    GODIR
        BLBC    R0, 50$
        MOVL    #ARM$M_READ, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 50$
        MOVAB   SUBKEY, R9
        BSBW    SUBDIR
        BLBS    R0, 10$
        BRB     50$
80$:    MOVZWL  -4(R1), VERLIM          ; its record's DIR$W_VERLIMIT
        PUSHL   R5
        BSBW    MKRES
        MOVL    (SP)+, R5
        MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_NOMOREFILES, R0
        RSB

; HERE: R0 = DMATCH's bits for WPATH, its names past the first WFIXL.
; The MFD matches as none or as 000000, as in it it is 000000.DIR, so
; [*] is [000000] too; but what is in it only as none. Keeps every other
; register.
HERE:
        .JSB_ENTRY
        MOVAB   WPATH, R8
        ADDL3   R8, WPATHL, R9
        ADDL2   WFIXL, R8
        CMPL    R8, R9
        BGEQU   10$
        TSTL    WFIXL
        BEQL    10$
        INCL    R8                      ; past the dot
10$:    MOVAB   WPAT, R10
        ADDL3   R10, WPATL, R11
        BSBW    DMATCH
        TSTL    WPATHL
        BNEQ    90$
        BLBS    R0, 90$
        PUSHL   R0
        MOVAB   MFDNAME, R8
        MOVAB   MFDNAME+6, R9
        BSBW    DMATCH
        BICL2   #^C<1>, R0
        BISL2   (SP)+, R0
90$:    RSB

; DMATCH: R8 = names, dots between, R9 = past them, R10 = WPAT's, R11 =
; past them. R0 = bit 0 set if the names match WPAT's, each name its
; name, ! none or more of them; bit 1 if names after them could. Keeps
; every other register.
DMATCH:
        .JSB_ENTRY
        CMPL    R10, R11
        BLSSU   20$
        CLRL    R0                      ; no more of WPAT's: no more names
        CMPL    R8, R9
        BLSSU   90$
        INCL    R0
        BRB     90$
20$:    MOVL    R10, R5                 ; WPAT's next: R6, R7 long
        MOVL    R10, R2
        MOVL    R11, R3
        BSBW    NEXTNAME
        MOVL    R1, R6
        MOVL    R0, R7
        MOVL    R2, R10
        CMPB    (R6), #^A/!/
        BEQL    50$
        MOVL    #2, R0                  ; no more names: those after could
        CMPL    R8, R9
        BGEQU   90$
        MOVL    R8, R2
        MOVL    R9, R3
        BSBW    NEXTNAME
        MOVL    R2, R8
        MOVL    R0, R2
        BSBW    FIL$MATCH
        BLBC    R0, 90$
        BSBW    DMATCH
        BRB     90$
50$:    BSBW    DMATCH                  ; !: none of the names,
        PUSHL   R0
        CMPL    R8, R9
        BLSSU   60$
        BISL2   #2, (SP)                ; or those after,
        BRB     70$
60$:    MOVL    R8, R2                  ; or one more
        MOVL    R9, R3
        BSBW    NEXTNAME
        MOVL    R2, R8
        MOVL    R5, R10
        BSBW    DMATCH
        BISL2   R0, (SP)
70$:    MOVL    (SP)+, R0
90$:    RSB

; NEXTNAME: R2 = names, dots between, R3 = past them. R1 = the first, R0
; = its length, R2 = past it and its dot. Keeps every other register.
NEXTNAME:
        .JSB_ENTRY  OUTPUT=<R2>
        MOVL    R2, R1
10$:    CMPL    R2, R3
        BGEQU   20$
        CMPB    (R2), #^A/./
        BEQL    20$
        INCL    R2
        BRB     10$
20$:    SUBL3   R1, R2, R0
        CMPL    R2, R3
        BGEQU   30$
        INCL    R2
30$:    RSB

; GODIR: reads the header of WPATH's directory into RMS$AB_DIRHDR, and
; its file ID into DIRFID, if it is a wildcard directory's; RMS$PARSE
; read the others'. R0 = DIRWALK's status. Uses R0-R11.
GODIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    #RMS$_NORMAL, R0
        TSTL    WPATL
        BEQL    90$
        MOVAB   WPATH, R10
        ADDL3   R10, WPATHL, R11
        BSBW    DIRWALK
90$:    RSB

; SUBDIR: R9 = 0, or SUBKEY. Finds the first directory in RMS$AB_DIRHDR's,
; after R9's, that the wildcard directory names, or names some in:
; NAME.DIR;1 but the MFD's own. WPATH becomes it. R0 = 1, or 0 if there
; is none. Uses R0-R9.
SUBDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9>
10$:    MOVAB   RMS$AB_DIRHDR, R3
        MOVAB   DIRSTAR, R6
        MOVL    #5, R7
        MOVL    #1, R8
        BSBW    FIL$SEARCHDIR
        BLBC    R0, 80$
        CMPL    R2, #48
        BGTRU   80$
        MOVB    R2, SUBKEY+2            ; the one to go on after
        MOVC3   R2, (R1), SUBKEY+3
        MOVAB   SUBKEY, R9
        MOVZBL  SUBKEY+2, R0            ; its name
        SUBL2   #4, R0
        MOVAB   SUBKEY+3, R1
        TSTL    WPATHL                  ; in the MFD, 000000 is the MFD
        BNEQ    20$
        CMPL    R0, #6
        BNEQ    20$
        CLRL    R2
15$:    CMPB    (R1)[R2], MFDNAME[R2]
        BNEQ    20$
        AOBLSS  #6, R2, 15$
        BRB     10$
20$:    PUSHL   WPATHL
        MOVAL   WPATHL, R4
        BSBW    APPNAME
        BLBC    R0, 30$
        BSBW    HERE
        TSTL    R0
        BNEQ    70$
30$:    MOVL    (SP)+, WPATHL
        BRB     10$
70$:    TSTL    (SP)+
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; UPDIR: WPATH's last name, NAME.DIR, into SUBKEY, and WPATH the names
; before it. Uses R0-R3.
UPDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    WPATHL, R0
10$:    DECL    R0
        BLSS    20$
        CMPB    WPATH[R0], #^A/./
        BNEQ    10$
20$:    INCL    R0                      ; the name's first character
        SUBL3   R0, WPATHL, R2
        MOVAB   WPATH[R0], R1
        DECL    R0                      ; its dot, or 0
        BGEQ    30$
        CLRL    R0
30$:    MOVL    R0, WPATHL
        ADDB3   #4, R2, SUBKEY+2
        MOVC3   R2, (R1), SUBKEY+3
        MOVL    DOTDIR, (R3)
        RSB

; MKRES: R1 = a name, NAME.TYPE, R2 = its length, R4 = a version. Makes
; the resultant specification in RES, with the expanded one's device and
; directory, or a wildcard directory's WPATH, and its parts in RESF.
; Uses R0-R6.
MKRES:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVL    R1, RESNAME
        MOVL    R2, RESNAME+4
        MOVL    R4, RESVER
        MOVAB   RES, R6
        CLRL    R5                      ; the device and directory
10$:    MOVAQ   RESF[R5], R3
        MOVL    R6, (R3)
        MOVAQ   FIELDS[R5], R0
        MOVL    (R0), R1
        MOVL    4(R0), R2
        BSBB    APPEND
        SUBL3   (R3), R6, 4(R3)
        AOBLSS  #2, R5, 10$
        TSTL    WPATL                   ; a wildcard directory: the one it is in
        BEQL    18$
        MOVL    RESF+8, R6
        MOVB    #91, (R6)+
        MOVAB   WPATH, R1
        MOVL    WPATHL, R2
        BNEQ    15$
        MOVAB   MFDNAME, R1
        MOVL    #6, R2
15$:    BSBB    APPEND
        MOVB    #93, (R6)+
        SUBL3   RESF+8, R6, RESF+12
18$:    MOVL    RESNAME, R1             ; the name, up to the dot
        CLRL    R2
20$:    CMPL    R2, RESNAME+4
        BGEQU   25$
        CMPB    (R1)[R2], #^A/./
        BEQL    25$
        INCL    R2
        BRB     20$
25$:    MOVL    R6, RESF+16
        BSBB    APPEND
        SUBL3   RESF+16, R6, RESF+20
        MOVL    R6, RESF+24             ; the type, the rest
        ADDL2   R2, R1
        SUBL3   R2, RESNAME+4, R2
        BSBB    APPEND
        SUBL3   RESF+24, R6, RESF+28
        MOVL    R6, RESF+32             ; the version
        MOVB    #59, (R6)+                ; a semicolon
        MOVL    RESVER, R1
        BSBB    DECIMAL
        SUBL3   RESF+32, R6, RESF+36
        MOVAB   RES, R0
        SUBL3   R0, R6, RESLEN
        RSB

; APPEND: copies the R2 bytes at R1 to R6, and R6 past them. Uses R0.
APPEND:
        .JSB_ENTRY  OUTPUT=<R6>
        CLRL    R0
10$:    CMPL    R0, R2
        BGEQU   20$
        MOVB    (R1)[R0], (R6)+
        INCL    R0
        BRB     10$
20$:    RSB

; DECIMAL: writes R1 in decimal at R6, and R6 past it. Uses R0-R3.
DECIMAL:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2, R3>
        CLRL    R2                      ; digits, on the stack
10$:    DIVL3   #10, R1, R0
        MULL3   #10, R0, R3
        SUBL3   R3, R1, R3
        ADDL2   #^A/0/, R3
        PUSHL   R3
        INCL    R2
        MOVL    R0, R1
        BNEQ    10$
20$:    MOVL    (SP)+, R0
        MOVB    R0, (R6)+
        SOBGTR  R2, 20$
        RSB

; PUTSTR: R0 = a specification, R1 = its length, R2 = its parts, R3 = a
; caller's string area in a NAM block, R4 = the area's size, R5 = the
; status if it is too small, R11 = the NAM block. Copies the
; specification to the area and points the NAM block's parts at it. R0 =
; RMS$_NORMAL, R5's status, or SS$_ACCVIO. Uses R0-R5.
PUTSTR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        CMPL    R1, R4
        BLEQU   10$
        MOVL    R5, R0
        RSB
10$:    IFNOWRT R1, (R3), 80$
        PUSHL   R0
        CLRL    R5
20$:    CMPL    R5, R1
        BGEQU   30$
        MOVB    (R0)[R5], (R3)[R5]
        INCL    R5
        BRB     20$
30$:    CLRL    R5
40$:    MOVAQ   (R2)[R5], R1
        MOVB    4(R1), NAM$B_DEV(R11)[R5]
        SUBL3   (SP), (R1), R4
        ADDL2   R3, R4
        MOVL    R4, NAM$L_DEV(R11)[R5]
        AOBLSS  #5, R5, 40$
        TSTL    (SP)+
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; RESUME: R11 = a NAM block, after RMS$PARSE of its expanded string.
; AFTER = the name, type and version of its resultant string, and for a
; wildcard directory WPATH its directory. R0 = RMS$_NORMAL, RMS$_RSS if
; there is none or it isn't one $SEARCH could have made, or SS$_ACCVIO.
; Uses R0-R7.
RESUME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        MOVZBL  NAM$B_RSL(R11), R1
        BEQL    80$
        MOVL    NAM$L_RSA(R11), R0
        IFNORD  R1, (R0), 85$
        MOVAQ   EQUT, R2
        BSBW    SPLIT
        BLBC    R0, 80$
        ADDL3   EQUT+20, EQUT+28, R0    ; NAME.TYPE
        CMPL    R0, #MAXKEY
        BGTRU   80$
        MOVB    R0, AFTER+2
        MOVC3   EQUT+20, @EQUT+16, AFTER+3
        MOVC3   EQUT+28, @EQUT+24, (R3)
        ADDL3   #1, EQUT+32, R1         ; the version, past its semicolon
        SUBL3   #1, EQUT+36, R2
        BLEQ    80$
        CLRL    R0
10$:    MOVZBL  (R1)+, R3
        SUBL2   #^A/0/, R3
        CMPL    R3, #9
        BGTRU   80$
        MULL2   #10, R0
        ADDL2   R3, R0
        CMPL    R0, #32767
        BGTRU   80$
        SOBGTR  R2, 10$
        MOVW    R0, AFTER
        TSTL    WPATL                   ; the directory, without 000000
        BEQL    70$
        CLRL    WPATHL
        ADDL3   #1, EQUT+8, R2
        ADDL3   EQUT+8, EQUT+12, R3
        DECL    R3                      ; at the closing bracket
        CMPL    R2, R3
        BGEQU   80$
20$:    BSBW    NEXTNAME
        CMPL    R0, #6
        BNEQ    30$
        CLRL    R4
25$:    CMPB    (R1)[R4], MFDNAME[R4]
        BNEQ    30$
        AOBLSS  #6, R4, 25$
        BRB     40$
30$:    TSTL    R0
        BEQL    80$
        MOVAL   WPATHL, R4
        BSBW    APPNAME
40$:    CMPL    R2, R3
        BLSSU   20$
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_RSS, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
        RSB

; PUTRES: R11 = a NAM block. Copies the resultant specification to its
; resultant string area, if it has one, and the file's and directory's
; IDs. R0 = RMS$_NORMAL, RMS$_RSS or SS$_ACCVIO. Uses R0-R5.
PUTRES:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  NAM$B_RSS(R11), R4
        BEQL    10$
        MOVAB   RES, R0
        MOVL    RESLEN, R1
        MOVAQ   RESF, R2
        MOVL    NAM$L_RSA(R11), R3
        MOVL    #RMS$_RSS, R5
        BSBW    PUTSTR
        BLBC    R0, 90$
        MOVB    RESLEN, NAM$B_RSL(R11)
10$:    MOVL    F11$GW_FID, NAM$W_FID(R11)
        MOVW    F11$GW_FID+4, NAM$W_FID+4(R11)
        MOVL    DIRFID, NAM$W_DID(R11)
        MOVW    DIRFID+4, NAM$W_DID+4(R11)
        MOVL    #RMS$_NORMAL, R0
90$:    RSB

; CHKACC: R0 = the access wanted, $ARMDEF's bits, R1 = a file header on
; F11$GL_VCB's volume. R0 = RMS$_NORMAL, or RMS$_PRV if the current
; process may not (FIL$CHKHDR). Keeps every other register.
CHKACC:
        .JSB_ENTRY
        BSBW    FIL$CHKHDR
        BLBC    R0, 10$
        MOVL    #RMS$_NORMAL, R0
        RSB
10$:    MOVL    #RMS$_PRV, R0
        RSB

; FINDXAB: R10 = a FAB. Finds the protection XAB in its chain: XABPRO =
; its address, or 0. R0 = RMS$_NORMAL, or SS$_ACCVIO if the caller can't
; read the chain or write the XAB. Uses R0-R2.
FINDXAB:
        .JSB_ENTRY  SCRATCH=<R2>
        CLRL    XABPRO
        MOVL    FAB$L_XAB(R10), R1
        MOVL    #MAXXAB, R2
10$:    TSTL    R1
        BEQL    70$
        IFNORD  #8, (R1), 80$
        CMPB    XAB$B_COD(R1), #XAB$C_PRO
        BEQL    20$
        MOVL    XAB$L_NXT(R1), R1
        SOBGTR  R2, 10$
        BRB     70$
20$:    IFNOWRT #XAB$C_PROLEN, (R1), 80$
        MOVL    R1, XABPRO
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; FABNAM: AP = a service's arguments, a FAB first. R10 = the FAB, R11 =
; its NAM block, or 0. R0 = RMS$_NORMAL; RMS$_FAB if the caller can't
; write a FAB there, RMS$_NAM if it can't a NAM block.
FABNAM:
        .JSB_ENTRY  SCRATCH=<R10, R11>
        MOVL    4(AP), R10
        IFNOWRT #FAB$C_BLN, (R10), 80$
        CMPB    FAB$B_BID(R10), #FAB$C_BID
        BNEQ    80$
        CMPB    FAB$B_BLN(R10), #FAB$C_BLN
        BLSSU   80$
        MOVL    FAB$L_NAM(R10), R11
        BEQL    70$
        IFNOWRT #NAM$C_BLN, (R11), 85$
        CMPB    NAM$B_BID(R11), #NAM$C_BID
        BNEQ    85$
        CMPB    NAM$B_BLN(R11), #NAM$C_BLN
        BLSSU   85$
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_FAB, R0
        RSB
85$:    MOVL    #RMS$_NAM, R0
        RSB

; PARSEFAB: R10 = a FAB. RMS$PARSE with its file specification and its
; default one, if the caller can read them. R0 = RMS$PARSE's status or
; SS$_ACCVIO. Uses R0-R4.
PARSEFAB:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        BSBB    FABCHK
        BLBC    R0, 90$
        BSBB    FABSPEC
        BSBW    RMS$PARSE
90$:    RSB

; FABCHK: R10 = a FAB. R0 = RMS$_NORMAL, or SS$_ACCVIO if the caller
; can't read its file specification and its default one. Uses R0-R3.
FABCHK:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        BSBB    FABSPEC
        TSTL    R1
        BEQL    10$
        IFNORD  R1, (R0), 80$
10$:    TSTL    R3
        BEQL    20$
        IFNORD  R3, (R2), 80$
20$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; FABSPEC: R10 = a FAB. R0-R4 as RMS$PARSE takes them: its file
; specification, its default one and the system's.
FABSPEC:
        .JSB_ENTRY  OUTPUT=<R1, R2, R3, R4>
        MOVL    FAB$L_FNA(R10), R0
        MOVZBL  FAB$B_FNS(R10), R1
        MOVL    FAB$L_DNA(R10), R2
        MOVZBL  FAB$B_DNS(R10), R3
        BRW     SYSDFLT

; SYSDFLT: R4 = SYSDEF, SYS$DISK: and the current process's default
; directory. Keeps every other register.
SYSDFLT:
        .JSB_ENTRY  OUTPUT=<R4>
        PUSHR   #^M<R0, R1, R2>
        MOVL    SCH$GL_CURPCB, R0
        MOVAB   PCB$T_DEFDIR(R0), R0
        MOVZBL  (R0)+, R1
        ADDB3   #9, R1, SYSDEF
        MOVAB   SYSDISK+9, R2
        TSTL    R1
        BEQL    20$
10$:    MOVB    (R0)+, (R2)+
        SOBGTR  R1, 10$
20$:    MOVAB   SYSDEF, R4
        POPR    #^M<R0, R1, R2>
        RSB

; FABDONE: R0 = a FAB service's status, R10 = the FAB. Puts it in
; FAB$L_STS, unless the FAB isn't one, and returns it. FAB$L_STV is
; SS$_NOSUCHFILE for RMS$_DNF, as VMS's, else 0.
        .MACRO  FABDONE ?L
        CMPL    R0, #RMS$_FAB
        BEQL    L
        MOVL    R0, FAB$L_STS(R10)
        CLRL    FAB$L_STV(R10)
        CMPL    R0, #RMS$_DNF
        BNEQ    L
        MOVL    #SS$_NOSUCHFILE, FAB$L_STV(R10)
L:      BSBW    FIL$UNLOCK
        RET
        .ENDM   FABDONE

; RABDONE: the same for a RAB service, with the RAB in R10.
        .MACRO  RABDONE ?L
        CMPL    R0, #RMS$_RAB
        BEQL    L
        MOVL    R0, RAB$L_STS(R10)
L:      BSBW    FIL$UNLOCK
        RET
        .ENDM   RABDONE

; $PARSE fab: parses the FAB's file specification, with its default one,
; into its NAM block: the expanded string, if the NAM block has an area
; for it, its parts, its directory's ID, NAM$M_WILDCARD, and
; NAM$M_SEARCH_LIST if its device is a search list, whose first string
; it is expanded with. A wildcard directory's ID is that of the
; directory its names before the first wildcard name. $SEARCH then finds the files it names. RMS$_DNF,
; when the directory doesn't exist, still gives the expanded string and
; its parts; but not for a search list's first string with more after
; it. So do RMS$_DEV, a device there isn't, and RMS$_DNR, one not
; mounted, as VMS's.
        .ENTRY  EXE$PARSE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVL    #RMS$_NAM, R0
        TSTL    R11
        BEQL    90$
        BSBW    PARSEFAB
        MOVL    R0, R9
        CMPL    R0, #RMS$_DNF
        BEQL    5$
        CMPL    R0, #RMS$_DEV
        BEQL    5$
        CMPL    R0, #RMS$_DNR
        BEQL    5$
        BLBC    R0, 90$
5$:     CLRL    NAM$L_WCC(R11)
        MOVZBL  NAM$B_ESS(R11), R4
        BEQL    10$
        MOVAB   RMS$T_EXP, R0
        MOVL    EXPLEN, R1
        MOVAQ   FIELDS, R2
        MOVL    NAM$L_ESA(R11), R3
        MOVL    #RMS$_ESS, R5
        BSBW    PUTSTR
        BLBC    R0, 90$
        MOVB    EXPLEN, NAM$B_ESL(R11)
10$:    MOVL    DIRFID, NAM$W_DID(R11)
        MOVW    DIRFID+4, NAM$W_DID+4(R11)
        CLRL    NAM$L_FNB(R11)
        TSTL    WILD
        BEQL    15$
        BISL2   #NAM$M_WILDCARD, NAM$L_FNB(R11)
15$:    TSTL    SLMORE
        BEQL    20$
        BISL2   #NAM$M_SEARCH_LIST, NAM$L_FNB(R11)
        MOVL    #RMS$_NORMAL, R9        ; the next string's directory may be there
20$:    MOVL    R9, R0
90$:    FABDONE

; $SEARCH fab: finds the next file the expanded string $PARSE left in the
; FAB's NAM block names, and puts its resultant string, its parts, its
; file ID and its directory's there. RMS$_FNF if there is none at all,
; then RMS$_NMF when there are no more, and the next $SEARCH starts
; again. A wildcard directory, [*], [A.*], [A...] or [...], is searched
; depth first, each directory's files before those of the directories
; in it, as VMS's RMS does. Each $SEARCH goes on after the file in the
; resultant string, which must be there for a wildcard, else RMS$_RSS;
; so a file $ERASE takes away, or one made since, takes no file's place.
; NAM$L_WCC says whether it found one, WCC_FOUND, and one in this string
; of a search list, WCC_AFTER. With NAM$M_SEARCH_LIST, it is the FAB's
; specification that is parsed again, with each string of the search
; list in turn, which NAM$L_WCC holds too: a string whose directory
; isn't there is passed over. The search's place is all in the NAM
; block and its strings, so an image may search with any number at once.
        .ENTRY  EXE$SEARCH, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVL    #RMS$_NAM, R0
        TSTL    R11
        BEQL    90$
        MOVL    #RMS$_ESA, R0
        MOVZBL  NAM$B_ESL(R11), R1
        BEQL    90$
        MOVL    NAM$L_ESA(R11), R0
        IFNORD  R1, (R0), 85$
3$:     EXTZV   #WCC_V_LIST, #WCC_S_LIST, NAM$L_WCC(R11), SLIDX
        BITL    #NAM$M_SEARCH_LIST, NAM$L_FNB(R11)
        BEQL    4$
        BSBW    FABCHK
        BLBC    R0, 90$
        BSBW    FABSPEC
        BRB     5$
4$:     MOVL    NAM$L_ESA(R11), R0
        MOVZBL  NAM$B_ESL(R11), R1
        CLRQ    R2
        BSBW    SYSDFLT
5$:     BSBW    PARSEIDX
        BLBS    R0, 7$
        CMPL    R0, #RMS$_NMF           ; the search list is shorter now
        BEQL    10$
        CMPL    R0, #RMS$_DNF
        BNEQ    90$
        TSTL    SLMORE
        BNEQ    8$
        TSTL    SLIDX
        BNEQ    10$
        BRB     90$
7$:     CLRB    AFTER+2
        BLBC    NAM$L_WCC(R11), 9$              ; WCC_AFTER: after the file it found
        TSTL    WILD
        BEQL    6$                              ; the only one
        BSBW    RESUME
        BLBC    R0, 90$
9$:     BSBW    SEARCH
        BLBS    R0, 20$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    90$
6$:     TSTL    SLMORE
        BEQL    10$
8$:     BICL2   #WCC_AFTER, NAM$L_WCC(R11)      ; the next string, from its start
        ADDL2   #1@WCC_V_LIST, NAM$L_WCC(R11)
        BRB     3$
10$:    MOVL    #RMS$_NMF, R0
        BBS     #31, NAM$L_WCC(R11), 15$        ; WCC_FOUND
        MOVL    #RMS$_FNF, R0
15$:    CLRL    NAM$L_WCC(R11)
        BRB     90$
20$:    BISL2   #WCC_FOUND!WCC_AFTER, NAM$L_WCC(R11)
        BSBW    PUTRES
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
90$:    FABDONE

; $OPEN fab: opens the file the FAB names, for FAB$B_FAC's access, $GET's
; if it gives none: puts its IFI in the FAB, with its organization,
; record format and attributes, maximum record size, allocation, bucket
; size, VFC header size and default extension, and a relative file's
; maximum record number; in its NAM block, if it has one, its resultant
; string and file ID; and in its XABs what they ask for (RMS$XABOUT).
; RMS$_PRV without read access to it. With FAB$M_PUT, or another way of
; writing: RMS$_WLK on a volume that can't be written, the system disk's,
; RMS$_PRV without write access too, or for the volume's own files and
; directories. With FAB$M_BIO or FAB$M_BRO, a file of any organization
; is opened for $READ, $WRITE and $SPACE. RMS$_ORG for an organization
; RMS doesn't know, RMS$_PLV for an indexed file that isn't prologue 3.
        .ENTRY  EXE$OPEN, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        BSBW    FINDXAB
        BLBC    R0, 90$
        BSBW    FABCHK
        BLBC    R0, 90$
        BSBW    FABSPEC
        PUSHR   #^M<R0, R1, R2, R3>
        BSBW    NEWIFAB
        MOVL    R0, R6
        POPR    #^M<R0, R1, R2, R3>
        BLBS    R6, 5$
        MOVL    R6, R0
        BRB     90$
5$:     PUSHR   #^M<R7, R8, R9>
        MOVAB   IFB$AB_HDR(R7), R5
        BSBW    RMS$LOCATE
        POPR    #^M<R7, R8, R9>
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, IFB$L_VCB(R7)       ; the volume it was found on
        MOVW    VERLIM, IFB$W_VERLIMIT(R7)
        MOVZBL  FAB$B_FAC(R10), R6      ; the access: $GET's if it gives none
        BNEQ    7$
        MOVL    #FAB$M_GET, R6
7$:     MOVB    R6, IFB$B_FAC(R7)
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, R6
        BEQL    10$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 80$
10$:    MOVL    #ARM$M_READ, R0
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, IFB$B_FAC(R7)
        BEQL    12$
        MOVL    #ARM$M_READ!ARM$M_WRITE, R0
12$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    CHKACC
        BLBC    R0, 80$
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, IFB$B_FAC(R7)
        BEQL    20$
        MOVL    #RMS$_PRV, R0
        TSTB    IFB$AB_HDR+FH2$B_FID_NMX(R7)
        BNEQ    15$
        CMPW    IFB$AB_HDR+FH2$W_FID(R7), #RESFILES
        BLEQU   80$
15$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$ISDIR
        MOVL    R0, R1
        MOVL    #RMS$_PRV, R0
        BLBS    R1, 80$
        BISL2   #1@IFB$V_WRITE, IFB$L_FLAGS(R7)
20$:    BSBW    ARBLOCK
        BLBC    R0, 80$
        TSTL    R11
        BEQL    30$
        BSBW    PUTRES
        BLBC    R0, 80$
30$:    BSBW    ATTRS
        PUSHR   #^M<R8, R9>
        BSBW    ORGOPEN
        POPR    #^M<R8, R9>
        BLBC    R0, 80$
        BSBW    RMS$XABOUT
        BLBC    R0, 80$
        BSBW    INSTALL
        BSBW    FABATTRS
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    BSBW    FREEIFAB
90$:    FABDONE

; ATTRS: R7 = an IFAB with its file's header. Gives the IFAB the file's
; organization, record format and attributes, record size, VFC header
; size (2 if the header says 0) and bucket size. Uses R0.
ATTRS:
        .JSB_ENTRY
        MOVZBL  IFB$AB_HDR+FAT$B_RTYPE(R7), R0
        BICB3   #^XF0, R0, IFB$B_RFM(R7)
        BICB3   #^X0F, R0, IFB$B_ORG(R7)
        MOVB    IFB$AB_HDR+FAT$B_RATTRIB(R7), IFB$B_RAT(R7)
        MOVW    IFB$AB_HDR+FAT$W_MAXREC(R7), IFB$W_MRS(R7)
        CMPB    IFB$B_RFM(R7), #FAB$C_FIX       ; a FIX record's size
        BNEQ    10$
        TSTW    IFB$W_MRS(R7)
        BNEQ    10$
        MOVW    IFB$AB_HDR+FAT$W_RSIZE(R7), IFB$W_MRS(R7)
10$:    MOVB    IFB$AB_HDR+FAT$B_VFCSIZE(R7), IFB$B_FSZ(R7)
        CMPB    IFB$B_RFM(R7), #FAB$C_VFC
        BNEQ    20$
        TSTB    IFB$B_FSZ(R7)
        BNEQ    20$
        MOVB    #2, IFB$B_FSZ(R7)
20$:    MOVB    IFB$AB_HDR+FAT$B_BKTSIZE(R7), IFB$B_BKS(R7)
        RSB

; FABATTRS: R7 = an IFAB, R10 = its FAB. Gives the FAB the file's
; attributes: organization, record format and attributes, maximum record
; size, VFC header size, bucket size, allocation, default extension, and
; maximum record number. Uses R0.
FABATTRS:
        .JSB_ENTRY
        MOVB    IFB$B_ORG(R7), FAB$B_ORG(R10)
        MOVB    IFB$B_RFM(R7), FAB$B_RFM(R10)
        MOVB    IFB$B_RAT(R7), FAB$B_RAT(R10)
        MOVW    IFB$W_MRS(R7), FAB$W_MRS(R10)
        MOVB    IFB$B_FSZ(R7), FAB$B_FSZ(R10)
        MOVB    IFB$B_BKS(R7), FAB$B_BKS(R10)
        ROTL    #16, IFB$AB_HDR+FAT$L_HIBLK(R7), FAB$L_ALQ(R10)
        MOVW    IFB$AB_HDR+FAT$W_DEFEXT(R7), FAB$W_DEQ(R10)
        MOVW    IFB$AB_HDR+FAT$W_GBC(R7), FAB$W_GBC(R10)
        MOVL    IFB$L_MRN(R7), FAB$L_MRN(R10)
        RSB

; ORGOPEN: R7 = an IFAB with its file's header and attributes, R10 =
; its FAB. Sets up its organization's state and buffer: SEQ$OPEN,
; REL$OPEN or IDX$OPEN, or SEQ$OPEN for block I/O. R0 = their status, or
; RMS$_ORG. Uses R0-R6, R8, R9, R11.
ORGOPEN:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R8, R9, R11>
        BBC     #FAB$V_BIO, IFB$B_FAC(R7), 10$
        BISL2   #1@IFB$V_BIO, IFB$L_FLAGS(R7)
        BRB     20$
10$:    BBC     #FAB$V_BRO, IFB$B_FAC(R7), 30$
        BISL2   #1@IFB$V_BRO, IFB$L_FLAGS(R7)
        CMPB    IFB$B_ORG(R7), #FAB$C_SEQ       ; ponytail: BRO on relative and indexed files is BIO
        BEQL    20$
        BISL2   #1@IFB$V_BIO, IFB$L_FLAGS(R7)
20$:    BSBW    SEQ$OPEN
        RSB
30$:    CMPB    IFB$B_ORG(R7), #FAB$C_SEQ
        BNEQ    40$
        BSBW    SEQ$OPEN
        RSB
40$:    CMPB    IFB$B_ORG(R7), #FAB$C_REL
        BNEQ    50$
        BSBW    REL$OPEN
        RSB
50$:    CMPB    IFB$B_ORG(R7), #FAB$C_IDX
        BNEQ    80$
        BSBW    IDX$OPEN
        RSB
80$:    MOVL    #RMS$_ORG, R0
        RSB

; NEWIFAB: R9 = the current PCB, R8 = an IFI it has free, R7 = an IFAB
; for it, on F11$GL_VCB's volume, with no buffer or current record yet,
; which INSTALL gives it. R0 = RMS$_NORMAL, or RMS$_DME if the process
; has every IFI or the pool has no room. Uses R0-R3.
NEWIFAB:
        .JSB_ENTRY  OUTPUT=<R7, R8, R9>, SCRATCH=<R2, R3>
        MOVL    SCH$GL_CURPCB, R9       ; a free IFI
        MOVL    #1, R8
10$:    TSTL    PCB$A_IFAB(R9)[R8]
        BEQL    20$
        AOBLEQ  #MAXIFI, R8, 10$
        BRB     80$
20$:    MOVL    #IFB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, R7
        PUSHR   #^M<R4, R5>
        MOVC5   #0, (R7), #0, #IFB$AB_HDR, (R7)
        POPR    #^M<R4, R5>
        MOVL    #IFB$K_LENGTH, IFB$L_SIZE(R7)
        CLRL    IFB$L_RLB(R7)
        MOVL    F11$GL_VCB, IFB$L_VCB(R7)
        MNEGL   #1, IFB$L_CUR(R7)
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DME, R0
        RSB

; RMS$ALLOCBUF: R7 = an IFAB, R1 = a size in bytes. Gives it a buffer of
; pool that big, zeroed, 65535 bytes at a time, MOVC5's most, which
; FREEIFAB gives back: IFB$L_BUF. R0 = RMS$_NORMAL or RMS$_DME. Uses
; R0-R3.
RMS$ALLOCBUF::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHL   R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, IFB$L_BUF(R7)
        MOVL    R1, IFB$L_BUFSZ(R7)
        PUSHR   #^M<R4, R5, R6, R7>
        MOVL    16(SP), R6              ; R6 = the bytes left, R7 = where
        MOVL    R2, R7
10$:    CMPL    R6, #^XFFFF
        BLEQU   20$
        MOVC5   #0, (R7), #0, #^XFFFF, (R7)
        ADDL2   #^XFFFF, R7
        SUBL2   #^XFFFF, R6
        BRB     10$
20$:    MOVC5   #0, (R7), #0, R6, (R7)
        POPR    #^M<R4, R5, R6, R7>
        TSTL    (SP)+
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    TSTL    (SP)+
        MOVL    #RMS$_DME, R0
        RSB

; FREEIFAB: R7 = an IFAB. Gives back its record locks, its access
; arbitration lock, and it and its buffer to the pool, and R0 as it was.
; Uses R1-R3.
FREEIFAB:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHL   R0
        BSBW    RMS$UNLOCKALL
        MOVL    IFB$L_LKID(R7), R1
        BSBW    UNLOCKFILE
        MOVL    IFB$L_BUF(R7), R0
        BEQL    10$
        MOVL    IFB$L_BUFSZ(R7), R1
        BSBW    EXE$DEANONPGDSIZ
10$:    MOVL    R7, R0
        MOVL    IFB$L_SIZE(R7), R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        RSB

; ARBLOCK: R7 = an IFAB with its file's header and access, on
; F11$GL_VCB's volume, R10 = its FAB. Takes the file's access
; arbitration lock, in the mode that access and the sharing FAB$B_SHR
; allows others call for, as VMS's XQP does: EX with FAB$M_NIL, or for
; writing that shares nothing; CW for writing that others may write too;
; PW for writing that others may only read; PR for reading that others
; may only read, FAB$M_SHRGET or no sharing at all; CR for reading that
; others may write. Its ID goes in IFB$L_LKID. Those that share with a
; writer, CW, PW and CR, lock the records they read (IFB$V_RLK). R0 =
; RMS$_NORMAL, RMS$_FLK if another open of the file's lock blocks it, or
; RMS$_DME. Uses R0-R3.
; ponytail: CW and record locks for an indexed file's record I/O only:
; another file's writer that shares writing is PW, so a second one gets
; RMS$_FLK, until relative files keep their buckets in step as indexed
; ones do (RMS$SYNC); no FAB$M_UPI or FAB$M_MSE.
ARBLOCK:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVZBL  FAB$B_SHR(R10), R0
        MOVL    #LCK$K_EXMODE, R1
        BBS     #FAB$V_NIL, R0, 30$
        CLRL    R2                      ; R2 = 1 for an indexed file's record I/O
        BICB3   #^X0F, IFB$AB_HDR+FAT$B_RTYPE(R7), R3
        CMPB    R3, #FAB$C_IDX
        BNEQ    5$
        BITB    #FAB$M_BIO!FAB$M_BRO, IFB$B_FAC(R7)
        BNEQ    5$
        MOVL    #1, R2
5$:     BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, IFB$B_FAC(R7)
        BEQL    10$
        BITB    #FAB$M_SHRGET!FAB$M_SHRPUT!FAB$M_SHRDEL!FAB$M_SHRUPD, R0
        BEQL    30$
        MOVL    #LCK$K_PWMODE, R1
        BITB    #FAB$M_SHRPUT!FAB$M_SHRDEL!FAB$M_SHRUPD, R0
        BEQL    20$
        TSTL    R2
        BEQL    20$
        MOVL    #LCK$K_CWMODE, R1
        BRB     20$
10$:    MOVL    #LCK$K_CRMODE, R1
        BITB    #FAB$M_SHRPUT!FAB$M_SHRDEL!FAB$M_SHRUPD, R0
        BNEQ    20$
        MOVL    #LCK$K_PRMODE, R1
        BRB     30$
20$:    BLBC    R2, 30$                 ; shared with a writer: record locks
        BISL2   #1@IFB$V_RLK, IFB$L_FLAGS(R7)
30$:    MOVAB   IFB$AB_HDR(R7), R2
        BSBW    LOCKFILE
        BLBC    R0, 90$
        MOVL    R1, IFB$L_LKID(R7)
90$:    RSB

; LOCKFILE: R1 = a lock mode, R2 = a file's header, on F11$GL_VCB's
; volume. Takes the file's access arbitration lock in that mode, if no
; other lock on it blocks that: a kernel mode lock of the system's on
; F11B$a, the device's name and the file ID, which is never queued. R0 =
; RMS$_NORMAL and R1 = its ID; RMS$_FLK if another lock blocks it;
; RMS$_DME if the pool has no room. Uses R0-R3.
; vaxpunk: VMS's XQP names the lock after the volume, not the device,
; under a lock for the volume; no program looks at either.
LOCKFILE:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        SUBL2   #32, SP                 ; the status block, then the name
        MOVL    SP, R3
        MOVL    ARBNAM, 8(R3)
        MOVW    ARBNAM+4, 12(R3)
        MOVL    F11$GL_VCB, R0
        MOVL    VCB$T_DEVNAM(R0), 14(R3)
        MOVB    VCB$T_DEVNAM+4(R0), 18(R3)
        MOVL    FH2$W_FID(R2), 19(R3)
        MOVW    FH2$W_FID+4(R2), 23(R3)
        MOVL    SCH$GL_CURPCB, R0
        DSBINT  #IPL$_SYNCH
        CLRL    -(SP)                   ; no blocking AST,
        CLRL    -(SP)                   ; parent
        CLRL    -(SP)                   ; or ACB: it completes now or not at all
        MNEGL   #1, -(SP)               ; the system's
        CLRL    -(SP)                   ; kernel mode
        PUSHAB  8(R3)
        PUSHL   #17                     ; F11B$a, DDCU:, the file ID
        PUSHL   #LCK$M_NOQUEUE
        PUSHL   R3
        PUSHL   R1
        PUSHL   PCB$L_PID(R0)
        CALLS   #11, G^LCK$ENQ
        ENBINT
        MOVL    4(R3), R1
        CMPL    R0, #SS$_SYNCH
        BNEQ    10$
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
10$:    CMPL    R0, #SS$_NOTQUEUED
        BNEQ    20$
        MOVL    #RMS$_FLK, R0
        BRB     90$
20$:    MOVL    #RMS$_DME, R0
90$:    ADDL2   #32, SP
        RSB

; UNLOCKFILE: R1 = an access arbitration lock's ID, or 0. Gives it back.
; Keeps every register.
UNLOCKFILE:
        .JSB_ENTRY
        TSTL    R1
        BEQL    90$
        PUSHR   #^M<R0, R1, R2, R3>
        MOVL    SCH$GL_CURPCB, R0
        DSBINT  #IPL$_SYNCH
        CLRL    -(SP)                   ; no value block
        CLRL    -(SP)                   ; or flags
        CLRL    -(SP)                   ; kernel mode
        PUSHL   R1
        PUSHL   PCB$L_PID(R0)
        CALLS   #5, G^LCK$DEQ
        ENBINT
        POPR    #^M<R0, R1, R2, R3>
90$:    RSB

; RMS$LOCKREC: R7 = an IFAB, R10 = its RAB, R0 = a VBN and R1 = an ID: a
; record's RFA, R2 = 0 for $GET and $FIND, 1 for $PUT. If the open locks
; records (IFB$V_RLK), locks the record for the stream as RAB$L_ROP
; says, as VMS's RMS: a $GET or $FIND drops the stream's lock on its last
; record first, unless RAB$M_ULK took it; a writer's lock is EX, PW with
; RAB$M_RLK, PR with RAB$M_REA; with RAB$M_NLK, or by a reader without
; REA, a $GET or $FIND only asks whether the record may be read, PR then
; CR, and holds nothing; another stream's lock refuses it, or with
; RAB$M_RRL lets it read the record anyway, unlocked, or with RAB$M_WAT
; it waits, without FIL$LOCK. A lock stays until the stream's next
; operation, or with RAB$M_ULK until $FREE, $RELEASE, $REWIND,
; $DISCONNECT or $CLOSE. The locks are kernel mode sublocks of the file's
; access arbitration lock, named by the RFA (RLB$L_ID). R0 =
; RMS$_NORMAL; RMS$_OK_ALK if the stream holds it already, RMS$_OK_RLK if
; another holds it but lets it be read, RMS$_OK_WAT after a wait, which
; may have changed the file; RMS$_RLK with SS$_NOTQUEUED in RAB$L_STV,
; RMS$_OK_RRL, RMS$_DEADLOCK, RMS$_DME, or RMS$_ENQ with the lock
; manager's error in RAB$L_STV. Uses R0-R3.
; ponytail: no RAB$M_TMO: a wait lasts until the lock is granted, or the
; deadlock search ends it; no RAB$W_ROP_2's NQL, NODLCKWT or NODLCKBLK.
RMS$LOCKREC::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        BBS     #IFB$V_RLK, IFB$L_FLAGS(R7), 5$
        MOVL    #RMS$_NORMAL, R0
        RSB
5$:     PUSHR   #^M<R4, R5, R6>
        MOVQ    R0, R4                  ; R4 = the VBN, R5 = the ID
        MOVL    R2, R6                  ; R6 = 1 for $PUT
        BSBW    FINDRLB
        TSTL    R2
        BEQL    10$
        MOVL    #RMS$_OK_ALK, R0        ; held already
        BRW     90$
10$:    TSTL    R6
        BNEQ    20$
        BSBW    RMS$UNLOCKAUTO          ; the last record's goes
        BBS     #RAB$V_NLK, RAB$L_ROP(R10), 50$
        BBS     #IFB$V_WRITE, IFB$L_FLAGS(R7), 20$
        BBC     #RAB$V_REA, RAB$L_ROP(R10), 50$ ; a reader asks
20$:    MOVL    #LCK$K_EXMODE, R0       ; a lock: its mode
        BBC     #RAB$V_RLK, RAB$L_ROP(R10), 22$
        MOVL    #LCK$K_PWMODE, R0
22$:    BBC     #RAB$V_REA, RAB$L_ROP(R10), 24$
        MOVL    #LCK$K_PRMODE, R0
24$:    PUSHL   R0
        MOVQ    R4, R1
        EXTZV   #RAB$V_WAT, #1, RAB$L_ROP(R10), R3
        BSBW    RECENQ
        MOVL    (SP)+, R3               ; R3 = the mode
        CMPL    R0, #SS$_SYNCH
        BEQL    30$
        CMPL    R0, #SS$_NORMAL
        BNEQ    70$
        PUSHL   #RMS$_OK_WAT            ; granted after a wait
        BRB     32$
30$:    PUSHL   #RMS$_NORMAL
32$:    MOVL    R1, R0                  ; an RLB for it, first in the list
        MOVL    #RLB$K_LENGTH, R1
        PUSHR   #^M<R0, R3>
        BSBW    EXE$ALONONPAGED
        POPR    #^M<R1, R3>
        BLBS    R0, 35$
        BSBW    UNLOCKFILE              ; no room: it goes
        TSTL    (SP)+
        MOVL    #RMS$_DME, R0
        BRB     90$
35$:    MOVL    R1, RLB$L_LKID(R2)
        MOVL    R4, RLB$L_VBN(R2)
        MOVL    R5, RLB$L_ID(R2)
        MOVB    R3, RLB$B_MODE(R2)
        CLRB    RLB$B_AUTO(R2)
        BBS     #RAB$V_ULK, RAB$L_ROP(R10), 37$
        MOVB    #1, RLB$B_AUTO(R2)
37$:    MOVL    IFB$L_RLB(R7), RLB$L_NEXT(R2)
        MOVL    R2, IFB$L_RLB(R7)
        MOVL    (SP)+, R0
        BRB     90$
50$:    MOVL    #LCK$K_PRMODE, R0       ; asking: may it be read?
        MOVQ    R4, R1
        CLRL    R3
        BSBW    RECENQ
        CMPL    R0, #SS$_SYNCH
        BNEQ    55$
        BSBW    UNLOCKFILE
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
55$:    CMPL    R0, #SS$_NOTQUEUED
        BNEQ    70$
        MOVL    #LCK$K_CRMODE, R0       ; locked: by an RLK lock?
        MOVQ    R4, R1
        EXTZV   #RAB$V_WAT, #1, RAB$L_ROP(R10), R3
        BSBW    RECENQ
        CMPL    R0, #SS$_SYNCH
        BEQL    60$
        CMPL    R0, #SS$_NORMAL
        BNEQ    70$
        BSBW    UNLOCKFILE
        MOVL    #RMS$_OK_WAT, R0
        BRB     90$
60$:    BSBW    UNLOCKFILE
        MOVL    #RMS$_OK_RLK, R0
        BRB     90$
70$:    MOVL    R0, RAB$L_STV(R10)      ; refused
        CMPL    R0, #SS$_NOTQUEUED
        BNEQ    75$
        MOVL    #RMS$_RLK, R0
        BBC     #RAB$V_RRL, RAB$L_ROP(R10), 90$
        MOVL    #RMS$_OK_RRL, R0
        CLRL    RAB$L_STV(R10)
        BRB     90$
75$:    CMPL    R0, #SS$_DEADLOCK
        BNEQ    77$
        MOVL    #RMS$_DEADLOCK, R0
        BRB     90$
77$:    MOVL    #RMS$_ENQ, R0
90$:    POPR    #^M<R4, R5, R6>
        RSB

; RECENQ: R7 = an IFAB, R0 = a lock mode, R1 = a record's VBN, R2 = its
; ID, R3 = 1 to wait. Asks for the record's lock, a kernel mode sublock
; of the file's access arbitration lock: never queued, or with R3 = 1
; queued if it must be, and waited for without FIL$LOCK (LCK$ENQWK). R0 =
; SS$_SYNCH if it was granted now, SS$_NORMAL after a wait, or the lock
; manager's refusal: SS$_NOTQUEUED, SS$_DEADLOCK...; R1 = its ID. Uses
; R0-R3.
RECENQ:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHR   #^M<R4, R5, R6>
        PUSHL   R1                      ; the name: the ID, then the VBN
        MOVZWL  R2, -(SP)
        MOVL    SP, R2
        SUBL2   #8, SP                  ; the status block
        MOVL    SP, R5
        MOVL    R0, R6
        MOVL    SCH$GL_CURPCB, R4
        DSBINT  #IPL$_SYNCH
        CLRL    -(SP)                   ; no blocking AST,
        PUSHL   IFB$L_LKID(R7)          ; the file's lock its parent,
        CLRL    -(SP)                   ; no ACB: it completes now or not at all
        MNEGL   #1, -(SP)               ; the system's
        CLRL    -(SP)                   ; kernel mode
        PUSHL   R2
        PUSHL   #8
        PUSHL   #LCK$M_NOQUEUE
        PUSHL   R5
        PUSHL   R6
        PUSHL   PCB$L_PID(R4)
        CALLS   #11, G^LCK$ENQ
        ENBINT
        MOVL    4(R5), R1
        CMPL    R0, #SS$_NOTQUEUED
        BNEQ    90$
        BLBC    R3, 90$
        BSBW    FIL$UNLOCK              ; wait for it, letting the others work
        MOVL    R6, R0
        MOVL    #RLKEFN, R1
        MOVL    #8, R3
        MOVL    IFB$L_LKID(R7), R4
        BSBW    LCK$ENQWK
        BSBW    FIL$LOCK
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        BLBC    R0, 90$
        MOVZWL  (R5), R0                ; how the wait ended
        MOVL    4(R5), R1
90$:    ADDL2   #16, SP
        POPR    #^M<R4, R5, R6>
        RSB

; FINDRLB: R7 = an IFAB, R0 = a VBN, R1 = an ID. R2 = the RLB of the
; stream's lock on that record, or 0, and R3 = the link to it. Keeps
; every other register.
FINDRLB:
        .JSB_ENTRY  OUTPUT=<R2, R3>
        MOVAL   IFB$L_RLB(R7), R3
10$:    MOVL    (R3), R2
        BEQL    90$
        CMPL    RLB$L_VBN(R2), R0
        BNEQ    20$
        CMPL    RLB$L_ID(R2), R1
        BEQL    90$
20$:    MOVL    R2, R3                  ; RLB$L_NEXT is the first longword
        BRB     10$
90$:    RSB

; FREERLB: R7 = an IFAB, R2 = an RLB of its stream's, R3 = the link to
; it. Gives back the lock and the RLB. Keeps every register.
FREERLB:
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3>
        MOVL    RLB$L_NEXT(R2), (R3)
        MOVL    RLB$L_LKID(R2), R1
        BSBW    UNLOCKFILE
        MOVL    R2, R0
        MOVL    #RLB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        POPR    #^M<R0, R1, R2, R3>
        RSB

; RMS$UNLOCKAUTO: R7 = an IFAB. Drops the stream's lock that its next
; operation drops, the one RAB$M_ULK didn't take, if it has one. Keeps
; every register.
RMS$UNLOCKAUTO::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        MOVAL   IFB$L_RLB(R7), R3
10$:    MOVL    (R3), R2
        BEQL    90$
        TSTB    RLB$B_AUTO(R2)
        BNEQ    20$
        MOVL    R2, R3
        BRB     10$
20$:    BSBW    FREERLB
90$:    POPR    #^M<R2, R3>
        RSB

; RMS$UNLOCKALL: R7 = an IFAB. Drops every record lock its stream holds,
; as $FREE. R0 = RMS$_NORMAL, or RMS$_RNL if it held none. Keeps every
; other register.
RMS$UNLOCKALL::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        MOVL    #RMS$_RNL, R0
10$:    MOVAL   IFB$L_RLB(R7), R3
        MOVL    (R3), R2
        BEQL    90$
        BSBW    FREERLB
        MOVL    #RMS$_NORMAL, R0
        BRB     10$
90$:    POPR    #^M<R2, R3>
        RSB

; RMS$UNLOCKREC: R7 = an IFAB, R0 = a VBN, R1 = an ID: a record's RFA.
; Drops the stream's lock on it, as $RELEASE. R0 = RMS$_NORMAL, or
; RMS$_RNL if the stream doesn't hold one. Keeps every other register.
RMS$UNLOCKREC::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        BSBW    FINDRLB
        MOVL    #RMS$_RNL, R0
        TSTL    R2
        BEQL    90$
        BSBW    FREERLB
        MOVL    #RMS$_NORMAL, R0
90$:    POPR    #^M<R2, R3>
        RSB

; RMS$RECHELD: R7 = an IFAB, R0 = a VBN, R1 = an ID: a record's RFA. R0 =
; 1 if the stream may change the record: the open locks no records, or
; the stream holds its lock in PW or EX mode; else 0. Keeps every other
; register.
RMS$RECHELD::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        BBC     #IFB$V_RLK, IFB$L_FLAGS(R7), 80$
        BSBW    FINDRLB
        CLRL    R0
        TSTL    R2
        BEQL    90$
        CMPB    RLB$B_MODE(R2), #LCK$K_PWMODE
        BLSSU   90$
80$:    MOVL    #1, R0
90$:    POPR    #^M<R2, R3>
        RSB

; RMS$FILEBUSY: R2 = a file's header, on F11$GL_VCB's volume. R0 =
; RMS$_NORMAL if no stream has it open, RMS$_FLK if one has, or RMS$_DME.
; Uses R0-R3.
RMS$FILEBUSY::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    #LCK$K_EXMODE, R1
        BSBW    LOCKFILE
        BLBC    R0, 90$
        BSBW    UNLOCKFILE
90$:    RSB

; MARKDEL: R2 = the header of a file open in some stream, on
; F11$GL_VCB's volume, its directory entry gone. Marks it for delete, on
; the disk and in each IFAB that has it open, in every process: the last
; to close it deletes it (DELLAST). R0 = SS$_NORMAL or the disk's error.
; Uses R0-R5.
MARKDEL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BISL2   #1@FCH$V_MARKDEL, FH2$L_FILECHAR(R2)
        MOVL    R2, R1
        BSBW    FIL$WRITEHDR
        DSBINT  #IPL$_SYNCH             ; their PCBs
        SUBL3   #1, SCH$GL_MAXPIX, R3
10$:    MOVL    @SCH$GL_PCBVEC[R3], R4
        BEQL    40$
        MOVL    #1, R5
20$:    BBC     R5, PCB$L_FILES(R4), 30$
        MOVL    PCB$A_IFAB(R4)[R5], R1
        CMPL    IFB$L_VCB(R1), F11$GL_VCB
        BNEQ    30$
        CMPL    IFB$AB_HDR+FH2$W_FID(R1), FH2$W_FID(R2)
        BNEQ    30$
        CMPW    IFB$AB_HDR+FH2$W_FID+4(R1), FH2$W_FID+4(R2)
        BNEQ    30$
        BISL2   #1@IFB$V_MARKDEL, IFB$L_FLAGS(R1)
        BISL2   #1@FCH$V_MARKDEL, IFB$AB_HDR+FH2$L_FILECHAR(R1)
30$:    AOBLEQ  #MAXIFI, R5, 20$
40$:    SOBGTR  R3, 10$
        ENBINT
        RSB

; PEER: R7 = an IFAB, R2 = 0, or what PEER gave last. R1 = the next
; other IFAB with R7's file open, in any process, and R2 where it is, a
; process's index times 16 and the IFI; or R1 = 0 when there is none
; left. Holding FIL$LOCK, so none comes or goes between calls. Keeps
; every other register.
PEER:
        .JSB_ENTRY  OUTPUT=<R1, R2>
        PUSHR   #^M<R0, R3, R4>
        DSBINT  #IPL$_SYNCH
        EXTZV   #4, #28, R2, R3         ; R3 = the process, R2 = the file
        BICL2   #^C15, R2
10$:    INCL    R2
        CMPL    R2, #MAXIFI
        BLEQU   20$
        MOVL    #1, R2                  ; the next process's first
        INCL    R3
20$:    CMPL    R3, SCH$GL_MAXPIX
        BGEQU   80$
        TSTL    R3                      ; slot 0 is no process
        BEQL    10$
        MOVL    @SCH$GL_PCBVEC[R3], R4
        BEQL    10$
        BBC     R2, PCB$L_FILES(R4), 10$
        MOVL    PCB$A_IFAB(R4)[R2], R1
        CMPL    R1, R7
        BEQL    10$
        CMPL    IFB$L_VCB(R1), IFB$L_VCB(R7)
        BNEQ    10$
        CMPL    IFB$AB_HDR+FH2$W_FID(R1), IFB$AB_HDR+FH2$W_FID(R7)
        BNEQ    10$
        CMPW    IFB$AB_HDR+FH2$W_FID+4(R1), IFB$AB_HDR+FH2$W_FID+4(R7)
        BNEQ    10$
        ASHL    #4, R3, R3
        BISL2   R3, R2
        BRB     90$
80$:    CLRL    R1
90$:    ENBINT
        POPR    #^M<R0, R3, R4>
        RSB

; RMS$SYNC: R7 = an IFAB whose stream changed its file. Gives every other
; open of the file, in any process, its copy of the header, and, if both
; are an indexed file's by record I/O, its key and area descriptors,
; and empties the other's slots (IDX$PEER): each open keeps the file's
; header and prologue, and a stream changes them only holding FIL$LOCK.
; Keeps every register.
RMS$SYNC::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5>
        CLRL    R2
10$:    BSBW    PEER
        TSTL    R1
        BEQL    90$
        PUSHR   #^M<R1, R2>
        MOVC3   #BLOCK, IFB$AB_HDR(R7), IFB$AB_HDR(R1)
        POPR    #^M<R1, R2>
        TSTL    IFB$L_IDX(R7)
        BEQL    10$
        TSTL    IFB$L_IDX(R1)
        BEQL    10$
        BSBW    IDX$PEER
        BRB     10$
90$:    POPR    #^M<R0, R1, R2, R3, R4, R5>
        RSB

; RMS$TAKEHDR: R7 = an IFAB just opened, with its file's header as the
; disk has it. If another stream has the file open, takes its copy
; instead, which is newer: a writer writes its header when it closes.
; Keeps every register.
RMS$TAKEHDR::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5>
        CLRL    R2
        BSBW    PEER
        TSTL    R1
        BEQL    90$
        MOVC3   #BLOCK, IFB$AB_HDR(R1), IFB$AB_HDR(R7)
90$:    POPR    #^M<R0, R1, R2, R3, R4, R5>
        RSB

; DELLAST: R7 = an IFAB of a file marked for delete. Gives back its access
; arbitration lock, and, if no other stream has the file open, deletes
; it, with its header as the disk has it now. Holding FIL$LOCK. Keeps
; every register.
; ponytail: an error deleting it isn't reported; the file is lost, as on
; VMS after a crash, with no directory entry and marked for delete.
DELLAST:
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5>
        MOVL    IFB$L_LKID(R7), R1
        BSBW    UNLOCKFILE
        CLRL    IFB$L_LKID(R7)
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        MOVAB   IFB$AB_HDR(R7), R2
        BSBW    RMS$FILEBUSY
        BLBC    R0, 90$
        MOVZBL  IFB$AB_HDR+FH2$B_FID_NMX(R7), R0
        ASHL    #16, R0, R0
        MOVW    IFB$AB_HDR+FH2$W_FID(R7), R0
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        BSBW    FIL$DELHDR
90$:    POPR    #^M<R0, R1, R2, R3, R4, R5>
        RSB

; INSTALL: R7 = an IFAB, R8 = its IFI, R9 = the current PCB, R10 = a FAB.
; Gives the process the open file, and the FAB its IFI. One the command
; interpreter opens, in supervisor mode, is one of PCB$L_CLIFILES, which
; outlive the image, as VMS's process permanent files. Uses R0.
INSTALL:
        .JSB_ENTRY
        MOVL    R7, PCB$A_IFAB(R9)[R8]
        ASHL    R8, #1, R0
        BISL2   R0, PCB$L_FILES(R9)
        MOVW    R8, FAB$W_IFI(R10)
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_PRVMOD, #2, R0, R0
        CMPL    R0, #PSL$C_SUPER
        BNEQ    10$
        BBSS    R8, PCB$L_CLIFILES(R9), 10$
10$:    RSB

; GETIFAB: R8 = an IFI. R7 = its IFAB, R9 = the current PCB, R0 =
; RMS$_NORMAL, or RMS$_IFI if the process has no such file open.
GETIFAB:
        .JSB_ENTRY  SCRATCH=<R7, R9>
        MOVL    SCH$GL_CURPCB, R9
        TSTL    R8
        BEQL    80$
        CMPL    R8, #MAXIFI
        BGTRU   80$
        MOVL    PCB$A_IFAB(R9)[R8], R7
        BEQL    80$
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_IFI, R0
        RSB

; CLOSEIFI: R8 = an IFI, R7 = its IFAB, R9 = the current PCB. Closes it:
; its record locks go; a file opened for writing gets what its buffers
; hold and its header written, with the revision date and count of a
; file that changed (ORGFLUSH), and the last stream to close a file
; $ERASE marked for delete deletes it (DELLAST). R0 = RMS$_NORMAL, or
; RMS$_WER if they couldn't be. Holding FIL$LOCK. Uses R0 and R1.
CLOSEIFI:
        .JSB_ENTRY
        BSBW    RMS$UNLOCKALL
        PUSHL   #RMS$_NORMAL
        BBC     #IFB$V_WRITE, IFB$L_FLAGS(R7), 20$
        PUSHR   #^M<R2, R3, R4, R5, R6, R8, R9, R10, R11>
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        MOVZBL  IFB$AB_HDR+FH2$B_IDOFFSET(R7), R0       ; the ident area, in words
        MOVAW   IFB$AB_HDR(R7)[R0], R0
        MOVQ    EXE$GQ_SYSTIME, FI2$Q_REVDATE(R0)
        INCW    FI2$W_REVISION(R0)
        BISL2   #1@IFB$V_HDR, IFB$L_FLAGS(R7)
        BSBW    ORGFLUSH
        POPR    #^M<R2, R3, R4, R5, R6, R8, R9, R10, R11>
        BLBS    R0, 20$
        MOVL    #RMS$_WER, (SP)
20$:    BBC     #IFB$V_MARKDEL, IFB$L_FLAGS(R7), 30$
        BSBW    DELLAST
30$:    CLRL    PCB$A_IFAB(R9)[R8]
        ASHL    R8, #1, R0
        BICL2   R0, PCB$L_FILES(R9)
        BICL2   R0, PCB$L_CLIFILES(R9)
        PUSHR   #^M<R2, R3>
        BSBW    FREEIFAB
        POPR    #^M<R2, R3>
        MOVL    (SP)+, R0
        RSB

; ORGFLUSH: R7 = an IFAB. Writes what its buffers hold that the file
; doesn't, and its header if it changed: SEQ$FLUSH, REL$FLUSH or
; IDX$FLUSH. R0 = their status. Uses R0-R6, R8-R11.
ORGFLUSH:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R8, R9, R10, R11>
        BBS     #IFB$V_BIO, IFB$L_FLAGS(R7), 10$
        CMPB    IFB$B_ORG(R7), #FAB$C_REL
        BEQL    20$
        BGTRU   30$
10$:    BSBW    SEQ$FLUSH
        RSB
20$:    BSBW    REL$FLUSH
        RSB
30$:    BSBW    IDX$FLUSH
        RSB

; $CLOSE fab: closes the file $OPEN or $CREATE opened, which first gets
; the owner and protection of the FAB's protection XAB, if it has one
; (SETPRO). The file is closed even if that fails, with SETPRO's status.
        .ENTRY  EXE$CLOSE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVZWL  FAB$W_IFI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 90$
        BSBW    SETPRO
        MOVL    R0, R6
        BSBW    CLOSEIFI
        CLRW    FAB$W_IFI(R10)
        BLBS    R6, 90$
        MOVL    R6, R0
90$:    FABDONE

; $DISPLAY fab: gives the FAB and its XABs the attributes of the file
; it opened, as $OPEN does. R0 = RMS$_NORMAL, RMS$_IFI, or RMS$XABOUT's
; error.
        .ENTRY  EXE$DISPLAY, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVZWL  FAB$W_IFI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 90$
        BSBW    FABATTRS
        BSBW    RMS$XABOUT
90$:    FABDONE

; SETPRO: R7 = an IFAB, R10 = its FAB. If the FAB has a protection XAB
; whose protection, or owner, unless it is 0, isn't the file's, gives the
; file those, in its header on the disk and in the IFAB's: a new
; protection takes control access, a new owner the system's. R0 =
; RMS$_NORMAL, RMS$_PRV, RMS$_WLK on a volume that can't be written,
; SS$_ACCVIO if the caller can't read the XAB, or the file system's error.
; Holding FIL$LOCK. Uses R0-R5.
SETPRO:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BSBW    FINDXAB
        BLBC    R0, 90$
        MOVL    XABPRO, R4
        BEQL    80$
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        CLRL    R5                      ; the access it takes
        CMPW    XAB$W_PRO(R4), IFB$AB_HDR+FH2$W_FILEPROT(R7)
        BEQL    10$
        BISL2   #ARM$M_CONTROL, R5
10$:    MOVL    XAB$L_UIC(R4), R0
        BNEQ    15$
        MOVL    IFB$AB_HDR+FH2$L_FILEOWNER(R7), R0
15$:    CMPL    R0, IFB$AB_HDR+FH2$L_FILEOWNER(R7)
        BEQL    20$
        BISL2   #ARM$M_SYSTEM, R5
20$:    TSTL    R5
        BEQL    80$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVZBL  IFB$AB_HDR+FH2$B_FID_NMX(R7), R0        ; the header as it is now
        ASHL    #16, R0, R0
        MOVW    IFB$AB_HDR+FH2$W_FID(R7), R0
        MOVAB   HDRBUF, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVL    #RMS$_FNF, R0           ; deleted since it was opened
        CMPW    HDRBUF+FH2$W_FID_SEQ, IFB$AB_HDR+FH2$W_FID_SEQ(R7)
        BNEQ    90$
        MOVL    R5, R0
        MOVAB   HDRBUF, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVW    XAB$W_PRO(R4), HDRBUF+FH2$W_FILEPROT
        MOVW    XAB$W_PRO(R4), IFB$AB_HDR+FH2$W_FILEPROT(R7)
        MOVL    XAB$L_UIC(R4), R0
        BEQL    30$
        MOVL    R0, HDRBUF+FH2$L_FILEOWNER
        MOVL    R0, IFB$AB_HDR+FH2$L_FILEOWNER(R7)
30$:    MOVAB   HDRBUF, R1
        BSBW    FIL$WRITEHDR
        BLBC    R0, 90$
80$:    MOVL    #RMS$_NORMAL, R0
90$:    RSB

; RABCHK: AP = a service's arguments, a RAB first. R10 = the RAB, R0 =
; RMS$_NORMAL, or RMS$_RAB if the caller can't write a RAB there.
RABCHK:
        .JSB_ENTRY  SCRATCH=<R10>
        MOVL    4(AP), R10
        IFNOWRT #RAB$C_BLN, (R10), 80$
        CMPB    RAB$B_BID(R10), #RAB$C_BID
        BNEQ    80$
        CMPB    RAB$B_BLN(R10), #RAB$C_BLN
        BLSSU   80$
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_RAB, R0
        RSB

; RABIFAB: AP = a record service's arguments, a RAB first. R10 = the
; RAB, R7 = the IFAB of the file it is connected to, on whose volume the
; file system works, and RAB$L_STV 0. R0 = RMS$_NORMAL, RMS$_RAB, or
; RMS$_ISI if it isn't connected. Uses R8 and R9.
RABIFAB:
        .JSB_ENTRY  OUTPUT=<R7, R10>, SCRATCH=<R8, R9>
        BSBW    RABCHK
        BLBC    R0, 90$
        CLRL    RAB$L_STV(R10)
        MOVZWL  RAB$W_ISI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 80$
        CMPL    IFB$L_RAB(R7), R10
        BNEQ    80$
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_ISI, R0
90$:    RSB

; $CONNECT rab: connects the RAB to the file its FAB opened: its stream
; starts at the first record, along key RAB$B_KRF in an indexed file, or
; with RAB$M_EOF past the last. RMS$_FAB if the RAB's FAB isn't one,
; RMS$_IFI if it opened no file, RMS$_ACT if a RAB is connected to it
; already, RMS$_KRF for a key the file hasn't.
; ponytail: one stream per file, FAB$M_MSE or not.
        .ENTRY  EXE$CONNECT, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABCHK
        BLBC    R0, 90$
        MOVL    RAB$L_FAB(R10), R1
        IFNORD  #FAB$C_BLN, (R1), 80$
        MOVZWL  FAB$W_IFI(R1), R8
        BSBW    GETIFAB
        BLBC    R0, 90$
        MOVL    #RMS$_ACT, R0
        TSTL    IFB$L_RAB(R7)
        BNEQ    90$
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        BBS     #IFB$V_BIO, IFB$L_FLAGS(R7), 10$
        CMPB    IFB$B_ORG(R7), #FAB$C_REL
        BEQL    20$
        BGTRU   30$
10$:    BSBW    SEQ$CONNECT
        BRB     40$
20$:    BSBW    REL$CONNECT
        BRB     40$
30$:    BSBW    IDX$CONNECT
40$:    BLBC    R0, 90$
        MOVL    R10, IFB$L_RAB(R7)
        MOVW    R8, RAB$W_ISI(R10)
        BRB     90$
80$:    MOVL    #RMS$_FAB, R0
90$:    RABDONE

; $DISCONNECT rab: disconnects the RAB from its file, writing what its
; buffers hold that the file doesn't; its record locks go.
        .ENTRY  EXE$DISCONNECT, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABIFAB
        BLBC    R0, 90$
        BSBW    RMS$UNLOCKALL
        PUSHL   R10
        BSBW    ORGFLUSH
        MOVL    (SP)+, R10
        CLRL    IFB$L_RAB(R7)
        CLRW    RAB$W_ISI(R10)
90$:    RABDONE

; RECORD name, seq, rel, idx[, bio]: the record service $name, which
; calls the routine for the file's organization with R7 = the IFAB and
; R10 = the RAB, or bio's for a file open for block I/O, RMS$_IOP by
; default, and returns its status in RAB$L_STS. Each may use R0-R6, R8,
; R9 and R11.
        .MACRO  RECORD  NAME, SEQ, REL, IDX, BIO=IOP, ?L1, ?L2, ?L3, ?L4
        .ENTRY  EXE$'NAME, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABIFAB
        BLBC    R0, L4
        BBC     #IFB$V_BIO, IFB$L_FLAGS(R7), L1
        BSBW    BIO
        BRB     L4
L1:     CMPB    IFB$B_ORG(R7), #FAB$C_REL
        BEQL    L2
        BGTRU   L3
        BSBW    SEQ
        BRB     L4
L2:     BSBW    REL
        BRB     L4
L3:     BSBW    IDX
L4:     RABDONE
        .ENDM   RECORD

; BLOCKIO name: the block I/O service $name, which calls BIO$name with
; R7 = the IFAB and R10 = the RAB, for a file opened with FAB$M_BIO or
; FAB$M_BRO, else RMS$_IOP.
        .MACRO  BLOCKIO NAME, ?L1, ?L2
        .ENTRY  EXE$'NAME, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABIFAB
        BLBC    R0, L2
        MOVL    #RMS$_IOP, R0
        BITL    #<1@IFB$V_BIO>!<1@IFB$V_BRO>, IFB$L_FLAGS(R7)
        BEQL    L2
        BSBW    BIO$'NAME
L2:     RABDONE
        .ENDM   BLOCKIO

; $GET rab: reads a record into the RAB's user buffer, RAB$W_USZ bytes
; at RAB$L_UBF, as much of it as fits: RAB$L_RBF points at it and
; RAB$W_RSZ is its size, RMS$_RTB if it didn't all fit. Which record
; RAB$B_RAC says: the next, by key or relative record number, or by RFA.
; It becomes the current record, and its RFA goes in RAB$W_RFA.
        RECORD  GET, SEQ$GET, REL$GET, IDX$GET

; $FIND rab: finds a record as $GET does, without reading it.
        RECORD  FIND, SEQ$FIND, REL$FIND, IDX$FIND

; $PUT rab: writes the record RAB$L_RBF points at, RAB$W_RSZ bytes: at
; the end of a sequential file, at the relative record number RAB$L_KBF
; points at, or in key order in an indexed file.
        RECORD  PUT, SEQ$PUT, REL$PUT, IDX$PUT

; $UPDATE rab: rewrites the current record with the one RAB$L_RBF points
; at.
        RECORD  UPDATE, SEQ$UPDATE, REL$UPDATE, IDX$UPDATE

; $DELETE rab: deletes the current record of a relative or indexed file;
; RMS$_IOP for a sequential one.
        RECORD  DELETE, IOP, REL$DELETE, IDX$DELETE

; $TRUNCATE rab: ends a sequential file at its current record; RMS$_IOP
; for the others.
        RECORD  TRUNCATE, SEQ$TRUNCATE, IOP, IOP

; $REWIND rab: the stream goes back to the first record.
        RECORD  REWIND, SEQ$REWIND, REL$REWIND, IDX$REWIND, BIO=SEQ$REWIND

; $FLUSH rab: writes what RMS's buffers hold that the file doesn't, and
; the file's header.
        RECORD  FLUSH, FLUSH, FLUSH, FLUSH, BIO=FLUSH

; $FREE rab: gives up every record lock the stream holds; RMS$_RNL if
; it holds none (RMS$UNLOCKALL). $RELEASE rab: gives up its lock on the
; record at RAB$W_RFA; RMS$_RNL if it doesn't hold that (RMS$UNLOCKREC).
; Only an indexed file's records are locked. $WAIT rab: every service is
; done when it returns.
        RECORD  FREE, RNL, RNL, RECFREE, BIO=RNL
        RECORD  RELEASE, RNL, RNL, RECRELEASE, BIO=RNL
        RECORD  WAIT, NORMAL, NORMAL, NORMAL, BIO=NORMAL

; $READ rab, $WRITE rab, $SPACE rab: block I/O (rmsseq.mar).
        BLOCKIO READ
        BLOCKIO WRITE
        BLOCKIO SPACE

; IOP, RNL, NORMAL, FLUSH, RECFREE, RECRELEASE: the record services'
; routines that only return RMS$_IOP, RMS$_RNL or RMS$_NORMAL, or call
; ORGFLUSH, RMS$UNLOCKALL or RMS$UNLOCKREC.
RECFREE:
        .JSB_ENTRY
        BSBW    RMS$UNLOCKALL
        RSB

RECRELEASE:
        .JSB_ENTRY
        MOVL    RAB$L_RFA0(R10), R0
        MOVZWL  RAB$W_RFA4(R10), R1
        BSBW    RMS$UNLOCKREC
        RSB

IOP:
        .JSB_ENTRY
        MOVL    #RMS$_IOP, R0
        RSB

RNL:
        .JSB_ENTRY
        MOVL    #RMS$_RNL, R0
        RSB

NORMAL:
        .JSB_ENTRY
        MOVL    #RMS$_NORMAL, R0
        RSB

FLUSH:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R8, R9, R11>
        PUSHL   R10
        BSBW    ORGFLUSH
        MOVL    (SP)+, R10
        RSB

; $CREATE fab: makes a new file, as the FAB names it, with its
; organization, record format and attributes, maximum record size, VFC
; header size, bucket size, default extension and allocation, FAB$L_ALQ
; blocks, and opens it for $PUT and the access FAB$B_FAC gives: its IFI
; goes in the FAB, and in its NAM block, if it has one, its resultant
; string and file ID. A relative file gets its prologue, with FAB$L_MRN
; (REL$CREATE); an indexed one its prologue, keys and areas from the
; FAB's XABKEYs and XABALLs (IDX$CREATE). Its version is one above the
; highest there is, unless the specification gives one; a name past its
; version limit then loses its lowest version (PURGEVER). The file is the
; current process's, with the protection of the highest version there
; is, or the default (f11wrt.mar), unless the FAB's protection XAB gives
; one, and an owner, not 0, which takes the system's access if it isn't
; the process's UIC (CREPRO). RMS$_WLD for a wildcard, RMS$_ORG for an
; organization RMS doesn't know, RMS$_WLK on a volume that can't be
; written, RMS$_PRV without write access to the directory or the
; system's for the owner, SS$_ACCVIO if the caller can't read the XAB
; chain or write the XAB, RMS$_FEX if that version is there, RMS$_FUL if
; the volume is full, RMS$_CRE for another error from the file system,
; which goes in FAB$L_STV, or the organization's error.
        .ENTRY  EXE$CREATE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVL    #RMS$_ORG, R0
        CMPB    FAB$B_ORG(R10), #FAB$C_IDX
        BGTRU   90$
        BITB    #^X0F, FAB$B_ORG(R10)
        BNEQ    90$
        BSBW    PARSEFAB
        BLBC    R0, 90$
        MOVL    #RMS$_WLD, R0
        TSTL    WILD
        BNEQ    90$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        BSBW    FINDXAB                 ; another owner takes the system's access
        BLBC    R0, 90$
        MOVL    XABPRO, R1
        BEQL    5$
        MOVL    XAB$L_UIC(R1), R1
        BEQL    5$
        MOVL    SCH$GL_CURPCB, R0
        CMPL    R1, PCB$L_UIC(R0)
        BEQL    5$
        MOVL    #ARM$M_SYSTEM, R0
        BSBW    FIL$CHKPRO
        BLBS    R0, 5$
        MOVL    #RMS$_PRV, R0
        BRB     90$
5$:     BSBW    NEWIFAB
        BLBC    R0, 90$
        BISB3   #FAB$M_PUT, FAB$B_FAC(R10), IFB$B_FAC(R7)
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$CREHDR
        BLBC    R0, 70$
        BSBW    CREPRO
        BSBW    CREATTRS
        MOVL    DIRFID, IFB$AB_HDR+FH2$W_BACKLINK(R7)
        MOVW    DIRFID+4, IFB$AB_HDR+FH2$W_BACKLINK+4(R7)
        MOVL    FAB$L_ALQ(R10), R1
        BEQL    20$
        MOVAB   IFB$AB_HDR(R7), R3
        BSBW    FIL$EXTEND
        BLBC    R0, 60$
20$:    BSBW    CRENTER
        BLBC    R0, 60$
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$WRITEHDR
        BLBC    R0, 60$
        MOVL    FIELDS+16, R1           ; its resultant string
        ADDL3   FIELDS+20, FIELDS+28, R2
        BSBW    MKRES
        MOVL    IFB$AB_HDR+FH2$W_FID(R7), F11$GW_FID
        MOVW    IFB$AB_HDR+FH2$W_FID+4(R7), F11$GW_FID+4
        TSTL    R11
        BEQL    30$
        BSBW    PUTRES
30$:    BISL2   #<1@IFB$V_WRITE>!<1@IFB$V_HDR>, IFB$L_FLAGS(R7)
        BSBW    ARBLOCK
        BLBC    R0, 50$
        BSBW    ATTRS
        PUSHR   #^M<R8, R9>
        BSBW    ORGCREATE
        POPR    #^M<R8, R9>
        BLBC    R0, 50$
        BSBW    RMS$XABOUT
        BLBC    R0, 50$
        BSBW    INSTALL
        BSBW    FABATTRS
        BSBW    PURGEVER
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
50$:    PUSHL   R0                      ; it goes, entry and all
        PUSHL   R7
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RESVER, R8
        BSBW    FIL$REMOVE
        MOVL    (SP)+, R7
        MOVL    (SP)+, R0
60$:    PUSHL   R0                      ; its blocks and header go back
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$DELHDR
        MOVL    (SP)+, R0
        CMPL    R0, #SS$_DUPFILENAME    ; that version is in the directory
        BNEQ    75$
        MOVL    #RMS$_FEX, R0
        BRB     75$
70$:    MOVL    R0, FAB$L_STV(R10)
        MOVL    R0, R1
        MOVL    #RMS$_FUL, R0
        CMPL    R1, #SS$_DEVICEFULL
        BEQL    75$
        MOVL    #RMS$_FEX, R0
        CMPL    R1, #SS$_DUPFILENAME
        BEQL    75$
        MOVL    #RMS$_CRE, R0
75$:    BSBW    FREEIFAB
90$:    FABDONE

; CREATTRS: R7 = an IFAB with a new file's header, R10 = its FAB. Gives
; the header the FAB's record attributes: organization and record
; format, attributes, maximum record size, a FIX or relative record's
; size, VFC header size, bucket size, default extension and global
; buffer count, and the longest record an XABFHC gives. Uses R0 and R1.
CREATTRS:
        .JSB_ENTRY
        BISB3   FAB$B_ORG(R10), FAB$B_RFM(R10), IFB$AB_HDR+FAT$B_RTYPE(R7)
        MOVB    FAB$B_RAT(R10), IFB$AB_HDR+FAT$B_RATTRIB(R7)
        MOVW    FAB$W_MRS(R10), IFB$AB_HDR+FAT$W_MAXREC(R7)
        CMPB    FAB$B_RFM(R10), #FAB$C_FIX
        BEQL    10$
        CMPB    FAB$B_ORG(R10), #FAB$C_REL
        BNEQ    20$
10$:    MOVW    FAB$W_MRS(R10), IFB$AB_HDR+FAT$W_RSIZE(R7)
20$:    MOVB    FAB$B_FSZ(R10), IFB$AB_HDR+FAT$B_VFCSIZE(R7)
        MOVB    FAB$B_BKS(R10), IFB$AB_HDR+FAT$B_BKTSIZE(R7)
        MOVW    FAB$W_DEQ(R10), IFB$AB_HDR+FAT$W_DEFEXT(R7)
        MOVW    FAB$W_GBC(R10), IFB$AB_HDR+FAT$W_GBC(R7)
        MOVL    #XAB$C_FHC, R0          ; and an XABFHC's longest record
        BSBW    RMS$FINDXAB
        TSTL    R0
        BEQL    90$
        CMPB    FAB$B_RFM(R10), #FAB$C_FIX
        BEQL    90$
        MOVW    XAB$W_LRL(R0), IFB$AB_HDR+FAT$W_RSIZE(R7)
90$:    RSB

; ORGCREATE: R7 = an IFAB with a new file's header and attributes, R10 =
; its FAB. Sets up its organization's state and buffer, and writes a
; relative or indexed file's prologue: SEQ$OPEN, REL$CREATE or
; IDX$CREATE, or SEQ$OPEN for block I/O. R0 = their status. Uses R0-R6,
; R8, R9, R11.
ORGCREATE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R8, R9, R11>
        BITB    #FAB$M_BIO!FAB$M_BRO, IFB$B_FAC(R7)
        BNEQ    20$
        CMPB    IFB$B_ORG(R7), #FAB$C_REL
        BEQL    30$
        BGTRU   40$
        BSBW    SEQ$OPEN
        RSB
20$:    BSBW    ORGOPEN
        RSB
30$:    BSBW    REL$CREATE
        RSB
40$:    BSBW    IDX$CREATE
        RSB

; CREPRO: R7 = an IFAB with a new file's header, XABPRO = the FAB's
; protection XAB, or 0. Gives the header the protection and the ACL of
; the highest version of the name in the directory RMS$PARSE found, if
; there is one, as VMS's XQP does, or else the directory's default ACEs
; and protection (FIL$ACLINHERIT), then the XAB's protection, and its
; owner unless it is 0. Holding FIL$LOCK. Uses R0-R5.
CREPRO:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7, R8, R9>
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        CLRQ    R8                      ; its highest version, from the first
        BSBW    FIL$SEARCHDIR
        MOVL    4(SP), R7
        BLBC    R0, 10$                 ; none: the directory's
        MOVL    R5, R0
        MOVAB   HDRBUF, R1
        BSBW    FIL$READHDR
        BLBC    R0, 10$
        MOVW    HDRBUF+FH2$W_FILEPROT, IFB$AB_HDR+FH2$W_FILEPROT(R7)
        MOVAB   HDRBUF, R2
        CLRL    R3
        BRB     15$
10$:    MOVAB   RMS$AB_DIRHDR, R2
        MOVL    #1, R3
15$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$ACLINHERIT
20$:    MOVL    XABPRO, R1
        BEQL    90$
        MOVW    XAB$W_PRO(R1), IFB$AB_HDR+FH2$W_FILEPROT(R7)
        MOVL    XAB$L_UIC(R1), R0
        BEQL    90$
        MOVL    R0, IFB$AB_HDR+FH2$L_FILEOWNER(R7)
90$:    POPR    #^M<R6, R7, R8, R9>
        RSB

; PURGEVER: $CREATE's new version is in RMS$AB_DIRHDR's directory, by the
; name FIELDS gives. If the name now has more versions than its version
; limit, takes the lowest out of the directory and deletes it, or marks it
; for delete if a stream has it open, as VMS's XQP does at create: one
; each time. One that fails stays. Keeps every register.
PURGEVER:
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MNEGL   #1, R8                  ; every version, highest first
        CLRL    R9
        CLRL    R10                     ; how many
10$:    BSBW    FIL$SEARCHDIR
        BLBC    R0, 30$
        TSTL    R10
        BNEQ    20$
        MOVZWL  -4(R1), R11             ; its record's DIR$W_VERLIMIT
20$:    INCL    R10
        MOVAB   PURGEAT, R9             ; on after it
        MOVW    R4, (R9)
        MOVB    R2, 2(R9)
        PUSHL   R3
        MOVC3   R2, (R1), 3(R9)
        MOVL    (SP)+, R3
        BRB     10$
30$:    TSTL    R11
        BEQL    90$
        CMPL    R10, R11
        BLEQU   90$
        MOVZWL  PURGEAT, R8             ; the lowest
        BSBW    FIL$REMOVE
        BLBC    R0, 90$
        MOVL    R5, R0
        MOVAB   HDRBUF, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVAB   HDRBUF, R2
        BSBW    RMS$FILEBUSY
        BLBS    R0, 40$
        CMPL    R0, #RMS$_FLK
        BNEQ    90$
        MOVAB   HDRBUF, R2
        BSBW    MARKDEL
        BRB     90$
40$:    MOVAB   HDRBUF, R1
        BSBW    FIL$DELHDR
90$:    POPR    #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

; CRENTER: R7 = an IFAB with a new file's header. Enters the file in the
; directory RMS$PARSE found, with the expanded specification's name and
; version, and puts the name in the header, and the name's version limit
; in the IFAB: R4 = the version. R0 =
; SS$_NORMAL or FIL$ENTER's error. Uses R0-R6.
CRENTER:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        PUSHR   #^M<R7, R8>
        MOVAB   IFB$AB_HDR+FH2$W_FID(R7), R5
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RMS$L_VERSION, R8
        BSBW    FIL$ENTER
        BLBC    R0, 90$
        MOVL    (SP), R1
        MOVW    R5, IFB$W_VERLIMIT(R1)
        MOVAB   IFB$AB_HDR(R1), R1
        BSBW    FIL$SETNAME
90$:    POPR    #^M<R7, R8>
        RSB

; $ERASE fab: deletes the file the FAB names, its highest version unless
; the specification gives one: its directory entry, its header and its
; blocks. With FAB$M_NAM in FAB$L_FOP, the file its NAM block's resultant
; string names, which $SEARCH found, and the NAM block's next $SEARCH
; finds the file after it. RMS$_WLD for a wildcard, RMS$_FNF if there is
; no such file, RMS$_WLK on a volume that can't be written, RMS$_PRV for
; the volume's own files, or without delete access to the file and write
; access to its directory, RMS$_MKD if the file system fails, with its
; error in FAB$L_STV: SS$_DIRNOTEMPTY for a directory with files in it.
; A file open in some stream loses its entry now and is marked for
; delete; the last stream to close it deletes it, as on VMS.
        .ENTRY  EXE$ERASE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        TSTL    R11                     ; by the NAM block
        BEQL    10$
        BITL    #FAB$M_NAM, FAB$L_FOP(R10)
        BEQL    10$
        MOVZBL  NAM$B_RSL(R11), R1
        BEQL    10$
        MOVL    NAM$L_RSA(R11), R0
        IFNORD  R1, (R0), 85$
        CLRQ    R2
        BSBW    SYSDFLT
        BRB     15$
10$:    BSBW    FABCHK
        BLBC    R0, 90$
        BSBW    FABSPEC
15$:    MOVAB   HDRBUF, R5
        BSBW    RMS$LOCATE
        BLBC    R0, 90$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVL    #RMS$_PRV, R0
        TSTB    HDRBUF+FH2$B_FID_NMX
        BNEQ    20$
        CMPW    HDRBUF+FH2$W_FID, #RESFILES
        BLEQU   90$
20$:    MOVL    #ARM$M_DELETE, R0
        MOVAB   HDRBUF, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVAB   HDRBUF, R1              ; a directory must be empty
        BSBW    FIL$ISDIR
        BLBC    R0, 25$
        MOVL    #1, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        MOVAB   HDRBUF, R3
        BSBW    FIL$READVBN
        BLBC    R0, 80$
        MOVL    #SS$_DIRNOTEMPTY, R0
        CMPW    F11$AB_DIRBLK, #^XFFFF
        BNEQ    80$
25$:    MOVAB   HDRBUF, R2
        BSBW    RMS$FILEBUSY
        CMPL    R0, #RMS$_DME
        BEQL    90$
        PUSHL   R0                      ; RMS$_FLK while it is open
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RESVER, R8
        BSBW    FIL$REMOVE
        MOVL    (SP)+, R1
        BLBC    R0, 80$
        BLBS    R1, 30$
        MOVAB   HDRBUF, R2
        BSBW    MARKDEL
        BLBC    R0, 80$
        BRB     40$
30$:    MOVAB   HDRBUF, R1
        BSBW    FIL$DELHDR
        BLBC    R0, 80$
40$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    MOVL    R0, FAB$L_STV(R10)
        MOVL    #RMS$_MKD, R0
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
90$:    FABDONE

; $CREATE_DIR devdirspec: makes the directory devdirspec names,
; [dev:][dir.dir...], what it leaves out from SYS$DISK: and the default
; directory, and each one above it that isn't there either: an empty
; NAME.DIR;1 in the one above it. SS$_CREATED if it made one, SS$_NORMAL
; if they were all there, SS$_ACCVIO if the caller can't read devdirspec,
; RMS$_WLD if it has a wildcard, RMS$_WLK on a volume that can't be
; written, RMS$_PRV without write access to the one above, or
; RMS$PARSE's or the file system's error, with the ones above made. Each is the current process's, with the one
; above's protection, but delete (FIL$MKDIR).
; ponytail: a service; VMS's LIB$CREATE_DIR asks the XQP with $QIO
; IO$_CREATE, which the disks' XQP functions haven't yet. No owner,
; protection or version limit arguments.
        .ENTRY  EXE$CREATE_DIR, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    4(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2
        MOVL    4(R1), R0
        MOVL    R2, R1
        BSBW    FIL$LOCK
        MOVL    #1, CREDIR
        CLRQ    R2
        BSBW    SYSDFLT
        BSBW    RMS$PARSE
        BLBC    R0, 80$
        MOVL    #SS$_NORMAL, R0
        CMPL    CREDIR, #1
        BEQL    80$
        MOVL    #SS$_CREATED, R0
80$:    CLRL    CREDIR
        BSBW    FIL$UNLOCK
90$:    RET

; RMS$VOLIDLE: R1 = a VCB. R0 = SS$_NORMAL if no process has a file on
; its volume open, else SS$_DEVACTIVE. Holding FIL$LOCK, which keeps
; their files open or closed. Uses R0 and R2-R4.
RMS$VOLIDLE::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        DSBINT  #IPL$_SYNCH             ; their PCBs
        SUBL3   #1, SCH$GL_MAXPIX, R2
10$:    MOVL    @SCH$GL_PCBVEC[R2], R3
        BEQL    40$
        MOVL    #1, R4
20$:    BBC     R4, PCB$L_FILES(R3), 30$
        MOVL    PCB$A_IFAB(R3)[R4], R0
        CMPL    IFB$L_VCB(R0), R1
        BEQL    80$
30$:    AOBLEQ  #MAXIFI, R4, 20$
40$:    SOBGTR  R2, 10$
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_DEVACTIVE, R0
90$:    ENBINT
        RSB

; RMS$RUNDOWN: R4 = the current PCB, R0 = a mask of IFIs. Closes the
; process's files but those, taking FIL$LOCK. Uses R0-R3.
RMS$RUNDOWN::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHR   #^M<R7, R8, R9>
        BSBW    FIL$LOCK
        MOVL    R0, R3
        MOVL    R4, R9
        MOVL    #1, R8
10$:    BBC     R8, PCB$L_FILES(R4), 20$
        BBS     R8, R3, 20$
        MOVL    PCB$A_IFAB(R4)[R8], R7
        BSBW    CLOSEIFI
20$:    AOBLEQ  #MAXIFI, R8, 10$
        BSBW    FIL$UNLOCK
        POPR    #^M<R7, R8, R9>
        RSB

        ; $SETDDIR newdir, oldlen, olddir: sets the process's default directory,
; the one a file specification without one is in. Writes the old one
; first, as much as fits, in olddir's buffer, and the length written in
; the word at oldlen. Each argument may be 0. newdir is [dir.dir...] or
; <...>, up to 63 characters, not relative: RMS$_DIR if it isn't, SS$_ACCVIO if the
; caller can't read or write an argument. It isn't looked for on the disk.
        .ENTRY  EXE$SETDDIR, ^M<R2, R3, R4, R5, R6>
        DSBINT  #IPL$_SYNCH
        MOVL    SCH$GL_CURPCB, R6
        MOVAB   PCB$T_DEFDIR(R6), R6
        MOVZBL  (R6), R5                ; the old one's length
        MOVL    12(AP), R1
        BEQL    20$
        IFNORD  #8, (R1), 80$
        MOVZWL  (R1), R2
        CMPL    R5, R2
        BGEQU   10$
        MOVL    R5, R2
10$:    MOVL    R2, R5
        BEQL    20$
        MOVL    4(R1), R3
        IFNOWRT R2, (R3), 80$
15$:    MOVB    (R6)[R2], -1(R3)[R2]
        SOBGTR  R2, 15$
20$:    MOVL    8(AP), R1
        BEQL    30$
        IFNOWRT #2, (R1), 80$
        MOVW    R5, (R1)
30$:    MOVL    4(AP), R1
        BEQL    70$
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2
        MOVL    4(R1), R1
        CMPL    R2, #3
        BLSSU   85$
        CMPL    R2, #63
        BGTRU   85$
        CMPB    (R1), #91               ; [ or <
        BEQL    35$
        CMPB    (R1), #60
        BNEQ    85$
35$:    CMPB    -1(R1)[R2], #93         ; ] or >
        BEQL    37$
        CMPB    -1(R1)[R2], #62
        BNEQ    85$
37$:    CMPB    1(R1), #^A/-/           ; not a relative one
        BEQL    85$
        CMPB    1(R1), #^A/./
        BEQL    85$
40$:    PUSHR   #^M<R1, R2>
        INCL    R1
        SUBL2   #2, R2
        MOVL    #2, R3                  ; dots, no wildcards
        BSBW    CHARS
        POPR    #^M<R1, R2>
        BLBC    R0, 85$
        MOVB    R2, (R6)+
45$:    MOVB    (R1)+, (R6)+
        SOBGTR  R2, 45$
70$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_ACCVIO, R0
        BRB     90$
85$:    MOVL    #RMS$_DIR, R0
90$:    ENBINT
        RET

        .END
