        .TITLE  VECACL  The ACL services: ACEs as text, objects' security
        .IDENT  /V0.1/
;
; $PARSE_ACL turns an ACE's text into its bytes, $FORMAT_ACL its bytes
; into text, and $GET_SECURITY and $SET_SECURITY read and change an
; object's owner, protection and ACL, by its class and name, as VMS's do
; (docs/adr/0040-acls-in-file-headers-and-rights-identifiers.md). They
; run in their caller's mode, in the vector, and call other services:
; $ASCTOID and $IDTOASC for identifiers' names, RMS and $QIO for files.
; An ACE's text is VMS's: (IDENTIFIER=id[+id...][,OPTIONS=opt[+opt...]]
; [,ACCESS=acc[+acc...]]), or (DEFAULT_PROTECTION[,OPTIONS=...],S:RWED,
; O:RWED,G:RE,W:R); a keyword may be cut short while no other starts so,
; and = may be :. An identifier is a name, [name], [g,m] in octal, a
; part of which may be * or a name, * for anyone, or %X and hex digits.
; vaxpunk: VMS's run in executive mode.
; ponytail: identifier and default protection ACEs only, not alarm,
; audit or journal ones; accnam and routin are taken and not used: the
; access names are a file's; the security class FILE only, and of a
; name with wildcards, the first file; objhan, flags and acmode are
; taken and not used.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $NAMDEF
        $IODEF
        $FIBDEF
        $ATRDEF
        $ACEDEF
        $UICDEF
        $OSSDEF

        .EXTERNAL SYS$ASCTOID, SYS$IDTOASC

LPAR = 40                               ; characters
RPAR = 41
STAR = 42
PLUS = 43
COMMA = 44
COLON = 58
EQUAL = 61
PERCENT = 37
LBRACK = 91
RBRACK = 93
ACEMAX = 255                            ; an ACE's bytes, at most
OUTMAX = 3072                           ; $FORMAT_ACL's text, at most
IDMAX = 48                              ; an identifier's, at most: [name], %Xhhhhhhhh
P_ACE = 0                               ; $PARSE_ACL's frame: the ACE being made,
P_START = P_ACE+ACEMAX+1                ; the text's start,
P_CLAUSE = P_START+4                    ; where the keyword being parsed started,
P_TYPE = P_CLAUSE+4                     ; the ACE's type, 0 for none yet,
P_NIDS = P_TYPE+4                       ; its identifiers,
P_UICS = P_NIDS+4                       ; those that are UICs,
P_FLAGS = P_UICS+4                      ; its options,
P_ACCESS = P_FLAGS+4                    ; its access,
P_PROT = P_ACCESS+4                     ; a default protection's, 4 longwords,
P_ID = P_PROT+16                        ; an identifier $ASCTOID found,
P_DSC = P_ID+4                          ; a name's descriptor
P_SIZE = <P_DSC+8+15>&^C15
F_TEXT = 0                              ; $FORMAT_ACL's frame: the text,
F_LEN = F_TEXT+OUTMAX                   ; its bytes,
F_LINE = F_LEN+4                        ; the line's,
F_WIDTH = F_LINE+4                      ; width,
F_INDENT = F_WIDTH+4                    ; indent,
F_ID = F_INDENT+4                       ; an identifier's text
F_SIZE = <F_ID+IDMAX+15>&^C15
S_FAB = 0                               ; $GET_SECURITY's and $SET_SECURITY's frame:
S_NAM = S_FAB+FAB$C_BLN                 ; the file's FAB and NAM,
S_EXP = S_NAM+NAM$C_BLN                 ; the expanded and resultant strings,
S_RES = S_EXP+256
S_FIB = S_RES+256                       ; the FIB,
S_FIBDSC = S_FIB+FIB$C_LENGTH           ; its descriptor,
S_ATR = S_FIBDSC+8                      ; the attributes, a descriptor each,
MAXATR = 30
S_IOSB = S_ATR+<MAXATR*8>+4
S_CHAN = S_IOSB+8                       ; the channel to its disk,
S_DEV = S_CHAN+4                        ; the disk's name's descriptor,
S_PROT = S_DEV+8                        ; and a protection being read
S_SIZE = <S_PROT+4+15>&^C15

        .PSECT  EXEC$VECTOR, EXE, NOWRT, LONG
KEYWORDS:                               ; an ACE's, in this order
        .ASCIC  "IDENTIFIER"
        .ASCIC  "ACCESS"
        .ASCIC  "OPTIONS"
        .ASCIC  "DEFAULT_PROTECTION"
        .ASCIC  "ALARM_JOURNAL"
        .ASCIC  "AUDIT_JOURNAL"
        .ASCIC  "AI_JOURNAL_NAME"
        .ASCIC  "AT_JOURNAL_NAME"
        .ASCIC  "BI_JOURNAL_NAME"
        .BYTE   0
ACCESSES:                               ; ACCESS's: the bits from 0, then NONE
        .ASCIC  "READ"
        .ASCIC  "WRITE"
        .ASCIC  "EXECUTE"
        .ASCIC  "DELETE"
        .ASCIC  "CONTROL"
        .ASCIC  "NONE"
        .ASCIC  "SUCCESS"
        .ASCIC  "FAILURE"
        .BYTE   0
OPTIONS:                                ; OPTIONS's: ACE$V_DEFAULT's bit and up, then NONE
        .ASCIC  "DEFAULT"
        .ASCIC  "PROTECTED"
        .ASCIC  "HIDDEN"
        .ASCIC  "NOPROPAGATE"
        .ASCIC  "NONE"
        .BYTE   0
OPTBITS:.WORD   ACE$M_DEFAULT, ACE$M_PROTECTED, ACE$M_HIDDEN, ACE$M_NOPROPAGATE, 0
OPTSHOWN:                               ; the options shown, in $FORMAT_ACL's order
        .WORD   ACE$M_DEFAULT
        .ASCIC  "DEFAULT+"
        .WORD   ACE$M_HIDDEN
        .ASCIC  "HIDDEN+"
        .WORD   ACE$M_PROTECTED
        .ASCIC  "PROTECTED+"
        .WORD   ACE$M_NOPROPAGATE
        .ASCIC  "NOPROPAGATE+"
        .WORD   0
CLASSES:                                ; a default protection's categories
        .ASCIC  "SYSTEM"
        .ASCIC  "OWNER"
        .ASCIC  "GROUP"
        .ASCIC  "WORLD"
        .BYTE   0
LETTERS:.ASCII  "RWEDC"                 ; what a category may do, by its bit
HEXDIGITS:
        .ASCII  "0123456789ABCDEF"
FILECLASS:
        .ASCII  "FILE"
T_LPAR: .ASCIC  "("
T_IDENT:.ASCIC  "IDENTIFIER="
T_PLUS: .ASCIC  "+"
T_COMMA:.ASCIC  ","
T_OPTS: .ASCIC  "OPTIONS="
T_ACC:  .ASCIC  "ACCESS="
T_NONE: .ASCIC  "NONE+"
T_DEFPROT:
        .ASCIC  "DEFAULT_PROTECTION,"
T_UNKNOWN:
        .ASCIC  "Unknown="
; Each OSS$_ item $GET_SECURITY and $SET_SECURITY take: its code, the
; ATR$C_ code it is, its size, 0 for the buffer's, at most ATR's, and
; R for one that returns a length: 1 of 4, 2 of 2, 3 an ACE's, 4 ACEs'.
ITEMS:  .BYTE   OSS$_OWNER, ATR$C_UIC, 4, 1
        .BYTE   OSS$_PROTECTION, ATR$C_FPRO, 2, 2
        .BYTE   OSS$_ACL_LENGTH, ATR$C_ACLLENGTH, 4, 1
        .BYTE   OSS$_ACL_READ_ENTRY, ATR$C_READACE, 0, 3
        .BYTE   OSS$_ACL_READ, ATR$C_READACL, 0, 4
        .BYTE   OSS$_ACL_FIND_ENTRY, ATR$C_FNDACLENT, 0, 0
        .BYTE   OSS$_ACL_ADD_ENTRY, ATR$C_ADDACLENT, 0, 0
        .BYTE   OSS$_ACL_DELETE_ENTRY, ATR$C_DELACLENT, 0, 0
        .BYTE   OSS$_ACL_DELETE, ATR$C_DELETEACL, 0, 0
        .BYTE   OSS$_ACL_DELETE_ALL, ATR$C_DELETE_ALL, 0, 0
        .BYTE   0

; $PARSE_ACL aclstr, aclent, errpos, accnam, routin: turns the text of an
; ACE the string aclstr describes into its bytes, in the buffer aclent
; describes, 0s after them. The word at errpos, if it is given, gets how
; many characters were taken: where the text went wrong, or all of it.
; R0 = SS$_NORMAL, SS$_IVACL for text that isn't an ACE, SS$_NOSUCHID or
; SS$_IVIDENT for a name that isn't an identifier, or SS$_ACCVIO if the
; buffer is too short.
        .ENTRY  SYS$PARSE_ACL, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        SUBL2   #P_SIZE, SP
        MOVL    SP, R11
        MOVC5   #0, (SP), #0, #P_SIZE, (R11)
        MNEGL   #1, P_PROT(R11)         ; a category not given may do nothing
        MNEGL   #1, P_PROT+4(R11)
        MNEGL   #1, P_PROT+8(R11)
        MNEGL   #1, P_PROT+12(R11)
        MOVL    4(AP), R1
        MOVZWL  (R1), R7
        MOVL    4(R1), R6
        MOVL    R6, P_START(R11)
        ADDL2   R6, R7                  ; past the text
        BSBW    BLANKS
        MOVL    R6, P_CLAUSE(R11)
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6)+, #LPAR
        BNEQ    80$
10$:    BSBW    BLANKS                  ; a clause
        MOVL    R6, P_CLAUSE(R11)
        BSBW    WORD
        MOVAB   KEYWORDS, R4
        BSBW    MATCH
        CASEL   R0, #1, #3
15$:    .WORD   20$-15$, 30$-15$, 40$-15$, 50$-15$
        BRB     80$
20$:    BSBW    IDENTS                  ; IDENTIFIER=
        BRB     60$
30$:    BSBW    ACCESS                  ; ACCESS=
        BRB     60$
40$:    BSBW    OPTS                    ; OPTIONS=
        BRB     60$
50$:    BSBW    DEFPROT                 ; DEFAULT_PROTECTION
60$:    BLBC    R0, 85$
        BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #COMMA
        BNEQ    65$
        INCL    R6
        BRB     10$
65$:    CMPB    (R6)+, #RPAR
        BNEQ    80$
        BSBW    BLANKS                  ; nothing after it
        MOVL    R6, P_CLAUSE(R11)
        CMPL    R6, R7
        BNEQ    80$
        BSBW    MAKEACE
        BLBC    R0, 85$
        MOVL    8(AP), R1               ; the ACE, 0s after it
        MOVZBL  P_ACE(R11), R2
        MOVL    #SS$_ACCVIO, R0
        CMPW    R2, (R1)
        BGTRU   85$
        MOVC5   R2, P_ACE(R11), #0, (R1), @4(R1)
        MOVL    R7, P_CLAUSE(R11)
        MOVL    #SS$_NORMAL, R0
        BRB     85$
80$:    MOVL    #SS$_IVACL, R0
85$:    MOVL    12(AP), R1              ; where it stopped
        BEQL    90$
        SUBL3   P_START(R11), P_CLAUSE(R11), R2
        MOVW    R2, (R1)
90$:    RET

; BLANKS: R6 = the text, R7 = past it. Moves R6 past blanks and tabs.
; Keeps every other register.
BLANKS:
        .JSB_ENTRY  OUTPUT=<R6>
10$:    CMPL    R6, R7
        BGEQU   20$
        CMPB    (R6), #^A/ /
        BEQL    15$
        CMPB    (R6), #9
        BNEQ    20$
15$:    INCL    R6
        BRB     10$
20$:    RSB

; WORD: R6 = the text, R7 = past it. Takes the letters, digits, $ and _
; at R6, after blanks: R2 = their first, R3 = how many, R6 past them.
; Uses R0.
WORD:
        .JSB_ENTRY  OUTPUT=<R2, R3, R6>
        BSBB    BLANKS
        MOVL    R6, R2
10$:    CMPL    R6, R7
        BGEQU   20$
        MOVZBL  (R6), R0
        BSBW    WORDCHAR
        BLBC    R0, 20$
        INCL    R6
        BRB     10$
20$:    SUBL3   R2, R6, R3
        RSB

; WORDCHAR: R0 = a character. R0 = 1 if it is a letter, a digit, $ or
; _, else 0. Keeps every other register.
WORDCHAR:
        .JSB_ENTRY
        CMPB    R0, #^A/$/
        BEQL    80$
        CMPB    R0, #^A/_/
        BEQL    80$
        CMPB    R0, #^A/0/
        BLSSU   70$
        CMPB    R0, #^A/9/
        BLEQU   80$
        BICB2   #^X20, R0               ; a letter, in capitals
        CMPB    R0, #^A/A/
        BLSSU   70$
        CMPB    R0, #^A/Z/
        BLEQU   80$
70$:    CLRL    R0
        RSB
80$:    MOVL    #1, R0
        RSB

; MATCH: R2 = a word, R3 = its length, R4 = a list of .ASCIC words, a
; byte of 0 after them. R0 = the number of the one it is, ignoring case,
; from 1, or of the one it is the start of, if only one; else 0. Uses
; R0, R1, R4, R5.
MATCH:
        .JSB_ENTRY  SCRATCH=<R4, R5>
        PUSHR   #^M<R6, R7, R8, R9>
        CLRL    R0                      ; the one it starts
        CLRL    R1                      ; how many it starts
        CLRL    R8                      ; the number
        TSTL    R3
        BEQL    90$
10$:    MOVZBL  (R4)+, R5               ; a word's length
        BEQL    80$
        INCL    R8
        CMPL    R3, R5
        BGTRU   40$
        CLRL    R6
20$:    MOVZBL  (R2)[R6], R7
        CMPB    R7, #^A/a/
        BLSSU   25$
        CMPB    R7, #^A/z/
        BGTRU   25$
        SUBB2   #^A/a/-^A/A/, R7
25$:    CMPB    R7, (R4)[R6]
        BNEQ    40$
        AOBLSS  R3, R6, 20$
        MOVL    R8, R0
        CMPL    R3, R5                  ; all of it: that one
        BEQL    90$
        INCL    R1
40$:    ADDL2   R5, R4
        BRB     10$
80$:    CMPL    R1, #1
        BEQL    90$
        CLRL    R0
90$:    POPR    #^M<R6, R7, R8, R9>
        RSB

; EQUALS: R6 = the text after a keyword. Takes the = or : after it.
; R0 = SS$_NORMAL or SS$_IVACL. Keeps every other register.
EQUALS:
        .JSB_ENTRY  OUTPUT=<R6>
        BSBW    BLANKS
        MOVL    #SS$_IVACL, R0
        CMPL    R6, R7
        BGEQU   90$
        CMPB    (R6), #EQUAL
        BEQL    10$
        CMPB    (R6), #COLON
        BNEQ    90$
10$:    INCL    R6
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; IDENTS: R6 = the text after IDENTIFIER, R11 = $PARSE_ACL's frame. Takes
; =id[+id...]: the ACE becomes an identifier ACE with them. R0 =
; SS$_NORMAL, SS$_IVACL, or $ASCTOID's failure. Uses R0-R5.
IDENTS:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2, R3, R4, R5>
        BSBB    EQUALS
        BLBC    R0, 90$
        MOVL    #SS$_IVACL, R0
        TSTL    P_TYPE(R11)
        BNEQ    90$
        MOVL    #ACE$C_KEYID, P_TYPE(R11)
10$:    BSBW    BLANKS
        MOVL    R6, P_CLAUSE(R11)
        BSBW    ONEID
        BLBC    R0, 90$
        MOVL    #SS$_IVACL, R0
        MOVL    P_NIDS(R11), R2
        CMPL    R2, #<ACEMAX-ACE$C_LENGTH>/4
        BGEQU   90$
        MOVL    R1, P_ACE+ACE$L_KEY(R11)[R2]
        INCL    P_NIDS(R11)
        BITL    #^XC0000000, R1         ; a UIC?
        BNEQ    20$
        INCL    P_UICS(R11)
20$:    BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #PLUS
        BNEQ    80$
        INCL    R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; ONEID: R6 = an identifier's text. R1 = the identifier, R6 past it. R0 =
; SS$_NORMAL, SS$_IVACL, or $ASCTOID's failure. Uses R0-R5.
ONEID:
        .JSB_ENTRY  OUTPUT=<R1, R6>, SCRATCH=<R2, R3, R4, R5>
        MOVL    #SS$_IVACL, R0
        CMPL    R6, R7
        BGEQU   90$
        CMPB    (R6), #STAR            ; anyone
        BNEQ    10$
        INCL    R6
        MNEGL   #1, R1
        BRB     80$
10$:    CMPB    (R6), #LBRACK
        BNEQ    20$
        INCL    R6
        BSBW    UIC
        RSB
20$:    CMPB    (R6), #PERCENT            ; %X and hex
        BNEQ    40$
        ADDL3   #2, R6, R0
        CMPL    R0, R7
        BGTRU   90$
        BICB3   #^X20, 1(R6), R0
        CMPB    R0, #^A/X/
        BNEQ    90$
        ADDL2   #2, R6
        CLRL    R1
        CLRL    R3                      ; digits
30$:    CMPL    R6, R7
        BGEQU   35$
        MOVZBL  (R6), R0
        BICB2   #^X20, R0
        LOCC    R0, #16, HEXDIGITS
        BEQL    35$
        SUBL3   R0, #16, R0
        ASHL    #4, R1, R1
        BISL2   R0, R1
        INCL    R6
        INCL    R3
        BRB     30$
35$:    MOVL    #SS$_IVACL, R0
        TSTL    R3
        BEQL    90$
        CMPL    R3, #8
        BGTRU   90$
        BRB     80$
40$:    BSBW    NAMEID                  ; a name
        RSB
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; NAMEID: R6 = a name's text, R11 = $PARSE_ACL's frame. Takes the name:
; R1 = its identifier, $ASCTOID's, R6 past it. R0 = SS$_NORMAL,
; SS$_IVACL if there is no name, or $ASCTOID's failure. Uses R0-R5.
NAMEID:
        .JSB_ENTRY  OUTPUT=<R1, R6>, SCRATCH=<R2, R3, R4, R5>
        BSBW    WORD
        MOVL    #SS$_IVACL, R0
        TSTL    R3
        BEQL    90$
        MOVW    R3, P_DSC(R11)
        MOVL    R2, P_DSC+4(R11)
        CLRL    -(SP)
        PUSHAL  P_ID(R11)
        PUSHAQ  P_DSC(R11)
        CALLS   #3, G^SYS$ASCTOID
        MOVL    P_ID(R11), R1
90$:    RSB

; UIC: R6 = the text after a [, R11 = $PARSE_ACL's frame. Takes
; group,member] or name]: R1 = the UIC. A group or member is octal, *, or
; a UIC identifier's name, whose group or member it takes. R0 =
; SS$_NORMAL, SS$_IVACL, or $ASCTOID's failure. Uses R0-R5.
UIC:
        .JSB_ENTRY  OUTPUT=<R1, R6>, SCRATCH=<R2, R3, R4, R5>
        BSBW    UICPART
        BLBC    R0, 90$
        BSBW    BLANKS
        MOVL    #SS$_IVACL, R0
        CMPL    R6, R7
        BGEQU   90$
        CMPB    (R6), #RBRACK
        BNEQ    20$
        INCL    R6                      ; [name]: a UIC identifier
        MOVL    #SS$_IVACL, R0
        TSTL    R2
        BNEQ    90$
        BITL    #^XC0000000, R1
        BNEQ    90$
        BRB     80$
20$:    CMPB    (R6)+, #COMMA
        BNEQ    90$
        PUSHL   R1                      ; the group
        CASEL   R2, #0, #2
21$:    .WORD   22$-21$, 24$-21$, 23$-21$
22$:    EXTZV   #UIC$V_GROUP, #UIC$S_GROUP, (SP), (SP)  ; a name's
        BRB     27$
23$:    MOVL    #UIC$K_WILD_GROUP, (SP) ; *
        BRB     27$
24$:    CMPL    (SP), #UIC$K_WILD_GROUP ; octal
        BGTRU   86$
27$:    BSBW    UICPART
        BLBC    R0, 87$
        TSTL    R2
        BNEQ    30$
        MOVZWL  R1, R1                  ; a name's member
30$:    CMPL    R1, #UIC$K_WILD_MEMBER
        BGTRU   86$
        INSV    (SP)+, #16, #16, R1
        BSBW    BLANKS
        MOVL    #SS$_IVACL, R0
        CMPL    R6, R7
        BGEQU   90$
        CMPB    (R6)+, #RBRACK
        BNEQ    90$
80$:    MOVL    #SS$_NORMAL, R0
        RSB
86$:    MOVL    #SS$_IVACL, R0
87$:    TSTL    (SP)+
90$:    RSB

; UICPART: R6 = a UIC's group or member. R1 = its value and R2 = 1 for
; octal, R2 = 2 for *, or R1 = the UIC identifier a name is and R2 = 0. R0 = SS$_NORMAL, SS$_IVACL, SS$_IVIDENT for a
; name that isn't a UIC, or $ASCTOID's failure. Uses R0-R5.
UICPART:
        .JSB_ENTRY  OUTPUT=<R1, R2, R6>, SCRATCH=<R3, R4, R5>
        BSBW    BLANKS
        MOVL    #SS$_IVACL, R0
        CMPL    R6, R7
        BGEQU   90$
        MOVZBL  (R6), R0
        CMPB    R0, #STAR
        BNEQ    10$
        INCL    R6
        MOVL    #UIC$K_WILD_MEMBER, R1
        MOVL    #2, R2
        BRB     80$
10$:    SUBB2   #^A/0/, R0
        CMPB    R0, #7
        BGTRU   40$
        CLRL    R1                      ; octal
20$:    CMPL    R6, R7
        BGEQU   30$
        MOVZBL  (R6), R0
        SUBB2   #^A/0/, R0
        CMPB    R0, #7
        BGTRU   30$
        ASHL    #3, R1, R1
        BISL2   R0, R1
        INCL    R6
        CMPL    R1, #^XFFFF
        BGTRU   85$
        BRB     20$
30$:    MOVL    #1, R2
        BRB     80$
40$:    BSBW    NAMEID
        BLBC    R0, 90$
        MOVL    #SS$_IVIDENT, R0
        BITL    #^XC0000000, R1
        BNEQ    90$
        CLRL    R2
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_IVACL, R0
90$:    RSB

; ACCESS: R6 = the text after ACCESS, R11 = $PARSE_ACL's frame. Takes
; =acc[+acc...], READ, WRITE, EXECUTE, DELETE, CONTROL or NONE, into the
; ACE's access. R0 = SS$_NORMAL or SS$_IVACL. Uses R0-R5.
ACCESS:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2, R3, R4, R5>
        BSBW    EQUALS
        BLBC    R0, 90$
10$:    BSBW    WORD
        MOVAB   ACCESSES, R4
        BSBW    MATCH
        MOVL    #SS$_IVACL, R1
        DECL    R0
        BLSS    85$
        CMPL    R0, #5
        BGTRU   85$                     ; SUCCESS and FAILURE: an alarm's
        BEQL    20$                     ; NONE
        BBSS    R0, P_ACCESS(R11), 20$
20$:    BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #PLUS
        BNEQ    80$
        INCL    R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    R1, R0
90$:    RSB

; OPTS: R6 = the text after OPTIONS, R11 = $PARSE_ACL's frame. Takes
; =opt[+opt...], DEFAULT, PROTECTED, HIDDEN, NOPROPAGATE or NONE, into
; the ACE's options. R0 = SS$_NORMAL or SS$_IVACL. Uses R0-R5.
OPTS:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2, R3, R4, R5>
        BSBW    EQUALS
        BLBC    R0, 90$
10$:    BSBW    WORD
        MOVAB   OPTIONS, R4
        BSBW    MATCH
        DECL    R0
        BLSS    85$
        BISW2   OPTBITS[R0], P_FLAGS(R11)
        BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #PLUS
        BNEQ    80$
        INCL    R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
        RSB
85$:    MOVL    #SS$_IVACL, R0
90$:    RSB

; DEFPROT: R6 = the text after DEFAULT_PROTECTION, R11 = $PARSE_ACL's
; frame. The ACE becomes a default protection ACE; takes each ,cat[:rwedc]
; after it, SYSTEM, OWNER, GROUP or WORLD, which may do what its letters
; say, and leaves R6 at a , before what isn't one. R0 = SS$_NORMAL or
; SS$_IVACL. Uses R0-R5.
DEFPROT:
        .JSB_ENTRY  OUTPUT=<R6>, SCRATCH=<R2, R3, R4, R5>
        MOVL    #SS$_IVACL, R0
        TSTL    P_TYPE(R11)
        BNEQ    90$
        MOVL    #ACE$C_DIRDEF, P_TYPE(R11)
10$:    BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #COMMA
        BNEQ    80$
        PUSHL   R6
        INCL    R6
        BSBW    WORD
        MOVAB   CLASSES, R4
        BSBW    MATCH
        DECL    R0
        BGEQ    20$
        MOVL    (SP)+, R6               ; another clause's
        BRB     80$
20$:    TSTL    (SP)+
        MOVAL   P_PROT(R11)[R0], R5
        MOVL    #^X1F, (R5)             ; nothing, unless its letters say
        BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #COLON
        BEQL    30$
        CMPB    (R6), #EQUAL
        BNEQ    10$
30$:    INCL    R6
40$:    CMPL    R6, R7
        BGEQU   80$
        MOVZBL  (R6), R0
        BICB2   #^X20, R0
        LOCC    R0, #5, LETTERS
        BEQL    10$
        SUBL3   R0, #5, R0
        BBCC    R0, (R5), 45$
45$:    INCL    R6
        BRB     40$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; MAKEACE: R11 = $PARSE_ACL's frame. Makes the ACE from what the text
; gave: an identifier ACE needs an identifier, and at most one UIC; a
; default protection ACE none. R0 = SS$_NORMAL or SS$_IVACL. Uses R0-R1.
MAKEACE:
        .JSB_ENTRY
        MOVL    #SS$_IVACL, R0
        MOVB    P_TYPE(R11), P_ACE+ACE$B_TYPE(R11)
        MOVW    P_FLAGS(R11), P_ACE+ACE$W_FLAGS(R11)
        MOVL    P_ACCESS(R11), P_ACE+ACE$L_ACCESS(R11)
        CMPL    P_TYPE(R11), #ACE$C_KEYID
        BNEQ    20$
        TSTL    P_NIDS(R11)
        BEQL    90$
        CMPL    P_UICS(R11), #1
        BGTRU   90$
        MULL3   #4, P_NIDS(R11), R1
        ADDB3   #ACE$C_LENGTH, R1, P_ACE+ACE$B_SIZE(R11)
        BRB     80$
20$:    CMPL    P_TYPE(R11), #ACE$C_DIRDEF
        BNEQ    90$
        TSTL    P_NIDS(R11)
        BNEQ    90$
        MOVB    #ACE$K_DIRDEF_LENGTH, P_ACE+ACE$B_SIZE(R11)
        BICL3   #^C^X1F, P_PROT(R11), P_ACE+ACE$L_SYS_PROT(R11)
        BICL3   #^C^X1F, P_PROT+4(R11), P_ACE+ACE$L_OWN_PROT(R11)
        BICL3   #^C^X1F, P_PROT+8(R11), P_ACE+ACE$L_GRP_PROT(R11)
        BICL3   #^C^X1F, P_PROT+12(R11), P_ACE+ACE$L_WOR_PROT(R11)
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; $FORMAT_ACL aclent, acllen, aclstr, width, trmdsc, indent, accnam,
; routin: writes the text of the ACE at the buffer aclent describes into
; the string aclstr describes, 0s after it, and its length into the word
; at acllen, if it is given. The text starts after indent blanks, the
; word at indent, 0 without it; with a width, the word at width, a line
; doesn't go past it: before a part that would, it writes the string
; trmdsc describes, if there is one, and indent blanks again. A part is
; a keyword with its = or :, an identifier, a + or a , an option or an
; access name with the + after it, and a category's protection. An
; identifier is its name, [name] for a UIC, else %X and hex, or [g,m] in
; octal. R0 = SS$_NORMAL, SS$_BUFFEROVF if the text didn't all fit, or
; SS$_IVACL for an ACE longer than 255.
        .ENTRY  SYS$FORMAT_ACL, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        SUBL2   #F_SIZE, SP
        MOVL    SP, R11
        CLRQ    F_LEN(R11)              ; and F_LINE
        CLRQ    F_WIDTH(R11)            ; and F_INDENT
        MOVL    16(AP), R0
        BEQL    5$
        MOVZWL  (R0), F_WIDTH(R11)
5$:     MOVL    24(AP), R0
        BEQL    7$
        MOVZWL  (R0), F_INDENT(R11)
7$:     MOVL    4(AP), R10
        MOVL    4(R10), R10             ; the ACE
        MOVL    #SS$_IVACL, R0
        CMPB    (R10), #ACE$C_LENGTH
        BLSSU   95$
        MOVL    F_INDENT(R11), R0
        BSBW    SPACES
        MOVAB   T_LPAR, R1
        BSBW    PIECE
        CMPB    ACE$B_TYPE(R10), #ACE$C_KEYID
        BEQL    10$
        CMPB    ACE$B_TYPE(R10), #ACE$C_DIRDEF
        BEQL    30$
        MOVAB   T_UNKNOWN, R1           ; another type
        BSBW    PIECE
        MOVZBL  ACE$B_TYPE(R10), R0
        MOVL    #2, R1
        BSBW    HEXPIECE
        BRB     70$
10$:    MOVAB   T_IDENT, R1             ; an identifier ACE
        BSBW    PIECE
        EXTZV   #0, #ACE$S_RESERVED, ACE$W_FLAGS(R10), R0
        MOVAL   ACE$L_KEY(R10)[R0], R8  ; its identifiers
        MOVZBL  (R10), R9
        ADDL2   R10, R9                 ; past them
        BRB     15$
12$:    MOVAB   T_PLUS, R1
        BSBW    PIECE
15$:    MOVL    (R8)+, R0
        MOVAB   F_ID+1(R11), R1
        BSBW    IDTEXT
        MOVB    R2, F_ID(R11)
        MOVAB   F_ID(R11), R1
        BSBW    PIECE
        CMPL    R8, R9
        BLSSU   12$
        MOVAB   T_COMMA, R1
        BSBW    PIECE
        BSBW    SHOWOPTS
        MOVAB   T_ACC, R1
        BSBW    PIECE
        MOVL    ACE$L_ACCESS(R10), R7
        BNEQ    20$
        MOVAB   T_NONE, R1
        BSBW    PIECE
        BRB     70$
20$:    CLRL    R6                      ; each bit's name
25$:    BBC     R6, R7, 28$
        BSBW    ACCNAME
        BSBW    PIECE
28$:    AOBLSS  #32, R6, 25$
        BRB     70$
30$:    MOVAB   T_DEFPROT, R1           ; a default protection ACE
        BSBW    PIECE
        CLRL    R6
35$:    MOVAB   F_ID+1(R11), R1         ; CATEGORY:letters,
        MOVAB   CLASSES, R2
        MOVL    R6, R3
36$:    MOVZBL  (R2)+, R0
        SOBGEQ  R3, 37$
        MOVC3   R0, (R2), (R1)
        MOVL    R3, R1
        MOVB    #COLON, (R1)+
        MOVL    ACE$L_SYS_PROT(R10)[R6], R7
        CLRL    R2
38$:    BBS     R2, R7, 39$
        MOVB    LETTERS[R2], (R1)+
39$:    AOBLSS  #5, R2, 38$
        MOVB    #COMMA, (R1)+
        MOVAB   F_ID+1(R11), R0
        SUBL3   R0, R1, R0
        MOVB    R0, F_ID(R11)
        MOVAB   F_ID(R11), R1
        BSBW    PIECE
        AOBLSS  #4, R6, 35$
        BSBW    SHOWOPTS
        BRB     70$
37$:    ADDL2   R0, R2
        BRB     36$
70$:    MOVB    #RPAR, R0              ; the last + or , ends it
        BSBW    LASTCHAR
        MOVL    8(AP), R0
        BEQL    85$
        MOVW    F_LEN(R11), (R0)
85$:    MOVL    12(AP), R1              ; as much as fits
        MOVL    #SS$_NORMAL, R6
        CMPW    F_LEN(R11), (R1)
        BLEQU   90$
        MOVL    #SS$_BUFFEROVF, R6
90$:    MOVL    F_LEN(R11), R2
        CMPL    R2, #OUTMAX
        BLEQU   92$
        MOVL    #OUTMAX, R2
92$:    MOVC5   R2, F_TEXT(R11), #0, (R1), @4(R1)
        MOVL    R6, R0
95$:    RET

; SHOWOPTS: R10 = an ACE, R11 = $FORMAT_ACL's frame. Writes OPTIONS=,
; then each option it has with a + after it, the last's a ,, if it has
; any. Uses R0-R5.
SHOWOPTS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BICW3   #^XF, ACE$W_FLAGS(R10), R0      ; but the reserved count
        BEQL    90$
        MOVAB   T_OPTS, R1
        BSBW    PIECE
        MOVAB   OPTSHOWN, R4
10$:    MOVW    (R4)+, R0
        BEQL    20$
        MOVL    R4, R1
        MOVZBL  (R4)+, R2
        ADDL2   R2, R4
        BITW    R0, ACE$W_FLAGS(R10)
        BEQL    10$
        PUSHL   R4
        BSBW    PIECE
        MOVL    (SP)+, R4
        BRB     10$
20$:    MOVB    #COMMA, R0
        BSBW    LASTCHAR
90$:    RSB

; LASTCHAR: R0 = a character, R11 = $FORMAT_ACL's frame. Makes it the
; text's last, in place of the + or , there. Uses R0-R1.
LASTCHAR:
        .JSB_ENTRY
        MOVL    F_LEN(R11), R1
        BEQL    90$
        CMPL    R1, #OUTMAX
        BGTRU   90$
        MOVB    R0, F_TEXT-1(R11)[R1]
90$:    RSB

; ACCNAME: R6 = an access bit. R1 = its name with a + after it, .ASCIC, in
; the frame's F_ID: READ to CONTROL, or BIT_n. Uses R0-R5.
ACCNAME:
        .JSB_ENTRY  OUTPUT=<R1>, SCRATCH=<R2, R3, R4, R5>
        MOVAB   F_ID+1(R11), R3
        CMPL    R6, #5
        BGEQU   20$
        MOVAB   ACCESSES, R2
        MOVL    R6, R4
10$:    MOVZBL  (R2)+, R0
        SOBGEQ  R4, 15$
        MOVC3   R0, (R2), (R3)
        BRB     30$
15$:    ADDL2   R0, R2
        BRB     10$
20$:    MOVL    #^A/BIT_/, (R3)+        ; BIT_n
        DIVL3   #10, R6, R0
        MULL3   #10, R0, R1
        SUBL3   R1, R6, R1
        TSTL    R0
        BEQL    25$
        ADDB3   #^A/0/, R0, (R3)+
25$:    ADDB3   #^A/0/, R1, (R3)+
30$:    MOVB    #PLUS, (R3)+
        MOVAB   F_ID+1(R11), R1
        SUBL3   R1, R3, R0
        MOVB    R0, F_ID(R11)
        MOVAB   F_ID(R11), R1
        RSB

; PIECE: R1 = a part of the text, .ASCIC, R11 = $FORMAT_ACL's frame.
; Appends it, after a line break if it would go past the width. Uses
; R0-R5.
PIECE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVZBL  (R1)+, R2
        TSTL    F_WIDTH(R11)
        BEQL    20$
        ADDL3   F_LINE(R11), R2, R0
        CMPL    R0, F_WIDTH(R11)
        BLEQU   20$
        PUSHR   #^M<R1, R2>             ; the line ends
        MOVL    20(AP), R0
        BEQL    10$
        MOVZWL  (R0), R2
        MOVL    4(R0), R1
        BSBB    APPEND
10$:    CLRL    F_LINE(R11)
        MOVL    F_INDENT(R11), R0
        BSBB    SPACES
        POPR    #^M<R1, R2>
20$:    BSBB    APPEND
        RSB

; SPACES: R0 = a count. Appends that many blanks. Uses R0-R5.
SPACES:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
10$:    DECL    R0
        BLSS    90$
        PUSHL   R0
        MOVL    #1, R2
        MOVAB   BLANK, R1
        BSBB    APPEND
        MOVL    (SP)+, R0
        BRB     10$
90$:    RSB
BLANK:  .ASCII  " "

; APPEND: R1 = text, R2 = its length. Appends it to the frame's text, as
; much as fits, and counts it in the line and the length whether it fits
; or not. Uses R0-R5.
APPEND:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        ADDL2   R2, F_LINE(R11)
        MOVL    F_LEN(R11), R3
        ADDL2   R2, F_LEN(R11)
        SUBL3   R3, #OUTMAX, R0         ; the room left
        BLEQ    90$
        CMPL    R2, R0
        BLEQU   10$
        MOVL    R0, R2
10$:    MOVAB   F_TEXT(R11)[R3], R3
        MOVC3   R2, (R1), (R3)
90$:    RSB

; HEXPIECE: R0 = a value, R1 = how many hex digits. Appends %X and them,
; with a , after them. Uses R0-R5.
HEXPIECE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAB   F_ID+1(R11), R3
        MOVW    #^A/%X/, (R3)+
        BSBW    HEX
        MOVB    #COMMA, (R3)+
        MOVAB   F_ID+1(R11), R1
        SUBL3   R1, R3, R2
        MOVB    R2, F_ID(R11)
        MOVAB   F_ID(R11), R1
        BSBW    PIECE
        RSB

; HEX: R0 = a value, R1 = how many hex digits, R3 = where they go. Writes
; them, R3 past them. Uses R2.
HEX:
        .JSB_ENTRY  OUTPUT=<R3>, SCRATCH=<R2>
        PUSHL   R1
10$:    DECL    R1
        BLSS    20$
        MULL3   #4, R1, R2
        EXTZV   R2, #4, R0, R2
        MOVB    HEXDIGITS[R2], (R3)+
        BRB     10$
20$:    MOVL    (SP)+, R1
        RSB

; IDTEXT: R0 = an identifier, R1 = where its text goes, IDMAX bytes.
; Writes it there, as $FORMAT_ACL and SHOW SECURITY show it: * for
; anyone; a general identifier's name, or %X and 8 hex digits for one
; with none; a UIC [g,m] in octal, a wildcard part *, or [name] if it is
; a UIC identifier's. R2 = its length. Uses R0-R5.
IDTEXT:
        .JSB_ENTRY  OUTPUT=<R2>, SCRATCH=<R3, R4, R5>
        PUSHR   #^M<R6, R7, R8>
        MOVL    R1, R7                  ; the start
        MOVL    R1, R3                  ; and the next character
        MOVL    R0, R6
        CMPL    R6, #UIC$K_MATCH_ALL
        BNEQ    10$
        MOVB    #STAR, (R3)+
        BRB     80$
10$:    BITL    #^XC0000000, R6
        BNEQ    40$
        EXTZV   #UIC$V_GROUP, #UIC$S_GROUP, R6, R0      ; a wildcard: no name
        CMPL    R0, #UIC$K_WILD_GROUP
        BEQL    20$
        CMPW    R6, #UIC$K_WILD_MEMBER
        BEQL    20$
        MOVB    #LBRACK, (R3)+
        MOVL    R6, R0
        BSBW    IDNAME
        BLBC    R0, 15$
        MOVB    #RBRACK, (R3)+
        BRB     80$
15$:    MOVL    R7, R3
20$:    MOVB    #LBRACK, (R3)+           ; [g,m]
        EXTZV   #UIC$V_GROUP, #UIC$S_GROUP, R6, R0
        CMPL    R0, #UIC$K_WILD_GROUP
        BNEQ    25$
        MOVB    #STAR, (R3)+
        BRB     27$
25$:    BSBW    OCTAL
27$:    MOVB    #COMMA, (R3)+
        MOVZWL  R6, R0
        CMPL    R0, #UIC$K_WILD_MEMBER
        BNEQ    30$
        MOVB    #STAR, (R3)+
        BRB     35$
30$:    BSBW    OCTAL
35$:    MOVB    #RBRACK, (R3)+
        BRB     80$
40$:    MOVL    R6, R0                  ; a general identifier
        BSBW    IDNAME
        BLBS    R0, 80$
        MOVL    R7, R3
        MOVW    #^A/%X/, (R3)+
        MOVL    R6, R0
        MOVL    #8, R1
        BSBW    HEX
80$:    SUBL3   R7, R3, R2
        POPR    #^M<R6, R7, R8>
        RSB

; IDNAME: R0 = an identifier, R3 = where its name goes. Writes the name
; $IDTOASC gives it there, R3 past it. R0 = SS$_NORMAL, or $IDTOASC's
; failure and R3 as it was. Uses R0-R2.
IDNAME:
        .JSB_ENTRY  OUTPUT=<R3>, SCRATCH=<R2>
        SUBL2   #16, SP                 ; the name's descriptor, its length
        MOVL    #32, (SP)
        MOVL    R3, 4(SP)
        CLRQ    -(SP)                   ; contxt, attrib
        CLRL    -(SP)                   ; resid
        PUSHAQ  12(SP)                  ; nambuf
        PUSHAW  24(SP)                  ; namlen
        PUSHL   R0                      ; id
        CALLS   #6, G^SYS$IDTOASC
        BLBC    R0, 10$
        MOVZWL  8(SP), R2
        ADDL2   R2, R3
10$:    ADDL2   #16, SP
        RSB

; OCTAL: R0 = a value, up to %XFFFF, R3 = where it goes. Writes it in
; octal, without leading 0s, R3 past it. Uses R0-R2.
OCTAL:
        .JSB_ENTRY  OUTPUT=<R3>, SCRATCH=<R2>
        MOVL    #15, R2                 ; the first digit's bit
10$:    TSTL    R2
        BEQL    20$
        EXTZV   R2, #3, R0, R1
        BNEQ    20$
        SUBL2   #3, R2
        BRB     10$
20$:    EXTZV   R2, #3, R0, R1
        ADDB3   #^A/0/, R1, (R3)+
        SUBL2   #3, R2
        BGEQ    20$
        RSB

; $GET_SECURITY clsnam, objnam, objhan, flags, itmlst, contxt, acmode:
; reads what the item list asks for of the object of the class the
; string clsnam describes, FILE, named by the string objnam: OSS$_OWNER,
; OSS$_PROTECTION, OSS$_ACL_LENGTH, OSS$_ACL_READ, OSS$_ACL_READ_ENTRY,
; OSS$_ACL_FIND_ENTRY, each item's buffer and the word its length goes
; in as in $GETJPI's list. The longword at contxt, if it is given, is the
; ACL's position, as the file system's FIB$L_ACLCTX, before and after.
; R0 = SS$_NORMAL, SS$_NOCLASS for a class it doesn't know, SS$_BADPARAM
; for an item it doesn't know, RMS's error finding the file, the file
; system's, such as SS$_NOPRIV, or an ACL item's, such as SS$_ACLEMPTY
; or SS$_NOMOREACE.
        .ENTRY  SYS$GET_SECURITY, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    #IO$_ACCESS, R10
        BSBW    SECURITY
        RET

; $SET_SECURITY clsnam, objnam, objhan, flags, itmlst, contxt, acmode:
; changes the object, as $GET_SECURITY reads it: OSS$_OWNER,
; OSS$_PROTECTION, OSS$_ACL_ADD_ENTRY, OSS$_ACL_DELETE_ENTRY,
; OSS$_ACL_DELETE, OSS$_ACL_DELETE_ALL and OSS$_ACL_FIND_ENTRY, in their
; order; OSS$_ACL_POSITION_TOP and OSS$_ACL_POSITION_BOTTOM put the
; position at the ACL's top or bottom first, where the ACEs added go,
; the top without either or contxt. R0 as $GET_SECURITY's, or SS$_ACLFULL.
        .ENTRY  SYS$SET_SECURITY, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    #IO$_MODIFY, R10
        BSBW    SECURITY
        RET

; SECURITY: AP = $GET_SECURITY's or $SET_SECURITY's arguments, R10 = the
; file system's function, IO$_ACCESS or IO$_MODIFY. Does it. R0 = its
; status. Uses R0-R11.
SECURITY:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        SUBL2   #S_SIZE, SP
        MOVL    SP, R11
        MOVC5   #0, (SP), #0, #S_SIZE, (R11)
        MOVL    #SS$_NOCLASS, R0        ; FILE, the class
        MOVL    4(AP), R1
        BEQL    90$
        CMPW    (R1), #4
        BNEQ    90$
        MOVL    4(R1), R1
        BICL3   #^X20202020, (R1), R2
        CMPL    R2, FILECLASS
        BNEQ    90$
        BSBW    FINDFILE
        BLBC    R0, 90$
        BSBW    ATTRS
        BLBC    R0, 80$
        MOVAB   S_ATR(R11), R2
        $QIOW_S CHAN=S_CHAN(R11), FUNC=R10, IOSB=S_IOSB(R11), P1=S_FIBDSC(R11), P5=R2
        BLBC    R0, 80$
        MOVZWL  S_IOSB(R11), R0
        BLBC    R0, 80$
        MOVL    S_FIB+FIB$L_ACL_STATUS(R11), R0
        BLBS    R0, 70$
        BSBW    CONTEXT
        BRB     80$
70$:    BSBW    CONTEXT
        BSBW    LENGTHS
        MOVL    #SS$_NORMAL, R0
80$:    PUSHL   R0
        $DASSGN_S CHAN=S_CHAN(R11)
        MOVL    (SP)+, R0
90$:    ADDL2   #S_SIZE, SP
        RSB

; FINDFILE: AP = the service's arguments, R11 = SECURITY's frame. Finds
; the file objnam names, with $PARSE and $SEARCH, and assigns a channel
; to its disk. R0 = SS$_NORMAL, RMS's error, or $ASSIGN's. Uses R0-R5.
FINDFILE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVB    #FAB$C_BID, S_FAB+FAB$B_BID(R11)
        MOVB    #FAB$C_BLN, S_FAB+FAB$B_BLN(R11)
        MOVB    #NAM$C_BID, S_NAM+NAM$B_BID(R11)
        MOVB    #NAM$C_BLN, S_NAM+NAM$B_BLN(R11)
        MOVAB   S_NAM(R11), S_FAB+FAB$L_NAM(R11)
        MOVB    #255, S_NAM+NAM$B_ESS(R11)
        MOVAB   S_EXP(R11), S_NAM+NAM$L_ESA(R11)
        MOVB    #255, S_NAM+NAM$B_RSS(R11)
        MOVAB   S_RES(R11), S_NAM+NAM$L_RSA(R11)
        MOVL    8(AP), R1
        MOVL    #RMS$_FNM, R0
        CMPW    (R1), #255
        BGTRU   90$
        MOVB    (R1), S_FAB+FAB$B_FNS(R11)
        MOVL    4(R1), S_FAB+FAB$L_FNA(R11)
        $PARSE  FAB=S_FAB(R11)
        BLBC    R0, 90$
        $SEARCH FAB=S_FAB(R11)
        BLBC    R0, 90$
        MOVZBL  S_NAM+NAM$B_DEV(R11), S_DEV(R11)
        MOVL    S_NAM+NAM$L_DEV(R11), S_DEV+4(R11)
        $ASSIGN_S DEVNAM=S_DEV(R11), CHAN=S_CHAN(R11)
        MOVL    S_NAM+NAM$W_FID(R11), S_FIB+FIB$W_FID(R11)
        MOVW    S_NAM+NAM$W_FID+4(R11), S_FIB+FIB$W_FID+4(R11)
        MOVL    #FIB$C_LENGTH, S_FIBDSC(R11)
        MOVAB   S_FIB(R11), S_FIBDSC+4(R11)
        MOVL    24(AP), R1              ; the ACL's position
        BEQL    90$
        MOVL    (R1), S_FIB+FIB$L_ACLCTX(R11)
90$:    RSB

; ATTRS: AP = the service's arguments, R11 = SECURITY's frame. Makes the
; attribute list from the item list, by ITEMS: each item's buffer, and
; its size, the buffer's if ITEMS says 0. OSS$_ACL_POSITION_TOP and
; OSS$_ACL_POSITION_BOTTOM set the position instead. R0 = SS$_NORMAL,
; or SS$_BADPARAM for an item it doesn't know, or more than MAXATR.
; Uses R0-R7.
ATTRS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        MOVL    20(AP), R6              ; the items
        BEQL    80$
        MOVAB   S_ATR(R11), R7          ; the attributes
10$:    TSTL    (R6)
        BEQL    80$
        CMPW    2(R6), #OSS$_ACL_POSITION_TOP
        BNEQ    15$
        CLRL    S_FIB+FIB$L_ACLCTX(R11)
        BRB     60$
15$:    CMPW    2(R6), #OSS$_ACL_POSITION_BOTTOM
        BNEQ    20$
        MOVL    #^XFFFFFF, S_FIB+FIB$L_ACLCTX(R11)
        BRB     60$
20$:    BSBW    ITEM
        MOVL    #SS$_BADPARAM, R0
        TSTL    R1
        BEQL    90$
        MOVAB   S_ATR+<MAXATR*8>(R11), R0
        CMPL    R7, R0
        BLSSU   25$
        MOVL    #SS$_BADPARAM, R0
        BRB     90$
25$:    MOVZBL  1(R1), R0               ; the attribute's code
        MOVW    R0, ATR$W_TYPE(R7)
        MOVZBL  2(R1), R0               ; its size
        BNEQ    30$
        MOVZWL  (R6), R0                ; the buffer's, at most 255 for an ACE
        CMPB    (R1), #OSS$_ACL_READ
        BEQL    30$
        CMPL    R0, #ACEMAX
        BLEQU   30$
        MOVL    #ACEMAX, R0
30$:    MOVW    R0, ATR$W_SIZE(R7)
        MOVL    4(R6), ATR$L_ADDR(R7)
        BNEQ    35$
        MOVAB   S_PROT(R11), ATR$L_ADDR(R7)     ; one with no buffer
        CLRW    ATR$W_SIZE(R7)
35$:    CMPB    (R1), #OSS$_PROTECTION  ; a protection read into a longword: 0s above
        BNEQ    40$
        CMPW    (R6), #4
        BLSSU   40$
        CMPL    R10, #IO$_ACCESS
        BNEQ    40$
        CLRL    @4(R6)
40$:    ADDL2   #8, R7
60$:    ADDL2   #12, R6
        BRB     10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; ITEM: R6 = an item. R1 = its entry in ITEMS, or 0. Uses R0.
ITEM:
        .JSB_ENTRY  OUTPUT=<R1>
        MOVAB   ITEMS, R1
10$:    TSTB    (R1)
        BEQL    80$
        CMPB    (R1), 2(R6)
        BEQL    90$
        ADDL2   #4, R1
        BRB     10$
80$:    CLRL    R1
90$:    RSB

; CONTEXT: AP = the service's arguments, R11 = SECURITY's frame. Writes
; the ACL's position back to contxt, if it is given. Keeps every register.
CONTEXT:
        .JSB_ENTRY
        PUSHL   R1
        MOVL    24(AP), R1
        BEQL    10$
        MOVL    S_FIB+FIB$L_ACLCTX(R11), (R1)
10$:    MOVL    (SP)+, R1
        RSB

; LENGTHS: AP = the service's arguments. Writes the length of what each
; item that returns one got, if its word for it is given: an owner's 4,
; a protection's 2, the ACL's length's 4, an ACE's its size, ACEs' their
; bytes. Uses R0-R7.
LENGTHS:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6, R7>
        MOVL    20(AP), R6
        BEQL    90$
10$:    TSTL    (R6)
        BEQL    90$
        TSTL    8(R6)
        BEQL    60$
        BSBW    ITEM
        TSTL    R1
        BEQL    60$
        MOVZBL  3(R1), R0
        CASEL   R0, #1, #3
15$:    .WORD   20$-15$, 25$-15$, 30$-15$, 35$-15$
        BRB     60$
20$:    MOVL    #4, R2
        BRB     50$
25$:    MOVL    #2, R2
        BRB     50$
30$:    MOVZBL  @4(R6), R2              ; an ACE's size
        BRB     50$
35$:    MOVL    4(R6), R3               ; ACEs': up to one of size 0
        MOVZWL  (R6), R4
        ADDL2   R3, R4
        MOVL    R3, R2
40$:    CMPL    R2, R4
        BGEQU   45$
        MOVZBL  (R2), R0
        BEQL    45$
        ADDL2   R0, R2
        BRB     40$
45$:    SUBL2   R3, R2
50$:    MOVW    R2, @8(R6)
60$:    ADDL2   #12, R6
        BRB     10$
90$:    RSB

        .END
