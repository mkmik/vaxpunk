        .TITLE  MEMORY  Memory management: pages, pool and the memory services
        .IDENT  /V0.1/
;
; The PAL gives the executive physical pages, numbered by PFN, and maps one
; at an address when the executive writes a PTE with WRPTE. The executive
; owns the PFN database, here a list of free PFNs, and decides what goes
; where (docs/design/0002-executive-processes.md). P0 and P1 are each
; process's own; a PTE written there is the current process's:
;
;   ^X00010000  P0: the process's image, then its $EXPREG pages
;   ^X40010000  S0, every process's: EXEC.EXE, then the PFN database,
;               then nonpaged pool: PCBs, kernel stacks, common event
;               blocks, timer queue entries, logical names; it grows, up
;               to NPAGEVIR or the port's pages
;   ^X4FF00000  the port's pages, with a network device
;   ^X4FFE0000  a page MMG$CRMPSC maps a global section's pages at to zero them
;   ^X4FFF0000  the RPB
;   ^X50000000  MDA0:'s blocks, the ramdisk's, once INITIALIZE makes them
;   ^X5FFF0000  the boot stack's top
;   ^X60000000  P1: the process's $CRETVA pages
;   ^X7FF00000  its command interpreter, if it has one, then its mode stacks
;
; A global section is pages any process may map by the section's name
; with $CRMPSC or $MGBLSC, so that processes share them: its GSD, from
; pool, names its PFNs and counts the PTEs that map them, and a PFN of
; one is never on the free list. FREEOLD, which every page's deletion
; goes through, counts one down, and deletes the section when the count
; reaches 0, unless it is permanent and $DGBLSC hasn't asked. A section's
; name is its creator's UIC group's, or, with SEC$M_SYSGBL, the
; system's; PRMGBL and SYSGBL privileges let a process make permanent and
; system sections.
; ponytail: global page file sections only: sections of a file need a
; channel to it, an RMS open with FAB$V_UFO, which isn't here; the pages
; are made when the section is, not as they are touched; no GBL$ logical
; names, no $UPDSEC.
;
; The PFN database, the pool and the global sections are synchronized
; at IPL$_SYNCH.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $PALDEF
        $PTEDEF
        $PRTDEF
        $PCBDEF
        $RPBDEF
        $VADEF
        $SSDEF
        $SECDEF
        $GSDDEF
        $ARMDEF
        $PRVDEF

        .EXTERNAL EXE$GL_RPB, SCH$GL_CURPCB, EXE$PROBER_DSC, EXE$MATCHNAME, FIL$CHKPRO

POOL_END = ^X4FF00000                   ; past pool: the port's pages
PFNDB_MAX = 128*1024*1024               ; the PFN database's most bytes: 64 GB of RAM
POOL_GROW = 256*1024                    ; what pool grows by, at least
ZEROVA = ^X4FFE0000
GSDNAMMAX = 43                          ; a global section name's characters, at most
KW = PTE$M_VALID ! PTE$M_FOE ! PTE$C_KW
UW = PTE$M_VALID ! PTE$M_FOE ! PTE$C_UW
UR = PTE$M_VALID ! PTE$M_FOE ! PTE$C_UR

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
MMG$GL_FREECNT::                        ; free PFNs: on the free stack, and from MMG$GL_HIGHPFN up
        .LONG   0
EXE$GL_NONPAGED::                       ; free pool blocks by address:
        .LONG   0                       ; each a link and a size
MMG$GL_MAXPFN::                         ; PFNs 0 to this one less are the executive's
        .LONG   0
MMG$GL_HIGHPFN::                        ; PFNs from this one to MMG$GL_MAXPFN were never used: free
        .LONG   0
MMG$GL_FREEPFN::                        ; S0: the free stack, PFNs freed, a longword each
        .LONG   0
FREESP: .LONG   0                       ; how many PFNs are on it
MMG$GL_FRESVA::                         ; the first S0 address past EXEC.EXE and the PFN database
        .LONG   0
MMG$GQ_GSDHD::                          ; global sections by name: GSDs
        .BLKQ   1
MMG$GL_PFNGSD::                         ; S0, by PFN: the GSD of the global section it is a page of, or 0
        .LONG   0
MMG$GL_NPAGEDYN::                       ; nonpaged pool's first address
        .LONG   0
MMG$GL_NPAGNEXT::                       ; and where it grows next
        .LONG   0
SGN$GL_NPAGEDYN::                       ; SYSGEN's NPAGEDYN: pool's bytes at boot
        .LONG   1024*1024
SGN$GL_NPAGEVIR::                       ; and NPAGEVIR: the most it grows to; 0, as far as S0 goes
        .LONG   0

        .PSECT  $CODE$

; MMG$INIT: makes the PFN database in S0 from RPB$L_FRESVA, past
; EXEC.EXE, for RPB$L_PFNCNT PFNs, or as many as PFNDB_MAX holds at 8
; bytes each: the free stack, empty, and MMG$GL_PFNGSD's table. The PFNs
; the boot left free are free from MMG$GL_HIGHPFN up, without a walk.
; Then makes the pool past it, NPAGEDYN bytes, and the most it may grow
; to, NPAGEVIR, no further than POOL_END. Uses R0-R5.
MMG$INIT::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVAQ   MMG$GQ_GSDHD, R0
        MOVL    R0, (R0)
        MOVL    R0, 4(R0)
        MOVL    EXE$GL_RPB, R5
        MOVL    RPB$L_FRESVA(R5), R4    ; the database
        MOVL    RPB$L_PFNCNT(R5), R2
        CMPL    R2, #PFNDB_MAX/8
        BLEQU   10$
        MOVL    #PFNDB_MAX/8, R2
10$:    MOVL    R2, MMG$GL_MAXPFN
        MOVL    RPB$L_FREEPFN(R5), R0
        MOVL    R0, MMG$GL_HIGHPFN
        SUBL3   R0, R2, MMG$GL_FREECNT
        MOVL    R4, MMG$GL_FREEPFN
        MOVAL   (R4)[R2], MMG$GL_PFNGSD
        ASHL    #3, R2, R3              ; both tables' bytes
        ADDL2   #MMG$C_PAGESIZE-1, R3
        ASHL    #-MMG$C_VPCTX, R3, R3   ; and pages, zeroed
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    #KW, R2
        BSBW    MMG$CREPAG
        ASHL    #MMG$C_VPCTX, R3, R3
        ADDL3   R3, R4, R0
        MOVL    R0, MMG$GL_FRESVA
        MOVL    R0, MMG$GL_NPAGEDYN     ; the pool
        MOVL    R0, MMG$GL_NPAGNEXT
        SUBL3   R0, #POOL_END, R1
        TSTL    SGN$GL_NPAGEVIR
        BEQL    20$
        CMPL    SGN$GL_NPAGEVIR, R1
        BLEQU   30$
20$:    MOVL    R1, SGN$GL_NPAGEVIR
30$:    MOVL    SGN$GL_NPAGEDYN, R1
        BSBW    GROWPOOL
        RSB

; GROWPOOL: R1 = bytes. Makes that much more pool, whole pages, at its
; end, if NPAGEVIR lets it, and puts it on the free list. R0 =
; SS$_NORMAL or SS$_INSFMEM. IPL$_SYNCH. Uses R0-R2.
GROWPOOL:
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3>
        ADDL2   #MMG$C_PAGESIZE-1, R1
        BICL2   #MMG$C_PAGESIZE-1, R1
        MOVL    R1, R3
        ADDL3   MMG$GL_NPAGNEXT, R3, R0
        SUBL2   MMG$GL_NPAGEDYN, R0     ; pool's size, grown
        CMPL    R0, SGN$GL_NPAGEVIR
        BGTRU   90$
        MOVL    MMG$GL_NPAGNEXT, R0
        ASHL    #-MMG$C_VPCTX, R3, R1
        MOVL    #KW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 80$                 ; no PFNs: what it made is made again next time
        MOVL    MMG$GL_NPAGNEXT, R0
        MOVL    R3, R1
        ADDL2   R3, MMG$GL_NPAGNEXT
        BSBW    EXE$DEANONPGDSIZ
        MOVL    #SS$_NORMAL, R0
80$:    POPR    #^M<R3>
        RSB
90$:    MOVL    #SS$_INSFMEM, R0
        BRB     80$

; MMG$ALLOCPFN: R0 = a free PFN, or 0 if there is none: PFN 0 is the
; boot's. One freed before, from the free stack, else one never used.
; IPL$_SYNCH.
MMG$ALLOCPFN::
        .JSB_ENTRY
        CLRL    R0
        TSTL    MMG$GL_FREECNT
        BEQL    20$
        DECL    MMG$GL_FREECNT
        MOVL    FREESP, R0
        BEQL    10$
        DECL    R0
        MOVL    R0, FREESP
        ASHL    #2, R0, R0
        ADDL2   MMG$GL_FREEPFN, R0
        MOVL    (R0), R0
        RSB
10$:    MOVL    MMG$GL_HIGHPFN, R0
        INCL    MMG$GL_HIGHPFN
20$:    RSB

; MMG$DEALLOCPFN: R0 = a PFN to free, onto the free stack. IPL$_SYNCH.
; Keeps every register.
MMG$DEALLOCPFN::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2>
        MOVL    MMG$GL_FREEPFN, R1
        MOVL    FREESP, R2
        MOVL    R0, (R1)[R2]
        INCL    FREESP
        INCL    MMG$GL_FREECNT
        POPR    #^M<R1, R2>
        RSB

; MMG$CREPAG: R0 = a page's address, R1 = a page count, R2 = the PTE's
; low longword: its valid bit, enables and fault on execute bit. Makes
; those pages, zeroed, with that protection, replacing any there. R0 =
; SS$_NORMAL, or SS$_INSFMEM when the PFNs run out or the PAL has no room
; for another mapping (WRPTE returns -1), with the pages made so far left.
; Uses R0-R2.
MMG$CREPAG::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4, R5, R6>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R3
        MOVL    R1, R4
        MOVL    R2, R5
10$:    TSTL    R4
        BEQL    40$
        BSBW    MMG$ALLOCPFN
        TSTL    R0
        BEQL    50$
        EVAX_SLL R0, #PTE$V_PFN, R6     ; its PTE, but the protection
        EVAX_OR R6, #KW, R1             ; writable first, to zero it,
        BITL    #PTE$M_KWE, R5          ; unless its protection lets kernel
        BEQL    15$                     ; mode write already
        EVAX_OR R6, R5, R1
15$:    MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
        EVAX_ADDQ R0, #1, R1            ; -1: the PAL has no room for it
        EVAX_BEQ R1, 55$
        BSBB    FREEOLD
        MOVL    R3, R1
        MOVL    #MMG$C_PAGESIZE/8, R2
20$:    CLRQ    (R1)+
        SOBGTR  R2, 20$
        BITL    #PTE$M_KWE, R5          ; then the protection it gets
        BNEQ    30$
        EVAX_OR R6, R5, R1
        MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
        EVAX_ADDQ R0, #1, R1            ; no room: the page stays kernel write
        EVAX_BEQ R1, 50$
30$:    ADDL2   #MMG$C_PAGESIZE, R3
        DECL    R4
        BRB     10$
40$:    MOVL    #SS$_NORMAL, R0
45$:    ENBINT
        POPR    #^M<R3, R4, R5, R6>
        RSB
55$:    EVAX_SRL R6, #PTE$V_PFN, R0     ; the PFN goes back
        BSBW    MMG$DEALLOCPFN
50$:    MOVL    #SS$_INSFMEM, R0
        BRB     45$

; FREEOLD: R0 = a PTE WRPTE replaced. Frees its PFN if it had one, or
; if that is a global section's, counts the section's PTEs down.
; IPL$_SYNCH.
FREEOLD:
        .JSB_ENTRY
        EVAX_ADDQ R0, #1, R1            ; -1: WRPTE made no change
        EVAX_BEQ R1, 10$
        EVAX_AND R0, #PTE$M_VALID, R1
        EVAX_BEQ R1, 10$
        EVAX_SRL R0, #PTE$V_PFN, R0
        MOVL    MMG$GL_PFNGSD, R1
        MOVL    (R1)[R0], R1
        BNEQ    20$
        BSBW    MMG$DEALLOCPFN
10$:    RSB
20$:    DECL    GSD$L_REFCNT(R1)
        BSBW    CHKGSD
        RSB

; CHKGSD: R1 = a global section's GSD. Deletes the section if no PTE maps
; its pages and it is temporary, or $DGBLSC took it off MMG$GQ_GSDHD:
; frees its PFNs and its GSD. IPL$_SYNCH.
CHKGSD:
        .JSB_ENTRY
        TSTL    GSD$L_REFCNT(R1)
        BNEQ    90$
        TSTL    GSD$L_GSDFL(R1)
        BEQL    10$                     ; off the list already
        BITL    #SEC$M_PERM, GSD$L_FLAGS(R1)
        BNEQ    90$
        REMQUE  (R1), R0
10$:    MOVL    GSD$L_PAGCNT(R1), R2
        MOVAL   GSD$AL_PFN(R1), R3
        MOVL    MMG$GL_PFNGSD, R4
        BRB     30$
20$:    MOVL    (R3)+, R0
        CLRL    (R4)[R0]
        BSBW    MMG$DEALLOCPFN
30$:    SOBGEQ  R2, 20$
        MOVL    R1, R0
        MOVL    GSD$L_SIZE(R0), R1
        BSBW    EXE$DEANONPGDSIZ
90$:    RSB

; ZEROPFN: R0 = a PFN no PTE maps. Zeroes its page, through ZEROVA.
; IPL$_SYNCH. Uses R0-R2.
ZEROPFN:
        .JSB_ENTRY  SCRATCH=<R2>
        EVAX_SLL R0, #PTE$V_PFN, R1
        EVAX_OR R1, #KW, R1
        MOVL    #ZEROVA, R0
        CALL_PAL #PAL$_WRPTE
        MOVL    #ZEROVA, R1
        MOVL    #MMG$C_PAGESIZE/8, R2
10$:    CLRQ    (R1)+
        SOBGTR  R2, 10$
        MOVL    #ZEROVA, R0
        CLRL    R1
        CALL_PAL #PAL$_WRPTE
        RSB

; MMG$DELPAG: R0 = a page's address, R1 = a page count. Deletes those
; pages and frees their PFNs. Uses R0-R1.
MMG$DELPAG::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R2
        MOVL    R1, R3
        BEQL    20$
10$:    MOVL    R2, R0
        CLRL    R1
        CALL_PAL #PAL$_WRPTE
        BSBB    FREEOLD
        ADDL2   #MMG$C_PAGESIZE, R2
        SOBGTR  R3, 10$
20$:    ENBINT
        POPR    #^M<R2, R3>
        RSB

; MMG$SETPRT: R0 = a page's address, R1 = a page count, R2 = the PTE's
; new low longword: its valid bit, enables and fault on execute bit. Changes the protection of
; pages that exist. Uses R0-R2.
MMG$SETPRT::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R3
        MOVL    R1, R4
        BEQL    20$
10$:    MOVL    R3, R0
        CLRL    R1
        CALL_PAL #PAL$_WRPTE            ; R0 = the PTE, with the PFN
        EVAX_AND R0, #PTE$M_VALID, R1
        EVAX_BEQ R1, 15$
        EVAX_SRL R0, #PTE$V_PFN, R1
        EVAX_SLL R1, #PTE$V_PFN, R1     ; the PFN alone
        EVAX_OR R1, R2, R1
        MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
15$:    ADDL2   #MMG$C_PAGESIZE, R3
        SOBGTR  R4, 10$
20$:    ENBINT
        POPR    #^M<R3, R4>
        RSB

; EXE$ALONONPAGED: R1 = a size in bytes. Allocates a block of nonpaged
; pool, 16-byte aligned, first fit, growing the pool when none fits: R2 =
; its address, R1 = the size it got, R0 = SS$_NORMAL or SS$_INSFMEM. The
; block isn't zeroed.
EXE$ALONONPAGED::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4, R5>
        DSBINT  #IPL$_SYNCH
        ADDL2   #15, R1
        BICL2   #15, R1
        BEQL    90$
        CLRL    R5                      ; not grown yet
5$:     MOVAL   EXE$GL_NONPAGED, R3     ; the link to the block
10$:    MOVL    (R3), R2
        BEQL    60$
        CMPL    4(R2), R1
        BGEQU   20$
        MOVL    R2, R3
        BRB     10$
20$:    SUBL3   R1, 4(R2), R4           ; what is left
        BEQL    30$
        MOVL    R4, 4(R2)               ; hand out its end
        ADDL2   R4, R2
        BRB     40$
30$:    MOVL    (R2), (R3)              ; all of it
40$:    MOVL    #SS$_NORMAL, R0
50$:    ENBINT
        POPR    #^M<R3, R4, R5>
        RSB
60$:    TSTL    R5                      ; none fits: grow once, by the block
        BNEQ    90$                     ; or POOL_GROW, whichever is more
        INCL    R5
        MOVL    R1, R4
        CMPL    R1, #POOL_GROW
        BGEQU   65$
        MOVL    #POOL_GROW, R1
65$:    BSBW    GROWPOOL
        MOVL    R4, R1
        BLBS    R0, 5$
90$:    CLRL    R2
        MOVL    #SS$_INSFMEM, R0
        BRB     50$

; EXE$DEANONPGDSIZ: R0 = a pool block, R1 = its size. Frees it, merging
; it with free neighbours. Keeps every register.
EXE$DEANONPGDSIZ::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4>
        DSBINT  #IPL$_SYNCH
        ADDL2   #15, R1
        BICL2   #15, R1
        MOVAL   EXE$GL_NONPAGED, R3     ; the link to the next block
        CLRL    R4                      ; the block before, if any
10$:    MOVL    (R3), R2
        BEQL    20$
        CMPL    R2, R0
        BGTRU   20$
        MOVL    R2, R4
        MOVL    R2, R3
        BRB     10$
20$:    MOVL    R2, (R0)
        MOVL    R1, 4(R0)
        MOVL    R0, (R3)
        TSTL    R2                      ; merge with the next
        BEQL    30$
        ADDL3   R0, R1, R3
        CMPL    R3, R2
        BNEQ    30$
        ADDL2   4(R2), 4(R0)
        MOVL    (R2), (R0)
30$:    TSTL    R4                      ; and with the one before
        BEQL    40$
        ADDL3   R4, 4(R4), R3
        CMPL    R3, R0
        BNEQ    40$
        ADDL2   4(R0), 4(R4)
        MOVL    (R0), (R4)
40$:    ENBINT
        POPR    #^M<R0, R1, R2, R3, R4>
        RSB

; INADR: AP = a $CRETVA or $DELTVA argument list. R2 = the first page of
; the range its inadr gives, R3 = the page count, R0 = SS$_NORMAL;
; SS$_ACCVIO if the caller can't read inadr or write retadr, or
; SS$_PAGOWNVIO if the range isn't all in P0, or all in P1 below the
; command interpreter's and the mode stacks' VA$C_CLI. Uses R1.
INADR:
        .JSB_ENTRY  OUTPUT=<R2, R3>
        MOVL    8(AP), R1
        BEQL    10$
        IFNOWRT #8, (R1), 80$
10$:    MOVL    4(AP), R1
        IFNORD  #8, (R1), 80$
        MOVL    (R1), R2
        MOVL    4(R1), R3
        BICL2   #MMG$C_PAGESIZE-1, R2
        BISL2   #MMG$C_PAGESIZE-1, R3
        CMPL    R3, R2
        BLSSU   90$
        CMPL    R2, #VA$C_P0BASE
        BLSSU   90$
        CMPL    R3, #VA$C_S0BASE
        BLSSU   20$                     ; all in P0
        CMPL    R2, #VA$C_P1BASE
        BLSSU   90$
        CMPL    R3, #VA$C_CLI
        BGEQU   90$
20$:    SUBL2   R2, R3
        INCL    R3
        ASHL    #-MMG$C_VPCTX, R3, R3
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB
90$:    MOVL    #SS$_PAGOWNVIO, R0
        RSB

; RETADR: R0 = a first page, R1 = a page count, R2 = the address of a
; retadr argument, 0 if none. Stores the range's first and last bytes.
RETADR:
        .JSB_ENTRY
        TSTL    R2
        BEQL    10$
        MOVL    R0, (R2)
        ASHL    #MMG$C_VPCTX, R1, R1
        ADDL3   R0, R1, 4(R2)
        DECL    4(R2)
10$:    RSB

; GROW: R2 = the first of a range of pages in P0 or P1, R3 = a page
; count. Grows the current process's P0 or P1 to take the range in, so
; that its rundown deletes the pages. Uses R0 and R1.
GROW:
        .JSB_ENTRY
        MOVL    SCH$GL_CURPCB, R0
        ASHL    #MMG$C_VPCTX, R3, R1
        ADDL2   R2, R1                  ; past the last
        CMPL    R2, #VA$C_S0BASE
        BGEQU   20$
        CMPL    R1, PCB$L_FREP0VA(R0)
        BLEQU   30$
        MOVL    R1, PCB$L_FREP0VA(R0)
        RSB
20$:    CMPL    R2, PCB$L_FREP1VA(R0)
        BGEQU   30$
        MOVL    R2, PCB$L_FREP1VA(R0)
30$:    RSB

; $CRETVA inadr, retadr, acmode: makes the pages of a range of the
; process's P0 or P1, zeroed and writable, replacing any there.
        .ENTRY  EXE$CRETVA, ^M<R2, R3, R4>
        BSBB    INADR
        BLBC    R0, 90$
        MOVL    R2, R4
        MOVL    R2, R0
        MOVL    R3, R1
        MOVL    #UW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
        MOVL    R4, R2
        BSBB    GROW
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
90$:    RET

; $DELTVA inadr, retadr, acmode: deletes the pages of a range of the
; process's P0 or P1.
        .ENTRY  EXE$DELTVA, ^M<R2, R3, R4>
        BSBB    INADR
        BLBC    R0, 90$
        MOVL    R2, R4
        MOVL    R2, R0
        MOVL    R3, R1
        BSBW    MMG$DELPAG
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
90$:    RET

; $EXPREG pagcnt, retadr, acmode, region: makes pagcnt pages, zeroed and
; writable, past the end of the process's P0.
; ponytail: P0 only, whatever the region; P1 grows down with $CRETVA.
        .ENTRY  EXE$EXPREG, ^M<R2, R3, R4>
        MOVL    4(AP), R3
        BEQL    85$
        MOVL    8(AP), R2
        BEQL    10$
        IFNOWRT #8, (R2), 95$
10$:    MOVL    SCH$GL_CURPCB, R4
        CMPL    R3, #<VA$C_S0BASE-VA$C_P0BASE>/MMG$C_PAGESIZE
        BGTRU   90$
        MOVL    PCB$L_FREP0VA(R4), R0   ; the first new page
        ASHL    #MMG$C_VPCTX, R3, R1
        ADDL2   R0, R1                  ; past the last
        CMPL    R1, #VA$C_S0BASE
        BGTRU   90$
        MOVL    R1, PCB$L_FREP0VA(R4)
        MOVL    R0, R4
        MOVL    R3, R1
        MOVL    #UW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 70$
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
70$:    RET
85$:    MOVL    #SS$_ILLPAGCNT, R0
        RET
90$:    MOVL    #SS$_VASFULL, R0
        RET
95$:    MOVL    #SS$_ACCVIO, R0
        RET

; GSDARGS: R1 = a gsdnam argument, the address of a descriptor, R2 = an
; ident argument, the address of a quadword, or 0. R6 = the name, R7 =
; its length, R9 = ident, or 0, R0 = SS$_NORMAL; SS$_ACCVIO if the
; caller can't read them, SS$_IVGSDNAM for no name or one too long,
; SS$_IVSECIDCTL for a match control that isn't SEC$K_MATALL, MATEQU or
; MATLEQ.
GSDARGS:
        .JSB_ENTRY  OUTPUT=<R6, R7, R9>
        MOVL    R2, R9
        BEQL    10$
        IFNORD  #8, (R9), 80$
        CMPL    (R9), #SEC$K_MATLEQ
        BGTRU   85$
10$:    TSTL    R1
        BEQL    84$
        MOVL    R1, R6
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R6), R7
        BEQL    84$
        CMPL    R7, #GSDNAMMAX
        BGTRU   84$
        MOVL    4(R6), R6
        MOVL    #SS$_NORMAL, R0
90$:    RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB
84$:    MOVL    #SS$_IVGSDNAM, R0
        RSB
85$:    MOVL    #SS$_IVSECIDCTL, R0
        RSB

; FINDGSD: R4 = the current PCB, R5 = a call's flags, R6 = a global
; section's name, R7 = its length. R8 = the GSD of the section of that
; name: a system one with SEC$M_SYSGBL, else one of the process's UIC
; group, or 0 if there is none. IPL$_SYNCH. Uses R0 and R1.
FINDGSD:
        .JSB_ENTRY  OUTPUT=<R8>
        MOVAQ   MMG$GQ_GSDHD, R8
10$:    MOVL    (R8), R8
        MOVAQ   MMG$GQ_GSDHD, R0
        CMPL    R8, R0
        BEQL    80$
        XORL3   GSD$L_FLAGS(R8), R5, R0
        BITL    #SEC$M_SYSGBL, R0
        BNEQ    10$                     ; the other kind
        BITL    #SEC$M_SYSGBL, R5
        BNEQ    20$
        CMPW    GSD$L_UIC+2(R8), PCB$L_UIC+2(R4)
        BNEQ    10$                     ; another group's
20$:    MOVAB   GSD$T_GSDNAM(R8), R0
        BSBW    EXE$MATCHNAME
        BLBC    R0, 10$
        RSB
80$:    CLRL    R8
        RSB

; CHKIDENT: R8 = a global section's GSD, R9 = an ident to match, or 0.
; R0 = SS$_NORMAL if it matches the section's version, else
; SS$_NOSUCHSEC.
CHKIDENT:
        .JSB_ENTRY
        MOVL    #SS$_NORMAL, R0
        TSTL    R9
        BEQL    90$
        MOVL    (R9), R1
        BEQL    90$                     ; SEC$K_MATALL
        CMPL    4(R9), GSD$L_IDENT(R8)
        BEQL    90$
        CMPL    R1, #SEC$K_MATEQU
        BEQL    80$
        XORL3   4(R9), GSD$L_IDENT(R8), R1
        BITL    #^XFF000000, R1
        BNEQ    80$                     ; another major version
        CMPL    4(R9), GSD$L_IDENT(R8)
        BLEQU   90$
80$:    MOVL    #SS$_NOSUCHSEC, R0
90$:    RSB

; MAPGSD: AP = a $CRMPSC or $MGBLSC argument list, R4 = the current PCB,
; R5 = the call's flags, R8 = a global section's GSD, R9 = the first of
; its pages to map. Maps its pages from there in the range inadr gives,
; as many as both have, or all of them past the end of the region
; inadr's first address is in, with SEC$M_EXPREG: writable with
; SEC$M_WRT, if the section is, else read only, if the section's owner
; and protection let the process. retadr gets the first and last
; addresses mapped. R0 = SS$_NORMAL, SS$_NOPRIV, SS$_ENDOFFILE for a
; first page past the section's end, SS$_VASFULL, SS$_PAGOWNVIO or
; SS$_ACCVIO. IPL$_SYNCH.
MAPGSD:
        .JSB_ENTRY  INPUT=<AP>
        CMPL    R9, GSD$L_PAGCNT(R8)
        BGEQU   82$
        MOVL    #ARM$M_READ, R0
        MOVL    #UR, R7
        BITL    #SEC$M_WRT, R5
        BEQL    10$
        BITL    #SEC$M_WRT, GSD$L_FLAGS(R8)
        BEQL    84$
        MOVL    #ARM$M_READ!ARM$M_WRITE, R0
        MOVL    #UW, R7
10$:    MOVL    GSD$L_UIC(R8), R1
        MOVL    GSD$L_PROT(R8), R2
        BSBW    FIL$CHKPRO
        BLBC    R0, 90$
        SUBL3   R9, GSD$L_PAGCNT(R8), R6        ; the pages it has from there
        BITL    #SEC$M_EXPREG, R5
        BNEQ    20$
        BSBW    INADR
        BLBC    R0, 90$
        CMPL    R3, R6
        BLEQU   40$
        MOVL    R6, R3
        BRB     40$
20$:    MOVL    8(AP), R1               ; SEC$M_EXPREG: retadr, inadr's region
        BEQL    25$
        IFNOWRT #8, (R1), 86$
25$:    MOVL    4(AP), R1
        IFNORD  #8, (R1), 86$
        MOVL    R6, R3
        ASHL    #MMG$C_VPCTX, R3, R0
        CMPL    (R1), #VA$C_P1BASE
        BGEQU   30$
        MOVL    PCB$L_FREP0VA(R4), R2   ; past P0's end
        ADDL2   R2, R0
        CMPL    R0, #VA$C_S0BASE
        BGTRU   88$
        BRB     40$
30$:    SUBL3   R0, PCB$L_FREP1VA(R4), R2       ; below P1's start
        CMPL    R2, #VA$C_P1BASE
        BLSSU   88$
40$:    BSBW    GROW
        MOVL    R2, R10
        MOVL    R3, R11
        MOVAL   GSD$AL_PFN(R8)[R9], R6
50$:    INCL    GSD$L_REFCNT(R8)        ; first, so the page it replaces can't take it to 0
        MOVL    (R6)+, R1
        EVAX_SLL R1, #PTE$V_PFN, R1
        EVAX_OR R1, R7, R1
        MOVL    R10, R0
        CALL_PAL #PAL$_WRPTE
        BSBW    FREEOLD
        ADDL2   #MMG$C_PAGESIZE, R10
        SOBGTR  R11, 50$
        MOVL    R2, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBW    RETADR
        MOVL    #SS$_NORMAL, R0
90$:    RSB
82$:    MOVL    #SS$_ENDOFFILE, R0
        RSB
84$:    MOVL    #SS$_NOPRIV, R0
        RSB
86$:    MOVL    #SS$_ACCVIO, R0
        RSB
88$:    MOVL    #SS$_VASFULL, R0
        RSB

; $CRMPSC inadr, retadr, acmode, flags, gsdnam, ident, relpag, chan,
; pagcnt, vbn, prot, pfc: makes a global page file section, flags
; SEC$M_GBL and SEC$M_PAGFIL, of pagcnt pages, zeroed and writable,
; called gsdnam, with ident's version, owned by the process's UIC, with
; the protection prot, a file's mask, and maps it as $MGBLSC does; if
; there is one by that name, whose ident matches, it maps that. Permanent
; with SEC$M_PERM, which takes PRMGBL, and a system section with
; SEC$M_SYSGBL, which takes SYSGBL. R0 = SS$_CREATED if it made it,
; SS$_NORMAL if it was there, or $MGBLSC's errors, SS$_IVSECFLG,
; SS$_ILLPAGCNT, SS$_INSFMEM.
; vaxpunk: no sections of files yet: a channel is SS$_IVCHNLSEC, and
; without one, a section that isn't SEC$M_PAGFIL is SS$_IVCHAN. acmode,
; vbn and pfc are ignored.
        .ENTRY  EXE$CRMPSC, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    16(AP), R5
        BITL    #^C<SEC$M_GBL!SEC$M_DZRO!SEC$M_WRT!SEC$M_PERM!SEC$M_SYSGBL!SEC$M_EXPREG!SEC$M_PAGFIL>, R5
        BNEQ    82$
        MOVL    #SS$_IVCHNLSEC, R0
        TSTL    32(AP)
        BNEQ    90$
        MOVL    #SS$_IVCHAN, R0
        BITL    #SEC$M_PAGFIL, R5
        BEQL    90$
        BITL    #SEC$M_GBL, R5
        BEQL    82$
        BISL2   #SEC$M_WRT, R5
        MOVL    #SS$_NOPRIV, R0
        BITL    #SEC$M_PERM, R5
        BEQL    10$
        IFNPRIV PRMGBL, 90$
10$:    BITL    #SEC$M_SYSGBL, R5
        BEQL    15$
        IFNPRIV SYSGBL, 90$
15$:    MOVL    36(AP), R10             ; pagcnt
        BEQL    84$
        CMPL    R10, MMG$GL_MAXPFN
        BGTRU   86$
        MOVL    20(AP), R1
        MOVL    24(AP), R2
        BSBW    GSDARGS
        BLBC    R0, 90$
        DSBINT  #IPL$_SYNCH
        BSBW    FINDGSD
        TSTL    R8
        BEQL    20$
        BSBW    CHKIDENT                ; there already: map it
        BLBC    R0, 80$
        MOVL    #SS$_NORMAL, R11
        BRB     60$
20$:    ASHL    #2, R10, R1             ; a new one
        ADDL2   #GSD$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, R8
        CLRL    GSD$L_GSDFL(R8)
        MOVL    R1, GSD$L_SIZE(R8)
        CLRL    GSD$L_REFCNT(R8)
        BICL3   #^C<SEC$M_WRT!SEC$M_PERM!SEC$M_SYSGBL>, R5, GSD$L_FLAGS(R8)
        MOVL    PCB$L_UIC(R4), GSD$L_UIC(R8)
        MOVZWL  44(AP), GSD$L_PROT(R8)
        CLRL    GSD$L_IDENT(R8)
        TSTL    R9
        BEQL    25$
        MOVL    4(R9), GSD$L_IDENT(R8)
25$:    MOVB    R7, GSD$T_GSDNAM(R8)
        CLRL    R1
        BRB     35$
30$:    MOVB    (R6)[R1], GSD$T_GSDNAM+1(R8)[R1]
        INCL    R1
35$:    CMPL    R1, R7
        BLSSU   30$
        CLRL    R11                     ; its pages, zeroed
40$:    MOVL    R11, GSD$L_PAGCNT(R8)
        CMPL    R11, R10
        BGEQU   50$
        BSBW    MMG$ALLOCPFN
        TSTL    R0
        BEQL    70$
        MOVL    R0, GSD$AL_PFN(R8)[R11]
        MOVL    MMG$GL_PFNGSD, R1
        MOVL    R8, (R1)[R0]
        BSBW    ZEROPFN
        INCL    R11
        BRB     40$
50$:    MOVAQ   MMG$GQ_GSDHD, R0
        INSQUE  (R8), @4(R0)
        MOVL    #SS$_CREATED, R11
60$:    MOVL    28(AP), R9              ; relpag
        BSBW    MAPGSD
        BLBC    R0, 65$
        MOVL    R11, R0
65$:    MOVL    R0, R11
        MOVL    R8, R1                  ; a new temporary one not mapped goes
        BSBW    CHKGSD
        MOVL    R11, R0
80$:    ENBINT
90$:    RET
70$:    MOVL    R8, R1                  ; out of PFNs: give back those it took
        BSBW    CHKGSD
        MOVL    #SS$_INSFMEM, R0
        BRB     80$
82$:    MOVL    #SS$_IVSECFLG, R0
        RET
84$:    MOVL    #SS$_ILLPAGCNT, R0
        RET
86$:    MOVL    #SS$_INSFMEM, R0
        RET

; $MGBLSC inadr, retadr, acmode, flags, gsdnam, ident, relpag: maps the
; global section gsdnam, the process's UIC group's, or the system's
; with SEC$M_SYSGBL, whose version ident matches, from its page relpag,
; into the range inadr gives, or past the end of inadr's region with
; SEC$M_EXPREG; writable with SEC$M_WRT, else read only. retadr gets
; the first and last addresses mapped. The process may read the section
; if its owner and protection allow it, and write it if they allow
; that too. R0 = SS$_NORMAL, SS$_NOSUCHSEC, SS$_IVSECFLG, SS$_IVGSDNAM,
; SS$_IVSECIDCTL, SS$_NOPRIV, SS$_ENDOFFILE, SS$_VASFULL,
; SS$_PAGOWNVIO or SS$_ACCVIO.
; vaxpunk: acmode is ignored.
        .ENTRY  EXE$MGBLSC, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    16(AP), R5
        MOVL    #SS$_IVSECFLG, R0
        BITL    #^C<SEC$M_GBL!SEC$M_WRT!SEC$M_SYSGBL!SEC$M_EXPREG>, R5
        BNEQ    90$
        MOVL    20(AP), R1
        MOVL    24(AP), R2
        BSBW    GSDARGS
        BLBC    R0, 90$
        DSBINT  #IPL$_SYNCH
        BSBW    FINDGSD
        MOVL    #SS$_NOSUCHSEC, R0
        TSTL    R8
        BEQL    80$
        BSBW    CHKIDENT
        BLBC    R0, 80$
        MOVL    28(AP), R9
        BSBW    MAPGSD
80$:    ENBINT
90$:    RET

; $DGBLSC flags, gsdnam, ident: deletes the global section gsdnam, the
; process's UIC group's, or the system's with SEC$M_SYSGBL, which takes
; SYSGBL, whose version ident matches: a permanent one, which takes
; PRMGBL, is temporary from now on. It goes once no process maps it, and
; no one finds it by its name any more. R0 = SS$_NORMAL, SS$_NOSUCHSEC,
; SS$_NOPRIV, SS$_IVGSDNAM, SS$_IVSECIDCTL or SS$_ACCVIO.
        .ENTRY  EXE$DGBLSC, ^M<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R5
        MOVL    #SS$_NOPRIV, R0
        BITL    #SEC$M_SYSGBL, R5
        BEQL    10$
        IFNPRIV SYSGBL, 90$
10$:    MOVL    8(AP), R1
        MOVL    12(AP), R2
        BSBW    GSDARGS
        BLBC    R0, 90$
        DSBINT  #IPL$_SYNCH
        BSBW    FINDGSD
        MOVL    #SS$_NOSUCHSEC, R0
        TSTL    R8
        BEQL    80$
        BSBW    CHKIDENT
        BLBC    R0, 80$
        MOVL    #SS$_NOPRIV, R0
        BITL    #SEC$M_PERM, GSD$L_FLAGS(R8)
        BEQL    20$
        IFNPRIV PRMGBL, 80$
20$:    REMQUE  (R8), R0
        CLRL    GSD$L_GSDFL(R8)
        MOVL    R8, R1
        BSBW    CHKGSD
        MOVL    #SS$_NORMAL, R0
80$:    ENBINT
90$:    RET

        .END
