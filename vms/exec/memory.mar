        .TITLE  MEMORY  Memory management: pages, pool and the memory services
        .IDENT  /V0.1/
;
; The PAL gives the executive physical pages, numbered by PFN, and maps one
; at an address when the executive writes a PTE with WRPTE. The executive
; owns the PFN database, here a list of free PFNs, and decides what goes
; where (docs/design/0002-executive-processes.md). P0 and P1 are each
; process's own; a PTE written there is the current process's:
;
;   ^X00010000  P0: the process's image, then its $EXPREG pages
;   ^X40010000  S0, every process's: EXEC.EXE
;   ^X48000000  nonpaged pool: PCBs, kernel stacks, common event blocks,
;               timer queue entries, logical names
;   ^X4FFF0000  the RPB
;   ^X50000000  MDA0:'s blocks, the ramdisk's, once INITIALIZE makes them
;   ^X5FFF0000  the boot stack's top
;   ^X60000000  P1: the process's $CRETVA pages
;   ^X7FF00000  its command interpreter, if it has one, then its mode stacks
;
; The PFN database and the pool are synchronized at IPL$_SYNCH.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $PALDEF
        $PTEDEF
        $PRTDEF
        $PCBDEF
        $RPBDEF
        $VADEF
        $SSDEF

        .EXTERNAL EXE$GL_RPB, SCH$GL_CURPCB

MMG$C_MAXPFN = 4096
POOL_VA = ^X48000000
POOL_PAGES = 128                        ; 512 KB
KW = PTE$M_VALID ! <PRT$C_KW @ PTE$V_PROT>
UW = PTE$M_VALID ! <PRT$C_UW @ PTE$V_PROT>

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
MMG$GL_FREECNT::                        ; free PFNs, a stack
        .LONG   0
EXE$GL_NONPAGED::                       ; free pool blocks by address:
        .LONG   0                       ; each a link and a size
MMG$AL_FREEPFN:
        .BLKL   MMG$C_MAXPFN

        .PSECT  $CODE$

; MMG$INIT: puts the PFNs the boot left free on the free list and makes
; the pool. Uses R0-R5.
MMG$INIT::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    EXE$GL_RPB, R5
        MOVL    RPB$L_PFNCNT(R5), R2
        CMPL    R2, #MMG$C_MAXPFN
        BLEQU   10$
        MOVL    #MMG$C_MAXPFN, R2
10$:    CLRL    R1                      ; the high PFNs go in first,
20$:    DECL    R2                      ; so the low ones come out first
        CMPL    R2, RPB$L_FREEPFN(R5)
        BLSSU   30$
        MOVL    R2, MMG$AL_FREEPFN[R1]
        INCL    R1
        BRB     20$
30$:    MOVL    R1, MMG$GL_FREECNT
        MOVL    #POOL_VA, R0
        MOVL    #POOL_PAGES, R1
        MOVL    #KW, R2
        BSBW    MMG$CREPAG
        MOVL    #POOL_VA, R0
        MOVL    R0, EXE$GL_NONPAGED
        CLRL    (R0)
        MOVL    #POOL_PAGES*MMG$C_PAGESIZE, 4(R0)
        RSB

; MMG$ALLOCPFN: R0 = a free PFN, or 0 if there is none: PFN 0 is the
; boot's. IPL$_SYNCH.
MMG$ALLOCPFN::
        .JSB_ENTRY
        MOVL    MMG$GL_FREECNT, R0
        BEQL    10$
        DECL    R0
        MOVL    R0, MMG$GL_FREECNT
        MOVL    MMG$AL_FREEPFN[R0], R0
10$:    RSB

; MMG$DEALLOCPFN: R0 = a PFN to free. IPL$_SYNCH. Keeps every register.
MMG$DEALLOCPFN::
        .JSB_ENTRY
        PUSHL   R1
        MOVL    MMG$GL_FREECNT, R1
        MOVL    R0, MMG$AL_FREEPFN[R1]
        INCL    MMG$GL_FREECNT
        MOVL    (SP)+, R1
        RSB

; MMG$CREPAG: R0 = a page's address, R1 = a page count, R2 = the PTE's
; valid bit, protection and execute bit. Makes those pages, zeroed, with
; that protection, replacing any there. R0 = SS$_NORMAL, or SS$_INSFMEM
; when the PFNs run out, with the pages made so far left. Uses R0-R2.
MMG$CREPAG::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4, R5, R6>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R3
        MOVL    R1, R4
        MOVL    R2, R5
10$:    TSTL    R4
        BEQL    40$
        BSBW    MMG$ALLOCPFN
        TSTL    R0
        BEQL    50$
        MOVL    R0, R6
        BISL3   #KW, R6, R1             ; writable first, to zero it
        MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
        BSBB    FREEOLD
        MOVL    R3, R1
        MOVL    #MMG$C_PAGESIZE/8, R2
20$:    CLRQ    (R1)+
        SOBGTR  R2, 20$
        CMPL    R5, #KW                 ; then the protection it gets
        BEQL    30$
        BISL3   R5, R6, R1
        MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
30$:    ADDL2   #MMG$C_PAGESIZE, R3
        DECL    R4
        BRB     10$
40$:    MOVL    #SS$_NORMAL, R0
45$:    ENBINT
        POPR    #^M<R3, R4, R5, R6>
        RSB
50$:    MOVL    #SS$_INSFMEM, R0
        BRB     45$

; FREEOLD: R0 = a PTE WRPTE replaced. Frees its PFN if it had one.
FREEOLD:
        .JSB_ENTRY
        BBC     #PTE$V_VALID, R0, 10$
        BICL2   #^C<PTE$M_PFN>, R0
        BSBW    MMG$DEALLOCPFN
10$:    RSB

; MMG$DELPAG: R0 = a page's address, R1 = a page count. Deletes those
; pages and frees their PFNs. Uses R0-R1.
MMG$DELPAG::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R2
        MOVL    R1, R3
        BEQL    20$
10$:    MOVL    R2, R0
        CLRL    R1
        CALL_PAL #PAL$_WRPTE
        BSBB    FREEOLD
        ADDL2   #MMG$C_PAGESIZE, R2
        SOBGTR  R3, 10$
20$:    ENBINT
        POPR    #^M<R2, R3>
        RSB

; MMG$SETPRT: R0 = a page's address, R1 = a page count, R2 = the PTE's
; new valid bit, protection and execute bit. Changes the protection of
; pages that exist. Uses R0-R2.
MMG$SETPRT::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4>
        DSBINT  #IPL$_SYNCH
        MOVL    R0, R3
        MOVL    R1, R4
        BEQL    20$
10$:    MOVL    R3, R0
        CLRL    R1
        CALL_PAL #PAL$_WRPTE            ; R0 = the PTE, with the PFN
        BBC     #PTE$V_VALID, R0, 15$
        BICL3   #^C<PTE$M_PFN>, R0, R1
        BISL2   R2, R1
        MOVL    R3, R0
        CALL_PAL #PAL$_WRPTE
15$:    ADDL2   #MMG$C_PAGESIZE, R3
        SOBGTR  R4, 10$
20$:    ENBINT
        POPR    #^M<R3, R4>
        RSB

; EXE$ALONONPAGED: R1 = a size in bytes. Allocates a block of nonpaged
; pool, 16-byte aligned, first fit: R2 = its address, R1 = the size it
; got, R0 = SS$_NORMAL or SS$_INSFMEM. The block isn't zeroed.
EXE$ALONONPAGED::
        .JSB_ENTRY  SCRATCH=<R2>
        PUSHR   #^M<R3, R4>
        DSBINT  #IPL$_SYNCH
        ADDL2   #15, R1
        BICL2   #15, R1
        BEQL    90$
        MOVAL   EXE$GL_NONPAGED, R3     ; the link to the block
10$:    MOVL    (R3), R2
        BEQL    90$
        CMPL    4(R2), R1
        BGEQU   20$
        MOVL    R2, R3
        BRB     10$
20$:    SUBL3   R1, 4(R2), R4           ; what is left
        BEQL    30$
        MOVL    R4, 4(R2)               ; hand out its end
        ADDL2   R4, R2
        BRB     40$
30$:    MOVL    (R2), (R3)              ; all of it
40$:    MOVL    #SS$_NORMAL, R0
50$:    ENBINT
        POPR    #^M<R3, R4>
        RSB
90$:    CLRL    R2
        MOVL    #SS$_INSFMEM, R0
        BRB     50$

; EXE$DEANONPGDSIZ: R0 = a pool block, R1 = its size. Frees it, merging
; it with free neighbours. Keeps every register.
EXE$DEANONPGDSIZ::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4>
        DSBINT  #IPL$_SYNCH
        ADDL2   #15, R1
        BICL2   #15, R1
        MOVAL   EXE$GL_NONPAGED, R3     ; the link to the next block
        CLRL    R4                      ; the block before, if any
10$:    MOVL    (R3), R2
        BEQL    20$
        CMPL    R2, R0
        BGTRU   20$
        MOVL    R2, R4
        MOVL    R2, R3
        BRB     10$
20$:    MOVL    R2, (R0)
        MOVL    R1, 4(R0)
        MOVL    R0, (R3)
        TSTL    R2                      ; merge with the next
        BEQL    30$
        ADDL3   R0, R1, R3
        CMPL    R3, R2
        BNEQ    30$
        ADDL2   4(R2), 4(R0)
        MOVL    (R2), (R0)
30$:    TSTL    R4                      ; and with the one before
        BEQL    40$
        ADDL3   R4, 4(R4), R3
        CMPL    R3, R0
        BNEQ    40$
        ADDL2   4(R0), 4(R4)
        MOVL    (R0), (R4)
40$:    ENBINT
        POPR    #^M<R0, R1, R2, R3, R4>
        RSB

; INADR: AP = a $CRETVA or $DELTVA argument list. R2 = the first page of
; the range its inadr gives, R3 = the page count, R0 = SS$_NORMAL;
; SS$_ACCVIO if the caller can't read inadr or write retadr, or
; SS$_PAGOWNVIO if the range isn't all in P0, or all in P1 below the
; command interpreter's and the mode stacks' VA$C_CLI. Uses R1.
INADR:
        .JSB_ENTRY  OUTPUT=<R2, R3>
        MOVL    8(AP), R1
        BEQL    10$
        IFNOWRT #8, (R1), 80$
10$:    MOVL    4(AP), R1
        IFNORD  #8, (R1), 80$
        MOVL    (R1), R2
        MOVL    4(R1), R3
        BICL2   #MMG$C_PAGESIZE-1, R2
        BISL2   #MMG$C_PAGESIZE-1, R3
        CMPL    R3, R2
        BLSSU   90$
        CMPL    R2, #VA$C_P0BASE
        BLSSU   90$
        CMPL    R3, #VA$C_S0BASE
        BLSSU   20$                     ; all in P0
        CMPL    R2, #VA$C_P1BASE
        BLSSU   90$
        CMPL    R3, #VA$C_CLI
        BGEQU   90$
20$:    SUBL2   R2, R3
        INCL    R3
        ASHL    #-MMG$C_VPCTX, R3, R3
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB
90$:    MOVL    #SS$_PAGOWNVIO, R0
        RSB

; RETADR: R0 = a first page, R1 = a page count, R2 = the address of a
; retadr argument, 0 if none. Stores the range's first and last bytes.
RETADR:
        .JSB_ENTRY
        TSTL    R2
        BEQL    10$
        MOVL    R0, (R2)
        ASHL    #MMG$C_VPCTX, R1, R1
        ADDL3   R0, R1, 4(R2)
        DECL    4(R2)
10$:    RSB

; $CRETVA inadr, retadr, acmode: makes the pages of a range of the
; process's P0 or P1, zeroed and writable, replacing any there.
        .ENTRY  EXE$CRETVA, ^M<R2, R3, R4, R5>
        BSBB    INADR
        BLBC    R0, 90$
        MOVL    R2, R4
        MOVL    R2, R0
        MOVL    R3, R1
        MOVL    #UW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 90$
; The process's P0 and P1 now reach these pages: its rundown deletes them.
        MOVL    SCH$GL_CURPCB, R5
        ASHL    #MMG$C_VPCTX, R3, R1
        ADDL2   R4, R1                  ; past the last
        CMPL    R4, #VA$C_S0BASE
        BGEQU   20$
        CMPL    R1, PCB$L_FREP0VA(R5)
        BLEQU   30$
        MOVL    R1, PCB$L_FREP0VA(R5)
        BRB     30$
20$:    CMPL    R4, PCB$L_FREP1VA(R5)
        BGEQU   30$
        MOVL    R4, PCB$L_FREP1VA(R5)
30$:    MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
90$:    RET

; $DELTVA inadr, retadr, acmode: deletes the pages of a range of the
; process's P0 or P1.
        .ENTRY  EXE$DELTVA, ^M<R2, R3, R4>
        BSBB    INADR
        BLBC    R0, 90$
        MOVL    R2, R4
        MOVL    R2, R0
        MOVL    R3, R1
        BSBW    MMG$DELPAG
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
90$:    RET

; $EXPREG pagcnt, retadr, acmode, region: makes pagcnt pages, zeroed and
; writable, past the end of the process's P0.
; ponytail: P0 only, whatever the region; P1 grows down with $CRETVA.
        .ENTRY  EXE$EXPREG, ^M<R2, R3, R4>
        MOVL    4(AP), R3
        BEQL    85$
        MOVL    8(AP), R2
        BEQL    10$
        IFNOWRT #8, (R2), 95$
10$:    MOVL    SCH$GL_CURPCB, R4
        CMPL    R3, #<VA$C_S0BASE-VA$C_P0BASE>/MMG$C_PAGESIZE
        BGTRU   90$
        MOVL    PCB$L_FREP0VA(R4), R0   ; the first new page
        ASHL    #MMG$C_VPCTX, R3, R1
        ADDL2   R0, R1                  ; past the last
        CMPL    R1, #VA$C_S0BASE
        BGTRU   90$
        MOVL    R1, PCB$L_FREP0VA(R4)
        MOVL    R0, R4
        MOVL    R3, R1
        MOVL    #UW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 70$
        MOVL    R4, R0
        MOVL    R3, R1
        MOVL    8(AP), R2
        BSBB    RETADR
        MOVL    #SS$_NORMAL, R0
70$:    RET
85$:    MOVL    #SS$_ILLPAGCNT, R0
        RET
90$:    MOVL    #SS$_VASFULL, R0
        RET
95$:    MOVL    #SS$_ACCVIO, R0
        RET

        .END
