        .TITLE  QIO     Channels, I/O request packets and their completion
        .IDENT  /V0.3/
;
; A process does I/O as on VMS (docs/adr/0013-qio-irps-and-drivers.md):
; $ASSIGN gives it a channel to a device, named so or by a logical name,
; and $QIO hands a request on it to the device's driver, through the
; device's UCB. The driver's FDT routine makes an I/O request packet,
; IOC$ALLOCIRP, and does the I/O at once or queues the IRP on the UCB.
; Either way it ends with IOC$REQCOM, which queues the IRP to its process
; as a kernel mode AST, IOC$POST: there the data, the I/O status block
; and the event flag are written, and the caller's AST queued. $QIOW waits
; for that.
; Each IRP of a $QIO is charged to its process's quotas, as on VMS: a
; disk's is a direct I/O, DIOCNT, the others' a buffered one, BIOCNT, and
; their size, BYTCNT; IOC$POST gives them back. A request past what is
; left waits, in resource wait (SCH$C_MWAIT), until one of the process's
; requests is done, or with $SETRWM's resource wait off fails with
; SS$_EXQUOTA.
; The drivers: the terminals', ttdriver.mar, the disks', DK$FDT in
; f11.mar, whose start I/O routine, DK$STARTIO, the file system's own
; reads and writes go through too, the network's, netdriver.mar, and the
; mailboxes', mbdriver.mar. The pseudo terminals' template, FTA0:, is
; the terminals' driver's too.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PALDEF
        $PSLDEF
        $IPLDEF
        $PCBDEF
        $STATEDEF
        $UCBDEF
        $IRPDEF
        $LNMBDEF
        $LNMDEF
        $SSDEF

        .EXTERNAL SCH$GL_CURPCB, SCH$QAST, SCH$ASTBITS, SCH$GETEFC, SCH$POSTEF
        .EXTERNAL SCH$WAIT, SCH$GL_PCBVEC, SCH$GL_MAXPIX
        .EXTERNAL EXE$PROBER_DSC, EXE$CLREF, EXE$WAITFR
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ
        .EXTERNAL LNM$TRNLOG, DK$FDT, DK$STARTIO, TT$FINDUNIT, TT$CANCEL, FT$FDT
        .EXTERNAL NET$FDT, NET$CANCEL, NET$FINDUNIT, MB$CANCEL, MB$FINDUNIT
        .EXTERNAL F11$AB_DKA0, F11$AB_DKB0, F11$AB_MDA0, XQP$GL_IRP, XQP$PERFORM

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
IOC$AB_UCB::                            ; the devices' UCBs, which $ASSIGN looks through
IOC$AB_DKA0::                           ; the system disk's
        .ADDRESS IOC$AB_DKA0, IOC$AB_DKA0, DK$FDT, F11$AB_DKA0
        .ASCII  /DKA0/
        .ADDRESS DK$STARTIO
        .LONG   0
IOC$AB_DKB0::                           ; the data disk's
        .ADDRESS IOC$AB_DKB0, IOC$AB_DKB0, DK$FDT, F11$AB_DKB0
        .ASCII  /DKB0/
        .ADDRESS DK$STARTIO
        .LONG   0
IOC$AB_MDA0::                           ; the ramdisk's
        .ADDRESS IOC$AB_MDA0, IOC$AB_MDA0, DK$FDT, F11$AB_MDA0
        .ASCII  /MDA0/
        .ADDRESS DK$STARTIO
        .LONG   0
IOC$AB_BGA0::                           ; the network's template device (netdriver.mar)
        .ADDRESS IOC$AB_BGA0, IOC$AB_BGA0, NET$FDT
        .LONG   0
        .ASCII  /BGA0/
        .LONG   0, 0
IOC$AB_FTA0::                           ; the pseudo terminals' template device (ttdriver.mar)
        .ADDRESS IOC$AB_FTA0, IOC$AB_FTA0, FT$FDT
        .LONG   0
        .ASCII  /FTA0/
        .LONG   0, 0
IOC$A_UCBEND::                          ; past the last UCB
RWAITQ: .ADDRESS RWAITQ, RWAITQ         ; the processes waiting for I/O quota, SCH$C_MWAIT

        .PSECT  $CODE$

; $ASSIGN devnam, chan, acmode, mbxnam: assigns a channel to the device
; devnam names, and puts its number in chan, a word. devnam is translated
; as a logical name, without its colon, in LNM$FILE_DEV, and what it
; translates to, up to LNM$C_MAXDEPTH times, until a name starts with an
; underscore, which is dropped, or doesn't translate. That must be a
; device, DKA0, DKB0, MDA0, BGA0, FTA0, a terminal, OPA0, TNAn or FTAn,
; a network unit, BGnn, or a mailbox, MBnn, with a colon or without.
; A channel the command interpreter assigns, in supervisor mode, is one
; of PCB$L_CLICHANS, which outlive the image, as on VMS, where image
; rundown deassigns only user mode's: DCL's at the CTRL/Y prompt too.
        .ENTRY  EXE$ASSIGN, ^M<R2, R3, R4, R5, R6, R7>
        MOVL    4(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        IFNOWRT #2, @8(AP), 85$
        MOVZWL  (R1), R2
        MOVL    4(R1), R3
        DSBINT  #IPL$_SYNCH             ; the names it translates to stay
        BSBW    IOC$TRNDEVNAM
        MOVL    #SS$_NOSUCHDEV, R0
        CMPL    R2, #4
        BEQL    10$
        CMPL    R2, #5
        BNEQ    80$
        CMPB    4(R3), #^A/:/
        BNEQ    80$
10$:    MOVAB   IOC$AB_UCB, R5
15$:    CMPL    (R3), UCB$T_NAME(R5)
        BEQL    18$
        ADDL2   #UCB$K_LENGTH, R5
        MOVAB   IOC$A_UCBEND, R1
        CMPL    R5, R1
        BLSSU   15$
        BSBW    TT$FINDUNIT             ; a terminal, OPA0 or TNAn?
        TSTL    R5
        BNEQ    18$
        BSBW    NET$FINDUNIT            ; a network unit, BGnn?
        TSTL    R5
        BNEQ    18$
        BSBW    MB$FINDUNIT             ; a mailbox, MBnn?
        TSTL    R5
        BEQL    80$
18$:    MOVL    SCH$GL_CURPCB, R4
        BSBW    IOC$ASSIGN
        BLBC    R0, 80$
        MOVW    R1, @8(AP)
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_PRVMOD, #2, R0, R0
        CMPL    R0, #PSL$C_SUPER
        BNEQ    20$
        BBSS    R1, PCB$L_CLICHANS(R4), 20$
20$:    MOVL    #SS$_NORMAL, R0
80$:    ENBINT
        RET
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

; IOC$ASSIGN: R4 = the current PCB, R5 = a device's UCB. Assigns the
; device a free channel: R1 = its number, R0 = SS$_NORMAL, or
; SS$_NOIOCHAN with none free. A cloned unit, a network unit or a
; mailbox, not one of IOC$AB_UCB's, counts one more channel. IPL$_SYNCH.
IOC$ASSIGN::
        .JSB_ENTRY
        MOVL    #1, R1
10$:    BBCS    R1, PCB$L_CHANS(R4), 20$
        AOBLEQ  #PCB$C_MAXCHAN, R1, 10$
        MOVL    #SS$_NOIOCHAN, R0
        RSB
20$:    MOVL    R5, PCB$AL_CCB(R4)[R1]
        MOVAB   IOC$AB_UCB, R0
        CMPL    R5, R0
        BLSSU   30$
        MOVAB   IOC$A_UCBEND, R0
        CMPL    R5, R0
        BLSSU   40$
30$:    INCL    UCB$L_REFC(R5)
40$:    MOVL    #SS$_NORMAL, R0
        RSB

; IOC$TRNDEVNAM: R2 = a device name's length, R3 = its address.
; Translates it as $ASSIGN does: as a logical name, without its colon, in
; LNM$FILE_DEV, and what it translates to, up to LNM$C_MAXDEPTH times,
; until a name starts with an underscore, which is dropped, or doesn't
; translate. R2 and R3 = the name it ends with, in the logical name's
; block if it is an equivalence. IPL$_SYNCH, which keeps that. Uses R0,
; R1, R5-R7.
IOC$TRNDEVNAM::
        .JSB_ENTRY  OUTPUT=<R2, R3>, SCRATCH=<R5, R6, R7>
        MOVL    #LNM$C_MAXDEPTH, R5
2$:     TSTL    R2
        BEQL    8$
        CMPB    (R3), #^A/_/            ; a device's own name
        BNEQ    4$
        INCL    R3
        DECL    R2
        BRB     8$
4$:     MOVL    R3, R6
        MOVL    R2, R7
        ADDL3   R2, R3, R0
        CMPB    -1(R0), #^A/:/
        BNEQ    6$
        DECL    R7
6$:     PUSHR   #^M<R2, R3>
        BSBW    LNM$TRNLOG
        POPR    #^M<R2, R3>
        TSTL    R1
        BEQL    8$
        MOVZBL  LNMB$T_NAME(R1), R0
        MOVAB   LNMB$T_NAME+1(R1)[R0], R3
        MOVZBL  (R3)+, R2
        SOBGTR  R5, 2$
8$:     RSB

; $DASSGN chan: deassigns a channel, and cancels its I/O (IOC$CANCEL).
        .ENTRY  EXE$DASSGN, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVZWL  4(AP), R5
        BEQL    80$
        CMPL    R5, #PCB$C_MAXCHAN
        BGTRU   80$
        BBC     R5, PCB$L_CHANS(R4), 80$
        DSBINT  #IPL$_SYNCH
        ASHL    R5, #1, R0
        CLRL    R1
        BSBW    IOC$CANCEL
        BBCC    R5, PCB$L_CHANS(R4), 10$
10$:    BBCC    R5, PCB$L_CLICHANS(R4), 20$
20$:    ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
80$:    MOVL    #SS$_IVCHAN, R0
        RET

; $CANCEL chan: cancels the channel's I/O (IOC$CANCEL): the requests its
; device's driver holds end with SS$_ABORT, and its CTRL/C and CTRL/Y ASTs
; are disabled. Those done already are left as they are.
        .ENTRY  EXE$CANCEL, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVZWL  4(AP), R5
        BEQL    80$
        CMPL    R5, #PCB$C_MAXCHAN
        BGTRU   80$
        BBC     R5, PCB$L_CHANS(R4), 80$
        DSBINT  #IPL$_SYNCH
        ASHL    R5, #1, R0
        MOVZWL  #SS$_ABORT, R1
        BSBW    IOC$CANCEL
        ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
80$:    MOVL    #SS$_IVCHAN, R0
        RET

; $QIO efn, chan, func, iosb, astadr, astprm, p1, p2, p3, p4, p5, p6:
; requests I/O on the channel's device: clears event flag efn and calls
; the device's driver, whose FDT routine checks func and the parameters,
; which it may fail, and does the I/O or queues it. Once it is done,
; IOC$POST writes in iosb the status and the byte count, and what the
; driver puts in the second longword, sets the flag and calls astadr with
; astprm in the caller's mode. A terminal's driver (TT$FDT) writes p2
; bytes at p1, or reads a line into them, after the prompt in p5 and p6
; for IO$_READPROMPT; the disks' (DK$FDT) reads or writes them at LBN p3,
; and for IO$_ACCESS and IO$_MODIFY makes an IRP that XQP$PERFORM does
; here, once IPL is back where it was, as VMS's XQP does in the process.
; The FDT routines read the arguments through AP, so it homes them all.
; A request IOC$ALLOCIRP finds past the process's quotas waits for them
; in resource wait, SCH$C_MWAIT, until an AST, its I/O done, ends the
; wait, and then the FDT routine is called again: it must change nothing
; before its IOC$ALLOCIRP. SS$_EXQUOTA with $SETRWM's resource wait off.
EXE$QIO::
        .CALL_ENTRY HOME_ARGS=TRUE, MAX_ARGS=12
        MOVL    SCH$GL_CURPCB, R4
        MOVZWL  8(AP), R0
        BEQL    75$
        CMPL    R0, #PCB$C_MAXCHAN
        BGTRU   75$
        BBC     R0, PCB$L_CHANS(R4), 75$
        MOVL    16(AP), R0
        BEQL    10$
        IFNOWRT #8, (R0), 85$
10$:    PUSHL   4(AP)
        CALLS   #1, G^EXE$CLREF
        BLBC    R0, 90$
        DSBINT  #IPL$_SYNCH
20$:    MOVL    SCH$GL_CURPCB, R4
        MOVZWL  8(AP), R0
        BBC     R0, PCB$L_CHANS(R4), 70$        ; an AST in the wait may deassign it
        MOVL    PCB$AL_CCB(R4)[R0], R5
        MOVL    UCB$L_FDT(R5), R0
        JSB     (R0)
        MOVL    SCH$GL_CURPCB, R4
        BBCC    #PCB$V_QUOWAIT, PCB$L_STS(R4), 30$
        BLBS    R0, 30$
        MOVL    #SCH$C_MWAIT, PCB$L_STATE(R4)
        MOVAQ   RWAITQ, R0
        BSBW    SCH$WAIT
        BRB     20$
30$:    MOVL    XQP$GL_IRP, R3          ; the file system's function: do it here
        BEQL    35$
        CLRL    XQP$GL_IRP
        ENBINT
        BSBW    XQP$PERFORM
        MOVL    #SS$_NORMAL, R0
        RET
35$:    ENBINT
        RET
70$:    ENBINT
75$:    MOVL    #SS$_IVCHAN, R0
        RET
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

; $QIOW efn, chan, func, iosb, astadr, astprm, p1, p2, p3, p4, p5, p6:
; $QIO, then waits for the event flag, and while iosb's status is still 0,
; which says the flag was set for something else, clears it and waits
; again, as VMS's $SYNCH. It passes its argument list on, all 12.
EXE$QIOW::
        .CALL_ENTRY MAX_ARGS=12
        CALLG   (AP), G^EXE$QIO
        BLBC    R0, 90$
10$:    PUSHL   4(AP)
        CALLS   #1, G^EXE$WAITFR
        MOVL    16(AP), R0
        BEQL    80$
        DSBINT  #IPL$_ASTDEL            ; IOC$POST, which sets both, waits
        TSTW    (R0)
        BNEQ    20$
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R3
        BSBW    SCH$GETEFC
        BLBC    R0, 20$
        BBCC    R2, (R1), 20$
20$:    ENBINT
        TSTW    @16(AP)
        BEQL    10$
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; IOC$ALLOCIRP: R1 = how many bytes the driver needs past the packet, R4 =
; the current PCB, R5 = a UCB, AP = $QIO's arguments. Makes an IRP for the
; request and charges it to the process: on a disk a direct I/O, DIOCNT,
; else a buffered one, BIOCNT, and its size, BYTCNT. R3 = it, R0 =
; SS$_NORMAL, or SS$_INSFMEM, or SS$_EXQUOTA if it would be 64 KB or more
; or over BYTLM, or the process has no I/O of the kind left. Then with
; resource wait on, as it is unless $SETRWM turned it off, it sets
; PCB$V_QUOWAIT, and $QIO waits for the quota and calls the FDT routine
; again. Uses R1 and R2.
IOC$ALLOCIRP::
        .JSB_ENTRY  INPUT=<AP>, OUTPUT=<R3>, SCRATCH=<R2>
        ADDL2   #IRP$K_LENGTH, R1
        CMPL    R1, #^XFFF0
        BGTRU   80$
        MOVAB   G^DK$FDT, R0
        CMPL    UCB$L_FDT(R5), R0
        BNEQ    10$
        MOVL    #IRP$K_DIO, R2          ; a disk's
        TSTW    PCB$W_DIOLM(R4)
        BLEQ    80$
        TSTW    PCB$W_DIOCNT(R4)
        BLEQ    70$
        BRW     ALLOC
10$:    MOVL    #IRP$K_BIO, R2
        TSTW    PCB$W_BIOLM(R4)
        BLEQ    80$
        CMPL    R1, PCB$L_BYTLM(R4)
        BGTR    80$
        TSTW    PCB$W_BIOCNT(R4)
        BLEQ    70$
        CMPL    R1, PCB$L_BYTCNT(R4)
        BGTR    70$
        BRW     ALLOC
70$:    BBS     #PCB$V_SSRWAIT, PCB$L_STS(R4), 80$
        BBSS    #PCB$V_QUOWAIT, PCB$L_STS(R4), 80$
80$:    MOVL    #SS$_EXQUOTA, R0
        RSB

; IOC$ALLOCDONE: IOC$ALLOCIRP's IRP for a request its FDT routine has done
; already, or an AST's packet, which charges nothing: what was done can't
; wait for quota and be done again. R1, R4, R5, AP and the results as
; IOC$ALLOCIRP has them, but SS$_EXQUOTA only for 64 KB. Uses R1 and R2.
; ponytail: VMS charges a request before its FDT routine, which waits for
; BIOCNT before the console's writes and SET MODE too.
IOC$ALLOCDONE::
        .JSB_ENTRY  INPUT=<AP>, OUTPUT=<R3>, SCRATCH=<R2>
        ADDL2   #IRP$K_LENGTH, R1
        CMPL    R1, #^XFFF0
        BGTRU   80$
        CLRL    R2
        BRW     ALLOC
80$:    MOVL    #SS$_EXQUOTA, R0
        RSB

; ALLOC: IOC$ALLOCIRP's and IOC$ALLOCDONE's work once the quotas are
; checked: R1 = the IRP's size, R2 = what to charge it to, an IRP$K_ value
; or 0, R4, R5 and AP as theirs have them. R3 = it, R0 = SS$_NORMAL or
; SS$_INSFMEM. Uses R1 and R2.
ALLOC:
        .JSB_ENTRY  INPUT=<AP>, OUTPUT=<R3>, SCRATCH=<R2>
        PUSHL   R2
        BSBW    EXE$ALONONPAGED
        BLBS    R0, 10$
        ADDL2   #4, SP
        RSB
10$:    MOVL    R2, R3
        MOVL    (SP)+, R2
        MOVB    R2, IRP$B_QUOTA(R3)
        CLRL    IRP$L_BOFF(R3)
        CMPL    R2, #IRP$K_DIO
        BNEQ    20$
        DECW    PCB$W_DIOCNT(R4)
        INCL    PCB$L_DIRIO(R4)
        BRB     30$
20$:    CMPL    R2, #IRP$K_BIO
        BNEQ    30$
        DECW    PCB$W_BIOCNT(R4)
        SUBL2   R1, PCB$L_BYTCNT(R4)
        MOVL    R1, IRP$L_BOFF(R3)
        INCL    PCB$L_BUFIO(R4)
30$:
        MOVW    R1, IRP$W_SIZE(R3)
        MOVB    #DYN$C_IRP, IRP$B_TYPE(R3)
        MOVL    PCB$L_PID(R4), IRP$L_PID(R3)
        MOVL    20(AP), IRP$L_AST(R3)
        MOVL    24(AP), IRP$L_ASTPRM(R3)
        CLRL    IRP$L_KAST(R3)
        MOVL    R5, IRP$L_UCB(R3)
        MOVL    12(AP), IRP$L_FUNC(R3)
        MOVL    4(AP), IRP$L_EFN(R3)
        MOVL    16(AP), IRP$L_IOSB(R3)
        MOVW    8(AP), IRP$W_CHAN(R3)
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_PRVMOD, #2, R0, R0
        MOVB    R0, IRP$B_PMOD(R3)
        CLRL    IRP$L_STS(R3)
        CLRL    IRP$L_IOST1(R3)
        CLRL    IRP$L_IOST2(R3)
        MOVL    28(AP), IRP$L_BUFADR(R3)
        MOVL    32(AP), IRP$L_BCNT(R3)
        CLRL    IRP$L_PROMPT(R3)
        CLRL    IRP$L_POST(R3)
        MOVL    #SS$_NORMAL, R0
        RSB

; IOC$RETQUOTA: R0 = an IRP. Gives back what IOC$ALLOCIRP charged it to its
; process, if it is still there, and marks it charged no more: IOC$POST
; does, and whoever frees one that isn't posted. IPL$_SYNCH. Keeps every
; register.
IOC$RETQUOTA::
        .JSB_ENTRY
        TSTB    IRP$B_QUOTA(R0)
        BEQL    90$
        PUSHL   R1
        MOVZWL  IRP$L_PID(R0), R1       ; its process, by index
        CMPL    R1, SCH$GL_MAXPIX
        BGEQU   80$
        MOVL    @SCH$GL_PCBVEC[R1], R1
        BEQL    80$
        CMPL    PCB$L_PID(R1), IRP$L_PID(R0)
        BNEQ    80$
        CMPB    IRP$B_QUOTA(R0), #IRP$K_DIO
        BNEQ    10$
        INCW    PCB$W_DIOCNT(R1)
        BRB     80$
10$:    INCW    PCB$W_BIOCNT(R1)
        ADDL2   IRP$L_BOFF(R0), PCB$L_BYTCNT(R1)
80$:    CLRB    IRP$B_QUOTA(R0)
        MOVL    (SP)+, R1
90$:    RSB

; $SETRWM watflg: turns resource wait on, for watflg's low bit clear, or
; off: a request past the process's quotas then fails with SS$_EXQUOTA
; instead of waiting. SS$_WASSET if it was off, else SS$_WASCLR.
        .ENTRY  EXE$SETRWM, ^M<R4>
        MOVL    SCH$GL_CURPCB, R4
        DSBINT  #IPL$_SYNCH
        MOVL    #SS$_WASCLR, R0
        BBCC    #PCB$V_SSRWAIT, PCB$L_STS(R4), 10$
        MOVL    #SS$_WASSET, R0
10$:    BLBC    4(AP), 20$
        BBSS    #PCB$V_SSRWAIT, PCB$L_STS(R4), 20$
20$:    ENBINT
        RET

; IOC$REQCOM: R3 = an IRP, done, R0 = its IOSB's first longword, a status
; and a byte count in the high word, R1 = its second. Queues it to its
; process as a kernel mode AST, IOC$POST, unless it is the file system's,
; with no process, which finds the status in the IRP. R0 = SS$_NORMAL, for
; an FDT routine to return. IPL$_SYNCH. Uses R1-R3.
IOC$REQCOM::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    R0, IRP$L_IOST1(R3)
        MOVL    R1, IRP$L_IOST2(R3)
        TSTL    IRP$L_PID(R3)
        BEQL    10$
        CLRB    IRP$B_RMOD(R3)
        MOVAB   IOC$POST, IRP$L_KAST(R3)
        PUSHL   R5
        MOVL    R3, R5
        BSBW    SCH$QAST
        MOVL    (SP)+, R5
10$:    MOVL    #SS$_NORMAL, R0
        RSB

; IOC$POST: a done IRP's kernel mode AST, in its process. R4 = the PCB, R5
; = the IRP. Calls its driver's post routine, IRP$L_POST, if it has one,
; which writes what else the request returns where the caller asked, then
; copies a buffered read's data to the caller's buffer, writes the IOSB
; and sets the event flag, then queues the IRP as an ACB for the caller's
; AST, in the caller's mode, or frees it if there is none. IPL$_SYNCH.
; Gives back the quota the request took first. Uses R0-R3, R5 and R6.
; ponytail: the buffer and the IOSB aren't probed again; VMS's are, or
; locked.
IOC$POST::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R6>
        MOVL    R5, R0
        BSBW    IOC$RETQUOTA
        MOVL    R5, R6
        MOVL    IRP$L_POST(R6), R0
        BEQL    5$
        PUSHL   R4
        JSB     (R0)
        MOVL    (SP)+, R4
5$:     BBC     #IRP$V_BUFIO, IRP$L_STS(R6), 10$
        EXTZV   #16, #16, IRP$L_IOST1(R6), R0
        ADDL3   #IRP$K_LENGTH, IRP$L_PROMPT(R6), R1
        ADDL2   R6, R1
        PUSHL   R4
        MOVC3   R0, (R1), @IRP$L_BUFADR(R6)
        MOVL    (SP)+, R4
10$:    MOVL    IRP$L_IOSB(R6), R0
        BEQL    20$
        MOVL    IRP$L_IOST1(R6), (R0)
        MOVL    IRP$L_IOST2(R6), 4(R0)
20$:    MOVL    IRP$L_EFN(R6), R3
        BSBW    SCH$GETEFC
        BLBC    R0, 30$
        BBSS    R2, (R1), 25$
25$:    BSBW    SCH$POSTEF
30$:    MOVL    R6, R5
        TSTL    IRP$L_AST(R5)
        BEQL    40$
        MOVB    IRP$B_PMOD(R5), IRP$B_RMOD(R5)
        CLRL    IRP$L_KAST(R5)
        BRW     SCH$QAST
40$:    MOVL    R5, R0
        MOVZWL  IRP$W_SIZE(R5), R1
        BRW     EXE$DEANONPGDSIZ

; IOC$CANCEL: R4 = the current PCB, R0 = a mask of its channels, R1 = a
; status, or 0. Disables their CTRL/C and CTRL/Y ASTs, and ends the
; requests the devices' UCBs hold for them: with R1 as their status, for
; $CANCEL, or, for 0, by freeing their IRPs unfinished, and those on its
; AST queue too, done but not yet posted, or posted with an AST: the image
; they were for is going, or the channel. The terminals' are TT$CANCEL's,
; which starts the reads after those it held. IPL$_SYNCH. Uses R0-R3.
; ponytail: VMS waits for rundown's to end, for drivers that can't stop
; at once.
IOC$CANCEL::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHR   #^M<R5, R6, R7>
        MOVL    R0, R6
        MOVL    R1, R7
        BSBW    NET$CANCEL              ; the requests on the port
        BSBW    MB$CANCEL               ; and on the mailboxes
        MOVAB   IOC$AB_UCB, R5
10$:    BSBB    IOC$CANCELQ
        ADDL2   #UCB$K_LENGTH, R5
        MOVAB   IOC$A_UCBEND, R0
        CMPL    R5, R0
        BLSSU   10$
        BSBW    TT$CANCEL
        TSTL    R7
        BNEQ    20$
        MOVAQ   PCB$Q_ASTQFL(R4), R5
        BSBB    IOC$CANCELQ
        BSBW    SCH$ASTBITS
20$:    POPR    #^M<R5, R6, R7>
        RSB

; IOC$CANCELQ: R5 = a queue of IRPs, or ACBs, R4 = a PCB, R6 = a mask of
; its channels, R7 = a status, or 0. Takes the IRPs there for those
; channels off it and completes them with that status, or frees them for
; 0. IPL$_SYNCH. Uses R0-R3.
IOC$CANCELQ::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    (R5), R3
10$:    CMPL    R3, R5
        BEQL    90$
        MOVL    R3, R0
        MOVL    (R3), R3                ; the next, before this one goes
        CMPB    IRP$B_TYPE(R0), #DYN$C_IRP
        BNEQ    10$
        CMPL    IRP$L_PID(R0), PCB$L_PID(R4)
        BNEQ    10$
        MOVZWL  IRP$W_CHAN(R0), R1
        BBC     R1, R6, 10$
        REMQUE  (R0), R0
        TSTL    R7
        BNEQ    20$
        BSBW    IOC$RETQUOTA
        MOVZWL  IRP$W_SIZE(R0), R1
        BSBW    EXE$DEANONPGDSIZ
        BRB     10$
20$:    PUSHL   R3
        MOVL    R0, R3
        MOVL    R7, R0
        CLRL    R1
        BSBW    IOC$REQCOM
        MOVL    (SP)+, R3
        BRB     10$
90$:    RSB

        .END
