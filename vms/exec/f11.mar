        .TITLE  F11     Files-11 ODS-2 volumes: mounting them, reading and writing blocks
        .IDENT  /V0.2/
;
; Each disk has a VCB: DKA0:, the system disk, a Files-11 ODS-2 volume
; (crosstools/ods/docs/) that the PAL reads a block at a time with READLBLK; DKB0:,
; the data disk, which the PAL also writes, with WRITELBLK; and MDA0:,
; the ramdisk (mddriver.mar). The file system can write the last two.
; DK$FDT is their driver, for $QIO's reads and writes by LBN, and its
; start I/O routine, DK$STARTIO, does the file system's too: as VMS's XQP,
; FIL$READLBLK and FIL$WRITELBLK hand the driver an IRP, through the
; disk's UCB.
; FIL$MOUNT mounts a volume: it reads the home block and keeps the index
; file's header, through which every other file's header is found;
; $DISMOU forgets it. The
; rest reads what VMS's XQP reads: a file's header by its number, its
; blocks through the header's map, and a directory's records, with
; wildcards. f11wrt.mar writes them. FIL$CHKPRO checks a process's
; access to a file or a volume by its owner and protection, as the XQP
; does. RMS (rms.mar), the image activator
; and the services here call them holding the file system's lock,
; FIL$LOCK, as the XQP holds its volume's: it keeps their buffers,
; F11$AB_IRP, and F11$GL_VCB, the volume they work on, to one process at a
; time, at IPL$_ASTDEL, where the others still run. Only the driver runs at
; IPL$_SYNCH.
; ponytail: no extension headers, so a file's map is what its one header
; holds; one lock for every volume, where the XQP $ENQs one per volume and
; one per file; DKA0:'s and DKB0:'s I/O waits for the device, at
; IPL$_SYNCH, and the file system waits for none: its IRP is done when the
; driver returns. A driver that queues it needs FIL$READLBLK to wait for
; it, as the lock lets it.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $PALDEF
        $IPLDEF
        $PCBDEF
        $PRVDEF
        $STATEDEF
        $SSDEF
        $RMSDEF
        $VCBDEF
        $MNTDEF
        $UCBDEF
        $IRPDEF
        $IODEF
        $ARMDEF

        .EXTERNAL EXE$OUTZSTRING, EXE$OUTCSTRING, EXE$OUTCRLF
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ, RMS$LOCATE, MD$IO
        .EXTERNAL IOC$ALLOCIRP, IOC$REQCOM, IOC$AB_DKA0, IOC$AB_DKB0, IOC$AB_MDA0
        .EXTERNAL EXE$PROBER_DSC, RMS$VOLIDLE, SCH$GL_CURPCB, SCH$WAIT, SCH$WAKEPCB

BLOCK = 512
MAXREAD = 127                           ; blocks a READLBLK reads, below 64 KB
MAXHDR = 16                             ; an image header's blocks, at most
BOUNCE = 8                              ; the blocks FIL$READIMG reads at a time
EIHD$L_HDRBLKCNT = 76
MFD = 4                                 ; the MFD's file number
BITMAP = 2                              ; BITMAP.SYS's
; The home block.
HM2$W_CLUSTER = 14
HM2$W_IBMAPVBN = 22
HM2$L_IBMAPLBN = 24
HM2$W_IBMAPSIZE = 32
HM2$L_VOLOWNER = 44
HM2$W_PROTECT = 52
HM2$T_VOLNAME = 472
HM2$T_FORMAT = 496
; A file header.
FH2$B_MPOFFSET = 1
FH2$W_FID = 8
FH2$B_FID_NMX = 13
FH2$W_RECATTR = 20
FH2$L_FILECHAR = 52
FH2$B_MAP_INUSE = 58
FH2$L_FILEOWNER = 60
FH2$W_FILEPROT = 64
FH2$W_CHECKSUM = 510
FCH$V_DIRECTORY = 13
; Its record attributes, at FH2$W_RECATTR.
FAT$B_RTYPE = 0
FAT$B_RATTRIB = 1
FAT$W_RSIZE = 2
FAT$L_HIBLK = 4                         ; high word first
FAT$L_EFBLK = 8                         ; high word first
FAT$W_FFBYTE = 12
FAT$B_VFCSIZE = 15
FAT$W_MAXREC = 16
MAXSYSGROUP = 8                         ; UIC groups up to this one are the system's

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
F11$GL_VCB::                            ; the volume the routines here work on
        .ADDRESS F11$AB_DKA0
F11$AB_DKA0::                           ; DKA0:'s VCB, the system disk's
        .LONG   0, 0, 0, 0              ; STATUS, HDRVBN, IBMAPLBN, SBMAPLBN
        .ASCII  "DKA0:"
        .BLKB   VCB$L_UCB-VCB$T_DEVNAM-5
        .ADDRESS IOC$AB_DKA0
        .LONG   0, 0, 0                 ; OWNER, PROT, SBMAPBLKS
F11$AB_DKB0::                           ; DKB0:'s, the data disk's
        .LONG   1@VCB$V_WRITE, 0, 0, 0
        .ASCII  "DKB0:"
        .BYTE   1                       ; VCB$B_UNIT
        .BLKB   VCB$L_UCB-VCB$T_DEVNAM-6
        .ADDRESS IOC$AB_DKB0
        .LONG   0, 0, 0                 ; OWNER, PROT, SBMAPBLKS
F11$AB_MDA0::                           ; MDA0:'s, the ramdisk's
        .LONG   <1@VCB$V_WRITE>!<1@VCB$V_RAMDISK>, 0, 0, 0
        .ASCII  "MDA0:"
        .BLKB   VCB$L_UCB-VCB$T_DEVNAM-5
        .ADDRESS IOC$AB_MDA0
        .LONG   0, 0, 0                 ; OWNER, PROT, SBMAPBLKS
F11$A_VCBEND::                          ; past the last VCB
F11$AB_DIRBLK::                         ; the directory block FIL$SEARCHDIR reads
        .BLKB   BLOCK
F11$AB_FILHDR::                         ; the header FIL$OPENFILE reads
        .BLKB   BLOCK
F11$GW_FID::                            ; the file ID FIL$SEARCHDIR found
        .BLKW   3
        .ALIGN  LONG
F11$AB_IRP::                            ; the IRP FIL$READLBLK and FIL$WRITELBLK hand the driver, with no process
        .BLKB   IRP$K_LENGTH
OWNER:  .LONG   0                       ; the PCB holding the file system's lock, or 0
LOCKIPL:                                ; the IPL it had
        .LONG   0
LOCKWQ: .ADDRESS LOCKWQ, LOCKWQ         ; the processes waiting for it, SCH$C_MWAIT
F11$T_FORMAT:
        .ASCII  "DECFILE11B"
MOUNTED:
        .ASCIZ  "%MOUNT-I-MOUNTED, "
ONDEV:  .ASCIZ  " mounted on _"
DEVNAM: .BLKB   6                       ; the device's, .ASCIZ
IMAGEDEF:                               ; where images are
        .ASCIC  "SYS$SYSTEM:"
SHAREDEF:                               ; and shareable images
        .ASCIC  "SYS$SHARE:.EXE"
LABEL:  .BLKB   13                      ; the label $MOUNT asks for, .ASCIC
        .ALIGN  LONG
MNTSET: .LONG   0                       ; bit 0: $MOUNT has MNTOWNER, bit 1 MNTPROT
MNTOWNER:                               ; the owner and protection it gives the volume
        .LONG   0
MNTPROT:
        .WORD   0

        .PSECT  $CODE$

; FIL$LOCK: takes the file system's lock, waiting while another process
; holds it, and raises IPL to IPL$_ASTDEL, unless it is above, so no
; kernel mode AST deletes the process while it holds it. FIL$UNLOCK gives
; it back. Not twice. Keeps every register.
FIL$LOCK::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R4>
        MFPR    #PR$_IPL, R1
        SETIPL  #IPL$_SYNCH
        MOVL    SCH$GL_CURPCB, R4
10$:    TSTL    OWNER
        BEQL    20$
        MOVL    #SCH$C_MWAIT, PCB$L_STATE(R4)
        MOVAQ   LOCKWQ, R0
        BSBW    SCH$WAIT
        BRB     10$
20$:    MOVL    R4, OWNER
        MOVL    R1, LOCKIPL
        CMPL    R1, #IPL$_ASTDEL
        BGEQ    30$
        MOVL    #IPL$_ASTDEL, R1
30$:    MTPR    R1, #PR$_IPL
        POPR    #^M<R0, R1, R4>
        RSB

; FIL$UNLOCK: gives back the lock FIL$LOCK took, ends the waits for it,
; each waiter trying again, and puts back the IPL FIL$LOCK's caller had.
; Keeps every register.
FIL$UNLOCK::
        .JSB_ENTRY
        PUSHR   #^M<R0, R1, R4>
        MOVL    LOCKIPL, R1
        SETIPL  #IPL$_SYNCH
        CLRL    OWNER
        MOVAQ   LOCKWQ, R0
10$:    MOVL    (R0), R4
        CMPL    R4, R0
        BEQL    20$
        BSBW    SCH$WAKEPCB
        BRB     10$
20$:    MTPR    R1, #PR$_IPL
        POPR    #^M<R0, R1, R4>
        RSB

; FIL$READLBLK: R0 = a buffer, R1 = a block count, R2 = an LBN. Reads the
; blocks from F11$GL_VCB's disk, with an IO$_READLBLK in F11$AB_IRP to its
; driver, at IPL$_SYNCH. R0 = SS$_NORMAL, or the device's error. Holding
; FIL$LOCK. Uses R1.
FIL$READLBLK::
        .JSB_ENTRY
        PUSHL   #IO$_READLBLK
        BRB     LBLK

; FIL$WRITELBLK: R0 = a buffer, R1 = a block count, R2 = an LBN. Writes
; the blocks to F11$GL_VCB's disk, with an IO$_WRITELBLK in F11$AB_IRP to
; its driver. R0 = SS$_NORMAL, SS$_WRITLCK if the disk is read only, or
; the device's error. Holding FIL$LOCK. Uses R1.
FIL$WRITELBLK::
        .JSB_ENTRY
        PUSHL   #IO$_WRITELBLK
LBLK:   .GLOBAL_LABEL                   ; FIL$READLBLK's too
        PUSHR   #^M<R2, R3, R4, R5>
        MOVAB   F11$AB_IRP, R3
        MOVL    16(SP), IRP$L_FUNC(R3)
        MOVL    R0, IRP$L_BUFADR(R3)
        MULL3   #BLOCK, R1, IRP$L_BCNT(R3)
        MOVL    R2, IRP$L_MEDIA(R3)
        MOVL    F11$GL_VCB, R5
        MOVL    VCB$L_UCB(R5), R5
        MOVL    R5, IRP$L_UCB(R3)
        MOVL    UCB$L_START(R5), R0
        DSBINT  #IPL$_SYNCH
        JSB     (R0)
        ENBINT
        MOVZWL  F11$AB_IRP+IRP$L_IOST1, R0
        POPR    #^M<R2, R3, R4, R5>
        TSTL    (SP)+
        RSB

; DISKIO: R0 = a buffer, R1 = a byte count, R2 = an LBN, R3 = 0 to read
; the blocks there into the buffer, 1 to write it there, R4 = the disk's
; VCB. R0 = SS$_NORMAL, SS$_WRITLCK if the disk is read only, or the
; device's error. Uses R1, R3 and R4.
DISKIO:
        .JSB_ENTRY  SCRATCH=<R3, R4>
        BLBC    R3, 10$
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R4), 30$
10$:    BBS     #VCB$V_RAMDISK, VCB$L_STATUS(R4), 20$
        MOVZBL  VCB$B_UNIT(R4), R4
        BLBS    R3, 15$
        MOVL    R4, R3
        CALL_PAL #PAL$_READLBLK
        RSB
15$:    MOVL    R4, R3
        CALL_PAL #PAL$_WRITELBLK
        RSB
20$:    BSBW    MD$IO
        RSB
30$:    MOVL    #SS$_WRITLCK, R0
        RSB

; DK$FDT: the disks' FDT routine, which $QIO calls. R4 = the current PCB,
; R5 = the disk's UCB, AP = $QIO's arguments. For IO$_READLBLK and
; IO$_READPBLK, which read the blocks from LBN p3 into the p2 bytes at
; p1, and IO$_WRITELBLK and IO$_WRITEPBLK, which write those bytes there,
; checks the buffer and makes the IRP, which DK$STARTIO does at once.
; The logical functions take LOG_IO or PHY_IO, the physical ones PHY_IO,
; as on VMS. R0 = SS$_NORMAL, SS$_ILLIOFUNC, SS$_NOPRIV, SS$_ACCVIO,
; SS$_BADPARAM, or IOC$ALLOCIRP's failure. IPL$_SYNCH. Uses R0-R3.
DK$FDT::
        .JSB_ENTRY  INPUT=<AP>, SCRATCH=<R2, R3, R4>
        BICL3   #^C63, 12(AP), R0       ; the function, without modifiers
        MOVL    28(AP), R2
        MOVL    32(AP), R3
        CMPL    R3, #65535
        BGTRU   87$
        CMPL    R0, #IO$_READLBLK
        BEQL    3$
        CMPL    R0, #IO$_WRITELBLK
        BEQL    3$
        CMPL    R0, #IO$_READPBLK
        BEQL    5$
        CMPL    R0, #IO$_WRITEPBLK
        BEQL    5$
        MOVL    #SS$_ILLIOFUNC, R0
        RSB
3$:     IFPRIV  LOG_IO, 7$
5$:     IFNPRIV PHY_IO, 86$
7$:     CMPL    R0, #IO$_READLBLK
        BEQL    10$
        CMPL    R0, #IO$_READPBLK
        BNEQ    20$
10$:    IFNOWRT R3, (R2), 85$
        BRB     30$
20$:    IFNORD  R3, (R2), 85$
30$:    CLRL    R1
        BSBW    IOC$ALLOCIRP
        BLBC    R0, 90$
        MOVL    36(AP), IRP$L_MEDIA(R3)
        BRB     DK$STARTIO
85$:    MOVL    #SS$_ACCVIO, R0
        RSB
86$:    MOVL    #SS$_NOPRIV, R0
        RSB
87$:    MOVL    #SS$_BADPARAM, R0
90$:    RSB

; DK$STARTIO: the disks' start I/O routine. R3 = an IRP, R5 = the disk's
; UCB. Does the IRP's read or write of IRP$L_BCNT bytes at IRP$L_BUFADR,
; from or to LBN IRP$L_MEDIA, at once, and completes it (IOC$REQCOM) with
; the status, and the count if it is a success; SS$_DRVERR, the device's
; own failure, counts in UCB$L_ERRCNT. R0 = SS$_NORMAL. IPL$_SYNCH. Uses
; R0-R3.
DK$STARTIO::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4>
        PUSHR   #^M<R3, R4>
        BICL3   #^C63, IRP$L_FUNC(R3), R4
        MOVL    IRP$L_BUFADR(R3), R0
        MOVL    IRP$L_BCNT(R3), R1
        MOVL    IRP$L_MEDIA(R3), R2
        CLRL    R3                      ; 0: a read
        CMPL    R4, #IO$_READLBLK
        BEQL    10$
        CMPL    R4, #IO$_READPBLK
        BEQL    10$
        INCL    R3                      ; 1: a write
10$:    MOVL    UCB$L_VCB(R5), R4
        BSBW    DISKIO
        POPR    #^M<R3, R4>
        BLBC    R0, 20$
        INSV    IRP$L_BCNT(R3), #16, #16, R0
        BRB     30$
20$:    CMPL    R0, #SS$_DRVERR
        BNEQ    30$
        INCL    UCB$L_ERRCNT(R5)
30$:    CLRL    R1
        BRW     IOC$REQCOM

; FIL$SELECT: R1 = a device name, R2 = its length: DKA0, DKB0 or MDA0, with a
; colon after it or not, an underscore before it or not. Makes its VCB
; F11$GL_VCB. R0 = SS$_NORMAL, or SS$_NOSUCHDEV and F11$GL_VCB as it was.
; Uses R1-R3.
FIL$SELECT::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        TSTL    R2
        BEQL    80$
        CMPB    (R1), #^A/_/
        BNEQ    10$
        INCL    R1
        DECL    R2
10$:    CMPL    R2, #5
        BNEQ    15$
        CMPB    4(R1), #^A/:/
        BNEQ    80$
        DECL    R2
15$:    CMPL    R2, #4
        BNEQ    80$
        MOVAB   F11$AB_DKA0, R3
20$:    CMPL    (R1), VCB$T_DEVNAM(R3)
        BEQL    30$
        ADDL2   #VCB$K_LENGTH, R3
        MOVAB   F11$A_VCBEND, R0
        CMPL    R3, R0
        BLSSU   20$
80$:    MOVL    #SS$_NOSUCHDEV, R0
        RSB
30$:    MOVL    R3, F11$GL_VCB
        MOVL    #SS$_NORMAL, R0
        RSB

; FIL$MOUNT: R1 = the label the volume must have, .ASCIC, or 0 for any.
; Mounts F11$GL_VCB's volume: reads its home block and INDEXF.SYS's
; header, which maps the others, and its owner and protection, and, if
; the disk can be written, finds the storage bitmap, and reports it on
; the console. R0 = SS$_NORMAL,
; SS$_NOHOMEBLK if there is no ODS-2 home block, SS$_INCVOLLABEL if the
; label isn't R1's, or the disk's error. Holding FIL$LOCK, but at boot,
; when no other process is there to want it. Uses R0-R5.
FIL$MOUNT::
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    F11$GL_VCB, R5
        MOVL    R1, R4
        MOVAB   VCB$AB_INDEXF(R5), R3   ; the home block, for now
        MOVL    R3, R0
        MOVL    #1, R1
        MOVL    #1, R2
        BSBW    FIL$READLBLK
        BLBC    R0, 90$
        CLRL    R1
10$:    CMPB    HM2$T_FORMAT(R3)[R1], F11$T_FORMAT[R1]
        BNEQ    80$
        AOBLSS  #10, R1, 10$
        MOVL    #12, R0                 ; the label, without its trailing blanks
15$:    CMPB    HM2$T_VOLNAME-1(R3)[R0], #^A/ /
        BNEQ    20$
        SOBGTR  R0, 15$
20$:    MOVB    R0, VCB$T_VOLNAME(R5)
        PUSHR   #^M<R3, R4, R5>
        MOVC3   R0, HM2$T_VOLNAME(R3), VCB$T_VOLNAME+1(R5)
        POPR    #^M<R3, R4, R5>
        TSTL    R4                      ; the one asked for?
        BEQL    25$
        MOVZBL  (R4), R0
        INCL    R0
22$:    CMPB    -1(R4)[R0], VCB$T_VOLNAME-1(R5)[R0]
        BNEQ    85$
        SOBGTR  R0, 22$
25$:    MOVAB   VCB$AB_INDEXF(R5), R3
        MOVW    HM2$W_CLUSTER(R3), VCB$W_CLUSTER(R5)
        MOVL    HM2$L_VOLOWNER(R3), VCB$L_OWNER(R5)
        MOVW    HM2$W_PROTECT(R3), VCB$W_PROT(R5)
        MOVZWL  HM2$W_IBMAPVBN(R3), R0
        MOVZWL  HM2$W_IBMAPSIZE(R3), R1
        ADDL3   R0, R1, VCB$L_HDRVBN(R5)
        MOVL    HM2$L_IBMAPLBN(R3), VCB$L_IBMAPLBN(R5)
        ADDL3   HM2$L_IBMAPLBN(R3), R1, R2      ; file 1's header
        MOVL    R3, R0
        MOVL    #1, R1
        BSBW    FIL$READLBLK
        BLBC    R0, 90$
        MOVL    #1, R0                  ; checked, as any other header
        MOVAB   VCB$AB_INDEXF(R5), R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R5), 30$
        MOVL    #BITMAP, R0             ; the storage bitmap, past the SCB
        MOVAB   F11$AB_FILHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVL    #2, R0
        BSBW    FIL$MAPVBN
        TSTL    R1
        BEQL    80$
        MOVL    R0, VCB$L_SBMAPLBN(R5)
        MOVAB   F11$AB_FILHDR, R1       ; and its blocks
        BSBW    FIL$EOF
        ADDL2   #BLOCK-1, R0
        DIVL2   #BLOCK, R0
        DECL    R0
        MOVL    R0, VCB$L_SBMAPBLKS(R5)
30$:    BISL2   #1@VCB$V_MOUNTED, VCB$L_STATUS(R5)
        DSBINT  #IPL$_SYNCH             ; the console, a line at a time
        MOVAB   MOUNTED, R1
        JSB     G^EXE$OUTZSTRING
        MOVAB   VCB$T_VOLNAME(R5), R1
        JSB     G^EXE$OUTCSTRING
        MOVAB   ONDEV, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    VCB$T_DEVNAM(R5), DEVNAM
        MOVB    VCB$T_DEVNAM+4(R5), DEVNAM+4
        MOVAB   DEVNAM, R1
        JSB     G^EXE$OUTZSTRING
        JSB     G^EXE$OUTCRLF
        ENBINT
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_NOHOMEBLK, R0
        RSB
85$:    MOVL    #SS$_INCVOLLABEL, R0
90$:    RSB

; $MOUNT itmlst: mounts the Files-11 volume on the disk the item list's
; MNT$_DEVNAM names, DKA0:, DKB0: or MDA0:, if its label is MNT$_VOLNAM's.
; MNT$_OWNER and MNT$_VPROT, a UIC and a protection mask, stand for the
; volume's own while it is mounted, and take VOLPRO. SS$_DEVMOUNT if one
; is mounted there already, SS$_BADPARAM for an item too short. Every
; process sees it, as VMS's MOUNT/SYSTEM, which takes SYSNAM: SS$_NOPRIV
; without.
; ponytail: no other items, flags or logical name; VMS lets the volume's
; owner give MNT$_OWNER and MNT$_VPROT without VOLPRO.
        .ENTRY  EXE$MOUNT, ^M<R2, R3, R4, R5, R6, R7, R8>
        MOVL    SCH$GL_CURPCB, R1
        MOVL    #SS$_NOPRIV, R0
        IFNPRIV SYSNAM, 90$, R1
        CLRQ    R6                      ; the device name: its address, length
        CLRB    LABEL
        CLRL    MNTSET
        MOVL    4(AP), R8
10$:    IFNORD  #4, (R8), 85$
        TSTL    (R8)
        BEQL    40$
        IFNORD  #12, (R8), 85$
        MOVZWL  (R8), R2
        MOVL    4(R8), R1
        IFNORD  R2, (R1), 85$
        CMPW    2(R8), #MNT$_DEVNAM
        BNEQ    20$
        MOVL    R1, R6
        MOVL    R2, R7
        BRB     30$
20$:    CMPW    2(R8), #MNT$_VOLNAM
        BNEQ    25$
        CMPL    R2, #12
        BGTRU   88$
        MOVB    R2, LABEL
        MOVC3   R2, (R1), LABEL+1
        BRB     30$
25$:    CMPW    2(R8), #MNT$_OWNER
        BNEQ    27$
        CMPL    R2, #4
        BLSSU   89$
        MOVL    (R1), MNTOWNER
        BISL2   #1, MNTSET
        BRB     30$
27$:    CMPW    2(R8), #MNT$_VPROT
        BNEQ    30$
        CMPL    R2, #2
        BLSSU   89$
        MOVW    (R1), MNTPROT
        BISL2   #2, MNTSET
30$:    ADDL2   #12, R8
        BRB     10$
40$:    MOVL    #SS$_IVDEVNAM, R0
        TSTL    R7
        BEQL    90$
        TSTL    MNTSET
        BEQL    45$
        MOVL    SCH$GL_CURPCB, R1
        MOVL    #SS$_NOPRIV, R0
        IFNPRIV VOLPRO, 90$, R1
45$:    BSBW    FIL$LOCK
        MOVL    R6, R1
        MOVL    R7, R2
        BSBW    FIL$SELECT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        MOVL    #SS$_DEVMOUNT, R0
        BBS     #VCB$V_MOUNTED, VCB$L_STATUS(R1), 80$
        MOVAB   LABEL, R1
        TSTB    (R1)
        BNEQ    50$
        CLRL    R1
50$:    BSBW    FIL$MOUNT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        BBC     #0, MNTSET, 60$
        MOVL    MNTOWNER, VCB$L_OWNER(R1)
60$:    BBC     #1, MNTSET, 80$
        MOVW    MNTPROT, VCB$W_PROT(R1)
80$:    BSBW    FIL$UNLOCK
        RET
85$:    MOVL    #SS$_ACCVIO, R0
        RET
88$:    MOVL    #SS$_INCVOLLABEL, R0
        RET
89$:    MOVL    #SS$_BADPARAM, R0
90$:    RET

; $DISMOU devnam, flags: dismounts the volume on the disk devnam names,
; DKB0: or MDA0:: the file system forgets it, and $MOUNT may mount it
; again, or $INIT_VOL write another there. SS$_DEVNOTMOUNT if none is
; mounted there, SS$_DEVACTIVE for the system disk, DKA0:, or while a
; process has a file on the volume open. SYSNAM, as $MOUNT, or
; SS$_NOPRIV.
; ponytail: no flags.
        .ENTRY  EXE$DISMOU, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R1
        MOVL    #SS$_NOPRIV, R0
        IFNPRIV SYSNAM, 90$, R1
        MOVL    4(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2
        MOVL    4(R1), R1
        BSBW    FIL$LOCK
        BSBW    FIL$SELECT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        MOVL    #SS$_DEVNOTMOUNT, R0
        BBC     #VCB$V_MOUNTED, VCB$L_STATUS(R1), 80$
        MOVL    #SS$_DEVACTIVE, R0
        MOVAB   F11$AB_DKA0, R2
        CMPL    R1, R2
        BEQL    80$
        BSBW    RMS$VOLIDLE
        BLBC    R0, 80$
        BICL2   #1@VCB$V_MOUNTED, VCB$L_STATUS(R1)
80$:    BSBW    FIL$UNLOCK
90$:    RET

; FIL$FREEBLOCKS: R0 = the free blocks on F11$GL_VCB's volume, which
; must be mounted: a cluster for each set bit of BITMAP.SYS's storage
; bitmap, the blocks past its SCB. R1 = SS$_NORMAL, or the disk's error
; and R0 = 0. Holding FIL$LOCK. Uses R0-R1.
; ponytail: counted each time, a bit at a time; VMS keeps the count in
; the VCB, up to date as files grow and shrink.
FIL$FREEBLOCKS::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6, R7>
        MOVL    #BITMAP, R0
        MOVAB   F11$AB_FILHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        BSBW    FIL$EOF
        ADDL2   #BLOCK-1, R0
        DIVL3   #BLOCK, R0, R7          ; its blocks, the SCB's and the bitmap's
        CLRL    R6                      ; the set bits
        MOVL    #2, R5                  ; the bitmap's VBN
10$:    CMPL    R5, R7
        BGTRU   50$
        MOVL    R5, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        MOVAB   F11$AB_FILHDR, R3
        BSBW    FIL$READVBN
        BLBC    R0, 90$
        CLRL    R4
20$:    BBC     R4, F11$AB_DIRBLK, 30$
        INCL    R6
30$:    AOBLSS  #BLOCK*8, R4, 20$
        INCL    R5
        BRB     10$
50$:    MOVL    F11$GL_VCB, R0
        MOVZWL  VCB$W_CLUSTER(R0), R0
        MULL2   R6, R0
        MOVL    #SS$_NORMAL, R1
        BRB     95$
90$:    MOVL    R0, R1
        CLRL    R0
95$:    POPR    #^M<R2, R3, R4, R5, R6, R7>
        RSB

; FIL$MAPVBN: R0 = a VBN, R1 = a file header. R0 = the LBN the header's
; map gives it, R1 = the blocks from there to its extent's end; both 0 if
; the map ends first. Keeps every other register.
FIL$MAPVBN::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5, R6>
        MOVZBL  FH2$B_MPOFFSET(R1), R2
        MOVAW   (R1)[R2], R2            ; the map
        MOVZBL  FH2$B_MAP_INUSE(R1), R3
        MOVAW   (R2)[R3], R3            ; past it
        MOVL    #1, R6                  ; the pointer's first VBN
10$:    CMPL    R2, R3
        BGEQU   80$
        MOVZWL  (R2), R4
        EXTZV   #14, #2, R4, R5         ; the format
        CASEL   R5, #0, #3
20$:    .WORD   30$-20$, 40$-20$, 50$-20$, 60$-20$
30$:    ADDL2   #2, R2                  ; 0: placement, maps nothing
        BRB     10$
40$:    MOVZBL  R4, R5                  ; 1: the count in 7:0, the LBN's
        EXTZV   #8, #6, R4, R1          ; high bits in 13:8, then a word
        ASHL    #16, R1, R1
        MOVW    2(R2), R1
        ADDL2   #4, R2
        BRB     70$
50$:    BICL3   #^XC000, R4, R5         ; 2: the count in 13:0, a longword LBN
        MOVL    2(R2), R1
        ADDL2   #6, R2
        BRB     70$
60$:    BICL3   #^XC000, R4, R5         ; 3: a 30-bit count, a longword LBN
        ASHL    #16, R5, R5
        MOVW    2(R2), R5
        MOVL    4(R2), R1
        ADDL2   #8, R2
70$:    INCL    R5                      ; counts are one less
        ADDL3   R6, R5, R4              ; past the pointer's last VBN
        CMPL    R0, R4
        BLSSU   75$
        MOVL    R4, R6
        BRB     10$
75$:    SUBL3   R0, R4, R4              ; the blocks left in the extent
        SUBL2   R6, R0
        ADDL2   R1, R0
        MOVL    R4, R1
        POPR    #^M<R2, R3, R4, R5, R6>
        RSB
80$:    CLRQ    R0
        POPR    #^M<R2, R3, R4, R5, R6>
        RSB

; FIL$READVBN: R0 = a VBN, R1 = a block count, R2 = a buffer, R3 = a file
; header. Reads the file's blocks from that VBN. R0 = SS$_NORMAL,
; SS$_ENDOFFILE if the map ends first, or the disk's error. Keeps every
; other register.
FIL$READVBN::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R4, R5, R6, R7, R8, R9>
        CLRL    R9
        BRB     VBLK

; FIL$WRITEVBN: R0 = a VBN, R1 = a block count, R2 = a buffer, R3 = a file
; header. Writes the buffer to the file's blocks from that VBN. R0 =
; SS$_NORMAL, SS$_ENDOFFILE if the map ends first, or the disk's error.
; Keeps every other register.
FIL$WRITEVBN::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R4, R5, R6, R7, R8, R9>
        MOVL    #1, R9
VBLK:   .GLOBAL_LABEL                   ; FIL$READVBN's too
        MOVL    R0, R6                  ; the next VBN
        MOVL    R1, R7                  ; the blocks left
        MOVL    R2, R8                  ; where they are
10$:    TSTL    R7
        BEQL    40$
        MOVL    R6, R0
        MOVL    R3, R1
        BSBW    FIL$MAPVBN
        TSTL    R1
        BEQL    50$
        CMPL    R1, R7
        BLEQU   20$
        MOVL    R7, R1
20$:    CMPL    R1, #MAXREAD
        BLEQU   30$
        MOVL    #MAXREAD, R1
30$:    MOVL    R1, R4
        MOVL    R0, R2
        MOVL    R8, R0
        BLBS    R9, 35$
        BSBW    FIL$READLBLK
        BRB     37$
35$:    BSBW    FIL$WRITELBLK
37$:    BLBC    R0, 60$
        ADDL2   R4, R6
        SUBL2   R4, R7
        MULL2   #BLOCK, R4
        ADDL2   R4, R8
        BRB     10$
40$:    MOVL    #SS$_NORMAL, R0
        BRB     60$
50$:    MOVL    #SS$_ENDOFFILE, R0
60$:    POPR    #^M<R1, R2, R4, R5, R6, R7, R8, R9>
        RSB

; FIL$READHDR: R0 = a file number, R1 = a buffer. Reads the file's
; header on F11$GL_VCB's volume there. R0 = SS$_NORMAL; SS$_NOSUCHFILE if the slot holds
; another file, SS$_BADCHKSUM if it holds no header, or the disk's error.
; Keeps every other register.
FIL$READHDR::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4, R5>
        MOVL    R1, R4
        MOVL    R0, R5
        BEQL    80$
        MOVL    F11$GL_VCB, R3
        ADDL3   VCB$L_HDRVBN(R3), R5, R0
        DECL    R0
        MOVL    #1, R1
        MOVL    R4, R2
        MOVAB   VCB$AB_INDEXF(R3), R3
        BSBW    FIL$READVBN
        BLBC    R0, 90$
        CLRL    R1                      ; the sum of words 0-254
        CLRL    R2
10$:    ADDW2   (R4)[R2], R1
        AOBLSS  #255, R2, 10$
        CMPW    R1, FH2$W_CHECKSUM(R4)
        BNEQ    85$
        MOVZBL  FH2$B_FID_NMX(R4), R1
        ASHL    #16, R1, R1
        MOVW    FH2$W_FID(R4), R1
        CMPL    R1, R5
        BNEQ    80$
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_NOSUCHFILE, R0
        BRB     90$
85$:    MOVL    #SS$_BADCHKSUM, R0
90$:    POPR    #^M<R1, R2, R3, R4, R5>
        RSB

; FIL$EOF: R1 = a file header. R0 = the bytes in the file, up to its end
; of file. Uses R1.
FIL$EOF::
        .JSB_ENTRY
        MOVZWL  FH2$W_RECATTR+FAT$L_EFBLK(R1), R0       ; high word first
        ASHL    #16, R0, R0
        MOVW    FH2$W_RECATTR+FAT$L_EFBLK+2(R1), R0
        TSTL    R0
        BEQL    10$
        DECL    R0
        MULL2   #BLOCK, R0
        MOVZWL  FH2$W_RECATTR+FAT$W_FFBYTE(R1), R1
        ADDL2   R1, R0
10$:    RSB

; FIL$ISDIR: R1 = a file header. R0 = 1 if the file is a directory, else
; 0. Keeps every other register.
FIL$ISDIR::
        .JSB_ENTRY
        EXTZV   #FCH$V_DIRECTORY, #1, FH2$L_FILECHAR(R1), R0
        RSB

; FIL$CHKPRO: R0 = the access wanted, $ARMDEF's bits, R1 = an owner's
; UIC, R2 = a protection mask, a file header's or a volume's: 4 bits each
; for the system, the owner, the group and the world, a set bit denying
; read, write, execute or delete. R0 = SS$_NORMAL if the current process
; may, by VMS's rules, else SS$_NOPRIV. It has what the world is allowed;
; what the group is too if its UIC group is the owner's; what the owner
; is, and control, if its UIC is the owner's; what the system is, and
; control, if its UIC group is up to MAXSYSGROUP, or with SYSPRV, or with
; GRPPRV in the owner's group. READALL reads anything, BYPASS does
; anything. Keeps every other register.
FIL$CHKPRO::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        IFPRIV  BYPASS, 80$
        MOVL    R0, R5                  ; what it wants
        MCOML   R2, R2                  ; a set bit allows
        EXTZV   #12, #4, R2, R3         ; the world's
        IFPRIV  SYSPRV, 10$
        CMPW    PCB$L_UIC+2(R4), #MAXSYSGROUP
        BLEQU   10$
        IFNPRIV GRPPRV, 20$
        EXTZV   #16, #16, R1, R0
        CMPW    R0, PCB$L_UIC+2(R4)
        BNEQ    20$
10$:    EXTZV   #0, #4, R2, R0          ; the system's
        BISL2   R0, R3
        BISL2   #ARM$M_CONTROL!ARM$M_SYSTEM, R3
20$:    CMPL    R1, PCB$L_UIC(R4)
        BNEQ    30$
        EXTZV   #4, #4, R2, R0          ; the owner's
        BISL2   R0, R3
        BISL2   #ARM$M_CONTROL, R3
30$:    EXTZV   #16, #16, R1, R0
        CMPW    R0, PCB$L_UIC+2(R4)
        BNEQ    40$
        EXTZV   #8, #4, R2, R0          ; the group's
        BISL2   R0, R3
40$:    IFNPRIV READALL, 50$
        BISL2   #ARM$M_READ, R3
50$:    BICL3   R3, R5, R0
        BNEQ    90$
80$:    MOVL    #SS$_NORMAL, R0
        BRB     95$
90$:    MOVL    #SS$_NOPRIV, R0
95$:    POPR    #^M<R1, R2, R3, R4, R5>
        RSB

; FIL$CHKHDR: R0 = the access wanted, $ARMDEF's bits, R1 = a file header
; on F11$GL_VCB's volume. FIL$CHKPRO with the volume's owner and
; protection, for the access alone, then with the file's. R0 = SS$_NORMAL
; or SS$_NOPRIV. Keeps every other register.
FIL$CHKHDR::
        .JSB_ENTRY
        PUSHR   #^M<R1, R2, R3>
        MOVL    R0, R3
        PUSHL   R1
        MOVL    F11$GL_VCB, R2
        MOVL    VCB$L_OWNER(R2), R1
        MOVZWL  VCB$W_PROT(R2), R2
        BICL2   #ARM$M_CONTROL!ARM$M_SYSTEM, R0
        BSBW    FIL$CHKPRO
        MOVL    (SP)+, R1
        BLBC    R0, 90$
        MOVL    R3, R0
        MOVZWL  FH2$W_FILEPROT(R1), R2
        MOVL    FH2$L_FILEOWNER(R1), R1
        BSBW    FIL$CHKPRO
90$:    POPR    #^M<R1, R2, R3>
        RSB

; FIL$SEARCHDIR: R3 = a directory's header, R6 = a pattern, "NAME.TYPE"
; with * and % wildcards, R7 = its length, R8 = a version: -1 any, 0 the
; highest, else that one, R9 = how many matching entries to skip. Finds
; the next entry that matches, in the directory's order: R1 = its name,
; in F11$AB_DIRBLK, R2 = the name's length, R4 = its version, R5 = its
; file number, and its file ID in F11$GW_FID. R0 = SS$_NORMAL,
; SS$_NOMOREFILES if there is none, or the disk's error. Holding FIL$LOCK.
; Keeps every other register.
; ponytail: the highest version is the first of a name's first record;
; a name whose versions spill into a second record matches twice.
FIL$SEARCHDIR::
        .JSB_ENTRY  OUTPUT=<R2, R4, R5>
        PUSHR   #^M<R3, R6, R7, R8, R9, R10, R11>
        MOVL    #1, R10                 ; the VBN
10$:    MOVL    R3, R1                  ; the blocks in use, EOF's partly
        BSBW    FIL$EOF
        ADDL2   #BLOCK-1, R0
        DIVL2   #BLOCK, R0
        CMPL    R10, R0
        BGTRU   90$
        MOVL    R10, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        BSBW    FIL$READVBN
        BLBC    R0, 95$
        MOVAB   F11$AB_DIRBLK, R11      ; the record
20$:    MOVAB   F11$AB_DIRBLK+BLOCK-2, R0
        CMPL    R11, R0
        BGEQU   60$
        CMPW    (R11), #^XFFFF          ; the block's end
        BEQL    60$
        MOVAB   6(R11), R1
        MOVZBL  5(R11), R2
        BSBW    FIL$MATCH
        BLBC    R0, 50$
        ADDL3   #1, R2, R4              ; the first entry, past the even name
        BICL2   #1, R4
        ADDL2   R1, R4
        MOVL    R4, R0                  ; the first entry
        MOVZWL  (R11), R5               ; past the record
        ADDL2   R11, R5
        ADDL2   #2, R5
30$:    CMPL    R4, R5
        BGEQU   50$
        TSTL    R8
        BLSS    40$                     ; any version
        TSTL    R8
        BGTR    35$
        CMPL    R4, R0                  ; the highest: the first only
        BNEQ    50$
        BRB     40$
35$:    CMPW    (R4), R8
        BNEQ    45$
40$:    TSTL    R9
        BEQL    70$
        DECL    R9
45$:    ADDL2   #8, R4
        BRB     30$
50$:    MOVZWL  (R11), R0               ; the next record
        ADDL2   #2, R0
        ADDL2   R0, R11
        BRB     20$
60$:    INCL    R10                     ; the next block
        BRB     10$
70$:    MOVL    2(R4), F11$GW_FID
        MOVW    6(R4), F11$GW_FID+4
        MOVZBL  7(R4), R5
        ASHL    #16, R5, R5
        MOVW    2(R4), R5
        MOVZWL  (R4), R4
        MOVL    #SS$_NORMAL, R0
        BRB     95$
90$:    MOVL    #SS$_NOMOREFILES, R0
95$:    POPR    #^M<R3, R6, R7, R8, R9, R10, R11>
        RSB

; FIL$MATCH: R1 = a name, R2 = its length, R6 = a pattern, R7 = its
; length. R0 = 1 if the name matches it, else 0: * matches any
; characters, % any one. Keeps every other register.
FIL$MATCH::
        .JSB_ENTRY
        PUSHR   #^M<R3, R4, R5, R8>
        CLRL    R3                      ; in the name
        CLRL    R4                      ; in the pattern
        MNEGL   #1, R5                  ; past the last *, to try again from
        CLRL    R8                      ; where in the name it matched from
10$:    CMPL    R3, R2
        BGEQU   50$
        CMPL    R4, R7
        BGEQU   30$
        MOVB    (R6)[R4], R0
        CMPB    R0, #^A/*/
        BEQL    20$
        CMPB    R0, #^A/%/
        BEQL    15$
        CMPB    R0, (R1)[R3]
        BNEQ    30$
15$:    INCL    R3
        INCL    R4
        BRB     10$
20$:    MOVL    R4, R5                  ; *: match nothing first
        MOVL    R3, R8
        INCL    R4
        BRB     10$
30$:    TSTL    R5                      ; no: the last * takes one more
        BLSS    80$
        ADDL3   #1, R5, R4
        INCL    R8
        MOVL    R8, R3
        BRB     10$
50$:    CMPL    R4, R7                  ; the name's end: only *s may be left
        BGEQU   70$
        CMPB    (R6)[R4], #^A/*/
        BNEQ    80$
        INCL    R4
        BRB     50$
70$:    MOVL    #1, R0
        BRB     90$
80$:    CLRL    R0
90$:    POPR    #^M<R3, R4, R5, R8>
        RSB

; FIL$OPENFILE: R6 = an image's file specification, R7 = its length.
; Finds the file, in SYS$SYSTEM: unless the specification says
; otherwise, on any mounted volume, and reads its image header, the
; blocks EIHD$L_HDRBLKCNT says, into a block of pool, with the file's
; header and its volume's VCB after them, for FIL$READIMG to read the
; sections with: R1 = the block's address, R2 = the file's size in bytes,
; R3 = the block's size, for EXE$DEANONPGDSIZ. R0 = SS$_NORMAL, an RMS
; error such as RMS$_FNF, RMS$_PRV if the process may not execute it,
; SS$_BADIMGHDR, SS$_INSFMEM, or the disk's error. Keeps every other
; register.
; ponytail: VMS maps an image's sections from it, page by page, when they
; are touched; here FIL$READIMG reads each at once.
FIL$OPENFILE::
        .JSB_ENTRY  OUTPUT=<R2, R3>
        PUSHR   #^M<R4, R5, R6, R7, R8, R9, R10, R11>
        MOVAB   IMAGEDEF, R4
        BRB     OPEN

; FIL$OPENSHR: R6 = a shareable image's name, R7 = its length. Reads the
; file as FIL$OPENFILE does, from SYS$SHARE:name.EXE unless the name says
; otherwise, as VMS's image activator looks for one.
; ponytail: VMS first translates the name as a logical name.
FIL$OPENSHR::
        .JSB_ENTRY  OUTPUT=<R2, R3>
        PUSHR   #^M<R4, R5, R6, R7, R8, R9, R10, R11>
        MOVAB   SHAREDEF, R4
OPEN:   .GLOBAL_LABEL                   ; FIL$OPENFILE's too
        BSBW    FIL$LOCK
        MOVL    R6, R0
        MOVL    R7, R1
        CLRQ    R2                      ; no default but the system's, R4
        MOVAB   F11$AB_FILHDR, R5
        BSBW    RMS$LOCATE
        BLBC    R0, 90$
        MOVL    #ARM$M_EXECUTE, R0
        MOVAB   F11$AB_FILHDR, R1
        BSBW    FIL$CHKHDR
        BLBS    R0, 10$
        MOVL    #RMS$_PRV, R0
        BRB     90$
10$:    MOVAB   F11$AB_FILHDR, R1
        BSBW    FIL$EOF
        MOVL    R0, R10                 ; the bytes
; The first block, which says how many the header has, in a block of
; pool with room for the file's header and the VCB after it.
        MOVL    #3*BLOCK, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R1, R11                 ; the pool block's size
        MOVL    R2, R8                  ; and address
        MOVL    #1, R9
        BSBB    HEADER
        BLBC    R0, 80$
        MOVL    EIHD$L_HDRBLKCNT(R8), R9
        BEQL    85$
        CMPL    R9, #MAXHDR
        BGTRU   85$
        CMPL    R9, #1
        BEQL    20$
        MOVL    R8, R0                  ; more blocks: a bigger pool block
        MOVL    R11, R1
        BSBW    EXE$DEANONPGDSIZ
        ADDL3   #2, R9, R1
        MULL2   #BLOCK, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R1, R11
        MOVL    R2, R8
        BSBB    HEADER
        BLBC    R0, 80$
20$:    MULL3   #BLOCK, R9, R0
        ADDL2   R8, R0
        MOVL    F11$GL_VCB, BLOCK(R0)
        MOVC3   #BLOCK, F11$AB_FILHDR, (R0)
        MOVL    R8, R1
        MOVL    R10, R2
        MOVL    R11, R3
        MOVL    #SS$_NORMAL, R0
        BRB     90$
85$:    MOVL    #SS$_BADIMGHDR, R0
80$:    PUSHL   R0
        MOVL    R8, R0
        MOVL    R11, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
90$:    BSBW    FIL$UNLOCK
        POPR    #^M<R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

; HEADER: R8 = a buffer, R9 = a block count. Reads the file's first blocks
; there, from F11$AB_FILHDR. Uses R0-R3.
HEADER:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    #1, R0
        MOVL    R9, R1
        MOVL    R8, R2
        MOVAB   F11$AB_FILHDR, R3
        BSBW    FIL$READVBN
        RSB

; FIL$READIMG: R0 = a VBN of an image FIL$OPENFILE or FIL$OPENSHR opened,
; R1 = a byte count, R2 = where, R8 = the pool block they returned. Reads
; that many bytes of the file from that VBN there, through a buffer in
; pool, holding FIL$LOCK. R0 = SS$_NORMAL, SS$_INSFMEM, or FIL$READVBN's
; error. Uses R1.
FIL$READIMG::
        .JSB_ENTRY  SCRATCH=<R1>
        PUSHR   #^M<R2, R3, R4, R5, R6, R7, R9, R10, R11>
        MOVL    R0, R6                  ; the next VBN
        MOVL    R1, R7                  ; the bytes left
        MOVL    R2, R9                  ; where they go
        MULL3   #BLOCK, EIHD$L_HDRBLKCNT(R8), R10
        ADDL2   R8, R10                 ; the file's header
        MOVL    #BOUNCE*BLOCK, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 99$
        MOVL    R2, R11                 ; the buffer
        PUSHL   R1                      ; and its size
        BSBW    FIL$LOCK
        MOVL    BLOCK(R10), F11$GL_VCB
10$:    TSTL    R7
        BEQL    50$
        ADDL3   #BLOCK-1, R7, R1
        DIVL2   #BLOCK, R1              ; the blocks left
        CMPL    R1, #BOUNCE
        BLEQU   20$
        MOVL    #BOUNCE, R1
20$:    MOVL    R6, R0
        MOVL    R11, R2
        MOVL    R10, R3
        BSBW    FIL$READVBN
        BLBC    R0, 60$
        ADDL2   R1, R6
        MULL2   #BLOCK, R1              ; the bytes read, of which those wanted
        CMPL    R1, R7
        BLEQU   30$
        MOVL    R7, R1
30$:    SUBL2   R1, R7
        MOVC3   R1, (R11), (R9)
        MOVL    R3, R9
        BRB     10$
50$:    MOVL    #SS$_NORMAL, R0
60$:    BSBW    FIL$UNLOCK
        MOVL    (SP)+, R1
        PUSHL   R0
        MOVL    R11, R0
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
99$:    POPR    #^M<R2, R3, R4, R5, R6, R7, R9, R10, R11>
        RSB

        .END
