        .TITLE  MDDRIVER MDA0:, a ramdisk, as DECram's
        .IDENT  /V0.1/
;
; MDA0: is a disk in memory, as DECram's MDDRIVER made one on VMS: its
; blocks are pages of S0 from MD_VA, which the first INITIALIZE of MDA0:
; makes ($INIT_VOL, f11wrt.mar) and every later one makes afresh, zeroed,
; INITIALIZE/SIZE's blocks, or as many as the last time, 1,024 at first.
; Until then the device is offline. Reads and writes are copies, at once:
; the disks' driver (DK$STARTIO, f11.mar) calls MD$IO where it would
; call the PAL for DKA0:. The pages are the system's, so the volume outlives the processes
; that wrote it, but not the system.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PTEDEF
        $PRTDEF
        $SSDEF

        .EXTERNAL MMG$CREPAG, MMG$DELPAG

BLOCK = 512
MD_VA = ^X50000000                      ; in S0, past the RPB
MD$C_BLOCKS = 1024                      ; its size at first, 512 KB
MD$C_MAXBLOCKS = <^X5FF00000-MD_VA>/BLOCK ; its most, up to the boot stack
PAGBLK = MMG$C_PAGESIZE/BLOCK           ; blocks in a page
KW = PTE$M_VALID ! PTE$M_FOE ! PTE$C_KW

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
MD$GL_BASE::                            ; the ramdisk's first block, or 0: offline
        .LONG   0
MD$GL_BLOCKS::                          ; its size in blocks, the last INITIALIZE's
        .LONG   MD$C_BLOCKS

        .PSECT  $CODE$

; MD$CREATE: R1 = a size in blocks. Makes the ramdisk's pages, that many
; blocks of them, zeroed, after deleting any it had. R0 = SS$_NORMAL,
; SS$_BADPARAM for a size of 0 or past MD$C_MAXBLOCKS, the ramdisk as it
; was, or SS$_INSFMEM, and the ramdisk offline. Uses R0-R3.
MD$CREATE::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        MOVL    #SS$_BADPARAM, R0
        TSTL    R1
        BEQL    90$
        CMPL    R1, #MD$C_MAXBLOCKS
        BGTRU   90$
        MOVL    R1, R3
        TSTL    MD$GL_BASE
        BEQL    10$
        CLRL    MD$GL_BASE
        BSBB    PAGES
        BSBW    MMG$DELPAG
10$:    MOVL    R3, MD$GL_BLOCKS
        BSBB    PAGES
        MOVL    #KW, R2
        BSBW    MMG$CREPAG
        BLBC    R0, 80$
        MOVL    #MD_VA, MD$GL_BASE
        RSB
80$:    PUSHL   R0                      ; none left, not some
        BSBB    PAGES
        BSBW    MMG$DELPAG
        MOVL    (SP)+, R0
90$:    RSB

; PAGES: R0 = the ramdisk's first page, R1 = its pages, for MD$GL_BLOCKS.
PAGES:
        .JSB_ENTRY
        MOVL    #MD_VA, R0
        ADDL3   #PAGBLK-1, MD$GL_BLOCKS, R1
        DIVL2   #PAGBLK, R1
        RSB

; MD$IO: R0 = a buffer, R1 = a byte count, R2 = an LBN, R3 = 0 to read the
; blocks there into the buffer, 1 to write the buffer there. R0 =
; SS$_NORMAL, SS$_MEDOFL before MD$CREATE, or SS$_ILLBLKNUM past the
; ramdisk's end. Uses R1.
MD$IO::
        .JSB_ENTRY
        PUSHR   #^M<R2, R3, R4, R5>
        TSTL    MD$GL_BASE
        BEQL    80$
        CMPL    R2, MD$GL_BLOCKS
        BGEQU   85$
        MULL2   #BLOCK, R2
        ADDL3   R2, R1, R4
        MULL3   #BLOCK, MD$GL_BLOCKS, R5
        CMPL    R4, R5
        BGTRU   85$
        ADDL2   MD$GL_BASE, R2
        BLBS    R3, 10$
        MOVC3   R1, (R2), (R0)
        BRB     70$
10$:    MOVC3   R1, (R0), (R2)
70$:    MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_MEDOFL, R0
        BRB     90$
85$:    MOVL    #SS$_ILLBLKNUM, R0
90$:    POPR    #^M<R2, R3, R4, R5>
        RSB

        .END
