#!/usr/bin/expect -f
# Boots an installed OpenVMS in AXPbox and leaves you at the console
# login prompt.
#
# usage: console.exp [DIR [BOOTDEV]]   (defaults: this directory, dka0)
#
# DIR holds es40.cfg (serial0 on port 21264) and axpbox or
# axpbox/build/axpbox; the emulator's output goes to DIR/axpbox.log.
# To quit: shut VMS down (@SYS$SYSTEM:SHUTDOWN), wait for P00>>>,
# then Ctrl-] stops the emulator gracefully so the disk images are flushed.

set dir [file normalize [lindex [concat $argv [file dirname [info script]]] 0]]
set dev [expr {[llength $argv] > 1 ? [lindex $argv 1] : "dka0"}]
set port 21264
cd $dir
set bin [expr {[file executable axpbox] && [file isfile axpbox] ? "./axpbox" : "axpbox/build/axpbox"}]

# AXPbox ignores bind() errors: a second one would listen on a random port.
if {![catch {close [socket 127.0.0.1 $port]}]} {
    puts "port $port busy: another axpbox running?"; exit 1
}
# Detached through sh so it is not our child: an unreaped zombie would
# keep stop_emu's kill -0 loop spinning.
set emu [exec sh -c "$bin run es40.cfg >axpbox.log 2>&1 </dev/null & echo \$!"]
proc stop_emu {} {
    global emu
    catch {exec kill -INT $emu}   ;# graceful exit flushes the disk images
    catch {exec sh -c "while kill -0 $emu 2>/dev/null; do sleep 0.2; done"}
    catch {exec kill [exp_pid]}   ;# telnet misses the close; don't leave it behind
}

# AXPbox takes a single console connection, so retry telnet itself
# rather than probing the port.
set timeout 300
for {set i 0} {1} {incr i} {
    spawn telnet 127.0.0.1 $port
    expect {
        "P00>>>" break
        "refused" {
            wait
            if {$i > 50} { puts "emulator not listening, see axpbox.log"; stop_emu; exit 1 }
            after 200
        }
        timeout { puts "\nno SRM prompt"; stop_emu; exit 1 }
        eof { wait; after 200 }
    }
}
send "boot $dev\r"

# Any output line restarts the timeout; 30 s of silence pokes Return,
# which OPA0 needs anyway to show Username: once startup is done.
set timeout 30
# The prompt follows a bare CR; audit alarms print a "Username:" field
# at the start of a line (after LF) too.
expect {
    -re {\rUsername: $} {}
    "date and time" {
        send "[string toupper [clock format [clock seconds] -format {%d-%b-%Y %H:%M}]]\r"
        exp_continue
    }
    "P00>>>" { send "boot $dev\r"; exp_continue }
    "\n" exp_continue
    timeout { send "\r"; exp_continue }
}

interact "\x1d" return
stop_emu
