        .TITLE  GETDVI  $GETDVI and $DEVICE_SCAN: what the devices are
        .IDENT  /V0.1/
;
; A program finds the devices with $DEVICE_SCAN and asks about each with
; $GETDVI, as on VMS, with VMS's item codes (starlet.mlb's $DVIDEF and
; $DVSDEF). The devices are the disks, in f11.mar's order, each a VCB,
; then the console, OPA0:, the one terminal: DEVICE numbers them so.
; ponytail: a VCB stands for a disk, and 0 for the console, not their UCBs
; (qio.mar), which have no counts or device types yet. $GETDVI is done when it returns, and
; takes no AST.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $IPLDEF
        $PCBDEF
        $SSDEF
        $VCBDEF
        $DVIDEF
        $DVSDEF
        $DCDEF
        $DEVDEF
        $UCBDEF

        .EXTERNAL F11$GL_VCB, F11$AB_DKA0, F11$A_VCBEND, F11$AB_DIRBLK
        .EXTERNAL FIL$FREEBLOCKS, FIL$READLBLK, FIL$MATCH, MD$GL_BASE
        .EXTERNAL IOC$TRNDEVNAM, EXE$PROBER_DSC, EXE$SETEF, EXE$CLREF
        .EXTERNAL SCH$GL_CURPCB

MAXCHAN = 31                            ; as qio.mar's
DISK = DEV$M_FOD!DEV$M_DIR!DEV$M_SHR!DEV$M_AVL!DEV$M_IDV!DEV$M_ODV!DEV$M_RND
TERM = DEV$M_REC!DEV$M_CCL!DEV$M_TRM!DEV$M_AVL!DEV$M_IDV!DEV$M_ODV

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
OPA0:   .ASCII  "OPA0"
NAMBUF: .BLKB   6                       ; a device's name, _DDCU:
VALUE:  .LONG   0                       ; a value item's

        .PSECT  $CODE$

; DEVICE: R4 = a device's number. R5 = its VCB, or 0 for the console.
; R0 = SS$_NORMAL, or SS$_NOMOREDEV past the last. Keeps every other
; register.
DEVICE: CMPL    R4, #255            ; a caller's context, which may be anything
        BGTRU   80$
        MULL3   #VCB$K_LENGTH, R4, R5
        MOVAB   F11$AB_DKA0, R0
        ADDL2   R0, R5
        MOVAB   F11$A_VCBEND, R0
        CMPL    R5, R0
        BLSSU   10$
        BNEQ    80$
        CLRL    R5                      ; the one past the disks
10$:    MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_NOMOREDEV, R0
        RSB

; DEVNAME: R5 = a device's VCB, or 0. Makes its name, _DDCU:, in NAMBUF.
; R1 = NAMBUF, R2 = 6. Keeps every other register.
DEVNAME:
        MOVAB   OPA0, R1
        TSTL    R5
        BEQL    10$
        MOVAB   VCB$T_DEVNAM(R5), R1
10$:    MOVB    #^A/_/, NAMBUF
        MOVL    (R1), NAMBUF+1
        MOVB    #^A/:/, NAMBUF+5
        MOVAB   NAMBUF, R1
        MOVL    #6, R2
        RSB

; DEVCHAR: R5 = a device's VCB, or 0. R0 = its DEV$ bits: a disk's, with
; MNT if a volume is mounted, and SWL too if the disk can't be written,
; or a terminal's. Keeps every other register.
DEVCHAR:
        MOVL    #TERM, R0
        TSTL    R5
        BEQL    10$
        MOVL    #DISK, R0
        BBC     #VCB$V_MOUNTED, VCB$L_STATUS(R5), 10$
        BISL2   #DEV$M_MNT, R0
        BBS     #VCB$V_WRITE, VCB$L_STATUS(R5), 10$
        BISL2   #DEV$M_SWL, R0
10$:    RSB

; ONLINE: R5 = a device's VCB, or 0. R0 = UCB$M_ONLINE if the device is
; there: the console, a disk with a volume mounted, the ramdisk once
; made, or a PAL disk whose first block reads; else 0. IPL$_SYNCH. Uses
; R1-R2.
ONLINE: TSTL    R5
        BEQL    70$
        BBS     #VCB$V_MOUNTED, VCB$L_STATUS(R5), 70$
        BBC     #VCB$V_RAMDISK, VCB$L_STATUS(R5), 10$
        TSTL    MD$GL_BASE
        BNEQ    70$
        BRB     80$
10$:    PUSHL   F11$GL_VCB
        MOVL    R5, F11$GL_VCB
        MOVAB   F11$AB_DIRBLK, R0
        MOVL    #1, R1
        CLRL    R2
        BSBW    FIL$READLBLK
        MOVL    (SP)+, F11$GL_VCB
        BLBC    R0, 80$
70$:    MOVL    #UCB$M_ONLINE, R0
        RSB
80$:    CLRL    R0
        RSB

; $GETDVI efn, chan, devnam, itmlst, iosb, astadr, astprm, nullarg:
; returns what the item list asks about a device: the one devnam names,
; translated as $ASSIGN translates it, or else chan's. Each
; item is a buffer length and an item code, words, then the buffer's
; address and the address of a word for the length returned, or 0; a
; longword of 0 ends the list. A value is a longword, a string as long
; as it is; either is cut to fit the buffer. Clears the event flag, then
; sets it, and writes SS$_NORMAL in the IOSB's first word, if there is
; one. SS$_NOSUCHDEV for a device that isn't there, SS$_IVCHAN for a
; channel that isn't assigned, SS$_BADPARAM for an item code it doesn't
; know, or the disk's error for DVI$_FREEBLOCKS.
; ponytail: done at once, no AST; the items $DVIDEF lists.
        .ENTRY  EXE$GETDVI, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    20(AP), R0              ; the IOSB
        BEQL    5$
        IFNOWRT #8, (R0), 85$
5$:     PUSHL   4(AP)
        CALLS   #1, G^EXE$CLREF
        BLBC    R0, 90$
        DSBINT  #IPL$_SYNCH             ; logical names, VCBs, buffers
        MOVL    12(AP), R1              ; the device's name
        BEQL    20$
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 80$
        MOVZWL  (R1), R2
        MOVL    4(R1), R3
        BSBW    IOC$TRNDEVNAM
        MOVL    #SS$_NOSUCHDEV, R0
        CMPL    R2, #5                  ; DDCU, with a colon or without
        BNEQ    10$
        CMPB    4(R3), #^A/:/
        BNEQ    80$
        DECL    R2
10$:    CMPL    R2, #4
        BNEQ    80$
        CLRL    R4
15$:    BSBW    DEVICE
        BLBC    R0, 18$
        BSBW    DEVNAME
        CMPL    1(R1), (R3)
        BEQL    30$
        INCL    R4
        BRB     15$
18$:    MOVL    #SS$_NOSUCHDEV, R0
        BRB     80$
20$:    MOVZWL  8(AP), R0               ; else the channel's
        BEQL    25$
        CMPL    R0, #MAXCHAN
        BGTRU   25$
        MOVL    SCH$GL_CURPCB, R1
        BBC     R0, PCB$L_CHANS(R1), 25$
        MOVL    PCB$AL_CCB(R1)[R0], R5  ; its UCB
        MOVL    UCB$L_VCB(R5), R5
        BRB     30$
25$:    MOVL    #SS$_IVCHAN, R0
        BRB     80$
30$:    MOVL    16(AP), R8              ; the items
40$:    IFNORD  #4, (R8), 84$
        TSTL    (R8)
        BEQL    70$
        IFNORD  #12, (R8), 84$
        MOVZWL  (R8), R9                ; the buffer: its length,
        MOVL    4(R8), R11              ; its address
        IFNOWRT R9, (R11), 84$
        MOVL    8(R8), R0
        BEQL    42$
        IFNOWRT #2, (R0), 84$
42$:    MOVZWL  2(R8), R10
        BSBW    ITEM
        BLBC    R0, 80$
        CMPL    R2, R9                  ; as much as fits
        BLEQU   44$
        MOVL    R9, R2
44$:    CLRL    R3
45$:    CMPL    R3, R2
        BGEQU   48$
        MOVB    (R1)[R3], (R11)[R3]
        INCL    R3
        BRB     45$
48$:    MOVL    8(R8), R0
        BEQL    50$
        MOVW    R2, (R0)
50$:    ADDL2   #12, R8
        BRB     40$
70$:    ENBINT
        MOVL    20(AP), R0
        BEQL    75$
        MOVL    #SS$_NORMAL, (R0)
        CLRL    4(R0)
75$:    PUSHL   4(AP)
        CALLS   #1, G^EXE$SETEF
        MOVL    #SS$_NORMAL, R0
        RET
84$:    MOVL    #SS$_ACCVIO, R0
80$:    ENBINT
        RET
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

; $GETDVIW efn, chan, devnam, itmlst, iosb, astadr, astprm, nullarg: as
; $GETDVI, which is done when it returns, so has nothing to wait for.
        .ENTRY  EXE$GETDVIW, ^M<>
        CALLG   (AP), EXE$GETDVI
        RET

; ITEM: R10 = an item code, R5 = the device's VCB, or 0. R1 = what to
; return, R2 = its length. R0 = SS$_NORMAL, SS$_BADPARAM for a code it
; doesn't know, or the disk's error. IPL$_SYNCH. Uses R0-R3.
ITEM:   CMPL    R10, #DVI$_DEVNAM
        BNEQ    10$
        BSBW    DEVNAME
        BRW     STRING
10$:    CMPL    R10, #DVI$_VOLNAM
        BNEQ    20$
        CLRL    R2
        BSBW    MOUNTED
        BLBC    R0, 15$
        MOVAB   VCB$T_VOLNAME+1(R5), R1
        MOVZBL  VCB$T_VOLNAME(R5), R2
15$:    BRW     STRING
20$:    CMPL    R10, #DVI$_DEVCHAR
        BNEQ    25$
        BSBW    DEVCHAR
        BRW     LONG
25$:    CMPL    R10, #DVI$_DEVCLASS
        BNEQ    30$
        MOVL    #DC$_TERM, R0
        TSTL    R5
        BEQL    27$
        MOVL    #DC$_DISK, R0
27$:    BRW     LONG
30$:    CMPL    R10, #DVI$_UNIT
        BEQL    32$
        CMPL    R10, #DVI$_ERRCNT
        BNEQ    35$
32$:    CLRL    R0
        BRW     LONG
35$:    CMPL    R10, #DVI$_FREEBLOCKS
        BNEQ    40$
        BSBW    MOUNTED
        BLBC    R0, 37$
        PUSHL   F11$GL_VCB
        MOVL    R5, F11$GL_VCB
        BSBW    FIL$FREEBLOCKS
        MOVL    (SP)+, F11$GL_VCB
        BLBS    R1, 38$
        MOVL    R1, R0
        RSB
37$:    CLRL    R0
38$:    BRW     LONG
40$:    CMPL    R10, #DVI$_CLUSTER
        BNEQ    45$
        BSBW    MOUNTED
        BLBC    R0, 42$
        MOVZWL  VCB$W_CLUSTER(R5), R0
42$:    BRW     LONG
45$:    CMPL    R10, #DVI$_MOUNTCNT
        BNEQ    50$
        BSBW    MOUNTED
        BRW     LONG
50$:    CMPL    R10, #DVI$_AVL
        BNEQ    52$
        BSBW    DEVCHAR
        EXTZV   #DEV$V_AVL, #1, R0, R0
        BRW     LONG
52$:    CMPL    R10, #DVI$_MNT
        BNEQ    54$
        BSBW    DEVCHAR
        EXTZV   #DEV$V_MNT, #1, R0, R0
        BRW     LONG
54$:    CMPL    R10, #DVI$_SWL
        BNEQ    56$
        BSBW    DEVCHAR
        EXTZV   #DEV$V_SWL, #1, R0, R0
        BRW     LONG
56$:    CMPL    R10, #DVI$_STS
        BNEQ    80$
        BSBW    ONLINE
        BRW     LONG
80$:    MOVL    #SS$_BADPARAM, R0
        RSB
; LONG: R0 = a value. Returns it as an item, a longword.
LONG:   MOVL    R0, VALUE
        MOVAB   VALUE, R1
        MOVL    #4, R2
; STRING: R1 and R2 = a string. Returns it as an item.
STRING: MOVL    #SS$_NORMAL, R0
        RSB

; MOUNTED: R5 = a device's VCB, or 0. R0 = 1 if a volume is mounted on
; it, else 0. Keeps every other register.
MOUNTED:
        CLRL    R0
        TSTL    R5
        BEQL    10$
        EXTZV   #VCB$V_MOUNTED, #1, VCB$L_STATUS(R5), R0
10$:    RSB

; $DEVICE_SCAN return_devnam, retlen, search_devnam, itmlst, contxt:
; finds the next device whose name matches search_devnam, with * and %
; wildcards, without its underscore or colon, or any device without one
; (or with an empty one), and of the class DVS$_DEVCLASS gives, if the
; item list has it. Writes its name, _DDCU:, to return_devnam's buffer,
; as much as fits, and its length to the word at retlen. contxt is a
; quadword, 0 to start from the first device, which it keeps where the
; scan is. SS$_NOMOREDEV after the last, SS$_BADPARAM for another item.
        .ENTRY  EXE$DEVICE_SCAN, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    4(AP), R1               ; the name's buffer
        IFNORD  #8, (R1), 85$
        MOVZWL  (R1), R9
        MOVL    4(R1), R11
        IFNOWRT R9, (R11), 85$
        MOVL    8(AP), R0
        BEQL    5$
        IFNOWRT #2, (R0), 85$
5$:     CLRL    R7                      ; the pattern: its length,
        MOVL    12(AP), R1
        BEQL    15$
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R7
        MOVL    4(R1), R6               ; its address
        TSTL    R7
        BEQL    15$
        CMPB    (R6), #^A/_/
        BNEQ    10$
        INCL    R6
        DECL    R7
10$:    TSTL    R7
        BEQL    15$
        CMPB    -1(R6)[R7], #^A/:/
        BNEQ    15$
        DECL    R7
15$:    MNEGL   #1, R10                 ; the class, -1 any
        MOVL    16(AP), R8
        BEQL    30$
20$:    IFNORD  #4, (R8), 85$
        TSTL    (R8)
        BEQL    30$
        IFNORD  #12, (R8), 85$
        MOVL    #SS$_BADPARAM, R0
        CMPW    2(R8), #DVS$_DEVCLASS
        BNEQ    90$
        IFNORD  #4, @4(R8), 85$
        MOVL    @4(R8), R10
        ADDL2   #12, R8
        BRB     20$
30$:    CLRL    R4                      ; where the scan is
        MOVL    20(AP), R8
        BEQL    40$
        IFNOWRT #8, (R8), 85$
        MOVL    (R8), R4
40$:    BSBW    DEVICE
        BLBC    R0, 90$
        INCL    R4
        TSTL    R10
        BLSS    45$
        MOVL    #DC$_TERM, R0
        TSTL    R5
        BEQL    42$
        MOVL    #DC$_DISK, R0
42$:    CMPL    R0, R10
        BNEQ    40$
45$:    BSBW    DEVNAME
        TSTL    R7
        BEQL    50$
        INCL    R1                      ; DDCU
        MOVL    #4, R2
        BSBW    FIL$MATCH
        BLBC    R0, 40$
        BSBW    DEVNAME
50$:    CMPL    R2, R9
        BLEQU   55$
        MOVL    R9, R2
55$:    CLRL    R3
60$:    CMPL    R3, R2
        BGEQU   65$
        MOVB    (R1)[R3], (R11)[R3]
        INCL    R3
        BRB     60$
65$:    MOVL    8(AP), R0
        BEQL    70$
        MOVW    R2, (R0)
70$:    TSTL    R8
        BEQL    75$
        MOVL    R4, (R8)
        CLRL    4(R8)
75$:    MOVL    #SS$_NORMAL, R0
        RET
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

        .END
