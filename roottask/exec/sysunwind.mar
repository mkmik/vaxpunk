        .TITLE  SYSUNWIND       Condition handling: exceptions, signals, $UNWIND and $PUTMSG
        .IDENT  /V0.1/
;
; A routine establishes a condition handler by writing its address at
; 0(FP), in its frame, as on the VAX (vtools/docs/macro32.md), or with
; LIB$ESTABLISH (sysexe/lib/signal.mar). A condition is signaled by an
; exception in an outer mode, or by LIB$SIGNAL: either way EXE$SIGNAL
; calls the handlers it finds, from the frame that signaled it out,
; with a signal array and a mechanism array ($CHFDEF), in the mode that
; signaled it. A handler continues, resignals, or calls $UNWIND to
; return from the frame that established it. A condition no handler
; takes goes to EXE$CATCHALL, which writes its message with $PUTMSG and,
; if it is severe, exits (ADR-0021).
;
; An exception reaches the executive in kernel mode (DESIGN-0001,
; *Exceptions*). EXE$ACVIOLAT and EXE$OPCDEC copy the PAL's frame, the
; registers and the two arrays below the stack of the mode that took
; it, and REI to EXE$SRCHANDLER there, which calls EXE$SIGNAL. A handler
; that continues goes back to the instruction that took it, or to the PC
; it wrote in the signal array.
;
; EXE$SRCHANDLER, EXE$SIGNAL, EXE$CATCHALL, $UNWIND and $PUTMSG run in
; outer modes, so they are in the vector, EXEC$VECTOR, which this module
; adds to after syssrv.mar's part (roottask/exec/syssrv.mar).
; A reserved PAL call's R7 is its code, as the PAL found it: vmacro keeps
; the real one in a scratch register, which REI restores, so it comes
; back only at the same PC.
; ponytail: no SS$_UNWIND call to the handlers of the frames $UNWIND
; removes, no exception vectors, and a handler's own conditions are
; searched for from its frame out through the frames already searched.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $CHFDEF
        $INTSTKDEF
        $IODEF
        $PALDEF
        $PSLDEF
        $SSDEF
        $STSDEF

        .EXTERNAL EXE$IMGEXIT, SYS$EXIT

; What EXE$ACVIOLAT and EXE$OPCDEC copy below the stack of the mode that
; took the exception, from its lowest address. EXE$SRCHANDLER pops it from
; there as it goes, the registers first, since what it calls goes below
; its SP, and REI the frame last.
REGS = 0                                ; R0-R11, AP and FP, as PUSHR leaves them
ARGS = REGS + 56                        ; the handlers' argument list: 2, then the arrays
MECH = ARGS + 12                        ; the mechanism array
SIG = MECH + 20                         ; the signal array, at most 6 longwords
FRAME = SIG + 24                        ; the PAL's frame, $INTSTKDEF, quadword aligned
AREA = FRAME + INTSTK$K_LENGTH          ; all of it, a multiple of 16

; EXE$SIGNAL's locals, below its FP, which SYS$UNWIND finds and writes.
UNW_LAST = -4                           ; the last frame $UNWIND removes, 0 if none
UNW_PC = -8                             ; where it goes on, 0 for the return address
UNW_FRAME0 = -12                        ; the frame that signaled
UNW_MCH = -16                           ; the mechanism array
UNW_LENGTH = 16

        .PSECT  $CODE$

; EXE$ACVIOLAT: the access violation handler. Below the PAL's frame, the
; VAX's parameters: a mask, bit 2 for a write, and the address. An outer
; mode took it, since one in kernel mode stops the system: signals
; SS$_ACCVIO there, with the mask and the address.
EXE$ACVIOLAT::
        .EXCEPTION_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, AP, FP>
        MOVL    #SS$_ACCVIO, R0
        MOVL    #2, R1
        BRB     REFLECT

; EXE$OPCDEC: the reserved instruction handler: privileged instructions
; and PAL calls, and undefined instructions, in an outer mode. Signals
; SS$_OPCDEC there.
EXE$OPCDEC::
        .EXCEPTION_ENTRY
        PUSHR   #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, AP, FP>
        MOVL    #SS$_OPCDEC, R0
        CLRL    R1
; REFLECT: R0 = the condition, R1 = the parameters the PAL pushed below
; its frame, 0 or 2 quadwords; below them, the registers of the mode that
; took the exception. Copies the frame, the registers and the arrays,
; AREA, below both its stack pointers, and REIs to EXE$SRCHANDLER in that
; mode, with its SP at them. If it can't write there, the image exits
; with the condition.
REFLECT:
        .GLOBAL_LABEL                   ; EXE$ACVIOLAT's and EXE$OPCDEC's
        MOVAB   56(SP), R2              ; the parameters
        ASHL    #3, R1, R4
        ADDL2   R2, R4                  ; the frame
        MOVL    INTSTK$Q_SP(R4), R5
        CMPL    INTSTK$Q_X_SP(R4), R5
        BGEQU   10$
        MOVL    INTSTK$Q_X_SP(R4), R5
10$:    BICL2   #15, R5
        SUBL2   #AREA, R5
        IFNOWRT #AREA, (R5), 90$
        MOVL    R4, R6
        MOVAB   FRAME(R5), R7
        MOVL    #INTSTK$K_LENGTH/4, R8
20$:    MOVL    (R6)+, (R7)+
        SOBGTR  R8, 20$
        MOVL    SP, R6
        MOVAB   REGS(R5), R7
        MOVL    #14, R8
30$:    MOVL    (R6)+, (R7)+
        SOBGTR  R8, 30$
        MOVL    INTSTK$Q_R7(R4), REGS+28(R5) ; R7, which PAL calls use, from the frame
        MOVL    #2, ARGS(R5)
        MOVAB   SIG(R5), ARGS+4(R5)
        MOVAB   MECH(R5), ARGS+8(R5)
        MOVL    #4, MECH(R5)
        MOVL    52(SP), MECH+CHF$L_MCH_FRAME(R5) ; its FP
        CLRL    MECH+CHF$L_MCH_DEPTH(R5)
        MOVQ    (SP), MECH+CHF$L_MCH_SAVR0(R5) ; R0 and R1
        ADDL3   #3, R1, SIG(R5)
        MOVL    R0, SIG+CHF$L_SIG_NAME(R5)
        MOVAB   SIG+CHF$L_SIG_ARG1(R5), R6
        TSTL    R1
        BEQL    40$
        MOVL    (R2), (R6)+             ; the mask
        MOVL    8(R2), (R6)+            ; the address
40$:    MOVL    INTSTK$Q_PC(R4), (R6)+
        MOVL    INTSTK$Q_PS(R4), (R6)
        MOVAB   EXE$SRCHANDLER, R0
        MOVL    R0, INTSTK$Q_PC(R4)
        CLRL    INTSTK$Q_PC+4(R4)
        MOVL    R5, INTSTK$Q_SP(R4)
        CLRL    INTSTK$Q_SP+4(R4)
        MOVL    R5, INTSTK$Q_X_SP(R4)
        CLRL    INTSTK$Q_X_SP+4(R4)
        MOVL    R4, SP
        REI
90$:    PUSHL   R0
        CALLS   #1, G^EXE$IMGEXIT

        .PSECT  EXEC$VECTOR, EXE, NOWRT, LONG
; EXE$SRCHANDLER: where an exception REIs to, in the mode that took it,
; with SP at what REFLECT copied. Calls EXE$SIGNAL with the registers the
; exception found, then, unless a handler unwound, EXE$CATCHALL if none
; took it, and goes back with REI, to the signal array's PC, with R0
; and R1 from the mechanism array. Not a routine.
EXE$SRCHANDLER::
        .EXCEPTION_ENTRY
        POPR    #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, AP, FP>
        CALLG   (SP), EXE$SIGNAL        ; SP is at ARGS
        BLBS    R0, 10$
        PUSHAB  SIG-ARGS(SP)
        CALLS   #1, EXE$CATCHALL
10$:    MOVL    SIG-ARGS(SP), R0        ; the count: the PC is the one before last
        MOVL    SIG-ARGS-4(SP)[R0], FRAME+INTSTK$Q_PC-ARGS(SP)
        MOVQ    MECH+CHF$L_MCH_SAVR0-ARGS(SP), R0
        MOVAB   FRAME-ARGS(SP), SP
        EVAX_STQ R0, INTSTK$Q_R0(SP)
        EVAX_STQ R1, INTSTK$Q_R1(SP)
        REI

; EXE$SIGNAL sigargs, mchargs: looks for a handler for the condition
; sigargs signals, from the frame mchargs has, the one that signaled it,
; its depth 0, out to its mode's first. It calls each handler on the
; way, at 0(FP) of its frame, with sigargs and mchargs, which have the
; frame and its depth. A handler returns SS$_CONTINUE, or any status
; with the low bit set, to go on where the condition was signaled, with
; R0 and R1 from mchargs, or SS$_RESIGNAL, or any with it clear, to let
; the next one have it; an $UNWIND it called takes effect as it returns.
; R0 = SS$_CONTINUE once a handler took it, SS$_RESIGNAL if none did.
; Doesn't return after an $UNWIND. Runs in the mode that signaled.
        .ENTRY  EXE$SIGNAL, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        SUBL2   #UNW_LENGTH, SP
        CLRQ    UNW_PC(FP)              ; and UNW_LAST
        MOVQ    4(AP), R6               ; R6 = sigargs, R7 = mchargs
        MOVL    R7, UNW_MCH(FP)
        MOVL    CHF$L_MCH_FRAME(R7), R2
        MOVL    R2, UNW_FRAME0(FP)
        CLRL    CHF$L_MCH_DEPTH(R7)
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_CURMOD, #2, R0, R8 ; the mode the frames are in
SEARCH:
        TSTL    R2
        BEQL    NONE
        IFNORD  #48, (R2), NONE, MODE=R8
        MOVL    (R2), R1                ; its handler
        BEQL    OUTWARD
        MOVL    R2, CHF$L_MCH_FRAME(R7)
        CALLG   (AP), (R1)
; HANDLER: where a handler returns to; SYS$UNWIND finds EXE$SIGNAL's
; frame by it.
HANDLER:
        TSTL    UNW_LAST(FP)
        BNEQ    UNWIND
        BLBC    R0, OUTWARD
        MOVL    #SS$_CONTINUE, R0
        RET
OUTWARD:
        MOVL    16(R2), R0              ; the caller's frame
        CMPL    R0, R2
        BLEQU   NONE                    ; not further out: no frame
        MOVL    R0, R2
        INCL    CHF$L_MCH_DEPTH(R7)
        BRB     SEARCH
NONE:   MOVL    #SS$_RESIGNAL, R0
        RET

; UNWIND: R7 = mchargs. Returns from the frame UNW_LAST says, as its RET
; would, having removed every frame from this one out to it: R2-R11 as
; each of them saved them, the outermost's last, so as they were in its
; caller; R0 and R1 from mchargs; AP, FP and SP from the frame. Goes on
; at UNW_PC, or else where the frame returns to.
UNWIND: MOVL    FP, R2
        MOVL    UNW_LAST(FP), R3
        MOVL    UNW_PC(FP), R4
        MOVQ    CHF$L_MCH_SAVR0(R7), R5 ; R5 and R6
        SUBL2   #52, SP                 ; R0-R11, then SP, for POPR
10$:    MOVL    40(R2), R8              ; the frame's entry mask
        MOVAB   48(R2), R9              ; what it saved, 8 bytes each
        CLRL    R10
20$:    BBC     R10, R8, 30$
        MOVL    (R9), (SP)[R10]
        ADDL2   #8, R9
30$:    AOBLSS  #12, R10, 20$
        CMPL    R2, R3
        BEQL    40$
        MOVL    16(R2), R2
        BRB     10$
40$:    MOVQ    R5, (SP)
        TSTL    R4
        BNEQ    50$
        MOVL    24(R2), R4              ; the return address
50$:    SUBL3   #4, 32(R2), R0          ; the caller's SP, less the address
        MOVL    R4, (R0)
        MOVL    R0, 48(SP)
        MOVL    8(R2), AP
        MOVL    16(R2), FP
        POPR    #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    (SP), SP
        JMP     @(SP)+

; $UNWIND [depadr] [,newpc]: in a condition handler, removes the frames
; from the one that signaled the condition out: as many as the longword
; at depadr says, or, without depadr, out to the one that established the
; handler. They go once the handler returns: the last one's caller goes
; on as if it had returned, or at newpc, with R0 and R1 from the
; mechanism array. SS$_NORMAL, and no unwind for a depth of 0 or less;
; SS$_NOSIGNAL outside a handler, SS$_UNWINDING if it asked already,
; SS$_INSFRAME if there are fewer frames, SS$_ACCVIO. Runs in the
; caller's mode.
        .ENTRY  SYS$UNWIND, ^M<R2, R3, R4>
        CALL_PAL #PAL$_RD_PS
        EXTZV   #PSL$V_CURMOD, #2, R0, R4
        MOVAB   HANDLER, R1
        MOVL    FP, R2
10$:    IFNORD  #48, (R2), 80$, MODE=R4
        CMPL    24(R2), R1
        BEQL    20$                     ; R2 is the handler's frame
        MOVL    16(R2), R0
        CMPL    R0, R2
        BLEQU   80$
        MOVL    R0, R2
        BRB     10$
20$:    MOVL    16(R2), R2              ; EXE$SIGNAL's
        TSTL    UNW_LAST(R2)
        BNEQ    82$
        MOVL    UNW_MCH(R2), R0
        ADDL3   #1, CHF$L_MCH_DEPTH(R0), R3
        CMPB    (AP), #1
        BLSSU   30$
        MOVL    4(AP), R0
        BEQL    30$
        IFNORD  #4, (R0), 84$, MODE=R4
        MOVL    (R0), R3
        BLEQ    70$
30$:    MOVL    UNW_FRAME0(R2), R0
        BRB     45$
40$:    MOVL    16(R0), R0
        BEQL    86$
        IFNORD  #48, (R0), 86$, MODE=R4
45$:    SOBGTR  R3, 40$
        MOVL    R0, UNW_LAST(R2)
        CLRL    UNW_PC(R2)
        CMPB    (AP), #2
        BLSSU   70$
        MOVL    8(AP), UNW_PC(R2)
70$:    MOVL    #SS$_NORMAL, R0
        RET
80$:    MOVL    #SS$_NOSIGNAL, R0
        RET
82$:    MOVL    #SS$_UNWINDING, R0
        RET
84$:    MOVL    #SS$_ACCVIO, R0
        RET
86$:    MOVL    #SS$_INSFRAME, R0
        RET

; EXE$CATCHALL sigargs: what becomes of a condition no handler took, as
; with VMS's catch-all handler: writes its message with $PUTMSG, without
; the PC and PSL, and, if it is severe, exits with it, STS$M_INHIB_MSG
; set, so that the command interpreter doesn't write it again, through
; the mode's exit handlers. Returns otherwise. Keeps every register but
; R0 and R1.
        .ENTRY  EXE$CATCHALL, ^M<R2>
        MOVL    4(AP), R2
        SUBL2   #2, (R2)
        PUSHL   R2
        CALLS   #1, SYS$PUTMSG
        ADDL2   #2, (R2)
        BICL3   #^C<STS$M_SEVERITY>, CHF$L_SIG_NAME(R2), R0
        CMPL    R0, #STS$K_SEVERE
        BNEQ    90$
        BISL3   #STS$M_INHIB_MSG, CHF$L_SIG_NAME(R2), -(SP)
        CALLS   #1, SYS$EXIT
90$:    RET

; $PUTMSG msgvec: writes the message msgvec has, a count, then a
; condition and its FAO arguments, on SYS$OUTPUT, or OPA0: for a process
; without one: $GETMSG's, with each !XB, !XW and !XL in it the next
; argument in hex, 2, 4 or 8 digits. A system condition's arguments
; follow it, as many as its message has, past the count if need be: an
; exception's PC and PSL, which EXE$CATCHALL's count leaves out, as on
; VMS. Another facility's follow their count, and are 0 past the last. R0 = $QIOW's status, or $ASSIGN's error. Runs in
; the caller's mode.
; ponytail: one message, no action routine or facility name, the FAO
; directives the executive's messages use, on SYS$OUTPUT, not SYS$ERROR.
        .ENTRY  SYS$PUTMSG, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    4(AP), R2
        SUBL2   #512, SP
        MOVL    SP, R3                  ; the text, 256 bytes
        MOVAB   256(SP), R4             ; the line, 256 bytes
        PUSHL   R3
        PUSHL   #256                    ; the text's descriptor
        MOVL    SP, R5
        CLRL    -(SP)                   ; its length
        MOVL    SP, R6
        $GETMSG_S MSGID=CHF$L_SIG_NAME(R2), MSGLEN=(R6), BUFADR=(R5)
        MOVZWL  (R6), R7
        MOVAB   CHF$L_SIG_ARG1(R2), R10
        MOVL    #255, R9                ; the arguments left: as many as it has
        BITL    #^XFFF0000, CHF$L_SIG_NAME(R2) ; the facility
        BEQL    5$
        SUBL3   #2, (R2), R9
        CMPL    (R10), R9
        BGEQU   4$
        MOVL    (R10), R9
4$:     ADDL2   #4, R10
5$:     CLRL    R8                      ; the line's length
        CLRL    R11                     ; where in the text
10$:    CMPL    R11, R7
        BGEQU   50$
        MOVZBL  (R3)[R11], R0
        INCL    R11
        CMPB    R0, #^A/!/
        BNEQ    40$
        SUBL3   R11, R7, R1
        CMPL    R1, #2
        BLSSU   40$                     ; no room for XL
        CMPB    (R3)[R11], #^A/X/
        BNEQ    40$
        MOVZBL  1(R3)[R11], R1
        MOVL    #2, R5                  ; the digits
        CMPB    R1, #^A/B/
        BEQL    20$
        MOVL    #4, R5
        CMPB    R1, #^A/W/
        BEQL    20$
        MOVL    #8, R5
        CMPB    R1, #^A/L/
        BNEQ    40$
20$:    ADDL2   #2, R11
        CLRL    R1
        TSTL    R9
        BEQL    25$
        DECL    R9
        MOVL    (R10)+, R1
25$:    SUBL3   R5, #8, R0
        ASHL    #2, R0, R0
        ROTL    R0, R1, R1              ; its first digit at the top
30$:    ROTL    #4, R1, R1
        EXTZV   #0, #4, R1, R0
        MOVZBL  HEX[R0], R0
        BSBB    PUT
        SOBGTR  R5, 30$
        BRB     10$
40$:    BSBB    PUT
        BRB     10$
50$:    MOVB    #13, (R4)[R8]
        MOVB    #10, 1(R4)[R8]
        ADDL2   #2, R8
        CLRL    -(SP)                   ; the channel
        MOVL    SP, R6
        $ASSIGN_S DEVNAM=OUTPUT, CHAN=(R6)
        BLBS    R0, 60$
        $ASSIGN_S DEVNAM=OPA0, CHAN=(R6)
        BLBC    R0, 90$
60$:    $QIOW_S CHAN=(R6), FUNC=#IO$_WRITEVBLK, P1=(R4), P2=R8
        PUSHL   R0
        $DASSGN_S CHAN=(R6)
        MOVL    (SP)+, R0
90$:    RET

; PUT: R0 = a character, R4 = the line, R8 = its length. Appends the
; character, if there is room for it and CR LF.
PUT:
        .JSB_ENTRY  SCRATCH=<R8>
        CMPL    R8, #254
        BGEQU   10$
        MOVB    R0, (R4)[R8]
        INCL    R8
10$:    RSB

HEX:    .ASCII  "0123456789ABCDEF"      ; a hex digit's character
OUTPUT: .ASCID  "SYS$OUTPUT"            ; where $PUTMSG writes
OPA0:   .ASCID  "OPA0:"                 ; or, without it, the console

        .END
