        .TITLE  PROCESS Process creation, deletion and control
        .IDENT  /V0.1/
;
; A process is a PCB, a kernel stack and an image, all in the address space
; every process shares, and a thread the PAL makes the first time the
; scheduler switches to the process's HWPCB. $CREPRC builds the PCB and a
; kernel stack holding the frame REI pops, which starts the process at
; EXE$PROCSTRT, in kernel mode at IPL 0. There it activates its image from
; the boot volume and calls it; when the image returns, or calls $EXIT,
; the process is deleted, as a VMS process is when its image exits and it
; has no command interpreter (docs/design/0002-executive-processes.md).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $PALDEF
        $PCBDEF
        $STATEDEF
        $RPBDEF
        $HWPCBDEF
        $INTSTKDEF
        $BVDDEF
        $PTEDEF
        $PRTDEF
        $SSDEF

        .EXTERNAL SCH$GL_CURPCB, SCH$GL_SWPPCB, SCH$GL_PCBVEC, SCH$GL_SEQ
        .EXTERNAL SCH$GQ_HIBWQ, SCH$GQ_SUSPWQ, SCH$GQ_DELQ
        .EXTERNAL SCH$REMCOM, SCH$MAKECOM, SCH$WAKEPCB, SCH$WAKE, SCH$WAIT
        .EXTERNAL SCH$SCHED, SCH$DACEFC_ALL, SGN$GW_QUANTUM
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ, MMG$CREPAG, MMG$DELPAG
        .EXTERNAL MMG$SETPRT, EXE$GL_RPB
        .EXTERNAL EXE$OUTZSTRING, EXE$OUTCSTRING, EXE$OUTHEX, EXE$OUTCRLF

KSTACK = 16384                          ; a process's kernel stack
IMG_BASE = ^X01000000                   ; where process images go
IMG_END = ^X1FFF0000
KW = PTE$M_VALID ! <PRT$C_KW @ PTE$V_PROT>
KR = PTE$M_VALID ! <PRT$C_KR @ PTE$V_PROT>
; Image header fields (vtools/docs/image-format.md).
EIHD$L_SIZE = 8
EIHD$L_ISDOFF = 12
EIHD$L_ACTIVOFF = 16
EIHD$L_IMGTYPE = 52
EIHD$L_LNKFLAGS = 80
EIHD$L_ARCH = 112
EIHA$Q_TFRADR1 = 8
EISD$L_EISDSIZE = 8
EISD$L_SECSIZE = 12
EISD$Q_VIRT_ADDR = 16
EISD$L_FLAGS = 24
EISD$L_VBN = 28
EISD$V_GBL = 0
EISD$V_DZRO = 2
EISD$V_WRT = 3
EISD$V_EXE = 11

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
EXITMSG:
        .ASCIZ  "%EXEC-W-EXITED, process "
EXITMSG2:
        .ASCIZ  " exited with status "

        .PSECT  $CODE$

; EXE$MATCHNAME: compares the .ASCIC string at R0 with the R7 bytes at R6.
; R0 = 1 if they are the same, else 0. Uses R1.
EXE$MATCHNAME::
        CMPB    (R0)+, R7
        BNEQ    20$
        CLRL    R1
10$:    CMPL    R1, R7
        BEQL    30$
        CMPB    (R0)[R1], (R6)[R1]
        BNEQ    20$
        INCL    R1
        BRB     10$
20$:    CLRL    R0
        RSB
30$:    MOVL    #1, R0
        RSB

; COPYNAME: copies R7 bytes from R1 to R0. Uses R5.
COPYNAME:
        CLRL    R5
        BRB     20$
10$:    MOVB    (R1)[R5], (R0)[R5]
        INCL    R5
20$:    CMPL    R5, R7
        BLSSU   10$
        RSB

; EXE$NAMPID: R4 = the current PCB, R2 = a pidadr argument and R3 = a
; prcnam argument, each an address or 0. Finds the process they name: by
; PID if pidadr points at one that isn't 0, else by name if there is
; prcnam, else the current process. R1 = its PCB, R0 = SS$_NORMAL,
; SS$_NONEXPR or SS$_IVLOGNAM. Its PID goes to pidadr. IPL$_SYNCH.
EXE$NAMPID::
        PUSHR   #^M<R5, R6, R7>
        TSTL    R2
        BEQL    20$
        MOVL    (R2), R0
        BEQL    20$
        MOVZWL  R0, R1                  ; the PID's index
        CMPL    R1, #SCH$C_MAXPIX
        BGEQU   80$
        MOVL    SCH$GL_PCBVEC[R1], R1
        BEQL    80$
        CMPL    PCB$L_PID(R1), R0
        BNEQ    80$
        BRB     70$
20$:    TSTL    R3
        BNEQ    30$
        MOVL    R4, R1
        BRB     60$
30$:    MOVZWL  (R3), R7
        CMPL    R7, #15
        BGTRU   85$
        MOVL    4(R3), R6
        MOVL    #SCH$C_MAXPIX-1, R5
40$:    MOVL    SCH$GL_PCBVEC[R5], R1
        BEQL    50$
        MOVAB   PCB$T_LNAME(R1), R0
        PUSHL   R1
        BSBW    EXE$MATCHNAME
        MOVL    (SP)+, R1
        BLBS    R0, 60$
50$:    SOBGTR  R5, 40$
        BRB     80$
60$:    TSTL    R2
        BEQL    70$
        MOVL    PCB$L_PID(R1), (R2)
70$:    MOVL    #SS$_NORMAL, R0
75$:    POPR    #^M<R5, R6, R7>
        RSB
80$:    MOVL    #SS$_NONEXPR, R0
        BRB     75$
85$:    MOVL    #SS$_IVLOGNAM, R0
        BRB     75$

; $CREPRC pidadr, image, input, output, error, prvadr, quota, prcnam,
; baspri, uic, mbxunt, stsflg: makes a process that runs image, called
; prcnam, at priority baspri, and puts its PID in pidadr. The other
; arguments are ignored: there is no I/O, privilege, quota or UIC yet.
        .ENTRY  EXE$CREPRC, ^M<R2, R3, R4, R5, R6, R7, R8>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    8(AP), R6               ; the image's descriptor
        BEQL    85$
        MOVZWL  (R6), R7
        BEQL    85$
        CMPL    R7, #39
        BGTRU   85$
        MOVL    32(AP), R3              ; the name's, or 0
        BEQL    10$
        CMPW    (R3), #15
        BGTRU   85$
10$:    MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R2, R8
        MOVL    #PCB$K_LENGTH/8, R0
        MOVL    R8, R1
15$:    CLRQ    (R1)+
        SOBGTR  R0, 15$
        MOVW    #PCB$K_LENGTH, PCB$W_SIZE(R8)
        MOVB    #DYN$C_PCB, PCB$B_TYPE(R8)
        MOVAB   PCB$T_IMAGE(R8), R0
        MOVB    R7, (R0)+
        MOVL    4(R6), R1
        BSBB    COPYNAME
        TSTL    R3
        BEQL    20$
        MOVZWL  (R3), R7
        MOVAB   PCB$T_LNAME(R8), R0
        MOVB    R7, (R0)+
        MOVL    4(R3), R1
        BSBB    COPYNAME
20$:    BICL3   #^C31, 36(AP), R0
        MOVB    R0, PCB$B_PRI(R8)
        MOVB    R0, PCB$B_PRIB(R8)
        MNEGW   SGN$GW_QUANTUM, PCB$W_QUANT(R8)
        MOVL    PCB$L_PID(R4), PCB$L_OWNER(R8)
        MOVAB   PCB$Q_HWPCB(R8), PCB$L_HWPCB(R8)
; The kernel stack, and on it the frame the PAL pops, as REI does, when
; the process first runs: PC EXE$PROCSTRT, PSL kernel mode at IPL 0.
        MOVL    #KSTACK, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, PCB$L_KSTACK(R8)
        ADDL2   #KSTACK, R2
        SUBL3   #INTSTK$K_LENGTH, R2, R1
        MOVL    R1, PCB$Q_HWPCB+HWPCB$Q_KSP(R8)
        MOVL    #INTSTK$K_LENGTH/8, R0
        MOVL    R1, R5
25$:    CLRQ    (R5)+
        SOBGTR  R0, 25$
        MOVAB   EXE$PROCSTRT, INTSTK$Q_PC(R1)
        MOVL    R2, INTSTK$Q_SP(R1)
        MOVL    R2, INTSTK$Q_X_SP(R1)
; A unique name, a slot and a PID, and on the COM queue.
        DSBINT  #IPL$_SYNCH
        TSTB    PCB$T_LNAME(R8)
        BEQL    30$
        PUSHL   R2
        CLRL    R2
        BSBW    EXE$NAMPID
        MOVL    (SP)+, R2
        BLBS    R0, 75$
30$:    MOVL    #2, R5
35$:    TSTL    SCH$GL_PCBVEC[R5]
        BEQL    40$
        AOBLSS  #SCH$C_MAXPIX, R5, 35$
        BRB     76$
40$:    MOVL    R8, SCH$GL_PCBVEC[R5]
        INCL    SCH$GL_SEQ
        MOVZWL  SCH$GL_SEQ, R0
        ASHL    #16, R0, R0
        BISL3   R5, R0, PCB$L_PID(R8)
        PUSHL   R4
        MOVL    R8, R4
        BSBW    SCH$MAKECOM
        MOVL    (SP)+, R4
        MOVL    4(AP), R0
        BEQL    45$
        MOVL    PCB$L_PID(R8), (R0)
45$:    ENBINT
        MOVL    #SS$_NORMAL, R0
        RET
75$:    MOVL    #SS$_DUPLNAM, R0
        BRB     77$
76$:    MOVL    #SS$_EXQUOTA, R0
77$:    ENBINT
        PUSHL   R0
        MOVL    PCB$L_KSTACK(R8), R0
        MOVL    #KSTACK, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
80$:    PUSHL   R0
        MOVL    R8, R0
        MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        RET
85$:    MOVL    #SS$_IVLOGNAM, R0
90$:    RET

; EXE$PROCSTRT: where a process starts, in kernel mode at IPL 0 on its
; kernel stack. Activates its image, calls it, and exits with the status
; it returns.
EXE$PROCSTRT::
        MOVL    SCH$GL_CURPCB, R4
        BSBW    EXE$IMGACT
        BLBC    R0, 10$
        CALLS   #0, (R1)
10$:    $EXIT_S R0
        HALT                            ; $EXIT doesn't return

; FIL$OPENFILE: R6 = a file name, R7 = its length. Finds the file on the
; boot volume: R1 = its address, R2 = its size, R0 = SS$_NORMAL or
; SS$_NOSUCHFILE. Uses R3 and R5.
; ponytail: the boot volume's directory; Files-11 with a disk driver.
FIL$OPENFILE::
        MOVL    EXE$GL_RPB, R2
        MOVL    RPB$L_VOLUME(R2), R3
        MOVL    #BVD$C_BLOCK/BVD$K_LENGTH, R5
10$:    TSTB    (R3)
        BEQL    90$
        MOVL    R3, R0
        BSBW    EXE$MATCHNAME
        BLBS    R0, 20$
        ADDL2   #BVD$K_LENGTH, R3
        SOBGTR  R5, 10$
90$:    MOVL    #SS$_NOSUCHFILE, R0
        RSB
20$:    MULL3   #BVD$C_BLOCK, BVD$L_LBN(R3), R1
        ADDL2   RPB$L_VOLUME(R2), R1
        MOVL    BVD$L_SIZE(R3), R2
        MOVL    #SS$_NORMAL, R0
        RSB

; NEXTISD: R8 = an image file, R10 = the offset of an EISD in its header.
; R3 = that EISD, or 0 past the last, and R10 = the next one's offset.
; Uses R0.
NEXTISD:
10$:    CMPL    R10, EIHD$L_SIZE(R8)
        BGEQU   30$
        ADDL3   R8, R10, R3
        MOVL    EISD$L_EISDSIZE(R3), R0
        BEQL    30$
        CMPL    R0, #-1
        BNEQ    20$
        ADDL2   #BVD$C_BLOCK, R10       ; on in the next block
        BICL2   #BVD$C_BLOCK-1, R10
        BRB     10$
20$:    ADDL2   R0, R10
        RSB
30$:    CLRL    R3
        RSB

; EXE$IMGACT: R4 = the current PCB. Activates the image the PCB names:
; maps its sections at their addresses, which no other process's image may
; use, with their contents and protection. R1 = its transfer address,
; R0 = SS$_NORMAL, SS$_NOSUCHFILE, SS$_BADIMGHDR, SS$_VASFULL or
; SS$_INSFMEM.
; ponytail: images run where they are linked; the EIAF moves them.
EXE$IMGACT::
        PUSHR   #^M<R2, R3, R5, R6, R7, R8, R9, R10, R11>
        MOVZBL  PCB$T_IMAGE(R4), R7
        MOVAB   PCB$T_IMAGE+1(R4), R6
        BSBW    FIL$OPENFILE
        BLBC    R0, 99$
        MOVL    R1, R8
        CMPL    (R8), #3                ; an ARM64 executable image
        BNEQ    90$
        CMPL    EIHD$L_IMGTYPE(R8), #1
        BNEQ    90$
        CMPL    EIHD$L_ARCH(R8), #183
        BNEQ    90$
        BBS     #1, EIHD$L_LNKFLAGS(R8), 90$    ; no transfer address
; Its address range.
        MOVL    #-1, R9                 ; the lowest
        CLRL    R11                     ; past the highest
        MOVL    EIHD$L_ISDOFF(R8), R10
10$:    BSBW    NEXTISD
        TSTL    R3
        BEQL    20$
        BBS     #EISD$V_GBL, EISD$L_FLAGS(R3), 90$
        TSTL    EISD$Q_VIRT_ADDR+4(R3)
        BNEQ    90$
        MOVL    EISD$Q_VIRT_ADDR(R3), R0
        CMPL    R0, R9
        BGEQU   12$
        MOVL    R0, R9
12$:    ADDL2   EISD$L_SECSIZE(R3), R0
        ADDL2   #MMG$C_PAGESIZE-1, R0
        BICL2   #MMG$C_PAGESIZE-1, R0
        CMPL    R0, R11
        BLEQU   10$
        MOVL    R0, R11
        BRB     10$
20$:    CMPL    R9, #IMG_BASE
        BLSSU   95$
        CMPL    R11, #IMG_END
        BGTRU   95$
        DSBINT  #IPL$_SYNCH             ; no other image there
        MOVL    #SCH$C_MAXPIX-1, R5
30$:    MOVL    SCH$GL_PCBVEC[R5], R0
        BEQL    35$
        CMPL    R0, R4
        BEQL    35$
        CMPL    R9, PCB$L_IMGEND(R0)
        BGEQU   35$
        CMPL    R11, PCB$L_IMGBAS(R0)
        BLEQU   35$
        ENBINT
        BRB     95$
35$:    SOBGTR  R5, 30$
        MOVL    R9, PCB$L_IMGBAS(R4)
        MOVL    R11, PCB$L_IMGEND(R4)
        ENBINT
; Each section: zeroed pages, the contents, the protection.
        MOVL    EIHD$L_ISDOFF(R8), R10
40$:    BSBW    NEXTISD
        TSTL    R3
        BEQL    60$
        MOVL    EISD$Q_VIRT_ADDR(R3), R0
        MOVL    EISD$L_SECSIZE(R3), R1
        ADDL2   #MMG$C_PAGESIZE-1, R1
        ASHL    #-MMG$C_VPCTX, R1, R1
        MOVL    #KW, R2
        PUSHR   #^M<R0, R1>
        BSBW    MMG$CREPAG
        BLBC    R0, 92$
        BBS     #EISD$V_DZRO, EISD$L_FLAGS(R3), 45$
        SUBL3   #1, EISD$L_VBN(R3), R0
        MULL2   #BVD$C_BLOCK, R0
        ADDL2   R8, R0
        PUSHL   R3
        MOVC3   EISD$L_SECSIZE(R3), (R0), @EISD$Q_VIRT_ADDR(R3)
        MOVL    (SP)+, R3
45$:    POPR    #^M<R0, R1>
        BBS     #EISD$V_WRT, EISD$L_FLAGS(R3), 40$
        MOVL    #KR, R2
        BBC     #EISD$V_EXE, EISD$L_FLAGS(R3), 50$
        BISL2   #PTE$M_EXEC, R2
50$:    BSBW    MMG$SETPRT
        BRB     40$
60$:    ADDL3   R8, EIHD$L_ACTIVOFF(R8), R0
        MOVL    EIHA$Q_TFRADR1(R0), R1
        MOVL    #SS$_NORMAL, R0
99$:    POPR    #^M<R2, R3, R5, R6, R7, R8, R9, R10, R11>
        RSB
90$:    MOVL    #SS$_BADIMGHDR, R0
        BRB     99$
92$:    ADDL2   #8, SP                  ; R0 and R1, keeping the status
        BRB     99$
95$:    MOVL    #SS$_VASFULL, R0
        BRB     99$

; $EXIT code: ends the image. A process has no command interpreter yet, so
; its image's end is its own: it is deleted. A failure status is reported
; on the console, as a command interpreter would. Doesn't return.
        .ENTRY  EXE$EXIT, ^M<>
        MOVL    SCH$GL_CURPCB, R4
        BLBS    4(AP), 10$
        DSBINT  #IPL$_SYNCH             ; the console, a line at a time
        MOVAB   EXITMSG, R1
        JSB     G^EXE$OUTZSTRING
        MOVAB   PCB$T_LNAME(R4), R1
        JSB     G^EXE$OUTCSTRING
        MOVAB   EXITMSG2, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    4(AP), R1
        JSB     G^EXE$OUTHEX
        JSB     G^EXE$OUTCRLF
        ENBINT
10$:    BRW     EXE$DELSELF

; EXE$RUNDOWN: R4 = a PCB. Gives back what its process holds: its image's
; pages, its common event flag clusters and its slot. Uses R0-R3.
; ponytail: pages from $CRETVA and $EXPREG stay; per-process address
; spaces will take them with the process.
EXE$RUNDOWN::
        MOVL    PCB$L_IMGBAS(R4), R0
        SUBL3   R0, PCB$L_IMGEND(R4), R1
        ASHL    #-MMG$C_VPCTX, R1, R1
        BSBW    MMG$DELPAG
        CLRQ    PCB$L_IMGBAS(R4)
        BSBW    SCH$DACEFC_ALL
        DSBINT  #IPL$_SYNCH
        MOVZWL  PCB$L_PID(R4), R0
        CLRL    SCH$GL_PCBVEC[R0]
        ENBINT
        RSB

; EXE$DELSELF: R4 = the current PCB. Deletes the current process: runs it
; down, leaves it for the swapper, which deletes its context, kernel stack
; and PCB, and gives up the CPU for good.
EXE$DELSELF::
        BSBW    EXE$RUNDOWN
        SETIPL  #IPL$_SYNCH
        CLRL    PCB$L_STATE(R4)
        INSQUE  (R4), @SCH$GQ_DELQ+4
        MOVL    SCH$GL_SWPPCB, R1
        BSBW    SCH$WAKE
        BSBW    SCH$SCHED
        HALT                            ; the CPU never comes back

; EXE$DELETEPCB: R4 = the PCB of a deleted process that isn't running.
; Deletes its context, kernel stack and PCB. Uses R0 and R1.
EXE$DELETEPCB::
        MOVL    PCB$L_HWPCB(R4), R0
        CALL_PAL #PAL$_DELCTX
        MOVL    PCB$L_KSTACK(R4), R0
        MOVL    #KSTACK, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    R4, R0
        MOVL    #PCB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        RSB

; $DELPRC pidadr, prcnam: deletes a process, the current one if none is
; named. Another process isn't running, so it is in a queue: it leaves it,
; and is deleted from here.
; ponytail: from outside, not by a kernel AST in its own context, which is
; fine while a process holds nothing but its queue entry.
        .ENTRY  EXE$DELPRC, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    R1, SCH$GL_SWPPCB
        BEQL    80$
        CMPL    R1, R4
        BEQL    50$
        MOVL    R1, R4
        CMPL    PCB$L_STATE(R4), #SCH$C_COM
        BNEQ    20$
        BSBW    SCH$REMCOM
        BRB     30$
20$:    REMQUE  (R4), R0
30$:    CLRL    PCB$L_STATE(R4)
        MOVZWL  PCB$L_PID(R4), R0
        CLRL    SCH$GL_PCBVEC[R0]       ; no one finds it any more
        ENBINT
        BSBW    EXE$RUNDOWN
        BSBW    EXE$DELETEPCB
        MOVL    #SS$_NORMAL, R0
        RET
50$:    ENBINT
        BRW     EXE$DELSELF
80$:    MOVL    #SS$_NOPRIV, R0
90$:    ENBINT
        RET

; $HIBER: sleeps until a $WAKE, or returns at once if one came since the
; last $HIBER.
        .ENTRY  EXE$HIBER, ^M<R4>
        MOVL    SCH$GL_CURPCB, R4
        DSBINT  #IPL$_SYNCH
        BBCC    #PCB$V_WAKEPEN, PCB$L_STS(R4), 10$
        BRB     20$
10$:    MOVL    #SCH$C_HIB, PCB$L_STATE(R4)
        MOVAQ   SCH$GQ_HIBWQ, R0
        BSBW    SCH$WAIT
20$:    ENBINT
        MOVL    #SS$_NORMAL, R0
        RET

; $WAKE pidadr, prcnam: wakes a hibernating process.
        .ENTRY  EXE$WAKE, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        BSBW    SCH$WAKE
90$:    ENBINT
        RET

; $SUSPND pidadr, prcnam, flags: suspends a process until a $RESUME. One
; that waits is suspended when its wait ends.
        .ENTRY  EXE$SUSPND, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    R1, SCH$GL_SWPPCB
        BEQL    80$
        CMPL    R1, R4
        BEQL    40$
        CMPL    PCB$L_STATE(R1), #SCH$C_COM
        BEQL    30$
        CMPL    PCB$L_STATE(R1), #SCH$C_SUSP
        BEQL    90$
        BBSS    #PCB$V_SUSPEN, PCB$L_STS(R1), 90$
        BRB     90$
30$:    PUSHL   R4
        MOVL    R1, R4
        BSBW    SCH$REMCOM
        BSBB    SUSPEND
        MOVL    (SP)+, R4
        BRB     90$
40$:    BSBB    SUSPEND
        BSBW    SCH$SCHED
        MOVL    #SS$_NORMAL, R0
90$:    ENBINT
        RET
80$:    MOVL    #SS$_NOPRIV, R0
        BRB     90$

SUSPEND:
        MOVL    #SCH$C_SUSP, PCB$L_STATE(R4)
        INSQUE  (R4), @SCH$GQ_SUSPWQ+4
        RSB

; $RESUME pidadr, prcnam: resumes a suspended process.
        .ENTRY  EXE$RESUME, ^M<R2, R3, R4>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        CMPL    PCB$L_STATE(R1), #SCH$C_SUSP
        BEQL    20$
        BBCC    #PCB$V_SUSPEN, PCB$L_STS(R1), 90$
        BRB     90$
20$:    MOVL    R1, R4
        BSBW    SCH$WAKEPCB
90$:    ENBINT
        RET

; $SETPRI pidadr, prcnam, pri, prvpri: sets a process's priority, base and
; current, and puts the old base priority in prvpri.
        .ENTRY  EXE$SETPRI, ^M<R2, R3, R4, R5>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R2
        MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH
        BSBW    EXE$NAMPID
        BLBC    R0, 90$
        MOVL    16(AP), R0
        BEQL    10$
        MOVZBL  PCB$B_PRIB(R1), (R0)
10$:    BICL3   #^C31, 12(AP), R5
        MOVB    R5, PCB$B_PRIB(R1)
        CMPL    PCB$L_STATE(R1), #SCH$C_COM
        BNEQ    20$
        PUSHL   R4
        MOVL    R1, R4
        BSBW    SCH$REMCOM
        MOVB    R5, PCB$B_PRI(R4)
        BSBW    SCH$MAKECOM
        MOVL    (SP)+, R4
        BRB     30$
20$:    MOVB    R5, PCB$B_PRI(R1)
        CMPL    R1, R4
        BNEQ    30$
        SOFTINT #IPL$_RESCHED           ; lower now: maybe another runs first
30$:    MOVL    #SS$_NORMAL, R0
90$:    ENBINT
        RET

; $SETPRN prcnam: renames the current process.
        .ENTRY  EXE$SETPRN, ^M<R2, R3, R4, R5, R6, R7>
        MOVL    SCH$GL_CURPCB, R4
        MOVL    4(AP), R3
        BEQL    85$
        MOVZWL  (R3), R7
        CMPL    R7, #15
        BGTRU   85$
        DSBINT  #IPL$_SYNCH
        CLRL    R2
        BSBW    EXE$NAMPID
        BLBC    R0, 10$
        CMPL    R1, R4
        BNEQ    80$
10$:    MOVAB   PCB$T_LNAME(R4), R0
        MOVB    R7, (R0)+
        MOVL    4(R3), R1
        BSBW    COPYNAME
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_DUPLNAM, R0
90$:    ENBINT
        RET
85$:    MOVL    #SS$_IVLOGNAM, R0
        RET

; $CMKRNL routin, arglst: calls routin in kernel mode, where every process
; already runs, with arglst.
        .ENTRY  EXE$CMKRNL, ^M<>
        CALLG   @8(AP), @4(AP)
        RET

        .END
