        .TITLE  F11     The system disk, a Files-11 ODS-2 volume, read only
        .IDENT  /V0.1/
;
; The system disk, DKA0:, is a Files-11 ODS-2 volume (ods/docs/) that the
; PAL reads a block at a time with READLBLK. FIL$MOUNT mounts it at boot:
; it reads the home block and keeps the index file's header, through
; which every other file's header is found. The rest reads what VMS's
; XQP reads: a file's header by its number, its blocks through the
; header's map, and a directory's records, with wildcards. RMS (rms.mar)
; and the image activator call them at IPL$_SYNCH, which keeps their
; buffers to one caller at a time.
; ponytail: read only; no extension headers, so a file's map is what its
; one header holds; the disk read waits for the device, at IPL$_SYNCH.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PALDEF
        $IPLDEF
        $SSDEF
        $RMSDEF

        .EXTERNAL EXE$OUTZSTRING, EXE$OUTCSTRING, EXE$OUTCRLF
        .EXTERNAL EXE$ALONONPAGED, EXE$DEANONPGDSIZ, RMS$PARSE, RMS$FIND

BLOCK = 512
MAXREAD = 127                           ; blocks a READLBLK reads, below 64 KB
MFD = 4                                 ; the MFD's file number
; The home block.
HM2$W_IBMAPVBN = 22
HM2$L_IBMAPLBN = 24
HM2$W_IBMAPSIZE = 32
HM2$T_VOLNAME = 472
HM2$T_FORMAT = 496
; A file header.
FH2$B_MPOFFSET = 1
FH2$W_FID = 8
FH2$B_FID_NMX = 13
FH2$W_RECATTR = 20
FH2$L_FILECHAR = 52
FH2$B_MAP_INUSE = 58
FH2$W_CHECKSUM = 510
FCH$V_DIRECTORY = 13
; Its record attributes, at FH2$W_RECATTR.
FAT$B_RTYPE = 0
FAT$B_RATTRIB = 1
FAT$W_RSIZE = 2
FAT$L_HIBLK = 4                         ; high word first
FAT$L_EFBLK = 8                         ; high word first
FAT$W_FFBYTE = 12
FAT$B_VFCSIZE = 15
FAT$W_MAXREC = 16

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
F11$GL_HDRVBN::                         ; INDEXF.SYS's VBN of file 1's header
        .LONG   0
F11$AB_INDEXF::                         ; INDEXF.SYS's header
        .BLKB   BLOCK
F11$AB_DIRBLK::                         ; the directory block FIL$SEARCHDIR reads
        .BLKB   BLOCK
F11$AB_FILHDR::                         ; the header FIL$OPENFILE reads
        .BLKB   BLOCK
F11$GW_FID::                            ; the file ID FIL$SEARCHDIR found
        .BLKW   3
F11$T_VOLNAME::                         ; the volume's label, .ASCIC
        .BLKB   13
F11$T_FORMAT:
        .ASCII  "DECFILE11B"
MOUNTED:
        .ASCIZ  "%MOUNT-I-MOUNTED, "
ONDKA0: .ASCIZ  " mounted on _DKA0:"
IMAGEDEF:                               ; where images are, SYS$SYSTEM
        .ASCIC  "DKA0:[SYSEXE]"

        .PSECT  $CODE$

; FIL$READLBLK: R0 = a buffer, R1 = a block count, R2 = an LBN. Reads the
; blocks from the disk. R0 = SS$_NORMAL, or the PAL's error. Uses R1.
FIL$READLBLK::
        MULL2   #BLOCK, R1
        CALL_PAL #PAL$_READLBLK
        RSB

; FIL$MOUNT: mounts the system disk: reads its home block and INDEXF.SYS's
; header, which maps the others, and reports it on the console. R0 =
; SS$_NORMAL, SS$_BADFILEHDR if there is no ODS-2 home block, or the
; disk's error. Uses R0-R4.
FIL$MOUNT::
        MOVAB   F11$AB_INDEXF, R3       ; the home block, for now
        MOVL    R3, R0
        MOVL    #1, R1
        MOVL    #1, R2
        BSBB    FIL$READLBLK
        BLBC    R0, 90$
        CLRL    R1
10$:    CMPB    HM2$T_FORMAT(R3)[R1], F11$T_FORMAT[R1]
        BNEQ    80$
        AOBLSS  #10, R1, 10$
        MOVL    #12, R0                 ; the label, without its trailing blanks
15$:    CMPB    HM2$T_VOLNAME-1(R3)[R0], #^A/ /
        BNEQ    20$
        SOBGTR  R0, 15$
20$:    MOVB    R0, F11$T_VOLNAME
        MOVC3   R0, HM2$T_VOLNAME(R3), F11$T_VOLNAME+1
        MOVAB   F11$AB_INDEXF, R3
        MOVZWL  HM2$W_IBMAPVBN(R3), R0
        MOVZWL  HM2$W_IBMAPSIZE(R3), R1
        ADDL3   R0, R1, F11$GL_HDRVBN
        ADDL3   HM2$L_IBMAPLBN(R3), R1, R2      ; file 1's header
        MOVAB   F11$AB_INDEXF, R0
        MOVL    #1, R1
        BSBB    FIL$READLBLK
        BLBC    R0, 90$
        MOVL    #1, R0                  ; checked, as any other header
        MOVAB   F11$AB_INDEXF, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVAB   MOUNTED, R1
        JSB     G^EXE$OUTZSTRING
        MOVAB   F11$T_VOLNAME, R1
        JSB     G^EXE$OUTCSTRING
        MOVAB   ONDKA0, R1
        JSB     G^EXE$OUTZSTRING
        JSB     G^EXE$OUTCRLF
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADFILEHDR, R0
90$:    RSB

; FIL$MAPVBN: R0 = a VBN, R1 = a file header. R0 = the LBN the header's
; map gives it, R1 = the blocks from there to its extent's end; both 0 if
; the map ends first. Keeps every other register.
FIL$MAPVBN::
        PUSHR   #^M<R2, R3, R4, R5, R6>
        MOVZBL  FH2$B_MPOFFSET(R1), R2
        MOVAW   (R1)[R2], R2            ; the map
        MOVZBL  FH2$B_MAP_INUSE(R1), R3
        MOVAW   (R2)[R3], R3            ; past it
        MOVL    #1, R6                  ; the pointer's first VBN
10$:    CMPL    R2, R3
        BGEQU   80$
        MOVZWL  (R2), R4
        EXTZV   #14, #2, R4, R5         ; the format
        CASEL   R5, #0, #3
20$:    .WORD   30$-20$, 40$-20$, 50$-20$, 60$-20$
30$:    ADDL2   #2, R2                  ; 0: placement, maps nothing
        BRB     10$
40$:    MOVZBL  R4, R5                  ; 1: the count in 7:0, the LBN's
        EXTZV   #8, #6, R4, R1          ; high bits in 13:8, then a word
        ASHL    #16, R1, R1
        MOVW    2(R2), R1
        ADDL2   #4, R2
        BRB     70$
50$:    BICL3   #^XC000, R4, R5         ; 2: the count in 13:0, a longword LBN
        MOVL    2(R2), R1
        ADDL2   #6, R2
        BRB     70$
60$:    BICL3   #^XC000, R4, R5         ; 3: a 30-bit count, a longword LBN
        ASHL    #16, R5, R5
        MOVW    2(R2), R5
        MOVL    4(R2), R1
        ADDL2   #8, R2
70$:    INCL    R5                      ; counts are one less
        ADDL3   R6, R5, R4              ; past the pointer's last VBN
        CMPL    R0, R4
        BLSSU   75$
        MOVL    R4, R6
        BRB     10$
75$:    SUBL3   R0, R4, R4              ; the blocks left in the extent
        SUBL2   R6, R0
        ADDL2   R1, R0
        MOVL    R4, R1
        POPR    #^M<R2, R3, R4, R5, R6>
        RSB
80$:    CLRQ    R0
        POPR    #^M<R2, R3, R4, R5, R6>
        RSB

; FIL$READVBN: R0 = a VBN, R1 = a block count, R2 = a buffer, R3 = a file
; header. Reads the file's blocks from that VBN. R0 = SS$_NORMAL,
; SS$_ENDOFFILE if the map ends first, or the disk's error. Keeps every
; other register.
FIL$READVBN::
        PUSHR   #^M<R1, R2, R4, R5, R6, R7, R8>
        MOVL    R0, R6                  ; the next VBN
        MOVL    R1, R7                  ; the blocks left
        MOVL    R2, R8                  ; where they go
10$:    TSTL    R7
        BEQL    40$
        MOVL    R6, R0
        MOVL    R3, R1
        BSBW    FIL$MAPVBN
        TSTL    R1
        BEQL    50$
        CMPL    R1, R7
        BLEQU   20$
        MOVL    R7, R1
20$:    CMPL    R1, #MAXREAD
        BLEQU   30$
        MOVL    #MAXREAD, R1
30$:    MOVL    R1, R4
        MOVL    R0, R2
        MOVL    R8, R0
        BSBW    FIL$READLBLK
        BLBC    R0, 60$
        ADDL2   R4, R6
        SUBL2   R4, R7
        MULL2   #BLOCK, R4
        ADDL2   R4, R8
        BRB     10$
40$:    MOVL    #SS$_NORMAL, R0
        BRB     60$
50$:    MOVL    #SS$_ENDOFFILE, R0
60$:    POPR    #^M<R1, R2, R4, R5, R6, R7, R8>
        RSB

; FIL$READHDR: R0 = a file number, R1 = a buffer. Reads the file's
; header there. R0 = SS$_NORMAL; SS$_NOSUCHFILE if the slot holds
; another file, SS$_BADCHKSUM if it holds no header, or the disk's error.
; Keeps every other register.
FIL$READHDR::
        PUSHR   #^M<R1, R2, R3, R4, R5>
        MOVL    R1, R4
        MOVL    R0, R5
        BEQL    80$
        ADDL3   F11$GL_HDRVBN, R5, R0
        DECL    R0
        MOVL    #1, R1
        MOVL    R4, R2
        MOVAB   F11$AB_INDEXF, R3
        BSBW    FIL$READVBN
        BLBC    R0, 90$
        CLRL    R1                      ; the sum of words 0-254
        CLRL    R2
10$:    ADDW2   (R4)[R2], R1
        AOBLSS  #255, R2, 10$
        CMPW    R1, FH2$W_CHECKSUM(R4)
        BNEQ    85$
        MOVZBL  FH2$B_FID_NMX(R4), R1
        ASHL    #16, R1, R1
        MOVW    FH2$W_FID(R4), R1
        CMPL    R1, R5
        BNEQ    80$
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_NOSUCHFILE, R0
        BRB     90$
85$:    MOVL    #SS$_BADCHKSUM, R0
90$:    POPR    #^M<R1, R2, R3, R4, R5>
        RSB

; FIL$EOF: R1 = a file header. R0 = the bytes in the file, up to its end
; of file. Uses R1.
FIL$EOF::
        MOVZWL  FH2$W_RECATTR+FAT$L_EFBLK(R1), R0       ; high word first
        ASHL    #16, R0, R0
        MOVW    FH2$W_RECATTR+FAT$L_EFBLK+2(R1), R0
        TSTL    R0
        BEQL    10$
        DECL    R0
        MULL2   #BLOCK, R0
        MOVZWL  FH2$W_RECATTR+FAT$W_FFBYTE(R1), R1
        ADDL2   R1, R0
10$:    RSB

; FIL$ISDIR: R1 = a file header. R0 = 1 if the file is a directory, else
; 0. Keeps every other register.
FIL$ISDIR::
        EXTZV   #FCH$V_DIRECTORY, #1, FH2$L_FILECHAR(R1), R0
        RSB

; FIL$SEARCHDIR: R3 = a directory's header, R6 = a pattern, "NAME.TYPE"
; with * and % wildcards, R7 = its length, R8 = a version: -1 any, 0 the
; highest, else that one, R9 = how many matching entries to skip. Finds
; the next entry that matches, in the directory's order: R1 = its name,
; in F11$AB_DIRBLK, R2 = the name's length, R4 = its version, R5 = its
; file number, and its file ID in F11$GW_FID. R0 = SS$_NORMAL,
; SS$_NOMOREFILES if there is none, or the disk's error. IPL$_SYNCH.
; Keeps every other register.
; ponytail: the highest version is the first of a name's first record;
; a name whose versions spill into a second record matches twice.
FIL$SEARCHDIR::
        PUSHR   #^M<R3, R6, R7, R8, R9, R10, R11>
        MOVL    #1, R10                 ; the VBN
10$:    MOVL    R3, R1                  ; the blocks in use, EOF's partly
        BSBW    FIL$EOF
        ADDL2   #BLOCK-1, R0
        DIVL2   #BLOCK, R0
        CMPL    R10, R0
        BGTRU   90$
        MOVL    R10, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        BSBW    FIL$READVBN
        BLBC    R0, 95$
        MOVAB   F11$AB_DIRBLK, R11      ; the record
20$:    MOVAB   F11$AB_DIRBLK+BLOCK-2, R0
        CMPL    R11, R0
        BGEQU   60$
        CMPW    (R11), #^XFFFF          ; the block's end
        BEQL    60$
        MOVAB   6(R11), R1
        MOVZBL  5(R11), R2
        BSBW    MATCH
        BLBC    R0, 50$
        ADDL3   #1, R2, R4              ; the first entry, past the even name
        BICL2   #1, R4
        ADDL2   R1, R4
        MOVL    R4, R0                  ; the first entry
        MOVZWL  (R11), R5               ; past the record
        ADDL2   R11, R5
        ADDL2   #2, R5
30$:    CMPL    R4, R5
        BGEQU   50$
        TSTL    R8
        BLSS    40$                     ; any version
        TSTL    R8
        BGTR    35$
        CMPL    R4, R0                  ; the highest: the first only
        BNEQ    50$
        BRB     40$
35$:    CMPW    (R4), R8
        BNEQ    45$
40$:    TSTL    R9
        BEQL    70$
        DECL    R9
45$:    ADDL2   #8, R4
        BRB     30$
50$:    MOVZWL  (R11), R0               ; the next record
        ADDL2   #2, R0
        ADDL2   R0, R11
        BRB     20$
60$:    INCL    R10                     ; the next block
        BRB     10$
70$:    MOVL    2(R4), F11$GW_FID
        MOVW    6(R4), F11$GW_FID+4
        MOVZBL  7(R4), R5
        ASHL    #16, R5, R5
        MOVW    2(R4), R5
        MOVZWL  (R4), R4
        MOVL    #SS$_NORMAL, R0
        BRB     95$
90$:    MOVL    #SS$_NOMOREFILES, R0
95$:    POPR    #^M<R3, R6, R7, R8, R9, R10, R11>
        RSB

; MATCH: R1 = a name, R2 = its length, R6 = a pattern, R7 = its length.
; R0 = 1 if the name matches it, else 0: * matches any characters, % any
; one.
MATCH:  PUSHR   #^M<R3, R4, R5, R8>
        CLRL    R3                      ; in the name
        CLRL    R4                      ; in the pattern
        MNEGL   #1, R5                  ; past the last *, to try again from
        CLRL    R8                      ; where in the name it matched from
10$:    CMPL    R3, R2
        BGEQU   50$
        CMPL    R4, R7
        BGEQU   30$
        MOVB    (R6)[R4], R0
        CMPB    R0, #^A/*/
        BEQL    20$
        CMPB    R0, #^A/%/
        BEQL    15$
        CMPB    R0, (R1)[R3]
        BNEQ    30$
15$:    INCL    R3
        INCL    R4
        BRB     10$
20$:    MOVL    R4, R5                  ; *: match nothing first
        MOVL    R3, R8
        INCL    R4
        BRB     10$
30$:    TSTL    R5                      ; no: the last * takes one more
        BLSS    80$
        ADDL3   #1, R5, R4
        INCL    R8
        MOVL    R8, R3
        BRB     10$
50$:    CMPL    R4, R7                  ; the name's end: only *s may be left
        BGEQU   70$
        CMPB    (R6)[R4], #^A/*/
        BNEQ    80$
        INCL    R4
        BRB     50$
70$:    MOVL    #1, R0
        BRB     90$
80$:    CLRL    R0
90$:    POPR    #^M<R3, R4, R5, R8>
        RSB

; FIL$OPENFILE: R6 = an image's file specification, R7 = its length.
; Reads the file, from DKA0:[SYSEXE] unless the specification says
; otherwise, into a block of pool: R1 = its address, R2 = the file's size
; in bytes, R3 = the block's size, for EXE$DEANONPGDSIZ. R0 = SS$_NORMAL,
; an RMS error such as RMS$_FNF, SS$_INSFMEM, or the disk's error. Keeps
; every other register.
; ponytail: the whole file, read at once; VMS maps an image's sections
; from it, page by page.
FIL$OPENFILE::
        PUSHR   #^M<R4, R5, R6, R7, R8, R9, R10, R11>
        DSBINT  #IPL$_SYNCH             ; the file system's buffers
        MOVL    R6, R0
        MOVL    R7, R1
        CLRQ    R2                      ; no default but SYS$SYSTEM
        MOVAB   IMAGEDEF, R4
        BSBW    RMS$PARSE
        BLBC    R0, 90$
        MOVAB   F11$AB_FILHDR, R1
        BSBW    RMS$FIND
        BLBC    R0, 90$
        MOVAB   F11$AB_FILHDR, R1
        BSBW    FIL$EOF
        MOVL    R0, R10                 ; the bytes
        ADDL3   #BLOCK-1, R10, R9
        DIVL2   #BLOCK, R9              ; the blocks
        MULL3   #BLOCK, R9, R1
        BEQL    85$
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 90$
        MOVL    R1, R11                 ; the block's size
        MOVL    R2, R8
        MOVL    #1, R0
        MOVL    R9, R1
        MOVAB   F11$AB_FILHDR, R3
        BSBW    FIL$READVBN
        BLBC    R0, 80$
        MOVL    R8, R1
        MOVL    R10, R2
        MOVL    R11, R3
        BRB     90$
80$:    PUSHL   R0
        MOVL    R8, R0
        MOVL    R11, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        BRB     90$
85$:    MOVL    #SS$_ENDOFFILE, R0
90$:    ENBINT
        POPR    #^M<R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

        .END
