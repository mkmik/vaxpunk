        .TITLE  GETMSG  $GETMSG: a status's message text
        .IDENT  /V0.1/
;
; A program asks for a status's message, %FACILITY-S-NAME, text, with
; $GETMSG, as on VMS, so DCL writes %RMS-E-FNF, file not found. VMS finds
; a facility's messages in its message file or the image's message
; section; here a table in the executive holds the file system's and
; RMS's. A status it has no text for is VMS's %NONAME-F-NOMSG, Message
; number 0000000C, with the status's severity, and SS$_MSGNOTFND.
; ponytail: one table, no message files; add them when an image brings
; its own facility's messages.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $SSDEF
        $RMSDEF

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
SEVERITY:                               ; a severity's letter, by its value
        .ASCII  "WSEIF???"
HEX:    .ASCII  "0123456789ABCDEF"      ; a hex digit's character
NOMSG:  .ASCIC  "NONAME"                ; a status with no text's facility and name
        .ASCIC  "NOMSG"
        .ASCIC  "Message number "
; The messages $GETMSG knows: a status, without its control bits, its
; facility, its name and its text, VMS's, each .ASCIC, until a status of 0.
MESSAGES:
        .LONG   RMS$_NORMAL
        .ASCIC  "RMS"
        .ASCIC  "NORMAL"
        .ASCIC  "normal successful completion"
        .LONG   RMS$_STALL
        .ASCIC  "RMS"
        .ASCIC  "STALL"
        .ASCIC  "synchronize with operation completion"
        .LONG   RMS$_PENDING
