        .ASCIC  "NOLOGTAB"
        .ASCIC  "no logical name table matched the specified name"
        .LONG   0

        .PSECT  $CODE$

; $GETMSG msgid, msglen, bufadr, flags, outadr: writes the message of the
; status msgid, found by its facility and number, with its own severity,
; in the buffer bufadr describes, as much as fits, and its length in the
; word at msglen, if there is one. flags says what it
; holds: bit 0 the text, bit 1 the name, bit 2 the severity, bit 3 the
; facility, 0 all four. Writes 0 in the longword at outadr, if there is
; one: no FAO arguments; a text may have FAO directives all the same,
; which $PUTMSG fills in. SS$_MSGNOTFND for a status it has no text for,
; SS$_BUFFEROVF if the message didn't fit, SS$_ACCVIO.
        .ENTRY  EXE$GETMSG, ^M<R2, R3, R4, R5, R6, R7, R8, R9>
        MOVL    12(AP), R0              ; the buffer
        IFNORD  #8, (R0), 84$
        MOVZWL  (R0), R7
        MOVL    4(R0), R6
        TSTL    R7
        BEQL    1$
        IFNOWRT R7, (R6), 84$
1$:     MOVL    8(AP), R0
        BEQL    2$
        IFNOWRT #2, (R0), 84$
2$:     MOVL    20(AP), R0
        BEQL    4$
        IFNOWRT #4, (R0), 84$
        CLRL    (R0)
4$:     MOVL    16(AP), R9
        BNEQ    5$
        MOVL    #15, R9
5$:     MOVL    4(AP), R4
        BICL3   #^XF0000007, R4, R3     ; without its control bits and severity
        MOVAB   MESSAGES, R5
6$:     TSTL    (R5)
        BEQL    8$
        BICL3   #7, (R5)+, R0
        CMPL    R0, R3
        BEQL    10$
        MOVL    #3, R1                  ; past the three strings
7$:     MOVZBL  (R5), R0
        ADDL2   R0, R5
        INCL    R5
        SOBGTR  R1, 7$
        BRB     6$
8$:     MOVAB   NOMSG, R5
        BISL2   #^X40000000, R9         ; not found
10$:    CLRL    R8                      ; the characters written
        MOVZBL  #^A/%/, R3              ; what goes before the next part
        BBC     #3, R9, 20$
        BSBB    SEP
        MOVL    R5, R1                  ; the facility
        BSBB    PUTC
20$:    MOVZBL  (R5), R0
        ADDL2   R0, R5
        INCL    R5                      ; the name
        BBC     #2, R9, 30$
        BSBB    SEP
        BICL3   #^C7, R4, R0
        MOVZBL  SEVERITY[R0], R0
        BSBB    PUTCHR
30$:    BBC     #1, R9, 40$
        BSBB    SEP
        MOVL    R5, R1
        BSBB    PUTC
40$:    MOVZBL  (R5), R0
        ADDL2   R0, R5
        INCL    R5                      ; the text
        BBC     #0, R9, 60$
        CMPB    R3, #^A/%/
        BEQL    45$                     ; no parts before it
        MOVZBL  #44, R0                 ; a comma
        BSBB    PUTCHR
        MOVZBL  #^A/ /, R0
        BSBB    PUTCHR
45$:    MOVL    R5, R1
        BSBB    PUTC
        BBC     #30, R9, 60$
        MOVL    #8, R2                  ; the status, in hex
50$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVZBL  HEX[R0], R0
        BSBB    PUTCHR
        SOBGTR  R2, 50$
60$:    MOVL    8(AP), R0
        BEQL    62$
        MOVW    R8, (R0)
62$:    MOVL    #SS$_BUFFEROVF, R0
        BBS     #31, R9, 90$
        MOVL    #SS$_MSGNOTFND, R0
        BBS     #30, R9, 90$
        MOVL    #SS$_NORMAL, R0
        RET
84$:    MOVL    #SS$_ACCVIO, R0
90$:    RET

; SEP: R3 = a character. Writes it, then makes R3 a dash. Uses R0 and R3.
SEP:
        .JSB_ENTRY  OUTPUT=<R8, R9>, SCRATCH=<R3>
        MOVL    R3, R0
        MOVZBL  #^A/-/, R3
; PUTCHR: R0 = a character. Writes it at R6[R8] if R8 is below R7, the
; buffer's length, and advances R8, else sets bit 31 of R9: it overflowed.
; Uses R0.
PUTCHR:
        .JSB_ENTRY  OUTPUT=<R8, R9>
        CMPL    R8, R7
        BGEQU   10$
        MOVB    R0, (R6)[R8]
        INCL    R8
        RSB
10$:    BISL2   #^X80000000, R9
        RSB

; PUTC: R1 = a .ASCIC string. Writes it with PUTCHR. Uses R0-R2.
PUTC:
        .JSB_ENTRY  OUTPUT=<R8, R9>, SCRATCH=<R2>
        MOVZBL  (R1)+, R2
        BRB     20$
10$:    MOVZBL  (R1)+, R0
        BSBB    PUTCHR
20$:    SOBGEQ  R2, 10$
        RSB

        .END
