        .TITLE  NETDRIVER BGA0:, TCP/IP through the port
        .IDENT  /V0.2/
;
; The network's port driver (docs/design/0003-tcpip-port.md). TCP/IP is a
; component below the executive, the TCP/IP component, which shares the
; port's pages with it ($PORTDEF): the driver writes a command in the
; port's command ring for each request and rings the doorbell, MTPR to
; PR$_DOORBELL; the component answers in the response ring, in any order,
; and interrupts at IPL$_PORT, through SCB$L_PORT. NET$INTERRUPT requests
; the IPL$_NETPOST fork, where NET$FORK completes the requests the
; responses are for.
;
; Programs see TCP/IP Services' $QIO interface (the VSI TCP/IP Services
; Sockets API and System Services Programming manual, chapters 5 and 6),
; with its symbols, starlet.mlb's $INETSYMDEF and the rest of
; TCPIP$INETDEF. BGA0: is a template device, as TCP/IP Services' BG0:
; was, which the system logical name TCPIP$DEVICE names: IO$_SETMODE with
; a socket's characteristics on a channel assigned to it makes a TCP,
; UDP or raw ICMP socket, and the channel goes to a unit of its own, a
; UCB cloned from it that holds the socket's connection number on the
; port, until the channel is deassigned, which closes it. Socket names
; come in item_list_2s and go out through item_list_3s, of SOCKADDRINs;
; the interface and its route are set and sensed with ioctls on a socket.
;
; A command takes a tag, a credit, which its response gives back. A send
; or a receive needs a tag with a buffer, the first PORT$K_BUFFERS, for
; its data; a request waits on BGA0:'s queue until a tag is free. A send's
; data is copied into its IRP at once, and from there to the buffer; a
; receive's data from the buffer into its IRP, which IOC$POST copies to
; the caller's buffer, as a buffered read. What else a request returns,
; a socket name or an ioctl's result, NET$POST writes, in the caller's
; process, from the response the IRP keeps.
; ponytail: one port, 0; a unit is cloned at IO$_SETMODE, not at $ASSIGN
; as TCP/IP Services' are; BGA0: isn't one of the devices $DEVICE_SCAN
; sees. No buffer lists (p5, p6 of a write or read), socket options (taken,
; and ignored), read and write flags, IO$M_NOW, out-of-band data or
; attention ASTs (IO$M_READATTN, IO$M_WRTATTN: taken, never delivered).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $PCBDEF
        $PRVDEF
        $UCBDEF
        $IRPDEF
        $RPBDEF
        $PORTDEF
        $IODEF
        $SSDEF
        $INETSYMDEF
        $IFREQDEF
        $ORTENTRYDEF
        $SIOCDEF

        .EXTERNAL EXE$GL_RPB, EXE$ALONONPAGED, EXE$DEANONPGDSIZ
        .EXTERNAL IOC$AB_BGA0, IOC$ALLOCIRP, IOC$REQCOM

; An IRP of this driver's holds, after the packet, the command, then where
; to write a socket name, the local one or a datagram's sender or a new
; connection's peer, then the peer's, each its buffer, the buffer's length
; and the address of the longword for the length written, or 0s, then the
; ioctls IO$_SENSEMODE asks for, each its request and its argument's
; address, and last a send's or receive's data.
NIRP$A_MSG = IRP$K_LENGTH               ; the command, then its response, PORTMSG$K_LENGTH bytes
NIRP$L_NAME = IRP$K_LENGTH+32
NIRP$L_PEER = IRP$K_LENGTH+44
NIRP$A_IOCTL = IRP$K_LENGTH+56
IOCTLS = 4                              ; ioctls a sense takes at most
NIRP$K_EXT = 56+<IOCTLS*8>              ; the bytes of those, past IRP$K_LENGTH
NIRP$A_DATA = IRP$K_LENGTH+NIRP$K_EXT
NIRP$V_LINE = 2                         ; IRP$L_STS: a READPROMPT's receive, a line
ORPHAN = 1                              ; NET$AL_TAG: busy, its IRP gone
WE0 = ^A/WE0/                           ; the interface's name, zero filled

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
NET$GL_PORT::                           ; port 0's pages, from the RPB, or 0 without a network
        .LONG   0
NET$AL_TAG::                            ; each tag's IRP, 0 if the tag is free, or ORPHAN
        .BLKL   PORT$K_TAGS
NET$GL_UNITS::                          ; the network units, linked by UCB$L_LINK
        .LONG   0
NET$GL_UNIT::                           ; the last unit's number, 1-99 then again
        .LONG   0
; The SS$_ status for each PORT$C_ST_.
STATUS: .LONG   SS$_NORMAL, SS$_BADPARAM, SS$_INSFMEM, SS$_DUPLNAM, SS$_REJECT
        .LONG   SS$_LINKABORT, SS$_TIMEOUT, SS$_ABORT, SS$_UNREACHABLE, SS$_LINKDISCON
        .LONG   SS$_NOLINKS, SS$_FILALRACC, SS$_IVADDR

        .PSECT  $CODE$

; NET$INIT: finds port 0 in the RPB. Uses R0.
NET$INIT::
        .JSB_ENTRY
        MOVL    G^EXE$GL_RPB, R0
        MOVL    RPB$L_PORT(R0), NET$GL_PORT
        RSB

; NET$INTERRUPT: port 0's completion interrupt, at IPL$_PORT. Requests
; the IPL$_NETPOST fork, which takes the responses.
NET$INTERRUPT::
        .EXCEPTION_ENTRY
        SOFTINT #IPL$_NETPOST
        REI

; NET$FORK: the IPL$_NETPOST software interrupt. Takes each response in
; the ring and completes the request it is for, then sends what waits for
; its tag.
NET$FORK::
        .EXCEPTION_ENTRY
        SETIPL  #IPL$_SYNCH
        PUSHR   #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8>
        MOVL    NET$GL_PORT, R8
10$:    CMPL    PORT$L_RSPGET(R8), PORT$L_RSPPUT(R8)
        BEQL    80$
        BICL3   #^C<PORT$K_RING-1>, PORT$L_RSPGET(R8), R6
        ASHL    #5, R6, R6
        MOVAB   PORT$A_RSP(R8)[R6], R6  ; the response
        MOVZWL  PORTMSG$W_TAG(R6), R2
        CMPL    R2, #PORT$K_TAGS
        BGEQU   70$
        MOVL    NET$AL_TAG[R2], R3
        BEQL    70$                     ; no request had it
        CLRL    NET$AL_TAG[R2]
        CMPL    R3, #ORPHAN
        BNEQ    20$
        BSBW    ORPHANED
        BRB     70$
20$:    TSTL    IRP$L_PID(R3)
        BNEQ    30$
        MOVL    R3, R0                  ; the driver's own
        MOVZWL  IRP$W_SIZE(R0), R1
        BSBW    EXE$DEANONPGDSIZ
        BRB     70$
30$:    BSBW    COMPLETE
70$:    INCL    PORT$L_RSPGET(R8)
        BRB     10$
80$:    BSBW    SENDWAIT
        POPR    #^M<R0, R1, R2, R3, R4, R5, R6, R7, R8>
        REI

; ORPHANED: R6 = a response for a request that is gone. A connection it
; made, OPEN's or ACCEPT's, has no unit: it is closed. IPL$_SYNCH. Uses
; R0-R3.
ORPHANED:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        TSTL    PORTMSG$L_STATUS(R6)
        BNEQ    90$
        MOVL    PORTMSG$L_CONN(R6), R0
        CMPB    PORTMSG$B_TYPE(R6), #PORT$C_OPEN
        BEQL    10$
        MOVL    PORTMSG$L_ARG1(R6), R0
        CMPB    PORTMSG$B_TYPE(R6), #PORT$C_ACCEPT
        BNEQ    90$
10$:    MOVL    #PORT$C_CLOSE, R1
        BRW     INTERNAL
90$:    RSB

; COMPLETE: R3 = an IRP, R6 = its response, in the buffer of tag R2.
; Keeps the response in the IRP, for NET$POST, and completes it, with
; the SS$_ status for the response's, and what the command gives back.
; IPL$_SYNCH. Uses R0-R5, R7.
COMPLETE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5, R7>
        MOVQ    (R6), NIRP$A_MSG(R3)
        MOVQ    8(R6), NIRP$A_MSG+8(R3)
        MOVQ    16(R6), NIRP$A_MSG+16(R3)
        MOVQ    24(R6), NIRP$A_MSG+24(R3)
        MOVL    PORTMSG$L_STATUS(R6), R0
        CMPL    R0, #PORT$C_ST_IVADDR
        BLEQU   5$
        MOVL    #PORT$C_ST_BADPARAM, R0
5$:     MOVL    STATUS[R0], R7
        MOVL    IRP$L_UCB(R3), R5
        CLRL    R1
        CMPB    PORTMSG$B_TYPE(R6), #PORT$C_OPEN
        BNEQ    10$
        MOVL    PORTMSG$L_CONN(R6), UCB$L_CONN(R5)
        BRW     80$
10$:    CMPB    PORTMSG$B_TYPE(R6), #PORT$C_ACCEPT
        BNEQ    20$
        BLBC    R7, 80$
        MOVL    IRP$L_BUFADR(R3), R0    ; the new channel's unit
        MOVL    PORTMSG$L_ARG1(R6), UCB$L_CONN(R0)
        BRW     80$
20$:    CMPB    PORTMSG$B_TYPE(R6), #PORT$C_CLOSE
        BNEQ    30$
        CLRL    UCB$L_CONN(R5)
        BRB     80$
30$:    CMPB    PORTMSG$B_TYPE(R6), #PORT$C_SEND
        BNEQ    40$
        BRB     70$
40$:    CMPB    PORTMSG$B_TYPE(R6), #PORT$C_RECV
        BNEQ    80$
        PUSHR   #^M<R1, R3>
        BSBW    BUFFER
        MOVC3   PORTMSG$L_LEN(R6), (R0), NIRP$A_DATA(R3)
        POPR    #^M<R1, R3>
        BBC     #NIRP$V_LINE, IRP$L_STS(R3), 70$
        BLBC    R7, 70$
        MOVL    PORTMSG$L_LEN(R6), R0   ; a line: without its end
        MOVL    #<1@16>!13, R1          ; ended by a carriage return
45$:    TSTL    R0
        BEQL    48$
        CMPB    NIRP$A_DATA-1(R3)[R0], #13
        BEQL    46$
        CMPB    NIRP$A_DATA-1(R3)[R0], #10
        BEQL    46$
        TSTB    NIRP$A_DATA-1(R3)[R0]
        BNEQ    48$
46$:    DECL    R0
        BRB     45$
48$:    ASHL    #16, R0, R0
        BISL2   R0, R7
        BRB     80$
70$:    ASHL    #16, PORTMSG$L_LEN(R6), R0      ; a byte count
        BISL2   R0, R7
80$:    MOVL    R7, R0
        BRW     IOC$REQCOM

; BUFFER: R2 = a tag. R0 = its buffer, in the port. Keeps every other
; register.
BUFFER:
        .JSB_ENTRY
        ADDL3   #1, R2, R0
        ASHL    #12, R0, R0
        ADDL2   NET$GL_PORT, R0
        RSB

; NET$POST: IOC$POST's call for a done IRP of this driver's, R6, in its
; process. If it succeeded, writes the socket names and the ioctls'
; results it asked for, from its response: the name's address and port
; in the response's ADDR and PORT, the peer's in ARG1 and ARG2, each a
; SOCKADDRIN, BSD 4.4's with IO$M_EXTEND, and its length; the interface's
; address, mask, gateway and link in an IFCONFIG's. Uses R0-R5.
NET$POST::
        .JSB_ENTRY  INPUT=<R6>, SCRATCH=<R2, R3, R4, R5>
        BLBC    IRP$L_IOST1(R6), 90$
        MOVL    NIRP$A_MSG+PORTMSG$L_ADDR(R6), R0
        MOVZWL  NIRP$A_MSG+PORTMSG$W_PORT(R6), R1
        MOVAL   NIRP$L_NAME(R6), R2
        BSBB    WRITENAME
        MOVL    NIRP$A_MSG+PORTMSG$L_ARG1(R6), R0
        MOVL    NIRP$A_MSG+PORTMSG$L_ARG2(R6), R1
        MOVAL   NIRP$L_PEER(R6), R2
        BSBB    WRITENAME
        MOVAB   NIRP$A_IOCTL(R6), R5
        MOVL    #IOCTLS, R4
10$:    MOVL    (R5)+, R0               ; the request
        BEQL    90$
        MOVL    (R5)+, R3               ; its argument
        MOVL    NIRP$A_MSG+PORTMSG$L_ADDR(R6), R1
        CMPL    R0, #SIOCGIFADDR
        BEQL    20$
        MOVL    NIRP$A_MSG+PORTMSG$L_ARG1(R6), R1
        CMPL    R0, #SIOCGIFNETMASK
        BEQL    20$
        CMPL    R0, #SIOCGIFFLAGS
        BEQL    30$
        MOVL    NIRP$A_MSG+PORTMSG$L_ARG2(R6), R1     ; SIOCGETRT: the default route
        CLRW    ORT$W_FLAGS(R3)
        TSTL    R1
        BEQL    15$
        MOVW    #ORT$M_RTF_UP!ORT$M_RTF_GATEWAY, ORT$W_FLAGS(R3)
15$:    ADDL2   #ORT$T_GATEWAY, R3
        BSBB    PUTSIN
        BRB     40$
20$:    ADDL2   #IFR$T_ADDR, R3
        BSBB    PUTSIN
        BRB     40$
30$:    MOVW    #IFR$M_IFF_UP!IFR$M_IFF_BROADCAST, IFR$W_FLAGS(R3)
        BITB    #PORT$M_LINKUP, NIRP$A_MSG+PORTMSG$B_FLAGS(R6)
        BEQL    40$
        BISW2   #IFR$M_IFF_RUNNING, IFR$W_FLAGS(R3)
40$:    SOBGTR  R4, 10$
90$:    RSB

; PUTSIN: R3 = a SOCKADDRIN, R1 = an address. Writes it there, with port
; 0. Keeps every other register.
PUTSIN:
        .JSB_ENTRY
        MOVW    #TCPIP$C_AF_INET, (R3)
        CLRW    2(R3)
        MOVL    R1, 4(R3)
        CLRQ    8(R3)
        RSB

; WRITENAME: R6 = an IRP, R0 = an address, R1 = a port, R2 = where a name
; goes: a buffer, its length and the address of the length written, or a
; buffer of 0 for none. Writes a SOCKADDRIN, as much as fits. Uses R0-R5.
WRITENAME:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        TSTL    (R2)
        BEQL    90$
        CLRQ    -(SP)                   ; the name, on the stack
        CLRQ    -(SP)
        BBS     #IO$V_EXTEND, IRP$L_FUNC(R6), 10$
        MOVW    #TCPIP$C_AF_INET, (SP)
        BRB     20$
10$:    MOVB    #16, (SP)               ; BSD 4.4's: its length, then its family
        MOVB    #TCPIP$C_AF_INET, 1(SP)
20$:    ROTL    #-8, R1, R3             ; the port, in network order
        MOVB    R3, 2(SP)
        MOVB    R1, 3(SP)
        MOVL    R0, 4(SP)
        MOVL    4(R2), R3
        CMPL    R3, #16
        BLEQU   30$
        MOVL    #16, R3
30$:    MOVL    8(R2), R4
        BEQL    40$
        MOVL    R3, (R4)
40$:    MOVC3   R3, (SP), @(R2)
        ADDL2   #16, SP
90$:    RSB

; NET$FDT: BGA0:'s FDT routine, and its units'. R4 = the current PCB, R5 =
; the channel's UCB, AP = $QIO's arguments. IO$_SETCHAR is IO$_SETMODE,
; IO$_SENSECHAR is IO$_SENSEMODE, as TCP/IP Services has them.
; On BGA0: itself:
;   IO$_SETMODE    makes a socket: p1 = its characteristics, a word
;                  protocol, a byte type and a byte family: TCPIP$C_TCP
;                  and TCPIP$C_STREAM, TCPIP$C_UDP and TCPIP$C_DGRAM, or
;                  TCPIP$C_ICMP and TCPIP$C_RAW, which needs SYSPRV or
;                  BYPASS (protocol 0 is the type's); the family
;                  TCPIP$C_AF_INET or 0. The channel goes to a new unit.
;                  Then p3 and p4 as on a unit, in one request
; On a unit, a socket:
;   IO$_SETMODE    binds it to the local name p3, an item_list_2; a port
;                  below 1024 needs SYSPRV or BYPASS; listens, p4
;                  connections waiting at most, if p4 isn't 0; or sets
;                  ioctls, p5 an item_list_2 of TCPIP$C_IOCTL, which need
;                  OPER: SIOCSIFADDR, SIOCSIFNETMASK and SIOCSIFDHCP on
;                  WE0, SIOCADDRT and SIOCDELRT of the default route
;   IO$_SENSEMODE  writes its local name to p3 and its peer's to p4, each
;                  an item_list_3; or the ioctls of p6, as p5's:
;                  SIOCGIFADDR, SIOCGIFNETMASK and SIOCGIFFLAGS of WE0,
;                  SIOCGETRT of the default route; IOCTLS at most
;   IO$_ACCESS     connects to the name p3, an item_list_2: for a
;                  datagram socket, sets the peer its writes go to and its
;                  reads come from
;   IO$_ACCESS!IO$M_ACCEPT   accepts a connection on a listening socket:
;                  p4 = the address of a word, a channel assigned to
;                  TCPIP$DEVICE:, which goes to the new connection's
;                  unit; p3, an item_list_3, gets the peer's name
;   IO$_WRITEVBLK  sends the p2 bytes at p1, 4096 at most; a datagram to
;                  the name p3, an item_list_2, if there is one
;   IO$_READVBLK   receives up to p2 bytes into p1, those that came, or
;                  one datagram, the rest of it lost, its sender's name
;                  to p3, an item_list_3; SS$_LINKDISCON once the peer
;                  has closed
;   IO$_DEACCESS   closes it; with IO$M_SHUTDOWN shuts down receiving,
;                  sending or both, p4 TCPIP$C_DSC_RCV, _SND or _ALL
; and as a terminal, for a process whose SYS$INPUT it is (vaxpunk's own:
; TCP/IP Services gives a remote login a TNA pseudo-terminal):
;   IO$_READPROMPT sends the p6 bytes at p5, then receives a line into
;                  p1, at most p2 bytes, as IO$_READVBLK, without its
;                  CR LF; the IOSB has a carriage return as its terminator
;   IO$_SETMODE!IO$M_CTRLCAST or IO$M_CTRLYAST does nothing
; R0 = SS$_NORMAL, SS$_DEVOFFLINE without the TCP/IP component,
; SS$_ILLIOFUNC, SS$_NOPRIV, SS$_BADPARAM (no socket yet, say),
; SS$_PROTOCOL, SS$_ACCVIO, SS$_IVBUFLEN, SS$_TOOMUCHDATA, SS$_IVCHAN,
; SS$_NOSUCHDEV, SS$_ILLCNTRFUNC, SS$_INSFMEM. IPL$_SYNCH. Uses R0-R8.
NET$FDT::
        .JSB_ENTRY  INPUT=<AP>, SCRATCH=<R2, R3, R4, R5, R6, R7, R8>
        MOVL    NET$GL_PORT, R0
        BEQL    10$
        CMPL    PORT$L_VERSION(R0), #PORT$K_VERSION
        BEQL    20$
10$:    MOVL    #SS$_DEVOFFLINE, R0
        RSB
20$:    BICL3   #^C63, 12(AP), R6       ; the function
        MOVL    12(AP), R7              ; and its modifiers
        CMPL    R6, #IO$_SETCHAR
        BNEQ    22$
        MOVL    #IO$_SETMODE, R6
22$:    CMPL    R6, #IO$_SENSECHAR
        BNEQ    24$
        MOVL    #IO$_SENSEMODE, R6
24$:    MOVAB   G^IOC$AB_BGA0, R0
        CMPL    R5, R0
        BNEQ    UNIT
        CMPL    R6, #IO$_SETMODE        ; no socket yet: only making one
        BNEQ    BADPARAM
        TSTL    28(AP)
        BEQL    BADPARAM
        BRW     OPEN

UNIT:   CMPL    R6, #IO$_SETMODE
        BNEQ    15$
        BRW     SOCKMODE
15$:    CMPL    R6, #IO$_SENSEMODE
        BNEQ    18$
        BRW     SENSEMODE
18$:    CMPL    R6, #IO$_READPROMPT
        BNEQ    20$
        BRW     PROMPT
20$:    CMPL    R6, #IO$_ACCESS
        BNEQ    30$
        BBS     #IO$V_ACCEPT, R7, 25$
        BRW     CONNECT
25$:    BRW     ACCEPT
30$:    CMPL    R6, #IO$_WRITEVBLK
        BNEQ    40$
        BRW     SEND
40$:    CMPL    R6, #IO$_READVBLK
        BNEQ    50$
        BRW     RECV
50$:    CMPL    R6, #IO$_DEACCESS
        BNEQ    ILLFUNC
        BRW     DEACCESS
ILLFUNC:
        MOVL    #SS$_ILLIOFUNC, R0
        RSB
BADPARAM:
        MOVL    #SS$_BADPARAM, R0
        RSB
ACCVIO: MOVL    #SS$_ACCVIO, R0
        RSB

; FREE: R3 = an IRP not sent, R0 = a failure. Frees the IRP, and returns
; the failure, for the FDT routine.
FREE:   PUSHL   R0
        MOVL    R3, R0
        MOVZWL  IRP$W_SIZE(R0), R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        RSB

; NOW: R1 = the IOSB's second longword. Completes the request at once,
; successfully.
NOW:    PUSHL   R1
        CLRL    R1
        BSBW    IOC$ALLOCIRP
        MOVL    (SP)+, R1
        BLBC    R0, 90$
        MOVL    #SS$_NORMAL, R0
        BRW     IOC$REQCOM
90$:    RSB

; OPEN: IO$_SETMODE on BGA0:, a new socket. The channel goes to a new
; unit, which the response gives its connection.
OPEN:   MOVL    28(AP), R2
        IFNORD  #4, (R2), ACCVIO
        MOVZWL  (R2), R6                ; the protocol
        MOVZBL  2(R2), R7               ; the type
        MOVZBL  3(R2), R0               ; the family
        BEQL    5$
        CMPL    R0, #TCPIP$C_AF_INET
        BNEQ    PROTOCOL
5$:     TSTL    R6                      ; 0: the type's
        BNEQ    10$
        MOVL    #TCPIP$C_TCP, R6
        CMPL    R7, #TCPIP$C_STREAM
        BEQL    10$
        MOVL    #TCPIP$C_UDP, R6
10$:    CMPL    R6, #TCPIP$C_TCP
        BNEQ    12$
        CMPL    R7, #TCPIP$C_STREAM
        BEQL    20$
12$:    CMPL    R6, #TCPIP$C_UDP
        BNEQ    14$
        CMPL    R7, #TCPIP$C_DGRAM
        BEQL    20$
14$:    CMPL    R6, #TCPIP$C_ICMP
        BNEQ    PROTOCOL
        CMPL    R7, #TCPIP$C_RAW
        BNEQ    PROTOCOL
        IFPRIV  SYSPRV, 20$
        IFPRIV  BYPASS, 20$
        MOVL    #SS$_NOPRIV, R0
        RSB
20$:    MOVL    #PORT$C_OPEN, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVW    R6, NIRP$A_MSG+PORTMSG$W_PROTO(R3)
        MOVL    R7, NIRP$A_MSG+PORTMSG$L_ARG2(R3)
        BSBW    BINDLISTEN
        BLBC    R0, FREE
        MOVZWL  8(AP), R0
        PUSHL   R3
        BSBW    NEWUNIT
        MOVL    (SP)+, R3
        BLBC    R0, FREE
        MOVL    R2, IRP$L_UCB(R3)
        MOVL    R6, UCB$L_PROTO(R2)
        BRW     QUEUE
90$:    RSB
PROTOCOL:
        MOVL    #SS$_PROTOCOL, R0
        RSB

; SOCKMODE: IO$_SETMODE on a unit: a terminal's or an attention AST, which
; never comes; a name and a backlog; or ioctls.
; ponytail: p3 and p4, or p5, not both in one request.
SOCKMODE:
        BITL    #IO$M_READATTN!IO$M_WRTATTN!IO$M_OUTBAND, R7
        BEQL    5$
        CLRL    R1                      ; CTRL/C's and CTRL/Y's are the same bits
        BRW     NOW
5$:     TSTL    28(AP)                  ; it has a socket already
        BEQL    7$
        BRW     BADPARAM
7$:     TSTL    44(AP)
        BEQL    10$
        BISL3   36(AP), 40(AP), R0
        BEQL    8$
        BRW     BADPARAM
8$:     BRW     SETIOCTL
10$:    MOVL    #PORT$C_SETMODE, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        BSBW    BINDLISTEN
        BLBS    R0, 20$
        BRW     FREE
20$:    TSTB    NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
        BNEQ    30$
        MOVL    #SS$_NORMAL, R0         ; nothing asked
        CLRL    R1
        BRW     IOC$REQCOM
30$:    BRW     QUEUE
90$:    RSB

; SETIOCTL: IO$_SETMODE's ioctls, p5: one IFCONFIG with what they set.
; Socket options are taken, and do nothing.
SETIOCTL:
        MOVL    #SS$_NOPRIV, R0
        IFNPRIV OPER, 99$
        MOVL    44(AP), R2
        IFNORD  #8, (R2), 97$
        CMPW    2(R2), #TCPIP$C_SOCKOPT
        BNEQ    3$
        CLRL    R1
        BRW     NOW
3$:     CMPW    2(R2), #TCPIP$C_IOCTL
        BNEQ    96$
        MOVL    #PORT$C_IFCONFIG, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 99$
        MOVL    44(AP), R2
        MOVZWL  (R2), R6
        MOVL    4(R2), R2               ; the ioctl_comms
        IFNORD  R6, (R2), 85$
        ASHL    #-3, R6, R6             ; how many
        BEQL    80$
10$:    MOVL    (R2)+, R0               ; the request
        MOVL    (R2)+, R7               ; its argument
        CMPL    R0, #SIOCADDRT
        BEQL    40$
        CMPL    R0, #SIOCDELRT
        BEQL    40$
        PUSHL   R0
        BSBW    IFREQ
        MOVL    R0, R1
        MOVL    (SP)+, R0
        BLBC    R1, 88$
        CMPL    R0, #SIOCSIFADDR
        BNEQ    20$
        MOVL    IFR$T_ADDR+4(R7), NIRP$A_MSG+PORTMSG$L_ADDR(R3)
        BISB2   #PORT$M_ADDR, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
        BRB     50$
20$:    CMPL    R0, #SIOCSIFNETMASK
        BNEQ    30$
        MOVL    IFR$T_ADDR+4(R7), NIRP$A_MSG+PORTMSG$L_ARG1(R3)
        BISB2   #PORT$M_MASK, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
        BRB     50$
30$:    CMPL    R0, #SIOCSIFDHCP
        BNEQ    86$
        BISB2   #PORT$M_DHCP, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
        BRB     50$
40$:    PUSHL   R0                      ; the default route, the one there is
        BSBW    ROUTE
        MOVL    R0, R1
        MOVL    (SP)+, R0
        BLBC    R1, 88$
        CLRL    NIRP$A_MSG+PORTMSG$L_ARG2(R3)
        CMPL    R0, #SIOCDELRT
        BEQL    45$
        MOVL    ORT$L_GATEWAY_SIN_ADDR(R7), NIRP$A_MSG+PORTMSG$L_ARG2(R3)
45$:    BISB2   #PORT$M_GW, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
50$:    SOBGTR  R6, 10$
        BRW     QUEUE
80$:    MOVL    #SS$_BADPARAM, R0
        BRW     FREE
85$:    MOVL    #SS$_ACCVIO, R0
        BRW     FREE
86$:    MOVL    #SS$_ILLCNTRFUNC, R0
        BRW     FREE
88$:    MOVL    R1, R0
        BRW     FREE
96$:    MOVL    #SS$_BADPARAM, R0
        RSB
97$:    MOVL    #SS$_ACCVIO, R0
99$:    RSB

; SENSEMODE: IO$_SENSEMODE on a unit: the local name p3 and the peer's
; p4, a GETNAME; or ioctls, p6, an IFCONFIG that sets nothing.
; ponytail: p3 and p4, or p6, not both in one request; no socket options.
SENSEMODE:
        TSTL    48(AP)
        BEQL    20$
        BISL3   36(AP), 40(AP), R0
        BEQL    10$
        BRW     BADPARAM
10$:    BRW     GETIOCTL
20$:    BISL3   36(AP), 40(AP), R0
        BNEQ    30$
        CLRL    R1                      ; nothing asked
        BRW     NOW
30$:    MOVL    #PORT$C_GETNAME, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    36(AP), R0
        BEQL    40$
        MOVAL   NIRP$L_NAME(R3), R2
        BSBW    OUTNAME
        BLBC    R0, 80$
40$:    MOVL    40(AP), R0
        BEQL    50$
        MOVAL   NIRP$L_PEER(R3), R2
        BSBW    OUTNAME
        BLBC    R0, 80$
50$:    BRW     QUEUE
80$:    BRW     FREE
90$:    RSB

; GETIOCTL: IO$_SENSEMODE's ioctls, p6, kept in the IRP for NET$POST.
GETIOCTL:
        MOVL    48(AP), R2
        IFNORD  #8, (R2), 97$
        CMPW    2(R2), #TCPIP$C_IOCTL
        BNEQ    96$
        MOVL    #PORT$C_IFCONFIG, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 99$
        MOVL    48(AP), R2
        MOVZWL  (R2), R6
        MOVL    4(R2), R2               ; the ioctl_comms
        IFNORD  R6, (R2), 85$
        ASHL    #-3, R6, R6             ; how many
        BEQL    80$
        CMPL    R6, #IOCTLS
        BGTRU   80$
        MOVAB   NIRP$A_IOCTL(R3), R8
10$:    MOVL    (R2)+, R0               ; the request
        MOVL    (R2)+, R7               ; its argument
        CMPL    R0, #SIOCGETRT
        BNEQ    20$
        IFNOWRT #ORT$K_LENGTH, (R7), 85$
        PUSHL   R0
        BSBW    ROUTE
        MOVL    R0, R1
        MOVL    (SP)+, R0
        BLBC    R1, 88$
        BRB     50$
20$:    CMPL    R0, #SIOCGIFADDR
        BEQL    30$
        CMPL    R0, #SIOCGIFNETMASK
        BEQL    30$
        CMPL    R0, #SIOCGIFFLAGS
        BNEQ    86$
30$:    IFNOWRT #IFR$K_LENGTH, (R7), 85$
        PUSHL   R0
        BSBW    IFREQ
        MOVL    R0, R1
        MOVL    (SP)+, R0
        BLBC    R1, 88$
50$:    MOVL    R0, (R8)+
        MOVL    R7, (R8)+
        SOBGTR  R6, 10$
        BRW     QUEUE
80$:    MOVL    #SS$_BADPARAM, R0
        BRW     FREE
85$:    MOVL    #SS$_ACCVIO, R0
        BRW     FREE
86$:    MOVL    #SS$_ILLCNTRFUNC, R0
        BRW     FREE
88$:    MOVL    R1, R0
        BRW     FREE
96$:    MOVL    #SS$_BADPARAM, R0
        RSB
97$:    MOVL    #SS$_ACCVIO, R0
99$:    RSB

; CONNECT: IO$_ACCESS, to the name p3.
CONNECT:
        TSTL    36(AP)
        BNEQ    5$
        BRW     BADPARAM
5$:     MOVL    #PORT$C_CONNECT, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    36(AP), R0
        BSBW    INNAME
        BLBC    R0, 80$
        TSTL    R2
        BNEQ    10$
        CMPL    UCB$L_PROTO(R5), #TCPIP$C_ICMP
        BEQL    10$
        MOVL    #SS$_IVADDR, R0         ; port 0
        BRB     80$
10$:    MOVL    R1, NIRP$A_MSG+PORTMSG$L_ADDR(R3)
        MOVW    R2, NIRP$A_MSG+PORTMSG$W_PORT(R3)
        BRW     QUEUE
80$:    BRW     FREE
90$:    RSB

; ACCEPT: IO$_ACCESS!IO$M_ACCEPT, the new channel in the word at p4, which
; goes to a new unit at once; the response gives it its connection, and
; the peer's name goes to p3.
ACCEPT: MOVL    40(AP), R0
        BNEQ    5$
        BRW     BADPARAM
5$:     IFNORD  #2, (R0), 85$
        MOVZWL  (R0), R6                ; the channel
        BEQL    80$
        CMPL    R6, #PCB$C_MAXCHAN
        BGTRU   80$
        BBC     R6, PCB$L_CHANS(R4), 80$
        MOVAB   G^IOC$AB_BGA0, R1
        CMPL    PCB$AL_CCB(R4)[R6], R1
        BNEQ    80$
        MOVL    #PORT$C_ACCEPT, R8
        CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    36(AP), R0
        BEQL    10$
        MOVAL   NIRP$L_NAME(R3), R2
        BSBW    OUTNAME
        BLBC    R0, 70$
10$:    MOVL    R6, R0
        PUSHL   R3
        BSBW    NEWUNIT
        MOVL    (SP)+, R3
        BLBC    R0, 70$
        MOVL    #TCPIP$C_TCP, UCB$L_PROTO(R2)
        MOVL    R2, IRP$L_BUFADR(R3)    ; the new unit
        BRW     QUEUE
70$:    BRW     FREE
80$:    MOVL    #SS$_IVCHAN, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; SEND: IO$_WRITEVBLK, p2 bytes at p1, which go into the IRP at once; a
; datagram socket's to the name p3.
SEND:   MOVL    28(AP), R2
        BNEQ    5$
        BRW     BADPARAM                ; a buffer list, p5
5$:     MOVL    32(AP), R6
        CMPL    R6, #PORT$K_BUFSIZE
        BLEQU   10$
        MOVL    #SS$_IVBUFLEN, R0
        CMPL    UCB$L_PROTO(R5), #TCPIP$C_TCP
        BEQL    8$
        MOVL    #SS$_TOOMUCHDATA, R0    ; a datagram goes in one piece
8$:     RSB
10$:    IFNORD  R6, (R2), 85$
        MOVL    #PORT$C_SEND, R8
        MOVL    R6, R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    R6, NIRP$A_MSG+PORTMSG$L_LEN(R3)
        MOVL    36(AP), R0
        BEQL    20$
        CMPL    UCB$L_PROTO(R5), #TCPIP$C_TCP
        BEQL    20$
        BSBW    INNAME
        BLBC    R0, 80$
        MOVL    R1, NIRP$A_MSG+PORTMSG$L_ADDR(R3)
        MOVW    R2, NIRP$A_MSG+PORTMSG$W_PORT(R3)
        BISB2   #PORT$M_TO, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
20$:    PUSHR   #^M<R3, R4, R5>
        MOVC3   R6, @28(AP), NIRP$A_DATA(R3)
        POPR    #^M<R3, R4, R5>
        BRW     QUEUE
80$:    BRW     FREE
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; RECV: IO$_READVBLK, at most p2 bytes into p1, 4096 if p2 is more, a
; buffered read; a datagram's sender's name to p3. RECV1: the same, with
; R7 = more IRP$L_STS bits.
RECV:   CLRL    R7
RECV1:  MOVL    28(AP), R2
        BNEQ    5$
        BRW     BADPARAM                ; a buffer list, p6
5$:     MOVL    32(AP), R6
        IFNOWRT R6, (R2), 85$
        CMPL    R6, #PORT$K_BUFSIZE
        BLEQU   10$
        MOVL    #PORT$K_BUFSIZE, R6
10$:    MOVL    #PORT$C_RECV, R8
        MOVL    R6, R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    R6, NIRP$A_MSG+PORTMSG$L_LEN(R3)
        MOVL    R6, IRP$L_BCNT(R3)
        BISL3   #IRP$M_BUFIO, R7, IRP$L_STS(R3)
        BBS     #NIRP$V_LINE, R7, 20$   ; a READPROMPT's p3 is no name
        MOVL    36(AP), R0
        BEQL    20$
        CMPL    UCB$L_PROTO(R5), #TCPIP$C_TCP
        BEQL    20$
        MOVAL   NIRP$L_NAME(R3), R2
        BSBW    OUTNAME
        BLBC    R0, 80$
20$:    BRW     QUEUE
80$:    BRW     FREE
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; DEACCESS: IO$_DEACCESS, a CLOSE, or with IO$M_SHUTDOWN a SHUTDOWN of the
; direction p4.
DEACCESS:
        MOVL    #PORT$C_CLOSE, R8
        BBC     #IO$V_SHUTDOWN, R7, 10$
        CMPL    40(AP), #TCPIP$C_DSC_ALL
        BLEQU   5$
        BRW     BADPARAM
5$:     MOVL    #PORT$C_SHUTDOWN, R8
10$:    CLRL    R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        MOVL    40(AP), NIRP$A_MSG+PORTMSG$L_ARG1(R3)
        BRW     QUEUE
90$:    RSB

; PROMPT: IO$_READPROMPT on a unit: a send of the prompt, for the driver
; itself, then a receive of a line.
PROMPT: MOVL    48(AP), R6
        BEQL    10$
        CMPL    R6, #PORT$K_BUFSIZE
        BGTRU   80$
        IFNORD  R6, @44(AP), 85$
        MOVL    #PORT$C_SEND, R8
        MOVL    R6, R1
        BSBW    NEWIRP
        BLBC    R0, 90$
        CLRL    IRP$L_PID(R3)           ; the driver's own
        MOVL    R6, NIRP$A_MSG+PORTMSG$L_LEN(R3)
        PUSHR   #^M<R3, R4, R5>
        MOVC3   R6, @44(AP), NIRP$A_DATA(R3)
        POPR    #^M<R3, R4, R5>
        PUSHR   #^M<R4, R5>
        BSBW    QUEUE
        POPR    #^M<R4, R5>
10$:    MOVL    #<1@NIRP$V_LINE>, R7
        BRW     RECV1
80$:    MOVL    #SS$_IVBUFLEN, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
90$:    RSB

; BINDLISTEN: R3 = an OPEN's or SETMODE's IRP, AP = $QIO's arguments.
; Puts the local name p3 in its command, to bind, and the backlog p4, to
; listen. R0 = SS$_NORMAL, INNAME's failure, or SS$_NOPRIV for a port
; below 1024 without SYSPRV or BYPASS. Uses R0-R2.
BINDLISTEN:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVL    36(AP), R0
        BEQL    20$
        BSBW    INNAME
        BLBC    R0, 90$
        TSTL    R2
        BEQL    10$
        CMPL    R2, #1024
        BGEQU   10$
        IFPRIV  SYSPRV, 10$
        IFPRIV  BYPASS, 10$
        MOVL    #SS$_NOPRIV, R0
        RSB
10$:    MOVL    R1, NIRP$A_MSG+PORTMSG$L_ADDR(R3)
        MOVW    R2, NIRP$A_MSG+PORTMSG$W_PORT(R3)
        BISB2   #PORT$M_BIND, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
20$:    MOVZBL  40(AP), R0
        BEQL    80$
        MOVL    R0, NIRP$A_MSG+PORTMSG$L_ARG1(R3)
        BISB2   #PORT$M_LISTEN, NIRP$A_MSG+PORTMSG$B_FLAGS(R3)
80$:    MOVL    #SS$_NORMAL, R0
90$:    RSB

; IFREQ: R7 = an ioctl's IFREQ. R0 = SS$_NORMAL if it can be read and
; names WE0, else SS$_ACCVIO or SS$_NOSUCHDEV. Keeps every other register.
IFREQ:
        .JSB_ENTRY
        MOVL    #SS$_ACCVIO, R0
        IFNORD  #IFR$K_LENGTH, (R7), 90$
        MOVL    #SS$_NOSUCHDEV, R0
        CMPL    IFR$T_NAME(R7), #WE0
        BNEQ    90$
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; ROUTE: R7 = an ioctl's ORTENTRY. R0 = SS$_NORMAL if it can be read and
; is the default route's, to 0.0.0.0, else SS$_ACCVIO or SS$_BADPARAM.
; Keeps every other register.
; ponytail: one route, the default; a routing table with a second
; interface.
ROUTE:
        .JSB_ENTRY
        MOVL    #SS$_ACCVIO, R0
        IFNORD  #ORT$K_LENGTH, (R7), 90$
        MOVL    #SS$_BADPARAM, R0
        TSTL    ORT$L_DST_SIN_ADDR(R7)
        BNEQ    90$
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; INNAME: R0 = an item_list_2 of a socket name, a SOCKADDRIN, BSD 4.3's
; or 4.4's. R1 = its address, R2 = its port, R0 = SS$_NORMAL, or
; SS$_ACCVIO, SS$_BADPARAM for another item, SS$_IVBUFLEN for one too
; short, SS$_PROTOCOL for another family. Keeps every other register.
INNAME:
        .JSB_ENTRY  OUTPUT=<R1, R2>
        IFNORD  #8, (R0), 85$
        CMPW    2(R0), #TCPIP$C_SOCK_NAME
        BNEQ    80$
        CMPW    (R0), #8                ; its family, port and address
        BLSSU   83$
        MOVL    4(R0), R2
        IFNORD  #8, (R2), 85$
        CMPW    (R2), #TCPIP$C_AF_INET
        BEQL    10$
        CMPB    1(R2), #TCPIP$C_AF_INET ; BSD 4.4's, after its length
        BNEQ    84$
10$:    MOVL    4(R2), R1
        MOVZBL  2(R2), R0               ; the port, high byte first
        ASHL    #8, R0, R0
        MOVZBL  3(R2), R2
        BISL2   R0, R2
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_BADPARAM, R0
        RSB
83$:    MOVL    #SS$_IVBUFLEN, R0
        RSB
84$:    MOVL    #SS$_PROTOCOL, R0
        RSB
85$:    MOVL    #SS$_ACCVIO, R0
        RSB

; OUTNAME: R0 = an item_list_3 for a socket name, R2 = where an IRP keeps
; one. Keeps its buffer, the buffer's length and the address of the length
; written there. R0 = SS$_NORMAL, or SS$_ACCVIO, SS$_BADPARAM for
; another item. Keeps every other register.
OUTNAME:
        .JSB_ENTRY
        PUSHL   R1
        IFNORD  #12, (R0), 85$
        CMPW    2(R0), #TCPIP$C_SOCK_NAME
        BNEQ    80$
        MOVZWL  (R0), R1
        IFNOWRT R1, @4(R0), 85$
        MOVL    4(R0), (R2)
        MOVL    R1, 4(R2)
        MOVL    8(R0), 8(R2)
        BEQL    10$
        IFNOWRT #4, @8(R0), 85$
10$:    MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_BADPARAM, R0
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
90$:    MOVL    (SP)+, R1
        RSB

; NEWIRP: R1 = the bytes of data past the command, R8 = a PORT$C_, and
; what NET$FDT has. Makes the request's IRP, with the command, of that
; type and otherwise 0, and nowhere to write a name or an ioctl's result
; yet, which NET$POST writes: R3 = it, R0 = SS$_NORMAL, or
; IOC$ALLOCIRP's failure. Uses R1 and R2.
NEWIRP:
        .JSB_ENTRY  OUTPUT=<R3>, SCRATCH=<R2>
        ADDL2   #NIRP$K_EXT, R1
        BSBW    IOC$ALLOCIRP
        BLBC    R0, 90$
        MOVL    #NIRP$K_EXT, IRP$L_PROMPT(R3)
        MOVAB   NET$POST, IRP$L_POST(R3)
        MOVAB   NIRP$A_MSG(R3), R1
        MOVL    #NIRP$K_EXT/4, R2
10$:    CLRL    (R1)+
        SOBGTR  R2, 10$
        MOVB    R8, NIRP$A_MSG+PORTMSG$B_TYPE(R3)
90$:    RSB

; NEWUNIT: R4 = the current PCB, R0 = a channel assigned to BGA0:. Clones
; BGA0:'s UCB, with no connection yet, as unit BGnn, the next number,
; for the channel to go to, its one channel. R0 = SS$_NORMAL, and R2 =
; the new UCB, or SS$_INSFMEM. Uses R1.
; ponytail: the numbers go round at 99, whether a unit has one or not.
NEWUNIT:
        .JSB_ENTRY  OUTPUT=<R2>
        PUSHL   R0
        MOVL    #UCB$K_NETLENGTH, R1
        BSBW    EXE$ALONONPAGED
        MOVL    (SP)+, R1
        BLBC    R0, 90$
        MOVL    R2, UCB$L_IOQFL(R2)
        MOVL    R2, UCB$L_IOQBL(R2)
        MOVAB   NET$FDT, UCB$L_FDT(R2)
        CLRL    UCB$L_VCB(R2)
        CLRL    UCB$L_START(R2)
        CLRL    UCB$L_ERRCNT(R2)
        CLRL    UCB$L_CONN(R2)
        CLRL    UCB$L_PROTO(R2)
        MOVL    NET$GL_UNITS, UCB$L_LINK(R2)
        MOVL    R2, NET$GL_UNITS
        MOVL    #1, UCB$L_REFC(R2)
        MOVL    R2, PCB$AL_CCB(R4)[R1]
        AOBLEQ  #99, NET$GL_UNIT, 10$
        MOVL    #1, NET$GL_UNIT
10$:    MOVL    NET$GL_UNIT, R0
        MOVL    R0, UCB$L_UNIT(R2)
        MOVW    #^A/BG/, UCB$T_NAME(R2)
        CLRL    R1                      ; nn: R1 tens, R0 ones
        EDIV    #10, R0, R1, R0
        ADDB3   #^A/0/, R1, UCB$T_NAME+2(R2)
        ADDB3   #^A/0/, R0, UCB$T_NAME+3(R2)
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; QUEUE: R3 = an IRP with its command. Sends it if a tag is free, or
; queues it on BGA0: until one is. R0 = SS$_NORMAL, for an FDT routine to
; return. IPL$_SYNCH. Uses R0-R5.
QUEUE:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        BSBB    TAG
        BLBS    R0, 10$
        MOVAB   G^IOC$AB_BGA0, R0
        INSQUE  (R3), @UCB$L_IOQBL(R0)
        BRB     90$
10$:    BSBB    SENDCMD
90$:    MOVL    #SS$_NORMAL, R0
        RSB

; TAG: R3 = an IRP with its command. R0 = 1 and R2 = a free tag for it,
; one with a buffer for a send or a receive, else 0. Uses R1.
TAG:
        .JSB_ENTRY  OUTPUT=<R2>
        CLRL    R2
        MOVL    #PORT$K_BUFFERS, R1
        CMPB    NIRP$A_MSG+PORTMSG$B_TYPE(R3), #PORT$C_SEND
        BEQL    10$
        CMPB    NIRP$A_MSG+PORTMSG$B_TYPE(R3), #PORT$C_RECV
        BEQL    10$
        MOVL    #PORT$K_BUFFERS, R2     ; the others take one without
        MOVL    #PORT$K_TAGS, R1
10$:    TSTL    NET$AL_TAG[R2]
        BEQL    20$
        AOBLSS  R1, R2, 10$
        CLRL    R0
        RSB
20$:    MOVL    #1, R0
        RSB

; SENDCMD: R3 = an IRP with its command, R2 = a free tag for it. Writes
; the command in the ring, with the tag and the connection, its unit's,
; or the command's own if the IRP is for BGA0:, and a send's data in the
; tag's buffer, and rings the doorbell. IPL$_SYNCH. Uses R0-R5.
SENDCMD:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVL    R3, NET$AL_TAG[R2]
        PUSHR   #^M<R6, R7, R8>
        MOVL    NET$GL_PORT, R8
        BICL3   #^C<PORT$K_RING-1>, PORT$L_CMDPUT(R8), R7
        ASHL    #5, R7, R7
        MOVAB   PORT$A_CMD(R8)[R7], R7  ; the entry
        MOVAB   NIRP$A_MSG(R3), R6
        MOVL    #PORTMSG$K_LENGTH/4, R0
10$:    MOVL    (R6)+, (R7)+
        SOBGTR  R0, 10$
        SUBL2   #PORTMSG$K_LENGTH, R7
        MOVW    R2, PORTMSG$W_TAG(R7)
        MOVL    IRP$L_UCB(R3), R0
        MOVAB   G^IOC$AB_BGA0, R1
        CMPL    R0, R1
        BEQL    20$
        MOVL    UCB$L_CONN(R0), PORTMSG$L_CONN(R7)
20$:    CMPB    PORTMSG$B_TYPE(R7), #PORT$C_SEND
        BNEQ    30$
        BSBW    BUFFER
        PUSHR   #^M<R7>
        MOVC3   PORTMSG$L_LEN(R7), NIRP$A_DATA(R3), (R0)
        POPR    #^M<R7>
30$:    INCL    PORT$L_CMDPUT(R8)
        MTPR    #0, #PR$_DOORBELL
        POPR    #^M<R6, R7, R8>
        RSB

; SENDWAIT: sends the requests waiting on BGA0: while there are tags for
; them, in order. IPL$_SYNCH. Uses R0-R5.
SENDWAIT:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
10$:    MOVAB   G^IOC$AB_BGA0, R0
        MOVL    UCB$L_IOQFL(R0), R3
        CMPL    R3, R0
        BEQL    90$
        BSBW    TAG
        BLBC    R0, 90$
        REMQUE  (R3), R3
        BSBW    SENDCMD
        BRB     10$
90$:    RSB

; INTERNAL: R0 = a connection, R1 = PORT$C_CLOSE or PORT$C_CANCEL. Sends
; that command for the driver itself, in an IRP of no process's, for BGA0:
; Without pool for it, the command isn't sent. IPL$_SYNCH. Uses R0-R3.
; ponytail: a connection whose CLOSE finds no pool stays open.
INTERNAL:
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHR   #^M<R4, R5>
        PUSHR   #^M<R0, R1>
        MOVL    #IRP$K_LENGTH+NIRP$K_EXT, R1
        BSBW    EXE$ALONONPAGED
        BLBS    R0, 10$
        POPR    #^M<R0, R1>
        BRB     90$
10$:    MOVL    R2, R3
        MOVW    R1, IRP$W_SIZE(R3)
        MOVB    #DYN$C_IRP, IRP$B_TYPE(R3)
        CLRL    IRP$L_PID(R3)
        CLRL    IRP$L_POST(R3)
        MOVAB   G^IOC$AB_BGA0, IRP$L_UCB(R3)
        MOVAB   NIRP$A_MSG(R3), R1
        MOVL    #PORTMSG$K_LENGTH/4, R2
20$:    CLRL    (R1)+
        SOBGTR  R2, 20$
        POPR    #^M<R0, R1>
        MOVL    R0, NIRP$A_MSG+PORTMSG$L_CONN(R3)
        MOVB    R1, NIRP$A_MSG+PORTMSG$B_TYPE(R3)
        BSBW    QUEUE
90$:    POPR    #^M<R4, R5>
        RSB

; NET$CANCEL: R4 = the current PCB, R0 = a mask of its channels, R1 = a
; status, or 0, as IOC$CANCEL has them. The requests on the port for
; those channels end: with that status, and a CANCEL for their
; connections, or, for 0, unfinished, since the channels are going: a
; unit's connection is closed then, and the unit freed. A request's tag
; stays taken until its response comes. Those waiting on BGA0: are
; IOC$CANCEL's. A unit is closed and freed once its last channel goes.
; IPL$_SYNCH. Uses R0-R3.
NET$CANCEL::
        .JSB_ENTRY  SCRATCH=<R2, R3>
        PUSHR   #^M<R4, R5, R6, R7, R8>
        MOVL    R0, R6
        MOVL    R1, R7
        CLRL    R8                      ; the tag
10$:    MOVL    NET$AL_TAG[R8], R3
        CMPL    R3, #ORPHAN
        BLEQU   40$
        TSTL    IRP$L_PID(R3)
        BEQL    40$
        CMPL    IRP$L_PID(R3), PCB$L_PID(R4)
        BNEQ    40$
        MOVZWL  IRP$W_CHAN(R3), R0
        BBC     R0, R6, 40$
        MOVL    #ORPHAN, NET$AL_TAG[R8]
        TSTL    R7
        BNEQ    20$
        MOVL    R3, R0                  ; the channel is going
        MOVZWL  IRP$W_SIZE(R0), R1
        BSBW    EXE$DEANONPGDSIZ
        BRB     40$
20$:    MOVL    IRP$L_UCB(R3), R0       ; $CANCEL
        MOVAB   G^IOC$AB_BGA0, R1
        CMPL    R0, R1
        BEQL    30$
        PUSHL   R3
        MOVL    UCB$L_CONN(R0), R0
        MOVL    #PORT$C_CANCEL, R1
        BSBW    INTERNAL
        MOVL    (SP)+, R3
30$:    CLRL    IRP$L_POST(R3)          ; it got nothing
        MOVL    R7, R0
        CLRL    R1
        BSBW    IOC$REQCOM
40$:    AOBLSS  #PORT$K_TAGS, R8, 10$
        TSTL    R7
        BNEQ    90$
        MOVL    #1, R8                  ; the units of the channels going
50$:    BBC     R8, R6, 70$
        MOVL    PCB$AL_CCB(R4)[R8], R5
        BSBW    NETUNIT
        BLBC    R0, 70$
        MOVAB   G^IOC$AB_BGA0, PCB$AL_CCB(R4)[R8]
        SOBGTR  UCB$L_REFC(R5), 70$     ; others still have it
        MOVL    UCB$L_CONN(R5), R0
        BEQL    60$
        MOVL    #PORT$C_CLOSE, R1
        BSBW    INTERNAL
60$:    MOVAL   NET$GL_UNITS, R0        ; off the list
65$:    CMPL    (R0), R5
        BEQL    67$
        MOVL    (R0), R0
        ADDL2   #UCB$L_LINK, R0
        BRB     65$
67$:    MOVL    UCB$L_LINK(R5), (R0)
        MOVL    R5, R0
        MOVL    #UCB$K_NETLENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
70$:    AOBLEQ  #PCB$C_MAXCHAN, R8, 50$
90$:    POPR    #^M<R4, R5, R6, R7, R8>
        RSB

; NETUNIT: R5 = a UCB. R0 = 1 if it is a network unit, not BGA0:, else 0.
NETUNIT:
        .JSB_ENTRY
        CLRL    R0
        PUSHL   R1
        MOVAB   NET$FDT, R1
        CMPL    UCB$L_FDT(R5), R1
        BNEQ    90$
        MOVAB   G^IOC$AB_BGA0, R1
        CMPL    R5, R1
        BEQL    90$
        INCL    R0
90$:    MOVL    (SP)+, R1
        RSB

; NET$FINDUNIT: R3 = a device name's four characters, DDCU. R5 = the
; network unit by that name, or 0. Keeps every other register.
NET$FINDUNIT::
        .JSB_ENTRY  OUTPUT=<R5>
        MOVL    NET$GL_UNITS, R5
10$:    TSTL    R5
        BEQL    90$
        CMPL    (R3), UCB$T_NAME(R5)
        BEQL    90$
        MOVL    UCB$L_LINK(R5), R5
        BRB     10$
90$:    RSB

        .END
