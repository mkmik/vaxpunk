        .TITLE  SYSSRV  The system service vector, the change mode dispatchers
        .IDENT  /V0.2/
;
; A program calls a system service as on VMS, with CALLS or CALLG to
; SYS$name, or with the $name_S macros in starlet.mlb. SYS$name changes
; mode to kernel with CHMK and the service's code; the PAL delivers the
; CHMK through the SCB to EXE$CMODKRNL, which checks the argument list and
; calls the service's EXE$name routine with it, then REIs with its status
; in R0. $CMEXEC changes mode to executive instead, with CHME, which
; EXE$CMODEXEC serves.
;
; Programs run in user mode, and command interpreters in supervisor mode,
; so SYS$name, EXE$CMODEXEC, and EXE$USRSTART and EXE$CLISTART, where a
; process enters those modes, are in a page of their own, the vector,
; which EXEC$START makes user readable: code an outer mode may run, as
; VMS's system service vector is.
;
; Services that aren't implemented yet are stubs that return
; SS$_ILLSER. An access violation or a reserved instruction in an outer
; mode ends the process.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $IPLDEF
        $PCBDEF
        $SSDEF

        .EXTERNAL SCH$GL_CURPCB, EXE$EXIT
        .EXTERNAL EXE$OUTZSTRING, EXE$OUTCSTRING, EXE$OUTHEX, EXE$OUTCRLF

; SERVICE name, nargs: SYS$name, which calls EXE$name with at least nargs
; arguments. STUB name, nargs: the same, with an EXE$name that fails.
        .MACRO  SERVICE NAME, NARGS
        .EXTERNAL EXE$'NAME
        VECTOR  NAME, NARGS
        .ENDM   SERVICE

        .MACRO  STUB    NAME, NARGS
        VECTOR  NAME, NARGS
        .ENTRY  EXE$'NAME, ^M<>
        MOVL    #SS$_ILLSER, R0
        RET
        .ENDM   STUB

; ESERVICE name, nargs: SYS$name for the executive mode service, which
; changes mode with CHME instead, to EXE$CMODEXEC.
        .MACRO  ESERVICE NAME, NARGS
        .SAVE_PSECT
        .PSECT  EXEC$VECTOR
        .ENTRY  SYS$'NAME, ^M<>
        CHME    #0
        RET
        .RESTORE_PSECT
        .ENDM   ESERVICE

        .MACRO  VECTOR  NAME, NARGS
        .SAVE_PSECT
        .PSECT  EXEC$SSTAB, NOEXE, NOWRT, LONG
        .ADDRESS EXE$'NAME
        .PSECT  EXEC$SSARG, NOEXE, NOWRT, BYTE
        .BYTE   NARGS
        .PSECT  EXEC$VECTOR
        .ENTRY  SYS$'NAME, ^M<>
        CHMK    #CODE
        RET
        .RESTORE_PSECT
CODE = CODE + 1
        .ENDM   VECTOR

        .PSECT  EXEC$VECTOR, EXE, NOWRT, 12
; EXE$VECTOR: the vector's first page, code an outer mode may run, up to
; EXE$VECTOREND. Not a routine.
EXE$VECTOR::

        .PSECT  EXEC$SSTAB, NOEXE, NOWRT, LONG
EXE$AL_SSTAB::                          ; EXE$name by code
        .PSECT  EXEC$SSARG, NOEXE, NOWRT, BYTE
EXE$AB_SSARG::                          ; argument counts by code
        .PSECT  $CODE$
CODE = 0
; Process control
        SERVICE CREPRC, 12
        SERVICE DELPRC, 2
        SERVICE EXIT, 1
        SERVICE FORCEX, 3
        SERVICE HIBER, 0
        SERVICE WAKE, 2
        SERVICE SCHDWK, 4
        SERVICE CANWAK, 2
        SERVICE SUSPND, 2
        SERVICE RESUME, 2
        SERVICE SETPRI, 4
        SERVICE SETPRN, 1
        SERVICE GETJPI, 7
        SERVICE GETJPIW, 7
        STUB    DCLEXH, 1
        STUB    CANEXH, 1
        STUB    SETPRV, 4
        SERVICE CMKRNL, 2
        ESERVICE CMEXEC, 2
; Event flags
        SERVICE ASCEFC, 2
        SERVICE DACEFC, 1
        STUB    DLCEFC, 1
        SERVICE SETEF, 1
        SERVICE CLREF, 1
        SERVICE READEF, 2
        SERVICE WAITFR, 1
        SERVICE WFLOR, 2
        SERVICE WFLAND, 2
; Memory
        SERVICE CRETVA, 2
        SERVICE DELTVA, 2
        SERVICE EXPREG, 2
        STUB    CNTREG, 4
        STUB    SETPRT, 5
        STUB    LKWSET, 3
        STUB    ULWSET, 3
        STUB    LCKPAG, 3
        STUB    ULKPAG, 3
        STUB    CRMPSC, 12
        STUB    MGBLSC, 7
; ASTs, time, I/O, logical names, system information
        SERVICE DCLAST, 3
        SERVICE SETAST, 1
        SERVICE ASTEXIT, 0
        SERVICE GETTIM, 1
        SERVICE SETIMR, 4
        SERVICE CANTIM, 2
        SERVICE ASSIGN, 4
        SERVICE DASSGN, 1
        SERVICE CANCEL, 1
        SERVICE QIO, 12
        SERVICE QIOW, 12
        SERVICE CRELNM, 5
        SERVICE DELLNM, 3
        SERVICE TRNLNM, 5
        SERVICE GETSYI, 7
        SERVICE GETSYIW, 7
; Images
        SERVICE IMGACT, 1
; RMS: files on Files-11 volumes
        SERVICE OPEN, 1
        SERVICE CLOSE, 1
        SERVICE CONNECT, 1
        SERVICE DISCONNECT, 1
        SERVICE GET, 1
        SERVICE PARSE, 1
        SERVICE SEARCH, 1
        SERVICE SETDDIR, 3
        SERVICE CREATE, 1
        SERVICE PUT, 1
        SERVICE ERASE, 1
; Volumes
        SERVICE MOUNT, 1
        SERVICE INIT_VOL, 2
; Devices
        SERVICE GETDVI, 8
        SERVICE GETDVIW, 8
        SERVICE DEVICE_SCAN, 5

; EXE$CMODKRNL: the CHMK handler. R0 = the service's code, AP = its
; argument list, the PAL's frame on the kernel stack.
EXE$CMODKRNL::
        CMPL    R0, #CODE
        BGEQU   80$
        PUSHL   R0
        MOVZBL  EXE$AB_SSARG[R0], R1
        BSBW    ARGLIST
        BLBC    R0, 70$
        MOVL    (SP)+, R0
        MOVL    EXE$AL_SSTAB[R0], R1
        CALLG   (AP), (R1)
        REI
70$:    ADDL2   #4, SP
        REI
80$:    MOVL    #SS$_ILLSER, R0
        REI

; EXE$ACVIOLAT: the access violation handler. Below the PAL's frame, the
; VAX's parameters: a mask, bit 2 for a write, and the address. An outer
; mode took it, since one in kernel mode stops the system: the process
; exits with SS$_ACCVIO, as one without a condition handler does.
EXE$ACVIOLAT::
        DSBINT  #IPL$_SYNCH             ; the console, a line at a time
        MOVAB   ACCVIO, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    12(SP), R1              ; past the IPL: the address
        JSB     G^EXE$OUTHEX
        MOVAB   ATPC, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    20(SP), R1              ; the frame's PC
        JSB     G^EXE$OUTHEX
        BSBB    PROCESS
        ENBINT
        PUSHL   #SS$_ACCVIO
        CALLS   #1, G^EXE$EXIT

; EXE$OPCDEC: the reserved instruction handler: privileged instructions
; and PAL calls, and undefined instructions, in an outer mode. The process
; exits with SS$_OPCDEC.
EXE$OPCDEC::
        DSBINT  #IPL$_SYNCH
        MOVAB   OPCDEC, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    4(SP), R1               ; past the IPL: the frame's PC
        JSB     G^EXE$OUTHEX
        BSBB    PROCESS
        ENBINT
        PUSHL   #SS$_OPCDEC
        CALLS   #1, G^EXE$EXIT

; PROCESS: writes ", process " and the current process's name, and CR LF.
PROCESS:
        MOVAB   INPROC, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    SCH$GL_CURPCB, R1
        MOVAB   PCB$T_LNAME(R1), R1
        JSB     G^EXE$OUTCSTRING
        JMP     G^EXE$OUTCRLF

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
ACCVIO: .ASCIZ  "%SYSTEM-F-ACCVIO, access violation, virtual address "
OPCDEC: .ASCIZ  "%SYSTEM-F-OPCDEC, reserved instruction at PC "
ATPC:   .ASCIZ  ", PC "
INPROC: .ASCIZ  ", process "

        .PSECT  EXEC$VECTOR
; EXE$CMODEXEC: the CHME handler, in executive mode. R0 = the service's
; code, AP = its argument list. $CMEXEC is the one executive mode service,
; code 0.
EXE$CMODEXEC::
        TSTL    R0
        BNEQ    80$
        MOVL    #2, R1
        BSBB    ARGLIST
        BLBC    R0, 90$
        CALLG   (AP), EXE$CMEXEC
90$:    REI
80$:    MOVL    #SS$_ILLSER, R0
        REI

; $CMEXEC routin, arglst: calls routin in executive mode with arglst.
; ponytail: any process may; CMEXEC privilege comes with privileges.
        .ENTRY  EXE$CMEXEC, ^M<>
        CALLG   @8(AP), @4(AP)
        RET

; ARGLIST: AP = an argument list a caller passed, R1 = the fewest arguments
; it may have. R0 = SS$_NORMAL; SS$_ACCVIO if the previous mode can't read
; all of it, SS$_INSFARG if it is too short. Uses R1. In the vector, for
; EXE$CMODEXEC, since executive mode may not run S0's other code.
ARGLIST:
        IFNORD  #4, (AP), 80$
        CMPB    (AP), R1
        BLSSU   85$
        MOVZBL  (AP), R1
        INCL    R1
        ASHL    #2, R1, R1
        IFNORD  R1, (AP), 80$
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB
85$:    MOVL    #SS$_INSFARG, R0
        RSB

; EXE$USRSTART: where a process enters user mode, with R1 = its image's
; transfer address: calls the image, and exits with the status it returns.
EXE$USRSTART::
        CALLS   #0, (R1)
        PUSHL   R0
        CALLS   #1, SYS$EXIT

; EXE$ASTDISP: where an AST routine is called, in the AST's access mode,
; with R1 = the routine and R0 = its parameter: calls it with the
; parameter, then $ASTEXIT, which goes back to what the AST interrupted.
EXE$ASTDISP::
        PUSHL   R0
        CALLS   #1, (R1)
        CALLS   #0, SYS$ASTEXIT

; EXE$CLISTART: where a process enters its command interpreter, in
; supervisor mode, with R1 = its transfer address and R0 = the status of
; the image that ran last: calls it with the status, and deletes the
; process if it returns.
EXE$CLISTART::
        PUSHL   R0
        CALLS   #1, (R1)
        CLRQ    -(SP)
        CALLS   #2, SYS$DELPRC
        .ALIGN  12
; EXE$VECTOREND: past the vector's last page. Not a routine.
EXE$VECTOREND::

        .END
