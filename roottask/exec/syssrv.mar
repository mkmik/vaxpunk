        .TITLE  SYSSRV  The system service vector, the change mode dispatchers
        .IDENT  /V0.2/
;
; A program calls a system service as on VMS, with CALLS or CALLG to
; SYS$name, or with the $name_S macros in starlet.mlb. SYS$name changes
; mode to kernel with CHMK and the service's code; the PAL delivers the
; CHMK through the SCB to EXE$CMODKRNL, which checks the argument list and
; calls the service's EXE$name routine with it, then REIs with its status
; in R0. $CMEXEC changes mode to executive instead, with CHME, which
; EXE$CMODEXEC serves.
;
; Programs run in user mode, and command interpreters in supervisor mode,
; so SYS$name, EXE$CMODEXEC, and EXE$USRSTART and EXE$CLISTART, where a
; process enters those modes, are in a page of their own, the vector,
; which EXEC$START makes user readable: code an outer mode may run, as
; VMS's system service vector is.
;
; Services that aren't implemented yet are stubs that return
; SS$_ILLSER. An access violation or a reserved instruction in an outer
; mode is a condition signaled there (roottask/exec/sysunwind.mar), whose
; code is in the vector too: modules after this one add to EXEC$VECTOR,
; before EXEC$VECTOREND.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $SSDEF
        $INTSTKDEF
        $PCBDEF
        $PRVDEF

        .EXTERNAL SCH$GL_CURPCB
CMEXECOK = 32767                        ; EXE$CMODEXEC's CHMK: may the process?

; SERVICE name, nargs[, EXH]: SYS$name, which calls EXE$name with at least
; nargs arguments. STUB name, nargs: the same, with an EXE$name that fails.
        .MACRO  SERVICE NAME, NARGS, EXH
        .EXTERNAL EXE$'NAME
        VECTOR  NAME, NARGS, EXH
        .ENDM   SERVICE

        .MACRO  STUB    NAME, NARGS
        VECTOR  NAME, NARGS
        .ENTRY  EXE$'NAME, ^M<>
        MOVL    #SS$_ILLSER, R0
        RET
        .ENDM   STUB

; ESERVICE name, nargs: SYS$name for the executive mode service, which
; changes mode with CHME instead, to EXE$CMODEXEC.
        .MACRO  ESERVICE NAME, NARGS
        .SAVE_PSECT
        .PSECT  EXEC$VECTOR
        .ENTRY  SYS$'NAME, ^M<>
        CHME    #0
        RET
        .RESTORE_PSECT
        .ENDM   ESERVICE

; VECTOR name, nargs[, EXH]: SYS$name and its entries in the tables. With
; EXH, $EXIT's: SYS$EXIT calls the caller's mode's exit handlers in that
; mode. EXE$EXIT returns SS$_NORMAL with R1 = the next one's block, which
; it took off the list: SYS$EXIT writes the status where the block says,
; calls the handler with the block's argument list, and calls EXE$EXIT
; again. Any other status is an error, which it returns.
        .MACRO  VECTOR  NAME, NARGS, EXH, ?L1, ?L2
        .SAVE_PSECT
        .PSECT  EXEC$SSTAB, NOEXE, NOWRT, LONG
        .ADDRESS EXE$'NAME
        .PSECT  EXEC$SSARG, NOEXE, NOWRT, BYTE
        .BYTE   NARGS
        .PSECT  EXEC$VECTOR
        .ENTRY  SYS$'NAME, ^M<>
        .IF     BLANK <EXH>
        CHMK    #CODE
        RET
        .IFF
L1:     CHMK    #CODE
        CMPL    R0, #SS$_NORMAL
        BNEQ    L2
        MOVL    4(AP), @12(R1)
        CALLG   8(R1), @4(R1)
        BRB     L1
L2:     RET
        .ENDC
        .RESTORE_PSECT
CODE = CODE + 1
        .ENDM   VECTOR

        .PSECT  EXEC$VECTOR, EXE, NOWRT, 12
; EXE$VECTOR: the vector's first page, code an outer mode may run, up to
; EXE$VECTOREND. Not a routine.
EXE$VECTOR::

        .PSECT  EXEC$SSTAB, NOEXE, NOWRT, LONG
EXE$AL_SSTAB::                          ; EXE$name by code
        .PSECT  EXEC$SSARG, NOEXE, NOWRT, BYTE
EXE$AB_SSARG::                          ; argument counts by code
        .PSECT  $CODE$
CODE = 0
; Process control
        SERVICE CREPRC, 12
        SERVICE DELPRC, 2
        SERVICE EXIT, 1, EXH
        SERVICE FORCEX, 3
        SERVICE HIBER, 0
        SERVICE WAKE, 2
        SERVICE SCHDWK, 4
        SERVICE CANWAK, 2
        SERVICE SUSPND, 2
        SERVICE RESUME, 2
        SERVICE SETPRI, 4
        SERVICE SETPRN, 1
        SERVICE GETJPI, 7
        SERVICE GETJPIW, 7
        SERVICE DCLEXH, 1
        SERVICE CANEXH, 1
        SERVICE SETPRV, 4
        SERVICE CMKRNL, 2
        ESERVICE CMEXEC, 2
; Event flags
        SERVICE ASCEFC, 2
        SERVICE DACEFC, 1
        STUB    DLCEFC, 1
        SERVICE SETEF, 1
        SERVICE CLREF, 1
        SERVICE READEF, 2
        SERVICE WAITFR, 1
        SERVICE WFLOR, 2
        SERVICE WFLAND, 2
; Memory
        SERVICE CRETVA, 2
        SERVICE DELTVA, 2
        SERVICE EXPREG, 2
        STUB    CNTREG, 4
        STUB    SETPRT, 5
        STUB    LKWSET, 3
        STUB    ULWSET, 3
        STUB    LCKPAG, 3
        STUB    ULKPAG, 3
        STUB    CRMPSC, 12
        STUB    MGBLSC, 7
; ASTs, time, I/O, logical names, system information
        SERVICE DCLAST, 3
        SERVICE SETAST, 1
        SERVICE ASTEXIT, 0
        SERVICE GETTIM, 1
        SERVICE SETIMR, 4
        SERVICE CANTIM, 2
        SERVICE ASSIGN, 4
        SERVICE DASSGN, 1
        SERVICE CANCEL, 1
        SERVICE CREMBX, 8
        SERVICE DELMBX, 1
        SERVICE QIO, 12
        SERVICE QIOW, 12
        SERVICE CRELNM, 5
        SERVICE DELLNM, 3
        SERVICE TRNLNM, 5
        SERVICE GETSYI, 7
        SERVICE GETSYIW, 7
        SERVICE GETMSG, 5
; Images
        SERVICE IMGACT, 1
; RMS: files on Files-11 volumes
        SERVICE OPEN, 1
        SERVICE CLOSE, 1
        SERVICE CONNECT, 1
        SERVICE DISCONNECT, 1
        SERVICE GET, 1
        SERVICE PARSE, 1
        SERVICE SEARCH, 1
        SERVICE SETDDIR, 3
        SERVICE CREATE, 1
        SERVICE PUT, 1
        SERVICE ERASE, 1
        SERVICE CREATE_DIR, 1
; Volumes
        SERVICE MOUNT, 1
        SERVICE INIT_VOL, 2
        SERVICE DISMOU, 2
; Devices
        SERVICE GETDVI, 8
        SERVICE GETDVIW, 8
        SERVICE DEVICE_SCAN, 5

; EXE$CMODKRNL: the CHMK handler. R0 = the service's code, AP = its
; argument list, the PAL's frame on the kernel stack. Code CMEXECOK is
; EXE$CMODEXEC's question, answered in R0. R0 and R1 go back to the
; caller in the frame, which REI restores every register from.
EXE$CMODKRNL::
        CMPL    R0, #CODE
        BGEQU   60$
        PUSHL   R0
        MOVZBL  EXE$AB_SSARG[R0], R1
        BSBW    ARGLIST
        BLBC    R0, 70$
        MOVL    (SP)+, R0
        MOVL    EXE$AL_SSTAB[R0], R1
        CALLG   (AP), (R1)
        BRB     90$
70$:    ADDL2   #4, SP
        BRB     90$
60$:    CMPL    R0, #CMEXECOK           ; may it change mode to executive?
        BNEQ    80$
        MOVL    SCH$GL_CURPCB, R1
        MOVL    #SS$_NORMAL, R0
        IFPRIV  CMEXEC, 90$, R1
        IFPRIV  CMKRNL, 90$, R1
        MOVL    #SS$_NOPRIV, R0
        BRB     90$
80$:    MOVL    #SS$_ILLSER, R0
90$:    EVAX_STQ R0, INTSTK$Q_R0(SP)
        EVAX_STQ R1, INTSTK$Q_R1(SP)
        REI

        .PSECT  EXEC$VECTOR
; EXE$CMODEXEC: the CHME handler, in executive mode. R0 = the service's
; code, AP = its argument list. $CMEXEC is the one executive mode service,
; code 0, for a process with CMEXEC or CMKRNL, which the PCB says: this
; mode can't read it, so a CHMK asks the kernel, SS$_NOPRIV without.
EXE$CMODEXEC::
        TSTL    R0
        BNEQ    80$
        CHMK    #CMEXECOK
        BLBC    R0, 90$
        MOVL    #2, R1
        BSBB    ARGLIST
        BLBC    R0, 90$
        CALLG   (AP), EXE$CMEXEC
        BRB     90$
80$:    MOVL    #SS$_ILLSER, R0
90$:    EVAX_STQ R0, INTSTK$Q_R0(SP)
        EVAX_STQ R1, INTSTK$Q_R1(SP)
        REI

; $CMEXEC routin, arglst: calls routin in executive mode with arglst.
        .ENTRY  EXE$CMEXEC, ^M<>
        CALLG   @8(AP), @4(AP)
        RET

; ARGLIST: AP = an argument list a caller passed, R1 = the fewest arguments
; it may have. R0 = SS$_NORMAL; SS$_ACCVIO if the previous mode can't read
; all of it, SS$_INSFARG if it is too short. Uses R1. In the vector, for
; EXE$CMODEXEC, since executive mode may not run S0's other code.
ARGLIST:
        IFNORD  #4, (AP), 80$
        CMPB    (AP), R1
        BLSSU   85$
        MOVZBL  (AP), R1
        INCL    R1
        ASHL    #2, R1, R1
        IFNORD  R1, (AP), 80$
        MOVL    #SS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB
85$:    MOVL    #SS$_INSFARG, R0
        RSB

; EXE$USRSTART: where a process enters user mode, with R1 = its image's
; transfer address: calls the image, and exits with the status it returns.
; A clear FP ends the frames a condition's handlers are looked for in.
EXE$USRSTART::
        CLRL    FP
        CALLS   #0, (R1)
        PUSHL   R0
        CALLS   #1, SYS$EXIT

; EXE$ASTDISP: where an AST routine is called, in the AST's access mode,
; with R1 = the routine and R0 = its parameter: calls it with the
; parameter, then $ASTEXIT, which goes back to what the AST interrupted.
; Its conditions aren't looked for in the frames it interrupted.
EXE$ASTDISP::
        CLRL    FP
        PUSHL   R0
        CALLS   #1, (R1)
        CALLS   #0, SYS$ASTEXIT

; EXE$CLISTART: where a process enters its command interpreter, in
; supervisor mode, with R1 = its transfer address and R0 = the status of
; the image that ran last: calls it with the status, and deletes the
; process if it returns.
EXE$CLISTART::
        CLRL    FP
        PUSHL   R0
        CALLS   #1, (R1)
        CLRQ    -(SP)
        CALLS   #2, SYS$DELPRC

; The vector ends at a page, past what later modules add to EXEC$VECTOR.
        .PSECT  EXEC$VECTOREND, EXE, NOWRT, 12
; EXE$VECTOREND: past the vector's last page. Not a routine.
EXE$VECTOREND::

        .END
