        .TITLE  RMS     Record Management Services: files on Files-11 volumes
        .IDENT  /V0.2/
;
; A program reads and writes files as on VMS: a FAB names a file and a
; RAB reads or writes its records, with $OPEN or $CREATE, $CONNECT, $GET
; or $PUT, $DISCONNECT and $CLOSE; $ERASE deletes one, and $PARSE and
; $SEARCH find the files a specification with wildcards names, into a
; NAM block (starlet.mlb's $FABDEF, $RABDEF, $NAMDEF, with VMS's
; layouts). A specification is [dev:][[dir.dir...]]name.type;ver: what it
; leaves out comes from the FAB's default specification, then from
; SYS$DISK: and the process's default directory, which $SETDDIR sets. A
; device may be a logical name, SYS$SYSTEM:, which stands for some of the
; parts: those the specification gives win. The device is DKA0:, the
; system disk, or MDA0:, the ramdisk, with a volume mounted on it, which
; f11.mar reads and f11wrt.mar writes.
;
; $OPEN reads the file's header into an IFAB, a block of pool, which the
; process's PCB holds by IFI, the index $OPEN puts in FAB$W_IFI; $CONNECT
; puts the same index in RAB$W_ISI. $GET reads sequential files' VAR and
; FIX records, a block at a time. $CREATE makes a new file, a version
; above the highest there is unless the specification gives one, with
; the FAB's record attributes and allocation. $PUT appends records to a
; file $CREATE made or $OPEN opened for FAB$M_PUT on a volume that may be
; written, a block at a time, extending it as it fills; $CLOSE writes its
; last block and its end of file. An image's files close when it exits,
; those its command interpreter opened when the process does.
;
; Each file and volume has an owner and a protection mask, which
; FIL$CHKPRO checks as VMS's XQP does: a lookup takes execute access to
; each directory it looks in, read for a wildcard; $OPEN takes read
; access to the file, $CREATE write to its directory, $ERASE delete to
; the file and write to its directory, else RMS$_PRV. A protection XAB
; in the FAB's chain gets the file's owner and protection from $OPEN,
; and gives them to it at $CLOSE, which takes control access, and the
; system's for a new owner.
;
; ponytail: $CREATE takes no XAB; SET PROTECTION, which opens the file,
; needs read access to it, where VMS's asks the XQP with IO$_MODIFY. The
; services run in kernel mode holding the file system's
; lock, FIL$LOCK, which keeps its buffers and RMS's to one process; VMS's
; RMS runs in executive mode, in the process's own P1. One stream per
; file; no $UPDATE or $TRUNCATE, so $PUT writes only at the end; no
; file sharing or locking, search lists or concealed devices, ASTs or
; completion routines, and $SEARCH finds its place again by counting the
; matches it skips.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $IPLDEF
        $PCBDEF
        $SSDEF
        $LNMBDEF
        $LNMDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $NAMDEF
        $VCBDEF
        $STATEDEF
        $ARMDEF
        $XABPRODEF

        .EXTERNAL SCH$GL_CURPCB, EXE$ALONONPAGED, EXE$DEANONPGDSIZ, EXE$PROBER_DSC
        .EXTERNAL FIL$READHDR, FIL$READVBN, FIL$SEARCHDIR, FIL$EOF, FIL$ISDIR
        .EXTERNAL FIL$SELECT, FIL$CREHDR, FIL$WRITEHDR, FIL$SETNAME, FIL$EXTEND
        .EXTERNAL FIL$ENTER, FIL$REMOVE, FIL$DELHDR, FIL$WRITEVBN, FIL$MKDIR
        .EXTERNAL FIL$LOCK, FIL$UNLOCK, FIL$CHKHDR
        .EXTERNAL F11$GW_FID, F11$GL_VCB, F11$AB_DIRBLK, LNM$TRNLOG, SCH$GL_PCBVEC

BLOCK = 512
MFD = 4                                 ; the MFD's file number
MAXIFI = 15                             ; PCB$A_IFAB's slots, 1-15
RESFILES = 9                            ; the volume's own files, 1-9
EXTEND = 8                              ; blocks $PUT extends a file by
WCC_FOUND = ^X80000000                  ; in NAM$L_WCC: $SEARCH found a file
; An IFAB: an open file.
IFB$L_POS = 0                           ; the next byte $GET reads, or $PUT writes
IFB$L_EOF = 4                           ; the bytes in the file
IFB$L_BLOCK = 8                         ; the VBN in IFB$AB_BUF, or 0
IFB$L_VCB = 12                          ; its volume
IFB$L_FLAGS = 16                        ; IFB$V_
IFB$AB_HDR = 32                         ; the file's header
IFB$AB_BUF = 544                        ; a block of the file
IFB$K_LENGTH = 1056
IFB$V_WRITE = 0                         ; $CREATE made it or $OPEN opened it for $PUT
IFB$V_DIRTY = 1                         ; IFB$AB_BUF is the file's last block, IFB$L_BLOCK,
                                        ; as $PUT left it, not yet written
; A file header's record attributes (ods/docs/file-header.md).
FAT$B_RTYPE = 20
FAT$B_RATTRIB = 21
FAT$W_RSIZE = 22
FAT$L_HIBLK = 24                        ; high word first
FAT$L_EFBLK = 28                        ; high word first
FAT$W_FFBYTE = 32
FAT$B_VFCSIZE = 35
FAT$W_MAXREC = 36
FH2$W_FID = 8
FH2$W_FID_SEQ = 10
FH2$B_FID_NMX = 13
FH2$L_FILEOWNER = 60
FH2$W_FILEPROT = 64
FH2$W_BACKLINK = 66
MAXXAB = 16                             ; XABs in a chain, at most

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
; A specification split into its five parts, device, directory, name,
; type and version, each an address and a length, 0 if it is absent: the
; file's, its default's, and the system's, and a logical name's
; equivalence string's.
SPECT:  .BLKQ   5
DEFT:   .BLKQ   5
SYST:   .BLKQ   5
EQUT:   .BLKQ   5
RMS$T_EXP::                             ; the expanded specification
        .BLKB   256
EXPLEN: .LONG   0
FIELDS: .BLKQ   5                       ; its parts
RMS$L_VERSION::                         ; the version it asks for: -1 any, 0 the highest
        .LONG   0
WILD:   .LONG   0                       ; 1 if it has a wildcard
CREDIR: .LONG   0                       ; 0, or 1 + the directories DIRWALK made
RMS$AB_DIRHDR::                         ; its directory's header
        .BLKB   BLOCK
DIRFID: .BLKW   3                       ; and file ID
DIRPAT: .BLKB   48                      ; a directory's name, NAME.DIR
RES:    .BLKB   512                     ; the resultant specification
RESLEN: .LONG   0
RESF:   .BLKQ   5                       ; its parts
RESNAME:
        .LONG   0, 0                    ; the name found, and its length
RESVER: .LONG   0
DEFDIR: .BLKB   256                     ; the default's and the specification's
SPECDIR:                                ; directories, made absolute
        .BLKB   256
SYSDEF: .BYTE   0                       ; the system's default: SYS$DISK: and
SYSDISK:                                ; the process's default directory, .ASCIC
        .ASCII  "SYS$DISK:"
        .BLKB   63
HDRBUF: .BLKB   BLOCK                   ; the header of a file $ERASE deletes
XABPRO: .LONG   0                       ; the FAB's protection XAB, or 0
MFDNAME:
        .ASCII  "000000"
DOTDIR: .ASCII  ".DIR"

        .PSECT  $CODE$

; RMS$PARSE: R0 = a file specification, R1 = its length, R2 = a default
; one, R3 = its length, 0 if there is none, R4 = the system's default,
; .ASCIC. Expands the specification into RMS$T_EXP, each one's device
; translated (XLATE), the parts it leaves
; out taken from the default, then from the system's, a relative
; directory made absolute (RESOLVE), checks it, finds
; its directory and reads the directory's header into RMS$AB_DIRHDR. R0 =
; RMS$_NORMAL, RMS$_SYN, RMS$_DEV, RMS$_DIR, RMS$_FNM, RMS$_VER, RMS$_DNF,
; or the disk's error. The strings must be readable. Holding FIL$LOCK;
; at IPL$_SYNCH until MERGE has copied the parts XLATE found in logical
; names' blocks, which another process may delete. Uses R1.
RMS$PARSE::
        PUSHR   #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        CLRL    WILD
        DSBINT  #IPL$_SYNCH
        PUSHL   R4
        PUSHL   R3
        PUSHL   R2
        MOVAQ   SPECT, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        BSBW    XLATE
        BLBC    R0, 10$
        MOVL    (SP), R0
        MOVL    4(SP), R1
        MOVAQ   DEFT, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        BSBW    XLATE
        BLBC    R0, 10$
        MOVL    8(SP), R0
        MOVZBL  (R0)+, R1
        MOVAQ   SYST, R2
        BSBW    SPLIT
        BLBC    R0, 10$
        BSBW    XLATE
10$:    ADDL2   #12, SP
        BLBC    R0, 20$
        BSBW    RESOLVE
        BLBC    R0, 20$
        BSBW    MERGE
20$:    ENBINT
        BLBC    R0, 90$
        BSBW    CHECK
        BLBC    R0, 90$
        BSBW    DIRWALK
90$:    POPR    #^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        RSB

; SPLIT: R0 = a specification, R1 = its length, R2 = a table of five
; parts. Splits it: [dev:][[dir]][name][.type][;ver]. A part's punctuation
; is in it: the colon, the brackets, the dot, the semicolon. R0 =
; RMS$_NORMAL, RMS$_DIR or RMS$_SYN. Uses R1-R6.
SPLIT:  CLRQ    (R2)
        CLRQ    8(R2)
        CLRQ    16(R2)
        CLRQ    24(R2)
        CLRQ    32(R2)
        ADDL3   R0, R1, R6              ; past the end
        MOVL    R0, R3                  ; where the next part starts
        MOVL    R3, R4                  ; the device: up to a colon
10$:    CMPL    R4, R6
        BGEQU   20$
        CMPB    (R4), #^A/:/
        BEQL    15$
        INCL    R4
        BRB     10$
15$:    INCL    R4
        MOVL    R3, (R2)
        SUBL3   R3, R4, 4(R2)
        MOVL    R4, R3
20$:    CMPL    R3, R6                  ; the directory: [...] or <...>
        BGEQU   40$
        CMPB    (R3), #91               ; [
        BEQL    25$
        CMPB    (R3), #60               ; <
        BNEQ    40$
25$:    MOVL    R3, R4
30$:    INCL    R4
        CMPL    R4, R6
        BGEQU   85$
        CMPB    (R4), #93               ; ]
        BEQL    35$
        CMPB    (R4), #62               ; >
        BNEQ    30$
35$:    INCL    R4
        MOVL    R3, 8(R2)
        SUBL3   R3, R4, 12(R2)
        MOVL    R4, R3
40$:    MOVL    R3, R4                  ; the name: up to a dot or semicolon
45$:    CMPL    R4, R6
        BGEQU   50$
        CMPB    (R4), #^A/./
        BEQL    50$
        CMPB    (R4), #59                 ; a semicolon
        BEQL    50$
        INCL    R4
        BRB     45$
50$:    MOVL    R3, 16(R2)
        SUBL3   R3, R4, 20(R2)
        MOVL    R4, R3
        CMPL    R3, R6                  ; the type: from a dot to a semicolon
        BGEQU   80$
        CMPB    (R3), #^A/./
        BNEQ    60$
        MOVL    R3, R4
55$:    INCL    R4
        CMPL    R4, R6
        BGEQU   57$
        CMPB    (R4), #59                 ; a semicolon
        BNEQ    55$
57$:    MOVL    R3, 24(R2)
        SUBL3   R3, R4, 28(R2)
        MOVL    R4, R3
        CMPL    R3, R6                  ; the version: the rest
        BGEQU   80$
60$:    CMPB    (R3), #59                 ; a semicolon
        BNEQ    87$
        MOVL    R3, 32(R2)
        SUBL3   R3, R6, 36(R2)
80$:    MOVL    #RMS$_NORMAL, R0
        RSB
85$:    MOVL    #RMS$_DIR, R0
        RSB
87$:    MOVL    #RMS$_SYN, R0
        RSB

; XLATE: R2 = a table of parts. While its device is a logical name in
; LNM$FILE_DEV, without an underscore before it, up to LNM$C_MAXDEPTH
; times, splits the equivalence string into EQUT: its device becomes the
; table's, and its other parts fill in those the table leaves out.
; SYS$SYSTEM:DCL.EXE is DKA0:[SYSEXE]DCL.EXE. R0 = RMS$_NORMAL, or
; SPLIT's error. IPL$_SYNCH. Uses R0-R9.
XLATE:  MOVL    R2, R8
        MOVL    #LNM$C_MAXDEPTH, R9
10$:    MOVL    (R8), R6                ; the device, without its colon
        SUBL3   #1, 4(R8), R7
        BLEQ    80$
        CMPB    (R6), #^A/_/
        BEQL    80$
        BSBW    LNM$TRNLOG
        TSTL    R1
        BEQL    80$
        MOVZBL  LNMB$T_NAME(R1), R0
        MOVAB   LNMB$T_NAME+1(R1)[R0], R0
        MOVZBL  (R0)+, R1
        MOVAQ   EQUT, R2
        BSBW    SPLIT
        BLBC    R0, 90$
        MOVQ    EQUT, (R8)
        MOVL    #1, R0
20$:    MOVAQ   (R8)[R0], R1
        TSTL    4(R1)
        BNEQ    30$
        MOVAQ   EQUT[R0], R2
        MOVQ    (R2), (R1)
30$:    AOBLSS  #5, R0, 20$
        SOBGTR  R9, 10$
80$:    MOVL    #RMS$_NORMAL, R0
90$:    MOVL    R8, R2
        RSB

; RESOLVE: makes the directories in SPECT and DEFT absolute, as VMS's RMS
; does: the default's relative to the system's, the specification's to the
; default's if it has one, else to the system's. R0 = RMS$_NORMAL or
; RMS$_DIR. Uses R0-R9.
RESOLVE:
        MOVAQ   DEFT+8, R0
        MOVAQ   SYST+8, R1
        MOVAB   DEFDIR, R2
        BSBB    RELDIR
        BLBC    R0, 90$
        MOVAQ   SPECT+8, R0
        MOVAQ   DEFT+8, R1
        TSTL    4(R1)
        BNEQ    10$
        MOVAQ   SYST+8, R1
10$:    MOVAB   SPECDIR, R2
        BSBB    RELDIR
90$:    RSB

; RELDIR: R0 = a directory part, its address and length, in a table of
; parts, R1 = the absolute one it is relative to, the same, R2 = a
; 256-byte buffer. If the part is relative, [] the same directory, [-]
; its parent, [--] the one above, [.dir] or [-.dir] a directory in one of
; those, writes the absolute one in the buffer and points the part at it.
; The MFD, [000000], has no parent. R0 = RMS$_NORMAL or RMS$_DIR. Uses
; R0-R9.
RELDIR: MOVL    4(R0), R3               ; the part's length
        CMPL    R3, #2
        BLSSU   70$                     ; none, or CHECK's to report
        MOVL    (R0), R4
        CMPL    R3, #2                  ; []
        BEQL    5$
        CMPB    1(R4), #^A/-/
        BEQL    5$
        CMPB    1(R4), #^A/./
        BNEQ    70$
5$:     ADDL3   #1, R4, R5              ; R5 = past the bracket, then the rest
        ADDL3   R4, R3, R6
        DECL    R6                      ; R6 = at the closing bracket
        CLRL    R7                      ; how many levels up
10$:    CMPL    R5, R6
        BGEQU   15$
        CMPB    (R5), #^A/-/
        BNEQ    12$
        INCL    R7
        INCL    R5
        BRB     10$
12$:    CMPB    (R5)+, #^A/./           ; a dot, then names
        BNEQ    80$
        CMPL    R5, R6
        BGEQU   80$
15$:    MOVL    (R1), R9                ; the base's names: R9, R8 long
        SUBL3   #2, 4(R1), R8
        BLEQ    80$
        INCL    R9
        CMPL    R8, #6                  ; the MFD's are none
        BNEQ    20$
        CMPL    (R9), MFDNAME
        BNEQ    20$
        CMPW    4(R9), MFDNAME+4
        BNEQ    20$
        CLRL    R8
20$:    TSTL    R7                      ; up a level: drop the last name
        BEQL    40$
25$:    TSTL    R8
        BEQL    80$
30$:    DECL    R8
        BEQL    35$
        CMPB    (R9)[R8], #^A/./
        BNEQ    30$
35$:    SOBGTR  R7, 25$
40$:    MOVL    R2, R3                  ; [, the base's names, a dot, the rest, ]
        MOVAB   255(R2), R4
        MOVB    #91, (R3)+
        TSTL    R8
        BEQL    50$
45$:    MOVB    (R9)+, (R3)+
        SOBGTR  R8, 45$
        CMPL    R5, R6
        BGEQU   60$
        MOVB    #^A/./, (R3)+
        BRB     55$
50$:    CMPL    R5, R6                  ; no names and no rest: the MFD
        BLSSU   55$
        MOVL    MFDNAME, (R3)+
        MOVW    MFDNAME+4, (R3)+
        BRB     60$
55$:    CMPL    R5, R6
        BGEQU   60$
        CMPL    R3, R4
        BGEQU   80$
        MOVB    (R5)+, (R3)+
        BRB     55$
60$:    CMPL    R3, R4
        BGTRU   80$
        MOVB    #93, (R3)+
        MOVL    R2, (R0)
        SUBL3   R2, R3, 4(R0)
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DIR, R0
        RSB

; MERGE: builds RMS$T_EXP from the parts in SPECT, else DEFT, else SYST,
; in capitals, and FIELDS from where each part went. An empty type is a
; dot, an empty version a semicolon. R0 = RMS$_NORMAL, or RMS$_SYN if it
; is longer than 255 characters. Uses R0-R6.
MERGE:  MOVAB   RMS$T_EXP, R6           ; the next character
        CLRL    R5                      ; the part
10$:    MOVAQ   SPECT[R5], R1
        TSTL    4(R1)
        BNEQ    20$
        MOVAQ   DEFT[R5], R1
        TSTL    4(R1)
        BNEQ    20$
        MOVAQ   SYST[R5], R1
20$:    MOVAQ   FIELDS[R5], R4
        MOVL    R6, (R4)
        MOVL    (R1), R2
        MOVL    4(R1), R3
        BNEQ    30$
        MOVZBL  #^A/./, R0              ; nothing there: the punctuation
        CMPL    R5, #3
        BEQL    35$
        MOVZBL  #59, R0                 ; a semicolon
        CMPL    R5, #4
        BEQL    35$
        BRB     40$
30$:    MOVZBL  (R2)+, R0
        CMPB    R0, #^A/a/
        BLSSU   35$
        CMPB    R0, #^A/z/
        BGTRU   35$
        SUBB2   #^A/a/-^A/A/, R0
35$:    MOVAB   RMS$T_EXP+255, R1
        CMPL    R6, R1
        BGEQU   80$
        MOVB    R0, (R6)+
        DECL    R3
        BGTR    30$
40$:    SUBL3   (R4), R6, 4(R4)
        AOBLSS  #5, R5, 10$
        MOVAB   RMS$T_EXP, R0
        SUBL3   R0, R6, EXPLEN
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_SYN, R0
        RSB

; CHECK: checks the parts in FIELDS: the device is DKA0: or MDA0:, with a
; volume mounted, which becomes F11$GL_VCB, the directory
; and the name and type are made of letters, digits, $, _ and -, with
; dots between the directory's names, wildcards in the name, type and
; version, and the version is a number up to 32767, * or nothing. Sets
; WILD for a wildcard and RMS$L_VERSION. R0 = RMS$_NORMAL, RMS$_DEV,
; RMS$_DNR, RMS$_DIR, RMS$_FNM or RMS$_VER. Uses R0-R4.
CHECK:  MOVL    FIELDS, R1              ; the device
        MOVL    FIELDS+4, R2
        BSBW    FIL$SELECT
        BLBC    R0, 80$
        MOVL    F11$GL_VCB, R1
        BBS     #VCB$V_MOUNTED, VCB$L_STATUS(R1), 7$
        MOVL    #RMS$_DNR, R0
        RSB
7$:     ADDL3   #1, FIELDS+8, R1        ; the directory, inside its brackets
        SUBL3   #2, FIELDS+12, R2
        BLEQ    85$
        MOVL    #2, R3                  ; dots, no wildcards
        BSBW    CHARS
        BLBC    R0, 85$
        MOVL    FIELDS+16, R1           ; the name
        MOVL    FIELDS+20, R2
        CMPL    R2, #39
        BGTRU   87$
        MOVL    #1, R3
        BSBW    CHARS
        BLBC    R0, 87$
        ADDL3   #1, FIELDS+24, R1       ; the type, past its dot
        SUBL3   #1, FIELDS+28, R2
        CMPL    R2, #39
        BGTRU   87$
        MOVL    #1, R3
        BSBW    CHARS
        BLBC    R0, 87$
        ADDL3   #1, FIELDS+32, R1       ; the version, past its semicolon
        SUBL3   #1, FIELDS+36, R2
        BNEQ    20$
        CLRL    RMS$L_VERSION           ; none: the highest
        BRB     70$
20$:    CMPB    (R1), #^A/*/
        BNEQ    25$
        CMPL    R2, #1
        BNEQ    89$
        MNEGL   #1, RMS$L_VERSION
        MOVL    #1, WILD
        BRB     70$
25$:    CLRL    R0
30$:    MOVZBL  (R1)+, R3
        SUBL2   #^A/0/, R3
        CMPL    R3, #9
        BGTRU   89$
        MULL2   #10, R0
        ADDL2   R3, R0
        CMPL    R0, #32767
        BGTRU   89$
        SOBGTR  R2, 30$
        MOVL    R0, RMS$L_VERSION
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DEV, R0
        RSB
85$:    MOVL    #RMS$_DIR, R0
        RSB
87$:    MOVL    #RMS$_FNM, R0
        RSB
89$:    MOVL    #RMS$_VER, R0
        RSB

; CHARS: R1 = a string, R2 = its length, R3 = bit 0 set if it may have
; the wildcards * and %, bit 1 if dots. R0 = 1 if it is made of letters,
; digits, $, _, - and those, else 0. Sets WILD for a wildcard. Uses R4.
CHARS:  CLRL    R4
10$:    CMPL    R4, R2
        BGEQU   70$
        MOVZBL  (R1)[R4], R0
        CMPB    R0, #^A/A/
        BLSSU   20$
        CMPB    R0, #^A/Z/
        BLEQU   60$
20$:    CMPB    R0, #^A/0/
        BLSSU   30$
        CMPB    R0, #^A/9/
        BLEQU   60$
30$:    CMPB    R0, #^A/$/
        BEQL    60$
        CMPB    R0, #^A/_/
        BEQL    60$
        CMPB    R0, #^A/-/
        BEQL    60$
        CMPB    R0, #^A/./
        BNEQ    40$
        BBS     #1, R3, 60$
        BRB     80$
40$:    CMPB    R0, #^A/*/
        BEQL    45$
        CMPB    R0, #^A/%/
        BNEQ    80$
45$:    BBC     #0, R3, 80$
        MOVL    #1, WILD
60$:    INCL    R4
        BRB     10$
70$:    MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; DIRWALK: finds the directory in FIELDS, from the MFD down, each name
; NAME.DIR;1 in the one before: [000000] is the MFD itself. Reads its
; header into RMS$AB_DIRHDR and its file ID into DIRFID. With CREDIR set,
; makes each one that isn't there, counting them in CREDIR. R0 =
; RMS$_NORMAL, RMS$_DNF, RMS$_DIR if a name isn't a directory, RMS$_WLK
; if one can't be made on the volume, RMS$_PRV without execute access to
; a directory it looks in, or write access to one it makes one in, or
; the file system's error. Uses R0-R11.
DIRWALK:
        MOVL    #MFD, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 99$
        ADDL3   #1, FIELDS+8, R10       ; the next name
        ADDL3   FIELDS+8, FIELDS+12, R11
        DECL    R11                     ; at the closing bracket
10$:    CMPL    R10, R11
        BLSSU   15$
        BRW     80$
15$:    MOVL    R10, R4                 ; the name's end
20$:    CMPL    R4, R11
        BGEQU   25$
        CMPB    (R4), #^A/./
        BEQL    25$
        INCL    R4
        BRB     20$
25$:    SUBL3   R10, R4, R7             ; its length
        BEQL    95$
        CMPL    R7, #6                  ; 000000: the MFD, where we are
        BNEQ    35$
        CLRL    R0
30$:    CMPB    (R10)[R0], MFDNAME[R0]
        BNEQ    35$
        AOBLSS  #6, R0, 30$
        BRB     70$
35$:    CMPL    R7, #39
        BGTRU   95$
        CLRL    R0                      ; NAME.DIR
40$:    MOVB    (R10)[R0], DIRPAT[R0]
        AOBLSS  R7, R0, 40$
        MOVAB   DIRPAT[R7], R0
        MOVL    DOTDIR, (R0)
        ADDL2   #4, R7
        MOVAB   DIRPAT, R6
        MOVL    #1, R8
        CLRL    R9
        MOVL    #ARM$M_EXECUTE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 99$
        MOVAB   RMS$AB_DIRHDR, R3
        PUSHL   R4
        BSBW    FIL$SEARCHDIR
        MOVL    (SP)+, R4
        BLBS    R0, 50$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    99$
        TSTL    CREDIR
        BEQL    90$
        MOVL    F11$GL_VCB, R0          ; not there: make it
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R0), 97$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 99$
        PUSHL   R4
        BSBW    FIL$MKDIR
        BLBC    R0, 98$
        MOVC3   #BLOCK, (R1), RMS$AB_DIRHDR
        MOVL    (SP)+, R4
        INCL    CREDIR
        BRB     70$
50$:    MOVL    R5, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$READHDR
        BLBC    R0, 99$
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    FIL$ISDIR
        BLBC    R0, 95$
70$:    ADDL3   #1, R4, R10             ; past the dot
        BRW     10$
80$:    MOVL    RMS$AB_DIRHDR+FH2$W_FID, DIRFID
        MOVW    RMS$AB_DIRHDR+FH2$W_FID+4, DIRFID+4
        MOVL    #RMS$_NORMAL, R0
        RSB
90$:    MOVL    #RMS$_DNF, R0
        RSB
95$:    MOVL    #RMS$_DIR, R0
        RSB
97$:    MOVL    #RMS$_WLK, R0
        RSB
98$:    TSTL    (SP)+
99$:    RSB

; RMS$FIND: after RMS$PARSE, R1 = a buffer. Finds the one file the
; expanded specification names, its highest version unless it gives one,
; makes its resultant specification and reads its header into the
; buffer. R0 = RMS$_NORMAL, RMS$_WLD, RMS$_FNF, RMS$_PRV, or the disk's
; error.
; Holding FIL$LOCK. Uses R0-R9.
RMS$FIND::
        TSTL    WILD
        BNEQ    80$
        PUSHL   R1
        CLRL    R9
        BSBB    SEARCH
        MOVL    (SP)+, R1
        BLBS    R0, 10$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    90$
        MOVL    #RMS$_FNF, R0
        RSB
10$:    MOVL    R5, R0
        BRW     FIL$READHDR
80$:    MOVL    #RMS$_WLD, R0
90$:    RSB

; SEARCH: after RMS$PARSE, R9 = how many matches to skip. Finds the next
; file the expanded specification names, and makes its resultant
; specification. R5 = its file number, R0 = SS$_NORMAL, SS$_NOMOREFILES,
; RMS$_PRV without execute access to the directory, or read access for a
; wildcard, or the disk's error. Uses R0-R8.
SEARCH: MOVL    #ARM$M_EXECUTE, R0
        TSTL    WILD
        BEQL    5$
        MOVL    #ARM$M_READ, R0
5$:     MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RMS$L_VERSION, R8
        BSBW    FIL$SEARCHDIR
        BLBC    R0, 90$
        PUSHL   R5
        BSBB    MKRES
        MOVL    (SP)+, R5
        MOVL    #SS$_NORMAL, R0
90$:    RSB

; MKRES: R1 = a name, NAME.TYPE, R2 = its length, R4 = a version. Makes
; the resultant specification in RES, with the expanded one's device and
; directory, and its parts in RESF. Uses R0-R6.
MKRES:  MOVL    R1, RESNAME
        MOVL    R2, RESNAME+4
        MOVL    R4, RESVER
        MOVAB   RES, R6
        CLRL    R5                      ; the device and directory
10$:    MOVAQ   RESF[R5], R3
        MOVL    R6, (R3)
        MOVAQ   FIELDS[R5], R0
        MOVL    (R0), R1
        MOVL    4(R0), R2
        BSBB    APPEND
        SUBL3   (R3), R6, 4(R3)
        AOBLSS  #2, R5, 10$
        MOVL    RESNAME, R1             ; the name, up to the dot
        CLRL    R2
20$:    CMPL    R2, RESNAME+4
        BGEQU   25$
        CMPB    (R1)[R2], #^A/./
        BEQL    25$
        INCL    R2
        BRB     20$
25$:    MOVL    R6, RESF+16
        BSBB    APPEND
        SUBL3   RESF+16, R6, RESF+20
        MOVL    R6, RESF+24             ; the type, the rest
        ADDL2   R2, R1
        SUBL3   R2, RESNAME+4, R2
        BSBB    APPEND
        SUBL3   RESF+24, R6, RESF+28
        MOVL    R6, RESF+32             ; the version
        MOVB    #59, (R6)+                ; a semicolon
        MOVL    RESVER, R1
        BSBB    DECIMAL
        SUBL3   RESF+32, R6, RESF+36
        MOVAB   RES, R0
        SUBL3   R0, R6, RESLEN
        RSB

; APPEND: copies the R2 bytes at R1 to R6, and R6 past them. Uses R0.
APPEND: CLRL    R0
10$:    CMPL    R0, R2
        BGEQU   20$
        MOVB    (R1)[R0], (R6)+
        INCL    R0
        BRB     10$
20$:    RSB

; DECIMAL: writes R1 in decimal at R6, and R6 past it. Uses R0-R3.
DECIMAL:
        CLRL    R2                      ; digits, on the stack
10$:    DIVL3   #10, R1, R0
        MULL3   #10, R0, R3
        SUBL3   R3, R1, R3
        ADDL2   #^A/0/, R3
        PUSHL   R3
        INCL    R2
        MOVL    R0, R1
        BNEQ    10$
20$:    MOVL    (SP)+, R0
        MOVB    R0, (R6)+
        SOBGTR  R2, 20$
        RSB

; PUTSTR: R0 = a specification, R1 = its length, R2 = its parts, R3 = a
; caller's string area in a NAM block, R4 = the area's size, R5 = the
; status if it is too small, R11 = the NAM block. Copies the
; specification to the area and points the NAM block's parts at it. R0 =
; RMS$_NORMAL, R5's status, or SS$_ACCVIO. Uses R0-R5.
PUTSTR: CMPL    R1, R4
        BLEQU   10$
        MOVL    R5, R0
        RSB
10$:    IFNOWRT R1, (R3), 80$
        PUSHL   R0
        CLRL    R5
20$:    CMPL    R5, R1
        BGEQU   30$
        MOVB    (R0)[R5], (R3)[R5]
        INCL    R5
        BRB     20$
30$:    CLRL    R5
40$:    MOVAQ   (R2)[R5], R1
        MOVB    4(R1), NAM$B_DEV(R11)[R5]
        SUBL3   (SP), (R1), R4
        ADDL2   R3, R4
        MOVL    R4, NAM$L_DEV(R11)[R5]
        AOBLSS  #5, R5, 40$
        TSTL    (SP)+
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; PUTRES: R11 = a NAM block. Copies the resultant specification to its
; resultant string area, if it has one, and the file's and directory's
; IDs. R0 = RMS$_NORMAL, RMS$_RSS or SS$_ACCVIO. Uses R0-R5.
PUTRES: MOVZBL  NAM$B_RSS(R11), R4
        BEQL    10$
        MOVAB   RES, R0
        MOVL    RESLEN, R1
        MOVAQ   RESF, R2
        MOVL    NAM$L_RSA(R11), R3
        MOVL    #RMS$_RSS, R5
        BSBW    PUTSTR
        BLBC    R0, 90$
        MOVB    RESLEN, NAM$B_RSL(R11)
10$:    MOVL    F11$GW_FID, NAM$W_FID(R11)
        MOVW    F11$GW_FID+4, NAM$W_FID+4(R11)
        MOVL    DIRFID, NAM$W_DID(R11)
        MOVW    DIRFID+4, NAM$W_DID+4(R11)
        MOVL    #RMS$_NORMAL, R0
90$:    RSB

; CHKACC: R0 = the access wanted, $ARMDEF's bits, R1 = a file header on
; F11$GL_VCB's volume. R0 = RMS$_NORMAL, or RMS$_PRV if the current
; process may not (FIL$CHKHDR). Keeps every other register.
CHKACC: BSBW    FIL$CHKHDR
        BLBC    R0, 10$
        MOVL    #RMS$_NORMAL, R0
        RSB
10$:    MOVL    #RMS$_PRV, R0
        RSB

; FINDXAB: R10 = a FAB. Finds the protection XAB in its chain: XABPRO =
; its address, or 0. R0 = RMS$_NORMAL, or SS$_ACCVIO if the caller can't
; read the chain or write the XAB. Uses R0-R2.
FINDXAB:
        CLRL    XABPRO
        MOVL    FAB$L_XAB(R10), R1
        MOVL    #MAXXAB, R2
10$:    TSTL    R1
        BEQL    70$
        IFNORD  #8, (R1), 80$
        CMPB    XAB$B_COD(R1), #XAB$C_PRO
        BEQL    20$
        MOVL    XAB$L_NXT(R1), R1
        SOBGTR  R2, 10$
        BRB     70$
20$:    IFNOWRT #XAB$C_PROLEN, (R1), 80$
        MOVL    R1, XABPRO
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; FABNAM: AP = a service's arguments, a FAB first. R10 = the FAB, R11 =
; its NAM block, or 0. R0 = RMS$_NORMAL; RMS$_FAB if the caller can't
; write a FAB there, RMS$_NAM if it can't a NAM block.
FABNAM: MOVL    4(AP), R10
        IFNOWRT #FAB$C_BLN, (R10), 80$
        CMPB    FAB$B_BID(R10), #FAB$C_BID
        BNEQ    80$
        CMPB    FAB$B_BLN(R10), #FAB$C_BLN
        BLSSU   80$
        MOVL    FAB$L_NAM(R10), R11
        BEQL    70$
        IFNOWRT #NAM$C_BLN, (R11), 85$
        CMPB    NAM$B_BID(R11), #NAM$C_BID
        BNEQ    85$
        CMPB    NAM$B_BLN(R11), #NAM$C_BLN
        BLSSU   85$
70$:    MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_FAB, R0
        RSB
85$:    MOVL    #RMS$_NAM, R0
        RSB

; PARSEFAB: R10 = a FAB. RMS$PARSE with its file specification and its
; default one, if the caller can read them. R0 = RMS$PARSE's status or
; SS$_ACCVIO. Uses R0-R4.
PARSEFAB:
        MOVL    FAB$L_FNA(R10), R0
        MOVZBL  FAB$B_FNS(R10), R1
        BEQL    10$
        IFNORD  R1, (R0), 80$
10$:    MOVL    FAB$L_DNA(R10), R2
        MOVZBL  FAB$B_DNS(R10), R3
        BEQL    20$
        IFNORD  R3, (R2), 80$
20$:    BSBW    SYSDFLT
        BRW     RMS$PARSE
80$:    MOVL    #SS$_ACCVIO, R0
        RSB

; SYSDFLT: R4 = SYSDEF, SYS$DISK: and the current process's default
; directory. Keeps every other register.
SYSDFLT:
        PUSHR   #^M<R0, R1, R2>
        MOVL    SCH$GL_CURPCB, R0
        MOVAB   PCB$T_DEFDIR(R0), R0
        MOVZBL  (R0)+, R1
        ADDB3   #9, R1, SYSDEF
        MOVAB   SYSDISK+9, R2
        TSTL    R1
        BEQL    20$
10$:    MOVB    (R0)+, (R2)+
        SOBGTR  R1, 10$
20$:    MOVAB   SYSDEF, R4
        POPR    #^M<R0, R1, R2>
        RSB

; FABDONE: R0 = a FAB service's status, R10 = the FAB. Puts it in
; FAB$L_STS, unless the FAB isn't one, and returns it.
        .MACRO  FABDONE ?L
        CMPL    R0, #RMS$_FAB
        BEQL    L
        MOVL    R0, FAB$L_STS(R10)
L:      BSBW    FIL$UNLOCK
        RET
        .ENDM   FABDONE

; RABDONE: the same for a RAB service, with the RAB in R10.
        .MACRO  RABDONE ?L
        CMPL    R0, #RMS$_RAB
        BEQL    L
        MOVL    R0, RAB$L_STS(R10)
L:      BSBW    FIL$UNLOCK
        RET
        .ENDM   RABDONE

; $PARSE fab: parses the FAB's file specification, with its default one,
; into its NAM block: the expanded string, if the NAM block has an area
; for it, its parts, its directory's ID, and NAM$M_WILDCARD. $SEARCH
; then finds the files it names. RMS$_DNF, when the directory doesn't
; exist, still gives the expanded string and its parts.
        .ENTRY  EXE$PARSE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVL    #RMS$_NAM, R0
        TSTL    R11
        BEQL    90$
        BSBW    PARSEFAB
        MOVL    R0, R9
        CMPL    R0, #RMS$_DNF
        BEQL    5$
        BLBC    R0, 90$
5$:     CLRL    NAM$L_WCC(R11)
        MOVZBL  NAM$B_ESS(R11), R4
        BEQL    10$
        MOVAB   RMS$T_EXP, R0
        MOVL    EXPLEN, R1
        MOVAQ   FIELDS, R2
        MOVL    NAM$L_ESA(R11), R3
        MOVL    #RMS$_ESS, R5
        BSBW    PUTSTR
        BLBC    R0, 90$
        MOVB    EXPLEN, NAM$B_ESL(R11)
10$:    MOVL    DIRFID, NAM$W_DID(R11)
        MOVW    DIRFID+4, NAM$W_DID+4(R11)
        CLRL    NAM$L_FNB(R11)
        TSTL    WILD
        BEQL    20$
        MOVL    #NAM$M_WILDCARD, NAM$L_FNB(R11)
20$:    MOVL    R9, R0
90$:    FABDONE

; $SEARCH fab: finds the next file the expanded string $PARSE left in the
; FAB's NAM block names, and puts its resultant string, its parts and its
; file ID there. RMS$_FNF if there is none at all, then RMS$_NMF when
; there are no more, and the next $SEARCH starts again. NAM$L_WCC counts
; the matches to skip, and WCC_FOUND says one was found.
        .ENTRY  EXE$SEARCH, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVL    #RMS$_NAM, R0
        TSTL    R11
        BEQL    90$
        MOVL    #RMS$_ESA, R0
        MOVZBL  NAM$B_ESL(R11), R1
        BEQL    90$
        MOVL    NAM$L_ESA(R11), R0
        IFNORD  R1, (R0), 85$
        CLRQ    R2
        BSBW    SYSDFLT
        BSBW    RMS$PARSE
        BLBC    R0, 90$
        BICL3   #WCC_FOUND, NAM$L_WCC(R11), R9
        BSBW    SEARCH
        BLBS    R0, 20$
        CMPL    R0, #SS$_NOMOREFILES
        BNEQ    90$
        MOVL    #RMS$_NMF, R0
        TSTL    NAM$L_WCC(R11)
        BNEQ    10$
        MOVL    #RMS$_FNF, R0
10$:    CLRL    NAM$L_WCC(R11)
        BRB     90$
20$:    INCL    NAM$L_WCC(R11)
        BISL2   #WCC_FOUND, NAM$L_WCC(R11)
        BSBW    PUTRES
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
90$:    FABDONE

; $OPEN fab: opens the file the FAB names, for reading: puts its IFI in
; the FAB, with its organization, record format and attributes, maximum
; record size, allocation and VFC header size, in its NAM block, if it
; has one, its resultant string and file ID, and in its protection XAB,
; if it has one, its owner and protection. RMS$_PRV without read access
; to it. With FAB$M_PUT, or another way of writing, in FAB$B_FAC, for
; $PUT as well: RMS$_WLK on a volume that can't be written, the system
; disk's, RMS$_PRV without write access too, or for the volume's own
; files and directories.
        .ENTRY  EXE$OPEN, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        BSBW    FINDXAB
        BLBC    R0, 90$
        BSBW    PARSEFAB
        BLBC    R0, 90$
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, FAB$B_FAC(R10)
        BEQL    10$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
10$:    BSBW    NEWIFAB
        BLBC    R0, 90$
        PUSHR   #^M<R7, R8, R9>
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    RMS$FIND
        POPR    #^M<R7, R8, R9>
        BLBC    R0, 80$
        MOVL    #ARM$M_READ, R0
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, FAB$B_FAC(R10)
        BEQL    12$
        MOVL    #ARM$M_READ!ARM$M_WRITE, R0
12$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    CHKACC
        BLBC    R0, 80$
        BITB    #FAB$M_PUT!FAB$M_DEL!FAB$M_UPD!FAB$M_TRN, FAB$B_FAC(R10)
        BEQL    20$
        MOVL    #RMS$_PRV, R0
        TSTB    IFB$AB_HDR+FH2$B_FID_NMX(R7)
        BNEQ    15$
        CMPW    IFB$AB_HDR+FH2$W_FID(R7), #RESFILES
        BLEQU   80$
15$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$ISDIR
        MOVL    R0, R1
        MOVL    #RMS$_PRV, R0
        BLBS    R1, 80$
        BISL2   #1@IFB$V_WRITE, IFB$L_FLAGS(R7)
20$:    TSTL    R11
        BEQL    30$
        BSBW    PUTRES
        BLBC    R0, 80$
30$:    MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$EOF
        MOVL    R0, IFB$L_EOF(R7)
        BSBW    INSTALL
        MOVZBL  IFB$AB_HDR+FAT$B_RTYPE(R7), R0
        BICB3   #^XF0, R0, FAB$B_RFM(R10)
        BICB3   #^X0F, R0, FAB$B_ORG(R10)
        MOVB    IFB$AB_HDR+FAT$B_RATTRIB(R7), FAB$B_RAT(R10)
        MOVW    IFB$AB_HDR+FAT$W_MAXREC(R7), FAB$W_MRS(R10)
        MOVB    IFB$AB_HDR+FAT$B_VFCSIZE(R7), FAB$B_FSZ(R10)
        MOVZWL  IFB$AB_HDR+FAT$L_HIBLK(R7), R0  ; high word first
        ASHL    #16, R0, R0
        MOVW    IFB$AB_HDR+FAT$L_HIBLK+2(R7), R0
        MOVL    R0, FAB$L_ALQ(R10)
        MOVL    XABPRO, R1
        BEQL    40$
        MOVW    IFB$AB_HDR+FH2$W_FILEPROT(R7), XAB$W_PRO(R1)
        MOVL    IFB$AB_HDR+FH2$L_FILEOWNER(R7), XAB$L_UIC(R1)
40$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    PUSHL   R0
        MOVL    R7, R0
        MOVL    #IFB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
90$:    FABDONE

; NEWIFAB: R9 = the current PCB, R8 = an IFI it has free, R7 = an IFAB
; for it, on F11$GL_VCB's volume, at the file's start, which INSTALL gives
; it. R0 = RMS$_NORMAL or RMS$_DME. Uses R0-R3.
NEWIFAB:
        MOVL    SCH$GL_CURPCB, R9       ; a free IFI
        MOVL    #1, R8
10$:    TSTL    PCB$A_IFAB(R9)[R8]
        BEQL    20$
        AOBLEQ  #MAXIFI, R8, 10$
        BRB     80$
20$:    MOVL    #IFB$K_LENGTH, R1
        BSBW    EXE$ALONONPAGED
        BLBC    R0, 80$
        MOVL    R2, R7
        CLRL    IFB$L_POS(R7)
        CLRL    IFB$L_EOF(R7)
        CLRL    IFB$L_BLOCK(R7)
        CLRL    IFB$L_FLAGS(R7)
        MOVL    F11$GL_VCB, IFB$L_VCB(R7)
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_DME, R0
        RSB

; INSTALL: R7 = an IFAB, R8 = its IFI, R9 = the current PCB, R10 = a FAB.
; Gives the process the open file, and the FAB its IFI. Uses R0.
INSTALL:
        MOVL    R7, PCB$A_IFAB(R9)[R8]
        ASHL    R8, #1, R0
        BISL2   R0, PCB$L_FILES(R9)
        MOVW    R8, FAB$W_IFI(R10)
        RSB

; GETIFAB: R8 = an IFI. R7 = its IFAB, R9 = the current PCB, R0 =
; RMS$_NORMAL, or RMS$_IFI if the process has no such file open.
GETIFAB:
        MOVL    SCH$GL_CURPCB, R9
        TSTL    R8
        BEQL    80$
        CMPL    R8, #MAXIFI
        BGTRU   80$
        MOVL    PCB$A_IFAB(R9)[R8], R7
        BEQL    80$
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_IFI, R0
        RSB

; CLOSEIFI: R8 = an IFI, R7 = its IFAB, R9 = the current PCB. Closes it:
; a file $CREATE made or $OPEN opened for $PUT gets its last block and its
; header written. R0 = RMS$_NORMAL, or RMS$_WER if they couldn't be.
; Holding FIL$LOCK. Uses R0 and R1.
CLOSEIFI:
        PUSHL   #RMS$_NORMAL
        BBC     #IFB$V_WRITE, IFB$L_FLAGS(R7), 20$
        PUSHR   #^M<R2, R3, R4, R5>
        BSBW    FLUSH
        BLBC    R0, 15$
        DIVL3   #BLOCK, IFB$L_EOF(R7), R0       ; the end of file
        INCL    R0
        ROTL    #16, R0, IFB$AB_HDR+FAT$L_EFBLK(R7)
        BICW3   #^C<BLOCK-1>, IFB$L_EOF(R7), IFB$AB_HDR+FAT$W_FFBYTE(R7)
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$WRITEHDR
15$:    POPR    #^M<R2, R3, R4, R5>
        BLBS    R0, 20$
        MOVL    #RMS$_WER, (SP)
20$:    CLRL    PCB$A_IFAB(R9)[R8]
        ASHL    R8, #1, R0
        BICL2   R0, PCB$L_FILES(R9)
        MOVL    R7, R0
        MOVL    #IFB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
        RSB

; FLUSH: R7 = an IFAB. Selects its volume and writes its last block, if
; $PUT left part of it in IFB$AB_BUF. R0 = SS$_NORMAL or the file
; system's error. Uses R0 and R1.
FLUSH:  MOVL    IFB$L_VCB(R7), F11$GL_VCB
        MOVL    #SS$_NORMAL, R0
        BBCC    #IFB$V_DIRTY, IFB$L_FLAGS(R7), 90$
        BICL3   #^C<BLOCK-1>, IFB$L_EOF(R7), R1
        BEQL    90$
        MOVL    IFB$L_BLOCK(R7), R1
        BSBW    WRITEBLK
90$:    RSB

; $CLOSE fab: closes the file $OPEN opened, which first gets the owner
; and protection of the FAB's protection XAB, if it has one (SETPRO).
; The file is closed even if that fails, with SETPRO's status.
        .ENTRY  EXE$CLOSE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        MOVZWL  FAB$W_IFI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 90$
        BSBW    SETPRO
        MOVL    R0, R6
        BSBW    CLOSEIFI
        CLRW    FAB$W_IFI(R10)
        BLBS    R6, 90$
        MOVL    R6, R0
90$:    FABDONE

; SETPRO: R7 = an IFAB, R10 = its FAB. If the FAB has a protection XAB
; whose protection, or owner, unless it is 0, isn't the file's, gives the
; file those, in its header on the disk and in the IFAB's: a new
; protection takes control access, a new owner the system's. R0 =
; RMS$_NORMAL, RMS$_PRV, RMS$_WLK on a volume that can't be written,
; SS$_ACCVIO if the caller can't read the XAB, or the file system's error.
; Holding FIL$LOCK. Uses R0-R5.
SETPRO: BSBW    FINDXAB
        BLBC    R0, 90$
        MOVL    XABPRO, R4
        BEQL    80$
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        CLRL    R5                      ; the access it takes
        CMPW    XAB$W_PRO(R4), IFB$AB_HDR+FH2$W_FILEPROT(R7)
        BEQL    10$
        BISL2   #ARM$M_CONTROL, R5
10$:    MOVL    XAB$L_UIC(R4), R0
        BNEQ    15$
        MOVL    IFB$AB_HDR+FH2$L_FILEOWNER(R7), R0
15$:    CMPL    R0, IFB$AB_HDR+FH2$L_FILEOWNER(R7)
        BEQL    20$
        BISL2   #ARM$M_SYSTEM, R5
20$:    TSTL    R5
        BEQL    80$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVZBL  IFB$AB_HDR+FH2$B_FID_NMX(R7), R0        ; the header as it is now
        ASHL    #16, R0, R0
        MOVW    IFB$AB_HDR+FH2$W_FID(R7), R0
        MOVAB   HDRBUF, R1
        BSBW    FIL$READHDR
        BLBC    R0, 90$
        MOVL    #RMS$_FNF, R0           ; deleted since it was opened
        CMPW    HDRBUF+FH2$W_FID_SEQ, IFB$AB_HDR+FH2$W_FID_SEQ(R7)
        BNEQ    90$
        MOVL    R5, R0
        MOVAB   HDRBUF, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVW    XAB$W_PRO(R4), HDRBUF+FH2$W_FILEPROT
        MOVW    XAB$W_PRO(R4), IFB$AB_HDR+FH2$W_FILEPROT(R7)
        MOVL    XAB$L_UIC(R4), R0
        BEQL    30$
        MOVL    R0, HDRBUF+FH2$L_FILEOWNER
        MOVL    R0, IFB$AB_HDR+FH2$L_FILEOWNER(R7)
30$:    MOVAB   HDRBUF, R1
        BSBW    FIL$WRITEHDR
        BLBC    R0, 90$
80$:    MOVL    #RMS$_NORMAL, R0
90$:    RSB

; RABCHK: AP = a service's arguments, a RAB first. R10 = the RAB, R0 =
; RMS$_NORMAL, or RMS$_RAB if the caller can't write a RAB there.
RABCHK: MOVL    4(AP), R10
        IFNOWRT #RAB$C_BLN, (R10), 80$
        CMPB    RAB$B_BID(R10), #RAB$C_BID
        BNEQ    80$
        CMPB    RAB$B_BLN(R10), #RAB$C_BLN
        BLSSU   80$
        MOVL    #RMS$_NORMAL, R0
        RSB
80$:    MOVL    #RMS$_RAB, R0
        RSB

; $CONNECT rab: connects the RAB to the file its FAB opened, at its start,
; or at its end with RAB$M_EOF in RAB$L_ROP.
        .ENTRY  EXE$CONNECT, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBB    RABCHK
        BLBC    R0, 90$
        MOVL    RAB$L_FAB(R10), R1
        IFNORD  #FAB$C_BLN, (R1), 80$
        MOVZWL  FAB$W_IFI(R1), R8
        BSBB    GETIFAB
        BLBC    R0, 90$
        CLRL    IFB$L_POS(R7)
        BITL    #RAB$M_EOF, RAB$L_ROP(R10)
        BEQL    10$
        MOVL    IFB$L_EOF(R7), IFB$L_POS(R7)
10$:    MOVW    R8, RAB$W_ISI(R10)
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #RMS$_FAB, R0
90$:    RABDONE

; $DISCONNECT rab: disconnects the RAB from its file.
        .ENTRY  EXE$DISCONNECT, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABCHK
        BLBC    R0, 90$
        MOVZWL  RAB$W_ISI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 80$
        CLRW    RAB$W_ISI(R10)
        BRB     90$
80$:    MOVL    #RMS$_ISI, R0
90$:    RABDONE

; $GET rab: reads the next record into the RAB's user buffer, as much of
; it as fits: RAB$L_RBF points at it and RAB$W_RSZ is its size.
; RMS$_RTB if it didn't all fit, RMS$_EOF past the last, RMS$_RFM for a
; file whose records are neither VAR nor FIX.
        .ENTRY  EXE$GET, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABCHK
        BLBC    R0, 90$
        MOVZWL  RAB$W_ISI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 87$
        MOVL    RAB$L_UBF(R10), R6
        MOVZWL  RAB$W_USZ(R10), R5
        BEQL    10$
        IFNOWRT R5, (R6), 85$
10$:    BITL    #1, IFB$L_POS(R7)       ; records start on a word
        BEQL    15$
        INCL    IFB$L_POS(R7)
15$:    BICB3   #^XF0, IFB$AB_HDR+FAT$B_RTYPE(R7), R0
        CMPB    R0, #FAB$C_FIX
        BEQL    20$
        CMPB    R0, #FAB$C_VAR
        BNEQ    86$
        BSBW    GETWORD                 ; VAR: its size first
        BLBC    R1, 88$
        CMPL    R0, #^XFFFF             ; none left in the block
        BNEQ    25$
        ADDL2   #BLOCK-1, IFB$L_POS(R7)
        BICL2   #BLOCK-1, IFB$L_POS(R7)
        BRB     15$
20$:    MOVZWL  IFB$AB_HDR+FAT$W_RSIZE(R7), R0
25$:    MOVL    R0, R4                  ; the record's size
        MOVL    R0, R2                  ; the bytes left of it
        CLRL    R3                      ; the bytes read
30$:    TSTL    R2
        BEQL    40$
        BSBW    GETBYTE
        BLBC    R1, 88$
        CMPL    R3, R5
        BGEQU   35$
        MOVB    R0, (R6)[R3]
35$:    INCL    R3
        DECL    R2
        BRB     30$
40$:    MOVL    R6, RAB$L_RBF(R10)
        MOVL    #RMS$_NORMAL, R0
        CMPL    R4, R5
        BLEQU   45$
        MOVL    R5, R4
        MOVL    #RMS$_RTB, R0
45$:    MOVW    R4, RAB$W_RSZ(R10)
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
        BRB     90$
86$:    MOVL    #RMS$_RFM, R0
        BRB     90$
87$:    MOVL    #RMS$_ISI, R0
        BRB     90$
88$:    MOVL    R1, R0
90$:    RABDONE

; $CREATE fab: makes a new file, as the FAB names it, with its
; organization, record format and attributes, maximum record size, VFC
; header size and allocation, FAB$L_ALQ blocks, and opens it for $PUT:
; its IFI goes in the FAB, and in its NAM block, if it has one, its
; resultant string and file ID. Its version is one above the highest
; there is, unless the specification gives one. The file is the current
; process's, with the default protection (f11wrt.mar). RMS$_WLD for a
; wildcard, RMS$_WLK on a volume that can't be written, RMS$_PRV without
; write access to the directory, RMS$_FEX if that version is
; there, RMS$_FUL if the volume is full, RMS$_CRE for another error from
; the file system, which goes in FAB$L_STV.
        .ENTRY  EXE$CREATE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        BSBW    PARSEFAB
        BLBC    R0, 90$
        MOVL    #RMS$_WLD, R0
        TSTL    WILD
        BNEQ    90$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        BSBW    NEWIFAB
        BLBC    R0, 90$
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$CREHDR
        BLBC    R0, 70$
        BISB3   FAB$B_ORG(R10), FAB$B_RFM(R10), IFB$AB_HDR+FAT$B_RTYPE(R7)
        MOVB    FAB$B_RAT(R10), IFB$AB_HDR+FAT$B_RATTRIB(R7)
        MOVW    FAB$W_MRS(R10), IFB$AB_HDR+FAT$W_MAXREC(R7)
        CMPB    FAB$B_RFM(R10), #FAB$C_FIX
        BNEQ    10$
        MOVW    FAB$W_MRS(R10), IFB$AB_HDR+FAT$W_RSIZE(R7)
10$:    MOVB    FAB$B_FSZ(R10), IFB$AB_HDR+FAT$B_VFCSIZE(R7)
        MOVL    DIRFID, IFB$AB_HDR+FH2$W_BACKLINK(R7)
        MOVW    DIRFID+4, IFB$AB_HDR+FH2$W_BACKLINK+4(R7)
        MOVL    FAB$L_ALQ(R10), R1
        BEQL    20$
        MOVAB   IFB$AB_HDR(R7), R3
        BSBW    FIL$EXTEND
        BLBC    R0, 60$
20$:    BSBW    CRENTER
        BLBC    R0, 60$
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$WRITEHDR
        BLBC    R0, 60$
        MOVL    FIELDS+16, R1           ; its resultant string
        ADDL3   FIELDS+20, FIELDS+28, R2
        BSBW    MKRES
        MOVL    IFB$AB_HDR+FH2$W_FID(R7), F11$GW_FID
        MOVW    IFB$AB_HDR+FH2$W_FID+4(R7), F11$GW_FID+4
        TSTL    R11
        BEQL    30$
        BSBW    PUTRES
30$:    BISL2   #<1@IFB$V_WRITE>!<1@IFB$V_DIRTY>, IFB$L_FLAGS(R7)
        MOVL    #1, IFB$L_BLOCK(R7)
        MOVC5   #0, (R7), #0, #BLOCK, IFB$AB_BUF(R7)
        BSBW    INSTALL
        ROTL    #16, IFB$AB_HDR+FAT$L_HIBLK(R7), FAB$L_ALQ(R10)
        MOVL    #RMS$_NORMAL, R0
        BRB     90$
60$:    PUSHL   R0                      ; its blocks and header go back
        MOVAB   IFB$AB_HDR(R7), R1
        BSBW    FIL$DELHDR
        MOVL    (SP)+, R0
70$:    MOVL    R0, FAB$L_STV(R10)
        MOVL    R0, R1
        MOVL    #RMS$_FUL, R0
        CMPL    R1, #SS$_DEVICEFULL
        BEQL    75$
        MOVL    #RMS$_FEX, R0
        CMPL    R1, #SS$_DUPFILENAME
        BEQL    75$
        MOVL    #RMS$_CRE, R0
75$:    PUSHL   R0
        MOVL    R7, R0
        MOVL    #IFB$K_LENGTH, R1
        BSBW    EXE$DEANONPGDSIZ
        MOVL    (SP)+, R0
90$:    FABDONE

; CRENTER: R7 = an IFAB with a new file's header. Enters the file in the
; directory RMS$PARSE found, with the expanded specification's name and
; version, and puts the name in the header: R4 = the version. R0 =
; SS$_NORMAL or FIL$ENTER's error. Uses R0-R6.
CRENTER:
        PUSHR   #^M<R7, R8>
        MOVAB   IFB$AB_HDR+FH2$W_FID(R7), R5
        MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RMS$L_VERSION, R8
        BSBW    FIL$ENTER
        BLBC    R0, 90$
        MOVL    (SP), R1
        MOVAB   IFB$AB_HDR(R1), R1
        BSBW    FIL$SETNAME
90$:    POPR    #^M<R7, R8>
        RSB

; $ERASE fab: deletes the file the FAB names, its highest version unless
; the specification gives one: its directory entry, its header and its
; blocks. With FAB$M_NAM in FAB$L_FOP, the file its NAM block's resultant
; string names, which $SEARCH found, and the NAM block's next $SEARCH
; finds the file after it. RMS$_WLD for a wildcard, RMS$_FNF if there is
; no such file, RMS$_WLK on a volume that can't be written, RMS$_PRV for
; the volume's own files, or without delete access to the file and write
; access to its directory, RMS$_MKD if the file system fails, with its
; error in FAB$L_STV: SS$_DIRNOTEMPTY for a directory with files in it.
; ponytail: an open file is deleted all the same.
        .ENTRY  EXE$ERASE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    FABNAM
        BLBC    R0, 90$
        CLRL    R9                      ; 1: by the NAM block
        TSTL    R11
        BEQL    10$
        BITL    #FAB$M_NAM, FAB$L_FOP(R10)
        BEQL    10$
        MOVZBL  NAM$B_RSL(R11), R1
        BEQL    10$
        MOVL    NAM$L_RSA(R11), R0
        IFNORD  R1, (R0), 85$
        MOVL    #1, R9
        CLRQ    R2
        BSBW    SYSDFLT
        BSBW    RMS$PARSE
        BRB     15$
10$:    BSBW    PARSEFAB
15$:    BLBC    R0, 90$
        MOVL    F11$GL_VCB, R1
        MOVL    #RMS$_WLK, R0
        BBC     #VCB$V_WRITE, VCB$L_STATUS(R1), 90$
        PUSHL   R9
        MOVAB   HDRBUF, R1
        BSBW    RMS$FIND
        MOVL    (SP)+, R9
        BLBC    R0, 90$
        MOVL    #RMS$_PRV, R0
        TSTB    HDRBUF+FH2$B_FID_NMX
        BNEQ    20$
        CMPW    HDRBUF+FH2$W_FID, #RESFILES
        BLEQU   90$
20$:    MOVL    #ARM$M_DELETE, R0
        MOVAB   HDRBUF, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVL    #ARM$M_WRITE, R0
        MOVAB   RMS$AB_DIRHDR, R1
        BSBW    CHKACC
        BLBC    R0, 90$
        MOVAB   HDRBUF, R1              ; a directory must be empty
        BSBW    FIL$ISDIR
        BLBC    R0, 25$
        MOVL    #1, R0
        MOVL    #1, R1
        MOVAB   F11$AB_DIRBLK, R2
        MOVAB   HDRBUF, R3
        BSBW    FIL$READVBN
        BLBC    R0, 80$
        MOVL    #SS$_DIRNOTEMPTY, R0
        CMPW    F11$AB_DIRBLK, #^XFFFF
        BNEQ    80$
25$:    MOVAB   RMS$AB_DIRHDR, R3
        MOVL    FIELDS+16, R6           ; NAME.TYPE
        ADDL3   FIELDS+20, FIELDS+28, R7
        MOVL    RESVER, R8
        BSBW    FIL$REMOVE
        BLBC    R0, 80$
        MOVAB   HDRBUF, R1
        BSBW    FIL$DELHDR
        BLBC    R0, 80$
        BLBC    R9, 30$                 ; one match fewer to skip
        BITL    #^C<WCC_FOUND>, NAM$L_WCC(R11)
        BEQL    30$
        DECL    NAM$L_WCC(R11)
30$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    MOVL    R0, FAB$L_STV(R10)
        MOVL    #RMS$_MKD, R0
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
90$:    FABDONE

; $PUT rab: appends the record RAB$L_RBF points at, RAB$W_RSZ bytes, to
; the file $CREATE made or $OPEN opened for it, at its end: a VAR record
; with its size first, a FIX one as it is, each on a word, and a VAR one
; that would cross into the next block in it, if the file's records don't
; span blocks. RMS$_IOP for a file opened only to read, RMS$_NEF if the
; stream isn't at the file's end, RMS$_RSZ for a FIX record of another size than the
; file's or a VAR one longer than its maximum, RMS$_RFM for another record
; format, RMS$_WER if the file system fails, with its error in RAB$L_STV.
        .ENTRY  EXE$PUT, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        BSBW    FIL$LOCK
        BSBW    RABCHK
        BLBC    R0, 90$
        MOVZWL  RAB$W_ISI(R10), R8
        BSBW    GETIFAB
        BLBC    R0, 87$
        MOVL    #RMS$_IOP, R0
        BBC     #IFB$V_WRITE, IFB$L_FLAGS(R7), 90$
        MOVL    #RMS$_NEF, R0           ; past it if $GET aligned a record
        CMPL    IFB$L_POS(R7), IFB$L_EOF(R7)
        BLSSU   90$
        MOVL    IFB$L_VCB(R7), F11$GL_VCB
        BBS     #IFB$V_DIRTY, IFB$L_FLAGS(R7), 5$
        BSBW    LOADEND
        BLBC    R1, 88$
5$:     MOVL    IFB$L_EOF(R7), IFB$L_POS(R7)
        MOVL    RAB$L_RBF(R10), R6
        MOVZWL  RAB$W_RSZ(R10), R5
        BEQL    10$
        IFNORD  R5, (R6), 85$
10$:    MOVL    #RMS$_RSZ, R0
        BICB3   #^XF0, IFB$AB_HDR+FAT$B_RTYPE(R7), R1
        CMPB    R1, #FAB$C_FIX
        BNEQ    20$
        CMPW    R5, IFB$AB_HDR+FAT$W_RSIZE(R7)
        BNEQ    90$
        BSBW    ALIGN
        BLBC    R1, 88$
        BRB     45$
20$:    CMPB    R1, #FAB$C_VAR
        BNEQ    86$
        TSTW    IFB$AB_HDR+FAT$W_MAXREC(R7)
        BEQL    25$
        CMPW    R5, IFB$AB_HDR+FAT$W_MAXREC(R7)
        BGTRU   90$
25$:    CMPW    R5, IFB$AB_HDR+FAT$W_RSIZE(R7)  ; the longest record
        BLEQU   30$
        MOVW    R5, IFB$AB_HDR+FAT$W_RSIZE(R7)
30$:    BSBW    ALIGN
        BLBC    R1, 88$
        BITB    #FAB$M_BLK, IFB$AB_HDR+FAT$B_RATTRIB(R7)
        BEQL    35$
        BICL3   #^C<BLOCK-1>, IFB$L_POS(R7), R0
        BEQL    35$
        ADDL2   R5, R0
        ADDL2   #2, R0
        CMPL    R0, #BLOCK
        BLEQU   35$
32$:    MNEGL   #1, R0                  ; the block ends here: all ones
        BSBW    PUTBYTE
        BLBC    R1, 88$
        BICL3   #^C<BLOCK-1>, IFB$L_POS(R7), R0
        BNEQ    32$
35$:    MOVL    R5, R0                  ; the size, low byte first
        BSBW    PUTBYTE
        BLBC    R1, 88$
        ASHL    #-8, R5, R0
        BSBW    PUTBYTE
        BLBC    R1, 88$
45$:    CLRL    R4
50$:    CMPL    R4, R5
        BGEQU   60$
        MOVZBL  (R6)[R4], R0
        BSBW    PUTBYTE
        BLBC    R1, 88$
        INCL    R4
        BRB     50$
60$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
85$:    MOVL    #SS$_ACCVIO, R0
        BRB     90$
86$:    MOVL    #RMS$_RFM, R0
        BRB     90$
87$:    MOVL    #RMS$_ISI, R0
        BRB     90$
88$:    MOVL    R1, RAB$L_STV(R10)
        MOVL    #RMS$_WER, R0
90$:    RABDONE

; LOADEND: R7 = an IFAB $PUT writes, whose last block IFB$AB_BUF doesn't
; hold. Reads it there, if the file ends partway into it, else clears it,
; for PUTBYTE to fill. R1 = SS$_NORMAL or the disk's error. Uses R0-R5.
LOADEND:
        BICL3   #^C<BLOCK-1>, IFB$L_EOF(R7), R1
        BNEQ    10$
        MOVC5   #0, (R7), #0, #BLOCK, IFB$AB_BUF(R7)
        BRB     20$
10$:    DIVL3   #BLOCK, IFB$L_EOF(R7), R0
        INCL    R0
        MOVL    #1, R1
        MOVAB   IFB$AB_BUF(R7), R2
        MOVAB   IFB$AB_HDR(R7), R3
        BSBW    FIL$READVBN
        MOVL    R0, R1
        BLBC    R1, 90$
20$:    DIVL3   #BLOCK, IFB$L_EOF(R7), R0
        ADDL3   #1, R0, IFB$L_BLOCK(R7)
        BISL2   #1@IFB$V_DIRTY, IFB$L_FLAGS(R7)
        MOVL    #SS$_NORMAL, R1
90$:    RSB

; ALIGN: R7 = an IFAB $PUT writes. Writes a byte if it is at an odd one,
; so the next record starts on a word. R1 = PUTBYTE's status. Uses R0.
ALIGN:  MOVL    #RMS$_NORMAL, R1
        BLBC    IFB$L_POS(R7), 10$
        CLRL    R0
        BSBB    PUTBYTE
10$:    RSB

; PUTBYTE: R7 = an IFAB $PUT writes, R0 = a byte. Writes it at the file's
; end, a block at a time. R1 = RMS$_NORMAL, or the file system's error.
PUTBYTE:
        BICL3   #^C<BLOCK-1>, IFB$L_POS(R7), R1
        MOVB    R0, IFB$AB_BUF(R7)[R1]
        INCL    IFB$L_POS(R7)
        MOVL    IFB$L_POS(R7), IFB$L_EOF(R7)
        BICL3   #^C<BLOCK-1>, IFB$L_POS(R7), R1
        BNEQ    80$
        PUSHR   #^M<R0, R2, R3, R4, R5>  ; the block is full
        DIVL3   #BLOCK, IFB$L_POS(R7), R1
        ADDL3   #1, R1, IFB$L_BLOCK(R7)
        BSBB    WRITEBLK
        PUSHL   R0
        MOVC5   #0, (R7), #0, #BLOCK, IFB$AB_BUF(R7)
        MOVL    (SP)+, R1
        POPR    #^M<R0, R2, R3, R4, R5>
        RSB
80$:    MOVL    #RMS$_NORMAL, R1
        RSB

; WRITEBLK: R7 = an IFAB $PUT writes, R1 = a VBN. Writes the IFAB's block
; there, extending the file first if it hasn't that many, by EXTEND
; blocks at least. R0 = SS$_NORMAL, or the file system's error. Keeps
; every other register.
WRITEBLK:
        PUSHR   #^M<R1, R2, R3>
        MOVAB   IFB$AB_HDR(R7), R3
        ROTL    #16, FAT$L_HIBLK(R3), R0
        CMPL    R1, R0
        BLEQU   10$
        SUBL3   R0, R1, R1
        CMPL    R1, #EXTEND
        BGEQU   5$
        MOVL    #EXTEND, R1
5$:     BSBW    FIL$EXTEND
        ROTL    #16, FAT$L_HIBLK(R3), R1        ; enough, even if not all?
        CMPL    (SP), R1
        BGTRU   90$
10$:    MOVL    (SP), R0
        MOVL    #1, R1
        MOVAB   IFB$AB_BUF(R7), R2
        BSBW    FIL$WRITEVBN
90$:    POPR    #^M<R1, R2, R3>
        RSB

; GETWORD: R7 = an IFAB. R0 = the next word of its file, low byte first,
; R1 = RMS$_NORMAL, RMS$_EOF or the disk's error.
GETWORD:
        BSBB    GETBYTE
        BLBC    R1, 90$
        PUSHL   R0
        BSBB    GETBYTE
        BLBC    R1, 80$
        ASHL    #8, R0, R0
        BISL2   (SP)+, R0
        RSB
80$:    TSTL    (SP)+
90$:    RSB

; GETBYTE: R7 = an IFAB. R0 = the next byte of its file, read a block at
; a time, R1 = RMS$_NORMAL, RMS$_EOF past its end of file, or the disk's
; error.
GETBYTE:
        MOVL    #RMS$_EOF, R1
        CMPL    IFB$L_POS(R7), IFB$L_EOF(R7)
        BGEQU   90$
        PUSHR   #^M<R2, R3>
        DIVL3   #BLOCK, IFB$L_POS(R7), R0
        INCL    R0                      ; the byte's VBN
        CMPL    R0, IFB$L_BLOCK(R7)
        BEQL    20$
        PUSHL   R0
        BSBW    FLUSH                   ; what $PUT left in the block first
        BLBC    R0, 10$
        MOVL    (SP), R0
        MOVL    #1, R1
        MOVAB   IFB$AB_BUF(R7), R2
        MOVAB   IFB$AB_HDR(R7), R3
        BSBW    FIL$READVBN
10$:    MOVL    R0, R1
        MOVL    (SP)+, R0
        BLBC    R1, 80$
        MOVL    R0, IFB$L_BLOCK(R7)
20$:    BICL3   #^C<BLOCK-1>, IFB$L_POS(R7), R0
        MOVZBL  IFB$AB_BUF(R7)[R0], R0
        INCL    IFB$L_POS(R7)
        MOVL    #RMS$_NORMAL, R1
80$:    POPR    #^M<R2, R3>
90$:    RSB

; $CREATE_DIR devdirspec: makes the directory devdirspec names,
; [dev:][dir.dir...], what it leaves out from SYS$DISK: and the default
; directory, and each one above it that isn't there either: an empty
; NAME.DIR;1 in the one above it. SS$_CREATED if it made one, SS$_NORMAL
; if they were all there, SS$_ACCVIO if the caller can't read devdirspec,
; RMS$_WLK on a volume that can't be written, RMS$_PRV without write
; access to the one above, or RMS$PARSE's or the file system's error,
; with the ones above made. Each is the current process's, with the one
; above's protection, but delete (FIL$MKDIR).
; ponytail: a service; VMS's LIB$CREATE_DIR asks the XQP with $QIO
; IO$_CREATE, and there are no XQP functions on disk channels. No owner,
; protection or version limit arguments.
        .ENTRY  EXE$CREATE_DIR, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    4(AP), R1
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2
        MOVL    4(R1), R0
        MOVL    R2, R1
        BSBW    FIL$LOCK
        MOVL    #1, CREDIR
        CLRQ    R2
        BSBW    SYSDFLT
        BSBW    RMS$PARSE
        BLBC    R0, 80$
        MOVL    #SS$_NORMAL, R0
        CMPL    CREDIR, #1
        BEQL    80$
        MOVL    #SS$_CREATED, R0
80$:    CLRL    CREDIR
        BSBW    FIL$UNLOCK
90$:    RET

; RMS$VOLIDLE: R1 = a VCB. R0 = SS$_NORMAL if no process has a file on
; its volume open, else SS$_DEVACTIVE. Holding FIL$LOCK, which keeps
; their files open or closed. Uses R0 and R2-R4.
RMS$VOLIDLE::
        DSBINT  #IPL$_SYNCH             ; their PCBs
        MOVL    #SCH$C_MAXPIX-1, R2
10$:    MOVL    SCH$GL_PCBVEC[R2], R3
        BEQL    40$
        MOVL    #1, R4
20$:    BBC     R4, PCB$L_FILES(R3), 30$
        MOVL    PCB$A_IFAB(R3)[R4], R0
        CMPL    IFB$L_VCB(R0), R1
        BEQL    80$
30$:    AOBLEQ  #MAXIFI, R4, 20$
40$:    SOBGTR  R2, 10$
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_DEVACTIVE, R0
90$:    ENBINT
        RSB

; RMS$RUNDOWN: R4 = the current PCB, R0 = a mask of IFIs. Closes the
; process's files but those, taking FIL$LOCK. Uses R0-R3.
RMS$RUNDOWN::
        PUSHR   #^M<R7, R8, R9>
        BSBW    FIL$LOCK
        MOVL    R0, R3
        MOVL    R4, R9
        MOVL    #1, R8
10$:    BBC     R8, PCB$L_FILES(R4), 20$
        BBS     R8, R3, 20$
        MOVL    PCB$A_IFAB(R4)[R8], R7
        BSBW    CLOSEIFI
20$:    AOBLEQ  #MAXIFI, R8, 10$
        BSBW    FIL$UNLOCK
        POPR    #^M<R7, R8, R9>
        RSB

        ; $SETDDIR newdir, oldlen, olddir: sets the process's default directory,
; the one a file specification without one is in. Writes the old one
; first, as much as fits, in olddir's buffer, and the length written in
; the word at oldlen. Each argument may be 0. newdir is [dir.dir...] or
; <...>, up to 63 characters, not relative: RMS$_DIR if it isn't, SS$_ACCVIO if the
; caller can't read or write an argument. It isn't looked for on the disk.
        .ENTRY  EXE$SETDDIR, ^M<R2, R3, R4, R5, R6>
        DSBINT  #IPL$_SYNCH
        MOVL    SCH$GL_CURPCB, R6
        MOVAB   PCB$T_DEFDIR(R6), R6
        MOVZBL  (R6), R5                ; the old one's length
        MOVL    12(AP), R1
        BEQL    20$
        IFNORD  #8, (R1), 80$
        MOVZWL  (R1), R2
        CMPL    R5, R2
        BGEQU   10$
        MOVL    R5, R2
10$:    MOVL    R2, R5
        BEQL    20$
        MOVL    4(R1), R3
        IFNOWRT R2, (R3), 80$
15$:    MOVB    (R6)[R2], -1(R3)[R2]
        SOBGTR  R2, 15$
20$:    MOVL    8(AP), R1
        BEQL    30$
        IFNOWRT #2, (R1), 80$
        MOVW    R5, (R1)
30$:    MOVL    4(AP), R1
        BEQL    70$
        BSBW    EXE$PROBER_DSC
        BLBC    R0, 90$
        MOVZWL  (R1), R2
        MOVL    4(R1), R1
        CMPL    R2, #3
        BLSSU   85$
        CMPL    R2, #63
        BGTRU   85$
        CMPB    (R1), #91               ; [ or <
        BEQL    35$
        CMPB    (R1), #60
        BNEQ    85$
35$:    CMPB    -1(R1)[R2], #93         ; ] or >
        BEQL    37$
        CMPB    -1(R1)[R2], #62
        BNEQ    85$
37$:    CMPB    1(R1), #^A/-/           ; not a relative one
        BEQL    85$
        CMPB    1(R1), #^A/./
        BEQL    85$
40$:    PUSHR   #^M<R1, R2>
        INCL    R1
        SUBL2   #2, R2
        MOVL    #2, R3                  ; dots, no wildcards
        BSBW    CHARS
        POPR    #^M<R1, R2>
        BLBC    R0, 85$
        MOVB    R2, (R6)+
45$:    MOVB    (R1)+, (R6)+
        SOBGTR  R2, 45$
70$:    MOVL    #RMS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_ACCVIO, R0
        BRB     90$
85$:    MOVL    #RMS$_DIR, R0
90$:    ENBINT
        RET

        .END
