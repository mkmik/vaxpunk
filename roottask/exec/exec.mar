        .TITLE  EXEC    The executive's start, and the swapper
        .IDENT  /V0.3/
;
; The root task, the PAL, starts EXEC.EXE as a task of its own, in kernel
; mode at IPL 31, with R11 pointing at the restart parameter block
; (docs/design/0001-pal-interface.md). EXEC$START sets up the system
; control block, memory, the scheduler, the system time and the console,
; starts the console's process, SYSTEM, which runs DCL, and becomes the
; swapper, process 1, which deletes what deleted processes leave behind
; (docs/design/0002-executive-processes.md).
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        $PRDEF
        $IPLDEF
        $SCBDEF
        $PTEDEF
        $PRTDEF
        $SSDEF

        .EXTERNAL EXE$OUTZSTRING, EXE$OUTHEX, EXE$OUTCRLF
        .EXTERNAL EXE$CMODKRNL, EXE$CMODEXEC, EXE$ACVIOLAT, EXE$OPCDEC
        .EXTERNAL SCH$RESCHED, MMG$INIT, SCH$INIT, MMG$GL_FREECNT, MMG$SETPRT
        .EXTERNAL EXE$HWCLKINT, EXE$SWTIMINT, EXE$INITTIM
        .EXTERNAL SCH$GQ_DELQ, EXE$DELETEPCB, EXE$VECTOR, EXE$VECTOREND
        .EXTERNAL TTY$INIT, TTY$RCVINT, TTY$IOPOST

UREXEC = PTE$M_VALID ! <PRT$C_UR @ PTE$V_PROT> ! PTE$M_EXEC

        .PSECT  EXEC$DATA, NOEXE, WRT, QUAD
EXE$GL_RPB::                            ; the restart parameter block
        .LONG   0
EXE$AL_SCB::                            ; the system control block
        .BLKB   SCB$K_LENGTH
CONSOLE_IMAGE:
        .ASCID  "DCL.EXE"
CONSOLE_NAME:
        .ASCID  "SYSTEM"
BANNER: .ASCIZ  "%EXEC-I-START, vaxpunk executive, free pages: "
NOSTART:
        .ASCIZ  "%EXEC-F-NOSTART, can't create SYSTEM, status "

        .PSECT  $CODE$
        .ENTRY  EXEC$START, ^M<>
        MOVL    R11, EXE$GL_RPB
        MOVAB   EXE$OPCDEC, EXE$AL_SCB+SCB$L_OPCDEC
        MOVAB   EXE$ACVIOLAT, EXE$AL_SCB+SCB$L_ACCVIO
        MOVAB   EXE$CMODKRNL, EXE$AL_SCB+SCB$L_CHMK
        MOVAB   EXE$CMODEXEC, EXE$AL_SCB+SCB$L_CHME
        MOVAB   SCH$RESCHED, EXE$AL_SCB+SCB$L_SOFTINT+<4*IPL$_RESCHED>
        MOVAB   TTY$IOPOST, EXE$AL_SCB+SCB$L_SOFTINT+<4*IPL$_IOPOST>
        MOVAB   EXE$SWTIMINT, EXE$AL_SCB+SCB$L_SOFTINT+<4*IPL$_TIMER>
        MOVAB   EXE$HWCLKINT, EXE$AL_SCB+SCB$L_INTTIM
        MOVAB   TTY$RCVINT, EXE$AL_SCB+SCB$L_CONSRCV
        MOVAB   EXE$AL_SCB, R0
        MTPR    R0, #PR$_SCBB
        JSB     G^MMG$INIT
        MOVAB   EXE$VECTOR, R0          ; outer modes may run the vector
        MOVAB   EXE$VECTOREND, R1
        SUBL2   R0, R1
        ASHL    #-MMG$C_VPCTX, R1, R1
        MOVL    #UREXEC, R2
        JSB     G^MMG$SETPRT
        JSB     G^SCH$INIT
        JSB     G^EXE$INITTIM
        JSB     G^TTY$INIT
        MOVAB   BANNER, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    MMG$GL_FREECNT, R1
        JSB     G^EXE$OUTHEX
        JSB     G^EXE$OUTCRLF
        SETIPL  #0
        $CREPRC_S IMAGE=CONSOLE_IMAGE, PRCNAM=CONSOLE_NAME, BASPRI=#4
        BLBS    R0, SWAPPER
        MOVL    R0, R2
        MOVAB   NOSTART, R1
        JSB     G^EXE$OUTZSTRING
        MOVL    R2, R1
        JSB     G^EXE$OUTHEX
        JSB     G^EXE$OUTCRLF
        HALT

; The swapper: deletes the context, kernel stack and PCB of each process
; that deleted itself, then hibernates until another does.
SWAPPER:
10$:    SETIPL  #IPL$_SYNCH
        REMQUE  @SCH$GQ_DELQ, R4
        BVS     20$
        JSB     G^EXE$DELETEPCB
        BRB     10$
20$:    SETIPL  #0
        $HIBER_S
        BRB     10$

; CON$PUTCHAR: writes the character in R0 on the console, for consolio's
; EXE$OUT* routines. Keeps every register.
CON$PUTCHAR::
        MTPR    R0, #PR$_TXDB
        RSB

        .END    EXEC$START
