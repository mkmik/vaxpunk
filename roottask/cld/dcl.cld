! The verbs DCL does itself: CLIROUTINE names the code in DCL that does
! each, which takes its values from the parse.

define verb CONTINUE
	cliroutine CONTINUE

define verb DEASSIGN
	cliroutine DEASSIGN
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

define verb DEFINE
	cliroutine DEFINE
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=EQUIVALENCE_NAME, prompt="Equ_name", value(required)
	qualifier LOG, default
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

define verb EXIT
	cliroutine EXIT
	parameter P1, label=STATUS, value(type=$rest_of_line)

define verb GOTO
	cliroutine GOTO
	parameter P1, label=LABEL, prompt="Label", value(required)

define verb HELP
	image HELP
	parameter P1, label=TOPIC, value(type=$rest_of_line)

define verb IF
	cliroutine IF
	parameter P1, label=EXPRESSION, prompt="Expression", value(required, type=$rest_of_line)

define verb LOGOUT
	cliroutine LOGOUT

define verb RUN
	cliroutine RUN
	parameter P1, label=FILE, prompt="File", value(required, type=$infile)

define verb SET
	cliroutine SET
	parameter P1, label=OPTION, prompt="What", value(required, type=SET_OPTIONS)

define type SET_OPTIONS
	keyword COMMAND, syntax=SET_COMMAND
	keyword CONTROL, negatable, value(list, type=CONTROL_OPTIONS)
	keyword DEFAULT, syntax=SET_DEFAULT
	keyword FILE, syntax=SET_FILE
	keyword HOST, syntax=SET_HOST
	keyword PROCESS, syntax=SET_PROCESS
	keyword PROTECTION, value(list), syntax=SET_PROTECTION
	keyword TERMINAL, syntax=SET_TERMINAL

! SET [NO]CONTROL[=Y]: CTRL/Y, and CTRL/C no image takes, on or off.
! ponytail: no T, CTRL/T has no status line to show.
define type CONTROL_OPTIONS
	keyword Y

! SET COMMAND file: compiles file.CLD's verbs into the process's tables.
define syntax SET_COMMAND
	cliroutine SET_COMMAND
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)

define syntax SET_DEFAULT
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DIRECTORY, prompt="Directory", value(required)

! SET HOST address: RTPAD.EXE, a remote login.
define syntax SET_HOST
	image RTPAD
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=NODE, prompt="Node", value(required)

! SET PROCESS/PRIVILEGES=(priv[,...]): SET.EXE.
define syntax SET_PROCESS
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	qualifier PRIVILEGES, value(required, list)
	disallow not PRIVILEGES

! SET PROTECTION=(code[,...]) file: SET.EXE gives the file's categories
! that access.
define syntax SET_PROTECTION
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)

! SET FILE/OWNER_UIC=uic file: SET.EXE gives the file that owner.
define syntax SET_FILE
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=FILE, prompt="File", value(required, type=$infile)
	qualifier OWNER_UIC, value(required, type=$uic)
	disallow not OWNER_UIC

! SET TERMINAL [device]: SET.EXE sets the terminal's characteristics.
! ponytail: the ones the console keeps that a program may care about;
! no /INQUIRE, /DEVICE_TYPE, /SPEED or /PERMANENT.
define syntax SET_TERMINAL
	image SET
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=DEVICE_NAME
	qualifier WIDTH, nonnegatable, value(required, type=$number)
	qualifier PAGE, nonnegatable, value(required, type=$number)
	qualifier BROADCAST
	qualifier ECHO
	qualifier EIGHTBIT
	qualifier ESCAPE
	qualifier LOWERCASE
	qualifier PASTHRU
	qualifier TAB
	qualifier WRAP

define verb SHOW
	cliroutine SHOW
	parameter P1, label=OPTION, prompt="What", value(required, type=SHOW_OPTIONS)

define type SHOW_OPTIONS
	keyword DEFAULT
	keyword DEVICES, syntax=SHOW_DEVICES
	keyword LOGICAL, syntax=SHOW_LOGICAL
	keyword PROCESS, syntax=SHOW_IMAGE
	keyword SYMBOL, syntax=SHOW_SYMBOL
	keyword SYSTEM, syntax=SHOW_IMAGE
	keyword TERMINAL, syntax=SHOW_TERMINAL

define syntax SHOW_DEVICES
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=DEVICE_NAME
	qualifier MOUNTED

define syntax SHOW_LOGICAL
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=LOGICAL_NAME
	qualifier PROCESS
	qualifier SYSTEM
	qualifier TABLE, value(required)
	disallow any2(PROCESS, SYSTEM, TABLE)

define syntax SHOW_SYMBOL
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=SYMBOL
	qualifier ALL
	qualifier GLOBAL
	qualifier LOCAL
	disallow GLOBAL and LOCAL
	disallow P2 and ALL

! SHOW PROCESS [/PRIVILEGES] and SHOW SYSTEM: SHOW.EXE.
define syntax SHOW_IMAGE
	image SHOW
	qualifier PRIVILEGES

! SHOW TERMINAL [device]: SHOW.EXE.
define syntax SHOW_TERMINAL
	image SHOW
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=DEVICE_NAME

define verb STOP
	cliroutine STOP
	parameter P1, label=PROCESS_NAME
	qualifier IDENTIFICATION, value(required)

! TCPIP command: TCP/IP Services' management commands, which TCPIP.EXE
! parses with its own tables, sysexe/tcpip.cld; with none, it prompts
! TCPIP> for them.
define verb TCPIP
	image TCPIP
	parameter P1, label=COMMAND, value(type=$rest_of_line)

define verb WRITE
	cliroutine WRITE
	parameter P1, label=LOGICAL_NAME, prompt="Log_name", value(required)
	parameter P2, label=EXPRESSION, prompt="Expression", value(required, type=$rest_of_line)
