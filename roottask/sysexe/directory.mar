        .TITLE  DIRECTORY Lists files
        .IDENT  /V0.2/
;
; DCL's DIRECTORY [spec] runs this. Lists the files spec names, as VMS's DIRECTORY
; does: the directory, then their names, four to a line, then how many.
; RMS's $PARSE expands spec, what it leaves out taken from *.*;*, and the
; directory from the default one; $SEARCH finds each file. * matches any
; characters, % one.
; ponytail: one directory, since RMS has no wildcard directories.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $NAMDEF

        .EXTERNAL PUT_LINE

COLUMN = 20                             ; a name and its blanks
LINEMAX = 80

; ADDTEXT "text": appends text to LINE. Uses R0-R2.
        .MACRO  ADDTEXT TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        MOVZBL  (R1)+, R2
        BSBW    ADD
        .ENDM   ADDTEXT

        .PSECT  DATA, NOEXE, WRT, LONG
DEFSPEC:                                ; what spec leaves out
        .ASCII  "*.*;*"
DEFLEN = .-DEFSPEC
        .ALIGN  LONG
FAB:    $FAB    FNA=SPEC, DNA=DEFSPEC, DNS=DEFLEN, NAM=NAM
SPECDSC:                                ; FILE, the parameter, if given
        .LONG   255
        .ADDRESS SPEC
SPEC:   .BLKB   255
NAM:    $NAM    ESA=EXP, ESS=255, RSA=RES, RSS=255
EXP:    .BLKB   255
RES:    .BLKB   255
LINE:   .BLKB   256                     ; a line being made, .ASCIC
FILES:  .LONG   0

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6>
        GETVALUE "FILE", SPECDSC, SPECDSC
        BLBS    R0, 5$
        CLRL    SPECDSC
5$:     MOVB    SPECDSC, FAB+FAB$B_FNS
        $PARSE  FAB=FAB
        BLBC    R0, 90$
10$:    $SEARCH FAB=FAB
        BLBC    R0, 50$
        TSTL    FILES
        BNEQ    20$
        PRINT   ""                      ; the first: its directory
        ADDTEXT "Directory "
        MOVZBL  NAM+NAM$B_DEV, R2
        ADDB2   NAM+NAM$B_DIR, R2
        MOVL    NAM+NAM$L_DEV, R1
        BSBW    ADD
        BSBW    SAY
        PRINT   ""
20$:    INCL    FILES
        TSTB    LINE
        BEQL    40$
30$:    MOVZBL  #^A/ /, R0              ; to the next column
        BSBW    ADDCHAR
        CLRL    R1
        MOVZBL  LINE, R0
        EDIV    #COLUMN, R0, R0, R1
        TSTL    R1
        BNEQ    30$
40$:    MOVZBL  NAM+NAM$B_NAME, R2      ; NAME.TYPE;VERSION
        ADDB2   NAM+NAM$B_TYPE, R2
        ADDB2   NAM+NAM$B_VER, R2
        MOVL    NAM+NAM$L_NAME, R1
        BSBW    ADD
        CMPB    LINE, #LINEMAX-COLUMN   ; four to a line
        BLSSU   10$
        BSBW    SAY
        BRB     10$
50$:    CMPL    R0, #RMS$_NMF
        BEQL    60$
        CMPL    R0, #RMS$_FNF
        BNEQ    90$
        PRINT   "%DIRECT-W-NOFILES, no files found"
        BRB     80$
60$:    TSTB    LINE
        BEQL    65$
        BSBW    SAY
65$:    PRINT   ""
        ADDTEXT "Total of "
        MOVL    FILES, R1
        BSBW    ADDDEC
        CMPL    FILES, #1
        BEQL    67$
        ADDTEXT " files."
        BRB     70$
67$:    ADDTEXT " file."
70$:    BSBW    SAY
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; ADDDEC: appends R1 in decimal to LINE. Uses R0-R5.
ADDDEC: CLRL    R4                      ; digits, on the stack
10$:    DIVL3   #10, R1, R5
        MULL3   #10, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R4
        MOVL    R5, R1
        BNEQ    10$
30$:    MOVL    (SP)+, R0
        BSBB    ADDCHAR
        SOBGTR  R4, 30$
        RSB

; SAY: writes the line in LINE, and empties it. Uses R0 and R1.
SAY:    PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        RSB

; ADDCHAR: appends the character in R0 to LINE. Uses R0-R2.
ADDCHAR:
        MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
; ADD: appends the R2 bytes at R1 to LINE, as many as fit. Uses R0-R2.
ADD:    MOVZBL  LINE, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, LINE[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, LINE
        RSB

        .PSECT  DATA
CHAR:   .BLKB   1

        .END    START
