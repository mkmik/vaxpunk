        .TITLE  SPIN    Computes until CTRL/Y, then again after CONTINUE
        .IDENT  /V0.1/
;
; SPIN loops in user mode with no system service, so only an interrupt
; takes the CPU from it, and CTRL/Y must stop it there. Each register it
; may use holds a value it checks each time round, so CONTINUE must give
; every one back as it was; if one changed, SPIN says so and exits.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        PRINT   "SPIN: spinning until CTRL/Y"
        MOVL    SP, R0
        MOVL    AP, R1
        MOVL    #2, R2
        MOVL    #3, R3
        MOVL    #4, R4
        MOVL    #5, R5
        MOVL    #6, R6
        MOVL    #7, R7
        MOVL    #8, R8
        MOVL    #9, R9
        MOVL    #10, R10
        MOVL    #11, R11
10$:    CMPL    R0, SP
        BNEQ    90$
        CMPL    R1, AP
        BNEQ    90$
        CMPL    R2, #2
        BNEQ    90$
        CMPL    R3, #3
        BNEQ    90$
        CMPL    R4, #4
        BNEQ    90$
        CMPL    R5, #5
        BNEQ    90$
        CMPL    R6, #6
        BNEQ    90$
        CMPL    R7, #7
        BNEQ    90$
        CMPL    R8, #8
        BNEQ    90$
        CMPL    R9, #9
        BNEQ    90$
        CMPL    R10, #10
        BNEQ    90$
        CMPL    R11, #11
        BEQL    10$
90$:    PRINT   "SPIN: a register changed"
        MOVL    #SS$_ABORT, R0
        RET

        .END    START
