        .TITLE  DCL     The command interpreter
        .IDENT  /V0.1/
;
; A small DCL. build.rs links it in P1, at VA$C_CLI, which makes it a
; command interpreter: EXEC$START creates the console's process, SYSTEM,
; with it, and the executive calls it in supervisor mode, with SS$_NORMAL
; at first and then, each time an image it runs exits, with the image's
; status (docs/design/0002-executive-processes.md), or with SS$_CONTROLY
; when CTRL/Y stops the image it runs (ADR-0010). Its data stays in P1
; from one call to the next. It reports a failure status, prompts for a
; command on the console and does it:
;
;   RUN image   runs image, image.EXE if it has no type, in this process
;   DIRECTORY [spec]
;               runs DIRECTORY.EXE
;   TYPE spec   runs TYPE.EXE
;   DEFINE name equivalence
;               makes a logical name in the process's table
;   DEASSIGN name
;               deletes it
;   SHOW LOGICAL [name]
;               translates a logical name, as $ASSIGN would; with no
;               name, or *, lists them all
;   SET DEFAULT [dev:][dir]
;               sets the process's default directory, with $SETDDIR,
;               and device, its SYS$DISK
;   SHOW DEFAULT
;               shows it, with the device
;   SHOW DEVICES [name]
;               lists the devices, those whose names start with name
;   SHOW PROCESS, SHOW SYSTEM
;               run SHOW.EXE, with PROCESS or SYSTEM as its command line
;   EDIT spec   runs EDIT.EXE, with spec as its command line
;   COPY from to
;               runs COPY.EXE
;   DELETE spec runs DELETE.EXE
;   INITIALIZE device label
;               runs INIT.EXE
;   MOUNT device label
;               runs MOUNT.EXE
;   CONTINUE    goes back to the image CTRL/Y stopped
;   HELP        lists the commands
;   LOGOUT      ends the process
;
; An image a command runs gets the command's parameters as its command
; line, in capitals, a blank between each two. A verb may be abbreviated,
; to as little as its first letter; the first that matches is the one. A
; status with STS$M_INHIB_MSG set is one the image reported itself. It
; reads the commands from SYS$INPUT. A command that runs an image runs
; down the one CTRL/Y stopped.
; ponytail: message texts for a few statuses only; no symbols,
; qualifiers, quoted strings or command procedures.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $IPLDEF
        $PCBDEF
        $LNMBDEF
        $SSDEF
        $IODEF
        $LNMDEF
        $RMSDEF
        $FABDEF
        $NAMDEF
        $DVIDEF
        $DVSDEF
        $DCDEF
        $UCBDEF

        .EXTERNAL PUT_LINE, SCH$GL_CURPCB, LNM$GQ_SYSTEM

LINESIZE = 255
INHIB_MSG = 28                          ; STS$V_INHIB_MSG

; ADDTEXT "text": appends text to the message in MSG. Uses R0-R2.
        .MACRO  ADDTEXT TEXT, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  TEXT
        .RESTORE_PSECT
        MOVAB   L, R1
        BSBW    ADDCSTR
        .ENDM   ADDTEXT

        .PSECT  DATA, NOEXE, WRT, LONG
CHAN:   .LONG   0                       ; SYS$INPUT's, once assigned
INPUT:  .ASCID  "SYS$INPUT"
PROCESS:
        .ASCID  "LNM$PROCESS"
FILE_DEV:
        .ASCID  "LNM$FILE_DEV"
NAMDSC: .LONG   0                       ; a logical name: its length
        .ADDRESS NAME
NAME:   .BLKB   LINESIZE
CREITEMS:                               ; $CRELNM's: the equivalence, in TOKEN
        .WORD   0, LNM$_STRING
        .ADDRESS TOKEN
        .LONG   0, 0
TRNITEMS:                               ; $TRNLNM's: the equivalence and the table
        .WORD   LINESIZE, LNM$_STRING
        .ADDRESS EQV, EQVLEN
        .WORD   31, LNM$_TABLE
        .ADDRESS TABNAM, TABLEN
        .LONG   0
EQV:    .BLKB   LINESIZE
EQVLEN: .WORD   0
TABNAM: .BLKB   31
TABLEN: .WORD   0
LNMARGS:                                ; GETLNM's: a table and an index
        .LONG   2, 0, 0
PROCTAB:
        .ASCIC  "LNM$PROCESS_TABLE"
SYSTAB: .ASCIC  "LNM$SYSTEM_TABLE"
PROMPT: .ASCII  "$ "
IOSB:   .BLKQ   1
LINE:   .BLKB   LINESIZE                ; the command line
TOKEN:  .BLKB   LINESIZE+4              ; a word of it, in capitals, and room for .EXE
TOKDSC: .LONG   0                       ; a descriptor of TOKEN: its length
        .ADDRESS TOKEN
DIRIMG: .ASCID  "DIRECTORY.EXE"
TYPEIMG:
        .ASCID  "TYPE.EXE"
EDITIMG:
        .ASCID  "EDIT.EXE"
COPYIMG:
        .ASCID  "COPY.EXE"
DELIMG: .ASCID  "DELETE.EXE"
INITIMG:
        .ASCID  "INIT.EXE"
MOUNTIMG:
        .ASCID  "MOUNT.EXE"
SHOWIMG:
        .ASCID  "SHOW.EXE"
MSG:    .BLKB   256                     ; a message being made, .ASCIC
CHAR:   .BLKB   1
V_RUN:  .ASCIC  "RUN"
V_HELP: .ASCIC  "HELP"
V_LOGOUT:
        .ASCIC  "LOGOUT"
V_DIRECTORY:
        .ASCIC  "DIRECTORY"
V_TYPE: .ASCIC  "TYPE"
V_DEFINE:
        .ASCIC  "DEFINE"
V_DEASSIGN:
        .ASCIC  "DEASSIGN"
V_SHOW: .ASCIC  "SHOW"
V_LOGICAL:
        .ASCIC  "LOGICAL"
V_SET:  .ASCIC  "SET"
V_DEFAULT:
        .ASCIC  "DEFAULT"
V_DEVICES:
        .ASCIC  "DEVICES"
SCANCTX:                                ; $DEVICE_SCAN's context
        .BLKQ   1
PATDSC: .LONG   0                       ; its search name, in TOKEN
        .ADDRESS TOKEN
DVSITEMS:                               ; its items: the class
        .WORD   4, DVS$_DEVCLASS
        .ADDRESS DEVCLASS
        .LONG   0
        .LONG   0
DEVCLASS:
        .LONG   0
DEVDSC: .LONG   8                       ; the device's name it found, _DDCU:
        .ADDRESS DEVNAME
DVINAM: .LONG   0                       ; and its length, a descriptor of it
        .ADDRESS DEVNAME
DEVNAME:
        .BLKB   8
DVIITEMS:                               ; what $GETDVIW returns of it
        .WORD   4, DVI$_MNT
        .ADDRESS V_MNT
        .LONG   0
        .WORD   4, DVI$_SWL
        .ADDRESS V_SWL
        .LONG   0
        .WORD   4, DVI$_STS
        .ADDRESS V_STS
        .LONG   0
        .WORD   12, DVI$_VOLNAM
        .ADDRESS DEVLABEL+1
        .ADDRESS LABLEN
        .WORD   4, DVI$_FREEBLOCKS
        .ADDRESS DEVFREE
        .LONG   0
        .LONG   0
V_MNT:  .LONG   0                       ; 1 if a volume is mounted,
V_SWL:  .LONG   0                       ; 1 if it is read only,
V_STS:  .LONG   0                       ; UCB$M_ONLINE if the device is there,
DEVLABEL:                               ; the volume's label, after a byte,
        .BLKB   13
LABLEN: .WORD   0                       ; its length,
DEVFREE:                                ; and its free blocks
        .LONG   0
S_MOUNTED:
        .ASCIC  "Mounted"
S_WRTLCK:
        .ASCIC  "Mounted wrtlck"
S_ONLINE:
        .ASCIC  "Online"
S_OFFLINE:
        .ASCIC  "Offline"
V_PROCESS:
        .ASCIC  "PROCESS"
V_SYSTEM:
        .ASCIC  "SYSTEM"
V_EDIT: .ASCIC  "EDIT"
V_COPY: .ASCIC  "COPY"
V_DELETE:
        .ASCIC  "DELETE"
V_INITIALIZE:
        .ASCIC  "INITIALIZE"
V_MOUNT:
        .ASCIC  "MOUNT"
V_CONTINUE:
        .ASCIC  "CONTINUE"
DOTEXE: .ASCII  ".EXE"
        .ALIGN  LONG
DEFFAB: $FAB    FNA=TOKEN, NAM=DEFNAM   ; SET and SHOW DEFAULT's $PARSE
DEFNAM: $NAM    ESA=EXP, ESS=255
EXP:    .BLKB   255                     ; its expanded string
DIRDSC: .LONG   0, 0                    ; a descriptor of the directory in it
DISK:   .ASCID  "SYS$DISK"
DISKITEMS:                              ; $CRELNM's: the device in EXP
        .WORD   0, LNM$_STRING
        .LONG   0, 0, 0
SEVERITY:
        .ASCII  "WSEIF???"
; The messages STATUS knows: a status, its facility, its name and its
; text, VMS's, each .ASCIC, until a status of 0.
MESSAGES:
        .LONG   RMS$_EOF
        .ASCIC  "RMS"
        .ASCIC  "EOF"
        .ASCIC  "end of file detected"
        .LONG   RMS$_FNF
        .ASCIC  "RMS"
        .ASCIC  "FNF"
        .ASCIC  "file not found"
        .LONG   RMS$_WLK
        .ASCIC  "RMS"
        .ASCIC  "WLK"
        .ASCIC  "device currently write locked"
        .LONG   RMS$_NMF
        .ASCIC  "RMS"
        .ASCIC  "NMF"
        .ASCIC  "no more files found"
        .LONG   RMS$_DNF
        .ASCIC  "RMS"
        .ASCIC  "DNF"
        .ASCIC  "directory not found"
        .LONG   RMS$_DEV
        .ASCIC  "RMS"
        .ASCIC  "DEV"
        .ASCIC  "error in device name or inappropriate device type for operation"
        .LONG   RMS$_DIR
        .ASCIC  "RMS"
        .ASCIC  "DIR"
        .ASCIC  "error in directory name"
        .LONG   RMS$_DME
        .ASCIC  "RMS"
        .ASCIC  "DME"
        .ASCIC  "dynamic memory exhausted"
        .LONG   RMS$_FNM
        .ASCIC  "RMS"
        .ASCIC  "FNM"
        .ASCIC  "error in file name"
        .LONG   RMS$_RFM
        .ASCIC  "RMS"
        .ASCIC  "RFM"
        .ASCIC  "invalid record format"
        .LONG   RMS$_SYN
        .ASCIC  "RMS"
        .ASCIC  "SYN"
        .ASCIC  "file specification syntax error"
        .LONG   RMS$_VER
        .ASCIC  "RMS"
        .ASCIC  "VER"
        .ASCIC  "error in version number"
        .LONG   RMS$_WLD
        .ASCIC  "RMS"
        .ASCIC  "WLD"
        .ASCIC  "invalid wildcard operation"
        .LONG   RMS$_DNR
        .ASCIC  "RMS"
        .ASCIC  "DNR"
        .ASCIC  "device not ready, not mounted, or unavailable"
        .LONG   RMS$_FEX
        .ASCIC  "RMS"
        .ASCIC  "FEX"
        .ASCIC  "file already exists, not superseded"
        .LONG   RMS$_PRV
        .ASCIC  "RMS"
        .ASCIC  "PRV"
        .ASCIC  "insufficient privilege or file protection violation"
        .LONG   RMS$_FUL
        .ASCIC  "RMS"
        .ASCIC  "FUL"
        .ASCIC  "device full (insufficient space for allocation)"
        .LONG   RMS$_CRE
        .ASCIC  "RMS"
        .ASCIC  "CRE"
        .ASCIC  "ACP file create failed"
        .LONG   RMS$_ENT
        .ASCIC  "RMS"
        .ASCIC  "ENT"
        .ASCIC  "ACP enter function failed"
        .LONG   RMS$_MKD
        .ASCIC  "RMS"
        .ASCIC  "MKD"
        .ASCIC  "ACP could not mark file for deletion"
        .LONG   RMS$_WER
        .ASCIC  "RMS"
        .ASCIC  "WER"
        .ASCIC  "file write error"
        .LONG   SS$_BADPARAM
        .ASCIC  "SYSTEM"
        .ASCIC  "BADPARAM"
        .ASCIC  "bad parameter value"
        .LONG   SS$_DEVMOUNT
        .ASCIC  "SYSTEM"
        .ASCIC  "DEVMOUNT"
        .ASCIC  "device is already mounted"
        .LONG   SS$_INCVOLLABEL
        .ASCIC  "SYSTEM"
        .ASCIC  "INCVOLLABEL"
        .ASCIC  "incorrect volume label"
        .LONG   SS$_IVDEVNAM
        .ASCIC  "SYSTEM"
        .ASCIC  "IVDEVNAM"
        .ASCIC  "invalid device name"
        .LONG   SS$_MEDOFL
        .ASCIC  "SYSTEM"
        .ASCIC  "MEDOFL"
        .ASCIC  "medium is offline"
        .LONG   SS$_WRITLCK
        .ASCIC  "SYSTEM"
        .ASCIC  "WRITLCK"
        .ASCIC  "write-locked"
        .LONG   SS$_NOSUCHDEV
        .ASCIC  "SYSTEM"
        .ASCIC  "NOSUCHDEV"
        .ASCIC  "no such device available"
        .LONG   SS$_NOHOMEBLK
        .ASCIC  "SYSTEM"
        .ASCIC  "NOHOMEBLK"
        .ASCIC  "Files-11 home block not found on volume"
        .LONG   SS$_DEVICEFULL
        .ASCIC  "SYSTEM"
        .ASCIC  "DEVICEFULL"
        .ASCIC  "device full - allocation failure"
        .LONG   SS$_IDXFILEFULL
        .ASCIC  "SYSTEM"
        .ASCIC  "IDXFILEFULL"
        .ASCIC  "index file full"
        .LONG   SS$_HEADERFULL
        .ASCIC  "SYSTEM"
        .ASCIC  "HEADERFULL"
        .ASCIC  "file header full"
        .LONG   0
HEX:    .ASCII  "0123456789ABCDEF"

        .PSECT  CODE, EXE, LONG
        .ENTRY  DCL, ^M<R2, R3, R4, R5, R6, R7, R8>
        TSTL    CHAN
        BNEQ    10$
        $ASSIGN_S DEVNAM=INPUT, CHAN=CHAN
        BLBC    R0, QUIT
10$:    BLBS    4(AP), NEXT
        BBS     #INHIB_MSG, 4(AP), NEXT
        MOVZBL  #^A/%/, R0
        MOVL    4(AP), R1
        BSBW    STATUS
NEXT:   $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=LINE, P2=#LINESIZE, P5=#PROMPT, P6=#2
        BLBC    R0, QUIT
        MOVAB   LINE, R6
        MOVZWL  IOSB+2, R7
        ADDL2   R6, R7                  ; past the line
        BSBW    WORD
        TSTL    R8
        BEQL    NEXT
        MOVAB   V_RUN, R1
        BSBW    VERB
        BLBS    R0, RUN
        MOVAB   V_HELP, R1
        BSBW    VERB
        BLBS    R0, HELP
        MOVAB   V_LOGOUT, R1
        BSBW    VERB
        BLBS    R0, LOGOUT
        MOVAB   V_DIRECTORY, R1
        BSBW    VERB
        BLBS    R0, DIRECTORY
        MOVAB   V_TYPE, R1
        BSBW    VERB
        BLBS    R0, TYPE
        MOVAB   V_DEFINE, R1
        BSBW    VERB
        BLBS    R0, DEFINE
        MOVAB   V_DEASSIGN, R1
        BSBW    VERB
        BLBS    R0, DEASSIGN
        MOVAB   V_SHOW, R1
        BSBW    VERB
        BLBS    R0, SHOW
        MOVAB   V_SET, R1
        BSBW    VERB
        BLBS    R0, SET
        MOVAB   V_EDIT, R1
        BSBW    VERB
        BLBS    R0, EDIT
        MOVAB   V_COPY, R1
        BSBW    VERB
        BLBS    R0, COPY
        MOVAB   V_DELETE, R1
        BSBW    VERB
        BLBS    R0, DELETE
        MOVAB   V_INITIALIZE, R1
        BSBW    VERB
        BLBS    R0, INITIALIZE
        MOVAB   V_MOUNT, R1
        BSBW    VERB
        BLBS    R0, MOUNT
        MOVAB   V_CONTINUE, R1
        BSBW    VERB
        BLBS    R0, CONTINUE
        PRINT   "%DCL-W-IVVERB, unrecognized command verb - check validity and spelling"
        ADDTEXT " \"
        BSBW    ADDTOKEN
        ADDTEXT "\"
        BSBW    SAY
        BRB     NEXT
LOGOUT: MOVL    #SS$_NORMAL, R0         ; the process ends
QUIT:   RET

; CONTINUE: $CONTINUE goes back to the image CTRL/Y stopped, and returns
; only if there is none, when CONTINUE does nothing.
CONTINUE:
        $CONTINUE_S
        BRB     NEXT

HELP:   PRINT   "  RUN image   runs image, image.EXE if it has no type"
        PRINT   "  DIRECTORY [spec]"
        PRINT   "              lists the files spec names, * and % wildcards"
        PRINT   "  TYPE spec   writes the file spec names on the console"
        PRINT   "  DEFINE name equivalence"
        PRINT   "              makes a logical name"
        PRINT   "  DEASSIGN name"
        PRINT   "              deletes one"
        PRINT   "  SHOW LOGICAL [name]"
        PRINT   "              translates one, or lists them all"
        PRINT   "  SET DEFAULT [dev:][dir]"
        PRINT   "              sets the default directory"
        PRINT   "  SHOW DEFAULT"
        PRINT   "              shows it"
        PRINT   "  SHOW DEVICES [name]"
        PRINT   "              lists the devices, or those whose names start with name"
        PRINT   "  SHOW PROCESS"
        PRINT   "              shows this process"
        PRINT   "  SHOW SYSTEM"
        PRINT   "              lists the processes"
        PRINT   "  EDIT spec   edits the file spec names with EDT"
        PRINT   "  COPY from to"
        PRINT   "              copies a file"
        PRINT   "  DELETE spec deletes the files spec names, ;version or ;*"
        PRINT   "  INITIALIZE device label"
        PRINT   "              writes an empty volume on DKB0: or MDA0:, the ramdisk"
        PRINT   "  MOUNT device label"
        PRINT   "              mounts the volume, DKB0: or MDA0: then names its files"
        PRINT   "  CONTINUE    goes back to the image CTRL/Y stopped"
        PRINT   "  HELP        lists the commands"
        PRINT   "  LOGOUT      ends the process"
        BRW     NEXT

; RUN image: runs it with $IMGACT, which returns only if it can't.
RUN:    BSBW    WORD
        TSTL    R8
        BEQL    INSFPRM
        CLRL    R0                      ; a type?
15$:    CMPB    TOKEN[R0], #^A/./
        BEQL    20$
        AOBLSS  R8, R0, 15$
        MOVAB   TOKEN[R8], R0
        MOVL    DOTEXE, (R0)
        ADDL2   #4, R8
20$:    MOVL    R8, TOKDSC
        $IMGACT_S IMAGE=TOKDSC
        MOVAB   TOKDSC, R1
        BRB     ACTFAIL

; The commands that run an image with their parameters: R4 = its
; descriptor, R3 = how many parameters it needs.
DIRECTORY:
        MOVAB   DIRIMG, R4
        CLRL    R3
        BRB     FOREIGN
TYPE:   MOVAB   TYPEIMG, R4
        MOVL    #1, R3
        BRB     FOREIGN
COPY:   MOVAB   COPYIMG, R4
        MOVL    #2, R3
        BRB     FOREIGN
DELETE: MOVAB   DELIMG, R4
        MOVL    #1, R3
        BRB     FOREIGN
INITIALIZE:
        MOVAB   INITIMG, R4
        MOVL    #2, R3
        BRB     FOREIGN
MOUNT:  MOVAB   MOUNTIMG, R4
        MOVL    #2, R3
FOREIGN:
        BSBW    REST
        CMPL    R2, R3
        BLSSU   INSFPRM
        MOVL    R8, TOKDSC
        PUSHL   R4
        $IMGACT_S IMAGE=(R4), CMDLIN=TOKDSC
        MOVL    (SP)+, R1
        BRB     ACTFAIL

; EDIT spec: runs EDIT.EXE with the spec.
EDIT:   BSBW    WORD
        TSTL    R8
        BEQL    INSFPRM
        MOVL    R8, TOKDSC
        $IMGACT_S IMAGE=EDITIMG, CMDLIN=TOKDSC
        MOVAB   EDITIMG, R1
        BRB     ACTFAIL

INSFPRM:
        PRINT   "%DCL-W-INSFPRM, missing command parameters - supply all required parameters"
        BRW     NEXT

; ACTFAIL: R0 = the status $IMGACT returned, R1 = the image's descriptor.
; Reports it, and prompts for the next command.
ACTFAIL:
        PUSHL   R0
        PUSHL   R1
        ADDTEXT "%DCL-W-ACTIMAGE, error activating image "
        MOVL    (SP)+, R0
        MOVZWL  (R0), R2
        MOVL    4(R0), R1
        BSBW    ADD
        BSBW    SAY
        MOVZBL  #^A/-/, R0
        MOVL    (SP)+, R1
        BSBW    STATUS
        BRW     NEXT

; DEFINE name equivalence: makes name a logical name in the process's
; table, telling if it replaced one.
DEFINE: BSBW    NAMEWORD
        TSTL    R8
        BEQL    INSFPRM
        BSBW    WORD
        TSTL    R8
        BEQL    INSFPRM
        MOVW    R8, CREITEMS
        $CRELNM_S TABNAM=PROCESS, LOGNAM=NAMDSC, ITMLST=CREITEMS
        CMPL    R0, #SS$_SUPERSEDE
        BNEQ    DONE
        ADDTEXT "%DCL-I-SUPERSEDE, previous value of "
        BSBW    ADDNAME
        ADDTEXT " has been superseded"
        BSBW    SAY
        BRW     NEXT

; DEASSIGN name: deletes the logical name from the process's table.
DEASSIGN:
        BSBW    NAMEWORD
        TSTL    R8
        BEQL    INSFPRM
        $DELLNM_S TABNAM=PROCESS, LOGNAM=NAMDSC
; DONE: R0 = a command's status. Reports it if it is an error, and prompts
; for the next command.
DONE:   BLBS    R0, 10$
        MOVL    R0, R1
        MOVZBL  #^A/%/, R0
        BSBW    STATUS
10$:    BRW     NEXT

; SET DEFAULT spec: $PARSEs spec, which must name no file, and makes the
; directory it expands to the default, with $SETDDIR, and its device the
; process's SYS$DISK. One that doesn't
; exist is still set, as VMS does, with a message.
SET:    BSBW    WORD
        TSTL    R8
        BEQL    5$
        MOVAB   V_DEFAULT, R1
        BSBW    VERB
        BLBC    R0, IVKEYW
        BSBW    WORD
        TSTL    R8
5$:     BEQL    INSFPRM
        MOVB    R8, DEFFAB+FAB$B_FNS
        $PARSE  FAB=DEFFAB
        MOVL    R0, R6
        CMPL    R0, #RMS$_DNF
        BEQL    10$
        BLBC    R0, 20$
10$:    MOVL    #RMS$_SYN, R0
        TSTB    DEFNAM+NAM$B_NAME
        BNEQ    20$
        MOVZBL  DEFNAM+NAM$B_DIR, DIRDSC
        MOVL    DEFNAM+NAM$L_DIR, DIRDSC+4
        $SETDDIR_S NEWDIR=DIRDSC
        BLBC    R0, 20$
        MOVZBW  DEFNAM+NAM$B_DEV, DISKITEMS
        MOVL    DEFNAM+NAM$L_DEV, DISKITEMS+4
        $CRELNM_S TABNAM=PROCESS, LOGNAM=DISK, ITMLST=DISKITEMS
        BLBC    R0, 20$
        CMPL    R6, #RMS$_DNF
        BNEQ    20$
        ADDTEXT "%DCL-I-INVDEF, "
        BSBW    ADDDEF
        ADDTEXT " does not exist"
        BSBW    SAY
        BRW     NEXT
20$:    BRW     DONE

; IVKEYW: reports the word in TOKEN as a keyword DCL doesn't know, and
; prompts for the next command.
IVKEYW: PRINT   "%DCL-W-IVKEYW, unrecognized keyword - check validity and spelling"
        ADDTEXT " \"
        BSBW    ADDTOKEN
        ADDTEXT "\"
        BSBW    SAY
        BRW     NEXT

; SHOW DEFAULT: shows the default device and directory, what $PARSE
; expands an empty specification to.
SHOWDEF:
        CLRB    DEFFAB+FAB$B_FNS
        $PARSE  FAB=DEFFAB
        CMPL    R0, #RMS$_DNF
        BEQL    10$
        BLBC    R0, 20$
10$:    ADDTEXT "  "
        BSBW    ADDDEF
        BSBW    SAY
        MOVL    #SS$_NORMAL, R0
20$:    BRW     DONE

; SHOW DEVICES [name]: lists the disks, with their status and their
; volumes' labels and free blocks, then the terminal, under VMS's
; headings, or only the devices whose names start with name, with *
; and % wildcards: SHOW DEVICES DK. It finds them with $DEVICE_SCAN, a
; class at a time, and asks each about itself with $GETDVIW.
; SS$_NOSUCHDEV if none matches.
; ponytail: no error counts, transactions or mount counts, which nothing
; keeps; no /FULL or other qualifiers.
SHOWDEV:
        BSBW    WORD
        TSTL    R8                      ; name*, without its colon
        BEQL    5$
        CMPB    TOKEN-1[R8], #^A/:/
        BNEQ    3$
        DECL    R8
3$:     MOVB    #^A/*/, TOKEN[R8]
        INCL    R8
5$:     MOVL    R8, PATDSC
        CLRL    R7                      ; the devices listed
        MOVL    #DC$_DISK, DEVCLASS
        BSBB    SCAN
        MOVL    #DC$_TERM, DEVCLASS
        BSBB    SCAN
        MOVL    #SS$_NORMAL, R0
        TSTL    R7
        BNEQ    10$
        MOVL    #SS$_NOSUCHDEV, R0
10$:    BRW     DONE

; SCAN: lists the devices of DEVCLASS's class whose names match PATDSC's,
; under their headings, if there are any. R7 = how many there were, and
; as many more. Uses R0-R6.
SCAN:   CLRQ    SCANCTX
        CLRL    R6                      ; 1 once the headings are out
10$:    $DEVICE_SCAN_S RETURN_DEVNAM=DEVDSC, RETLEN=DVINAM, SEARCH_DEVNAM=PATDSC, ITMLST=DVSITEMS, CONTXT=SCANCTX
        BLBC    R0, 90$
        $GETDVIW_S DEVNAM=DVINAM, ITMLST=DVIITEMS
        BLBC    R0, 10$
        TSTL    R6
        BNEQ    20$
        INCL    R6
        PRINT   ""
        CMPL    DEVCLASS, #DC$_DISK
        BNEQ    15$
        PRINT   "Device                  Device           Error    Volume         Free"
        PRINT   " Name                   Status           Count     Label        Blocks"
        BRB     20$
15$:    PRINT   "Device                  Device           Error"
        PRINT   " Name                   Status           Count"
20$:    INCL    R7
        MOVAB   DEVNAME+1, R1           ; without its underscore
        MOVZWL  DVINAM, R2
        DECL    R2
        BSBW    ADD
        MOVL    #24, R3
        BSBW    PADTO
        MOVAB   S_OFFLINE, R1
        BITL    #UCB$M_ONLINE, V_STS
        BEQL    25$
        MOVAB   S_ONLINE, R1
25$:    TSTL    V_MNT
        BEQL    30$
        MOVAB   S_MOUNTED, R1
        TSTL    V_SWL
        BEQL    30$
        MOVAB   S_WRTLCK, R1
30$:    BSBW    ADDCSTR
        MOVL    #41, R3
        BSBW    PADTO
        CLRL    R1                      ; the error count
        MOVL    #5, R3
        BSBW    ADDDEC
        TSTL    V_MNT
        BEQL    40$
        ADDTEXT "  "
        MOVAB   DEVLABEL+1, R1
        MOVZWL  LABLEN, R2
        BSBW    ADD
        MOVL    #62, R3
        BSBW    PADTO
        MOVL    DEVFREE, R1
        MOVL    #8, R3
        BSBW    ADDDEC
40$:    BSBW    SAY
        BRW     10$
90$:    RSB

; PADTO: R3 = a column. Appends blanks to MSG up to it. Uses R0-R2.
PADTO:  MOVZBL  MSG, R0
        CMPL    R0, R3
        BGEQ    10$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
        BRB     PADTO
10$:    RSB

; ADDDEC: appends R1 in decimal to MSG, right-aligned in R3 columns.
; Uses R0-R5.
ADDDEC: CLRL    R4                      ; digits, on the stack
10$:    DIVL3   #10, R1, R5
        MULL3   #10, R5, R0
        SUBL3   R0, R1, R0
        ADDL2   #^A/0/, R0
        PUSHL   R0
        INCL    R4
        MOVL    R5, R1
        BNEQ    10$
20$:    CMPL    R3, R4
        BLEQ    30$
        MOVZBL  #^A/ /, R0
        BSBW    ADDCHAR
        DECL    R3
        BRB     20$
30$:    MOVL    (SP)+, R0
        BSBW    ADDCHAR
        SOBGTR  R4, 30$
        RSB

; ADDDEF: appends the device and directory $PARSE left in DEFNAM to MSG.
; Uses R0-R2.
ADDDEF: MOVL    DEFNAM+NAM$L_DEV, R1
        MOVZBL  DEFNAM+NAM$B_DEV, R2
        ADDB2   DEFNAM+NAM$B_DIR, R2
        BRW     ADD

; SHOW LOGICAL [name]: translates name in LNM$FILE_DEV, and shows the
; equivalence and the table it is in. With no name, or *, lists them all.
; SHOW DEFAULT: as SHOWDEF. SHOW DEVICES: as SHOWDEV. SHOW PROCESS and
; SHOW SYSTEM run SHOW.EXE.
SHOW:   BSBW    WORD
        TSTL    R8
        BEQL    5$
        MOVAB   V_DEFAULT, R1
        BSBW    VERB
        BLBS    R0, SHOWDEF
        MOVAB   V_DEVICES, R1
        BSBW    VERB
        BLBS    R0, SHOWDEV
        MOVAB   V_LOGICAL, R1
        BSBW    VERB
        BLBS    R0, 10$
        MOVAB   V_PROCESS, R1
        BSBW    VERB
        BLBS    R0, 7$
        MOVAB   V_SYSTEM, R1
        BSBW    VERB
        BLBS    R0, 7$
        BRW     IVKEYW
5$:     BRW     INSFPRM
7$:     SUBL2   R8, R6                  ; the keyword is SHOW.EXE's command line
        MOVAB   SHOWIMG, R4
        MOVL    #1, R3
        BRW     FOREIGN
10$:    BSBW    NAMEWORD
        TSTL    R8
        BEQL    LIST
        CMPL    R8, #1
        BNEQ    15$
        CMPB    NAME, #^A/*/
        BEQL    LIST
15$:    $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=NAMDSC, ITMLST=TRNITEMS
        BLBS    R0, 20$
        CMPL    R0, #SS$_NOLOGNAM
        BNEQ    DONE
        ADDTEXT "%SHOW-S-NOTRAN, no translation for logical name "
        BSBW    ADDNAME
        BSBW    SAY
        BRW     NEXT
20$:    ADDTEXT "   "
        BSBW    PAIR
        ADDTEXT " ("
        MOVAB   TABNAM, R1
        MOVZWL  TABLEN, R2
        BSBW    ADD
        ADDTEXT ")"
        BSBW    SAY
        BRW     NEXT

; LIST: lists the logical names of the process's table, then the system's,
; as VMS's SHOW LOGICAL does, under each table's name.
LIST:   CLRL    R6                      ; the table: 0 the process's, 1 the system's
10$:    PRINT   ""
        ADDTEXT "("
        MOVAB   PROCTAB, R1
        TSTL    R6
        BEQL    15$
        MOVAB   SYSTAB, R1
15$:    BSBW    ADDCSTR
        ADDTEXT ")"
        BSBW    SAY
        PRINT   ""
        CLRL    R7                      ; the name's index
20$:    MOVL    R6, LNMARGS+4
        MOVL    R7, LNMARGS+8
        $CMKRNL_S ROUTIN=GETLNM, ARGLST=LNMARGS
        BLBC    R0, 30$
        ADDTEXT "  "
        BSBW    PAIR
        BSBW    SAY
        INCL    R7
        BRB     20$
30$:    AOBLEQ  #1, R6, 10$
        BRW     NEXT

; GETLNM table, index: in kernel mode, copies the index'th logical name of
; a table, 0 the process's and 1 the system's, to NAME and NAMDSC, and its
; equivalence to EQV and EQVLEN. SS$_NOLOGNAM past the last. A name made
; or deleted between calls may be missed or shown twice.
; ponytail: walks the executive's tables itself, as DIRECTORY reads the
; boot volume; VMS's DCL asks the executive's logical name routines.
        .ENTRY  GETLNM, ^M<R2, R3, R4, R5>
        MOVL    G^SCH$GL_CURPCB, R2
        MOVAQ   PCB$Q_LNMHD(R2), R2
        TSTL    4(AP)
        BEQL    10$
        MOVAQ   G^LNM$GQ_SYSTEM, R2
10$:    MOVL    8(AP), R3
        DSBINT  #IPL$_SYNCH             ; the tables
        MOVL    R2, R1
20$:    MOVL    (R1), R1
        CMPL    R1, R2
        BEQL    80$
        SOBGEQ  R3, 20$
        PUSHL   R1
        MOVZBL  LNMB$T_NAME(R1), NAMDSC
        MOVC3   NAMDSC, LNMB$T_NAME+1(R1), NAME
        MOVL    (SP)+, R1
        MOVZBL  LNMB$T_NAME(R1), R0
        MOVAB   LNMB$T_NAME+1(R1)[R0], R1
        MOVZBL  (R1)+, R0
        MOVW    R0, EQVLEN
        MOVC3   R0, (R1), EQV
        MOVL    #SS$_NORMAL, R0
        BRB     90$
80$:    MOVL    #SS$_NOLOGNAM, R0
90$:    ENBINT
        RET

; PAIR: appends "name" = "equivalence", of NAME and EQV, to MSG. Uses
; R0-R2.
PAIR:   BSBW    QUOTE
        BSBW    ADDNAME
        BSBW    QUOTE
        ADDTEXT " = "
        BSBW    QUOTE
        MOVAB   EQV, R1
        MOVZWL  EQVLEN, R2
        BSBW    ADD
        BRW     QUOTE

; NAMEWORD: the next word of the line, as WORD, copied to NAME, which
; NAMDSC describes. R8 = its length, 0 if there is none. Uses R0-R5.
NAMEWORD:
        BSBW    WORD
        MOVC3   R8, TOKEN, NAME
        MOVL    R8, NAMDSC
        RSB

; WORD: R6 = the next character of the line, R7 = past its last. Skips
; blanks, then copies the characters up to the next blank, in capitals, to
; TOKEN, with R6 past them. R8 = their count, 0 at the end of the line.
; Uses R0.
WORD:   CLRL    R8
10$:    CMPL    R6, R7
        BGEQU   40$
        CMPB    (R6), #^A/ /
        BNEQ    20$
        INCL    R6
        BRB     10$
20$:    CMPL    R6, R7
        BGEQU   40$
        MOVZBL  (R6), R0
        CMPB    R0, #^A/ /
        BEQL    40$
        CMPB    R0, #^A/a/
        BLSSU   30$
        CMPB    R0, #^A/z/
        BGTRU   30$
        SUBB2   #^A/a/-^A/A/, R0
30$:    MOVB    R0, TOKEN[R8]
        INCL    R8
        INCL    R6
        BRB     20$
40$:    RSB

; REST: R6 = the next character of the line, R7 = past its last. Copies
; the words left to TOKEN, in capitals, a blank between each two, with R6
; at the line's end: R8 = their length, R2 = how many. Uses R0.
REST:   CLRL    R8
        CLRL    R2
10$:    CMPL    R6, R7                  ; past the blanks
        BGEQU   50$
        CMPB    (R6), #^A/ /
        BNEQ    20$
        INCL    R6
        BRB     10$
20$:    TSTL    R2
        BEQL    25$
        MOVB    #^A/ /, TOKEN[R8]
        INCL    R8
25$:    INCL    R2
30$:    CMPL    R6, R7                  ; the word
        BGEQU   50$
        MOVZBL  (R6), R0
        CMPB    R0, #^A/ /
        BEQL    10$
        CMPB    R0, #^A/a/
        BLSSU   40$
        CMPB    R0, #^A/z/
        BGTRU   40$
        SUBB2   #^A/a/-^A/A/, R0
40$:    MOVB    R0, TOKEN[R8]
        INCL    R8
        INCL    R6
        BRB     30$
50$:    RSB

; VERB: R1 = a verb, .ASCIC. R0 = 1 if the R8 characters in TOKEN are
; its first ones, else 0. Uses R2.
VERB:   CLRL    R0
        MOVZBL  (R1)+, R2
        CMPL    R8, R2
        BGTRU   90$
        CLRL    R2
10$:    CMPL    R2, R8
        BGEQU   80$
        CMPB    TOKEN[R2], (R1)[R2]
        BNEQ    90$
        INCL    R2
        BRB     10$
80$:    MOVL    #1, R0
90$:    RSB

; STATUS: R0 = % for a message, - for one that follows another, R1 = a
; status. Writes its message, %FACILITY-S-NAME, text, from MESSAGES, or
; the one VMS writes for a status it has no text for.
; Uses R0-R5.
; ponytail: a table in DCL for the file system's and RMS's statuses; VMS
; finds every facility's in message files, with $GETMSG.
STATUS: MOVL    R1, R4
        BSBW    ADDCHAR
        BICL3   #^XF0000000, R4, R3     ; without its control bits
        MOVAB   MESSAGES, R5
5$:     TSTL    (R5)
        BEQL    8$
        CMPL    (R5)+, R3
        BEQL    20$
        MOVL    #3, R3                  ; past the three strings
6$:     MOVZBL  (R5), R0
        ADDL2   R0, R5
        INCL    R5
        SOBGTR  R3, 6$
        BICL3   #^XF0000000, R4, R3
        BRB     5$
8$:     ADDTEXT "NONAME-"
        BICL3   #^C7, R4, R0
        MOVZBL  SEVERITY[R0], R0
        BSBB    ADDCHAR
        ADDTEXT "-NOMSG, Message number "
        MOVL    #8, R5
10$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVZBL  HEX[R0], R0
        BSBB    ADDCHAR
        SOBGTR  R5, 10$
        BRB     SAY
20$:    BSBB    ADDSTEP                 ; the facility
        ADDTEXT "-"
        BICL3   #^C7, R4, R0
        MOVZBL  SEVERITY[R0], R0
        BSBB    ADDCHAR
        ADDTEXT "-"
        BSBB    ADDSTEP                 ; the name
        ADDTEXT ", "
        BSBB    ADDSTEP                 ; the text
; SAY: writes the message in MSG, and empties it. Uses R0 and R1.
SAY:    PUSHAB  MSG
        CALLS   #1, G^PUT_LINE
        CLRB    MSG
        RSB

; ADDSTEP: R5 = a .ASCIC string. Appends it to MSG, with R5 past it.
; Uses R0-R2.
ADDSTEP:
        MOVL    R5, R1
        BSBW    ADDCSTR
        MOVZBL  (R5), R0
        ADDL2   R0, R5
        INCL    R5
        RSB

; ADDNAME: appends the logical name in NAME to MSG. Uses R0-R2.
ADDNAME:
        MOVAB   NAME, R1
        MOVL    NAMDSC, R2
        BRB     ADD

; QUOTE: appends a double quote to MSG. Uses R0-R2.
QUOTE:  MOVZBL  #34, R0
        BRB     ADDCHAR

; ADDTOKEN: appends the R8 characters in TOKEN to MSG. Uses R0-R2.
ADDTOKEN:
        MOVAB   TOKEN, R1
        MOVL    R8, R2
        BRB     ADD

; ADDCHAR: appends the character in R0 to MSG. Uses R0-R2.
ADDCHAR:
        MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
        BRB     ADD

; ADDCSTR: appends the .ASCIC string at R1 to MSG. Uses R0-R2.
ADDCSTR:
        MOVZBL  (R1)+, R2
; ADD: appends the R2 bytes at R1 to MSG, as many as fit. Uses R0-R2.
ADD:    MOVZBL  MSG, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, MSG[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, MSG
        RSB

        .END    DCL
