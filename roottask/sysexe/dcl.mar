        .TITLE  DCL     The command interpreter
        .IDENT  /V0.1/
;
; A small DCL. build.rs links it in P1, at VA$C_CLI, which makes it a
; command interpreter: EXEC$START creates the console's process, SYSTEM,
; with it, and the executive calls it in supervisor mode, with SS$_NORMAL
; at first and then, each time an image it runs exits, with the image's
; status (docs/design/0002-executive-processes.md). Its data stays in P1
; from one call to the next. It reports a failure status, prompts for a
; command on the console and does it:
;
;   RUN image   runs image, image.EXE if it has no type, in this process
;   DIRECTORY [spec]
;               runs DIRECTORY.EXE
;   TYPE spec   runs TYPE.EXE
;   DEFINE name equivalence
;               makes a logical name in the process's table, or with
;               /SYSTEM or /TABLE=table that one's; /NOLOG says nothing
;               of the one it replaced
;   DEASSIGN name
;               deletes it, with the same qualifiers
;   SHOW LOGICAL [name]
;               translates a logical name, as $ASSIGN would; with no
;               name, or *, lists them all; /PROCESS, /SYSTEM and
;               /TABLE=table look in that table only
;   SET DEFAULT [dev:][dir]
;               sets the process's default directory, with $SETDDIR,
;               and device, its SYS$DISK
;   SHOW DEFAULT
;               shows it, with the device
;   SHOW DEVICES [name]
;               lists the devices, those whose names start with name;
;               /MOUNTED those with a volume mounted
;   SHOW PROCESS[/PRIVILEGES], SHOW SYSTEM
;               run SHOW.EXE
;   SET PROCESS/PRIVILEGES=(priv[,...])
;               runs SET.EXE
;   SET INTERFACE address mask, SHOW INTERFACE,
;   SET CONFIGURATION INTERFACE address mask,
;   SET ROUTE /DEFAULT /GATEWAY=address [/PERMANENT]
;               run TCPIP.EXE
;   SET [NO]CONTROL[=Y]
;               turns CTRL/Y, and CTRL/C no image takes, on or off
;   SET HOST address
;               runs RTPAD.EXE, a remote login to address
;   SET COMMAND file
;               adds the verbs file.CLD defines to the process's
;               commands, compiled with CDU$COMPILE (dcl/cdu.mar)
;   EDIT spec   runs EDIT.EXE, with spec as its command line
;   COPY[/LOG] from to
;               runs COPY.EXE
;   DELETE[/LOG] spec
;               runs DELETE.EXE
;   INITIALIZE device label
;               runs INIT.EXE
;   MOUNT device [label]
;               runs MOUNT.EXE
;   DISMOUNT device
;               runs DISMOUNT.EXE
;   CREATE/DIRECTORY spec
;               runs CREATE.EXE
;   CONTINUE    goes back to the image CTRL/Y stopped
;   STOP [process-name], STOP/IDENTIFICATION=pid
;               deletes the process; with no name, ends the image CTRL/Y
;               stopped, without its exit handlers, and the procedures
;   HELP [verb] runs HELP.EXE, which lists the commands from DCL$TABLES
;   LOGOUT      ends the process
;   @file [p1 ... p8]
;               runs the command procedure file, file.COM if it has no
;               type, with P1 to P8 local symbols of its parameters
;   name = expression, name == expression
;               sets a local symbol, or a global one
;   name := string, name :== string
;               the same, with the rest of the line, in capitals but in
;               quotes
;   name := $image
;               makes name a foreign command: name args runs image,
;               SYS$SYSTEM:image.EXE by default, which takes args with
;               LIB$GET_FOREIGN
;   IF expression THEN command
;               does command if the expression is true, odd
;   GOTO label  goes on from the procedure's line label: starts
;   EXIT [status]
;               ends the procedure, with $STATUS or status; outside
;               one, the image CTRL/Y stopped exits with it, through its
;               exit handlers
;   WRITE SYS$OUTPUT expression[,...]
;               writes the values on the console
;   SHOW SYMBOL name
;               shows a symbol's value: the nearest, or with /LOCAL or
;               /GLOBAL that one; /ALL instead of a name shows them all
;   DELETE/SYMBOL name
;               deletes a local symbol, or with /GLOBAL a global one;
;               /ALL instead of a name deletes them all
;
; The verbs are DCL$TABLES's, from roottask/cld/*.cld (ADR-0017).
; CLI$$DCL_PARSE parses each command with them, and prompts for the
; parameters it needs at the console: a verb, or a qualifier, may be
; abbreviated to 4 characters, or fewer that no other starts with. An
; image a verb runs gets the parse, which it reads with CLI$PRESENT and
; CLI$GET_VALUE. A verb DCL does itself has a CLIROUTINE, the name of its
; code in ROUTINES. A symbol may stand for the verb, and the words after
; it: HOME ==
; "SET DEFAULT [SYSMGR]" makes HOME a command. A status with
; STS$M_INHIB_MSG set is one the image reported itself. It reads the
; commands from SYS$INPUT, but SYS$MANAGER:SYSTARTUP_VMS.COM's and
; SYLOGIN.COM's, which it runs first, and a command procedure's, whose
; lines start with $.
;
; CTRL/Y is DCL's supervisor mode AST, which it enables on the console
; with IO$_SETMODE (ADR-0014). It stops the image DCL runs, where it is,
; and DCL prompts on top of it: CONTINUE returns from the AST, and the
; image goes on; a command that runs an image runs the stopped one down.
; With no image, CTRL/Y ends the line being typed.
;
; Before a command is done, ! outside quotes starts a comment, and
; 'name' outside quotes, ''name' in them, becomes the symbol's value.
; Local symbols are the procedure's that made them, and those it calls
; see them; global ones are everyone's. $STATUS is the last command's
; status and $SEVERITY its severity. Expressions are integers, "strings"
; and symbols, with * /, + -, .EQ. .NE. .LT. .LE. .GT. .GE. and their
; string forms .EQS. ... .GES., .AND., .OR., in that order, ( ), and -
; and .NOT. in front of an operand. + joins two strings; a string
; elsewhere is its integer, or 1 if it starts with T or Y, else 0. A
; command whose status is an error or a fatal error ends every procedure,
; as VMS's ON ERROR THEN EXIT does; so does CTRL/Y, at the next command.
; ponytail: message texts for a few statuses only. @
; reads the whole procedure into PBUF, and it goes when the procedure
; ends: 16 KB for those running at once. No ON, IF blocks, lexical
; functions, OPEN or READ; lines without $, an image's input on VMS, are
; skipped. .NOT. takes an operand, not a comparison.
;
; This module reads the commands, parses them and does those that run
; an image, CTRL/Y, CONTINUE and STOP. The rest are in dcl/: logical.mar
; has the logical name commands, setshow.mar SET and SHOW DEFAULT, SHOW
; DEVICES and SET COMMAND, proc.mar @ and the commands that steer a
; procedure, symbol.mar the symbols and their commands, expr.mar symbol
; substitution and expressions, message.mar the messages, and cdu.mar
; the CLD compiler. What they share is global, named DCL$name, and
; dcl.mlb has their constants.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        .LIBRARY "dcl.mlb"
        $SSDEF
        $CLIMSGDEF
        $IODEF
        $DCLDEF

        .EXTERNAL DCL$TABLES, CLI$$DCL_PARSE, CLI$$RESULT, CLI$$IMAGE
        .EXTERNAL CLI$$ROUTINE, CLI$GET_VALUE, CLI$PRESENT, CLI$$FOREIGN
        .EXTERNAL DCL$ADD, DCL$ADDCSTR, DCL$ASSIGN, DCL$DEASSIGN, DCL$DEFINE
        .EXTERNAL DCL$DELSYM, DCL$DO, DCL$ENDPROCS, DCL$EXIT, DCL$EXITPROC
        .EXTERNAL DCL$FINDSYM, DCL$GETPROC, DCL$GOTO, DCL$IF, DCL$NAMESCAN
        .EXTERNAL DCL$SAMESTR, DCL$SAY, DCL$SETCOMMAND, DCL$SETDEF, DCL$SHOW
        .EXTERNAL DCL$SKIP, DCL$STATUS, DCL$STRASSIGN, DCL$SUBST, DCL$SYMNAM
        .EXTERNAL DCL$TOSTR, DCL$VSTACK, DCL$WRITE

        .PSECT  DATA, NOEXE, WRT, LONG
CHAN:   .LONG   0                       ; SYS$INPUT's, once assigned
INPUT:  .ASCID  "SYS$INPUT"
DCL$NAMDSC::                            ; a logical name: its length
        .LONG   0
        .ADDRESS DCL$NAME
DCL$NAME::                              ; and its text
        .BLKB   LINESIZE
PROMPT: .ASCII  "$ "
IOSB:   .BLKQ   1
DCL$LINE::                              ; the command line
        .BLKB   LINESIZE
DCL$TOKEN::                             ; a word of it, in capitals, and room for .EXE
        .BLKB   LINESIZE+4
TOKDSC: .LONG   0                       ; a descriptor of DCL$TOKEN: its length
        .ADDRESS DCL$TOKEN
DCL$MSG::                               ; a message being made, .ASCIC
        .BLKB   256
CMDDSC: .LONG   0, 0                    ; a command, for CLI$$DCL_PARSE
RESDSC: .LONG   0, 0                    ; its parse, for $IMGACT
DCLFAC: .ASCIC  "DCL"                   ; the facility its errors are
DCL$V_FILE::                            ; the entities DCL's own verbs get
        .ASCID  "FILE"
DCL$V_LOGNAM::                          ; the logical name
        .ASCID  "LOGICAL_NAME"
DCL$V_EXPR::                            ; an expression
        .ASCID  "EXPRESSION"
V_PRCNAM:
        .ASCID  "PROCESS_NAME"
V_IDENT:
        .ASCID  "IDENTIFICATION"
V_CONTROL:
        .ASCID  "OPTION.CONTROL"
VALDSC: .LONG   LINESIZE                ; DCL$GETVAL's: DCL$TOKEN
        .ADDRESS DCL$TOKEN
VALLEN: .WORD   0
; The CLIROUTINEs of DCL$TABLES: each name, .ASCIC, and its code, until
; a 0.
ROUTINES:
        .ASCIC  "CONTINUE"
        .ADDRESS DCL$CONTINUE
        .ASCIC  "DEASSIGN"
        .ADDRESS DCL$DEASSIGN
        .ASCIC  "DEFINE"
        .ADDRESS DCL$DEFINE
        .ASCIC  "DELSYM"
        .ADDRESS DCL$DELSYM
        .ASCIC  "EXIT"
        .ADDRESS DCL$EXIT
        .ASCIC  "GOTO"
        .ADDRESS DCL$GOTO
        .ASCIC  "IF"
        .ADDRESS DCL$IF
        .ASCIC  "LOGOUT"
        .ADDRESS LOGOUT
        .ASCIC  "RUN"
        .ADDRESS RUN
        .ASCIC  "SET"
        .ADDRESS SET
        .ASCIC  "SET_COMMAND"
        .ADDRESS DCL$SETCOMMAND
        .ASCIC  "SHOW"
        .ADDRESS DCL$SHOW
        .ASCIC  "STOP"
        .ADDRESS STOP
        .ASCIC  "WRITE"
        .ADDRESS DCL$WRITE
        .BYTE   0
FIRST:  .ASCIC  "@SYS$MANAGER:SYSTARTUP_VMS"     ; the first commands, until a 0
        .ASCIC  "@SYS$MANAGER:SYLOGIN"
        .BYTE   0
DCL$LINE2::                             ; a command being made
        .BLKB   LINESIZE
DOTEXE: .ASCII  ".EXE"
        .ALIGN  LONG
DCL$SAVESP::                            ; SP as DCL was called, where errors go back to
        .LONG   0
FIRSTP: .ADDRESS FIRST                  ; the next of the first commands
IMGRUN: .LONG   0                       ; 1 while an image runs, or is about to
DCL$CTRLYFP::                           ; while CTRL/Y has it stopped, FP in the AST, else 0
        .LONG   0
CTRLYHIT:                               ; 1: CTRL/Y came with no image
        .LONG   0
NOCTRLY:                                ; 1 after SET NOCONTROL: no CTRL/Y AST
        .LONG   0
STOPPID:                                ; STOP/IDENTIFICATION's PID
        .LONG   0
DCL$LASTSTAT::                          ; $STATUS
        .LONG   SS$_NORMAL
DCL$DEPTH::                             ; the procedure running, 0 for none
        .LONG   0
DCL$PTABVEC::                           ; the process's tables, for CLI$$DCL_PARSE: how many,
        .LONG   0
        .BLKL   MAXPTAB                 ; then each one, the last SET COMMAND's first

        .PSECT  CODE, EXE, LONG
; DCL status: the command interpreter's transfer address, which the
; executive calls with SS$_NORMAL first and then with the status of each
; image it runs. Reports the status if it is a failure, then reads and
; does commands. Never returns.
        .ENTRY  DCL, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVL    SP, DCL$SAVESP
        CLRL    IMGRUN
        TSTL    CHAN
        BNEQ    10$
        $ASSIGN_S DEVNAM=INPUT, CHAN=CHAN
        BLBC    R0, QUIT
        BSBW    CTRLYON
        BRB     DCL$NEXT
10$:    MOVL    4(AP), R0
        BRW     DCL$DONE

; DCL$NEXT: reads the next command, from the procedure running or from
; the console, and does it.
DCL$NEXT::
        MOVL    DCL$SAVESP, SP
        BBCC    #0, CTRLYHIT, 5$
        BSBW    DCL$ENDPROCS
5$:     TSTL    DCL$DEPTH
        BEQL    PROMPT1
        BSBW    DCL$GETPROC
        BLBS    R0, 10$
        BSBW    DCL$EXITPROC            ; past its end
        BRB     DCL$NEXT
10$:    MOVAB   DCL$LINE, R6
        ADDL2   R6, R7
        BSBW    DCL$SKIP
        CMPL    R6, R7
        BGEQU   DCL$NEXT
        CMPB    (R6), #^A/$/            ; a command, else data, skipped
        BNEQ    DCL$NEXT
        INCL    R6
        BRB     SUBLINE
PROMPT1:
        MOVL    FIRSTP, R1              ; the first commands, before the console's
        MOVZBL  (R1)+, R7
        BEQL    20$
        ADDL3   R1, R7, FIRSTP
        MOVC3   R7, (R1), DCL$LINE
        BRB     GOTLINE
20$:    $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=DCL$LINE, P2=#LINESIZE, P5=#PROMPT, P6=#2
        BLBC    R0, QUIT
        CMPW    IOSB, #SS$_LINKDISCON   ; SET HOST's: the line is gone
        BEQL    QUIT
        CMPW    IOSB, #SS$_LINKABORT
        BEQL    QUIT
        MOVZWL  IOSB+2, R7
; GOTLINE: R7 = the length of the command in DCL$LINE.
GOTLINE:
        MOVAB   DCL$LINE, R6
        ADDL2   R6, R7                  ; past the line
SUBLINE:
        BSBW    DCL$SUBST
; DCL$COMMAND: R6 = a command's first character in DCL$LINE, R7 = past
; its last. Does it.
DCL$COMMAND::
        BSBW    DCL$SKIP
        CMPL    R6, R7
        BGEQU   5$
        CMPB    (R6), #^A/$/            ; IF's THEN $ command, or a $ typed
        BNEQ    10$
        INCL    R6
        BSBW    DCL$SKIP
        CMPL    R6, R7
        BLSSU   10$
5$:     BRW     DCL$NEXT
10$:    CMPB    (R6), #^A/@/
        BNEQ    15$
        BRW     DCL$DO
15$:    MOVL    R6, R10                 ; a label, or an assignment?
        BSBW    DCL$NAMESCAN
        TSTL    R8
        BEQL    40$
        BSBW    DCL$SKIP
        CMPL    R6, R7
        BGEQU   40$
        CMPB    (R6), #^A/=/
        BNEQ    20$
        BRW     DCL$ASSIGN
20$:    CMPB    (R6), #^A/:/
        BNEQ    40$
        INCL    R6
        CMPL    R6, R7
        BGEQU   DCL$COMMAND
        CMPB    (R6), #^A/=/
        BNEQ    DCL$COMMAND             ; a label: the rest is the command
        BRW     DCL$STRASSIGN
40$:    MOVL    R10, R6
        BSBW    DCL$WORD
        TSTL    R8
        BEQL    5$
        CMPL    R8, #31                 ; a symbol for the verb?
        BGTRU   VERBS
        MOVB    R8, DCL$SYMNAM
        MOVC3   R8, DCL$TOKEN, DCL$SYMNAM+1
        BSBW    DCL$FINDSYM
        TSTL    R1
        BEQL    VERBS
        MOVAB   DCL$VSTACK, R9          ; its value, then the rest, in DCL$LINE
        MOVC3   #VAL$K_LENGTH, SYM$R_VALUE(R1), (R9)
        BSBW    DCL$TOSTR
        MOVZBL  VAL$T_STR(R9), R11
        BEQL    45$
        CMPB    VAL$T_STR+1(R9), #^A/$/ ; name := $image, a foreign command
        BNEQ    45$
        BRW     FOREIGN
45$:    MOVC3   R11, VAL$T_STR+1(R9), DCL$LINE2
        SUBL3   R6, R7, R0
        SUBL3   R11, #LINESIZE, R1
        CMPL    R0, R1
        BLEQU   50$
        MOVL    R1, R0
50$:    ADDL3   R0, R11, R7
        MOVAB   DCL$LINE2[R11], R1
        MOVC3   R0, (R6), (R1)
        MOVC3   R7, DCL$LINE2, DCL$LINE
        MOVAB   DCL$LINE, R6
        ADDL2   R6, R7
        BSBW    DCL$WORD
        TSTL    R8
        BEQL    5$
; VERBS: R6 = past the verb, R8 = its length. Parses the command with
; DCL$TABLES (ADR-0017), prompting for missing parameters at the
; console, and runs the verb's image with the parse, or does the verb's
; CLIROUTINE, which takes its values from the parse.
VERBS:  SUBL3   R8, R6, R0              ; the command
        MOVL    R0, CMDDSC+4
        SUBL3   R0, R7, CMDDSC
        CLRL    R1                      ; prompts only at the console
        TSTL    DCL$DEPTH
        BNEQ    10$
        MOVAB   PROMPTFOR, R1
10$:    PUSHAL  DCL$PTABVEC             ; SET COMMAND's tables first
        PUSHAB  DCLFAC
        PUSHL   R1
        PUSHAB  G^DCL$TABLES
        PUSHAQ  CMDDSC
        CALLS   #5, G^CLI$$DCL_PARSE
        BLBS    R0, 20$
        BRW     DCL$DONE                ; reported
20$:    TSTB    G^CLI$$ROUTINE
        BNEQ    30$
        BRW     IMGVERB
30$:    MOVAB   ROUTINES, R10           ; which one
40$:    MOVZBL  (R10), R0
        BEQL    60$
        MOVL    R10, R1
        MOVAB   G^CLI$$ROUTINE, R2
        BSBW    DCL$SAMESTR
        MOVZBL  (R10), R1
        ADDL2   R1, R10
        INCL    R10
        BLBS    R0, 50$
        ADDL2   #4, R10
        BRB     40$
50$:    MOVL    (R10), R0
        JMP     (R0)
60$:    PRINT   "%DCL-W-INVROUT, invalid routine specified in command tables - check .CLD file"
        BRW     DCL$WARN
LOGOUT:                                 ; the process ends
QUIT:   $DELPRC_S

; DCL$CONTINUE: returns from the CTRL/Y AST to the image it stopped,
; with CTRL/Y enabled again, or does nothing if there is none.
DCL$CONTINUE::
        TSTL    DCL$CTRLYFP
        BEQL    10$
        BSBW    CTRLYON
        MOVL    DCL$CTRLYFP, FP
        CLRL    DCL$CTRLYFP
        RET
10$:    BRW     DCL$OK

; STOP [process-name], STOP/IDENTIFICATION=pid: deletes the process with
; $DELPRC, pid in hex. With neither, ends the procedures running, and
; the image CTRL/Y stopped, if there is one, with $EXIT from here, which
; runs it down without its exit handlers, user mode's, and calls DCL
; afresh, with CTRL/Y enabled again, and SS$_ABORT, reported already.
STOP:   MOVAB   V_IDENT, R1
        BSBW    DCL$GETVAL
        TSTL    R8
        BNEQ    STOPID
        MOVAB   V_PRCNAM, R1
        BSBW    DCL$GETVAL
        TSTL    R8
        BEQL    10$
        MOVL    R8, TOKDSC
        $DELPRC_S PRCNAM=TOKDSC
        BRW     DCL$DONE
10$:    BSBW    DCL$ENDPROCS
        TSTL    DCL$CTRLYFP
        BEQL    20$
        CLRL    DCL$CTRLYFP
        BSBW    CTRLYON
        $EXIT_S #<SS$_ABORT!INHIB>
20$:    MOVL    #<SS$_ABORT!INHIB>, R0
        BRW     DCL$DONE

; STOPID: DCL$TOKEN = a PID, R8 = its length: its hex digits, 8 at most.
STOPID: CLRL    STOPPID
        CMPL    R8, #8
        BGTRU   30$
        MOVAB   DCL$TOKEN, R1
10$:    MOVZBL  (R1)+, R0
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BLEQU   20$
        SUBL2   #<^A/A/-^A/0/-10>, R0
        CMPL    R0, #10
        BLSSU   30$
        CMPL    R0, #15
        BGTRU   30$
20$:    ASHL    #4, STOPPID, STOPPID
        BISL2   R0, STOPPID
        SOBGTR  R8, 10$
        $DELPRC_S PIDADR=STOPPID
        BRW     DCL$DONE
30$:    PRINT   "%DCL-W-IVCHAR, invalid numeric value - check for invalid digits"
        BRW     DCL$WARN

; RUN image: runs it with $IMGACT, which returns only if it can't.
RUN:    MOVAB   DCL$V_FILE, R1
        BSBW    DCL$GETVAL
        CLRL    R9                      ; no command line
        BRB     IMAGE

; FOREIGN: R9 = the value, $image, of the symbol DCL$SYMNAM, the verb,
; R10 = the command's first character, R7 = past its last. Runs image,
; with a parse whose $LINE is the command, in capitals outside quotes,
; which LIB$GET_FOREIGN takes the words after the verb from.
FOREIGN:
        MOVL    R10, R1
        CLRL    R2                      ; 1 in quotes
10$:    CMPL    R1, R7
        BGEQU   30$
        CMPB    (R1), #^A/"/
        BNEQ    15$
        XORL2   #1, R2
15$:    TSTL    R2
        BNEQ    20$
        CMPB    (R1), #^A/a/
        BLSSU   20$
        CMPB    (R1), #^A/z/
        BGTRU   20$
        SUBB2   #^A/a/-^A/A/, (R1)
20$:    INCL    R1
        BRB     10$
30$:    MOVL    R10, CMDDSC+4
        SUBL3   R10, R7, CMDDSC
        PUSHAB  DCL$SYMNAM
        PUSHAQ  CMDDSC
        CALLS   #2, G^CLI$$FOREIGN
        MOVZBL  VAL$T_STR(R9), R8       ; the image, past the $
        DECL    R8
        MOVC3   R8, VAL$T_STR+2(R9), DCL$TOKEN
        BRB     WITHPARSE

; IMGVERB: runs the parsed verb's image, with the parse as its command.
IMGVERB:
        MOVZBL  G^CLI$$IMAGE, R8
        MOVC3   R8, G^CLI$$IMAGE+1, DCL$TOKEN
; WITHPARSE: DCL$TOKEN = an image, R8 = its length: runs it with the
; parse.
WITHPARSE:
        MOVAB   G^CLI$$RESULT, R0
        MOVZWL  (R0), RESDSC
        MOVL    R0, RESDSC+4
        MOVAB   RESDSC, R9
; IMAGE: DCL$TOKEN = an image's name, R8 = its length, R9 = the parse's
; descriptor, or 0. Runs it, IMAGE.EXE if it has no type.
IMAGE:  CLRL    R0                      ; a type?
15$:    CMPB    DCL$TOKEN[R0], #^A/./
        BEQL    20$
        AOBLSS  R8, R0, 15$
        MOVAB   DCL$TOKEN[R8], R0
        MOVL    DOTEXE, (R0)
        ADDL2   #4, R8
20$:    MOVL    R8, TOKDSC
        BSBW    RUNNING
        $IMGACT_S IMAGE=TOKDSC, CMDLIN=(R9)
        MOVAB   TOKDSC, R1
        BRB     ACTFAIL

; DCL$INSFPRM: after a command without a parameter it needs.
DCL$INSFPRM::
        PRINT   "%DCL-W-INSFPRM, missing command parameters - supply all required parameters"
; DCL$WARN: after a warning DCL reported.
DCL$WARN::
        MOVL    #CLIWARN, R0
        BRW     DCL$DONE

; ACTFAIL: R0 = the status $IMGACT returned, R1 = the image's descriptor.
; Reports it, and prompts for the next command. The image CTRL/Y stopped,
; if there was one, is gone.
ACTFAIL:
        CLRL    IMGRUN
        CLRL    DCL$CTRLYFP
        PUSHL   R0
        PUSHL   R1
        ADDTEXT "%DCL-W-ACTIMAGE, error activating image "
        MOVL    (SP)+, R0
        MOVZWL  (R0), R2
        MOVL    4(R0), R1
        BSBW    DCL$ADD
        BSBW    DCL$SAY
        MOVZBL  #^A/-/, R0
        MOVL    (SP)+, R1
        PUSHL   R1
        BSBW    DCL$STATUS
        BISL3   #INHIB, (SP)+, R0
        BRW     DCL$DONE

; DCL$DONE: R0 = a command's status, or an image's. Makes it $STATUS,
; and reports it if it is a failure no one reported, which it then marks
; reported. An error or a fatal error ends the procedures running. Then
; the next command.
DCL$DONE::
        MOVL    R0, DCL$LASTSTAT
        BLBS    R0, 20$
        BBS     #INHIB_MSG, R0, 10$
        MOVL    R0, R1
        MOVZBL  #^A/%/, R0
        BSBW    DCL$STATUS
        BISL2   #INHIB, DCL$LASTSTAT
10$:    TSTL    DCL$DEPTH
        BEQL    20$
        BICL3   #^C7, DCL$LASTSTAT, R0  ; the severity
        CMPL    R0, #2                  ; STS$K_ERROR
        BEQL    15$
        CMPL    R0, #4                  ; STS$K_SEVERE
        BNEQ    20$
15$:    BSBW    DCL$EXITPROC
        BRB     10$
20$:    BRW     DCL$NEXT

; DCL$OK: after a command that worked.
DCL$OK::
        MOVL    #SS$_NORMAL, DCL$LASTSTAT
        BRW     DCL$NEXT

; SET [NO]CONTROL[=Y]: enables DCL's CTRL/Y AST, or disables it, so that
; CTRL/Y, and CTRL/C no image has an AST for, do nothing.
SET:    MOVAB   V_CONTROL, R1
        BSBW    DCL$ISPRES
        CMPL    R0, #CLI$_ABSENT
        BEQL    DCL$SETDEF
        CLRL    NOCTRLY
        CMPL    R0, #CLI$_NEGATED
        BNEQ    10$
        MOVL    #1, NOCTRLY
10$:    BSBW    CTRLYON
        BRW     DCL$OK

; DCL$GETVAL: R1 = an entity's name, .ASCID. Copies its first value in
; the command's parse to DCL$TOKEN: R8 = its length, 0 if it has none.
; Uses R0, R1.
DCL$GETVAL::
        PUSHAW  VALLEN
        PUSHAQ  VALDSC
        PUSHL   R1
        CALLS   #3, G^CLI$GET_VALUE
        MOVZWL  VALLEN, R8
        BLBS    R0, 10$
        CLRL    R8
10$:    RSB

; DCL$ISPRES: R1 = an entity's name, .ASCID. R0 = CLI$PRESENT's status
; for it, odd if it is present or defaulted. Uses R0, R1.
DCL$ISPRES::
        PUSHL   R1
        CALLS   #1, G^CLI$PRESENT
        RSB

; DCL$NAMEVAL: the same, copied to DCL$NAME, which DCL$NAMDSC describes.
; Uses R0-R5.
DCL$NAMEVAL::
        BSBB    DCL$GETVAL
        MOVC3   R8, DCL$TOKEN, DCL$NAME
        MOVL    R8, DCL$NAMDSC
        RSB

; DCL$RESTVAL: R1 = an entity's name, .ASCID, a $REST_OF_LINE. Copies
; its value to DCL$LINE: R6 = DCL$LINE, R7 = past it, where IF, EXIT and
; WRITE read their expressions. Uses R0-R5, R8.
DCL$RESTVAL::
        BSBB    DCL$GETVAL
        MOVC3   R8, DCL$TOKEN, DCL$LINE
        MOVAB   DCL$LINE, R6
        ADDL3   R6, R8, R7
        RSB

; DCL$VALNAME: R1 = an entity's name, .ASCID. Its first value, as a
; symbol name, to DCL$SYMNAM, as DCL$NAMESCAN makes it: R8 = its length.
; Uses R0, R1, R6, R7.
DCL$VALNAME::
        BSBB    DCL$GETVAL
        MOVAB   DCL$TOKEN, R6
        ADDL3   R6, R8, R7
        BRW     DCL$NAMESCAN

; DCL$WORD: R6 = the next character of the line, R7 = past its last.
; Skips blanks, then copies the characters up to the next blank, in
; capitals, to DCL$TOKEN, with R6 past them. R8 = their count, 0 at the
; end of the line. Uses R0.
DCL$WORD::
        CLRL    R8
10$:    CMPL    R6, R7
        BGEQU   40$
        CMPB    (R6), #^A/ /
        BNEQ    20$
        INCL    R6
        BRB     10$
20$:    CMPL    R6, R7
        BGEQU   40$
        MOVZBL  (R6), R0
        CMPB    R0, #^A/ /
        BEQL    40$
        CMPB    R0, #^A/a/
        BLSSU   30$
        CMPB    R0, #^A/z/
        BGTRU   30$
        SUBB2   #^A/a/-^A/A/, R0
30$:    MOVB    R0, DCL$TOKEN[R8]
        INCL    R8
        INCL    R6
        BRB     20$
40$:    RSB

; REST: R6 = the next character of the line, R7 = past its last. Copies
; the words left to DCL$TOKEN, in capitals, a blank between each two,
; with R6 at the line's end: R8 = their length, R2 = how many. Uses R0.
REST:   CLRL    R8
        CLRL    R2
10$:    CMPL    R6, R7                  ; past the blanks
        BGEQU   50$
        CMPB    (R6), #^A/ /
        BNEQ    20$
        INCL    R6
        BRB     10$
20$:    TSTL    R2
        BEQL    25$
        MOVB    #^A/ /, DCL$TOKEN[R8]
        INCL    R8
25$:    INCL    R2
30$:    CMPL    R6, R7                  ; the word
        BGEQU   50$
        MOVZBL  (R6), R0
        CMPB    R0, #^A/ /
        BEQL    10$
        CMPB    R0, #^A/a/
        BLSSU   40$
        CMPB    R0, #^A/z/
        BGTRU   40$
        SUBB2   #^A/a/-^A/A/, R0
40$:    MOVB    R0, DCL$TOKEN[R8]
        INCL    R8
        INCL    R6
        BRB     30$
50$:    RSB

; DCL$VERB: R1 = a verb, .ASCIC. R0 = 1 if the R8 characters in
; DCL$TOKEN are its first ones, else 0. Uses R2.
DCL$VERB::
        CLRL    R0
        MOVZBL  (R1)+, R2
        CMPL    R8, R2
        BGTRU   90$
        CLRL    R2
10$:    CMPL    R2, R8
        BGEQU   80$
        CMPB    DCL$TOKEN[R2], (R1)[R2]
        BNEQ    90$
        INCL    R2
        BRB     10$
80$:    MOVL    #1, R0
90$:    RSB

; PROMPTFOR answer, prompt, anslen: CLI$$DCL_PARSE's prompt routine, as
; LIB$GET_INPUT: reads a line from SYS$INPUT after the prompt, into the
; string answer describes, and its length into the word anslen.
; SS$_ABORT if CTRL/Y came.
        .ENTRY  PROMPTFOR, ^M<R2, R3>
        MOVL    4(AP), R2
        MOVZWL  (R2), R3
        MOVL    8(AP), R1
        MOVZWL  (R1), R0
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=@4(R2), P2=R3, P5=4(R1), P6=R0
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
        BLBC    R0, 90$
        MOVW    IOSB+2, @12(AP)
        TSTL    CTRLYHIT
        BEQL    90$
        MOVL    #SS$_ABORT, R0
90$:    RET

; RUNNING: before $IMGACT. Enables CTRL/Y for the image, which CTRL/Y's
; AST may not have, and says an image runs. Uses R0 and R1.
RUNNING:
        MOVL    #1, IMGRUN
; CTRLYON: enables DCL's CTRL/Y AST on the console, or disables it
; after SET NOCONTROL. Uses R0 and R1.
CTRLYON:
        MOVAB   CTRLY, R0
        TSTL    NOCTRLY
        BEQL    10$
        CLRL    R0
10$:    $QIOW_S CHAN=CHAN, FUNC=#IO$_SETMODE!IO$M_CTRLYAST, P1=(R0)
        RSB

; CTRLY: DCL's CTRL/Y AST, in supervisor mode, on top of what CTRL/Y
; stopped. With an image running, ends the procedures running and does
; commands, until CONTINUE returns from here, or a command runs another
; image. Without, it is enabled again, and DCL ends the procedures at its
; next command. Saves the registers DCL does, so that CONTINUE can return
; from here.
        .ENTRY  CTRLY, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        TSTL    IMGRUN
        BNEQ    10$
        MOVL    #1, CTRLYHIT
        BSBW    CTRLYON
        RET
10$:    MOVL    FP, DCL$CTRLYFP
        MOVL    SP, DCL$SAVESP
        BSBW    DCL$ENDPROCS
        BRW     DCL$NEXT

        .END    DCL
