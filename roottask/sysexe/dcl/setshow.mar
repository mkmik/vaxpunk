        .TITLE  SETSHOW DCL's SET and SHOW of the default and devices
        .IDENT  /V0.1/
;
; SET DEFAULT, SHOW DEFAULT, SHOW DEVICES and SET COMMAND.
; One of DCL's modules: ../dcl.mar says how they fit.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        .LIBRARY "../sysexe.mlb"
        .LIBRARY "../dcl.mlb"
        $SSDEF
        $LNMDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $NAMDEF
        $DVIDEF
        $DVSDEF
        $DCDEF
        $UCBDEF
        $DCLDEF

        .EXTERNAL CDU$COMPILE, DCL$ADD, DCL$ADDCSTR, DCL$ADDDEC, DCL$DONE
        .EXTERNAL DCL$GETVAL, DCL$INSFPRM, DCL$ISPRES, DCL$OK, DCL$PADTO
        .EXTERNAL DCL$PTABVEC, DCL$SAY, DCL$TOKEN, DCL$V_FILE, DCL$WARN

        .PSECT  DATA, NOEXE, WRT, LONG
DCL$PROCESS::                           ; the process's logical name table
        .ASCID  "LNM$PROCESS"
V_DIR:  .ASCID  "DIRECTORY"
V_DEVNAM:
        .ASCID  "DEVICE_NAME"
V_MOUNTED:
        .ASCID  "MOUNTED"
MOUNTED:                                ; SHOW DEVICES/MOUNTED: 1 for mounted volumes only
        .JSB32_ENTRY
        .LONG   0
SCANCTX:                                ; $DEVICE_SCAN's context
        .BLKQ   1
PATDSC: .LONG   0                       ; its search name, in DCL$TOKEN
        .ADDRESS DCL$TOKEN
DVSITEMS:                               ; its items: the class
        .WORD   4, DVS$_DEVCLASS
        .ADDRESS DEVCLASS
        .LONG   0
        .LONG   0
DEVCLASS:
        .LONG   0
DEVDSC: .LONG   8                       ; the device's name it found, _DDCU:
        .ADDRESS DEVNAME
DVINAM: .LONG   0                       ; and its length, a descriptor of it
        .ADDRESS DEVNAME
DEVNAME:
        .BLKB   8
DVIITEMS:                               ; what $GETDVIW returns of it
        .WORD   4, DVI$_MNT
        .ADDRESS V_MNT
        .LONG   0
        .WORD   4, DVI$_SWL
        .ADDRESS V_SWL
        .LONG   0
        .WORD   4, DVI$_STS
        .ADDRESS V_STS
        .LONG   0
        .WORD   4, DVI$_ERRCNT
        .ADDRESS V_ERRCNT
        .LONG   0
        .WORD   12, DVI$_VOLNAM
        .ADDRESS DEVLABEL+1
        .ADDRESS LABLEN
        .WORD   4, DVI$_FREEBLOCKS
        .ADDRESS DEVFREE
        .LONG   0
        .LONG   0
V_MNT:  .LONG   0                       ; 1 if a volume is mounted,
V_SWL:  .LONG   0                       ; 1 if it is read only,
V_STS:  .LONG   0                       ; UCB$M_ONLINE if the device is there,
V_ERRCNT:                               ; the errors it reported,
        .LONG   0
DEVLABEL:                               ; the volume's label, after a byte,
        .BLKB   13
LABLEN: .WORD   0                       ; its length,
DEVFREE:                                ; and its free blocks
        .LONG   0
S_MOUNTED:
        .ASCIC  "Mounted"
S_WRTLCK:
        .ASCIC  "Mounted wrtlck"
S_ONLINE:
        .ASCIC  "Online"
S_OFFLINE:
        .ASCIC  "Offline"
DOTCLD: .ASCII  ".CLD"
CLDFAB:                                 ; SET COMMAND's
        $FAB    FNA=DCL$TOKEN, DNA=DOTCLD, DNS=4
CLDRAB:
        $RAB    FAB=CLDFAB, USZ=LINESIZE
CLDDSC: .LONG   0                       ; the .CLD file's text, in CLDBUF
        .ADDRESS CLDBUF
PTABDSC:                                ; the room left for tables, in PTABS
        .LONG   0, 0
PTABLEN:                                ; the tables CDU$COMPILE made there
        .WORD   0
PTABFREE:                               ; the room left
        .ADDRESS PTABS
CLDBUF: .BLKB   CLDMAX                  ; the .CLD file, its lines each ending in LF
PTABS:  .BLKB   PTABMAX                 ; the process's command tables
DEFFAB: $FAB    FNA=DCL$TOKEN, DNA=DDIR, NAM=DEFNAM ; SET and SHOW DEFAULT's $PARSE
DEFNAM: $NAM    ESA=EXP, ESS=255
EXP:    .BLKB   255                     ; its expanded string
DIRDSC: .LONG   0, 0                    ; a descriptor of the directory in it
DISK:   .ASCID  "SYS$DISK"
DISKITEMS:                              ; $CRELNM's: the device in EXP
        .WORD   0, LNM$_STRING
        .LONG   0, 0, 0
FILE_DEV:
        .ASCID  "LNM$FILE_DEV"
DISKSTR:                                ; SHOW DEFAULT's $TRNLNM: SYS$DISK's string
        .WORD   LINESIZE, LNM$_STRING
        .ADDRESS SLSTR, SLDSC
        .LONG   0
SLDSC:  .LONG   0                       ; the string, a descriptor
        .ADDRESS SLSTR
SLSTR:  .BLKB   LINESIZE
LISTMAX:                                ; ISLIST's $TRNLNM: a name's last index
        .WORD   4, LNM$_MAX_INDEX
        .ADDRESS ISMAX, 0
        .LONG   0
ISMAX:  .LONG   0
ISDSC:  .LONG   0, 0                    ; the name
DDIRDSC:                                ; the default directory
        .LONG   63
        .ADDRESS DDIR
DDIR:   .BLKB   63
NEWTOK: .BLKB   LINESIZE*2+1            ; TRNDEV's spec, as it makes it
SLFAB:  $FAB    DNA=DDIR, NAM=SLNAM     ; SHOWDIR's $PARSE
SLNAM:  $NAM    ESA=SLEXP, ESS=255
SLEXP:  .BLKB   255                     ; its expanded string
SHOWN:  .LONG   0                       ; the directories SHOWSL showed
; SHOWSL's frame, on the stack: its $TRNLNM's items, their buffers, and
; the name it translates.
F_ITM = 0
F_IDX = 40
F_MAX = 44
F_LEN = 48
F_NDSC = 52
F_ODIR = 60                             ; the directory over its strings
F_NEW = 68                              ; a string, that directory over it
F_STR = F_NEW+LINESIZE+1
FRAME = F_STR+LINESIZE+1

        .PSECT  CODE, EXE, LONG
; DCL$SETDEF, SET DEFAULT spec: $PARSEs spec, which must name no file,
; and makes the directory it expands to the default, with $SETDDIR, and
; its device the process's SYS$DISK. One that doesn't exist is still
; set, as VMS does: SHOW DEFAULT says so. A device that is a search list,
; HOME: for MDA0:[000000],SYS$MANAGER, becomes SYS$DISK as it is, and the
; default directory the spec's, or none, so that each string's own
; directory holds (SEARCHDEF); one that translates to a search list,
; SYS$MANAGER:, becomes it first (TRNDEV).
DCL$SETDEF::
        .EXCEPTION_ENTRY
        MOVAB   V_DIR, R1
        BSBW    DCL$GETVAL
        TSTL    R8
        BNEQ    5$
        BRW     DCL$INSFPRM
5$:     BSBW    GETDDIR                 ; a relative directory is relative to it
        MOVB    DDIRDSC, DEFFAB+FAB$B_DNS
        MOVB    R8, DEFFAB+FAB$B_FNS
        $PARSE  FAB=DEFFAB
        MOVL    R0, R6
        CMPL    R0, #RMS$_DNF
        BEQL    10$
        BLBC    R0, 20$
10$:    MOVL    #RMS$_SYN, R0
        TSTB    DEFNAM+NAM$B_NAME
        BNEQ    20$
        BITL    #NAM$M_SEARCH_LIST, DEFNAM+NAM$L_FNB
        BEQL    15$
        BRW     SEARCHDEF
15$:    MOVZBL  DEFNAM+NAM$B_DIR, DIRDSC
        MOVL    DEFNAM+NAM$L_DIR, DIRDSC+4
        $SETDDIR_S NEWDIR=DIRDSC
        BLBC    R0, 20$
        MOVZBW  DEFNAM+NAM$B_DEV, DISKITEMS
        MOVL    DEFNAM+NAM$L_DEV, DISKITEMS+4
        $CRELNM_S TABNAM=DCL$PROCESS, LOGNAM=DISK, ITMLST=DISKITEMS
20$:    BRW     DCL$DONE

; SEARCHDEF: SET DEFAULT's for a search list, as VMS's: R8 = the length
; of the spec in DCL$TOKEN. SYS$DISK becomes its device as given, up to
; its colon, or all of it and a colon if it is only a logical name, SET
; DEFAULT HOME, and the default directory the expanded one if it gives
; one, made absolute against the old, else stays: SHOW DEFAULT then says
; HOME:[SYSMGR], whose strings' own directories RMS takes before it.
SEARCHDEF:
        BSBW    TRNDEV
        BSBW    HASDIR
        BEQL    20$
        MOVZBL  DEFNAM+NAM$B_DIR, DIRDSC
        MOVL    DEFNAM+NAM$L_DIR, DIRDSC+4
        $SETDDIR_S NEWDIR=DIRDSC
        BLBC    R0, 90$
20$:    LOCC    #^A/:/, R8, DCL$TOKEN
        BEQL    30$
        MOVAB   DCL$TOKEN, R0
        SUBL3   R0, R1, R0              ; up to the colon
        INCL    R0
        BRB     40$
30$:    BSBW    HASDIR                  ; only a directory: SYS$DISK stays
        BNEQ    80$
        MOVB    #^A/:/, DCL$TOKEN[R8]
        ADDL3   #1, R8, R0
40$:    MOVW    R0, DISKITEMS
        MOVAB   DCL$TOKEN, DISKITEMS+4
        $CRELNM_S TABNAM=DCL$PROCESS, LOGNAM=DISK, ITMLST=DISKITEMS
        BLBC    R0, 90$
80$:    BRW     DCL$OK
90$:    BRW     DCL$DONE

; TRNDEV: R8 = the length of a spec in DCL$TOKEN whose device $PARSE
; found a search list behind. As VMS's SET DEFAULT, replaces the device
; with its translation while it is a logical name of one string, until
; it is a search list: SYS$MANAGER: becomes SYS$SYSROOT:[SYSMGR]. A
; directory in the spec wins over the translation's. R8 = the new length.
; Uses R0-R7 and R9.
TRNDEV:
        .JSB_ENTRY  OUTPUT=<R8>, SCRATCH=<R2, R3, R4, R5, R6, R7, R9>
        MOVL    #LNM$C_MAXDEPTH, R9
10$:    MOVL    R8, R0
        MOVAB   DCL$TOKEN, R1
        BSBW    STRDEV                  ; R6, R7: the device
        TSTL    R7
        BEQL    90$
        BSBW    ISLIST                  ; its name to ISDSC
        BLBS    R0, 90$                 ; a search list: done
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=ISDSC, ITMLST=DISKSTR
        BLBC    R0, 90$                 ; not a logical name
        ADDL3   #1, R7, R6              ; the rest, past the colon
        CMPL    R6, R8
        BLEQU   20$
        MOVL    R8, R6
20$:    MOVZWL  SLDSC, R7               ; the translation
        LOCC    #^A/:/, R7, SLSTR
        BEQL    40$                     ; only a name
        SUBL3   R0, R7, R2
        INCL    R2                      ; its device, with the colon
        SUBL3   R6, R8, R4
        MOVAB   DCL$TOKEN[R6], R5
        LOCC    #91, R4, (R5)           ; the rest has a directory: the
        BNEQ    30$                     ; translation's goes
        LOCC    #60, R4, (R5)
        BEQL    35$
30$:    MOVL    R2, R7
35$:    MOVC3   R7, SLSTR, NEWTOK
        BRB     50$
40$:    MOVC3   R7, SLSTR, NEWTOK
        MOVB    #^A/:/, (R3)+
50$:    SUBL3   R6, R8, R0
        MOVC3   R0, DCL$TOKEN[R6], (R3)
        MOVAB   NEWTOK, R0
        SUBL3   R0, R3, R0
        CMPL    R0, #LINESIZE
        BGTRU   90$
        MOVL    R0, R8
        MOVC3   R8, NEWTOK, DCL$TOKEN
        SOBGTR  R9, 10$
90$:    RSB

; HASDIR: R8 = the length of a spec in DCL$TOKEN. Z clear if it has a
; directory, [ or <. Uses R0 and R1.
HASDIR:
        .JSB_ENTRY
        LOCC    #91, R8, DCL$TOKEN
        BNEQ    90$
        LOCC    #60, R8, DCL$TOKEN
90$:    RSB

; GETDDIR: the process's default directory, to DDIR, its length in
; DDIRDSC. Uses R0 and R1.
GETDDIR:
        .JSB_ENTRY
        MOVW    #63, DDIRDSC
        $SETDDIR_S OLDLEN=DDIRDSC, OLDDIR=DDIRDSC
        RSB

; DCL$SETCOMMAND, SET COMMAND file: compiles the command definitions in
; file, file.CLD if it has no type, with CDU$COMPILE, into the process's
; tables in PTABS, which DCL looks for a verb in before DCL$TABLES, the
; last first (ADR-0018).
DCL$SETCOMMAND::
        .EXCEPTION_ENTRY
        MOVAB   DCL$V_FILE, R1
        BSBW    DCL$GETVAL
        TSTL    R8
        BNEQ    5$
        BRW     DCL$INSFPRM
5$:     CMPL    DCL$PTABVEC, #MAXPTAB
        BLSSU   7$
        PRINT   "%CDU-E-TABOVF, command tables full"
        BRW     DCL$WARN
7$:     MOVB    R8, CLDFAB+FAB$B_FNS
        $OPEN   FAB=CLDFAB
        BLBC    R0, 80$
        $CONNECT RAB=CLDRAB
        BLBC    R0, 70$
        MOVAB   CLDBUF, R11             ; where the next line goes
10$:    MOVAB   CLDBUF+CLDMAX-LINESIZE-1, R0
        CMPL    R11, R0
        BLEQU   15$
        MOVL    #RMS$_DME, R0           ; no room
        BRB     70$
15$:    MOVL    R11, CLDRAB+RAB$L_UBF
        $GET    RAB=CLDRAB
        BLBS    R0, 20$
        CMPL    R0, #RMS$_RTB           ; too long: what fits
        BEQL    20$
        CMPL    R0, #RMS$_EOF
        BNEQ    70$
        BRB     30$
20$:    MOVZWL  CLDRAB+RAB$W_RSZ, R0
        ADDL2   R0, R11
        MOVB    #10, (R11)+
        BRB     10$
30$:    $CLOSE  FAB=CLDFAB
        MOVAB   CLDBUF, R0
        SUBL3   R0, R11, CLDDSC
        MOVAB   PTABS+PTABMAX, R0       ; the room left
        SUBL3   PTABFREE, R0, PTABDSC
        MOVL    PTABFREE, PTABDSC+4
        PUSHAW  PTABLEN
        PUSHAQ  PTABDSC
        PUSHAQ  CLDDSC
        CALLS   #3, G^CDU$COMPILE
        BLBC    R0, 80$                 ; reported
        MOVL    DCL$PTABVEC, R1         ; the last first
40$:    TSTL    R1
        BEQL    50$
        MOVL    DCL$PTABVEC[R1], DCL$PTABVEC+4[R1]
        DECL    R1
        BRB     40$
50$:    MOVL    PTABFREE, DCL$PTABVEC+4
        INCL    DCL$PTABVEC
        MOVZWL  PTABLEN, R0             ; the next ones after them, aligned
        ADDL2   #3, R0
        BICL2   #3, R0
        ADDL2   R0, PTABFREE
        BRW     DCL$OK
70$:    PUSHL   R0
        $CLOSE  FAB=CLDFAB
        MOVL    (SP)+, R0
80$:    BRW     DCL$DONE

; DCL$SHOWDEF, SHOW DEFAULT: shows the default device and directory,
; what $PARSE expands an empty specification to, then %DCL-I-INVDEF if
; that directory isn't there. When SYS$DISK is a search list, as VMS
; does: SYS$DISK's string and the default directory,
; SYS$SYSROOT:[SYSMGR], then after "=" each directory the list's strings
; take it to that is there, MDA0:[SYSMGR] (SHOWSL), or %DCL-I-INVDEF if
; none is.
DCL$SHOWDEF::
        .EXCEPTION_ENTRY
        CLRB    DEFFAB+FAB$B_FNS
        CLRB    DEFFAB+FAB$B_DNS
        $PARSE  FAB=DEFFAB
        MOVL    R0, R6
        CMPL    R0, #RMS$_DNF
        BEQL    10$
        BLBC    R0, 20$
10$:    BITL    #NAM$M_SEARCH_LIST, DEFNAM+NAM$L_FNB
        BNEQ    30$
        ADDTEXT "  "
        BSBW    ADDDEF
        BSBW    DCL$SAY
        CMPL    R6, #RMS$_DNF
        BNEQ    15$
        ADDTEXT "%DCL-I-INVDEF, "
        BSBW    ADDDEF
        ADDTEXT " does not exist"
        BSBW    DCL$SAY
15$:    MOVL    #SS$_NORMAL, R0
20$:    BRW     DCL$DONE
30$:    BSBW    GETDDIR
        BLBC    R0, 20$
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=DISK, ITMLST=DISKSTR
        BLBC    R0, 20$
        ADDTEXT "  "
        BSBW    ADDLIST
        BSBW    DCL$SAY
        MOVB    DDIRDSC, SLFAB+FAB$B_DNS
        CLRL    SHOWN
        MOVL    SLDSC, R0
        MOVAB   SLSTR, R1
        BSBW    STRDEV                  ; the list's name
        CLRQ    R2                      ; its strings' directories hold
        MOVL    #LNM$C_MAXDEPTH, R9
        BSBW    SHOWSL
        BLBC    R0, 90$
        TSTL    SHOWN
        BNEQ    80$
        ADDTEXT "%DCL-I-INVDEF, "
        BSBW    ADDLIST
        ADDTEXT " does not exist"
        BSBW    DCL$SAY
80$:    MOVL    #SS$_NORMAL, R0
90$:    BRW     DCL$DONE

; ADDLIST: adds SYS$DISK's string, in SLSTR, and the default directory,
; in DDIR, to the message. Uses R0-R2.
ADDLIST:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVAB   SLSTR, R1
        MOVL    SLDSC, R2
        BSBW    DCL$ADD
        MOVAB   DDIR, R1
        MOVZWL  DDIRDSC, R2
        BRW     DCL$ADD

; SHOWSL: R6 = a logical name, R7 = its length, R2 = the length of a
; directory that goes in place of its strings' own, R3 its address, or 0,
; R9 = how many more names deep it may go. As RMS takes the default
; directory through each of the name's strings, depth first, through
; each logical name a string's device is: shows "  =   dev:[dir]" for
; each directory that is there, and counts them in SHOWN. A string's own
; directory, or one over it, wins over the default. R0 = $TRNLNM's
; status. Uses R0-R5.
SHOWSL:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        PUSHR   #^M<R6, R7, R9, R10, R11>
        SUBL2   #FRAME, SP
        MOVL    SP, R11
        MOVL    #<LNM$_INDEX@16>+4, F_ITM(R11)
        MOVAL   F_IDX(R11), F_ITM+4(R11)
        CLRL    F_ITM+8(R11)
        MOVL    #<LNM$_STRING@16>+LINESIZE, F_ITM+12(R11)
        MOVAB   F_STR(R11), F_ITM+16(R11)
        MOVAW   F_LEN(R11), F_ITM+20(R11)
        MOVL    #<LNM$_MAX_INDEX@16>+4, F_ITM+24(R11)
        MOVAL   F_MAX(R11), F_ITM+28(R11)
        CLRQ    F_ITM+32(R11)
        MOVL    R7, F_NDSC(R11)
        MOVL    R6, F_NDSC+4(R11)
        MOVQ    R2, F_ODIR(R11)
        CLRL    F_IDX(R11)
10$:    CLRW    F_LEN(R11)
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=F_NDSC(R11), ITMLST=F_ITM(R11)
        BLBC    R0, 90$
        BSBW    OVERDIR                 ; the string, in F_NEW
        BLBC    R0, 60$                 ; too long: passed over
        MOVL    R10, R0
        MOVAB   F_NEW(R11), R1
        BSBW    STRDEV
        TSTL    R7
        BEQL    50$
        TSTL    R9
        BEQL    50$
        BSBW    ISNAME
        BLBC    R0, 50$
        CLRQ    R2                      ; its directory goes over the name's
        LOCC    #91, R10, F_NEW(R11)
        BNEQ    20$
        LOCC    #60, R10, F_NEW(R11)
        BEQL    30$
20$:    MOVL    R0, R2
        MOVL    R1, R3
30$:    DECL    R9
        BSBW    SHOWSL
        INCL    R9
        BLBC    R0, 90$
        BRB     60$
50$:    MOVL    R10, R0
        BSBW    SHOWDIR
60$:    INCL    F_IDX(R11)
        CMPL    F_IDX(R11), F_MAX(R11)
        BLEQ    10$
        MOVL    #SS$_NORMAL, R0
90$:    ADDL2   #FRAME, SP
        POPR    #^M<R6, R7, R9, R10, R11>
        RSB

; OVERDIR: R11 = SHOWSL's frame. Copies the string in F_STR to F_NEW,
; with the directory in F_ODIR, if any, in place of its own, after a
; colon: R10 = its length. R0 = 0 if it would be too long. Uses R0-R5.
OVERDIR:
        .JSB_ENTRY  OUTPUT=<R10>, SCRATCH=<R2, R3, R4, R5>
        MOVZWL  F_LEN(R11), R10
        TSTL    F_ODIR(R11)
        BNEQ    10$
        MOVC3   R10, F_STR(R11), F_NEW(R11)
        BRB     80$
10$:    LOCC    #91, R10, F_STR(R11)
        BNEQ    20$
        LOCC    #60, R10, F_STR(R11)
20$:    SUBL2   R0, R10                 ; up to its directory
        ADDL3   R10, F_ODIR(R11), R0
        INCL    R0
        CMPL    R0, #LINESIZE
        BGTRU   90$
        MOVC3   R10, F_STR(R11), F_NEW(R11)
        TSTL    R10
        BEQL    40$
        CMPB    -1(R3), #^A/:/
        BEQL    40$
        MOVB    #^A/:/, (R3)+           ; a name: its colon
40$:    MOVC3   F_ODIR(R11), @F_ODIR+4(R11), (R3)
        MOVAB   F_NEW(R11), R0
        SUBL3   R0, R3, R10
80$:    MOVL    #1, R0
        RSB
90$:    CLRL    R0
        RSB

; SHOWDIR: R11 = SHOWSL's frame, R0 = the length of the string in F_NEW.
; $PARSEs it, with the default directory, and shows the device and
; directory it expands to, "  =   MDA0:[SYSMGR]", if the directory is
; there, counting it in SHOWN. Uses R0-R5.
SHOWDIR:
        .JSB_ENTRY  SCRATCH=<R2, R3, R4, R5>
        MOVB    R0, SLFAB+FAB$B_FNS
        MOVAB   F_NEW(R11), SLFAB+FAB$L_FNA
        $PARSE  FAB=SLFAB
        BLBC    R0, 90$
        ADDTEXT "  =   "
        MOVL    SLNAM+NAM$L_DEV, R1
        MOVZBL  SLNAM+NAM$B_DEV, R2
        ADDB2   SLNAM+NAM$B_DIR, R2
        BSBW    DCL$ADD
        BSBW    DCL$SAY
        INCL    SHOWN
90$:    RSB

; ISLIST: R6 = a name, R7 = its length. R0 = 1 if it is a logical name
; with more than one string, else 0. Uses R0 and R1.
ISLIST:
        .JSB_ENTRY
        BSBB    ISNAME
        BLBC    R0, 80$
        TSTL    ISMAX
        BEQL    80$
        MOVL    #1, R0
        RSB
80$:    CLRL    R0
        RSB

; ISNAME: R6 = a name, R7 = its length. R0 = $TRNLNM's status for it,
; success if it is a logical name, its last index in ISMAX. Uses R0 and
; R1.
ISNAME:
        .JSB_ENTRY
        MOVL    R7, ISDSC
        MOVL    R6, ISDSC+4
        CLRL    ISMAX
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=ISDSC, ITMLST=LISTMAX
        RSB

; STRDEV: R1 = a file specification, R0 = its length. R6 = its device,
; without its colon, R7 = its length: up to a colon, or all of it if it
; is only a name; 0 if it has none or an underscore is before it, which
; RMS wouldn't translate. Uses R0 and R1.
STRDEV:
        .JSB_ENTRY  OUTPUT=<R6, R7>
        MOVL    R1, R6
        CLRL    R7
10$:    CMPL    R7, R0
        BGEQU   40$                     ; only a name
        MOVZBL  (R6)[R7], R1
        CMPB    R1, #^A/:/
        BEQL    40$
        CMPB    R1, #91                 ; [
        BEQL    80$
        CMPB    R1, #60                 ; <
        BEQL    80$
        CMPB    R1, #^A/./
        BEQL    80$
        CMPB    R1, #59                 ; a semicolon
        BEQL    80$
        INCL    R7
        BRB     10$
40$:    TSTL    R7
        BEQL    90$
        CMPB    (R6), #^A/_/
        BNEQ    90$
80$:    CLRL    R7
90$:    RSB

; DCL$SHOWDEV, SHOW DEVICES [name]: lists the disks, with their status,
; error counts and their volumes' labels and free blocks, then the
; terminal, under VMS's headings, or only the devices whose names start
; with name, with * and % wildcards: SHOW DEVICES DK. It finds them with
; $DEVICE_SCAN, a class at a time, and asks each about itself with
; $GETDVIW. SS$_NOSUCHDEV if none matches. With /MOUNTED, only the
; devices with a volume mounted. ponytail: no transactions or mount
; counts, which nothing keeps; no /FULL.
DCL$SHOWDEV::
        .EXCEPTION_ENTRY
        MOVAB   V_MOUNTED, R1
        BSBW    DCL$ISPRES
        BICL3   #^C1, R0, MOUNTED
        MOVAB   V_DEVNAM, R1
        BSBW    DCL$GETVAL
        TSTL    R8                      ; name*, without its colon
        BEQL    5$
        CMPB    DCL$TOKEN-1[R8], #^A/:/
        BNEQ    3$
        DECL    R8
3$:     MOVB    #^A/*/, DCL$TOKEN[R8]
        INCL    R8
5$:     MOVL    R8, PATDSC
        CLRL    R7                      ; the devices listed
        MOVL    #DC$_DISK, DEVCLASS
        BSBB    SCAN
        MOVL    #DC$_TERM, DEVCLASS
        BSBB    SCAN
        MOVL    #SS$_NORMAL, R0
        TSTL    R7
        BNEQ    10$
        MOVL    #SS$_NOSUCHDEV, R0
10$:    BRW     DCL$DONE

; SCAN: lists the devices of DEVCLASS's class whose names match PATDSC's,
; under their headings, if there are any. R7 = how many there were, and
; as many more. Uses R0-R6.
SCAN:
        .JSB_ENTRY  OUTPUT=<R7>, SCRATCH=<R2, R3, R4, R5, R6>
        CLRQ    SCANCTX
        CLRL    R6                      ; 1 once the headings are out
10$:    $DEVICE_SCAN_S RETURN_DEVNAM=DEVDSC, RETLEN=DVINAM, SEARCH_DEVNAM=PATDSC, ITMLST=DVSITEMS, CONTXT=SCANCTX
        BLBC    R0, 90$
        $GETDVIW_S DEVNAM=DVINAM, ITMLST=DVIITEMS
        BLBC    R0, 10$
        TSTL    MOUNTED
        BEQL    12$
        TSTL    V_MNT
        BEQL    10$
12$:    TSTL    R6
        BNEQ    20$
        INCL    R6
        PRINT   ""
        CMPL    DEVCLASS, #DC$_DISK
        BNEQ    15$
        PRINT   "Device                  Device           Error    Volume         Free"
        PRINT   " Name                   Status           Count     Label        Blocks"
        BRB     20$
15$:    PRINT   "Device                  Device           Error"
        PRINT   " Name                   Status           Count"
20$:    INCL    R7
        MOVAB   DEVNAME+1, R1           ; without its underscore
        MOVZWL  DVINAM, R2
        DECL    R2
        BSBW    DCL$ADD
        MOVL    #24, R3
        BSBW    DCL$PADTO
        MOVAB   S_OFFLINE, R1
        BITL    #UCB$M_ONLINE, V_STS
        BEQL    25$
        MOVAB   S_ONLINE, R1
25$:    TSTL    V_MNT
        BEQL    30$
        MOVAB   S_MOUNTED, R1
        TSTL    V_SWL
        BEQL    30$
        MOVAB   S_WRTLCK, R1
30$:    BSBW    DCL$ADDCSTR
        MOVL    #41, R3
        BSBW    DCL$PADTO
        MOVL    V_ERRCNT, R1
        MOVL    #5, R3
        BSBW    DCL$ADDDEC
        TSTL    V_MNT
        BEQL    40$
        ADDTEXT "  "
        MOVAB   DEVLABEL+1, R1
        MOVZWL  LABLEN, R2
        BSBW    DCL$ADD
        MOVL    #62, R3
        BSBW    DCL$PADTO
        MOVL    DEVFREE, R1
        MOVL    #8, R3
        BSBW    DCL$ADDDEC
40$:    BSBW    DCL$SAY
        BRW     10$
90$:    RSB

; ADDDEF: appends the device and directory $PARSE left in DEFNAM to
; DCL$MSG. Uses R0-R2.
ADDDEF:
        .JSB_ENTRY  SCRATCH=<R2>
        MOVL    DEFNAM+NAM$L_DEV, R1
        MOVZBL  DEFNAM+NAM$B_DEV, R2
        ADDB2   DEFNAM+NAM$B_DIR, R2
        BRW     DCL$ADD
