        .TITLE  SVCTEST Checks the system services the other programs don't use
        .IDENT  /V0.1/
;
; Each EXPECT checks a service's status. A failed one exits with 2 * N,
; an error, which the executive reports with the process's name, so the
; status says which.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $IODEF
        $LNMDEF
        $RMSDEF
        .EXTERNAL SYS$SETAST, SYS$EXIT, EXE$GL_RPB

        .PSECT  DATA, NOEXE, WRT, LONG
OTHER_NAME:
        .ASCID  "SVCTEST2"
MY_NAME:
        .ASCID  "SVCTEST"
NAPPER_NAME:
        .ASCID  "NAPPER"
SLEEPER_IMAGE:
        .ASCID  "SLEEPER.EXE"
NOSUCH_NAME:
        .ASCID  "NOSUCH"
NOSUCH_IMAGE:
        .ASCID  "NOSUCH.EXE"
SNOOP_IMAGE:
        .ASCID  "SNOOP.EXE"
SNOOP_NAME:
        .ASCID  "SNOOP"
USURP_IMAGE:
        .ASCID  "USURP.EXE"
USURP_NAME:
        .ASCID  "USURP"
CONSOLE:
        .ASCID  "OPA0:"
STATE:  .LONG   0
PRI:    .LONG   0
CHAN:   .LONG   0
INADR:  .LONG   ^X60000000, ^X60001FFF  ; in P1
LNM_SYSTEM:
        .ASCID  "LNM$SYSTEM"
LNM_PROCESS:
        .ASCID  "LNM$PROCESS"
FILE_DEV:
        .ASCID  "LNM$FILE_DEV"
LNM_JOB:
        .ASCID  "LNM$JOB"
TERM_NAME:
        .ASCID  "SVCTEST_TERM"
OUT_NAME:
        .ASCID  "SVCTEST_OUT"
TERM_ITEMS:                             ; SVCTEST_TERM: the console
        .WORD   6, LNM$_STRING
        .ADDRESS TERM_EQV
        .LONG   0, 0
OUT_ITEMS:                              ; SVCTEST_OUT: SVCTEST_TERM
        .WORD   13, LNM$_STRING
        .ADDRESS OUT_EQV
        .LONG   0, 0
TERM_EQV:
        .ASCII  "_OPA0:"
OUT_EQV:
        .ASCII  "SVCTEST_TERM:"
TRN_ITEMS:                              ; too short a buffer, the length, the table
        .WORD   4, LNM$_STRING
        .ADDRESS BUF, BUFLEN
        .WORD   4, LNM$_LENGTH
        .ADDRESS EQVLEN
        .LONG   0
        .WORD   31, LNM$_TABLE
        .ADDRESS TABBUF, TABLEN
        .LONG   0
LEN_ITEMS:                              ; not one $CRELNM takes
        .WORD   4, LNM$_LENGTH
        .ADDRESS EQVLEN
        .LONG   0, 0
SYS_ITEMS:                              ; a buffer user mode can't write
        .WORD   4, LNM$_STRING
        .ADDRESS EXE$GL_RPB
        .LONG   0, 0
BUF:    .BLKB   4
BUFLEN: .WORD   0
EQVLEN: .LONG   0
TABBUF: .BLKB   31
TABLEN: .WORD   0
SYSTEM: .LONG   ^X40000000, ^X40000FFF  ; S0: not a process's to make
SYSEXE: .ASCID  "[SYSEXE]"
WILDDIR:
        .ASCID  "[SYS*]"
PARENT: .ASCID  "[-]"
OLDDIR: .LONG   63                      ; the default directory it started in:
                                        ; oldlen, its length, overwrites 63
        .ADDRESS OLDBUF
OLDBUF: .BLKB   63
SHORT:  .LONG   4                       ; too short a buffer for one
        .ADDRESS BUF

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2>
        $SETPRN_S PRCNAM=OTHER_NAME
        EXPECT  #SS$_NORMAL, 1
        $SETPRN_S PRCNAM=MY_NAME
        EXPECT  #SS$_NORMAL, 2

; Local event flags.
        $CLREF_S EFN=#3
        EXPECT  #SS$_WASCLR, 3
        $SETEF_S EFN=#3
        EXPECT  #SS$_WASCLR, 4
        $SETEF_S EFN=#3
        EXPECT  #SS$_WASSET, 5
        $READEF_S EFN=#3, STATE=STATE
        EXPECT  #SS$_WASSET, 6
        CMPL    STATE, #^X8
        BNEQ    90$
        $WAITFR_S EFN=#3                ; set: returns at once
        EXPECT  #SS$_NORMAL, 7
        $WFLAND_S EFN=#0, MASK=#^X8
        EXPECT  #SS$_NORMAL, 8
        $WFLOR_S EFN=#0, MASK=#^X18
        EXPECT  #SS$_NORMAL, 9
        $SETEF_S EFN=#128
        EXPECT  #SS$_ILLEFC, 10
        $SETEF_S EFN=#100               ; cluster 3 has no common block
        EXPECT  #SS$_UNASEFC, 11

; The dispatcher: too few arguments, and a stub.
        CALLS   #0, G^SYS$SETAST
        EXPECT  #SS$_INSFARG, 12
        PUSHL   #0
        CALLS   #1, G^SYS$SETAST
        EXPECT  #SS$_ILLSER, 13

; Pages.
        $CRETVA_S INADR=INADR
        EXPECT  #SS$_NORMAL, 14
        MOVL    #^X12345678, @#^X60001FFC
        CMPL    @#^X60001FFC, #^X12345678
        BNEQ    90$
        $DELTVA_S INADR=INADR
        EXPECT  #SS$_NORMAL, 15
        $CRETVA_S INADR=SYSTEM
        EXPECT  #SS$_PAGOWNVIO, 16

; Routines in kernel and executive mode.
        $CMKRNL_S ROUTIN=ANSWER
        EXPECT  #42, 17
        $CMEXEC_S ROUTIN=EXEC_ANSWER
        EXPECT  #43, 28

; User mode may read and write its own data, read but not write the
; system service vector, and do neither to the executive's data. The
; executive won't for it either.
        PROBEW  #0, #4, STATE
        BEQL    90$
        PROBER  #0, #4, G^SYS$EXIT
        BEQL    90$
        PROBEW  #0, #4, G^SYS$EXIT
        BNEQ    90$
        PROBER  #0, #4, G^EXE$GL_RPB
        BNEQ    90$
        $GETTIM_S TIMADR=G^EXE$GL_RPB
        EXPECT  #SS$_ACCVIO, 29
        $ASSIGN_S DEVNAM=CONSOLE, CHAN=CHAN
        EXPECT  #SS$_NORMAL, 30
        $QIOW_S CHAN=CHAN, FUNC=#IO$_WRITEVBLK, P1=G^EXE$GL_RPB, P2=#4
        EXPECT  #SS$_ACCVIO, 31
        $DASSGN_S CHAN=CHAN
        EXPECT  #SS$_NORMAL, 32
        $DASSGN_S CHAN=CHAN
        EXPECT  #SS$_IVCHAN, 33

; Logical names: one in the system's table, and one in the process's that
; translates to it, which $ASSIGN follows to the console. $TRNLNM in
; LNM$FILE_DEV finds the system's after the process's, and fills in as
; much as fits.
        $CRELNM_S TABNAM=LNM_SYSTEM, LOGNAM=TERM_NAME, ITMLST=TERM_ITEMS
        EXPECT  #SS$_NORMAL, 36
        $CRELNM_S TABNAM=LNM_PROCESS, LOGNAM=OUT_NAME, ITMLST=OUT_ITEMS
        EXPECT  #SS$_NORMAL, 37
        $CRELNM_S TABNAM=FILE_DEV, LOGNAM=OUT_NAME, ITMLST=OUT_ITEMS
        EXPECT  #SS$_SUPERSEDE, 38
        $ASSIGN_S DEVNAM=OUT_NAME, CHAN=CHAN
        EXPECT  #SS$_NORMAL, 39
        $DASSGN_S CHAN=CHAN
        EXPECT  #SS$_NORMAL, 40
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=TERM_NAME, ITMLST=TRN_ITEMS
        EXPECT  #SS$_NORMAL, 41
        CMPW    BUFLEN, #4
        BNEQ    90$
        CMPL    BUF, #^A/_OPA/
        BNEQ    90$
        CMPL    EQVLEN, #6
        BNEQ    90$
        CMPW    TABLEN, #16             ; LNM$SYSTEM_TABLE
        BNEQ    90$
        $TRNLNM_S TABNAM=LNM_PROCESS, LOGNAM=TERM_NAME, ITMLST=TRN_ITEMS
        EXPECT  #SS$_NOLOGNAM, 42
        $TRNLNM_S TABNAM=LNM_JOB, LOGNAM=TERM_NAME, ITMLST=TRN_ITEMS
        EXPECT  #SS$_NOLOGTAB, 43
        $TRNLNM_S TABNAM=FILE_DEV, LOGNAM=TERM_NAME, ITMLST=SYS_ITEMS
        EXPECT  #SS$_ACCVIO, 44
        $CRELNM_S TABNAM=LNM_PROCESS, LOGNAM=OUT_NAME, ITMLST=LEN_ITEMS
        EXPECT  #SS$_BADPARAM, 45
        $DELLNM_S TABNAM=LNM_SYSTEM, LOGNAM=TERM_NAME
        EXPECT  #SS$_NORMAL, 46
        $ASSIGN_S DEVNAM=OUT_NAME, CHAN=CHAN    ; SVCTEST_TERM: isn't a device
        EXPECT  #SS$_NOSUCHDEV, 47
        $DELLNM_S TABNAM=LNM_PROCESS, LOGNAM=OUT_NAME
        EXPECT  #SS$_NORMAL, 48
        $DELLNM_S TABNAM=LNM_PROCESS, LOGNAM=OUT_NAME
        EXPECT  #SS$_NOLOGNAM, 49

; The default directory: set [SYSEXE], keeping the old one; one with a
; wildcard isn't one, nor a relative one; read back as much as fits; set the old one again.
        $SETDDIR_S NEWDIR=SYSEXE, OLDLEN=OLDDIR, OLDDIR=OLDDIR
        EXPECT  #RMS$_NORMAL, 50
        $SETDDIR_S NEWDIR=WILDDIR
        EXPECT  #RMS$_DIR, 51
        $SETDDIR_S NEWDIR=PARENT        ; relative: $PARSE's to resolve
        EXPECT  #RMS$_DIR, 54
        $SETDDIR_S OLDLEN=BUFLEN, OLDDIR=SHORT
        EXPECT  #RMS$_NORMAL, 52
        CMPW    BUFLEN, #4
        BNEQ    90$
        CMPL    BUF, #^X5359535B        ; "[SYS"
        BNEQ    90$
        $SETDDIR_S NEWDIR=OLDDIR
        EXPECT  #RMS$_NORMAL, 53

; Other processes: lower this one's priority below NAPPER's so it runs
; and hibernates; suspend it while it does, so that $WAKE leaves it
; suspended; resume it, and delete it.
        $CREPRC_S IMAGE=SLEEPER_IMAGE, PRCNAM=NAPPER_NAME, BASPRI=#4
        EXPECT  #SS$_NORMAL, 18
        $CREPRC_S IMAGE=SLEEPER_IMAGE, PRCNAM=NAPPER_NAME, BASPRI=#4
        EXPECT  #SS$_DUPLNAM, 19
        $SETPRI_S PRI=#2, PRVPRI=PRI
        EXPECT  #SS$_NORMAL, 20
        CMPL    PRI, #4
        BNEQ    90$
        $SETPRI_S PRI=#4
        EXPECT  #SS$_NORMAL, 21
        $SUSPND_S PRCNAM=NAPPER_NAME
        EXPECT  #SS$_NORMAL, 22
        $WAKE_S PRCNAM=NAPPER_NAME
        EXPECT  #SS$_NORMAL, 23
        $RESUME_S PRCNAM=NAPPER_NAME
        EXPECT  #SS$_NORMAL, 24
        $DELPRC_S PRCNAM=NAPPER_NAME
        EXPECT  #SS$_NORMAL, 25
        $WAKE_S PRCNAM=NAPPER_NAME
        EXPECT  #SS$_NONEXPR, 26
; A process whose image isn't there: it exits with RMS$_FNF, which
; the executive reports.
        $CREPRC_S IMAGE=NOSUCH_IMAGE, PRCNAM=NOSUCH_NAME, BASPRI=#4
        EXPECT  #SS$_NORMAL, 27
; Processes that break the rules of user mode: each exits with the
; exception's status, which the executive reports.
        $CREPRC_S IMAGE=SNOOP_IMAGE, PRCNAM=SNOOP_NAME, BASPRI=#4
        EXPECT  #SS$_NORMAL, 34
        $CREPRC_S IMAGE=USURP_IMAGE, PRCNAM=USURP_NAME, BASPRI=#4
        EXPECT  #SS$_NORMAL, 35
        PRINT   "SVCTEST: ok"
        MOVL    #SS$_NORMAL, R0
        RET
90$:    MOVL    #SS$_ABORT, R0
        RET

; ANSWER: in kernel mode, where MFPR isn't a reserved instruction.
        .ENTRY  ANSWER, ^M<>
        MFPR    #18, R0                 ; PR$_IPL
        MOVL    #42, R0
        RET

; EXEC_ANSWER: in executive mode, on the executive stack.
        .ENTRY  EXEC_ANSWER, ^M<>
        MOVL    #43, R0
        RET

        .END    START
