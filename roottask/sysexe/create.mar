        .TITLE  CREATE  Makes directories
        .IDENT  /V0.1/
;
; DCL's CREATE/DIRECTORY spec runs this: $CREATE_DIR makes the
; directory, [dev:][dir.dir...], and those above it that aren't there.
; Returns its status: SS$_CREATED, or SS$_NORMAL if the directory was
; there already.
; ponytail: one directory; CREATE without /DIRECTORY, which makes a file
; on VMS, is %CREATE-E-NOTDIR and SS$_BADPARAM.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF

INHIB = ^X10000000                      ; STS$M_INHIB_MSG: reported already

        .PSECT  DATA, NOEXE, WRT, LONG
SPEC:   .LONG   255                     ; FILE, the parameter
        .ADDRESS SPECBUF
SPECBUF:
        .BLKB   255

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<>
        PRESENT "DIRECTORY"
        BLBS    R0, 10$
        PRINT   "%CREATE-E-NOTDIR, only CREATE/DIRECTORY makes anything yet"
        MOVL    #SS$_BADPARAM!INHIB, R0
        RET
10$:    GETVALUE "FILE", SPEC, SPEC
        $CREATE_DIR_S DEVDIRSPEC=SPEC
        RET

        .END    START
