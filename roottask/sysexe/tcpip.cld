! TCPIP.CLD: TCP/IP Services' management commands, which TCPIP.EXE parses
! with CLI$DCL_PARSE, after DCL's TCPIP verb or at its TCPIP> prompt, and
! which build.rs links into TCPIP.EXE as TCPIP_TABLES. WE0 is the one
! interface.
module TCPIP_TABLES

define verb EXIT
	routine EXIT

! HELP [command]: describes the commands, from these tables.
define verb HELP
	routine HELP
	parameter P1, label=TOPIC, value(type=$rest_of_line)

! PING host [/NUMBER_PACKETS=n]: an ICMP echo request to the host, an
! address or a name in the hosts database, each second, until CTRL/C, or
! n of them.
define verb PING
	routine PING
	parameter P1, label=HOST, prompt="Host", value(required)
	qualifier NUMBER_PACKETS, nonnegatable, value(required)

define verb SET
	parameter P1, label=OPTION, prompt="What", value(required, type=SET_OPTIONS)

define type SET_OPTIONS
	keyword CONFIGURATION, syntax=SET_CONFIGURATION
	keyword HOST, syntax=SET_HOST
	keyword INTERFACE, syntax=SET_INTERFACE
	keyword NOHOST, syntax=SET_NOHOST
	keyword ROUTE, syntax=SET_ROUTE

! SET HOST host /ADDRESS=address [/ALIAS=(alias,...)]: adds the host to
! the hosts database, TCPIP$HOST.DAT.
define syntax SET_HOST
	routine SET_HOST
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=NAME, prompt="Host", value(required)
	qualifier ADDRESS, nonnegatable, value(required)
	qualifier ALIAS, nonnegatable, value(required, list)
	disallow not ADDRESS

! SET NOHOST host [/NOCONFIRM]: takes the host, and its aliases, out of
! the hosts database, each that has the name, after asking unless
! /NOCONFIRM.
define syntax SET_NOHOST
	routine SET_NOHOST
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=NAME, prompt="Host", value(required)
	qualifier CONFIRM, default

! SET INTERFACE WE0 /HOST=address /NETWORK_MASK=mask, or /DHCP: the
! running system.
define syntax SET_INTERFACE
	routine SET_INTERFACE
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=INTERFACE, prompt="Interface", value(required)
	qualifier DHCP, nonnegatable
	qualifier HOST, nonnegatable, value(required)
	qualifier NETWORK_MASK, nonnegatable, value(required)
	disallow DHCP and (HOST or NETWORK_MASK)
	disallow not DHCP and not (HOST and NETWORK_MASK)

! SET CONFIGURATION INTERFACE WE0 /HOST=address /NETWORK_MASK=mask, or
! /DHCP: the saved configuration, which START COMMUNICATION applies.
define syntax SET_CONFIGURATION
	routine SET_CONFIGURATION
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	parameter P2, label=COMPONENT, prompt="Component", value(required, type=CONFIGURATION_OPTIONS)
	parameter P3, label=INTERFACE, prompt="Interface", value(required)
	qualifier DHCP, nonnegatable
	qualifier HOST, nonnegatable, value(required)
	qualifier NETWORK_MASK, nonnegatable, value(required)
	disallow DHCP and (HOST or NETWORK_MASK)
	disallow not DHCP and not (HOST and NETWORK_MASK)

define type CONFIGURATION_OPTIONS
	keyword INTERFACE

! SET ROUTE /DEFAULT /GATEWAY=address: the default route, the only one;
! /PERMANENT saves it instead.
define syntax SET_ROUTE
	routine SET_ROUTE
	parameter P1, label=OPTION, value(required, type=SET_OPTIONS)
	qualifier DEFAULT, nonnegatable
	qualifier GATEWAY, nonnegatable, value(required)
	qualifier PERMANENT, nonnegatable
	disallow not DEFAULT or not GATEWAY

define verb SHOW
	parameter P1, label=OPTION, prompt="What", value(required, type=SHOW_OPTIONS)

define type SHOW_OPTIONS
	keyword HOST, syntax=SHOW_HOST
	keyword INTERFACE, syntax=SHOW_INTERFACE

! SHOW HOST [host] [/ADDRESS=address] [/LOCAL]: the hosts in the hosts
! database, or the one with that name, alias or address.
define syntax SHOW_HOST
	routine SHOW_HOST
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=NAME
	qualifier ADDRESS, nonnegatable, value(required)
	qualifier LOCAL, nonnegatable
	disallow NAME and ADDRESS

define syntax SHOW_INTERFACE
	routine SHOW_INTERFACE
	parameter P1, label=OPTION, value(required, type=SHOW_OPTIONS)
	parameter P2, label=INTERFACE

! START COMMUNICATION: the saved configuration, or DHCP, and the remote login
! server, as SYLOGIN.COM does at boot.
define verb START
	routine START_COMMUNICATION
	parameter P1, label=OPTION, prompt="What", value(required, type=START_OPTIONS)

define type START_OPTIONS
	keyword COMMUNICATION
