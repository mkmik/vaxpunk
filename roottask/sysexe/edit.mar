        .TITLE  EDIT    The EDT editor: line mode and keypad mode
        .IDENT  /V0.2/
;
; DCL's EDIT spec runs this, with spec, in capitals, as its command line
; at VA$C_FOREIGN. As EDT does in line mode, it reads the file spec names,
; in the default directory unless it says where, with RMS, into its buffer, types
; the first line and prompts with * for a command:
;
;   range       types the lines range names
;   TYPE [range]
;               the same, the current line if there is no range
;   (RETURN)    moves to the next line and types it
;   INSERT [range]
;               inserts the lines typed next, up to a CTRL/Z, before
;               the range's first line, the current line if there is no range
;   DELETE [range]
;               deletes the lines
;   REPLACE [range]
;               deletes the lines, then inserts as INSERT does
;   CHANGE      edits the buffer on the screen, keypad mode, until CTRL/Z
;   EXIT        writes the buffer to a new version of the file, and ends
;               the session
;   QUIT        ends the session without writing
;   HELP        lists the commands
;
; A range is a line, or two with a colon between them: a number, . the
; current line, BEGIN the first, END the end of the buffer, "text" or
; 'text' the next line with text in it, -"text" the last one before, case
; ignored;
; or WHOLE, every line, or REST, the current line and those after. The
; last line typed becomes the current line. A line is typed after its
; number, and the end of the buffer as [EOB]. After an INSERT the current
; line is the one the lines went before, after a DELETE the one after
; those deleted. EXIT writes variable length records with carriage
; return control, as EDT does, and types the new file's name; if RMS
; can't, it types its status and the session goes on.
; Keypad mode, on a VT100, shows ROWS lines around the current one and
; reads a key at a time (IO$M_NOFILTR): a character goes in at the
; cursor, RETURN breaks the line, DEL deletes the character before, BS
; goes to the start of the line, the arrows move, CTRL/W paints the
; screen again and CTRL/Z goes back to line mode. The keypad, or F1-F4 for
; PF1-PF4, is EDT's: PF1 GOLD, PF2 HELP, PF3 FINDNXT, GOLD PF3 FIND, PF4
; DEL L, comma DEL C, 0 LINE, 2 EOL, 3 CHAR, 4 ADVANCE, 5 BACKUP, GOLD 4
; BOTTOM, GOLD 5 TOP, 8 SECT, and PREV and NEXT SCREEN a section back and
; on.
; ponytail: a VT100's 24 by 80 screen, whatever the terminal's size;
; lines of at most LINESIZE characters, MAXLINES of them, shown up to
; COLS with a tab as a space; no SUBSTITUTE, MOVE, COPY or WRITE in line
; mode, no WORD, PAGE, SELECT, CUT or UNDELETE in keypad mode, and a
; backward FIND finds the first match on a line, not the last. At most
; TEXTSIZE bytes; only keypad mode takes back the room of lines deleted
; or changed.
;
        .LIBRARY "lib.mlb"
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $VADEF
        $SSDEF
        $IODEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $NAMDEF

        .EXTERNAL PUT_LINE

LINESIZE = 255
MAXLINES = 2000
TEXTSIZE = 65536
ROWS = 22                               ; keypad mode's text rows; messages on MSGROW
MSGROW = 24
COLS = 80
SECTION = 16                            ; the lines SECT moves
RESERVE = 1024                          ; the room a change may take in TEXT
SBUFSIZE = 4096
ESC = 27
; Keys, as GETKEY returns them; GOLD adds K_GOLD to the cursor and keypad keys.
K_UP = 256                              ; to K_UP+3: up, down, right, left, as ESC [ A-D
K_PF1 = 260                             ; to K_PF1+3, ESC O P-S
K_KP0 = 264                             ; to K_KP0+9, ESC O p-y
K_PREV = 274                            ; PREV SCREEN, ESC [ 5 ~
K_NEXT = 275                            ; NEXT SCREEN, ESC [ 6 ~
K_COMMA = 276                           ; ESC O l
K_GOLD = 32

        .PSECT  DATA, NOEXE, WRT, LONG
FAB:    $FAB    FNA=VA$C_FOREIGN+1, NAM=NAM
NAM:    $NAM    RSA=RES, RSS=255
RAB:    $RAB    FAB=FAB, USZ=LINESIZE
OUTFAB: $FAB    FNA=VA$C_FOREIGN+1
OUTRAB: $RAB    FAB=OUTFAB
RES:    .BLKB   255                     ; the file's name, once opened
CHAN:   .LONG   0                       ; OPA0:'s, once assigned
OPA0:   .ASCID  "OPA0:"
PROMPT: .ASCII  "*"
TAB:    .ASCII  <9>                     ; INSERT's prompt
IOSB:   .BLKQ   1
CMD:    .BLKB   LINESIZE                ; the command line
TOKEN:  .BLKB   LINESIZE                ; a word of it, in capitals
OUT:    .BLKB   256                     ; a line being typed, .ASCIC
NLINES: .LONG   0                       ; the lines in the buffer
CUR:    .LONG   1                       ; the current line, NLINES+1 at [EOB]
FREE:   .ADDRESS TEXT                   ; the arena's first unused byte
V_TYPE: .ASCIC  "TYPE"
V_INSERT:
        .ASCIC  "INSERT"
V_DELETE:
        .ASCIC  "DELETE"
V_REPLACE:
        .ASCIC  "REPLACE"
V_EXIT: .ASCIC  "EXIT"
V_QUIT: .ASCIC  "QUIT"
V_HELP: .ASCIC  "HELP"
V_CHANGE:
        .ASCIC  "CHANGE"
K_BEGIN:
        .ASCIC  "BEGIN"
K_END:  .ASCIC  "END"
K_WHOLE:
        .ASCIC  "WHOLE"
K_REST: .ASCIC  "REST"
E_CMD:  .ASCIC  "Unrecognized command"
E_FIND: .ASCIC  "String was not found"
E_RANGE:
        .ASCIC  "Invalid range"
E_FULL: .ASCIC  "Buffer is full"
E_LONG: .ASCIC  "Line too long"
E_NOSTR:
        .ASCIC  "No search string"
E_KEYS: .ASCIC  "PF1 GOLD PF3 FINDNXT G-PF3 FIND PF4 DEL L , DEL C 4/5 ADV/BACK G-4/5 BOT/TOP"
S_ENTER:
        .ASCIC  <ESC>"="<ESC>"[2J"     ; keypad application mode, a clear screen
S_LEAVE:
        .ASCIC  <ESC>">"<ESC>"[24;1H"<ESC>"[K"
S_EOL:  .ASCIC  <ESC>"[K"
S_EOB:  .ASCIC  "[EOB]"
S_FIND: .ASCII  <ESC>"[24;1H"<ESC>"[KSearch for: "
S_FINDLEN = .-S_FIND
EMPTY:  .BYTE   0                       ; an empty line, .ASCIC
KEY:    .BLKB   1                       ; a key read in keypad mode
STR:    .BLKB   LINESIZE                ; what FIND looks for
OPEN:   .BLKB   LINESIZE+1              ; the line being changed, .ASCIC
        .ALIGN  LONG
STRLEN: .LONG   0
OPENED: .LONG   0                       ; that line, LINES[OPENED] = OPEN, or 0
ORIG:   .LONG   0                       ; its old copy, which it goes back to if it fits
COL:    .LONG   0                       ; the cursor's column, past the end after up or down
TOP:    .LONG   1                       ; the line on the first row
DIR:    .LONG   1                       ; 1 after ADVANCE, -1 after BACKUP
GOLD:   .LONG   0                       ; 1: PF1 came before this key
PAINT:  .LONG   0                       ; what to paint: bit 0 the current line, 1 the screen
MSGON:  .LONG   0                       ; 1: a message is on MSGROW
MCOL:   .LONG   0                       ; the column MATCH found the text at
SLEN:   .LONG   0                       ; the bytes in SBUF
SBUF:   .BLKB   SBUFSIZE                ; what keypad mode writes, until FLUSH
        .ALIGN  LONG
BASE:   .ADDRESS TEXT                   ; the arena the lines are in, TEXT or TEXT2
LIMIT:  .ADDRESS TEXT+TEXTSIZE          ; its end
LINES:  .BLKL   MAXLINES+1              ; LINES[n]: line n, .ASCIC in BASE's arena
TEXT:   .BLKB   TEXTSIZE
TEXT2:  .BLKB   TEXTSIZE                ; the other arena, which COMPACT copies to

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        $ASSIGN_S DEVNAM=OPA0, CHAN=CHAN
        BLBC    R0, QUIT
        BSBW    LOAD
        BLBC    R0, QUIT
        MOVL    CUR, R1
        BSBW    SHOW
NEXT:   $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=CMD, P2=#LINESIZE, P5=#PROMPT, P6=#1
        BLBC    R0, QUIT
        MOVAB   CMD, R6
        MOVZWL  IOSB+2, R7
        ADDL2   R6, R7                  ; past the line
        BSBW    BLANKS
        CMPL    R6, R7
        BLSSU   10$
        CMPL    CUR, NLINES             ; RETURN: the next line
        BGTRU   5$
        INCL    CUR
5$:     MOVL    CUR, R1
        BSBW    SHOW
        BRB     NEXT
10$:    MOVL    R6, R9                  ; a range, unless it is a verb
        BSBW    WORD
        TSTL    R8
        BEQL    TYPE1
        MOVAB   V_TYPE, R1
        BSBW    VERB
        BLBS    R0, TYPE
        MOVAB   V_INSERT, R1
        BSBW    VERB
        BLBS    R0, INSERT
        MOVAB   V_DELETE, R1
        BSBW    VERB
        BLBS    R0, DELETE
        MOVAB   V_REPLACE, R1
        BSBW    VERB
        BLBS    R0, REPLACE
        MOVAB   V_EXIT, R1
        BSBW    VERB
        BLBS    R0, EXIT
        MOVAB   V_QUIT, R1
        BSBW    VERB
        BLBS    R0, QUIT1
        MOVAB   V_HELP, R1
        BSBW    VERB
        BLBS    R0, HELP
        MOVAB   V_CHANGE, R1
        BSBW    VERB
        BLBC    R0, TYPE1
        BSBW    SCREEN
        BRW     NEXT
TYPE1:  MOVL    R9, R6
TYPE:   BSBW    RANGE
        BLBC    R0, ERROR
        MOVL    R2, R10
10$:    MOVL    R10, R1
        BSBW    SHOW
        AOBLEQ  R3, R10, 10$
        MOVL    R3, CUR
        BRW     NEXT
INSERT: BSBW    RANGE
        BLBC    R0, ERROR
        MOVL    R2, CUR
        BRB     ADD1
REPLACE:
        BSBW    RANGE
        BLBC    R0, ERROR
        BSBW    REMOVE
ADD1:   BSBW    ADD
        BRW     NEXT
DELETE: BSBW    RANGE
        BLBC    R0, ERROR
        BSBW    REMOVE
        BRW     NEXT
EXIT:   BSBW    SAVE
        BLBS    R0, QUIT1
        PRINTHEX "Unable to write the file, status ", R0
        BRW     NEXT
QUIT1:  MOVL    #SS$_NORMAL, R0
QUIT:   RET

ERROR:  PUSHL   R1
        CALLS   #1, G^PUT_LINE
        BRW     NEXT

HELP:   PRINT   "  range       types the lines range names"
        PRINT   "  TYPE [range]"
        PRINT   "              the same, the current line if there is no range"
        PRINT   "  (RETURN)    moves to the next line and types it"
        PRINT   "  INSERT [range]"
        PRINT   "              inserts lines, up to a CTRL/Z, before the range"
        PRINT   "  DELETE [range]"
        PRINT   "              deletes the lines"
        PRINT   "  REPLACE [range]"
        PRINT   "              deletes the lines, then inserts"
        PRINT   "  CHANGE      edits on the screen until CTRL/Z, PF2 there lists keys"
        PRINT   "  EXIT        writes a new version of the file, and ends"
        PRINT   "  QUIT        ends without writing"
        PRINT   "  HELP        lists the commands"
        PRINT   "A range is a line, or two with a colon between them: a number,"
        PRINT   ". the current line, BEGIN, END, 'text' the next line with text"
        PRINT   "in it, -'text' the last one before; or WHOLE, or REST."
        BRW     NEXT

; LOAD: reads the file the command line names into the buffer, a record a
; line, up to MAXLINES of them and TEXTSIZE bytes. A file that doesn't
; exist leaves it empty. R0 = SS$_NORMAL, or RMS's error. Uses R0-R5.
LOAD:   MOVB    @#VA$C_FOREIGN, FAB+FAB$B_FNS
        $OPEN   FAB=FAB
        BLBS    R0, 10$
        CMPL    R0, #RMS$_FNF
        BNEQ    90$
        PRINT   "Input file does not exist"
        MOVL    #SS$_NORMAL, R0
        RSB
10$:    $CONNECT RAB=RAB
        BLBC    R0, 80$
20$:    CMPL    NLINES, #MAXLINES
        BGEQU   60$
        SUBL3   FREE, LIMIT, R0
        CMPL    R0, #LINESIZE+1
        BLSSU   60$
        ADDL3   #1, FREE, RAB+RAB$L_UBF
        $GET    RAB=RAB
        BLBS    R0, 30$
        CMPL    R0, #RMS$_RTB           ; too long: what fits
        BEQL    30$
        CMPL    R0, #RMS$_EOF
        BNEQ    80$
        MOVL    #SS$_NORMAL, R0
        BRB     80$
30$:    INCL    NLINES
        MOVL    NLINES, R1
        MOVL    FREE, LINES[R1]
        MOVZWL  RAB+RAB$W_RSZ, R0
        MOVB    R0, @FREE
        INCL    R0
        ADDL2   R0, FREE
        BRB     20$
60$:    PRINT   "The file is too long: the buffer has its first lines"
        MOVL    #SS$_NORMAL, R0
80$:    PUSHL   R0
        $CLOSE  FAB=FAB
        MOVL    (SP)+, R0
90$:    RSB

; ADD: reads lines from the console, each after a tab, up to a CTRL/Z,
; and inserts them before the current line, while the buffer has room.
; The current line stays the one they went before. Uses R0-R5 and R10.
ADD:    MOVL    CUR, R10
10$:    CMPL    NLINES, #MAXLINES
        BGEQU   80$
        SUBL3   FREE, LIMIT, R0
        CMPL    R0, #LINESIZE+1
        BLSSU   80$
        ADDL3   #1, FREE, R0
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=(R0), P2=#LINESIZE, P5=#TAB, P6=#1
        BLBC    R0, 90$
        CMPB    IOSB+4, #26             ; CTRL/Z
        BEQL    90$
        SUBL3   R10, NLINES, R0         ; LINES[R10] on up, one up
        INCL    R0
        MULL2   #4, R0
        MOVAL   LINES[R10], R1
        MOVC3   R0, (R1), 4(R1)
        MOVL    FREE, LINES[R10]
        MOVZWL  IOSB+2, R0
        MOVB    R0, @FREE
        INCL    R0
        ADDL2   R0, FREE
        INCL    NLINES
        INCL    R10
        BRB     10$
80$:    PRINT   "The buffer is full"
90$:    MOVL    R10, CUR
        RSB

; REMOVE: R2 = a line, R3 = a line after it, 1 to NLINES+1. Deletes them,
; but [EOB], and the current line is then the one after. Uses R0-R5.
REMOVE: MOVL    R2, CUR
        CMPL    R3, NLINES
        BLEQU   10$
        MOVL    NLINES, R3
10$:    SUBL3   R2, R3, R4              ; the lines, less one
        BLSS    90$
        SUBL3   R3, NLINES, R0          ; those after them, down
        MULL2   #4, R0
        SUBL2   R4, NLINES
        DECL    NLINES
        MOVAL   LINES+4[R3], R1
        MOVAL   LINES[R2], R3
        MOVC3   R0, (R1), (R3)
90$:    RSB

; SAVE: creates a new version of the file, the version LOAD opened or
; else the one the command line names, and writes the buffer to it, a
; record a line. Types its name. R0 = RMS$_NORMAL or RMS's error. Uses
; R0-R5 and R10.
SAVE:   MOVZBL  NAM+NAM$B_RSL, R0
        BEQL    10$
        MOVAB   RES, OUTFAB+FAB$L_FNA   ; its name, without the version
        SUBL3   #RES, NAM+NAM$L_VER, R0
        MOVB    R0, OUTFAB+FAB$B_FNS
        BRB     20$
10$:    MOVB    @#VA$C_FOREIGN, OUTFAB+FAB$B_FNS
20$:    MOVB    #FAB$C_VAR, OUTFAB+FAB$B_RFM
        MOVB    #FAB$M_CR, OUTFAB+FAB$B_RAT
        MOVAB   NAM, OUTFAB+FAB$L_NAM   ; its new name, in RES
        $CREATE FAB=OUTFAB
        BLBC    R0, 90$
        $CONNECT RAB=OUTRAB
        BLBC    R0, 80$
        MOVL    #1, R10
30$:    CMPL    R10, NLINES
        BGTRU   70$
        MOVL    LINES[R10], R0
        MOVZBW  (R0)+, OUTRAB+RAB$W_RSZ
        MOVL    R0, OUTRAB+RAB$L_RBF
        $PUT    RAB=OUTRAB
        BLBC    R0, 80$
        INCL    R10
        BRB     30$
70$:    MOVZBL  NAM+NAM$B_RSL, R0
        MOVB    R0, OUT
        MOVC3   R0, RES, OUT+1
        PUSHAB  OUT
        CALLS   #1, G^PUT_LINE
        MOVL    #RMS$_NORMAL, R0
80$:    PUSHL   R0
        $CLOSE  FAB=OUTFAB
        MOVL    (SP)+, R0
90$:    RSB

; SHOW: R1 = a line, 1 to NLINES+1. Types it after its number, or [EOB]
; past the last. Uses R0 and R1.
SHOW:   CMPL    R1, NLINES
        BLEQU   10$
        PRINT   "[EOB]"
        RSB
10$:    PUSHR   #^M<R2, R3, R4, R5>
        MOVL    R1, R2
        MOVL    #5, R3                  ; the number, in OUT+1 to OUT+5
20$:    DIVL3   #10, R2, R4
        MULL3   #10, R4, R5
        SUBL3   R5, R2, R5
        ADDB3   #^A/0/, R5, OUT[R3]
        DECL    R3
        MOVL    R4, R2
        BNEQ    20$
30$:    TSTL    R3
        BEQL    40$
        MOVB    #^A/ /, OUT[R3]
        DECL    R3
        BRB     30$
40$:    MOVB    #9, OUT+6
        MOVL    LINES[R1], R0
        MOVZBL  (R0)+, R2
        CMPL    R2, #255-6
        BLEQU   50$
        MOVL    #255-6, R2              ; what fits
50$:    ADDB3   #6, R2, OUT
        MOVC3   R2, (R0), OUT+7
        PUSHAB  OUT
        CALLS   #1, G^PUT_LINE
        POPR    #^M<R2, R3, R4, R5>
        RSB

; RANGE: R6 = the next character of the command, R7 = past its last.
; Reads a range, the current line if the command ends here, up to the end
; of the command. R0 = 1, R2 = its first line and R3 its last, 1 to
; NLINES+1, or R0 = 0 and R1 = an error message, .ASCIC. Uses R0-R5, R8
; and R9.
RANGE:  BSBW    BLANKS
        MOVL    CUR, R2
        MOVL    CUR, R3
        CMPL    R6, R7
        BGEQU   80$
        MOVL    R6, R9
        BSBW    WORD
        MOVAB   K_WHOLE, R1
        BSBW    KEYWORD
        BLBC    R0, 10$
        MOVL    #1, R2
        BRB     15$
10$:    MOVAB   K_REST, R1
        BSBW    KEYWORD
        BLBC    R0, 20$
        MOVL    CUR, R2
15$:    ADDL3   #1, NLINES, R3
        BRB     60$
20$:    MOVL    R9, R6
        BSBW    LINE
        BLBC    R0, 90$
        MOVL    R1, R2
        MOVL    R1, R3
        BSBW    BLANKS
        CMPL    R6, R7
        BGEQU   80$
        CMPB    (R6), #^A/:/
        BNEQ    60$
        INCL    R6
        BSBW    LINE
        BLBC    R0, 90$
        MOVL    R1, R3
60$:    BSBW    BLANKS
        MOVAB   E_CMD, R1
        CLRL    R0
        CMPL    R6, R7
        BLSSU   90$
        MOVAB   E_RANGE, R1
        CMPL    R2, R3
        BGTRU   90$
80$:    MOVL    #1, R0
90$:    RSB

; LINE: R6 = the next character of the command, R7 = past its last.
; Reads a line: a number, ., BEGIN, END, "text" or -"text". R0 = 1 and
; R1 = the line, 1 to NLINES+1, or R0 = 0 and R1 = an error message,
; .ASCIC. Uses R0, R1, R6, R8.
LINE:   PUSHR   #^M<R2, R3, R4, R5>
        BSBW    BLANKS
        MOVAB   E_CMD, R1
        CLRL    R0
        CMPL    R6, R7
        BGEQU   90$
        CMPB    (R6), #^A/./
        BNEQ    10$
        INCL    R6
        MOVL    CUR, R1
        BRB     80$
10$:    BSBW    QUOTE
        BLBC    R0, 20$
        BSBW    STRING
        MOVL    CUR, R1                 ; forwards, from the next line
12$:    CMPL    R1, NLINES
        BGEQU   70$
        INCL    R1
        CLRL    R0
        BSBW    MATCH
        BLBS    R0, 80$
        BRB     12$
20$:    CMPB    (R6), #^A/-/
        BNEQ    30$
        INCL    R6
        CMPL    R6, R7
        BGEQU   90$
        BSBW    QUOTE
        BLBC    R0, 90$
        BSBW    STRING
        MOVL    CUR, R1                 ; backwards, from the one before
22$:    CMPL    R1, #1
        BLEQU   70$
        DECL    R1
        CLRL    R0
        BSBW    MATCH
        BLBS    R0, 80$
        BRB     22$
30$:    CMPB    (R6), #^A/0/
        BLSSU   50$
        CMPB    (R6), #^A/9/
        BGTRU   50$
        CLRL    R1                      ; a number: the first line from it on
35$:    CMPL    R6, R7
        BGEQU   40$
        CMPB    (R6), #^A/0/
        BLSSU   40$
        CMPB    (R6), #^A/9/
        BGTRU   40$
        MOVZBL  (R6)+, R0
        CMPL    R1, #MAXLINES+1
        BGTRU   35$
        SUBL2   #^A/0/, R0
        MULL2   #10, R1
        ADDL2   R0, R1
        BRB     35$
40$:    TSTL    R1
        BNEQ    45$
        MOVL    #1, R1
45$:    ADDL3   #1, NLINES, R0
        CMPL    R1, R0
        BLEQU   80$
        MOVL    R0, R1
        BRB     80$
50$:    BSBW    WORD                    ; BEGIN or END
        MOVAB   K_BEGIN, R1
        BSBW    KEYWORD
        BLBC    R0, 55$
        MOVL    #1, R1
        BRB     80$
55$:    MOVAB   K_END, R1
        BSBW    KEYWORD
        BLBC    R0, 60$
        ADDL3   #1, NLINES, R1
        BRB     80$
60$:    MOVAB   E_CMD, R1
        CLRL    R0
        BRB     90$
70$:    MOVAB   E_FIND, R1
        CLRL    R0
        BRB     90$
80$:    MOVL    #1, R0
90$:    POPR    #^M<R2, R3, R4, R5>
        RSB

; QUOTE: R6 = a character of the command. R0 = 1 if it is " or ', else 0.
QUOTE:  MOVL    #1, R0
        CMPB    (R6), #^A/"/
        BEQL    10$
        CMPB    (R6), #^A/'/
        BEQL    10$
        CLRL    R0
10$:    RSB

; STRING: R6 = a quote in the command, R7 = past its last character. R4 =
; the text after it, R5 = its length, up to the same quote again or the
; end of the command, and R6 past them. Uses R0.
STRING: MOVZBL  (R6)+, R0
        MOVL    R6, R4
10$:    CMPL    R6, R7
        BGEQU   20$
        CMPB    (R6)+, R0
        BNEQ    10$
        SUBL3   R4, R6, R5
        DECL    R5
        RSB
20$:    SUBL3   R4, R6, R5
        RSB

; MATCH: R1 = a line, R4 = text, R5 = its length, R0 = a column. R0 = 1
; if the line has the text in it from that column on, case ignored, and
; MCOL = where, else 0. Keeps every register but R0.
MATCH:  PUSHR   #^M<R2, R3, R8, R9>
        MOVL    LINES[R1], R2
        MOVZBL  (R2)+, R3
        SUBL2   R5, R3
        SUBL2   R0, R3                  ; the places it may start, less one
        BLSS    80$
        ADDL2   R0, R2
10$:    CLRL    R9
20$:    CMPL    R9, R5
        BGEQU   70$
        MOVZBL  (R2)[R9], R0
        BSBB    UPCASE
        MOVL    R0, R8
        MOVZBL  (R4)[R9], R0
        BSBB    UPCASE
        CMPL    R0, R8
        BNEQ    30$
        INCL    R9
        BRB     20$
30$:    INCL    R2
        SOBGEQ  R3, 10$
80$:    CLRL    R0
        BRB     90$
70$:    SUBL3   LINES[R1], R2, R0
        SUBL3   #1, R0, MCOL
        MOVL    #1, R0
90$:    POPR    #^M<R2, R3, R8, R9>
        RSB

; UPCASE: R0 = a character, in capitals.
UPCASE: CMPB    R0, #^A/a/
        BLSSU   10$
        CMPB    R0, #^A/z/
        BGTRU   10$
        SUBL2   #^A/a/-^A/A/, R0
10$:    RSB

; BLANKS: R6 = the next character of the command, R7 = past its last.
; Moves R6 past blanks and tabs.
BLANKS: CMPL    R6, R7
        BGEQU   10$
        CMPB    (R6), #^A/ /
        BEQL    5$
        CMPB    (R6), #9
        BNEQ    10$
5$:     INCL    R6
        BRB     BLANKS
10$:    RSB

; WORD: R6 = the next character of the command, R7 = past its last.
; Copies the letters there to TOKEN, in capitals, with R6 past them. R8 =
; their count, 0 if there is none. Uses R0.
WORD:   CLRL    R8
10$:    CMPL    R6, R7
        BGEQU   20$
        MOVZBL  (R6), R0
        BSBB    UPCASE
        CMPB    R0, #^A/A/
        BLSSU   20$
        CMPB    R0, #^A/Z/
        BGTRU   20$
        MOVB    R0, TOKEN[R8]
        INCL    R8
        INCL    R6
        BRB     10$
20$:    RSB

; VERB: R1 = a verb, .ASCIC. R0 = 1 if the R8 characters in TOKEN are
; its first ones, else 0. Uses R1-R3.
VERB:   CLRL    R0
        MOVZBL  (R1)+, R2
        CMPL    R8, R2
        BGTRU   90$
        CLRL    R3
10$:    CMPL    R3, R8
        BGEQU   80$
        CMPB    TOKEN[R3], (R1)[R3]
        BNEQ    90$
        INCL    R3
        BRB     10$
80$:    MOVL    #1, R0
90$:    RSB

; KEYWORD: R1 = a keyword, .ASCIC. R0 = 1 if the R8 characters in TOKEN
; are all of it, else 0. Uses R1-R3.
KEYWORD:
        CLRL    R0
        CMPB    R8, (R1)
        BNEQ    10$
        BRB     VERB
10$:    RSB

; SCREEN: keypad mode, from the current line until CTRL/Z, which leaves
; the cursor's line the current one, and the line being changed back in
; the arena, for line mode's commands. Uses R0-R7.
SCREEN: CLRL    COL
        CLRL    GOLD
        MOVL    #1, DIR
        MOVAB   S_ENTER, R1
        BSBW    PUTS
        MOVL    #2, PAINT
10$:    BSBW    SHOWSCR
        BSBW    GETKEY
        TSTL    MSGON
        BEQL    15$
        CLRL    MSGON
        PUSHL   R0
        MOVL    #MSGROW, R1
        CLRL    R2
        BSBW    GOTO
        MOVAB   S_EOL, R1
        BSBW    PUTS
        MOVL    (SP)+, R0
15$:    CMPL    R0, #26                 ; CTRL/Z
        BEQL    90$
        CMPL    R0, #K_PF1
        BNEQ    20$
        MOVL    #1, GOLD
        BRB     10$
20$:    TSTL    GOLD
        BEQL    25$
        CLRL    GOLD
        CMPL    R0, #K_UP
        BLSSU   25$
        ADDL2   #K_GOLD, R0
25$:    CMPL    R0, #^A/ /
        BLSSU   30$
        CMPL    R0, #126
        BGTRU   30$
        BSBW    INSCHR
        BRB     10$
30$:    MOVAL   KEYS, R6
40$:    TSTL    (R6)
        BEQL    10$                     ; not one of them
        CMPL    R0, (R6)+
        BEQL    50$
        TSTL    (R6)+
        BRB     40$
50$:    JSB     @(R6)+
        BRB     10$
90$:    BSBW    COMMIT
        MOVAB   S_LEAVE, R1
        BSBW    PUTS
        BRW     FLUSH

; KEY code, routine: the routine keypad mode calls with R0 = code for it.
        .MACRO  KEY     CODE, ROUTINE
        .LONG   CODE
        .ADDRESS ROUTINE
        .ENDM   KEY

KEYS:   KEY     8, BOL                  ; BS
        KEY     9, INSCHR               ; TAB
        KEY     13, SPLIT
        KEY     23, REFRESH             ; CTRL/W
        KEY     127, RUBOUT             ; DEL
        KEY     K_UP, UP
        KEY     K_UP+1, DOWN
        KEY     K_UP+2, RIGHT
        KEY     K_UP+3, LEFT
        KEY     K_PF1+1, HELPKEY
        KEY     K_PF1+2, FINDNXT
        KEY     K_PF1+2+K_GOLD, FIND
        KEY     K_PF1+3, DELL
        KEY     K_COMMA, DELC
        KEY     K_KP0, LINEKEY
        KEY     K_KP0+2, EOLKEY
        KEY     K_KP0+3, CHARKEY
        KEY     K_KP0+4, ADVANCE
        KEY     K_KP0+5, BACKUP
        KEY     K_KP0+4+K_GOLD, BOTTOM
        KEY     K_KP0+5+K_GOLD, TOPKEY
        KEY     K_KP0+8, SECT
        KEY     K_PREV, PREV
        KEY     K_NEXT, NEXTSCR
        .LONG   0

; GETKEY: R0 = the next key: a character, a K_ code for the escape
; sequence a cursor, keypad or function key sends, or 0 for another.
; Uses R0-R2.
GETKEY: BSBW    READKEY
        CMPL    R0, #ESC
        BNEQ    90$
        BSBW    READKEY
        CMPL    R0, #91                 ; [
        BEQL    20$
        CMPL    R0, #^A/O/
        BNEQ    80$
        BSBW    READKEY                 ; ESC O x
        MOVAB   SS3, R2
10$:    TSTB    (R2)
        BEQL    80$
        CMPB    R0, (R2)
        BLSSU   15$
        CMPB    R0, 1(R2)
        BGTRU   15$
        SUBB2   (R2), R0
        ADDW2   2(R2), R0
        RSB
15$:    ADDL2   #4, R2
        BRB     10$
20$:    BSBW    READKEY                 ; ESC [ A-D, or ESC [ n ~
        CMPL    R0, #^A/A/
        BLSSU   30$
        CMPL    R0, #^A/D/
        BGTRU   80$
        ADDL2   #K_UP-^A/A/, R0
        RSB
30$:    CLRL    R2
40$:    CMPL    R0, #^A/~/
        BEQL    50$
        SUBL2   #^A/0/, R0
        CMPL    R0, #9
        BGTRU   80$
        MULL2   #10, R2
        ADDL2   R0, R2
        BSBW    READKEY
        BRB     40$
50$:    MOVL    #K_PREV, R0
        CMPL    R2, #5
        BEQL    90$
        MOVL    #K_NEXT, R0
        CMPL    R2, #6
        BEQL    90$
        SUBL3   #11, R2, R0             ; 11-14: F1-F4
        CMPL    R0, #3
        BGTRU   80$
        ADDL2   #K_PF1, R0
        RSB
80$:    CLRL    R0
90$:    RSB

; SS3: what ESC O and a character in each range is: the range's first
; and last character, and the key of the first.
SS3:    .BYTE   ^A/A/, ^A/D/
        .WORD   K_UP
        .BYTE   ^A/P/, ^A/S/
        .WORD   K_PF1
        .BYTE   ^A/p/, ^A/y/
        .WORD   K_KP0
        .BYTE   ^A/l/, ^A/l/
        .WORD   K_COMMA
        .BYTE   ^A/M/, ^A/M/            ; ENTER
        .WORD   13
        .BYTE   0

; READKEY: R0 = the next character typed, without echo; a carriage
; return if it ended the read, and CTRL/Z if the read fails. Uses R0, R1.
READKEY:
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READVBLK!IO$M_NOECHO!IO$M_NOFILTR, IOSB=IOSB, P1=KEY, P2=#1
        BLBC    R0, 80$
        MOVZBL  #13, R0
        TSTW    IOSB+2
        BEQL    90$
        MOVZBL  KEY, R0
        RSB
80$:    MOVZBL  #26, R0
90$:    RSB

; SHOWSCR: scrolls the current line to the middle of the screen if it is
; off it, paints what PAINT says, and puts the cursor at its column.
; Uses R0-R6.
SHOWSCR:
        SUBL3   TOP, CUR, R0
        CMPL    R0, #ROWS               ; unsigned: above the top too
        BLSSU   20$
        SUBL3   #ROWS/2, CUR, R0
        BGTR    10$
        MOVL    #1, R0
10$:    MOVL    R0, TOP
        MOVL    #2, PAINT
20$:    BBC     #1, PAINT, 40$
        MOVL    #1, R6                  ; every row but MSGROW's
30$:    MOVL    R6, R1
        CLRL    R2
        BSBW    GOTO
        CMPL    R6, #ROWS
        BGTRU   35$
        ADDL3   TOP, R6, R1
        DECL    R1
        BSBW    DRAW
35$:    MOVAB   S_EOL, R1
        BSBW    PUTS
        AOBLSS  #MSGROW, R6, 30$
        BRB     50$
40$:    BLBC    PAINT, 50$
        SUBL3   TOP, CUR, R1
        INCL    R1
        CLRL    R2
        BSBW    GOTO
        MOVL    CUR, R1
        BSBW    DRAW
        MOVAB   S_EOL, R1
        BSBW    PUTS
50$:    CLRL    PAINT
        BSBW    CLAMP
        CMPL    R0, #COLS-1
        BLEQU   60$
        MOVL    #COLS-1, R0
60$:    MOVL    R0, R2
        SUBL3   TOP, CUR, R1
        INCL    R1
        BSBW    GOTO
        BRW     FLUSH

; DRAW: R1 = a line. Writes it, up to COLS characters, with a control
; character as a space, [EOB] past the last line and nothing past that.
; Uses R0-R4.
DRAW:   CMPL    R1, NLINES
        BLEQU   10$
        DECL    R1
        CMPL    R1, NLINES
        BNEQ    90$
        MOVAB   S_EOB, R1
        BRW     PUTS
10$:    MOVL    LINES[R1], R3
        MOVZBL  (R3)+, R4
        BEQL    90$
        CMPL    R4, #COLS
        BLEQU   20$
        MOVL    #COLS, R4
20$:    MOVZBL  (R3)+, R0
        CMPL    R0, #^A/ /
        BLSSU   25$
        CMPL    R0, #126
        BLEQU   30$
25$:    MOVZBL  #^A/ /, R0
30$:    BSBW    PUTC
        SOBGTR  R4, 20$
90$:    RSB

; MSG: R1 = a message, .ASCIC. Writes it on MSGROW, until the next key.
; Uses R0-R3.
MSG:    PUSHL   R1
        MOVL    #MSGROW, R1
        CLRL    R2
        BSBW    GOTO
        MOVL    (SP)+, R1
        BSBW    PUTS
        MOVAB   S_EOL, R1
        BSBW    PUTS
        MOVL    #1, MSGON
        RSB

; GOTO: R1 = a row, from 1, R2 = a column, from 0. Moves the cursor
; there. Uses R0-R2.
GOTO:   PUSHL   R2
        PUSHL   R1
        MOVZBL  #ESC, R0
        BSBB    PUTC
        MOVZBL  #91, R0                 ; [
        BSBB    PUTC
        MOVL    (SP)+, R0
        BSBB    PUTNUM
        MOVZBL  #59, R0                 ; a semicolon
        BSBB    PUTC
        ADDL3   #1, (SP)+, R0
        BSBB    PUTNUM
        MOVZBL  #^A/H/, R0
        BRB     PUTC

; PUTNUM: R0 = a number, 0-99. Writes it in decimal. Uses R0-R2.
PUTNUM: DIVL3   #10, R0, R2
        MULL3   #10, R2, R1
        SUBL2   R1, R0
        PUSHL   R0
        TSTL    R2
        BEQL    10$
        ADDL3   #^A/0/, R2, R0
        BSBB    PUTC
10$:    ADDL3   #^A/0/, (SP)+, R0
        BRB     PUTC

; PUTS: R1 = text, .ASCIC. Writes it. Uses R0-R3.
PUTS:   MOVL    R1, R3
        MOVZBL  (R3)+, R2
        BEQL    20$
10$:    MOVZBL  (R3)+, R0
        BSBB    PUTC
        SOBGTR  R2, 10$
20$:    RSB

; PUTC: R0 = a character. Writes it, in SBUF until FLUSH. Uses R1.
PUTC:   MOVL    SLEN, R1
        CMPL    R1, #SBUFSIZE
        BLSSU   10$
        PUSHL   R0
        BSBB    FLUSH
        MOVL    (SP)+, R0
        CLRL    R1
10$:    MOVB    R0, SBUF[R1]
        INCL    SLEN
        RSB

; FLUSH: writes what is in SBUF on the console. Uses R0, R1.
FLUSH:  $QIOW_S CHAN=CHAN, FUNC=#IO$_WRITEVBLK, P1=SBUF, P2=SLEN
        CLRL    SLEN
        RSB

; LEN: R1 = a line, 1 to NLINES+1. R0 = its length, 0 for [EOB].
LEN:    CLRL    R0
        CMPL    R1, NLINES
        BGTRU   10$
        MOVL    LINES[R1], R0
        MOVZBL  (R0), R0
10$:    RSB

; CLAMP: R0 = the cursor's column, at most the end of the current line,
; R1 = that line's length.
CLAMP:  MOVL    CUR, R1
        BSBB    LEN
        MOVL    R0, R1
        MOVL    COL, R0
        CMPL    R0, R1
        BLEQU   10$
        MOVL    R1, R0
10$:    RSB

; The keys' routines. Each may use R0-R7.
UP:     CMPL    CUR, #1
        BLEQU   10$
        DECL    CUR
10$:    RSB

DOWN:   CMPL    CUR, NLINES
        BGTRU   10$
        INCL    CUR
10$:    RSB

RIGHT:  BSBB    CLAMP
        CMPL    R0, R1
        BGEQU   10$
        ADDL3   #1, R0, COL
        RSB
10$:    CMPL    CUR, NLINES
        BGTRU   20$
        INCL    CUR
        CLRL    COL
20$:    RSB

LEFT:   BSBB    CLAMP
        TSTL    R0
        BEQL    10$
        SUBL3   #1, R0, COL
        RSB
10$:    CMPL    CUR, #1
        BLEQU   20$
        DECL    CUR
        MOVL    CUR, R1
        BSBB    LEN
        MOVL    R0, COL
20$:    RSB

BOL:    BSBB    CLAMP                   ; the start of the line, or the one before
        TSTL    R0
        BNEQ    10$
        BSBB    UP
10$:    CLRL    COL
        RSB

LINEKEY:
        TSTL    DIR                     ; the next line's start, or this one's
        BLSS    BOL
        BSBB    DOWN
        CLRL    COL
        RSB

EOLKEY: TSTL    DIR                     ; this line's end, or the one after or before
        BGTR    10$
        BSBB    UP
        BRB     20$
10$:    BSBB    CLAMP
        CMPL    R0, R1
        BLSSU   20$
        BSBB    DOWN
20$:    MOVL    CUR, R1
        BSBB    LEN
        MOVL    R0, COL
        RSB

CHARKEY:
        TSTL    DIR
        BLSS    LEFT
        BRB     RIGHT

ADVANCE:
        MOVL    #1, DIR
        RSB

BACKUP: MNEGL   #1, DIR
        RSB

TOPKEY: MOVL    #1, CUR
        CLRL    COL
        RSB

BOTTOM: ADDL3   #1, NLINES, CUR
        CLRL    COL
        RSB

SECT:   MOVL    DIR, R2
        BRB     MOVESECT
PREV:   MNEGL   #1, R2
        BRB     MOVESECT
NEXTSCR:
        MOVL    #1, R2
; MOVESECT: R2 = 1 or -1. Moves SECTION lines that way, to the start of
; the line, the first or [EOB] at most.
MOVESECT:
        MULL3   #SECTION, R2, R0
        ADDL2   CUR, R0
        BGTR    10$
        MOVL    #1, R0
10$:    ADDL3   #1, NLINES, R1
        CMPL    R0, R1
        BLEQ    20$
        MOVL    R1, R0
20$:    MOVL    R0, CUR
        CLRL    COL
        RSB

REFRESH:
        MOVL    #2, PAINT
        RSB

HELPKEY:
        MOVAB   E_KEYS, R1
        BRW     MSG

; FIND: reads what to look for on MSGROW, and finds it as FINDNXT does.
FIND:   BSBW    FLUSH
        $QIOW_S CHAN=CHAN, FUNC=#IO$_READPROMPT, IOSB=IOSB, P1=STR, P2=#LINESIZE, P5=#S_FIND, P6=#S_FINDLEN
        MOVL    #2, PAINT               ; the echo of RETURN scrolled the screen
        BLBC    R0, 10$
        MOVZWL  IOSB+2, R0
        BEQL    10$
        MOVL    R0, STRLEN
        BRB     FINDNXT
10$:    RSB

; FINDNXT: moves to the next place with what FIND looked for, case
; ignored, after the cursor in ADVANCE, on a line before it in BACKUP.
FINDNXT:
        MOVL    STRLEN, R5
        BNEQ    10$
        MOVAB   E_NOSTR, R1
        BRW     MSG
10$:    MOVAB   STR, R4
        TSTL    DIR
        BLSS    40$
        BSBW    CLAMP
        INCL    R0
        MOVL    CUR, R1
20$:    CMPL    R1, NLINES
        BGTRU   80$
        BSBW    MATCH
        BLBS    R0, 70$
        INCL    R1
        CLRL    R0
        BRB     20$
40$:    MOVL    CUR, R1
50$:    DECL    R1
        BEQL    80$
        CLRL    R0
        BSBW    MATCH
        BLBC    R0, 50$
70$:    MOVL    R1, CUR
        MOVL    MCOL, COL
        RSB
80$:    MOVAB   E_FIND, R1
        BRW     MSG

; INSCHR: R0 = a character. Puts it in at the cursor.
INSCHR: MOVL    R0, R7
        BSBW    ROOM
        BLBC    R0, 90$
        BSBW    OPENLN
        BLBC    R0, 90$
        BSBW    CLAMP
        CMPL    R1, #LINESIZE
        BGEQU   80$
        ADDL3   #1, R0, COL
        INCB    OPEN
        SUBL2   R0, R1                  ; the characters after it
        MOVAB   OPEN+1[R0], R6
        MOVC3   R1, (R6), 1(R6)
        MOVB    R7, (R6)
        BISL2   #1, PAINT
90$:    RSB
80$:    MOVAB   E_LONG, R1
        BRW     MSG

; SPLIT: RETURN. Breaks the line at the cursor, which goes to the start
; of the new one; at [EOB], puts an empty line before it.
SPLIT:  BSBW    ROOM
        BLBC    R0, 90$
        CMPL    NLINES, #MAXLINES
        BGEQU   80$
        CMPL    CUR, NLINES
        BLEQU   10$
        MOVAB   EMPTY, R1
        MOVL    CUR, R2
        BSBW    INSLINE
        BRB     20$
10$:    BSBW    OPENLN
        BSBW    CLAMP
        MOVB    R0, OPEN                ; this line, up to the cursor
        SUBL2   R0, R1                  ; and the rest, a new one
        MOVAB   OPEN+1[R0], R0
        MOVL    FREE, R6
        MOVB    R1, (R6)
        ADDL3   #1, R1, R2
        ADDL2   R2, FREE
        MOVC3   R1, (R0), 1(R6)
        MOVL    R6, R1
        ADDL3   #1, CUR, R2
        BSBW    INSLINE
20$:    INCL    CUR
        CLRL    COL
90$:    RSB
80$:    MOVAB   E_FULL, R1
        BRW     MSG

; RUBOUT: DEL. Deletes the character before the cursor, at the start of
; a line the end of the one before.
RUBOUT: BSBW    ROOM
        BLBC    R0, 90$
        BSBW    CLAMP
        TSTL    R0
        BEQL    10$
        DECL    R0
        MOVL    R0, COL
        BSBW    OPENLN
        MOVL    COL, R0
        BRB     DELCHR
10$:    CMPL    CUR, #1
        BLEQU   90$
        DECL    CUR
        MOVL    CUR, R1
        BSBW    LEN
        MOVL    R0, COL
        BRB     JOIN
90$:    RSB

; DELC: deletes the character at the cursor, at the end of a line the
; end itself.
DELC:   BSBW    ROOM
        BLBC    R0, 90$
        BSBW    CLAMP
        MOVL    R0, COL
        CMPL    R0, R1
        BGEQU   JOIN
        BSBW    OPENLN
        MOVL    COL, R0
        BRB     DELCHR
90$:    RSB

; DELL: deletes from the cursor to the start of the next line.
DELL:   BSBW    ROOM
        BLBC    R0, 90$
        CMPL    CUR, NLINES
        BGTRU   90$
        BSBW    CLAMP
        MOVL    R0, COL
        BSBW    OPENLN
        MOVB    COL, OPEN
        BISL2   #1, PAINT
        BRB     JOIN
90$:    RSB

; DELCHR: R0 = a column of OPEN, before its end. Deletes the character
; there.
DELCHR: MOVZBL  OPEN, R1
        SUBL2   R0, R1
        DECL    R1                      ; the characters after it
        DECB    OPEN
        MOVAB   OPEN+1[R0], R2
        MOVC3   R1, 1(R2), (R2)
        BISL2   #1, PAINT
        RSB

; JOIN: puts the next line at the end of the current one, if there is
; one and the two fit in a line.
JOIN:   CMPL    CUR, NLINES
        BGEQU   90$
        BSBW    OPENLN
        ADDL3   #1, CUR, R7
        MOVL    LINES[R7], R1
        MOVZBL  (R1)+, R0
        MOVZBL  OPEN, R2
        ADDL3   R0, R2, R3
        CMPL    R3, #LINESIZE
        BGTRU   80$
        MOVB    R3, OPEN
        MOVAB   OPEN+1[R2], R2
        MOVC3   R0, (R1), (R2)
        MOVL    R7, R2
        BRW     DELLINE
80$:    MOVAB   E_LONG, R1
        BRW     MSG
90$:    RSB

; ROOM: R0 = 1 if TEXT has RESERVE bytes for a change, compacted if it
; must be, else 0, and a message. Uses R0-R7.
ROOM:   SUBL3   FREE, LIMIT, R0
        CMPL    R0, #RESERVE
        BGEQU   10$
        BSBB    COMPACT
        SUBL3   FREE, LIMIT, R0
        CMPL    R0, #RESERVE
        BGEQU   10$
        MOVAB   E_FULL, R1
        BSBW    MSG
        CLRL    R0
        RSB
10$:    MOVL    #1, R0
        RSB

; COMPACT: copies the lines, the one being changed too, to the other
; arena, one after another, and goes on in that one, without the copies
; changes left behind. Uses R0-R7.
COMPACT:
        MOVAB   TEXT, R6
        CMPL    BASE, R6
        BNEQ    10$
        MOVAB   TEXT2, R6
10$:    MOVL    R6, BASE
        ADDL3   #TEXTSIZE, R6, LIMIT
        CLRL    OPENED
        MOVL    #1, R7
20$:    CMPL    R7, NLINES
        BGTRU   30$
        MOVL    LINES[R7], R1
        MOVL    R6, LINES[R7]
        MOVZBL  (R1), R0
        INCL    R0
        PUSHL   R0
        MOVC3   R0, (R1), (R6)
        ADDL3   (SP)+, LINES[R7], R6
        INCL    R7
        BRB     20$
30$:    MOVL    R6, FREE
        RSB

; OPENLN: makes the current line the one being changed, in OPEN, after
; it puts the one that was back; at [EOB], a new empty line. R0 = 1, or
; 0 if there is no room for it. Uses R0-R5.
OPENLN: CMPL    OPENED, CUR
        BEQL    80$
        BSBB    COMMIT
        CMPL    CUR, NLINES
        BLEQU   10$
        CMPL    NLINES, #MAXLINES
        BGEQU   85$
        MOVAB   EMPTY, R1
        MOVL    CUR, R2
        BSBB    INSLINE
10$:    MOVL    CUR, R5
        MOVL    LINES[R5], R1
        MOVL    R1, ORIG
        MOVAB   OPEN, LINES[R5]
        MOVL    R5, OPENED
        MOVZBL  (R1), R0
        INCL    R0
        MOVC3   R0, (R1), OPEN
80$:    MOVL    #1, R0
        RSB
85$:    MOVAB   E_FULL, R1
        BSBW    MSG
        CLRL    R0
        RSB

; COMMIT: puts the line being changed back in TEXT: where it was if it
; fits, else at FREE. Uses R0-R5.
COMMIT: MOVL    OPENED, R5
        BEQL    90$
        CLRL    OPENED
        MOVZBL  OPEN, R0
        INCL    R0
        MOVL    ORIG, R3
        CMPB    OPEN, (R3)
        BLEQU   10$
        MOVL    FREE, R3
        ADDL2   R0, FREE
10$:    MOVL    R3, LINES[R5]
        MOVC3   R0, OPEN, (R3)
90$:    RSB

; INSLINE: R1 = a line, .ASCIC, R2 = where it goes, 1 to NLINES+1. Puts
; it there, and the lines from there on one further. Uses R0-R5.
INSLINE:
        PUSHR   #^M<R1, R2>
        SUBL3   R2, NLINES, R0
        INCL    R0
        MULL2   #4, R0
        MOVAL   LINES[R2], R1
        MOVC3   R0, (R1), 4(R1)
        POPR    #^M<R1, R2>
        MOVL    R1, LINES[R2]
        INCL    NLINES
        CMPL    OPENED, R2
        BLSSU   10$
        INCL    OPENED
10$:    MOVL    #2, PAINT
        RSB

; DELLINE: R2 = a line, 1 to NLINES. Takes it out, and the lines after
; it one back. Uses R0-R5.
DELLINE:
        PUSHL   R2
        SUBL3   R2, NLINES, R0
        MULL2   #4, R0
        MOVAL   LINES[R2], R1
        MOVC3   R0, 4(R1), (R1)
        MOVL    (SP)+, R2
        DECL    NLINES
        CMPL    OPENED, R2
        BLSSU   20$
        BNEQ    10$
        CLRL    OPENED
        BRB     20$
10$:    DECL    OPENED
20$:    MOVL    #2, PAINT
        RSB

        .END    START
