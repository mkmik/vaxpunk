        .TITLE  HELP    Describes DCL's commands, from its command tables
        .IDENT  /V0.1/
;
; DCL's HELP [topic] runs this, which build.rs links with DCL$TABLES,
; DCL's command tables (ADR-0017, vtools/docs/command-tables.md). With no
; topic it lists each verb with its parameters, then what DCL does with
; no verb: symbols, labels, procedures. HELP verb describes each verb
; whose name starts with the topic:
;
;   DELETE file                 the verb and its parameters, [optional]
;     /[NO]LOG                  its qualifiers, and the values they take
;     /SYMBOL
;   DELETE/SYMBOL symbol        each syntax a qualifier or keyword
;     ...                       switches to that has parameters or
;                               qualifiers of its own, the same way
;
; A parameter whose value is a keyword lists the keywords. Topics are
; matched in capitals; one that no verb starts with is "Sorry, no
; documentation on TOPIC".
; ponytail: the tables have no text, so neither has HELP: VMS's HELP
; reads it from a help library, HELPLIB.HLB.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF

        .EXTERNAL PUT_LINE, DCL$TABLES

; Entities, as in the tables.
ENT$B_FLAGS = 0
ENT$B_TYPE = 1
ENT$W_KEYWORDS = 2
ENT$W_SYNTAX = 4
ENT$T_NAME = 7                          ; after a byte, its PLACEMENT
ENT_V_DEFAULT = 0
ENT_V_NEGATABLE = 1
ENT_V_VALUE = 2
ENT_V_REQUIRED = 3
ENT_V_LIST = 4
TYP_KEYWORD = 5
INHERIT = 255
MAXSYNTAX = 16                          ; syntaxes HELP describes for a verb

; TEXT "text": appends text to LINE. Uses R0-R2.
        .MACRO  TEXT    STRING, ?L
        .SAVE_PSECT LOCAL_BLOCK
        .PSECT  $LITERAL$
L:      .ASCIC  STRING
        .RESTORE_PSECT
        MOVAB   L, R1
        BSBW    ADDC
        .ENDM   TEXT

        .PSECT  DATA, NOEXE, WRT, LONG
TOPDSC: .LONG   64                      ; TOPIC, the parameter
        .ADDRESS TOPIC
TOPIC:  .BLKB   64
TOPLEN: .LONG   0                       ; its first word's length
FOUND:  .LONG   0                       ; verbs described
LINE:   .BLKB   256                     ; a line being made, .ASCIC
HEAD:   .BLKB   128                     ; DESCRIBE's: the command so far, .ASCIC
NSEEN:  .LONG   0                       ; the syntaxes described,
SEEN:   .BLKL   MAXSYNTAX               ; their blocks
CHAR:   .BLKB   1
COMMA:  .ASCIC  /, /
BAR:    .ASCIC  /|/

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7>
        MOVL    #64, TOPDSC
        CLRL    FOUND
        GETVALUE "TOPIC", TOPDSC, TOPDSC
        BLBS    R0, 10$
        CLRL    TOPDSC
10$:    CLRL    R2                      ; its first word, in capitals
20$:    CMPL    R2, TOPDSC
        BGEQU   30$
        MOVZBL  TOPIC[R2], R0
        CMPB    R0, #^A/ /
        BEQL    30$
        CMPB    R0, #^A/a/
        BLSSU   25$
        CMPB    R0, #^A/z/
        BGTRU   25$
        SUBB2   #^A/a/-^A/A/, R0
25$:    MOVB    R0, TOPIC[R2]
        INCL    R2
        BRB     20$
30$:    MOVL    R2, TOPLEN
        MOVAB   G^DCL$TABLES, R6
        MOVZWL  2(R6), R7               ; the verbs
        MOVAB   4(R6), R5               ; each one's name and block
        TSTL    TOPLEN
        BNEQ    50$
        PRINT   ""                      ; no topic: the list
40$:    TEXT    "  "
        MOVZWL  (R5), R1
        ADDL2   R6, R1
        BSBW    ADDC
        MOVZWL  2(R5), R2
        ADDL2   R6, R2
        BSBW    BLOCK
        CLRL    R4
        BSBW    PARAMS
        BSBW    SAY
        ADDL2   #4, R5
        SOBGTR  R7, 40$
        PRINT   ""
        PRINT   "  @file [p1 ... p8]     runs the command procedure file, file.COM"
        PRINT   "  name = expression     sets a local symbol, == a global one"
        PRINT   "  name := string        the same with a string, :== a global one"
        PRINT   "  'name'                stands for the symbol's value in a command"
        PRINT   "  label:                a label in a procedure, for GOTO"
        PRINT   ""
        PRINT   "  HELP verb describes a verb, its parameters and qualifiers."
        BRB     90$
50$:    MOVZWL  (R5), R1                ; a topic: the verbs it starts
        ADDL2   R6, R1
        CMPB    (R1), TOPLEN
        BLSSU   60$
        CLRL    R0
55$:    CMPB    1(R1)[R0], TOPIC[R0]
        BNEQ    60$
        AOBLSS  TOPLEN, R0, 55$
        INCL    FOUND
        PRINT   ""
        MOVB    #2, HEAD
        MOVW    #^X2020, HEAD+1
        MOVZWL  (R5), R1
        ADDL2   R6, R1
        BSBW    ADDHEAD
        MOVZWL  2(R5), R1
        ADDL2   R6, R1
        CLRL    NSEEN
        PUSHL   #0                      ; no parameters to skip
        CLRQ    -(SP)                   ; nothing to inherit
        PUSHL   R1
        CALLS   #4, DESCRIBE
60$:    ADDL2   #4, R5
        SOBGTR  R7, 50$
        TSTL    FOUND
        BNEQ    90$
        TEXT    "Sorry, no documentation on "
        MOVAB   TOPIC, R1
        MOVL    TOPLEN, R2
        BSBW    ADD
        BSBW    SAY
90$:    MOVL    #SS$_NORMAL, R0
        RET

; ADDHEAD: R1 = a verb's name, .ASCIC. Appends it to HEAD. Uses R0-R2.
ADDHEAD:
        MOVZBL  (R1)+, R2
        MOVZBL  HEAD, R0
10$:    TSTL    R2
        BEQL    20$
        INCL    R0
        MOVB    (R1)+, HEAD[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, HEAD
        RSB

; DESCRIBE block, params, quals, skip: writes the command in HEAD, with
; the parameters of block, a verb's or a syntax's, from the skip'th, and
; its own qualifiers, but those that switch to it; then each syntax one of them or a keyword of its first
; parameter switches to, if it has parameters or qualifiers of its own and
; wasn't described yet. A syntax inherits params and quals, the count
; bytes of its parent's, where it has none.
        .ENTRY  DESCRIBE, ^M<R2, R3, R4, R5, R6, R7, R8, R9, R10, R11>
        MOVAB   G^DCL$TABLES, R6
        MOVL    4(AP), R2
        BSBW    BLOCK                   ; R2, R3 = its own, or 0
        TSTL    R2
        BNEQ    10$
        MOVL    8(AP), R2
10$:    TSTL    R3
        BNEQ    20$
        MOVL    12(AP), R3
20$:    MOVL    R2, R9                  ; the parameters
        MOVL    R3, R10                 ; the qualifiers
        MOVAB   HEAD, R1
        BSBW    ADDC
        MOVL    R9, R2
        MOVL    16(AP), R4
        BSBW    PARAMS
        BSBW    SAY
        MOVL    R9, R2                  ; keywords a parameter may be
        MOVL    16(AP), R4
        BSBW    KEYWORDS
        CMPL    R10, 12(AP)             ; the qualifiers, its own
        BEQL    40$
        MOVL    R10, R8
        MOVZBL  (R8)+, R11
30$:    TSTL    R11
        BEQL    40$
        BSBW    ENTITY
        MOVZWL  ENT$W_SYNTAX(R1), R0    ; not one that leads to it
        ADDL2   R6, R0
        CMPL    R0, 4(AP)
        BEQL    37$
        MOVL    R1, R7
        TEXT    "    /"
        BBC     #ENT_V_NEGATABLE, ENT$B_FLAGS(R7), 35$
        TEXT    "[NO]"
35$:    MOVL    R7, R1
        BSBW    QUAL
        BSBW    SAY
37$:    ADDL2   #2, R8
        DECL    R11
        BRB     30$
40$:    MOVL    R10, R8                 ; their syntaxes
        MOVZBL  (R8)+, R11
50$:    TSTL    R11
        BEQL    60$
        BSBW    ENTITY
        MOVZBL  #^A"/", R0
        CLRL    R4
        BSBW    SUBSYNTAX
        ADDL2   #2, R8
        DECL    R11
        BRB     50$
60$:    TSTL    16(AP)                  ; the first parameter's keywords',
        BNEQ    90$                     ; unless HEAD names one
        TSTB    (R9)
        BEQL    90$
        MOVAB   1(R9), R8
        BSBW    ENTITY
        CMPB    ENT$B_TYPE(R1), #TYP_KEYWORD
        BNEQ    90$
        BSBW    TYPEOF
        MOVL    R0, R8
        MOVZBL  (R8)+, R11
70$:    TSTL    R11
        BEQL    90$
        BSBW    ENTITY
        MOVZBL  #^A" ", R0
        MOVL    #1, R4
        BSBW    SUBSYNTAX
        ADDL2   #2, R8
        DECL    R11
        BRB     70$
90$:    RET

; SUBSYNTAX: R1 = a qualifier or keyword, R0 = the character before its
; name in the command, R4 = the parameters it takes the place of, R9 and
; R10 = the command's parameters and qualifiers. DESCRIBEs the syntax it
; switches to, if it has one HELP should describe, with HEAD the command
; and the name. Uses R0-R5.
SUBSYNTAX:
        MOVZWL  ENT$W_SYNTAX(R1), R2
        BEQL    90$
        ADDL2   R6, R2
        MOVL    NSEEN, R3               ; described already?
10$:    DECL    R3
        BLSS    20$
        CMPL    R2, SEEN[R3]
        BEQL    90$
        BRB     10$
20$:    PUSHL   R2
        PUSHL   R1
        PUSHL   R0
        BSBW    BLOCK                   ; one of its own?
        BISL3   R2, R3, R5
        MOVL    (SP)+, R0
        MOVL    (SP)+, R1
        MOVL    (SP)+, R2
        TSTL    R5
        BEQL    90$
        MOVL    NSEEN, R3
        CMPL    R3, #MAXSYNTAX
        BGEQU   90$
        MOVL    R2, SEEN[R3]
        INCL    NSEEN
        MOVZBL  HEAD, R3                ; HEAD + /NAME or blank NAME
        PUSHL   R3
        INCL    R3
        MOVB    R0, HEAD[R3]
        MOVB    R3, HEAD
        PUSHL   R2
        MOVAB   ENT$T_NAME(R1), R1
        BSBW    ADDHEAD
        MOVL    (SP)+, R2
        PUSHL   R4
        PUSHL   R10
        PUSHL   R9
        PUSHL   R2
        CALLS   #4, DESCRIBE
        MOVL    (SP)+, R3
        MOVB    R3, HEAD                ; HEAD again
90$:    RSB

; BLOCK: R2 = a command block. R2, R3 = its parameters' and qualifiers'
; counts, 0 for those it inherits. Uses R0-R3.
BLOCK:  MOVZBL  (R2)+, R0               ; past its name, image and routine
        ADDL2   R0, R2
        MOVZBL  (R2)+, R0
        ADDL2   R0, R2
        MOVZBL  (R2)+, R0
        ADDL2   R0, R2
        MOVL    R2, R3
        CMPB    (R2), #INHERIT
        BNEQ    10$
        CLRL    R2
        INCL    R3
        BRB     20$
10$:    MOVZBL  (R3), R0
        ASHL    #1, R0, R0
        ADDL2   R0, R3
        INCL    R3
20$:    CMPB    (R3), #INHERIT
        BNEQ    30$
        CLRL    R3
30$:    RSB

; ENTITY: R8 = a word offset in the tables. R1 = the entity there. Uses
; R0, R1.
ENTITY: MOVZBL  (R8), R1
        MOVZBL  1(R8), R0
        ASHL    #8, R0, R0
        BISL2   R0, R1
        ADDL2   R6, R1
        RSB

; TYPEOF: R1 = an entity whose values are keywords. R0 = its type's
; block: a count and word offsets. Uses R0, R2.
TYPEOF: MOVZWL  ENT$W_KEYWORDS(R1), R0
        ADDL2   R6, R0
        RSB

; PARAMS: R2 = a count byte and parameters, R4 = how many to skip.
; Appends the others to LINE: a blank and each one's label, in small
; letters, [in brackets] if optional, [,...] after it if a list. Uses
; R0-R4, R8, R11.
PARAMS: MOVAB   1(R2), R8
        MOVZBL  (R2), R11
        SUBL2   R4, R11
        BLEQ    90$
        ASHL    #1, R4, R4
        ADDL2   R4, R8
10$:    BSBB    ENTITY
        PUSHL   R1
        TEXT    " "
        MOVL    (SP), R1
        BBS     #ENT_V_REQUIRED, ENT$B_FLAGS(R1), 20$
        TEXT    "["
20$:    MOVL    (SP), R1
        MOVAB   ENT$T_NAME(R1), R1      ; the label
        MOVZBL  (R1)+, R0
        ADDL2   R0, R1
        BSBW    ADDLOW
        MOVL    (SP), R1
        BBC     #ENT_V_LIST, ENT$B_FLAGS(R1), 30$
        TEXT    "[,...]"
30$:    MOVL    (SP)+, R1
        BBS     #ENT_V_REQUIRED, ENT$B_FLAGS(R1), 40$
        TEXT    "]"
40$:    ADDL2   #2, R8
        SOBGTR  R11, 10$
90$:    RSB

; KEYWORDS: R2 = a count byte and parameters, R4 = how many to skip. For
; each other whose values are keywords, writes "    label: KEYWORD,
; KEYWORD...". Uses R0-R5, R8, R11.
KEYWORDS:
        MOVAB   1(R2), R8
        MOVZBL  (R2), R11
        SUBL2   R4, R11
        ASHL    #1, R4, R4
        ADDL2   R4, R8
10$:    TSTL    R11
        BLEQ    90$
        BSBB    ENTITY
        CMPB    ENT$B_TYPE(R1), #TYP_KEYWORD
        BNEQ    20$
        PUSHL   R1
        TEXT    "    "
        MOVL    (SP), R1
        MOVAB   ENT$T_NAME(R1), R1
        MOVZBL  (R1)+, R0
        ADDL2   R0, R1
        BSBW    ADDLOW
        TEXT    ": "
        MOVL    (SP)+, R1
        CLRL    R3
        BSBB    KEYLIST
        BSBW    SAY
20$:    ADDL2   #2, R8
        DECL    R11
        BRB     10$
90$:    RSB

; KEYLIST: R1 = an entity whose values are keywords, R3 = 0 to separate
; them with commas, 1 with bars. Appends their names to LINE. Uses R0-R5.
KEYLIST:
        PUSHL   R8
        PUSHL   R3
        BSBB    TYPEOF
        MOVL    R0, R8
        MOVZBL  (R8)+, R5
        CLRL    R4                      ; the first?
10$:    TSTL    R5
        BEQL    90$
        TSTL    R4
        BEQL    20$
        MOVAB   COMMA, R1               ; the separator
        TSTL    (SP)
        BEQL    15$
        MOVAB   BAR, R1
15$:    BSBW    ADDC
20$:    INCL    R4
        BSBW    ENTITY
        MOVAB   ENT$T_NAME(R1), R1
        BSBW    ADDC
        ADDL2   #2, R8
        DECL    R5
        BRB     10$
90$:    TSTL    (SP)+
        MOVL    (SP)+, R8
        RSB

; QUAL: R1 = a qualifier. Appends its name and the value it takes,
; =value, [=value] if it may have none, or =keyword|keyword, and
; (default) if it is present by default. Uses R0-R5.
QUAL:   PUSHL   R1
        MOVAB   ENT$T_NAME(R1), R1
        BSBW    ADDC
        MOVL    (SP), R1
        BBC     #ENT_V_VALUE, ENT$B_FLAGS(R1), 30$
        BBS     #ENT_V_REQUIRED, ENT$B_FLAGS(R1), 10$
        TEXT    "["
10$:    TEXT    "="
        MOVL    (SP), R1
        CMPB    ENT$B_TYPE(R1), #TYP_KEYWORD
        BEQL    15$
        TEXT    "value"
        BRB     20$
15$:    MOVL    #1, R3
        BSBB    KEYLIST
20$:    MOVL    (SP), R1
        BBS     #ENT_V_REQUIRED, ENT$B_FLAGS(R1), 30$
        TEXT    "]"
30$:    MOVL    (SP)+, R1
        BBC     #ENT_V_DEFAULT, ENT$B_FLAGS(R1), 40$
        TEXT    "  (default)"
40$:    RSB

; ADDLOW: R1 = a .ASCIC string. Appends it to LINE in small letters.
; Uses R0-R3.
ADDLOW: MOVZBL  (R1)+, R3
10$:    TSTL    R3
        BEQL    20$
        MOVZBL  (R1)+, R0
        CMPB    R0, #^A/A/
        BLSSU   15$
        CMPB    R0, #^A/Z/
        BGTRU   15$
        ADDB2   #^A/a/-^A/A/, R0
15$:    PUSHL   R1
        BSBB    ADDCH
        MOVL    (SP)+, R1
        DECL    R3
        BRB     10$
20$:    RSB

; ADDCH: appends the character in R0 to LINE. ADDC: the .ASCIC string at
; R1. ADD: the R2 characters at R1, as many as fit. Use R0-R2.
ADDCH:  MOVB    R0, CHAR
        MOVAB   CHAR, R1
        MOVL    #1, R2
        BRB     ADD
ADDC:   MOVZBL  (R1)+, R2
ADD:    MOVZBL  LINE, R0
10$:    TSTL    R2
        BEQL    20$
        CMPL    R0, #255
        BGEQU   20$
        INCL    R0
        MOVB    (R1)+, LINE[R0]
        DECL    R2
        BRB     10$
20$:    MOVB    R0, LINE
        RSB

; SAY: writes the line in LINE, and empties it. Uses R0, R1.
SAY:    PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        CLRB    LINE
        RSB

        .END    START
