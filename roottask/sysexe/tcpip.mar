        .TITLE  TCPIP   Sets and shows the network interface
        .IDENT  /V0.2/
;
; DCL's SET INTERFACE address mask, SET ROUTE /DEFAULT /GATEWAY=address,
; SHOW INTERFACE and SET CONFIGURATION INTERFACE address mask run this,
; in the spirit of TCP/IP Services' TCPIP commands: OPTION, the parse's
; first parameter, and $VERB say which, and ADDRESS, MASK and GATEWAY
; give the addresses, four numbers and dots each. As there, SET
; INTERFACE and SET ROUTE change the running system, and SET
; CONFIGURATION INTERFACE and SET ROUTE /PERMANENT the saved
; configuration, which the next boot applies: the first two sense the
; settings with IO$_SENSECHAR on BGA0:, the network's port driver
; (netdriver.mar), change theirs and set them with IO$_SETCHAR; the last
; two read the saved ones, change theirs and write INTERFACE address mask
; gateway in a new version of TCPIP$CONFIG.DAT on the data disk, the one
; that may be written. SHOW senses them and writes them, and whether the
; link is up. With no command line, as SYLOGIN.COM runs it at boot, it
; sets the interface from the saved settings, if there are any, and says
; so, and starts TELNETD, the remote login server SET HOST talks to.
; ponytail: one interface and one route, the default; a saved file only
; once INITIALIZE DKB0: has made a volume there.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF
        $RMSDEF
        $FABDEF
        $RABDEF
        $IODEF

        .EXTERNAL PUT_LINE, INET_ADDR, CLI$GET_VALUE

        .PSECT  DATA, NOEXE, WRT, LONG
BGA0:   .ASCID  "BGA0:"
CHAN:   .LONG   0
IOSB:   .BLKQ   1
SETTINGS:                               ; address, mask, gateway, flags: 2 the link is up
        .BLKL   4
CMD:    .BLKB   256                     ; the saved settings, .ASCIC
OPTION: .LONG   16                      ; OPTION, the parameter: INTERFACE, ROUTE or CONFIGURATION
        .ADDRESS OPTBUF
OPTBUF: .BLKB   16
VERB:   .LONG   4                       ; $VERB: SET or SHOW
        .ADDRESS VERBBUF
VERBBUF:
        .BLKB   4
VALUE:  .LONG   0                       ; an address the command gives
        .ADDRESS VALBUF
VALBUF: .BLKB   64
FAB:    $FAB    FNA=CONFIG, FNS=CONFIGLEN
RAB:    $RAB    FAB=FAB, UBF=CMD+1, USZ=255
LINE:   .BLKB   256                     ; a line being written, .ASCIC
CONFIG: .ASCII  "DKB0:[000000]TCPIP$CONFIG.DAT"
CONFIGLEN = . - CONFIG
INTERFACE:
        .ASCIC  "INTERFACE"
P_ADDRESS:
        .ASCID  "ADDRESS"
P_MASK: .ASCID  "MASK"
P_GATEWAY:
        .ASCID  "GATEWAY"
TELNETD:
        .ASCID  "TELNETD.EXE"
TELNETD_NAME:
        .ASCID  "TCPIP$TELNET"

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3, R4, R5, R6, R7>
        $ASSIGN_S DEVNAM=BGA0, CHAN=CHAN
        BLBC    R0, 90$
        GETVALUE "OPTION", OPTION, OPTION
        BLBS    R0, 5$
        BRW     BOOT                    ; no command
5$:     GETVALUE "$VERB", VERB, VERB
        CMPB    VERBBUF+1, #^A/H/       ; SHOW INTERFACE
        BNEQ    10$
        BRW     SHOW
10$:    CLRL    R7                      ; 1: the saved settings
        CMPB    OPTBUF, #^A/C/          ; SET CONFIGURATION INTERFACE
        BEQL    15$
        CMPB    OPTBUF, #^A/R/          ; SET ROUTE /PERMANENT
        BNEQ    20$
        PRESENT "PERMANENT"
        BLBC    R0, 20$
15$:    INCL    R7
        BSBW    LOAD
        BRB     30$
20$:    BSBW    SENSE
        BLBC    R0, 90$
30$:    CMPB    OPTBUF, #^A/R/
        BNEQ    40$
        MOVAB   P_GATEWAY, R5           ; SET ROUTE: the gateway
        MOVAB   SETTINGS+8, R6
        BSBW    TAKE
        BRB     50$
40$:    MOVAB   P_ADDRESS, R5           ; the address and the mask
        MOVAB   SETTINGS, R6
        BSBW    TAKE
        BLBC    R0, 90$
        MOVAB   P_MASK, R5
        MOVAB   SETTINGS+4, R6
        BSBW    TAKE
50$:    BLBC    R0, 90$
        BLBC    R7, 60$
        BRW     SAVE
60$:    BSBW    SETCHAR
90$:    RET

; TAKE: R5 = an entity's name, a descriptor, R6 = a longword. Puts the
; address the command gives the entity there. R0 = SS$_NORMAL, or
; SS$_IVADDR for one that isn't an address. Uses R0-R5.
TAKE:   MOVW    #64, VALUE
        PUSHAW  VALUE
        PUSHAQ  VALUE
        PUSHL   R5
        CALLS   #3, G^CLI$GET_VALUE
        BLBC    R0, 90$
        MOVAB   VALBUF, R0
        MOVZWL  VALUE, R1
        BSBW    ADDRESS
        BLBC    R0, 90$
        MOVL    R3, (R6)
90$:    RSB

; BOOT: no command line: unless the interface has an address already,
; the saved settings, if there are any, from the data disk. Then the
; remote login server, TELNETD, unless it runs already. Without a
; network, nothing.
BOOT:   BSBW    SENSE
        BLBC    R0, 80$
        TSTL    SETTINGS
        BNEQ    50$
        BSBW    LOAD
        BLBC    R0, 50$
        BSBW    SETCHAR
        BLBC    R0, 90$
        BSBW    SENSE
        BLBC    R0, 90$
        MOVAB   SETMSG, R1
        BSBW    SHOWLINE
50$:    $CREPRC_S IMAGE=TELNETD, PRCNAM=TELNETD_NAME, BASPRI=#4
80$:    MOVL    #SS$_NORMAL, R0
90$:    RET

; LOAD: puts the saved settings, INTERFACE address mask gateway in the
; data disk's file, in SETTINGS, or zeros if there are none. R0 = RMS's
; status if it can't read them, or PARSE's. Uses R0-R6.
LOAD:   CLRQ    SETTINGS
        CLRQ    SETTINGS+8
        $OPEN   FAB=FAB
        BLBC    R0, 90$
        $CONNECT RAB=RAB
        BLBC    R0, 40$
        $GET    RAB=RAB
        BLBC    R0, 40$
        MOVB    RAB+RAB$W_RSZ, CMD
40$:    PUSHL   R0
        $CLOSE  FAB=FAB
        MOVL    (SP)+, R0
        BLBC    R0, 90$
        BSBW    PARSE
90$:    RSB

; SAVE: writes INTERFACE and the settings' address, mask and gateway in a
; new version of the saved file. R0 = RMS's status if it can't.
SAVE:   MOVZBL  INTERFACE, R2
        MOVB    R2, LINE
        MOVC3   R2, INTERFACE+1, LINE+1
        MOVAB   SETTINGS, R6
10$:    MOVZBL  LINE, R0                ; a blank, then the address
        MOVB    #^A/ /, LINE+1[R0]
        INCB    LINE
        MOVL    (R6)+, R3
        BSBW    ADDTEXT
        MOVAB   SETTINGS+12, R0
        CMPL    R6, R0
        BLSSU   10$
        MOVB    #FAB$C_VAR, FAB+FAB$B_RFM
        MOVB    #FAB$M_CR, FAB+FAB$B_RAT
        $CREATE FAB=FAB
        BLBC    R0, 80$
        $CONNECT RAB=RAB
        BLBC    R0, 70$
        MOVAB   LINE+1, RAB+RAB$L_RBF
        MOVZBW  LINE, RAB+RAB$W_RSZ
        $PUT    RAB=RAB
70$:    MOVL    R0, R2
        $CLOSE  FAB=FAB
        MOVL    R2, R0
80$:    RET

; SETCHAR: sets the interface as SETTINGS says. R0 = a status.
SETCHAR:
        $QIOW_S CHAN=CHAN, FUNC=#IO$_SETCHAR, IOSB=IOSB, P1=SETTINGS
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

; PARSE: CMD = INTERFACE address mask gateway. Puts the three in
; SETTINGS. R0 = SS$_NORMAL, or SS$_IVADDR for one that isn't an address
; or isn't there. Uses R0-R6.
PARSE:  MOVL    #2, R2
        MOVAB   SETTINGS, R6
10$:    BSBW    WORD
        BSBW    ADDRESS
        BLBC    R0, 90$
        MOVL    R3, (R6)+
        AOBLEQ  #4, R2, 10$
90$:    RSB

; SHOW: writes the interface's address, mask and gateway, and the link's
; state.
SHOW:   BSBW    SENSE
        BLBC    R0, 90$
        PRINT   "Interface  IP_Addr          Network mask     Gateway          Link"
        MOVAB   SHOWMSG, R1
        BSBW    SHOWLINE
        MOVL    #SS$_NORMAL, R0
90$:    RET

; SENSE: senses the settings. R0 = a status.
SENSE:  $QIOW_S CHAN=CHAN, FUNC=#IO$_SENSECHAR, IOSB=IOSB, P1=SETTINGS
        BLBC    R0, 90$
        MOVZWL  IOSB, R0
90$:    RSB

; SHOWLINE: R1 = a heading, .ASCIC. Writes it, then the settings, each in
; 17 columns, and the link's state. Keeps R0.
SHOWLINE:
        PUSHL   R0
        MOVB    (R1)+, LINE
        MOVZBL  LINE, R2
        MOVC3   R2, (R1), LINE+1
        MOVAB   SETTINGS, R6
10$:    MOVL    (R6)+, R3
        MOVZBL  LINE, R4
        BSBW    ADDTEXT
        ADDB3   #17, R4, R5             ; pad to the column's end
20$:    CMPB    LINE, R5
        BGEQU   30$
        MOVZBL  LINE, R0
        MOVB    #^A/ /, LINE+1[R0]
        INCB    LINE
        BRB     20$
30$:    MOVAB   SETTINGS+12, R0
        CMPL    R6, R0
        BLSSU   10$
        MOVAB   DOWN, R1
        BBC     #1, (R6), 40$
        MOVAB   UP, R1
40$:    MOVZBL  (R1)+, R2
        MOVZBL  LINE, R0
        ADDB2   R2, LINE
        MOVC3   R2, (R1), LINE+1[R0]
        PUSHAB  LINE
        CALLS   #1, G^PUT_LINE
        MOVL    (SP)+, R0
        RSB
SHOWMSG:
        .ASCIC  " BGA0      "
SETMSG: .ASCIC  "%TCPIP-I-SET, BGA0: "
UP:     .ASCIC  "up"
DOWN:   .ASCIC  "down"

; ADDTEXT: R3 = an address. Appends it to LINE, four numbers and dots.
; Uses R0-R3.
ADDTEXT:
        CLRL    R2                      ; the byte
10$:    EXTZV   #0, #8, R3, R0
        ASHL    #-8, R3, R3
        BICL2   #^XFF000000, R3
        MOVL    #100, R1                ; its digits, without leading zeros
        TSTL    R0
        BNEQ    15$
        MOVL    #1, R1
15$:    CMPL    R0, R1
        BGEQU   20$
        DIVL2   #10, R1
        BRB     15$
20$:    PUSHL   R2
25$:    DIVL3   R1, R0, R2
        MULL3   R2, R1, -(SP)
        SUBL2   (SP)+, R0
        ADDB2   #^A/0/, R2
        PUSHL   R0
        MOVZBL  LINE, R0
        MOVB    R2, LINE+1[R0]
        INCB    LINE
        MOVL    (SP)+, R0
        DIVL2   #10, R1
        BNEQ    25$
        MOVL    (SP)+, R2
        INCL    R2
        CMPL    R2, #4
        BGEQU   90$
        MOVZBL  LINE, R0
        MOVB    #^A/./, LINE+1[R0]
        INCB    LINE
        BRB     10$
90$:    RSB

; WORD: R2 = n. R0 = the address of CMD's nth word, from 1, R1 = its
; length, 0 if there are fewer. Keeps every other register.
WORD:   PUSHR   #^M<R2, R3, R4>
        MOVAB   CMD+1, R0
        MOVZBL  CMD, R3
        ADDL2   R0, R3                  ; past the last character
10$:    CMPL    R0, R3                  ; past the blanks
        BGEQU   80$
        CMPB    (R0), #^A/ /
        BNEQ    20$
        INCL    R0
        BRB     10$
20$:    MOVL    R0, R4                  ; to the next blank
30$:    CMPL    R0, R3
        BGEQU   40$
        CMPB    (R0), #^A/ /
        BEQL    40$
        INCL    R0
        BRB     30$
40$:    SOBGTR  R2, 10$
        SUBL3   R4, R0, R1
        MOVL    R4, R0
        BRB     90$
80$:    CLRL    R1
90$:    POPR    #^M<R2, R3, R4>
        RSB

; ADDRESS: R0 and R1 = a word. R3 = the address it is (INET_ADDR), and
; R0 = SS$_NORMAL, or SS$_IVADDR. Keeps R2.
ADDRESS:
        CLRL    -(SP)
        PUSHAL  (SP)
        PUSHL   R0
        PUSHL   R1
        CALLS   #3, G^INET_ADDR
        MOVL    (SP)+, R3
        RSB

        .END    START
