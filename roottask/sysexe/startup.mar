        .TITLE  STARTUP Starts the other test programs
        .IDENT  /V0.2/
;
; RUN STARTUP at the console's DCL prompt runs this. It puts the
; executive's services to work: it makes pages and deletes them, starts
; SLEEPER at a higher priority, which runs at once, then PING and PONG,
; waits until PONG sets a flag of their cluster, deletes SLEEPER, starts
; SVCTEST, HOG, TIMETEST and ASTTEST and returns, which ends the image.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $SSDEF

PAGES = 4
STARTUP_EF = 66                         ; PONG's for me, in PING and PONG's cluster

        .PSECT  DATA, NOEXE, WRT, LONG
CLUSTER:
        .ASCID  "PINGPONG"
SLEEPER_IMAGE:
        .ASCID  "SLEEPER.EXE"
SLEEPER_NAME:
        .ASCID  "SLEEPER"
PING_IMAGE:
        .ASCID  "PING.EXE"
PING_NAME:
        .ASCID  "PING"
PONG_IMAGE:
        .ASCID  "PONG.EXE"
PONG_NAME:
        .ASCID  "PONG"
SVCTEST_IMAGE:
        .ASCID  "SVCTEST.EXE"
SVCTEST_NAME:
        .ASCID  "SVCTEST"
HOG_IMAGE:
        .ASCID  "HOG.EXE"
HOG_NAME:
        .ASCID  "HOG"
TIMETEST_IMAGE:
        .ASCID  "TIMETEST.EXE"
TIMETEST_NAME:
        .ASCID  "TIMETEST"
ASTTEST_IMAGE:
        .ASCID  "ASTTEST.EXE"
ASTTEST_NAME:
        .ASCID  "ASTTEST"
PID:    .LONG   0
RANGE:  .BLKL   2                       ; first and last byte

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<R2, R3>
        $ASCEFC_S EFN=#STARTUP_EF, NAME=CLUSTER
        BLBC    R0, 90$
        $EXPREG_S PAGCNT=#PAGES, RETADR=RANGE
        BLBC    R0, 90$
        MOVL    RANGE, R2               ; fill them, then check
        MOVL    #PAGES*4096/4, R3
10$:    MOVL    R3, (R2)+
        SOBGTR  R3, 10$
        MOVL    RANGE, R2
        CMPL    (R2), #PAGES*4096/4
        BNEQ    80$
        SUBL3   #3, RANGE+4, R2         ; the last longword
        CMPL    (R2), #1
        BNEQ    80$
        PRINTHEX "STARTUP: $EXPREG made 4 pages, and they hold what I wrote, at ", RANGE
        $DELTVA_S INADR=RANGE
        BLBC    R0, 90$
        $CREPRC_S PIDADR=PID, IMAGE=SLEEPER_IMAGE, PRCNAM=SLEEPER_NAME, BASPRI=#6
        BLBC    R0, 90$
        PRINTHEX "STARTUP: created SLEEPER, which ran first, PID ", PID
        $CREPRC_S PIDADR=PID, IMAGE=PING_IMAGE, PRCNAM=PING_NAME, BASPRI=#4
        BLBC    R0, 90$
        $CREPRC_S PIDADR=PID, IMAGE=PONG_IMAGE, PRCNAM=PONG_NAME, BASPRI=#4
        BLBC    R0, 90$
        PRINT   "STARTUP: created PING and PONG; waiting until PONG wakes me"
        $WAITFR_S EFN=#STARTUP_EF
        BLBC    R0, 90$
        PRINT   "STARTUP: woken, deleting SLEEPER"
        $DELPRC_S PRCNAM=SLEEPER_NAME
        BLBC    R0, 90$
        $CREPRC_S IMAGE=SVCTEST_IMAGE, PRCNAM=SVCTEST_NAME, BASPRI=#4
        BLBC    R0, 90$
        $CREPRC_S IMAGE=HOG_IMAGE, PRCNAM=HOG_NAME, BASPRI=#4
        BLBC    R0, 90$
        $CREPRC_S IMAGE=TIMETEST_IMAGE, PRCNAM=TIMETEST_NAME, BASPRI=#4
        BLBC    R0, 90$
        $CREPRC_S IMAGE=ASTTEST_IMAGE, PRCNAM=ASTTEST_NAME, BASPRI=#4
        BLBC    R0, 90$
        PRINT   "STARTUP: done, SVCTEST, HOG, TIMETEST and ASTTEST next"
        MOVL    #SS$_NORMAL, R0
        RET
80$:    MOVL    #SS$_ABORT, R0
90$:    RET

        .END    START
