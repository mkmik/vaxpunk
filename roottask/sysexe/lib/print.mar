        .TITLE  PRINT   Console output for the system disk's programs
        .IDENT  /V0.1/
;
; The programs run in user mode, so they write on the console as a VMS
; program does: on a channel to OPA0:, with $QIOW, a line at a time, which
; the executive writes whole. build.rs links this module into each of
; them; sysexe.mlb's PRINT and PRINTHEX call it.
;
        .LIBRARY "starlet.mlb"
        $IODEF

        .PSECT  PRINT_DATA, NOEXE, WRT, LONG
CHAN:   .LONG   0                       ; OPA0:'s, once assigned
OPA0:   .ASCID  "OPA0:"
HEX:    .ASCII  "0123456789ABCDEF"
LINE:   .BLKB   272

        .PSECT  PRINT_CODE, EXE, LONG
; PUT_LINE text, value: writes the .ASCIC text, value in 8 hex digits if
; there is a value, and CR LF. R0 = $QIOW's status.
        .ENTRY  PUT_LINE, ^M<R2, R3, R4>
        MOVL    4(AP), R1
        MOVZBL  (R1)+, R2
        CLRL    R3                      ; the bytes in LINE
10$:    CMPL    R3, R2
        BGEQU   20$
        MOVB    (R1)[R3], LINE[R3]
        INCL    R3
        BRB     10$
20$:    CMPB    (AP), #2
        BLSSU   40$
        MOVL    8(AP), R4
        MOVL    #8, R2
30$:    ROTL    #4, R4, R4
        EXTZV   #0, #4, R4, R0
        MOVB    HEX[R0], LINE[R3]
        INCL    R3
        SOBGTR  R2, 30$
40$:    MOVB    #13, LINE[R3]
        MOVB    #10, LINE+1[R3]
        ADDL2   #2, R3
        TSTL    CHAN
        BNEQ    50$
        $ASSIGN_S DEVNAM=OPA0, CHAN=CHAN
        BLBC    R0, 90$
50$:    $QIOW_S CHAN=CHAN, FUNC=#IO$_WRITEVBLK, P1=LINE, P2=R3
90$:    RET

        .END
