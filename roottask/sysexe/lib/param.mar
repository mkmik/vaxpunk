        .TITLE  PARAM   The command line's parameters, for the system disk's programs
        .IDENT  /V0.1/
;
; DCL passes a command's parameters to the image it runs as its command
; line, at VA$C_FOREIGN, in capitals, a blank between each two. build.rs
; links this module into each image, as it does lib/print.mar.
;
        .LIBRARY "lib.mlb"
        $VADEF

        .PSECT  PARAM_CODE, EXE, LONG
; GET_PARAM n, desc: points the descriptor at the command line's nth
; parameter, from 1: its length in its first word, its address in its
; second longword; the word between is left alone, so an item list's
; entry is a descriptor too. R0 = 1, or 0 if there are fewer parameters.
        .ENTRY  GET_PARAM, ^M<R2, R3, R4>
        MOVL    #VA$C_FOREIGN+1, R1     ; the next character
        MOVZBL  @#VA$C_FOREIGN, R2
        ADDL2   R1, R2                  ; past the last
        MOVL    4(AP), R3
10$:    CMPL    R1, R2                  ; a parameter: past the blanks
        BGEQU   80$
        CMPB    (R1), #^A/ /
        BNEQ    20$
        INCL    R1
        BRB     10$
20$:    MOVL    R1, R4                  ; to the next blank
30$:    CMPL    R1, R2
        BGEQU   40$
        CMPB    (R1), #^A/ /
        BEQL    40$
        INCL    R1
        BRB     30$
40$:    SOBGTR  R3, 10$
        MOVL    8(AP), R0
        SUBW3   R4, R1, (R0)
        MOVL    R4, 4(R0)
        MOVL    #1, R0
        RET
80$:    CLRL    R0
        RET

        .END
