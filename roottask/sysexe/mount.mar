        .TITLE  MOUNT   Mounts a Files-11 volume
        .IDENT  /V0.1/
;
; DCL's MOUNT device [label] runs this: $MOUNT mounts the volume on the
; device if its label is that one, or whatever it is without one, as
; /OVERRIDE=IDENTIFICATION does on VMS, and the executive reports it on
; the console. Returns $MOUNT's status.
; ponytail: no qualifiers.
;
        .LIBRARY "starlet.mlb"
        .LIBRARY "sysexe.mlb"
        $MNTDEF

        .PSECT  DATA, NOEXE, WRT, LONG
ITEMS:  .WORD   64, MNT$_DEVNAM         ; each a descriptor too, which GETVALUE fills
        .ADDRESS DEVBUF
        .LONG   0
        .WORD   64, MNT$_VOLNAM
        .ADDRESS LABBUF
        .LONG   0
        .LONG   0
DEVBUF: .BLKB   64
LABBUF: .BLKB   64

        .PSECT  CODE, EXE, LONG
        .ENTRY  START, ^M<>
        GETVALUE "DEVICE", ITEMS, ITEMS
        GETVALUE "LABEL", ITEMS+12, ITEMS+12
        BLBS    R0, 10$
        CLRL    ITEMS+12                ; no label: the list ends before it
10$:    $MOUNT_S ITMLST=ITEMS
        RET

        .END    START
