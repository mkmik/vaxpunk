        .TITLE  EXEC    The executive's MACRO-32 part
        .IDENT  /V0.2/
;
; The root task, the PAL, starts EXEC.EXE as a task of its own, in kernel
; mode at IPL 31. Privileged instructions are PAL calls
; (docs/design/0001-pal-interface.md): this writes a greeting on the console
; as a VAX's CON$PUTCHAR does, lowers IPL to 8 and halts with the IPL it
; reads back in R0.
;
        .LIBRARY "lib.mlb"
        $PRDEF

        .PSECT  DATA, NOEXE, NOWRT, LONG
GREETING:
        .ASCIZ  "hello from the executive"<13><10>

        .PSECT  CODE, EXE, SHR, LONG
        .ENTRY  EXEC$START, ^M<>
        MOVAB   GREETING, R1
10$:    MOVZBL  (R1)+, R0
        BEQL    20$
        MTPR    R0, #PR$_TXDB
        BRB     10$
20$:    MTPR    #8, #PR$_IPL
        MFPR    #PR$_IPL, R0
        HALT

        .END    EXEC$START
