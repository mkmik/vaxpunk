# The QEMU machine the kernel is built for. seL4 dumps this machine's DTB at
# configure time and compiles its memory map in, so QEMU must run with the
# same values. Read by kernel/build.rs and scripts/run-qemu.sh.
# QEMU_MEM is the RAM in MB, all of it the PAL's and the executive's
# (ADR-0037). QEMU gives the guest host pages only as it touches them, so a
# large size costs the host nothing until it is used. QEMU_MEM in the
# environment overrides it for both: the browser demo's images are built
# with QEMU_MEM=1024.
QEMU_CPU=cortex-a57
QEMU_MEM=8192
# GICv3 rather than seL4's default v2: HVF (run-qemu.sh --hvf) only emulates v3.
QEMU_GIC=3
